 1 file changed, 32 insertions(+), 34 deletions(-)

diff --git a/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp b/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
index a242c143b273b576476c640887796a027b1499f4..38f4515ce5212f1ac23c3717e338f07fa22a09d5 100644
--- a/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
+++ b/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
@@ -85,15 +85,6 @@ bool inferProjectedRowDimension(LayoutSourceAttrInterface source,
   return false;
 }
 
-bool hasValidProjectedIndices(LayoutSourceAttrInterface source,
-                              size_t iterationRank, size_t rowDim,
-                              bool scalarRowProjection) {
-  size_t inferredRowDim = iterationRank;
-  return inferProjectedRowDimension(source, iterationRank, inferredRowDim) &&
-         (scalarRowProjection ? inferredRowDim == iterationRank
-                              : inferredRowDim == rowDim);
-}
