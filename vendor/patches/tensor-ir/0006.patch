+StatusOr<std::string> sha256File(llvm::StringRef path) {
+  auto buffer = llvm::MemoryBuffer::getFile(path, /*IsText=*/false);
+  if (!buffer) {
+    return Status::NotFound("failed to read tileiras for identity check: " +
+                            buffer.getError().message());
+  }
+  llvm::SHA256 sha;
+  sha.update((*buffer)->getBuffer());
+  auto digest = sha.final();
+  return llvm::toHex(
+      llvm::ArrayRef<uint8_t>(digest.data(), digest.size()),
+      /*LowerCase=*/true);
+}
+
+Status validateCanonicalProgramPath(llvm::StringRef program) {
+  llvm::SmallString<256> canonical;
+  if (std::error_code error =
+          llvm::sys::fs::real_path(program, canonical, /*expand_tilde=*/true)) {
+    return Status::NotFound("failed to resolve tileiras real path: " +
+                            error.message());
+  }
+  if (canonical != program) {
+    return Status::InvalidArgument(
+        "explicit tileiras path must already be canonical");
+  }
+  return Status::Ok();
+}
+
+Status validateProgramSha256(llvm::StringRef program,
+                             llvm::StringRef expectedSha256) {
+  if (expectedSha256.empty()) {
+    return Status::Ok();
+  }
+  TIR_ASSIGN_OR_RETURN(auto actualSha256, sha256File(program));
+  if (actualSha256 != expectedSha256) {
+    return Status::CompilationError(
+        "tileiras SHA-256 differs from the expected producer identity");
+  }
+  return Status::Ok();
+}
