+  for (char character : value) {
+    if (!((character >= '0' && character <= '9') ||
+          (character >= 'a' && character <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+uint16_t readU16LE(llvm::ArrayRef<char> bytes, size_t offset) {
+  return static_cast<uint16_t>(static_cast<uint8_t>(bytes[offset])) |
+         static_cast<uint16_t>(static_cast<uint8_t>(bytes[offset + 1])) << 8;
+}
+
+uint32_t readU32LE(llvm::ArrayRef<char> bytes, size_t offset) {
+  return static_cast<uint32_t>(static_cast<uint8_t>(bytes[offset])) |
+         static_cast<uint32_t>(static_cast<uint8_t>(bytes[offset + 1])) << 8 |
+         static_cast<uint32_t>(static_cast<uint8_t>(bytes[offset + 2])) << 16 |
+         static_cast<uint32_t>(static_cast<uint8_t>(bytes[offset + 3])) << 24;
+}
+
+Status validateTileIRHeader(
+    llvm::ArrayRef<char> bytes,
+    std::optional<mlir::cuda_tile::BytecodeVersion> expectedVersion) {
+  constexpr size_t kHeaderSize = 12;
+  if (bytes.size() < kHeaderSize) {
+    return Status::InvalidArgument("truncated TileIR bytecode header");
+  }
+  auto version = mlir::cuda_tile::BytecodeVersion::fromVersion(
+      static_cast<uint8_t>(bytes[8]), static_cast<uint8_t>(bytes[9]),
+      readU16LE(bytes, 10));
+  if (!version) {
+    return Status::InvalidArgument("unsupported TileIR bytecode version");
+  }
+  if (expectedVersion && *version != *expectedVersion) {
+    return Status::InvalidArgument(
+        "TileIR bytecode version differs from artifact metadata");
+  }
+  return Status::Ok();
+}
+
+Status validateCudaElfHeader(llvm::ArrayRef<char> bytes,
+                             std::optional<int32_t> expectedCc) {
+  constexpr size_t kElf64HeaderSize = 64;
+  constexpr size_t kMachineOffset = 18;
+  constexpr size_t kVersionOffset = 20;
+  constexpr size_t kFlagsOffset = 48;
+  constexpr size_t kHeaderSizeOffset = 52;
+  if (bytes.size() < kElf64HeaderSize) {
+    return Status::InvalidArgument("truncated CUDA ELF header");
+  }
+  if (static_cast<uint8_t>(bytes[llvm::ELF::EI_CLASS]) !=
+          llvm::ELF::ELFCLASS64 ||
+      static_cast<uint8_t>(bytes[llvm::ELF::EI_DATA]) !=
+          llvm::ELF::ELFDATA2LSB ||
+      static_cast<uint8_t>(bytes[llvm::ELF::EI_VERSION]) !=
+          llvm::ELF::EV_CURRENT ||
+      readU16LE(bytes, kMachineOffset) != llvm::ELF::EM_CUDA ||
+      readU32LE(bytes, kVersionOffset) != llvm::ELF::EV_CURRENT ||
+      readU16LE(bytes, kHeaderSizeOffset) != kElf64HeaderSize) {
+    return Status::InvalidArgument("ELF payload is not a CUDA ELF64 cubin");
+  }
+  if (expectedCc) {
+    uint32_t flags = readU32LE(bytes, kFlagsOffset);
+    int32_t encodedCc = *expectedCc >= 100
+                            ? static_cast<int32_t>(
+                                  (flags & llvm::ELF::EF_CUDA_SM_MASK) >>
+                                  llvm::ELF::EF_CUDA_SM_OFFSET)
+                            : static_cast<int32_t>(flags & llvm::ELF::EF_CUDA_SM);
+    if (encodedCc != *expectedCc) {
+      return Status::InvalidArgument(
+          "cubin SM flags differ from artifact target metadata");
+    }
+  }
+  return Status::Ok();
+}
