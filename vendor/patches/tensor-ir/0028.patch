From f8e9272e14b7176ca10f43419db305cd46e88979 Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Thu, 27 Aug 2026 21:09:09 +0800
Subject: [PATCH 28/89] Preserve bounded diagnostics in strict compilation
 errors

---
 lib/Compiler/CudaTile/CudaTileCompiler.cpp | 35 ++++++++++++++++++++--
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/lib/Compiler/CudaTile/CudaTileCompiler.cpp b/lib/Compiler/CudaTile/CudaTileCompiler.cpp
index da85bc1323b1ebe0e9a74a527c0f6f54df88b9a8..5aeec83cd007f58279989333f50b2f8b873a95ac 100644
--- a/lib/Compiler/CudaTile/CudaTileCompiler.cpp
+++ b/lib/Compiler/CudaTile/CudaTileCompiler.cpp
@@ -25,9 +25,11 @@
 #include "cuda_tile/Bytecode/Writer/BytecodeWriter.h"
 #include "mlir/IR/Diagnostics.h"
 #include "mlir/Parser/Parser.h"
+#include <algorithm>
 #include <cstdlib>
 #include <memory>
 #include <optional>
+#include <string>
 
 namespace {
 
@@ -288,18 +290,45 @@ StatusOr<CudaTileCompiledArtifact> CudaTileCompiler::compileToArtifact(
   mlir::MLIRContext context(registry);
   context.loadAllAvailableDialects();
 
+  constexpr size_t kMaximumCapturedDiagnosticBytes = 64 * 1024;
+  std::string capturedDiagnostics;
   std::unique_ptr<mlir::ScopedDiagnosticHandler> diagnosticHandler;
   if (!options.allowEnvironmentOverrides) {
     diagnosticHandler = std::make_unique<mlir::ScopedDiagnosticHandler>(
-        &context, [](mlir::Diagnostic &) {});
+        &context, [&](mlir::Diagnostic &diagnostic) {
+          if (capturedDiagnostics.size() >=
+              kMaximumCapturedDiagnosticBytes) {
+            return;
+          }
+          std::string rendered;
+          llvm::raw_string_ostream stream(rendered);
+          diagnostic.print(stream);
+          stream.flush();
+          const size_t remaining = kMaximumCapturedDiagnosticBytes -
+                                   capturedDiagnostics.size();
+          capturedDiagnostics.append(rendered.data(),
+                                     std::min(rendered.size(), remaining));
+          if (capturedDiagnostics.size() <
+              kMaximumCapturedDiagnosticBytes) {
+            capturedDiagnostics.push_back('\n');
+          }
+        });
   }
 
   mlir::ParserConfig parserConfig(&context);
   auto module = mlir::parseSourceString<mlir::ModuleOp>(source, parserConfig);
   if (!module) {
-    return Status::CompilationError("Failed to parse MLIR source string");
+    return Status::CompilationError(
+        "Failed to parse MLIR source string" +
+        (capturedDiagnostics.empty() ? std::string()
+                                     : "\n" + capturedDiagnostics));
+  }
+  auto compiled = compileToArtifact(*module, options);
+  if (!compiled.ok() && !capturedDiagnostics.empty()) {
+    return Status::CompilationError(compiled.status().message() + "\n" +
+                                    capturedDiagnostics);
   }
-  return compileToArtifact(*module, options);
+  return compiled;
 }
 
 StatusOr<CudaTileCompiledArtifact> CudaTileCompiler::compileToArtifact(
