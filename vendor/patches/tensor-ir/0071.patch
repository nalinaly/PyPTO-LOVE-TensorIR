+struct ContiguousColumnProjection {
+  SmallVector<size_t> dimensions;
+  int64_t tileSize = 1;
+};
+
+FailureOr<ContiguousColumnProjection> inferContiguousColumnProjection(
+    const tcg::Layout &dataLayout, ArrayRef<int64_t> iterationTileShape,
+    size_t rowDim, int64_t physicalColumnStride) {
+  if (physicalColumnStride <= 0) {
+    return failure();
+  }
+  SmallVector<std::pair<int64_t, size_t>> orderedDimensions;
+  for (size_t dim = 0; dim < iterationTileShape.size(); ++dim) {
+    int64_t layoutStride =
+        tcg::static_size(tcg::get(dataLayout.stride(), dim));
+    if (dim == rowDim || layoutStride == 0) {
+      continue;
+    }
+    if (layoutStride < physicalColumnStride ||
+        layoutStride % physicalColumnStride != 0) {
+      return failure();
+    }
+    orderedDimensions.emplace_back(layoutStride / physicalColumnStride, dim);
+  }
+  std::sort(orderedDimensions.begin(), orderedDimensions.end());
+
+  ContiguousColumnProjection projection;
+  int64_t previousCoefficient = 0;
+  for (auto [coefficient, dim] : orderedDimensions) {
+    if (coefficient <= previousCoefficient || iterationTileShape[dim] <= 0) {
+      return failure();
+    }
+    previousCoefficient = coefficient;
+    projection.dimensions.push_back(dim);
+    const int64_t tileExtent = iterationTileShape[dim];
+    if (tileExtent == 1) {
+      continue;
+    }
+    // A dense GatherScatterView can flatten several logical column axes only
+    // when this tile is contiguous in physical column order. Unit-tiled outer
+    // axes remain legal because they contribute only a base offset.
+    if (coefficient != projection.tileSize ||
+        projection.tileSize >
+            std::numeric_limits<int64_t>::max() / tileExtent) {
+      return failure();
+    }
+    projection.tileSize *= tileExtent;
+  }
+  return projection;
+}
+
+Value buildProjectedColumnOffset(
+    ConversionPatternRewriter &rewriter, Location loc,
+    ArrayRef<Value> indexValues, ArrayRef<int64_t> iterationTileShape,
+    const tcg::Layout &dataLayout, int64_t physicalColumnStride,
+    ArrayRef<size_t> columnDimensions, Value zeroIndex) {
+  Value offset;
+  for (size_t dim : columnDimensions) {
+    int64_t layoutStride =
+        tcg::static_size(tcg::get(dataLayout.stride(), dim));
+    int64_t scale = iterationTileShape[dim] *
+                    (layoutStride / physicalColumnStride);
+    Value term = indexValues[dim];
+    if (scale != 1) {
+      Value scaleValue = createConstant(
+          rewriter, loc, cast<ShapedType>(term.getType()), scale);
+      term = cuda_tile::MulIOp::create(rewriter, loc, term, scaleValue);
+    }
+    offset = offset ? cuda_tile::AddIOp::create(rewriter, loc, offset, term)
+                    : term;
+  }
+  return offset ? offset : zeroIndex;
+}
