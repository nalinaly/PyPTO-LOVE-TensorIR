@@ -80,46 +82,114 @@ constexpr unsigned kCompileCommandTimeoutSeconds = 300;
 constexpr unsigned kAssemblerMemoryLimitMiB = 4096;
 
 detail::ScratchScanResult classifyScratchScanError(std::error_code error) {
-  return {error == std::errc::no_such_file_or_directory
-              ? detail::ScratchScanStatus::TransientError
-              : detail::ScratchScanStatus::FatalError,
-          error};
+  return {detail::ScratchScanStatus::ScanError, error};
 }
 
+#if defined(__linux__)
+std::error_code currentSystemError() {
+  return {errno, std::generic_category()};
+}
+
+struct DirectoryCloser {
+  void operator()(DIR *directory) const {
+    if (directory != nullptr) {
+      (void)::closedir(directory);
+    }
+  }
+};
+
+using DirectoryHandle = std::unique_ptr<DIR, DirectoryCloser>;
+
+detail::ScratchScanResult openDirectoryHandle(int descriptor,
+                                              DirectoryHandle &result) {
+  DIR *directory = ::fdopendir(descriptor);
+  if (directory == nullptr) {
+    std::error_code error = currentSystemError();
+    (void)::close(descriptor);
+    return classifyScratchScanError(error);
+  }
+  result.reset(directory);
+  return {detail::ScratchScanStatus::WithinLimit, {}};
+}
+#endif
+
 } // namespace
 
 detail::ScratchScanResult detail::scanScratchDirectory(
     llvm::StringRef path, uint64_t maximumBytes) {
-  std::error_code error;
-  llvm::sys::fs::recursive_directory_iterator iterator(
-      path, error, /*follow_symlinks=*/false);
-  llvm::sys::fs::recursive_directory_iterator end;
-  if (error) {
-    return classifyScratchScanError(error);
+#if defined(__linux__)
+  const std::string rootPath = path.str();
+  int rootDescriptor = ::open(rootPath.c_str(),
+                              O_RDONLY | O_CLOEXEC | O_DIRECTORY | O_NOFOLLOW);
+  if (rootDescriptor < 0) {
+    return classifyScratchScanError(currentSystemError());
+  }
+  DirectoryHandle root;
+  ScratchScanResult rootOpen = openDirectoryHandle(rootDescriptor, root);
+  if (rootOpen.status == ScratchScanStatus::ScanError) {
+    return rootOpen;
   }
+
   uint64_t totalBytes = 0;
-  while (iterator != end) {
-    auto status = iterator->status();
-    if (!status) {
-      return classifyScratchScanError(status.getError());
-    }
-    if (status->type() == llvm::sys::fs::file_type::regular_file) {
-      uint64_t fileBytes = 0;
-      if (std::error_code sizeError =
-              llvm::sys::fs::file_size(iterator->path(), fileBytes)) {
-        return classifyScratchScanError(sizeError);
+  std::vector<DirectoryHandle> pendingDirectories;
+  pendingDirectories.push_back(std::move(root));
+  while (!pendingDirectories.empty()) {
+    DirectoryHandle directory = std::move(pendingDirectories.back());
+    pendingDirectories.pop_back();
+    while (true) {
+      errno = 0;
+      dirent *entry = ::readdir(directory.get());
+      if (entry == nullptr) {
+        if (errno != 0) {
+          return classifyScratchScanError(currentSystemError());
+        }
+        break;
       }
-      if (fileBytes > maximumBytes - totalBytes) {
-        return {detail::ScratchScanStatus::Exceeded, {}};
+      if (std::strcmp(entry->d_name, ".") == 0 ||
+          std::strcmp(entry->d_name, "..") == 0) {
+        continue;
+      }
+
+      struct stat status {};
+      if (::fstatat(::dirfd(directory.get()), entry->d_name, &status,
+                    AT_SYMLINK_NOFOLLOW) != 0) {
+        return classifyScratchScanError(currentSystemError());
+      }
+      if (S_ISDIR(status.st_mode)) {
+        int childDescriptor =
+            ::openat(::dirfd(directory.get()), entry->d_name,
+                     O_RDONLY | O_CLOEXEC | O_DIRECTORY | O_NOFOLLOW);
+        if (childDescriptor < 0) {
+          return classifyScratchScanError(currentSystemError());
+        }
+        DirectoryHandle child;
+        ScratchScanResult childOpen =
+            openDirectoryHandle(childDescriptor, child);
+        if (childOpen.status == ScratchScanStatus::ScanError) {
+          return childOpen;
+        }
+        pendingDirectories.push_back(std::move(child));
+      } else if (S_ISREG(status.st_mode)) {
+        if (status.st_size < 0) {
+          return classifyScratchScanError(
+              std::make_error_code(std::errc::io_error));
+        }
+        uint64_t fileBytes = static_cast<uint64_t>(status.st_size);
+        if (totalBytes > maximumBytes ||
+            fileBytes > maximumBytes - totalBytes) {
+          return {detail::ScratchScanStatus::Exceeded, {}};
+        }
+        totalBytes += fileBytes;
       }
-      totalBytes += fileBytes;
-    }
-    iterator.increment(error);
-    if (error) {
-      return classifyScratchScanError(error);
     }
   }
   return {detail::ScratchScanStatus::WithinLimit, {}};
+#else
+  (void)path;
+  (void)maximumBytes;
+  return classifyScratchScanError(
+      std::make_error_code(std::errc::operation_not_supported));
+#endif
 }
 
