 StatusOr<CudaTileArtifactKind>
 detectCudaTileArtifactKind(llvm::ArrayRef<char> deviceCode);
 
+/// Validate complete runtime-free device bytes against their declared kind,
+/// target, and intermediate TileIR bytecode version. This performs no CUDA
+/// load, context query, filesystem access, or runtime reconstruction. The
+/// target is byte-attested for Cubin; TileIR carries and validates its version
+/// but does not encode an equivalent target attestation.
+Status validateCudaTileDeviceCode(
+    llvm::ArrayRef<char> deviceCode, CudaTileArtifactKind actualKind,
+    SmTarget actualTarget,
+    mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion);
+
 /// Process- and device-independent output of TensorIR CUDA Tile compilation.
 ///
 /// This value deliberately contains no CUDA module, kernel, context, stream,
diff --git a/lib/Compiler/CudaTile/CudaTileArtifact.cpp b/lib/Compiler/CudaTile/CudaTileArtifact.cpp
index c7b9f3afadb95383afd588b3a8dd91b2342642a4..48d0b3f0a60adc372cc25cbe3383b0736464b98e 100644
--- a/lib/Compiler/CudaTile/CudaTileArtifact.cpp
+++ b/lib/Compiler/CudaTile/CudaTileArtifact.cpp
@@ -350,6 +350,34 @@ detectCudaTileArtifactKind(llvm::ArrayRef<char> deviceCode) {
       "device code is neither TileIR bytecode nor an ELF cubin");
 }
 
+Status validateCudaTileDeviceCode(
+    llvm::ArrayRef<char> deviceCode, CudaTileArtifactKind actualKind,
+    SmTarget actualTarget,
+    mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion) {
+  TIR_ASSIGN_OR_RETURN(auto detectedKind,
+                       detectCudaTileArtifactKind(deviceCode));
+  if (detectedKind != actualKind) {
+    return Status::InvalidArgument(
+        "declared CUDA Tile artifact kind differs from byte magic");
+  }
+  switch (actualKind) {
+  case CudaTileArtifactKind::TileIR:
+    TIR_RETURN_IF_ERROR(
+        validateTileIRHeader(deviceCode, tileIRBytecodeVersion));
+    return validateCompleteTileIR(deviceCode);
+  case CudaTileArtifactKind::Cubin:
+    if (actualTarget.getPortability() !=
+        ArchPortability::arch_conditional) {
+      return Status::InvalidArgument(
+          "cubin artifact requires an architecture-conditional target");
+    }
+    TIR_RETURN_IF_ERROR(validateCudaElfHeader(
+        deviceCode, actualTarget.getComputeCapabilityVersion()));
+    return validateCompleteCudaElf(deviceCode, actualTarget);
+  }
+  return Status::InvalidArgument("unknown CUDA Tile artifact kind");
+}
+
 Status CudaTileCompiledArtifact::validate() const {
   if (schemaVersion != kSchemaVersion) {
     return Status::InvalidArgument("unsupported CUDA Tile artifact schema");
