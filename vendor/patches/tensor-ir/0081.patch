-      physicalPermutation.push_back(static_cast<int32_t>(dim));
-      usedDimensions[dim] = true;
-    }
-    for (size_t dim = 0; dim < iterationRank; ++dim) {
-      if (!usedDimensions[dim]) {
-        physicalPermutation.push_back(static_cast<int32_t>(dim));
-      }
-    }
-    SmallVector<int64_t> storeShape;
-    storeShape.reserve(iterationRank);
-    for (int32_t dim : physicalPermutation) {
