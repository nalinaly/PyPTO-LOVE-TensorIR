+def TensorIR_GatherRowsOp : TensorIR_Op<"gather_rows", [
+    Pure,
+    OpAsmOpInterface,
+    IterationSpaceInfoInterface,
+    PointwiseOpInterface,
+    DeclareOpInterfaceMethods<LayoutPropInterface, ["inferResultLayout"]>
+  ]> {
+  let summary = "Gather matrix rows with one index per output row";
+  let description = [{
+    Selects one row from a rank-2 source matrix for every output row. The
+    indices tensor has the same logical shape as the output and must carry the
+    selected row index repeated across each output row (normally represented
+    by a zero column stride). This shape-preserving form lets pointwise users
+    fuse after the gather while lowering the source access through a CUDA Tile
+    gather/scatter view.
+
+    ```mlir
+    %result = nv_tensor_ir.gather_rows %table, %indices
+        : (tensor<1024x128xbf16>, tensor<32x128xi32>)
+       -> tensor<32x128xbf16>
+    ```
+  }];
+
+  let arguments = (ins
+    Arg<TensorIR_TensorType, "Rank-2 source matrix">:$data,
+    Arg<TensorIR_TensorType, "Repeated i32 row indices">:$indices
+  );
+  let results = (outs
+    Arg<TensorIR_TensorType, "Gathered rows">:$output
+  );
+
+  let assemblyFormat = "$data `,` $indices attr-dict `:` functional-type(operands, results)";
+  let hasVerifier = 1;
+}
