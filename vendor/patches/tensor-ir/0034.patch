+LogicalResult GatherRowsOp::verify() {
+  auto dataType = getData().getType();
+  auto indicesType = getIndices().getType();
+  auto outputType = getOutput().getType();
+  if (dataType.getRank() != 2 || indicesType.getRank() != 2 ||
+      outputType.getRank() != 2) {
+    return emitOpError("requires rank-2 data, indices and output tensors");
+  }
+  if (!indicesType.getElementType().isInteger(32)) {
+    return emitOpError("requires i32 indices");
+  }
+  if (dataType.getElementType() != outputType.getElementType()) {
+    return emitOpError("requires matching data and output element types");
+  }
+  if (dataType.getDimSize(1) != outputType.getDimSize(1)) {
+    return emitOpError("requires data and output column extents to match");
+  }
+  if (indicesType.getShape() != outputType.getShape()) {
+    return emitOpError("requires indices and output shapes to match");
+  }
+  if (!dataType.hasStaticShape() || !indicesType.hasStaticShape() ||
+      !outputType.hasStaticShape()) {
+    return emitOpError("currently requires static shapes");
+  }
+  return success();
+}
+
+LayoutSourceAttrInterface GatherRowsOp::inferResultLayout(
+    ArrayRef<LayoutSourceAttrInterface> inputLayouts) {
+  assert(inputLayouts.size() == 2 && "expects data and indices layouts");
+  auto dataSource = dyn_cast<TensorSourceAttr>(inputLayouts[0]);
+  if (!dataSource || !getOutput().getType().hasStaticShape()) {
+    return nullptr;
+  }
+  tcg::Layout gatheredLayout(getShapeRef(getOutput().getType()));
+  auto gatheredSource = TensorSourceAttr::get(
+      getContext(), dataSource.getTensorId(), dataSource.getOffset(),
+      gatheredLayout.toString(), /*dynamicValueMapping=*/{});
+  return CompositeSourceAttr::get(
+      getContext(), {gatheredSource, inputLayouts[1]});
+}
