+// CHECK-LABEL: entry @gather_rows
+// CHECK: %[[DATA_VIEW:.*]] = make_tensor_view {{.*}}, shape = [1024, 128], strides = [128, 1] : tensor_view<1024x128xbf16, strides=[128,1]>
+// CHECK: %[[GATHER_VIEW:.*]] = make_gather_scatter_view %[[DATA_VIEW]] : gather_scatter_view<tile=(8x128), tensor_view<1024x128xbf16, strides=[128,1]>, sparse_dim=0>
+// CHECK: %[[NARROW:.*]] = extract {{.*}} : tile<8x128xi32> -> tile<8x1xi32>
+// CHECK: %[[ROWS:.*]] = reshape %[[NARROW]] : tile<8x1xi32> -> tile<8xi32>
+// CHECK: %[[GATHERED:.*]], {{.*}} = load_view_tko weak %[[GATHER_VIEW]][%[[ROWS]], {{.*}}]
+// CHECK-SAME: -> tile<8x128xbf16>, token
