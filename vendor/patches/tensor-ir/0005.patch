+namespace mlir::nv_tensor_ir::backend::cuda_tile {
+
+/// Device-code representation selected by the CUDA Tile producer.
+enum class CudaTileArtifactKind : uint32_t {
+  TileIR = 0,
+  Cubin = 1,
+};
+
+/// Runtime argument reconstruction selected by the compiler.
+enum class CudaTileArgumentPackingPolicy : uint32_t {
+  PointerOnly = 0,
+  Flat = 1,
+};
+
+/// Runtime grid reconstruction selected by the compiler.
+enum class CudaTileGridPolicy : uint32_t {
+  Static = 0,
+  TileBasedRuntime = 1,
+};
+
+llvm::StringRef stringifyCudaTileArtifactKind(CudaTileArtifactKind kind);
+
+/// Determine the actual representation from device-code magic.
+StatusOr<CudaTileArtifactKind>
+detectCudaTileArtifactKind(llvm::ArrayRef<char> deviceCode);
+
+/// Process- and device-independent output of TensorIR CUDA Tile compilation.
+///
+/// This value deliberately contains no CUDA module, kernel, context, stream,
+/// workspace pointer, runtime operand accessor, or type-erased launch object.
+/// An embedding compiler can serialize it and reconstruct those process-bound
+/// objects only after cache validation.
+struct CudaTileCompiledArtifact {
+  static constexpr uint32_t kSchemaVersion = 1;
+
+  CudaTileCompiledArtifact(
+      SmTarget requestedTarget, SmTarget actualTarget,
+      mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion)
+      : requestedTarget(requestedTarget), actualTarget(actualTarget),
+        tileIRBytecodeVersion(tileIRBytecodeVersion) {}
+
+  uint32_t schemaVersion = kSchemaVersion;
+  llvm::SmallVector<char, 0> deviceCode;
+  CudaTileArtifactKind requestedArtifactKind = CudaTileArtifactKind::TileIR;
+  CudaTileArtifactKind actualArtifactKind = CudaTileArtifactKind::TileIR;
+  SmTarget requestedTarget;
+  SmTarget actualTarget;
+  mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion;
+
+  std::string runtimeKernelName;
+  std::string entryFunctionName;
+  ::tensor_ir::rt::KernelArgLayout argLayout;
+  CudaTileArgumentPackingPolicy argumentPackingPolicy =
+      CudaTileArgumentPackingPolicy::PointerOnly;
+  CudaTileGridPolicy gridPolicy = CudaTileGridPolicy::Static;
+  std::array<int32_t, 3> staticGrid = {1, 1, 1};
+
+  uint64_t workspaceSizeBytes = 0;
+  uint64_t workspaceAlignmentBytes = 1;
+
+  bool environmentOverridesEnabled = true;
+  bool artifactFallbackAllowed = true;
+  std::string tileIRAssemblerPath;
+  std::string compileOptionsIdentity;
+
+  [[nodiscard]] bool usedArtifactFallback() const {
+    return requestedArtifactKind != actualArtifactKind;
+  }
+
+  /// Validate the complete value without loading device code.
+  [[nodiscard]] Status validate() const;
+};
+
+} // namespace mlir::nv_tensor_ir::backend::cuda_tile
+
+#endif // TENSOR_IR_COMPILER_CUDATILE_CUDATILEARTIFACT_H
