+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+#include "tensor_ir/Compiler/CudaTile/CudaTileArtifact.h"
+
+#include "llvm/ADT/StringRef.h"
+
+#include <cstddef>
+#include <limits>
+#include <string>
+
+namespace mlir::nv_tensor_ir::backend::cuda_tile {
+namespace {
+
+bool containsNul(llvm::StringRef value) {
+  return value.find('\0') != llvm::StringRef::npos;
+}
+
+bool isPowerOfTwo(uint64_t value) {
+  return value != 0 && (value & (value - 1)) == 0;
+}
+
+Status validateArgLayout(const ::tensor_ir::rt::KernelArgLayout &layout) {
+  if (layout.numInputs < 0 ||
+      layout.numInputs > static_cast<int32_t>(layout.tensorDescs.size())) {
+    return Status::InvalidArgument("invalid number of input operands");
+  }
+  if (layout.totalKernelArgs < 0) {
+    return Status::InvalidArgument("negative total kernel argument count");
+  }
+
+  int64_t expectedKernelArgs = 0;
+  for (const auto &desc : layout.tensorDescs) {
+    if (desc.rank < 0 || desc.numDynSizes < 0 || desc.numDynStrides < 0) {
+      return Status::InvalidArgument("negative kernel argument layout field");
+    }
+    if (desc.isScalar) {
+      if (desc.rank != 0 || desc.scalarSizeInBytes <= 0 ||
+          !desc.staticShape.empty() || !desc.staticStrides.empty() ||
+          desc.numDynSizes != 0 || desc.numDynStrides != 0 ||
+          desc.hasExplicitStrides) {
+        return Status::InvalidArgument("invalid scalar argument descriptor");
+      }
+    } else {
+      if (desc.scalarSizeInBytes != 0 ||
+          desc.staticShape.size() != static_cast<size_t>(desc.rank) ||
+          (!desc.staticStrides.empty() &&
+           desc.staticStrides.size() != static_cast<size_t>(desc.rank))) {
+        return Status::InvalidArgument("invalid tensor argument descriptor");
+      }
+      if (desc.hasExplicitStrides != !desc.staticStrides.empty()) {
+        return Status::InvalidArgument(
+            "tensor stride flag does not match stride metadata");
+      }
+    }
+    expectedKernelArgs += desc.totalArgs();
+    if (expectedKernelArgs > std::numeric_limits<int32_t>::max()) {
+      return Status::InvalidArgument("kernel argument count overflows int32");
+    }
+  }
+  if (expectedKernelArgs != layout.totalKernelArgs) {
+    return Status::InvalidArgument("kernel argument count does not match ABI");
+  }
+  for (int32_t tileSize : layout.tileSizes) {
+    if (tileSize <= 0) {
+      return Status::InvalidArgument("tile sizes must be positive");
+    }
+  }
+  return Status::Ok();
+}
+
+} // namespace
+
+llvm::StringRef stringifyCudaTileArtifactKind(CudaTileArtifactKind kind) {
+  switch (kind) {
+  case CudaTileArtifactKind::TileIR:
+    return "tileir";
+  case CudaTileArtifactKind::Cubin:
+    return "cubin";
+  }
+  return "";
+}
+
+StatusOr<CudaTileArtifactKind>
+detectCudaTileArtifactKind(llvm::ArrayRef<char> deviceCode) {
+  static constexpr char kTileIRMagic[] = "\x7fTileIR\x00";
+  static constexpr char kElfMagic[] = "\x7f"
+                                      "ELF";
+  llvm::StringRef bytes(deviceCode.data(), deviceCode.size());
+  if (bytes.starts_with(
+          llvm::StringRef(kTileIRMagic, sizeof(kTileIRMagic) - 1))) {
+    return CudaTileArtifactKind::TileIR;
+  }
+  if (bytes.starts_with(llvm::StringRef(kElfMagic, sizeof(kElfMagic) - 1))) {
+    return CudaTileArtifactKind::Cubin;
+  }
+  return Status::InvalidArgument(
+      "device code is neither TileIR bytecode nor an ELF cubin");
+}
+
+Status CudaTileCompiledArtifact::validate() const {
+  if (schemaVersion != kSchemaVersion) {
+    return Status::InvalidArgument("unsupported CUDA Tile artifact schema");
+  }
+  if (runtimeKernelName.empty() || entryFunctionName.empty() ||
+      containsNul(runtimeKernelName) || containsNul(entryFunctionName)) {
+    return Status::InvalidArgument("invalid CUDA Tile kernel name");
+  }
+  if (compileOptionsIdentity.empty() || containsNul(compileOptionsIdentity)) {
+    return Status::InvalidArgument("invalid compile options identity");
+  }
+
+  switch (requestedArtifactKind) {
+  case CudaTileArtifactKind::TileIR:
+  case CudaTileArtifactKind::Cubin:
+    break;
+  default:
+    return Status::InvalidArgument("unknown requested artifact kind");
+  }
+
+  TIR_ASSIGN_OR_RETURN(auto detectedKind,
+                       detectCudaTileArtifactKind(deviceCode));
+  if (detectedKind != actualArtifactKind) {
+    return Status::InvalidArgument(
+        "declared CUDA Tile artifact kind differs from byte magic");
+  }
+  if (requestedArtifactKind == CudaTileArtifactKind::TileIR &&
+      actualArtifactKind != CudaTileArtifactKind::TileIR) {
+    return Status::InvalidArgument(
+        "TileIR request unexpectedly produced another artifact kind");
+  }
+  if (usedArtifactFallback() && !artifactFallbackAllowed) {
+    return Status::InvalidArgument("artifact fallback is not allowed");
+  }
+  if (!requestedTarget.validateCodegenTargetCompatibility(
+          actualTarget.getComputeCapabilityVersion())) {
+    return Status::InvalidArgument(
+        "actual target is incompatible with requested target");
+  }
+  if (actualArtifactKind == CudaTileArtifactKind::Cubin &&
+      actualTarget.getPortability() != ArchPortability::arch_conditional) {
+    return Status::InvalidArgument(
+        "cubin artifact requires an architecture-conditional target");
+  }
+
+  TIR_RETURN_IF_ERROR(validateArgLayout(argLayout));
+  bool requiresFlatPacking =
+      argLayout.uniformSignature || argLayout.hasDynamicShapes();
+  if (argumentPackingPolicy != CudaTileArgumentPackingPolicy::PointerOnly &&
+      argumentPackingPolicy != CudaTileArgumentPackingPolicy::Flat) {
+    return Status::InvalidArgument("unknown argument packing policy");
+  }
+  if ((argumentPackingPolicy == CudaTileArgumentPackingPolicy::Flat) !=
+      requiresFlatPacking) {
+    return Status::InvalidArgument(
+        "argument packing policy differs from kernel ABI metadata");
+  }
+
+  for (int32_t dim : staticGrid) {
+    if (dim <= 0) {
+      return Status::InvalidArgument("static grid dimensions must be positive");
+    }
+  }
+  if (gridPolicy == CudaTileGridPolicy::TileBasedRuntime) {
+    if (argLayout.tileSizes.empty() || argLayout.gridShapeTensorIdx < 0 ||
+        argLayout.gridShapeTensorIdx >=
+            static_cast<int32_t>(argLayout.tensorDescs.size())) {
+      return Status::InvalidArgument("runtime grid metadata is incomplete");
+    }
+  } else if (gridPolicy != CudaTileGridPolicy::Static) {
+    return Status::InvalidArgument("unknown CUDA Tile grid policy");
+  }
+
+  if (!isPowerOfTwo(workspaceAlignmentBytes) ||
+      (workspaceSizeBytes % workspaceAlignmentBytes) != 0) {
+    return Status::InvalidArgument("invalid workspace ABI metadata");
+  }
+  if (!environmentOverridesEnabled &&
+      actualArtifactKind == CudaTileArtifactKind::Cubin &&
+      tileIRAssemblerPath.empty()) {
+    return Status::InvalidArgument(
+        "deterministic cubin artifact lacks an explicit assembler path");
+  }
+  return Status::Ok();
+}
+
+} // namespace mlir::nv_tensor_ir::backend::cuda_tile
