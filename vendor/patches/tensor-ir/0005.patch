+StatusOr<CudaTileCompiledArtifact> CudaTileCompiler::compileToArtifact(
+    llvm::StringRef source, const CudaTileCompileOptions &options) {
+  mlir::DialectRegistry registry;
+  mlir::nv_tensor_ir::registerDialects(registry);
+  mlir::MLIRContext context(registry);
+  context.loadAllAvailableDialects();
+
+  mlir::ParserConfig parserConfig(&context);
+  auto module = mlir::parseSourceString<mlir::ModuleOp>(source, parserConfig);
+  if (!module) {
+    return Status::CompilationError("Failed to parse MLIR source string");
+  }
+  return compileToArtifact(*module, options);
+}
+
+StatusOr<CudaTileCompiledArtifact> CudaTileCompiler::compileToArtifact(
+    mlir::ModuleOp module, const CudaTileCompileOptions &cudaTileOptions) {
+  TIR_RETURN_IF_ERROR(cudaTileOptions.validate());
+
+  IRDebugOptions debug = cudaTileOptions.irDebug;
+  if (cudaTileOptions.allowEnvironmentOverrides) {
+    applyPathEnvVar("TENSOR_IR_DUMP_IR", debug.dumpCudaTileIRPath);
+    applyPathEnvVar("TENSOR_IR_DUMP_TILEIR_BC", debug.dumpTileIRBCPath);
+    applyPathEnvVar("TENSOR_IR_LOAD_TILEIR_BC", debug.loadTileIRBCPath);
+    applyBoolEnvVar("TENSOR_IR_PRINT_IR_AFTER_ALL", debug.printIRAfterAll);
+    applyPathEnvVar("TENSOR_IR_PRINT_IR_TREE_DIR", debug.printIRTreeDir);
+    applyBoolEnvVar("TENSOR_IR_TIMING", debug.enableTiming);
+  }
+
+  auto frontendOptions = makeFrontendOptions(cudaTileOptions, debug);
+  auto frontendOr =
+      compiler::cuda_tile::lowerTensorIRToCudaTile(module, frontendOptions);
+  if (failed(frontendOr)) {
+    return Status::CompilationError(
+        "Failed to lower TensorIR to CudaTile dialect");
+  }
+  compiler::cuda_tile::CudaTileFrontendResult frontend = std::move(*frontendOr);
+
+  llvm::SmallVector<char, 0> tileirBytecode;
+  llvm::raw_svector_ostream os(tileirBytecode);
+  if (failed(mlir::cuda_tile::writeBytecode(
+          os, frontend.cudaTileModule, cudaTileOptions.bytecodeVersion))) {
+    return Status::CompilationError("Failed to write tile-ir bytecode");
+  }
+
+  if (!debug.dumpTileIRBCPath.empty()) {
+    std::error_code ec;
+    llvm::raw_fd_ostream bcOs(debug.dumpTileIRBCPath, ec,
+                              llvm::sys::fs::OF_None);
+    if (ec) {
+      llvm::errs() << "Warning: cannot dump Tile IR bytecode to '"
+                   << debug.dumpTileIRBCPath << "': " << ec.message() << "\n";
+    } else {
+      bcOs.write(tileirBytecode.data(), tileirBytecode.size());
+    }
+  }
+
+  if (!debug.loadTileIRBCPath.empty()) {
+    auto bufOrErr = llvm::MemoryBuffer::getFile(debug.loadTileIRBCPath,
+                                                /*IsText=*/false);
+    if (!bufOrErr) {
+      return Status::CompilationError("Cannot load Tile IR bytecode from '" +
+                                      debug.loadTileIRBCPath +
+                                      "': " + bufOrErr.getError().message());
+    }
+    llvm::StringRef bc = (*bufOrErr)->getBuffer();
+    tileirBytecode.assign(bc.begin(), bc.end());
+  }
+
+  if (cudaTileOptions.artifactKind == CudaTileArtifactKind::Cubin) {
+    TIR_ASSIGN_OR_RETURN(
+        auto cubin,
+        assembleTileIRToCubin(tileirBytecode,
+                              cudaTileOptions.computeCapability,
+                              cudaTileOptions.bytecodeVersion,
+                              cudaTileOptions.tileIRAssemblerPath));
+    if (cubin) {
+      tileirBytecode = std::move(*cubin);
+    } else if (!cudaTileOptions.allowArtifactFallback) {
+      return Status::CompilationError(
+          "Cubin was requested but no compatible TileIR assembler is "
+          "available");
+    }
+  }
+
+  TIR_ASSIGN_OR_RETURN(auto actualArtifactKind,
+                       detectCudaTileArtifactKind(tileirBytecode));
+  CudaTileCompiledArtifact artifact(
+      cudaTileOptions.computeCapability, cudaTileOptions.computeCapability,
+      cudaTileOptions.bytecodeVersion);
+  artifact.deviceCode = std::move(tileirBytecode);
+  artifact.requestedArtifactKind = cudaTileOptions.artifactKind;
+  artifact.actualArtifactKind = actualArtifactKind;
+  artifact.runtimeKernelName = std::move(frontend.runtimeKernelName);
+  artifact.entryFunctionName = std::move(frontend.entryFunctionName);
+  artifact.argLayout = std::move(frontend.argLayout);
+  artifact.argumentPackingPolicy =
+      artifact.argLayout.uniformSignature ||
+              artifact.argLayout.hasDynamicShapes()
+          ? CudaTileArgumentPackingPolicy::Flat
+          : CudaTileArgumentPackingPolicy::PointerOnly;
+  artifact.gridPolicy = frontend.useRuntimeGrid
+                            ? CudaTileGridPolicy::TileBasedRuntime
+                            : CudaTileGridPolicy::Static;
+  artifact.staticGrid = compiler::cuda_tile::computeStaticGridSize(frontend);
+  artifact.environmentOverridesEnabled =
+      cudaTileOptions.allowEnvironmentOverrides;
+  artifact.artifactFallbackAllowed = cudaTileOptions.allowArtifactFallback;
+  artifact.tileIRAssemblerPath = cudaTileOptions.tileIRAssemblerPath;
+  artifact.compileOptionsIdentity = cudaTileOptions.toUniqueString();
+  TIR_RETURN_IF_ERROR(artifact.validate());
+  return artifact;
+}
