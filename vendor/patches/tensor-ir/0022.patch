@@ -54,10 +72,37 @@ struct ProcessResult {
 constexpr uint64_t kMaximumDiagnosticBytes = 64 * 1024;
 constexpr uint64_t kMaximumCubinBytes = 64ULL * 1024ULL * 1024ULL;
 constexpr uint64_t kMaximumChildFileBytes = 4096ULL * 1024ULL * 1024ULL;
+constexpr uint64_t kMaximumChildScratchBytes = 4096ULL * 1024ULL * 1024ULL;
 constexpr unsigned kMetadataCommandTimeoutSeconds = 30;
 constexpr unsigned kCompileCommandTimeoutSeconds = 300;
 constexpr unsigned kAssemblerMemoryLimitMiB = 4096;
 
+bool scratchDirectoryWithinLimit(llvm::StringRef path) {
+  std::error_code error;
+  llvm::sys::fs::recursive_directory_iterator iterator(
+      path, error, /*follow_symlinks=*/false);
+  llvm::sys::fs::recursive_directory_iterator end;
+  if (error) {
+    return false;
+  }
+  uint64_t totalBytes = 0;
+  while (iterator != end) {
+    if (iterator->type() == llvm::sys::fs::file_type::regular_file) {
+      uint64_t fileBytes = 0;
+      if (llvm::sys::fs::file_size(iterator->path(), fileBytes) ||
+          fileBytes > kMaximumChildScratchBytes - totalBytes) {
+        return false;
+      }
+      totalBytes += fileBytes;
+    }
+    iterator.increment(error);
+    if (error) {
+      return false;
+    }
+  }
+  return true;
+}
