From 4c3f0821f8ffe33ca1f6995e5c6943889a19e816 Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Fri, 28 Aug 2026 01:47:24 +0800
Subject: [PATCH 44/89] Key lazy input loads by rewrite owner

---
 .../TensorToCudaTile/LayoutPropagationImpl.cpp | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp b/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
index d736aa40427d8ddd65705ee833726ab69ee4c179..b7b259aa22b1aa0cba28d7c3380e2278d375737d 100644
--- a/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
+++ b/lib/Conversion/TensorToCudaTile/LayoutPropagationImpl.cpp
@@ -140,6 +140,8 @@ private:
   /// materialized lazily from getTile so each new load immediately gains a
   /// real SSA consumer instead of living only in this side table.
   ConversionPatternRewriter *activeRewriter = nullptr;
+  Operation *activeOperation = nullptr;
+  DenseMap<IterationSpace *, Operation *> loadedTileCacheOwner;
 
   /// A cached load is only safe while one conversion pattern is being
   /// rewritten. Graph splitting may erase that pattern's replacement later,
@@ -745,7 +747,7 @@ public:
     state.blockStructure = &state.blockStructures[resultsOp.getOperation()];
     state.iterationSpace = &state.blockStructure->iterationSpaces[0];
     state.activeRewriter = &rewriter;
-    state.resetLoadedTileCache(*state.iterationSpace);
+    state.activeOperation = resultsOp.getOperation();
     state.layouts.clear();
     for (Value operand : resultsOp.getOperands()) {
       auto layout = dyn_cast_or_null<LayoutSourceAttrInterface>(
@@ -929,6 +931,8 @@ LogicalResult ConversionStateImpl::start(GraphOp graphOp) {
   blockStructure = nullptr;
   iterationSpace = nullptr;
   activeRewriter = nullptr;
+  activeOperation = nullptr;
+  loadedTileCacheOwner.clear();
   layouts.clear();
   operandIndex = 0;
 
@@ -942,6 +946,7 @@ LogicalResult ConversionStateImpl::update(ConversionPatternRewriter &rewriter,
                                           Operation *op) {
   LLVM_DEBUG(llvm::dbgs() << "Converting: " << op->getName() << "\n");
   activeRewriter = &rewriter;
+  activeOperation = op;
 
   // Verify the attribute-level legality (layout / iteration-space-id presence
   // and validity). This is shared with the pre-flight feasibility check. Here,
@@ -995,13 +1000,6 @@ LogicalResult ConversionStateImpl::update(ConversionPatternRewriter &rewriter,
   auto iterSpaceId =
       op->getAttrOfType<IntegerAttr>(TensorIRDialect::getIterSpaceIdAttrName());
   iterationSpace = iterationSpaces.find(iterSpaceId.getInt())->second;
-  if (blockStructure) {
-    for (IterationSpace &space : blockStructure->iterationSpaces) {
-      resetLoadedTileCache(space);
-    }
-  } else {
-    resetLoadedTileCache(*iterationSpace);
-  }
   rewriter.setInsertionPointToEnd(iterationSpace->insertionBlock);
 
   // Reset the operand index.
@@ -1043,6 +1041,10 @@ Value ConversionStateImpl::getTile(Value operand) {
       iterationSpace = &blockStructure->iterationSpaces[idx];
     }
 
+    if (loadedTileCacheOwner.lookup(iterationSpace) != activeOperation) {
+      resetLoadedTileCache(*iterationSpace);
+      loadedTileCacheOwner[iterationSpace] = activeOperation;
+    }
     auto it = iterationSpace->loadedTiles.find(tensorSource);
     assert(it != iterationSpace->loadedTiles.end() &&
            "layout has no associated value");
