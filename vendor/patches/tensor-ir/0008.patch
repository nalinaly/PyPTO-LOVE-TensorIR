 # Compiler.h is a public embedding surface and directly includes MLIR/LLVM
diff --git a/lib/Compiler/CudaTile/CudaTileArtifact.cpp b/lib/Compiler/CudaTile/CudaTileArtifact.cpp
index 46c52021569346800438c8a9b0178908e826ca66..0a8dc849ac0ca8524edca6aabe65d3057e0e25c5 100644
--- a/lib/Compiler/CudaTile/CudaTileArtifact.cpp
+++ b/lib/Compiler/CudaTile/CudaTileArtifact.cpp
@@ -5,9 +5,6 @@
 
 #include "llvm/ADT/StringRef.h"
 #include "llvm/BinaryFormat/ELF.h"
-#include "llvm/Object/ELFObjectFile.h"
-#include "llvm/Object/ObjectFile.h"
-#include "llvm/Support/Error.h"
 #include "llvm/Support/MemoryBuffer.h"
 
 #include "cuda_tile/Bytecode/Reader/BytecodeReader.h"
@@ -55,6 +52,20 @@ uint32_t readU32LE(llvm::ArrayRef<char> bytes, size_t offset) {
          static_cast<uint32_t>(static_cast<uint8_t>(bytes[offset + 3])) << 24;
 }
 
+uint64_t readU64LE(llvm::ArrayRef<char> bytes, size_t offset) {
+  uint64_t value = 0;
+  for (size_t index = 0; index < sizeof(uint64_t); ++index) {
+    value |= static_cast<uint64_t>(
+                 static_cast<uint8_t>(bytes[offset + index]))
+             << (index * 8);
+  }
+  return value;
+}
+
+bool isRangeWithin(uint64_t offset, uint64_t size, size_t totalSize) {
+  return offset <= totalSize && size <= totalSize - offset;
+}
+
 Status validateTileIRHeader(
     llvm::ArrayRef<char> bytes,
     std::optional<mlir::cuda_tile::BytecodeVersion> expectedVersion) {
@@ -130,40 +141,88 @@ Status validateCompleteCudaElf(llvm::ArrayRef<char> bytes,
   // CUDA 13.3 cubins emitted by tileiras use OSABI byte 0x41. The pinned LLVM
   // revision only names the older CUDA OSABI values (0x33 and 0x29).
   static constexpr uint8_t kCudaTileOsAbi = 0x41;
-  llvm::MemoryBufferRef buffer(
-      llvm::StringRef(bytes.data(), bytes.size()), "cuda-cubin-artifact");
-  auto objectOr = llvm::object::ObjectFile::createObjectFile(buffer);
-  if (!objectOr) {
-    llvm::consumeError(objectOr.takeError());
-    return Status::InvalidArgument("invalid CUDA ELF object structure");
-  }
-  auto *elf = llvm::dyn_cast<llvm::object::ELFObjectFileBase>(objectOr->get());
-  if (!elf || elf->getEMachine() != llvm::ELF::EM_CUDA ||
-      elf->getBytesInAddress() != 8 || !elf->isLittleEndian() ||
-      (elf->getEType() != llvm::ELF::ET_EXEC &&
-       elf->getEType() != llvm::ELF::ET_REL) ||
-      (elf->getEIdentOSABI() != llvm::ELF::ELFOSABI_CUDA &&
-       elf->getEIdentOSABI() != llvm::ELF::ELFOSABI_CUDA_V2 &&
-       elf->getEIdentOSABI() != kCudaTileOsAbi) ||
-      (elf->getEIdentABIVersion() != llvm::ELF::ELFABIVERSION_CUDA_V1 &&
-       elf->getEIdentABIVersion() != llvm::ELF::ELFABIVERSION_CUDA_V2)) {
+  constexpr size_t kProgramHeaderOffset = 32;
+  constexpr size_t kSectionHeaderOffset = 40;
+  constexpr size_t kProgramHeaderSizeOffset = 54;
+  constexpr size_t kProgramHeaderCountOffset = 56;
+  constexpr size_t kSectionHeaderSizeOffset = 58;
+  constexpr size_t kSectionHeaderCountOffset = 60;
+  constexpr size_t kSectionNameIndexOffset = 62;
+  constexpr uint16_t kElf64ProgramHeaderSize = 56;
+  constexpr uint16_t kElf64SectionHeaderSize = 64;
+  uint8_t osAbi = static_cast<uint8_t>(bytes[llvm::ELF::EI_OSABI]);
+  uint8_t abiVersion =
+      static_cast<uint8_t>(bytes[llvm::ELF::EI_ABIVERSION]);
+  uint16_t elfType = readU16LE(bytes, 16);
+  if ((elfType != llvm::ELF::ET_EXEC && elfType != llvm::ELF::ET_REL) ||
+      (osAbi != llvm::ELF::ELFOSABI_CUDA &&
+       osAbi != llvm::ELF::ELFOSABI_CUDA_V2 &&
+       osAbi != kCudaTileOsAbi) ||
+      (abiVersion != llvm::ELF::ELFABIVERSION_CUDA_V1 &&
+       abiVersion != llvm::ELF::ELFABIVERSION_CUDA_V2)) {
     return Status::InvalidArgument("ELF object is not a supported CUDA cubin");
   }
 
+  uint64_t programHeadersOffset = readU64LE(bytes, kProgramHeaderOffset);
+  uint16_t programHeaderSize =
+      readU16LE(bytes, kProgramHeaderSizeOffset);
+  uint16_t programHeaderCount =
+      readU16LE(bytes, kProgramHeaderCountOffset);
+  if (programHeaderCount > 0 &&
+      (programHeaderSize != kElf64ProgramHeaderSize ||
+       !isRangeWithin(programHeadersOffset,
+                      static_cast<uint64_t>(programHeaderSize) *
+                          programHeaderCount,
+                      bytes.size()))) {
+    return Status::InvalidArgument("invalid CUDA ELF program header table");
+  }
+  for (uint16_t index = 0; index < programHeaderCount; ++index) {
+    uint64_t headerOffset = programHeadersOffset +
+                            static_cast<uint64_t>(index) * programHeaderSize;
+    uint64_t fileOffset = readU64LE(bytes, headerOffset + 8);
+    uint64_t fileSize = readU64LE(bytes, headerOffset + 32);
+    if (!isRangeWithin(fileOffset, fileSize, bytes.size())) {
+      return Status::InvalidArgument("invalid CUDA ELF segment bounds");
+    }
+  }
+
+  uint64_t sectionHeadersOffset = readU64LE(bytes, kSectionHeaderOffset);
+  uint16_t sectionHeaderSize =
+      readU16LE(bytes, kSectionHeaderSizeOffset);
+  uint16_t sectionHeaderCount =
+      readU16LE(bytes, kSectionHeaderCountOffset);
+  uint16_t sectionNameIndex = readU16LE(bytes, kSectionNameIndexOffset);
+  if (sectionHeaderCount == 0 ||
+      sectionHeaderSize != kElf64SectionHeaderSize ||
+      sectionNameIndex >= sectionHeaderCount ||
+      !isRangeWithin(sectionHeadersOffset,
+                     static_cast<uint64_t>(sectionHeaderSize) *
+                         sectionHeaderCount,
+                     bytes.size())) {
+    return Status::InvalidArgument("invalid CUDA ELF section header table");
+  }
+
   bool hasText = false;
-  for (const llvm::object::SectionRef &section : elf->sections()) {
-    auto contents = section.getContents();
-    if (!contents) {
-      llvm::consumeError(contents.takeError());
+  for (uint16_t index = 0; index < sectionHeaderCount; ++index) {
+    uint64_t headerOffset = sectionHeadersOffset +
+                            static_cast<uint64_t>(index) * sectionHeaderSize;
+    uint32_t sectionType = readU32LE(bytes, headerOffset + 4);
+    uint64_t sectionFlags = readU64LE(bytes, headerOffset + 8);
+    uint64_t sectionOffset = readU64LE(bytes, headerOffset + 24);
+    uint64_t sectionSize = readU64LE(bytes, headerOffset + 32);
+    if (sectionType != llvm::ELF::SHT_NOBITS &&
+        !isRangeWithin(sectionOffset, sectionSize, bytes.size())) {
       return Status::InvalidArgument("invalid CUDA ELF section bounds");
     }
-    hasText = hasText || section.isText();
+    hasText = hasText ||
+              (sectionType == llvm::ELF::SHT_PROGBITS && sectionSize > 0 &&
+               (sectionFlags & llvm::ELF::SHF_EXECINSTR) != 0);
   }
   if (!hasText) {
     return Status::InvalidArgument("CUDA cubin contains no text section");
   }
 
-  uint32_t flags = elf->getPlatformFlags();
+  uint32_t flags = readU32LE(bytes, 48);
   int32_t expectedCc = expectedTarget.getComputeCapabilityVersion();
   int32_t encodedCc = expectedCc >= 100
                           ? static_cast<int32_t>(
