+/// Immutable output of TensorIR-to-CUDA-Tile lowering before final device-code
+/// assembly.
+///
+/// The value owns the exact TileIR bytecode, complete callable ABI metadata,
+/// and the already-resolved assembler identity.  It is intentionally
+/// move-only and can only be created by CudaTileCompiler, so final assembly
+/// cannot be mixed with a second CudaTileCompileOptions value.
+class CudaTilePreparedArtifact {
+public:
+  CudaTilePreparedArtifact() = delete;
+  CudaTilePreparedArtifact(const CudaTilePreparedArtifact &) = delete;
+  CudaTilePreparedArtifact &
+  operator=(const CudaTilePreparedArtifact &) = delete;
+  CudaTilePreparedArtifact(CudaTilePreparedArtifact &&) = default;
+  CudaTilePreparedArtifact &operator=(CudaTilePreparedArtifact &&) = default;
+
+  [[nodiscard]] llvm::ArrayRef<char> getTileIRBytecode() const {
+    return tileIRBytecode_;
+  }
+  [[nodiscard]] CudaTileArtifactKind getRequestedArtifactKind() const {
+    return requestedArtifactKind_;
+  }
+  [[nodiscard]] const SmTarget &getRequestedTarget() const {
+    return requestedTarget_;
+  }
+  [[nodiscard]] const mlir::cuda_tile::BytecodeVersion &
+  getTileIRBytecodeVersion() const {
+    return tileIRBytecodeVersion_;
+  }
+  [[nodiscard]] const std::string &getRuntimeKernelName() const {
+    return runtimeKernelName_;
+  }
+  [[nodiscard]] const std::string &getEntryFunctionName() const {
+    return entryFunctionName_;
+  }
+  [[nodiscard]] const ::tensor_ir::rt::KernelArgLayout &getArgLayout() const {
+    return argLayout_;
+  }
+  [[nodiscard]] CudaTileArgumentPackingPolicy
+  getArgumentPackingPolicy() const {
+    return argumentPackingPolicy_;
+  }
+  [[nodiscard]] CudaTileGridPolicy getGridPolicy() const {
+    return gridPolicy_;
+  }
+  [[nodiscard]] const std::array<int32_t, 3> &getStaticGrid() const {
+    return staticGrid_;
+  }
+  [[nodiscard]] uint64_t getWorkspaceSizeBytes() const {
+    return workspaceSizeBytes_;
+  }
+  [[nodiscard]] uint64_t getWorkspaceAlignmentBytes() const {
+    return workspaceAlignmentBytes_;
+  }
+  [[nodiscard]] bool getEnvironmentOverridesEnabled() const {
+    return environmentOverridesEnabled_;
+  }
+  [[nodiscard]] bool getArtifactFallbackAllowed() const {
+    return artifactFallbackAllowed_;
+  }
+  [[nodiscard]] const std::string &getTileIRAssemblerPath() const {
+    return tileIRAssemblerPath_;
+  }
+  [[nodiscard]] const std::string &getTileIRAssemblerVersion() const {
+    return tileIRAssemblerVersion_;
+  }
+  [[nodiscard]] const std::string &getTileIRAssemblerSha256() const {
+    return tileIRAssemblerSha256_;
+  }
+  [[nodiscard]] unsigned getTileIRAssemblerTimeoutSeconds() const {
+    return tileIRAssemblerTimeoutSeconds_;
+  }
+  [[nodiscard]] const std::string &getCompileOptionsIdentity() const {
+    return compileOptionsIdentity_;
+  }
+
+private:
+  friend class CudaTileCompiler;
+
+  CudaTilePreparedArtifact(
+      SmTarget requestedTarget,
+      mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion)
+      : requestedTarget_(requestedTarget),
+        tileIRBytecodeVersion_(tileIRBytecodeVersion) {}
+
+  llvm::SmallVector<char, 0> tileIRBytecode_;
+  CudaTileArtifactKind requestedArtifactKind_ = CudaTileArtifactKind::TileIR;
+  SmTarget requestedTarget_;
+  mlir::cuda_tile::BytecodeVersion tileIRBytecodeVersion_;
+
+  std::string runtimeKernelName_;
+  std::string entryFunctionName_;
+  ::tensor_ir::rt::KernelArgLayout argLayout_;
+  CudaTileArgumentPackingPolicy argumentPackingPolicy_ =
+      CudaTileArgumentPackingPolicy::PointerOnly;
+  CudaTileGridPolicy gridPolicy_ = CudaTileGridPolicy::Static;
+  std::array<int32_t, 3> staticGrid_ = {1, 1, 1};
+
+  uint64_t workspaceSizeBytes_ = 0;
+  uint64_t workspaceAlignmentBytes_ = 1;
+
+  bool environmentOverridesEnabled_ = true;
+  bool artifactFallbackAllowed_ = true;
+  std::string tileIRAssemblerPath_;
+  std::string tileIRAssemblerVersion_;
+  std::string tileIRAssemblerSha256_;
+  unsigned tileIRAssemblerTimeoutSeconds_ = 0;
+  std::string compileOptionsIdentity_;
+};
