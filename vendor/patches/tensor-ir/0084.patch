+
+static_assert(!std::is_copy_constructible_v<CudaTilePreparedArtifact>);
+static_assert(!std::is_copy_assignable_v<CudaTilePreparedArtifact>);
+static_assert(std::is_move_constructible_v<CudaTilePreparedArtifact>);
+
+namespace {
+
+bool sameTarget(const SmTarget &lhs, const SmTarget &rhs) {
+  return lhs.getComputeCapabilityVersion() ==
+             rhs.getComputeCapabilityVersion() &&
+         lhs.getPortability() == rhs.getPortability() &&
+         lhs.toString() == rhs.toString();
+}
+
+bool sameBytecodeVersion(const mlir::cuda_tile::BytecodeVersion &lhs,
+                         const mlir::cuda_tile::BytecodeVersion &rhs) {
+  return lhs.getMajor() == rhs.getMajor() && lhs.getMinor() == rhs.getMinor() &&
+         lhs.getTag() == rhs.getTag();
+}
+
+bool sameDescriptor(const ::tensor_ir::rt::TensorArgDesc &lhs,
+                    const ::tensor_ir::rt::TensorArgDesc &rhs) {
+  return lhs.rank == rhs.rank && lhs.staticShape == rhs.staticShape &&
+         lhs.staticStrides == rhs.staticStrides &&
+         lhs.numDynSizes == rhs.numDynSizes &&
+         lhs.numDynStrides == rhs.numDynStrides &&
+         lhs.hasExplicitStrides == rhs.hasExplicitStrides &&
+         lhs.isScalar == rhs.isScalar &&
+         lhs.scalarSizeInBytes == rhs.scalarSizeInBytes;
+}
+
+bool sameLayout(const ::tensor_ir::rt::KernelArgLayout &lhs,
+                const ::tensor_ir::rt::KernelArgLayout &rhs) {
+  if (lhs.tensorDescs.size() != rhs.tensorDescs.size() ||
+      lhs.tileSizes != rhs.tileSizes || lhs.numInputs != rhs.numInputs ||
+      lhs.totalKernelArgs != rhs.totalKernelArgs ||
+      lhs.gridShapeTensorIdx != rhs.gridShapeTensorIdx ||
+      lhs.uniformSignature != rhs.uniformSignature) {
+    return false;
+  }
+  for (size_t index = 0; index < lhs.tensorDescs.size(); ++index) {
+    if (!sameDescriptor(lhs.tensorDescs[index], rhs.tensorDescs[index])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool sameArtifact(const CudaTileCompiledArtifact &lhs,
+                  const CudaTileCompiledArtifact &rhs) {
+  return lhs.schemaVersion == rhs.schemaVersion &&
+         lhs.deviceCode == rhs.deviceCode &&
+         lhs.requestedArtifactKind == rhs.requestedArtifactKind &&
+         lhs.actualArtifactKind == rhs.actualArtifactKind &&
+         sameTarget(lhs.requestedTarget, rhs.requestedTarget) &&
+         sameTarget(lhs.actualTarget, rhs.actualTarget) &&
+         sameBytecodeVersion(lhs.tileIRBytecodeVersion,
+                             rhs.tileIRBytecodeVersion) &&
+         lhs.runtimeKernelName == rhs.runtimeKernelName &&
+         lhs.entryFunctionName == rhs.entryFunctionName &&
+         sameLayout(lhs.argLayout, rhs.argLayout) &&
+         lhs.argumentPackingPolicy == rhs.argumentPackingPolicy &&
+         lhs.gridPolicy == rhs.gridPolicy &&
+         lhs.staticGrid == rhs.staticGrid &&
+         lhs.workspaceSizeBytes == rhs.workspaceSizeBytes &&
+         lhs.workspaceAlignmentBytes == rhs.workspaceAlignmentBytes &&
+         lhs.environmentOverridesEnabled ==
+             rhs.environmentOverridesEnabled &&
+         lhs.artifactFallbackAllowed == rhs.artifactFallbackAllowed &&
+         lhs.tileIRAssemblerPath == rhs.tileIRAssemblerPath &&
+         lhs.tileIRAssemblerVersion == rhs.tileIRAssemblerVersion &&
+         lhs.tileIRAssemblerSha256 == rhs.tileIRAssemblerSha256 &&
+         lhs.compileOptionsIdentity == rhs.compileOptionsIdentity;
+}
+
+int fail(llvm::StringRef message) {
+  llvm::errs() << "error: " << message << "\n";
+  return 1;
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 2) {
+    return fail("expected exactly one TensorIR source path");
+  }
+  auto sourceOr = llvm::MemoryBuffer::getFile(argv[1]);
+  if (!sourceOr) {
+    return fail("failed to read TensorIR source");
+  }
+  auto target = SmTarget::fromCc(120, ArchPortability::arch_conditional);
+  if (failed(target)) {
+    return fail("failed to construct sm_120a target");
+  }
+
+  CudaTileCompileOptions tileIROptions(*target);
+  tileIROptions.tileSize = {16};
+  tileIROptions.maxTileCandidates = 0;
+  tileIROptions.allowEnvironmentOverrides = false;
+  tileIROptions.allowArtifactFallback = false;
+  tileIROptions.artifactKind = CudaTileArtifactKind::TileIR;
+
+  CudaTileCompiler compiler;
+  auto preparedOr = compiler.prepareToArtifact(
+      (*sourceOr)->getBuffer(), tileIROptions);
+  if (!preparedOr.ok()) {
+    return fail("prepareToArtifact failed: " + preparedOr.status().message());
+  }
+  CudaTilePreparedArtifact prepared = std::move(*preparedOr);
+  if (prepared.getTileIRBytecode().empty() ||
+      prepared.getRequestedArtifactKind() !=
+          CudaTileArtifactKind::TileIR ||
+      !sameTarget(prepared.getRequestedTarget(), *target) ||
+      prepared.getRuntimeKernelName().empty() ||
+      prepared.getEntryFunctionName().empty() ||
+      prepared.getArgLayout().tensorDescs.empty() ||
+      prepared.getStaticGrid()[0] <= 0 ||
+      prepared.getWorkspaceSizeBytes() != 0 ||
+      prepared.getWorkspaceAlignmentBytes() != 1 ||
+      prepared.getEnvironmentOverridesEnabled() ||
+      prepared.getArtifactFallbackAllowed() ||
+      prepared.getTileIRAssemblerTimeoutSeconds() !=
+          tileIROptions.tileIRAssemblerTimeoutSeconds ||
+      prepared.getCompileOptionsIdentity() !=
+          tileIROptions.toUniqueString()) {
+    return fail("prepared metadata differs from the resolved compile options");
+  }
+  llvm::outs() << "prepared-metadata: ok\n";
+
+  auto splitOr = compiler.assemblePreparedArtifact(std::move(prepared));
+  if (!splitOr.ok()) {
+    return fail("assemblePreparedArtifact failed: " +
+                splitOr.status().message());
+  }
+  auto wrappedOr =
+      compiler.compileToArtifact((*sourceOr)->getBuffer(), tileIROptions);
+  if (!wrappedOr.ok()) {
+    return fail("compileToArtifact failed: " + wrappedOr.status().message());
+  }
+  if (!sameArtifact(*splitOr, *wrappedOr)) {
+    return fail("two-stage result differs from compileToArtifact wrapper");
+  }
+  llvm::outs() << "wrapper-parity: ok\n";
+
+  CudaTileCompileOptions cubinOptions = tileIROptions;
+  cubinOptions.artifactKind = CudaTileArtifactKind::Cubin;
+  cubinOptions.tileIRAssemblerPath =
+      "/tensor-ir-test/nonexistent/tileiras";
+  cubinOptions.tileIRAssemblerVersion = "test-only";
+  cubinOptions.tileIRAssemblerSha256 = std::string(64, '0');
+  auto cubinPreparedOr = compiler.prepareToArtifact(
+      (*sourceOr)->getBuffer(), cubinOptions);
+  if (!cubinPreparedOr.ok()) {
+    return fail("Cubin preparation unexpectedly invoked the assembler: " +
+                cubinPreparedOr.status().message());
+  }
+  if (cubinPreparedOr->getRequestedArtifactKind() !=
+          CudaTileArtifactKind::Cubin ||
+      cubinPreparedOr->getTileIRAssemblerPath() !=
+          cubinOptions.tileIRAssemblerPath ||
+      cubinPreparedOr->getTileIRAssemblerVersion() !=
+          cubinOptions.tileIRAssemblerVersion ||
+      cubinPreparedOr->getTileIRAssemblerSha256() !=
+          cubinOptions.tileIRAssemblerSha256) {
+    return fail("Cubin preparation did not seal the assembler identity");
+  }
+  auto cubinOr =
+      compiler.assemblePreparedArtifact(std::move(*cubinPreparedOr));
+  if (cubinOr.ok() ||
+      cubinOr.status().message().find(
+          "Cubin was requested but no compatible TileIR assembler") ==
+          std::string::npos) {
+    return fail("assembler failure was not confined to final assembly");
+  }
+  llvm::outs() << "assembler-boundary: ok\n";
+  return 0;
+}
