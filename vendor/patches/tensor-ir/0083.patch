From 1ce28c3f90aad4ae111075e64ee53b3549d65422 Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Sat, 29 Aug 2026 06:55:09 +0800
Subject: [PATCH 83/89] Make TileIR assembler timeout explicit

---
 .../Compiler/CudaTile/CudaTileCompiler.h          |  6 ++++++
 .../tensor_ir/Compiler/CudaTile/TileIRAssembly.h  |  6 +++++-
 lib/Compiler/CudaTile/CudaTileCompiler.cpp        | 13 ++++++++++++-
 lib/Compiler/CudaTile/TileIRAssembly.cpp          | 15 ++++++++++-----
 4 files changed, 33 insertions(+), 7 deletions(-)

diff --git a/include/tensor_ir/Compiler/CudaTile/CudaTileCompiler.h b/include/tensor_ir/Compiler/CudaTile/CudaTileCompiler.h
index 2e4773e1d1c14ca2dcadcff7fdfde2197c618df8..de811bbe682d991f876cff64ff24cdead94b07eb 100644
--- a/include/tensor_ir/Compiler/CudaTile/CudaTileCompiler.h
+++ b/include/tensor_ir/Compiler/CudaTile/CudaTileCompiler.h
@@ -8,6 +8,7 @@
 
 #include "tensor_ir/Compiler/Compiler.h"
 #include "tensor_ir/Compiler/CudaTile/CudaTileArtifact.h"
+#include "tensor_ir/Compiler/CudaTile/TileIRAssembly.h"
 #include "tensor_ir/Conversion/TensorToCudaTile/Options.h"
 #include "tensor_ir/Runtime/IRuntimeKernel.h"
 #include "tensor_ir/Support/Status.h"
@@ -167,6 +168,11 @@ public:
   std::string tileIRAssemblerVersion;
   std::string tileIRAssemblerSha256;
 
+  /// Bounded tileiras subprocess timeout. Embedding compilers should set this
+  /// explicitly and include it in their immutable compile identity.
+  unsigned tileIRAssemblerTimeoutSeconds =
+      kDefaultTileIRAssemblerTimeoutSeconds;
+
   /// TileIR bytecode target version. Defaults to
   /// max(kCurrentCompatibilityVersion, 13.3) so generated bytecode stays within
   /// driver-compatible range while supporting TensorIR features that require
diff --git a/include/tensor_ir/Compiler/CudaTile/TileIRAssembly.h b/include/tensor_ir/Compiler/CudaTile/TileIRAssembly.h
index 0401c3c2f63808531dd7786c41b994320878afa8..f6d93f9a3a42f6f14aaf08da57b6a3f5d40f1dcb 100644
--- a/include/tensor_ir/Compiler/CudaTile/TileIRAssembly.h
+++ b/include/tensor_ir/Compiler/CudaTile/TileIRAssembly.h
@@ -16,6 +16,8 @@
 
 namespace mlir::nv_tensor_ir::backend::cuda_tile {
 
+inline constexpr unsigned kDefaultTileIRAssemblerTimeoutSeconds = 300;
+
 /// Assemble the TileIR bytecode into a cubin by invoking 'tileiras'
 /// as a subprocess for the given target and bytecode version.
 /// Returns std::nullopt when the assembler is unavailable or incompatible;
@@ -25,7 +27,9 @@ assembleTileIRToCubin(llvm::ArrayRef<char> bytecode, SmTarget target,
                       mlir::cuda_tile::BytecodeVersion bytecodeVersion,
                       llvm::StringRef assemblerPath = {},
                       llvm::StringRef assemblerVersion = {},
-                      llvm::StringRef assemblerSha256 = {});
+                      llvm::StringRef assemblerSha256 = {},
+                      unsigned timeoutSeconds =
+                          kDefaultTileIRAssemblerTimeoutSeconds);
 
 } // namespace mlir::nv_tensor_ir::backend::cuda_tile
 
diff --git a/lib/Compiler/CudaTile/CudaTileCompiler.cpp b/lib/Compiler/CudaTile/CudaTileCompiler.cpp
index 5aeec83cd007f58279989333f50b2f8b873a95ac..af297eead26ce849142c94b1c1dca7e61366f04b 100644
--- a/lib/Compiler/CudaTile/CudaTileCompiler.cpp
+++ b/lib/Compiler/CudaTile/CudaTileCompiler.cpp
@@ -393,7 +393,8 @@ StatusOr<CudaTileCompiledArtifact> CudaTileCompiler::compileToArtifact(
                               cudaTileOptions.bytecodeVersion,
                               cudaTileOptions.tileIRAssemblerPath,
                               cudaTileOptions.tileIRAssemblerVersion,
-                              cudaTileOptions.tileIRAssemblerSha256));
+                              cudaTileOptions.tileIRAssemblerSha256,
+                              cudaTileOptions.tileIRAssemblerTimeoutSeconds));
     if (cubin) {
       tileirBytecode = std::move(*cubin);
     } else if (!cudaTileOptions.allowArtifactFallback) {
@@ -522,6 +523,12 @@ Status CudaTileCompileOptions::validateDerived() const {
           "Deterministic cubin compilation requires a lowercase tileiras "
           "SHA-256");
     }
+    if (tileIRAssemblerTimeoutSeconds == 0 ||
+        tileIRAssemblerTimeoutSeconds > 3600) {
+      return Status::InvalidArgument(
+          "Deterministic cubin compilation requires a TileIR assembler "
+          "timeout in [1, 3600] seconds");
+    }
   }
   return Status::Ok();
 }
@@ -551,6 +558,8 @@ std::string CudaTileCompileOptions::toStringDerived() const {
   if (!tileIRAssemblerSha256.empty()) {
     s += "\nTileIR assembler SHA-256: " + tileIRAssemblerSha256;
   }
+  s += "\nTileIR assembler timeout seconds: " +
+       std::to_string(tileIRAssemblerTimeoutSeconds);
   if (!tileSize.empty()) {
     s += "\nTile size: ";
     for (size_t i = 0; i < tileSize.size(); ++i) {
@@ -593,6 +602,8 @@ std::string CudaTileCompileOptions::toUniqueStringDerived() const {
   s += "_assembler_sha256_" +
        std::to_string(tileIRAssemblerSha256.size()) + ":" +
        tileIRAssemblerSha256;
+  s += "_assembler_timeout_" +
+       std::to_string(tileIRAssemblerTimeoutSeconds);
   s += "_loadbc_" + std::to_string(irDebug.loadTileIRBCPath.size()) + ":" +
        irDebug.loadTileIRBCPath;
   s += "_bc";
diff --git a/lib/Compiler/CudaTile/TileIRAssembly.cpp b/lib/Compiler/CudaTile/TileIRAssembly.cpp
index 1a51fb41aeb761093211656f93b75e3c7adc530e..0d1ec066d2085c63a37cd8194890e61573faf32c 100644
--- a/lib/Compiler/CudaTile/TileIRAssembly.cpp
+++ b/lib/Compiler/CudaTile/TileIRAssembly.cpp
@@ -78,7 +78,6 @@ constexpr uint64_t kMaximumCubinBytes = 64ULL * 1024ULL * 1024ULL;
 constexpr uint64_t kMaximumChildFileBytes = 4096ULL * 1024ULL * 1024ULL;
 constexpr uint64_t kMaximumChildScratchBytes = 4096ULL * 1024ULL * 1024ULL;
 constexpr unsigned kMetadataCommandTimeoutSeconds = 30;
-constexpr unsigned kCompileCommandTimeoutSeconds = 300;
 constexpr unsigned kAssemblerMemoryLimitMiB = 4096;
 
 detail::ScratchScanResult classifyScratchScanError(std::error_code error) {
@@ -627,11 +626,16 @@ assembleWithExecutable(llvm::ArrayRef<char> bytecode, SmTarget target,
                        mlir::cuda_tile::BytecodeVersion bytecodeVersion,
                        llvm::StringRef assemblerPath,
                        llvm::StringRef assemblerVersion,
-                       llvm::StringRef assemblerSha256) {
+                       llvm::StringRef assemblerSha256,
+                       unsigned timeoutSeconds) {
   if (bytecode.empty() || bytecode.size() > kMaximumCubinBytes) {
     return Status::CompilationError(
         "TileIR assembler input must contain at most 64 MiB");
   }
+  if (timeoutSeconds == 0) {
+    return Status::InvalidArgument(
+        "TileIR assembler timeout must be positive");
+  }
   TIR_ASSIGN_OR_RETURN(auto temporaryDirectory, createTemporaryDirectory());
   std::string programStorage;
   if (assemblerPath.empty()) {
@@ -733,7 +737,7 @@ assembleWithExecutable(llvm::ArrayRef<char> bytecode, SmTarget target,
                                              inputFile.path};
   ProcessResult compile =
       runProgram(program, args, stdoutFile.path, stderrFile.path,
-                 producerBinDirectory, kCompileCommandTimeoutSeconds);
+                 producerBinDirectory, timeoutSeconds);
   if (compile.exitCode != 0) {
     return processError("tileiras compilation", compile, stderrFile.path);
   }
@@ -766,11 +770,12 @@ assembleTileIRToCubin(llvm::ArrayRef<char> bytecode, SmTarget target,
                       mlir::cuda_tile::BytecodeVersion bytecodeVersion,
                       llvm::StringRef assemblerPath,
                       llvm::StringRef assemblerVersion,
-                      llvm::StringRef assemblerSha256) {
+                      llvm::StringRef assemblerSha256,
+                      unsigned timeoutSeconds) {
 
   auto executable = assembleWithExecutable(bytecode, target, bytecodeVersion,
                                            assemblerPath, assemblerVersion,
-                                           assemblerSha256);
+                                           assemblerSha256, timeoutSeconds);
   if (executable.ok()) {
     return std::optional<llvm::SmallVector<char, 0>>(std::move(*executable));
   }
