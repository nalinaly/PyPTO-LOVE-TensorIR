+Status validateCompleteTileIR(llvm::ArrayRef<char> bytes) {
+  llvm::MemoryBufferRef buffer(
+      llvm::StringRef(bytes.data(), bytes.size()), "cuda-tile-artifact");
+  mlir::MLIRContext context(mlir::MLIRContext::Threading::DISABLED);
+  context.getOrLoadDialect<mlir::cuda_tile::CudaTileDialect>();
+  mlir::ScopedDiagnosticHandler handler(&context,
+                                        [](mlir::Diagnostic &) {});
+  auto module = mlir::cuda_tile::readBytecode(buffer, context);
+  if (!module) {
+    return Status::InvalidArgument("invalid or incomplete TileIR bytecode");
+  }
+  return Status::Ok();
+}
