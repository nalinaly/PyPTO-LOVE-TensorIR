diff --git a/lib/Compiler/CudaTile/TileIRAssembly.cpp b/lib/Compiler/CudaTile/TileIRAssembly.cpp
index 26cc6d6e4c3197c0bf2346aac12dea9c77371835..606d8a760e66989c8e35bd349f57acd29f9e355a 100644
--- a/lib/Compiler/CudaTile/TileIRAssembly.cpp
+++ b/lib/Compiler/CudaTile/TileIRAssembly.cpp
@@ -91,6 +91,54 @@ StatusOr<std::string> sha256File(llvm::StringRef path) {
       /*LowerCase=*/true);
 }
 
+StatusOr<TemporaryFile>
+materializeVerifiedProgram(llvm::StringRef sourcePath,
+                           llvm::StringRef expectedSha256) {
+  auto source = llvm::MemoryBuffer::getFile(sourcePath, /*IsText=*/false);
+  if (!source) {
+    return Status::NotFound("failed to read tileiras for verified copy: " +
+                            source.getError().message());
+  }
+  llvm::SHA256 sha;
+  sha.update((*source)->getBuffer());
+  auto digest = sha.final();
+  std::string actualSha256 = llvm::toHex(
+      llvm::ArrayRef<uint8_t>(digest.data(), digest.size()),
+      /*LowerCase=*/true);
+  if (actualSha256 != expectedSha256) {
+    return Status::CompilationError(
+        "tileiras SHA-256 differs from the expected producer identity");
+  }
+
+  TIR_ASSIGN_OR_RETURN(auto copy, createTemporaryFile("tileiras"));
+  std::error_code error;
+  llvm::raw_fd_ostream output(copy.path, error, llvm::sys::fs::OF_None);
+  if (error) {
+    return Status::CompilationError(
+        "failed to open verified tileiras copy: " + error.message());
+  }
+  llvm::StringRef bytes = (*source)->getBuffer();
+  output.write(bytes.data(), bytes.size());
+  output.close();
+  if (output.has_error()) {
+    output.clear_error();
+    return Status::CompilationError("failed to write verified tileiras copy");
+  }
+  error = llvm::sys::fs::setPermissions(
+      copy.path, llvm::sys::fs::owner_read | llvm::sys::fs::owner_exe);
+  if (error) {
+    return Status::CompilationError(
+        "failed to make verified tileiras copy executable: " +
+        error.message());
+  }
+  TIR_ASSIGN_OR_RETURN(auto copySha256, sha256File(copy.path));
+  if (copySha256 != expectedSha256) {
+    return Status::CompilationError(
+        "verified tileiras copy differs from expected producer identity");
+  }
+  return copy;
+}
