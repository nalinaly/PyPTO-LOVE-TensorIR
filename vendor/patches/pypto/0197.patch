       a.dense_strides != b.dense_strides || a_log.dtype != DataType::FP32 ||
-      dt_bias.dtype != DataType::FP32 || !SameTensor(a_log, dt_bias) ||
+      dt_bias.dtype != DataType::BF16 || a_log.shape != dt_bias.shape ||
+      a_log.dense_strides != dt_bias.dense_strides ||
       state.dtype != DataType::FP32 || state.shape.size() != 2 ||
       state.dense_strides[1] != 1 ||
       state.dense_strides[0] < state.shape[1] ||
@@ -5169,7 +5170,7 @@ NativeTileGdnRecurrentGraph AnalyzeNativeTileGdnRecurrent(
