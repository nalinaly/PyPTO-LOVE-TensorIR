   const std::string norm_type = TensorTypeText(norm);
   const std::string output_wide_type = TensorTypeText(output_wide);
   const std::string output_type = TensorTypeText(output);
@@ -8758,12 +8767,17 @@ std::string EmitNativeTileGdnRecurrentSource(
                 " = slice %arg4 starts = [" + std::to_string(head) +
                 ", 0] limits = [" + std::to_string(head + 1) + ", " +
                 std::to_string(graph.value_dim) + "] strides = [1, 1] : ";
-      source += parameter_type;
+      source += dt_type;
       source += " -> ";
-      source += parameter_row_type;
-      source += "\n    %dt_" + head_suffix + " = reshape %dt_row_" +
+      source += dt_parameter_row_type;
+      source += "\n    %dt_bf16_" + head_suffix + " = reshape %dt_row_" +
                 head_suffix + " : ";
-      source += parameter_row_type;
+      source += dt_parameter_row_type;
+      source += " -> ";
+      source += dt_parameter_column_type;
+      source += "\n    %dt_" + head_suffix + " = convert %dt_bf16_" +
+                head_suffix + " : ";
+      source += dt_parameter_column_type;
       source += " -> ";
       source += parameter_column_type;
 
