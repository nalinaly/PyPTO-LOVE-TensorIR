   const std::string gate_box_type = TensorTypeText(gate_box);
   const std::string parameter_group_type = TensorTypeText(parameter_group);
+  const std::string dt_parameter_group_type =
+      TensorTypeText(dt_parameter_group);
   const std::string output_group_type = TensorTypeText(output_group);
   const std::string output_group_bf16_type = TensorTypeText(output_group_bf16);
   const std::string output_box_type = TensorTypeText(output_box);
@@ -9266,8 +9285,12 @@ std::string EmitNativeTileGdnRecurrentBatchedSource(
   source += parameter_group_type;
   source += "\n    %expA_group = exp %A_group : ";
   source += parameter_group_type;
-  source += "\n    %dt_group = reshape %arg4 : ";
-  source += parameter_type;
+  source += "\n    %dt_group_bf16 = reshape %arg4 : ";
+  source += dt_type;
+  source += " -> ";
+  source += dt_parameter_group_type;
+  source += "\n    %dt_group = convert %dt_group_bf16 : ";
+  source += dt_parameter_group_type;
   source += " -> ";
   source += parameter_group_type;
   source += "\n    %epsilon = constant 9.999999974752427e-07 : f32";
