       {33, "tile.abs"},          {34, "tile.exp"},
       {35, "tile.log"},          {36, "tile.add"},
       {37, "tile.neg"},          {38, "tile.exp"},
@@ -8588,6 +8589,10 @@ std::string EmitNativeTileGdnRecurrentSource(
   StaticTensor parameter_column{DataType::FP32, {graph.value_dim, 1}, {}};
   parameter_column.dense_strides =
       MakeDenseStridesForMetadata(parameter_column.shape);
+  StaticTensor dt_parameter_row = parameter_row;
+  dt_parameter_row.dtype = DataType::BF16;
+  StaticTensor dt_parameter_column = parameter_column;
+  dt_parameter_column.dtype = DataType::BF16;
   StaticTensor norm{DataType::FP32, {1, 1}, {1, 1}};
   StaticTensor output_wide{DataType::FP32, {1, graph.value_dim}, {}};
   output_wide.dense_strides =
@@ -8613,6 +8618,7 @@ std::string EmitNativeTileGdnRecurrentSource(
   const std::string mixed_type = TensorTypeText(graph.mixed_qkv);
   const std::string a_type = TensorTypeText(graph.a);
   const std::string parameter_type = TensorTypeText(graph.a_log);
+  const std::string dt_type = TensorTypeText(graph.dt_bias);
   const std::string state_type = TensorTypeText(graph.state);
   const std::string indices_type = TensorTypeText(graph.state_indices);
   const std::string indices_i32_type = TensorTypeText(indices_i32);
@@ -8637,6 +8643,9 @@ std::string EmitNativeTileGdnRecurrentSource(
       TensorTypeText(wide_gate_column);
   const std::string parameter_row_type = TensorTypeText(parameter_row);
   const std::string parameter_column_type = TensorTypeText(parameter_column);
+  const std::string dt_parameter_row_type = TensorTypeText(dt_parameter_row);
+  const std::string dt_parameter_column_type =
