   gate_box.dense_strides = MakeDenseStridesForMetadata(gate_box.shape);
   StaticTensor parameter_group = wide_value_group;
+  StaticTensor dt_parameter_group = parameter_group;
+  dt_parameter_group.dtype = DataType::BF16;
   StaticTensor output_group{DataType::FP32,
                             {graph.q_heads, heads_per_query, 1,
                              graph.value_dim}, {}};
@@ -9204,6 +9220,7 @@ std::string EmitNativeTileGdnRecurrentBatchedSource(
   const std::string mixed_type = TensorTypeText(graph.mixed_qkv);
   const std::string gate_type = TensorTypeText(graph.a);
   const std::string parameter_type = TensorTypeText(graph.a_log);
+  const std::string dt_type = TensorTypeText(graph.dt_bias);
   const std::string state_type = TensorTypeText(graph.state);
   const std::string indices_type = TensorTypeText(graph.state_indices);
   const std::string indices_i32_type = TensorTypeText(indices_i32);
@@ -9223,6 +9240,8 @@ std::string EmitNativeTileGdnRecurrentBatchedSource(
