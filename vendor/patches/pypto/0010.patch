+def test_projection_digests_are_sha256_of_distinct_canonical_domains() -> None:
+    value = request()
+    byte_projection = value.serialize_byte_compile_identity()
+    loader_projection = value.serialize_loader_compatibility_input()
+    device_projection = value.serialize_device_autotune_identity()
+
+    assert value.byte_compile_identity_digest == hashlib.sha256(byte_projection).hexdigest()
+    assert value.loader_compatibility_input_digest == hashlib.sha256(loader_projection).hexdigest()
+    assert value.device_autotune_identity_digest == hashlib.sha256(device_projection).hexdigest()
+    # Fixed vectors lock both the canonical projection schema and the in-tree C++ SHA-256.
+    assert value.byte_compile_identity_digest == (
+        "4f2d7a90b70af99e56362d650aa93f164821be00a4c0220375eacb208b98e436"
+    )
+    assert value.loader_compatibility_input_digest == (
+        "d8c39f9ca5fe309425867f0b82ca21677d5d2fd5bac06b773d8ec7c6c0ad5807"
+    )
+    assert value.device_autotune_identity_digest == (
+        "0b5469b93172e567cade8b77ed5d621261bf4aa4b6f259598e8719ec71061d4c"
+    )
+    assert len(
+        {
+            value.byte_compile_identity_digest,
+            value.loader_compatibility_input_digest,
+            value.device_autotune_identity_digest,
+        }
+    ) == 3
