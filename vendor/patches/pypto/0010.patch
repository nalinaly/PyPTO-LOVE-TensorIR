+        ("tensor_ir_revision", "A" * 40, "lowercase"),
+        ("llvm_revision", "1" * 39, "40-character"),
+        ("cuda_toolkit_root", "relative/cuda", "absolute"),
+        ("tileiras_real_path", "/", "filesystem root"),
+        ("tileiras_sha256", "f" * 63, "64-character"),
+        ("tileiras_sha256", "F" * 64, "lowercase"),
