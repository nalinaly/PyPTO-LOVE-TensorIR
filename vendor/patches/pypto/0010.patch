+}  // namespace
+
+int main() {
+  static_assert(!std::is_default_constructible_v<ToolchainIdentity>);
+  static_assert(!std::is_copy_assignable_v<ToolchainIdentity>);
+  static_assert(!std::is_move_assignable_v<ToolchainIdentity>);
+  static_assert(!std::is_default_constructible_v<CompileRequest>);
+  static_assert(!std::is_copy_assignable_v<CompileRequest>);
+  static_assert(!std::is_move_assignable_v<CompileRequest>);
+
+  const auto target = ValidTarget();
+  const CompileRequest owned_request(target, ValidToolchain());
+  REQUIRE(&owned_request.GetTargetInfo() != &target);
+  REQUIRE(owned_request.GetRequestSchemaVersion() == 1);
+  REQUIRE(owned_request.GetCompilerAbiVersion() == 1);
+  REQUIRE(owned_request.GetRequestedArtifactPolicy() == RequestedArtifactPolicy::CubinOnly);
+  REQUIRE(owned_request.GetCompilerPolicy() == CompilerPolicy::DeterministicStrict);
+  REQUIRE(owned_request.GetVerificationPolicy() == VerificationPolicy::Strict);
+
+  const std::vector<uint8_t> canonical = owned_request.SerializeCanonical();
+  const CompileRequest round_trip = CompileRequest::DeserializeCanonical(canonical);
+  REQUIRE(round_trip.SerializeCanonical() == canonical);
+  REQUIRE(round_trip.GetTargetInfo().GetDeviceUuid() == "GPU-test");
+  REQUIRE(round_trip.GetToolchainIdentity().GetTileirasRealPath() == "/opt/cuda-13.3/bin/tileiras");
+  REQUIRE(round_trip.GetByteCompileIdentityDigest().size() == 64);
+  REQUIRE(round_trip.GetLoaderCompatibilityInputDigest().size() == 64);
+  REQUIRE(round_trip.GetDeviceAutotuneIdentityDigest().size() == 64);
+  REQUIRE(round_trip.GetByteCompileIdentityDigest() ==
+          "4f2d7a90b70af99e56362d650aa93f164821be00a4c0220375eacb208b98e436");
+  REQUIRE(round_trip.GetLoaderCompatibilityInputDigest() ==
+          "d8c39f9ca5fe309425867f0b82ca21677d5d2fd5bac06b773d8ec7c6c0ad5807");
+  REQUIRE(round_trip.GetDeviceAutotuneIdentityDigest() ==
+          "0b5469b93172e567cade8b77ed5d621261bf4aa4b6f259598e8719ec71061d4c");
+  REQUIRE(round_trip.GetByteCompileIdentityDigest() != round_trip.GetLoaderCompatibilityInputDigest());
+  REQUIRE(round_trip.GetByteCompileIdentityDigest() != round_trip.GetDeviceAutotuneIdentityDigest());
+
+  const CompileRequest other_device = ValidRequest(7, "GPU-other");
+  REQUIRE(other_device.GetByteCompileIdentityDigest() == owned_request.GetByteCompileIdentityDigest());
+  REQUIRE(other_device.GetLoaderCompatibilityInputDigest() ==
+          owned_request.GetLoaderCompatibilityInputDigest());
+  REQUIRE(other_device.GetDeviceAutotuneIdentityDigest() != owned_request.GetDeviceAutotuneIdentityDigest());
