+ * See LICENSE in the root of the software repository for the full text of the License.
+ * -----------------------------------------------------------------------------------------------------------
+ */
+
+#ifndef PYPTO_COMPILER_COMPILE_REQUEST_H_
+#define PYPTO_COMPILER_COMPILE_REQUEST_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "pypto/backend/common/backend_type.h"
+#include "pypto/compiler/target_info.h"
+
+namespace pypto::compiler {
+
+/** Requested output policy. V1 deliberately accepts native Cubin only. */
+enum class RequestedArtifactPolicy : uint8_t {
+  CubinOnly = 0,
+};
+
+/** Compiler option policy. V1 requires rejection of ambient and nondeterministic overrides. */
+enum class CompilerPolicy : uint8_t {
+  DeterministicStrict = 0,
+};
+
+/** Validation policy for request, producer, and eventual artifact boundaries. */
+enum class VerificationPolicy : uint8_t {
+  Strict = 0,
+};
+
+/**
+ * Exact, filesystem-independent identity of the compiler toolchain selected by the parent.
+ *
+ * Paths must already be canonical absolute values. In particular, the parent must resolve
+ * tileiras_real_path and hash that executable; this value object performs no filesystem query.
+ */
+class ToolchainIdentity {
+ public:
+  ToolchainIdentity() = delete;
+  ToolchainIdentity(std::string pypto_revision, std::string tensor_ir_revision,
+                    std::string cuda_tile_revision, std::string llvm_revision, std::string cuda_toolkit_root,
+                    std::string cuda_toolkit_version, std::string tileiras_real_path,
+                    std::string tileiras_version, std::string tileiras_sha256);
+  ToolchainIdentity(const ToolchainIdentity&) = default;
+  ToolchainIdentity(ToolchainIdentity&&) = default;
+  ToolchainIdentity& operator=(const ToolchainIdentity&) = delete;
+  ToolchainIdentity& operator=(ToolchainIdentity&&) = delete;
+
+  [[nodiscard]] const std::string& GetPyptoRevision() const noexcept { return pypto_revision_; }
+  [[nodiscard]] const std::string& GetTensorIrRevision() const noexcept { return tensor_ir_revision_; }
+  [[nodiscard]] const std::string& GetCudaTileRevision() const noexcept { return cuda_tile_revision_; }
+  [[nodiscard]] const std::string& GetLlvmRevision() const noexcept { return llvm_revision_; }
+  [[nodiscard]] const std::string& GetCudaToolkitRoot() const noexcept { return cuda_toolkit_root_; }
+  [[nodiscard]] const std::string& GetCudaToolkitVersion() const noexcept { return cuda_toolkit_version_; }
+  [[nodiscard]] const std::string& GetTileirasRealPath() const noexcept { return tileiras_real_path_; }
+  [[nodiscard]] const std::string& GetTileirasVersion() const noexcept { return tileiras_version_; }
+  [[nodiscard]] const std::string& GetTileirasSha256() const noexcept { return tileiras_sha256_; }
+
+ private:
+  std::string pypto_revision_;
+  std::string tensor_ir_revision_;
+  std::string cuda_tile_revision_;
+  std::string llvm_revision_;
+  std::string cuda_toolkit_root_;
+  std::string cuda_toolkit_version_;
+  std::string tileiras_real_path_;
+  std::string tileiras_version_;
+  std::string tileiras_sha256_;
+};
+
+/**
+ * Immutable, pointer-free CompileRequest v1.
+ *
+ * The request value-owns its target and toolchain identities. It contains no source region,
+ * schedule, compiled bytes, CUDA handle, stream, pointer, or runtime state.
+ */
+class CompileRequest {
+ public:
+  static constexpr uint32_t kRequestSchemaVersion = 1;
+  static constexpr uint32_t kCompilerAbiVersion = 1;
+
+  CompileRequest() = delete;
+  CompileRequest(NvidiaTargetInfo target_info, ToolchainIdentity toolchain_identity,
+                 RequestedArtifactPolicy requested_artifact_policy = RequestedArtifactPolicy::CubinOnly,
+                 CompilerPolicy compiler_policy = CompilerPolicy::DeterministicStrict,
+                 VerificationPolicy verification_policy = VerificationPolicy::Strict);
+  CompileRequest(const CompileRequest&) = default;
+  CompileRequest(CompileRequest&&) = default;
+  CompileRequest& operator=(const CompileRequest&) = delete;
+  CompileRequest& operator=(CompileRequest&&) = delete;
+
+  [[nodiscard]] constexpr uint32_t GetRequestSchemaVersion() const noexcept { return kRequestSchemaVersion; }
+  [[nodiscard]] constexpr uint32_t GetCompilerAbiVersion() const noexcept { return kCompilerAbiVersion; }
+  [[nodiscard]] backend::BackendType GetBackendType() const noexcept { return backend::BackendType::Nvidia; }
+  [[nodiscard]] const NvidiaTargetInfo& GetTargetInfo() const noexcept { return target_info_; }
+  [[nodiscard]] const ToolchainIdentity& GetToolchainIdentity() const noexcept { return toolchain_identity_; }
+  [[nodiscard]] RequestedArtifactPolicy GetRequestedArtifactPolicy() const noexcept {
+    return requested_artifact_policy_;
+  }
+  [[nodiscard]] CompilerPolicy GetCompilerPolicy() const noexcept { return compiler_policy_; }
+  [[nodiscard]] VerificationPolicy GetVerificationPolicy() const noexcept { return verification_policy_; }
+
+  /** Serialize the complete request as canonical MessagePack. */
+  [[nodiscard]] std::vector<uint8_t> SerializeCanonical() const;
+
+  /** Deserialize canonical MessagePack, rejecting malformed, noncanonical, and unknown data. */
+  [[nodiscard]] static CompileRequest DeserializeCanonical(const std::vector<uint8_t>& data);
+
+  /** Canonical byte identity, excluding physical-device, driver-only, and capacity fields. */
+  [[nodiscard]] std::vector<uint8_t> SerializeByteCompileIdentity() const;
+  [[nodiscard]] std::string GetByteCompileIdentityDigest() const;
+
+  /**
+   * Canonical request-side loader compatibility input.
+   *
+   * This is not an artifact compatibility result: the eventual artifact must add its actual
+   * kind, target, and runtime requirements before load.
+   */
+  [[nodiscard]] std::vector<uint8_t> SerializeLoaderCompatibilityInput() const;
+  [[nodiscard]] std::string GetLoaderCompatibilityInputDigest() const;
+
+  /** Canonical identity for device-specific autotuning and measurement records. */
+  [[nodiscard]] std::vector<uint8_t> SerializeDeviceAutotuneIdentity() const;
+  [[nodiscard]] std::string GetDeviceAutotuneIdentityDigest() const;
+
+ private:
+  NvidiaTargetInfo target_info_;
+  ToolchainIdentity toolchain_identity_;
+  RequestedArtifactPolicy requested_artifact_policy_;
+  CompilerPolicy compiler_policy_;
+  VerificationPolicy verification_policy_;
+};
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_COMPILE_REQUEST_H_
diff --git a/python/bindings/modules/compiler.cpp b/python/bindings/modules/compiler.cpp
index 2a7d80fff135748b6486ed146ad4d6a85e2c1396..997995d48d5e82df28a81562b800b08c6d019f92 100644
--- a/python/bindings/modules/compiler.cpp
+++ b/python/bindings/modules/compiler.cpp
@@ -14,15 +14,42 @@
 #include <nanobind/stl/vector.h>
 
 #include "../module.h"
+#include "pypto/compiler/compile_request.h"
 #include "pypto/compiler/target_info.h"
 
 namespace nb = nanobind;
 
 namespace pypto::python {
+namespace {
+
+nb::bytes ToPythonBytes(const std::vector<uint8_t>& data) {
+  return nb::bytes(reinterpret_cast<const char*>(data.data()), data.size());
+}
+
+std::vector<uint8_t> FromPythonBytes(const nb::bytes& data) {
+  const auto* begin = static_cast<const uint8_t*>(data.data());
+  return std::vector<uint8_t>(begin, begin + data.size());
+}
+
+}  // namespace
 
 void BindCompiler(nb::module_& m) {
   nb::module_ compiler_mod = m.def_submodule("compiler", "PyPTO compiler target contracts");
 
+  nb::enum_<compiler::RequestedArtifactPolicy>(compiler_mod, "RequestedArtifactPolicy",
+                                               "Requested compiler output policy")
+      .value("CubinOnly", compiler::RequestedArtifactPolicy::CubinOnly,
+             "Require later artifact validation to reject non-Cubin output");
+
+  nb::enum_<compiler::CompilerPolicy>(compiler_mod, "CompilerPolicy", "Deterministic compiler option policy")
+      .value("DeterministicStrict", compiler::CompilerPolicy::DeterministicStrict,
+             "Require a later compiler to reject ambient and nondeterministic overrides");
+
+  nb::enum_<compiler::VerificationPolicy>(compiler_mod, "VerificationPolicy",
+                                          "Compile request verification policy")
+      .value("Strict", compiler::VerificationPolicy::Strict,
+             "Require strict request, producer, and artifact verification");
+
   nb::class_<compiler::TargetTraits>(compiler_mod, "TargetTraits")
       .def(nb::init<int, int, int, int, int, int, int, int, int, int, int, int, uint64_t,
                     uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t,
@@ -96,6 +123,74 @@ void BindCompiler(nb::module_& m) {
       .def("supports_compute_dtype", &compiler::NvidiaTargetInfo::SupportsComputeDtype,
            nb::arg("dtype"));
 
+  nb::class_<compiler::ToolchainIdentity>(
+      compiler_mod, "ToolchainIdentity",
+      "Exact source, CUDA toolkit, and tileiras identity selected by the parent process")
+      .def(nb::init<std::string, std::string, std::string, std::string, std::string, std::string, std::string,
+                    std::string, std::string>(),
+           nb::arg("pypto_revision"), nb::arg("tensor_ir_revision"), nb::arg("cuda_tile_revision"),
+           nb::arg("llvm_revision"), nb::arg("cuda_toolkit_root"), nb::arg("cuda_toolkit_version"),
+           nb::arg("tileiras_real_path"), nb::arg("tileiras_version"), nb::arg("tileiras_sha256"))
+      .def_prop_ro("pypto_revision", &compiler::ToolchainIdentity::GetPyptoRevision)
+      .def_prop_ro("tensor_ir_revision", &compiler::ToolchainIdentity::GetTensorIrRevision)
+      .def_prop_ro("cuda_tile_revision", &compiler::ToolchainIdentity::GetCudaTileRevision)
+      .def_prop_ro("llvm_revision", &compiler::ToolchainIdentity::GetLlvmRevision)
+      .def_prop_ro("cuda_toolkit_root", &compiler::ToolchainIdentity::GetCudaToolkitRoot)
+      .def_prop_ro("cuda_toolkit_version", &compiler::ToolchainIdentity::GetCudaToolkitVersion)
+      .def_prop_ro("tileiras_real_path", &compiler::ToolchainIdentity::GetTileirasRealPath)
+      .def_prop_ro("tileiras_version", &compiler::ToolchainIdentity::GetTileirasVersion)
+      .def_prop_ro("tileiras_sha256", &compiler::ToolchainIdentity::GetTileirasSha256);
+
+  nb::class_<compiler::CompileRequest>(
+      compiler_mod, "CompileRequest",
+      "Immutable pointer-free v1 compiler policy and target worker payload")
+      .def(
+          nb::init<compiler::NvidiaTargetInfo, compiler::ToolchainIdentity, compiler::RequestedArtifactPolicy,
+                   compiler::CompilerPolicy, compiler::VerificationPolicy>(),
+          nb::arg("target_info"), nb::arg("toolchain_identity"),
+          nb::arg("requested_artifact_policy") = compiler::RequestedArtifactPolicy::CubinOnly,
+          nb::arg("compiler_policy") = compiler::CompilerPolicy::DeterministicStrict,
+          nb::arg("verification_policy") = compiler::VerificationPolicy::Strict)
+      .def_prop_ro("request_schema_version", &compiler::CompileRequest::GetRequestSchemaVersion)
+      .def_prop_ro("compiler_abi_version", &compiler::CompileRequest::GetCompilerAbiVersion)
+      .def_prop_ro("backend_type", &compiler::CompileRequest::GetBackendType)
+      .def_prop_ro("target_info", &compiler::CompileRequest::GetTargetInfo, nb::rv_policy::reference_internal)
+      .def_prop_ro("toolchain_identity", &compiler::CompileRequest::GetToolchainIdentity,
+                   nb::rv_policy::reference_internal)
+      .def_prop_ro("requested_artifact_policy", &compiler::CompileRequest::GetRequestedArtifactPolicy)
+      .def_prop_ro("compiler_policy", &compiler::CompileRequest::GetCompilerPolicy)
+      .def_prop_ro("verification_policy", &compiler::CompileRequest::GetVerificationPolicy)
+      .def(
+          "serialize",
+          [](const compiler::CompileRequest& request) { return ToPythonBytes(request.SerializeCanonical()); },
+          "Serialize the complete request as canonical MessagePack bytes")
+      .def_static("deserialize",
+                  [](const nb::bytes& data) {
+                    return compiler::CompileRequest::DeserializeCanonical(FromPythonBytes(data));
+                  },
+                  nb::arg("data"),
+                  "Deserialize canonical MessagePack and reject malformed or unknown data")
+      .def("serialize_byte_compile_identity",
+           [](const compiler::CompileRequest& request) {
+             return ToPythonBytes(request.SerializeByteCompileIdentity());
+           },
+           "Serialize the byte-producing identity projection")
+      .def_prop_ro("byte_compile_identity_digest", &compiler::CompileRequest::GetByteCompileIdentityDigest)
+      .def("serialize_loader_compatibility_input",
+           [](const compiler::CompileRequest& request) {
+             return ToPythonBytes(request.SerializeLoaderCompatibilityInput());
+           },
+           "Serialize request-side loader compatibility policy input")
+      .def_prop_ro("loader_compatibility_input_digest",
+                   &compiler::CompileRequest::GetLoaderCompatibilityInputDigest)
+      .def("serialize_device_autotune_identity",
+           [](const compiler::CompileRequest& request) {
+             return ToPythonBytes(request.SerializeDeviceAutotuneIdentity());
+           },
+           "Serialize the physical-device and autotuning identity projection")
+      .def_prop_ro("device_autotune_identity_digest",
+                   &compiler::CompileRequest::GetDeviceAutotuneIdentityDigest);
+
   compiler_mod.def("is_supported_nvidia_compute_capability",
                    &compiler::IsSupportedNvidiaComputeCapability, nb::arg("compute_capability"));
 }
