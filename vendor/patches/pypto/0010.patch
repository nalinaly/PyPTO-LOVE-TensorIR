+void RequireText(const std::string& value, const std::string& field_name) {
+  const auto is_ascii_whitespace = [](unsigned char character) {
+    return character == ' ' || character == '\t' || character == '\n' || character == '\r' ||
+           character == '\f' || character == '\v';
+  };
+  if (value.empty() || is_ascii_whitespace(static_cast<unsigned char>(value.front())) ||
+      is_ascii_whitespace(static_cast<unsigned char>(value.back())) ||
+      value.find('\0') != std::string::npos) {
+    throw ValueError(field_name + " must be non-empty, trimmed, and contain no NUL bytes");
+  }
+  if (value.size() > kMaximumStringBytes) {
+    throw ValueError(field_name + " exceeds the CompileRequest v1 string-size limit");
+  }
+}
+
+void RequireFullRevision(const std::string& value, const std::string& field_name) {
+  if (value.size() != 40 || !std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+      })) {
+    throw ValueError(field_name + " must be a full 40-character lowercase hexadecimal revision");
+  }
+}
+
+void RequireSha256(const std::string& value, const std::string& field_name) {
+  if (value.size() != 64 || !std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+      })) {
+    throw ValueError(field_name + " must be a 64-character lowercase hexadecimal SHA-256");
+  }
+}
