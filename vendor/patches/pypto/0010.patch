+class StrictMap {
+ public:
+  StrictMap(const msgpack::object& object, std::string context,
+            std::initializer_list<std::string_view> allowed_fields)
+      : context_(std::move(context)) {
+    if (object.type != msgpack::type::MAP) {
+      throw ValueError(context_ + " must be a map");
+    }
+    std::map<std::string, bool> allowed;
+    for (std::string_view field : allowed_fields) allowed.emplace(field, true);
+    for (uint32_t i = 0; i < object.via.map.size; ++i) {
+      const auto& entry = object.via.map.ptr[i];
+      if (entry.key.type != msgpack::type::STR) {
+        throw ValueError(context_ + " field names must be strings");
+      }
+      std::string key(entry.key.via.str.ptr, entry.key.via.str.size);
+      if (allowed.find(key) == allowed.end()) {
+        throw ValueError(context_ + " contains unknown field '" + key + "'");
+      }
+      if (!fields_.emplace(std::move(key), &entry.val).second) {
+        throw ValueError(context_ + " contains a duplicate field");
+      }
+    }
+  }
+
+  [[nodiscard]] const msgpack::object& Get(const std::string& field) const {
+    const auto iterator = fields_.find(field);
+    if (iterator == fields_.end()) throw ValueError(context_ + " is missing required field '" + field + "'");
+    return *iterator->second;
+  }
+
+ private:
+  std::string context_;
+  std::map<std::string, const msgpack::object*> fields_;
+};
+
+std::string ReadText(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::STR) throw ValueError(context + " must be a string");
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+uint64_t ReadUint64(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::POSITIVE_INTEGER) {
+    throw ValueError(context + " must be an unsigned integer");
+  }
+  return object.via.u64;
+}
+
+uint32_t ReadUint32(const msgpack::object& object, const std::string& context) {
+  const uint64_t value = ReadUint64(object, context);
+  if (value > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError(context + " exceeds uint32 range");
+  }
+  return static_cast<uint32_t>(value);
+}
+
+int ReadInt(const msgpack::object& object, const std::string& context) {
+  if (object.type == msgpack::type::POSITIVE_INTEGER) {
+    if (object.via.u64 > static_cast<uint64_t>(std::numeric_limits<int>::max())) {
+      throw ValueError(context + " exceeds int range");
+    }
+    return static_cast<int>(object.via.u64);
+  }
+  if (object.type == msgpack::type::NEGATIVE_INTEGER) {
+    if (object.via.i64 < std::numeric_limits<int>::min()) {
+      throw ValueError(context + " exceeds int range");
+    }
+    return static_cast<int>(object.via.i64);
+  }
+  throw ValueError(context + " must be an integer");
+}
+
+TargetTraits ParseTargetTraits(const msgpack::object& object) {
+  StrictMap fields(object, "CompileRequest.target.traits",
+                   {"compute_capability",
+                    "default_shared_memory_per_cta_bytes",
+                    "l1_cache_line_bytes",
+                    "l2_cache_size_bytes",
+                    "max_block_dim_x",
+                    "max_block_dim_y",
+                    "max_block_dim_z",
+                    "max_blocks_per_multiprocessor",
+                    "max_grid_dim_x",
+                    "max_grid_dim_y",
+                    "max_grid_dim_z",
+                    "max_registers_per_thread",
+                    "max_shared_memory_per_cta_bytes",
+                    "max_threads_per_block",
+                    "max_threads_per_multiprocessor",
+                    "multiprocessor_count",
+                    "registers_per_cta",
+                    "registers_per_multiprocessor",
+                    "shared_memory_per_multiprocessor_bytes",
+                    "total_global_memory_bytes",
+                    "warp_size"});
+  return TargetTraits(
+      ReadInt(fields.Get("compute_capability"), "target.traits.compute_capability"),
+      ReadInt(fields.Get("multiprocessor_count"), "target.traits.multiprocessor_count"),
+      ReadInt(fields.Get("warp_size"), "target.traits.warp_size"),
+      ReadInt(fields.Get("max_threads_per_block"), "target.traits.max_threads_per_block"),
+      ReadInt(fields.Get("max_threads_per_multiprocessor"), "target.traits.max_threads_per_multiprocessor"),
+      ReadInt(fields.Get("max_blocks_per_multiprocessor"), "target.traits.max_blocks_per_multiprocessor"),
+      ReadInt(fields.Get("max_block_dim_x"), "target.traits.max_block_dim_x"),
+      ReadInt(fields.Get("max_block_dim_y"), "target.traits.max_block_dim_y"),
+      ReadInt(fields.Get("max_block_dim_z"), "target.traits.max_block_dim_z"),
+      ReadInt(fields.Get("max_grid_dim_x"), "target.traits.max_grid_dim_x"),
+      ReadInt(fields.Get("max_grid_dim_y"), "target.traits.max_grid_dim_y"),
+      ReadInt(fields.Get("max_grid_dim_z"), "target.traits.max_grid_dim_z"),
+      ReadUint64(fields.Get("l1_cache_line_bytes"), "target.traits.l1_cache_line_bytes"),
+      ReadUint64(fields.Get("default_shared_memory_per_cta_bytes"),
+                 "target.traits.default_shared_memory_per_cta_bytes"),
+      ReadUint64(fields.Get("max_shared_memory_per_cta_bytes"),
+                 "target.traits.max_shared_memory_per_cta_bytes"),
+      ReadUint64(fields.Get("shared_memory_per_multiprocessor_bytes"),
+                 "target.traits.shared_memory_per_multiprocessor_bytes"),
+      ReadUint64(fields.Get("registers_per_cta"), "target.traits.registers_per_cta"),
+      ReadUint64(fields.Get("max_registers_per_thread"), "target.traits.max_registers_per_thread"),
+      ReadUint64(fields.Get("registers_per_multiprocessor"), "target.traits.registers_per_multiprocessor"),
+      ReadUint64(fields.Get("l2_cache_size_bytes"), "target.traits.l2_cache_size_bytes"),
+      ReadUint64(fields.Get("total_global_memory_bytes"), "target.traits.total_global_memory_bytes"));
+}
+
+std::vector<DataType> ParseDtypes(const msgpack::object& object) {
+  if (object.type != msgpack::type::ARRAY) {
+    throw ValueError("CompileRequest.target.supported_compute_dtypes must be an array");
+  }
+  std::vector<DataType> dtypes;
+  dtypes.reserve(object.via.array.size);
+  for (uint32_t i = 0; i < object.via.array.size; ++i) {
+    const uint64_t code = ReadUint64(object.via.array.ptr[i], "target.supported_compute_dtypes item");
+    if (code > std::numeric_limits<uint8_t>::max()) {
+      throw ValueError("target.supported_compute_dtypes item exceeds uint8 range");
+    }
+    dtypes.emplace_back(static_cast<uint8_t>(code));
+  }
+  return dtypes;
+}
+
+NvidiaTargetInfo ParseTarget(const msgpack::object& object) {
+  StrictMap fields(
+      object, "CompileRequest.target",
+      {"cuda_driver_version", "cuda_tile_revision", "cuda_toolkit_version", "device_name", "device_ordinal",
+       "device_uuid", "pci_device_id", "supported_compute_dtypes", "tensor_ir_revision", "traits"});
+  return NvidiaTargetInfo(ReadInt(fields.Get("device_ordinal"), "target.device_ordinal"),
+                          ReadText(fields.Get("device_name"), "target.device_name"),
+                          ReadText(fields.Get("device_uuid"), "target.device_uuid"),
+                          ReadText(fields.Get("pci_device_id"), "target.pci_device_id"),
+                          ParseTargetTraits(fields.Get("traits")),
+                          ReadText(fields.Get("cuda_toolkit_version"), "target.cuda_toolkit_version"),
+                          ReadText(fields.Get("cuda_driver_version"), "target.cuda_driver_version"),
+                          ReadText(fields.Get("tensor_ir_revision"), "target.tensor_ir_revision"),
+                          ReadText(fields.Get("cuda_tile_revision"), "target.cuda_tile_revision"),
+                          ParseDtypes(fields.Get("supported_compute_dtypes")));
+}
+
+ToolchainIdentity ParseToolchain(const msgpack::object& object) {
+  StrictMap fields(
+      object, "CompileRequest.toolchain",
+      {"cuda_tile_revision", "cuda_toolkit_root", "cuda_toolkit_version", "llvm_revision", "pypto_revision",
+       "tensor_ir_revision", "tileiras_real_path", "tileiras_sha256", "tileiras_version"});
+  return ToolchainIdentity(ReadText(fields.Get("pypto_revision"), "toolchain.pypto_revision"),
+                           ReadText(fields.Get("tensor_ir_revision"), "toolchain.tensor_ir_revision"),
+                           ReadText(fields.Get("cuda_tile_revision"), "toolchain.cuda_tile_revision"),
+                           ReadText(fields.Get("llvm_revision"), "toolchain.llvm_revision"),
+                           ReadText(fields.Get("cuda_toolkit_root"), "toolchain.cuda_toolkit_root"),
+                           ReadText(fields.Get("cuda_toolkit_version"), "toolchain.cuda_toolkit_version"),
+                           ReadText(fields.Get("tileiras_real_path"), "toolchain.tileiras_real_path"),
+                           ReadText(fields.Get("tileiras_version"), "toolchain.tileiras_version"),
+                           ReadText(fields.Get("tileiras_sha256"), "toolchain.tileiras_sha256"));
+}
+
+RequestedArtifactPolicy ParseRequestedArtifactPolicy(const msgpack::object& object) {
+  const std::string value = ReadText(object, "requested_artifact_policy");
+  if (value == RequestedArtifactPolicyName(RequestedArtifactPolicy::CubinOnly)) {
+    return RequestedArtifactPolicy::CubinOnly;
+  }
+  throw ValueError("unsupported requested_artifact_policy '" + value + "'; v1 requires cubin-only");
+}
+
+CompilerPolicy ParseCompilerPolicy(const msgpack::object& object) {
+  const std::string value = ReadText(object, "compiler_policy");
+  if (value == CompilerPolicyName(CompilerPolicy::DeterministicStrict)) {
+    return CompilerPolicy::DeterministicStrict;
+  }
+  throw ValueError("unsupported compiler_policy '" + value + "'; v1 requires deterministic-strict");
+}
+
+VerificationPolicy ParseVerificationPolicy(const msgpack::object& object) {
+  const std::string value = ReadText(object, "verification_policy");
+  if (value == VerificationPolicyName(VerificationPolicy::Strict)) {
+    return VerificationPolicy::Strict;
+  }
+  throw ValueError("unsupported verification_policy '" + value + "'; v1 requires strict");
+}
+
+msgpack::object_handle UnpackOne(const std::vector<uint8_t>& data) {
+  if (data.empty()) throw ValueError("CompileRequest payload must not be empty");
+  if (data.size() > kMaximumSerializedRequestBytes) {
+    throw ValueError("CompileRequest payload exceeds the 1 MiB v1 limit");
+  }
+  size_t offset = 0;
+  const msgpack::unpack_limit limits(kMaximumArrayItems, kMaximumMapItems, kMaximumStringBytes, 0, 0,
+                                     kMaximumNestingDepth);
+  msgpack::object_handle handle = [&]() {
+    try {
+      return msgpack::unpack(reinterpret_cast<const char*>(data.data()), data.size(), offset, nullptr,
+                             nullptr, limits);
+    } catch (const msgpack::unpack_error& error) {
+      throw ValueError("malformed CompileRequest MessagePack: " + std::string(error.what()));
+    }
+  }();
+  if (offset != data.size()) {
+    throw ValueError("CompileRequest payload contains trailing bytes");
+  }
+  return handle;
+}
