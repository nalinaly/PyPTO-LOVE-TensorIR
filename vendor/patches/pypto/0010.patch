+
+CompileRequest::CompileRequest(NvidiaTargetInfo target_info, ToolchainIdentity toolchain_identity,
+                               RequestedArtifactPolicy requested_artifact_policy,
+                               CompilerPolicy compiler_policy, VerificationPolicy verification_policy)
+    : target_info_(std::move(target_info)),
+      toolchain_identity_(std::move(toolchain_identity)),
+      requested_artifact_policy_(requested_artifact_policy),
+      compiler_policy_(compiler_policy),
+      verification_policy_(verification_policy) {
+  (void)RequestedArtifactPolicyName(requested_artifact_policy_);
+  (void)CompilerPolicyName(compiler_policy_);
+  (void)VerificationPolicyName(verification_policy_);
+  if (target_info_.GetTensorIrRevision() != toolchain_identity_.GetTensorIrRevision()) {
+    throw ValueError("target tensor_ir_revision must match toolchain tensor_ir_revision");
+  }
+  if (target_info_.GetCudaTileRevision() != toolchain_identity_.GetCudaTileRevision()) {
+    throw ValueError("target cuda_tile_revision must match toolchain cuda_tile_revision");
+  }
+  if (target_info_.GetCudaToolkitVersion() != toolchain_identity_.GetCudaToolkitVersion()) {
+    throw ValueError("target cuda_toolkit_version must match toolchain cuda_toolkit_version");
+  }
+  RequireText(target_info_.GetDeviceName(), "target.device_name");
+  RequireText(target_info_.GetDeviceUuid(), "target.device_uuid");
+  RequireText(target_info_.GetPciDeviceId(), "target.pci_device_id");
+  RequireText(target_info_.GetCudaToolkitVersion(), "target.cuda_toolkit_version");
+  RequireText(target_info_.GetCudaDriverVersion(), "target.cuda_driver_version");
+  if (SerializeCanonical().size() > kMaximumSerializedRequestBytes) {
+    throw ValueError("CompileRequest canonical payload exceeds the 1 MiB v1 limit");
+  }
+}
+
+std::vector<uint8_t> CompileRequest::SerializeCanonical() const {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(9);
+  PackKey(packer, "backend");
+  PackText(packer, "nvidia");
+  PackKey(packer, "compiler_abi_version");
+  packer.pack(kCompilerAbiVersion);
+  PackKey(packer, "compiler_policy");
+  PackText(packer, CompilerPolicyName(compiler_policy_));
+  PackKey(packer, "contract");
+  PackText(packer, kCompileRequestContract);
+  PackKey(packer, "request_schema_version");
+  packer.pack(kRequestSchemaVersion);
+  PackKey(packer, "requested_artifact_policy");
+  PackText(packer, RequestedArtifactPolicyName(requested_artifact_policy_));
+  PackKey(packer, "target");
+  PackCompleteTarget(packer, target_info_);
+  PackKey(packer, "toolchain");
+  PackToolchain(packer, toolchain_identity_);
+  PackKey(packer, "verification_policy");
+  PackText(packer, VerificationPolicyName(verification_policy_));
+  return FinishBuffer(buffer);
+}
+
+CompileRequest CompileRequest::DeserializeCanonical(const std::vector<uint8_t>& data) {
+  auto handle = UnpackOne(data);
+  StrictMap fields(
+      handle.get(), "CompileRequest",
+      {"backend", "compiler_abi_version", "compiler_policy", "contract", "request_schema_version",
+       "requested_artifact_policy", "target", "toolchain", "verification_policy"});
+  const std::string contract = ReadText(fields.Get("contract"), "contract");
+  if (contract != kCompileRequestContract) {
+    throw ValueError("unsupported CompileRequest contract '" + contract + "'");
+  }
+  const uint32_t request_schema_version =
+      ReadUint32(fields.Get("request_schema_version"), "request_schema_version");
+  if (request_schema_version != kRequestSchemaVersion) {
+    throw ValueError("unsupported CompileRequest request_schema_version " +
+                     std::to_string(request_schema_version));
+  }
+  const uint32_t compiler_abi_version =
+      ReadUint32(fields.Get("compiler_abi_version"), "compiler_abi_version");
+  if (compiler_abi_version != kCompilerAbiVersion) {
+    throw ValueError("unsupported CompileRequest compiler_abi_version " +
+                     std::to_string(compiler_abi_version));
+  }
+  const std::string backend = ReadText(fields.Get("backend"), "backend");
+  if (backend != "nvidia") throw ValueError("unsupported CompileRequest backend '" + backend + "'");
+
+  CompileRequest request(ParseTarget(fields.Get("target")), ParseToolchain(fields.Get("toolchain")),
+                         ParseRequestedArtifactPolicy(fields.Get("requested_artifact_policy")),
+                         ParseCompilerPolicy(fields.Get("compiler_policy")),
+                         ParseVerificationPolicy(fields.Get("verification_policy")));
+  if (request.SerializeCanonical() != data) {
+    throw ValueError("CompileRequest payload is valid MessagePack but is not in canonical form");
+  }
+  return request;
+}
