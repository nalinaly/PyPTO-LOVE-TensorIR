+def test_compile_request_round_trip_is_canonical_and_value_owned() -> None:
+    value = request()
+    canonical = value.serialize()
+    restored = CompileRequest.deserialize(canonical)
+
+    assert restored.serialize() == canonical
+    assert restored.request_schema_version == 1
+    assert restored.compiler_abi_version == 1
+    assert restored.backend_type == backend.BackendType.Nvidia
+    assert restored.target_info.device_uuid == "GPU-test"
+    assert restored.toolchain_identity.tileiras_real_path == "/opt/cuda-13.3/bin/tileiras"
+    assert restored.requested_artifact_policy == RequestedArtifactPolicy.CubinOnly
+    assert restored.compiler_policy == CompilerPolicy.DeterministicStrict
+    assert restored.verification_policy == VerificationPolicy.Strict
+    assert restored.target_info is not value.target_info
+    assert restored.toolchain_identity is not value.toolchain_identity
+    with pytest.raises(AttributeError):
+        restored.target_info = target()
+    with pytest.raises(AttributeError):
+        restored.toolchain_identity.cuda_toolkit_root = "/changed"
+
+
+def test_toolchain_paths_must_be_parent_canonicalized_before_identity() -> None:
+    value = toolchain()
+    assert value.cuda_toolkit_root == "/opt/cuda-13.3"
+    assert value.tileiras_real_path == "/opt/cuda-13.3/bin/tileiras"
+    with pytest.raises(ValueError, match="already be a canonical absolute path"):
+        toolchain(cuda_toolkit_root="/opt/cuda/../cuda-13.3/")
+    with pytest.raises(ValueError, match="already be a canonical absolute path"):
+        toolchain(tileiras_real_path="/opt/cuda-13.3/lib/../bin/tileiras")
+
+
+@pytest.mark.parametrize(
+    ("field", "value", "message"),
