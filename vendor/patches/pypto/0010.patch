+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+namespace {
+
+constexpr std::string_view kPyptoRevision = "042878dd6825bb65ed03f22db7b067fb96277623";
+constexpr std::string_view kTensorIrRevision = "3b5a8bebc00510b46a1e8b97229d06dd0d006215";
+constexpr std::string_view kCudaTileRevision = "af2417041cc939b87ef56d92cfdcf61737c5457e";
+constexpr std::string_view kLlvmRevision = "1111111111111111111111111111111111111111";
+constexpr std::string_view kTileirasSha256 =
+    "2222222222222222222222222222222222222222222222222222222222222222";
+
+TargetTraits ValidTraits(int multiprocessor_count = 82,
+                         uint64_t total_global_memory_bytes = 24463ULL * 1024 * 1024) {
+  return TargetTraits(120, multiprocessor_count, 32, 1024, 1536, 24, 1024, 1024, 64, 2147483647, 65535, 65535,
+                      128, 48 * 1024, 101376, 131072, 65536, 255, 65536, 96ULL * 1024 * 1024,
+                      total_global_memory_bytes);
+}
+
+NvidiaTargetInfo ValidTarget(int device_ordinal = 0, std::string device_uuid = "GPU-test",
+                             std::string cuda_driver_version = "610.74", int multiprocessor_count = 82,
+                             uint64_t total_global_memory_bytes = 24463ULL * 1024 * 1024) {
+  return NvidiaTargetInfo(device_ordinal, "NVIDIA test device", std::move(device_uuid), "0000:01:00.0",
+                          ValidTraits(multiprocessor_count, total_global_memory_bytes), "13.3",
+                          std::move(cuda_driver_version), std::string(kTensorIrRevision),
+                          std::string(kCudaTileRevision),
+                          std::vector<DataType>{DataType::FP32, DataType::BF16});
+}
+
+ToolchainIdentity ValidToolchain(std::string cuda_toolkit_root = "/opt/cuda-13.3") {
+  return ToolchainIdentity(std::string(kPyptoRevision), std::string(kTensorIrRevision),
+                           std::string(kCudaTileRevision), std::string(kLlvmRevision),
+                           std::move(cuda_toolkit_root), "13.3", "/opt/cuda-13.3/bin/tileiras", "13.3.73",
+                           std::string(kTileirasSha256));
+}
+
+CompileRequest ValidRequest(int device_ordinal = 0, std::string device_uuid = "GPU-test",
+                            std::string cuda_driver_version = "610.74", int multiprocessor_count = 82,
+                            std::string cuda_toolkit_root = "/opt/cuda-13.3",
+                            uint64_t total_global_memory_bytes = 24463ULL * 1024 * 1024) {
+  return CompileRequest(ValidTarget(device_ordinal, std::move(device_uuid), std::move(cuda_driver_version),
+                                    multiprocessor_count, total_global_memory_bytes),
+                        ValidToolchain(std::move(cuda_toolkit_root)));
+}
+
+void PackText(msgpack::packer<msgpack::sbuffer>& packer, std::string_view text) {
+  packer.pack_str(static_cast<uint32_t>(text.size()));
+  packer.pack_str_body(text.data(), static_cast<uint32_t>(text.size()));
+}
+
+std::string ObjectKey(const msgpack::object& object) {
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+std::vector<uint8_t> BufferBytes(const msgpack::sbuffer& buffer) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+std::vector<uint8_t> AddUnknownField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    packer.pack(root.get().via.map.ptr[i].key);
+    packer.pack(root.get().via.map.ptr[i].val);
+  }
+  PackText(packer, "unknown_field");
+  packer.pack(1);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddUnknownTargetField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "target") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size + 1);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      packer.pack(entry.val.via.map.ptr[j].key);
+      packer.pack(entry.val.via.map.ptr[j].val);
+    }
+    PackText(packer, "unknown_target_field");
+    packer.pack(1);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddDuplicateBackendField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    packer.pack(root.get().via.map.ptr[i].key);
+    packer.pack(root.get().via.map.ptr[i].val);
+  }
+  PackText(packer, "backend");
+  PackText(packer, "nvidia");
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceFirstDtypeWithUnknown(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "target") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      const auto& target_entry = entry.val.via.map.ptr[j];
+      packer.pack(target_entry.key);
+      if (ObjectKey(target_entry.key) != "supported_compute_dtypes") {
+        packer.pack(target_entry.val);
+        continue;
+      }
+      packer.pack_array(target_entry.val.via.array.size);
+      packer.pack(255);
+      for (uint32_t k = 1; k < target_entry.val.via.array.size; ++k) {
+        packer.pack(target_entry.val.via.array.ptr[k]);
+      }
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> DropVerificationPolicy(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size - 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    if (ObjectKey(entry.key) == "verification_policy") continue;
+    packer.pack(entry.key);
+    packer.pack(entry.val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceVersion(const std::vector<uint8_t>& canonical, std::string_view field_name) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == field_name) {
+      packer.pack(2);
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReverseRootOrder(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = root.get().via.map.size; i > 0; --i) {
+    packer.pack(root.get().via.map.ptr[i - 1].key);
+    packer.pack(root.get().via.map.ptr[i - 1].val);
+  }
+  return BufferBytes(buffer);
+}
+
+bool Rejects(const std::vector<uint8_t>& data) {
+  try {
+    (void)CompileRequest::DeserializeCanonical(data);
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+template <typename Function>
+bool RejectsConstruction(Function&& function) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
