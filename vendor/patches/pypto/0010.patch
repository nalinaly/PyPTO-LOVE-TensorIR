diff --git a/include/pypto/compiler/compile_request.h b/include/pypto/compiler/compile_request.h
new file mode 100644
index 0000000000000000000000000000000000000000..1d63508833db5eb31d0798f67113381c39f82c16
--- /dev/null
+++ b/include/pypto/compiler/compile_request.h
@@ -0,0 +1,144 @@
