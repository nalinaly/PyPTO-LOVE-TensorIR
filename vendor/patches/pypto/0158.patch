diff --git a/src/codegen/nvidia/tensor_ir_codegen.cpp b/src/codegen/nvidia/tensor_ir_codegen.cpp
index 3b22fa2a1dce9566e20ba34f1d899da74822385b..8bd9949e78aa9634c5b76042deaa9b99584ad7d9 100644
--- a/src/codegen/nvidia/tensor_ir_codegen.cpp
+++ b/src/codegen/nvidia/tensor_ir_codegen.cpp
@@ -359,8 +359,9 @@ StaticTensor ReadStaticIntegerTensor(const ir::TypePtr& type,
                       MakeDenseStrides(shape, span)};
 }
 
-StaticTensor ReadStaticTile(const ir::TypePtr& type, const ir::Span& span,
-                            std::string_view location) {
+StaticTensor ReadStaticTileWithAnyDtype(const ir::TypePtr& type,
+                                        const ir::Span& span,
+                                        std::string_view location) {
   const auto tile_type = ir::As<ir::TileType>(type);
   if (!tile_type) {
     Reject(std::string(location) + " must have plain TileType", &span);
@@ -368,11 +369,6 @@ StaticTensor ReadStaticTile(const ir::TypePtr& type, const ir::Span& span,
   if (tile_type->memref_.has_value()) {
     Reject(std::string(location) + " must not carry a MemRef", &span);
   }
-  if (tile_type->dtype_ != DataType::BF16 && tile_type->dtype_ != DataType::FP32) {
-    Reject(std::string(location) + " dtype must be BF16 or FP32, got " +
-               tile_type->dtype_.ToString(),
-           &span);
-  }
   if (tile_type->shape_.empty() || tile_type->shape_.size() > kMaximumRank) {
     Reject(std::string(location) + " rank must be between 1 and 32", &span);
   }
@@ -389,6 +385,17 @@ StaticTensor ReadStaticTile(const ir::TypePtr& type, const ir::Span& span,
   return StaticTensor{tile_type->dtype_, shape, MakeDenseStrides(shape, span)};
 }
 
+StaticTensor ReadStaticTile(const ir::TypePtr& type, const ir::Span& span,
+                            std::string_view location) {
+  const StaticTensor tile = ReadStaticTileWithAnyDtype(type, span, location);
+  if (tile.dtype != DataType::BF16 && tile.dtype != DataType::FP32) {
+    Reject(std::string(location) + " dtype must be BF16 or FP32, got " +
+               tile.dtype.ToString(),
+           &span);
+  }
+  return tile;
+}
+
 bool SameTensor(const StaticTensor& left, const StaticTensor& right) {
   return left.dtype == right.dtype && left.shape == right.shape &&
          left.dense_strides == right.dense_strides;
@@ -6126,16 +6133,16 @@ NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
              &q_body->stmts_[9 + index]->span_);
     }
   }
-  const StaticTensor position_tile = ReadStaticTile(
+  const StaticTensor position_tile = ReadStaticTileWithAnyDtype(
       assignments[4]->var_->GetType(), assignments[4]->var_->span_,
       "native paged decode mask positions");
   const StaticTensor masked_score = ReadStaticTile(
       assignments[7]->var_->GetType(), assignments[7]->var_->span_,
       "native paged decode masked score");
-  const StaticTensor mask_tile = ReadStaticTile(
+  const StaticTensor mask_tile = ReadStaticTileWithAnyDtype(
       assignments[5]->var_->GetType(), assignments[5]->var_->span_,
       "native paged decode valid mask");
-  const StaticTensor mask_scratch = ReadStaticTile(
+  const StaticTensor mask_scratch = ReadStaticTileWithAnyDtype(
       assignments[6]->var_->GetType(), assignments[6]->var_->span_,
       "native paged decode mask scratch");
   const auto position_start = calls[4]->args_.size() == 2
@@ -8009,7 +8016,7 @@ std::string EmitNativeTilePagedPrefillSource(
         source += score_type;
         source += "\n    %valid_offset_" + suffix + " = constant ";
         source += std::to_string(query_row + 1);
-        source += " : i32\n    %valid_offset_splat_" + suffix +
+        source += " : si32\n    %valid_offset_splat_" + suffix +
                   " = splat %valid_offset_" + suffix + " : ";
         source += index_row_type;
         source += "\n    %valid_count_" + suffix + " = add %arg5, "
