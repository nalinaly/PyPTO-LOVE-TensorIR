+bool IsNativeTileWeightedRmsNormCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTileRmsNormCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  return function->params_.size() == 3;
+}
+
+NativeTileWeightedRmsNormGraph AnalyzeNativeTileWeightedRmsNorm(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native weighted RMSNorm must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 3 ||
+      function->param_directions_.size() != 3 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native weighted RMSNorm requires input, weight and output",
+           &function->span_);
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native weighted RMSNorm input");
+  const StaticTensor weight = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native weighted RMSNorm weight");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native weighted RMSNorm output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native weighted RMSNorm return");
+  if (input.dtype != DataType::BF16 || input.shape.size() != 2 ||
+      weight.dtype != DataType::BF16 ||
+      weight.shape != std::vector<int64_t>({1, input.shape[1]}) ||
+      !SameTensor(input, result) || !SameTensor(result, declared)) {
+    Reject("native weighted RMSNorm tensors have incompatible types or shapes",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2 || !top->stmts_[0] ||
+      !top->stmts_[1]) {
+    Reject("native weighted RMSNorm body must contain one scope and return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[2].get()) {
+    Reject("native weighted RMSNorm scope or return is invalid",
+           &function->span_);
+  }
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  if (loop_nest.repetitions != static_cast<uint64_t>(input.shape[0]) ||
+      !loop_nest.leaf || loop_nest.leaf->stmts_.size() != 15) {
+    Reject("native weighted RMSNorm must cover each row with one tile body",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 14> kOps = {
+      "tile.load", "tile.load", "tile.cast", "tile.mul", "tile.create",
+      "tile.row_sum", "tile.muls", "tile.adds", "tile.rsqrt",
+      "tile.row_expand_mul", "tile.cast", "tile.adds", "tile.mul",
+      "tile.cast"};
+  std::array<ir::AssignStmtPtr, 14> assignments;
+  std::array<ir::CallPtr, 14> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native weighted RMSNorm tile sequence is invalid",
+             &loop_nest.leaf->stmts_[index]->span_);
+    }
+  }
+  auto require_var = [&](const ir::CallPtr& call, size_t index,
+                         const ir::VarPtr& expected,
+                         std::string_view diagnostic) {
+    const auto value = index < call->args_.size()
+                           ? ir::As<ir::Var>(call->args_[index])
+                           : nullptr;
+    if (!value || value.get() != expected.get()) {
+      Reject(std::string(diagnostic), &call->span_);
+    }
+  };
+  require_var(calls[0], 0, function->params_[0],
+              "weighted RMSNorm input load is invalid");
+  require_var(calls[1], 0, function->params_[1],
+              "weighted RMSNorm weight load is invalid");
+  require_var(calls[2], 0, assignments[0]->var_,
+              "weighted RMSNorm input cast is invalid");
+  require_var(calls[3], 0, assignments[2]->var_,
+              "weighted RMSNorm square lhs is invalid");
+  require_var(calls[3], 1, assignments[2]->var_,
+              "weighted RMSNorm square rhs is invalid");
+  require_var(calls[5], 0, assignments[3]->var_,
+              "weighted RMSNorm row sum input is invalid");
+  require_var(calls[5], 1, assignments[4]->var_,
+              "weighted RMSNorm row sum scratch is invalid");
+  for (size_t index = 6; index <= 8; ++index) {
+    require_var(calls[index], 0, assignments[index - 1]->var_,
+                "weighted RMSNorm reduction epilogue is not linear");
+  }
+  require_var(calls[9], 0, assignments[2]->var_,
+              "weighted RMSNorm normalization input is invalid");
+  require_var(calls[9], 1, assignments[8]->var_,
+              "weighted RMSNorm inverse RMS input is invalid");
+  require_var(calls[10], 0, assignments[1]->var_,
+              "weighted RMSNorm weight cast is invalid");
+  require_var(calls[11], 0, assignments[10]->var_,
+              "weighted RMSNorm weight scale is invalid");
+  require_var(calls[12], 0, assignments[9]->var_,
+              "weighted RMSNorm normalized value is invalid");
+  require_var(calls[12], 1, assignments[11]->var_,
+              "weighted RMSNorm scale value is invalid");
+  require_var(calls[13], 0, assignments[12]->var_,
+              "weighted RMSNorm result cast is invalid");
+
+  const auto store = ir::As<ir::EvalStmt>(loop_nest.leaf->stmts_.back());
+  const auto store_call = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  if (!store_call || !ir::IsOp(store_call, "tile.store")) {
+    Reject("native weighted RMSNorm must end in tile.store",
+           &loop_nest.leaf->stmts_.back()->span_);
+  }
+  require_var(store_call, 0, assignments[13]->var_,
+              "weighted RMSNorm stored value is invalid");
+  require_var(store_call, 2, function->params_[2],
+              "weighted RMSNorm store target is invalid");
+
+  const StaticTensor input_tile = ReadStaticTile(
+      assignments[0]->var_->GetType(), assignments[0]->span_,
+      "native weighted RMSNorm input tile");
+  const StaticTensor weight_tile = ReadStaticTile(
+      assignments[1]->var_->GetType(), assignments[1]->span_,
+      "native weighted RMSNorm weight tile");
+  const StaticTensor result_tile = ReadStaticTile(
+      assignments[13]->var_->GetType(), assignments[13]->span_,
+      "native weighted RMSNorm result tile");
+  const StaticTensor expected_tile{DataType::BF16, {1, input.shape[1]},
+                                   {input.shape[1], 1}};
+  if (!SameTensor(input_tile, expected_tile) ||
+      !SameTensor(weight_tile, expected_tile) ||
+      !SameTensor(result_tile, expected_tile)) {
+    Reject("native weighted RMSNorm BF16 tile shapes are invalid", &scope->span_);
+  }
+  for (size_t index : {2U, 3U, 4U, 9U, 10U, 11U, 12U}) {
+    const StaticTensor tile = ReadStaticTile(
+        assignments[index]->var_->GetType(), assignments[index]->span_,
+        "native weighted RMSNorm FP32 tile");
+    if (tile.dtype != DataType::FP32 || tile.shape != expected_tile.shape) {
+      Reject("native weighted RMSNorm FP32 full tile is invalid",
+             &assignments[index]->span_);
+    }
+  }
+  for (size_t index : {5U, 6U, 7U, 8U}) {
+    const StaticTensor tile = ReadStaticTile(
+        assignments[index]->var_->GetType(), assignments[index]->span_,
+        "native weighted RMSNorm row tile");
+    if (tile.dtype != DataType::FP32 ||
+        tile.shape != std::vector<int64_t>({1, 1})) {
+      Reject("native weighted RMSNorm FP32 row tile is invalid",
+             &assignments[index]->span_);
+    }
+  }
+
+  const auto mean_scale = calls[6]->args_.size() == 2
+                              ? ir::As<ir::ConstFloat>(calls[6]->args_[1])
+                              : nullptr;
+  const auto epsilon = calls[7]->args_.size() == 2
+                           ? ir::As<ir::ConstFloat>(calls[7]->args_[1])
+                           : nullptr;
+  const auto weight_one = calls[11]->args_.size() == 2
+                              ? ir::As<ir::ConstFloat>(calls[11]->args_[1])
+                              : nullptr;
+  const double expected_mean = 1.0 / static_cast<double>(input.shape[1]);
+  if (!mean_scale || !epsilon || !weight_one ||
+      !std::isfinite(mean_scale->value_) || !std::isfinite(epsilon->value_) ||
+      epsilon->value_ <= 0.0 || weight_one->value_ != 1.0 ||
+      std::fabs(mean_scale->value_ - expected_mean) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native weighted RMSNorm scalar constants are invalid", &scope->span_);
+  }
+  return NativeTileWeightedRmsNormGraph{
+      input, weight, result, mean_scale->value_, epsilon->value_};
+}
