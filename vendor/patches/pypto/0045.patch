+void ValidateLoadedParameterAbi(
+    detail::NvidiaDriverApi& driver, uintptr_t function_address,
+    const std::vector<uint64_t>& expected_widths,
+    uint64_t parameter_frame_size_bytes) {
+  struct ParameterRange {
+    uint64_t offset = 0;
+    uint64_t end = 0;
+    size_t index = 0;
+  };
+  std::vector<ParameterRange> ranges;
+  ranges.reserve(expected_widths.size());
+  for (size_t index = 0; index < expected_widths.size(); ++index) {
+    const auto info = driver.GetFunctionParameterInfo(
+        function_address, static_cast<uint32_t>(index));
+    if (!info.has_value()) {
+      throw RuntimeError("loaded CUDA function parameter ABI differs from Artifact at index " +
+                         std::to_string(index) + ": parameter is absent");
+    }
+    if (info->size_bytes != expected_widths[index]) {
+      throw RuntimeError("loaded CUDA function parameter ABI differs from Artifact at index " +
+                         std::to_string(index) + ": expected size " +
+                         std::to_string(expected_widths[index]) + ", actual size " +
+                         std::to_string(info->size_bytes) + ", actual offset " +
+                         std::to_string(info->offset_bytes));
+    }
+    if (info->offset_bytes >
+        std::numeric_limits<uint64_t>::max() - info->size_bytes) {
+      throw RuntimeError("loaded CUDA function parameter ABI differs from Artifact at index " +
+                         std::to_string(index) + ": offset range overflows");
+    }
+    const uint64_t end = info->offset_bytes + info->size_bytes;
+    if (end > parameter_frame_size_bytes) {
+      throw RuntimeError(
+          "loaded CUDA function parameter ABI differs from Artifact at index " +
+          std::to_string(index) + ": parameter range exceeds the bounded "
+                                  "Artifact frame");
+    }
+    ranges.push_back(ParameterRange{info->offset_bytes, end, index});
+  }
+  if (driver.GetFunctionParameterInfo(
+          function_address, static_cast<uint32_t>(expected_widths.size()))
+          .has_value()) {
+    throw RuntimeError("loaded CUDA function has parameters absent from Artifact ABI");
+  }
+  std::sort(ranges.begin(), ranges.end(),
+            [](const ParameterRange& lhs, const ParameterRange& rhs) {
+              if (lhs.offset != rhs.offset) return lhs.offset < rhs.offset;
+              return lhs.index < rhs.index;
+            });
+  uint64_t previous_end = 0;
+  for (const ParameterRange& range : ranges) {
+    if (range.offset < previous_end) {
+      throw RuntimeError("loaded CUDA function parameter ABI differs from Artifact: parameter " +
+                         std::to_string(range.index) + " overlaps another parameter");
+    }
+    previous_end = range.end;
+  }
+}
