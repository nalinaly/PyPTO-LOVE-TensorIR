+[[nodiscard]] uint64_t PackInt32ArgumentSlot(int64_t value,
+                                             int64_t minimum,
+                                             const char* description) {
+  if (value < minimum ||
+      value > static_cast<int64_t>(std::numeric_limits<int32_t>::max())) {
+    throw ValueError(std::string(description) +
+                     " is outside the int32 CUDA ABI range");
+  }
+  const int32_t packed = static_cast<int32_t>(value);
+  uint64_t slot = 0;
+  std::memcpy(&slot, &packed, sizeof(packed));
+  return slot;
+}
