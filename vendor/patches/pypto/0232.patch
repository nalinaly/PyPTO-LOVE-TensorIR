+    const std::array<StaticTensor, 4> inputs = {
+        graph.cache, graph.req_to_token, graph.request_index,
+        graph.virtual_to_physical};
+    for (uint32_t index = 0; index < inputs.size(); ++index) {
+      const StaticTensor& input = inputs[index];
+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Input, index, input.dtype, input.shape,
+          input.dense_strides, /*has_explicit_strides=*/true));
+    }
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype, graph.result.shape,
+        graph.result.dense_strides, /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
+                          EmitNativeTilePagedGatherSource(graph),
+                          std::move(metadata), /*input_count=*/4);
+  }
   if (IsNativeTilePagedPrefillCandidate(program)) {
     const NativeTilePagedPrefillGraph graph =
         AnalyzeNativeTilePagedPrefill(program);
