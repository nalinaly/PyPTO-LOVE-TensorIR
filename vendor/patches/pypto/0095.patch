+std::string EmitNativeTileFusedAddRmsNormSource(
+    const NativeTileFusedAddRmsNormGraph& graph) {
+  StaticTensor compute = graph.input;
+  compute.dtype = DataType::FP32;
+  StaticTensor row = compute;
+  row.shape[1] = 1;
+  row.dense_strides = {1, 1};
+  StaticTensor weight_compute = graph.weight;
+  weight_compute.dtype = DataType::FP32;
+
+  const std::string input_type = TensorTypeText(graph.input);
+  const std::string compute_type = TensorTypeText(compute);
+  const std::string row_type = TensorTypeText(row);
+  const std::string weight_type = TensorTypeText(graph.weight);
+  const std::string weight_compute_type = TensorTypeText(weight_compute);
+  std::string source;
+  source.reserve(3584);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.input);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.input);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.weight);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ", ";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %residual0 = add %arg0, %arg1 : ";
+  source += input_type;
+  source += "\n    %wide = convert %residual0 : ";
+  source += input_type;
+  source += " -> ";
+  source += compute_type;
+  source += "\n    %square = mul %wide, %wide : ";
+  source += compute_type;
+  source += "\n    %sum = reduce(%square) <dimensions = [1], reduction_mode = <add>> : ";
+  source += compute_type;
+  source += " -> ";
+  source += row_type;
+  source += "\n    %mean_constant = constant ";
+  AppendFloat(source, graph.mean_scale);
+  source += " : f32\n    %mean_splat = splat %mean_constant : ";
+  source += row_type;
+  source += "\n    %mean = mul %sum, %mean_splat : ";
+  source += row_type;
+  source += "\n    %epsilon_constant = constant ";
+  AppendFloat(source, graph.epsilon);
+  source += " : f32\n    %epsilon_splat = splat %epsilon_constant : ";
+  source += row_type;
+  source += "\n    %shifted = add %mean, %epsilon_splat : ";
+  source += row_type;
+  source += "\n    %inverse = rsqrt %shifted : ";
+  source += row_type;
+  source += "\n    %inverse_broadcast = broadcast %inverse : ";
+  source += row_type;
+  source += " -> ";
+  source += compute_type;
+  source += "\n    %normalized = mul %wide, %inverse_broadcast : ";
+  source += compute_type;
+  source += "\n    %weight_wide = convert %arg2 : ";
+  source += weight_type;
+  source += " -> ";
+  source += weight_compute_type;
+  source += "\n    %one = constant 1.0 : f32\n    %one_splat = splat %one : ";
+  source += weight_compute_type;
+  source += "\n    %weight_scale = add %weight_wide, %one_splat : ";
+  source += weight_compute_type;
+  std::string weight_value = "%weight_scale";
+  if (graph.input.shape[0] != 1) {
+    source += "\n    %weight_broadcast = broadcast %weight_scale : ";
+    source += weight_compute_type;
+    source += " -> ";
+    source += compute_type;
+    weight_value = "%weight_broadcast";
+  }
+  source += "\n    %weighted = mul %normalized, ";
+  source += weight_value;
+  source += " : ";
+  source += compute_type;
+  source += "\n    %result0 = convert %weighted : ";
+  source += compute_type;
+  source += " -> ";
+  source += input_type;
+  source += "\n    results %result0, %residual0 : ";
+  source += input_type;
+  source += ", ";
+  source += input_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
