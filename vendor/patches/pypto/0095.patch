+bool IsNativeTileFusedAddRmsNormCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTileRmsNormCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  return function->params_.size() == 5;
+}
+
+NativeTileFusedAddRmsNormGraph AnalyzeNativeTileFusedAddRmsNorm(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native fused add RMSNorm must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 5 ||
+      function->param_directions_.size() != 5 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::In ||
+      function->param_directions_[3] != ir::ParamDirection::Out ||
+      function->param_directions_[4] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 2) {
+    Reject("native fused add RMSNorm requires three inputs and two outputs",
+           &function->span_);
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native fused add RMSNorm input");
+  const StaticTensor residual = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native fused add RMSNorm residual");
+  const StaticTensor weight = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native fused add RMSNorm weight");
+  const StaticTensor normalized_result = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native fused add RMSNorm normalized output");
+  const StaticTensor residual_result = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native fused add RMSNorm residual output");
+  if (input.dtype != DataType::BF16 || input.shape.size() != 2 ||
+      !SameTensor(input, residual) || !SameTensor(input, normalized_result) ||
+      !SameTensor(input, residual_result) || weight.dtype != DataType::BF16 ||
+      weight.shape != std::vector<int64_t>({1, input.shape[1]})) {
+    Reject("native fused add RMSNorm tensors have incompatible types or shapes",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 2; ++index) {
+    const StaticTensor declared = ReadStaticTensor(
+        function->return_types_[index], function->span_,
+        "native fused add RMSNorm declared return");
+    if (!SameTensor(input, declared)) {
+      Reject("native fused add RMSNorm returns must match the input",
+             &function->span_);
+    }
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2 || !top->stmts_[0] ||
+      !top->stmts_[1]) {
+    Reject("native fused add RMSNorm body must contain one scope and return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned || returned->value_.size() != 2) {
+    Reject("native fused add RMSNorm scope or return is invalid",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 2; ++index) {
+    const auto value = ir::As<ir::Var>(returned->value_[index]);
+    if (!value || value.get() != function->params_[3 + index].get()) {
+      Reject("native fused add RMSNorm return order is invalid",
+             &returned->span_);
+    }
+  }
+
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  if (loop_nest.repetitions != static_cast<uint64_t>(input.shape[0]) ||
+      !loop_nest.leaf || loop_nest.leaf->stmts_.size() != 18) {
+    Reject("native fused add RMSNorm must cover each row with one tile body",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 16> kOps = {
+      "tile.load", "tile.load", "tile.load", "tile.add", "tile.cast",
+      "tile.mul", "tile.create", "tile.row_sum", "tile.muls", "tile.adds",
+      "tile.rsqrt", "tile.row_expand_mul", "tile.cast", "tile.adds",
+      "tile.mul", "tile.cast"};
+  std::array<ir::AssignStmtPtr, 16> assignments;
+  std::array<ir::CallPtr, 16> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native fused add RMSNorm tile sequence is invalid",
+             &loop_nest.leaf->stmts_[index]->span_);
+    }
+  }
+  auto require_var = [&](const ir::CallPtr& call, size_t index,
+                         const ir::VarPtr& expected,
+                         std::string_view diagnostic) {
+    const auto value = index < call->args_.size()
+                           ? ir::As<ir::Var>(call->args_[index])
+                           : nullptr;
+    if (!value || value.get() != expected.get()) {
+      Reject(std::string(diagnostic), &call->span_);
+    }
+  };
+  require_var(calls[0], 0, function->params_[0],
+              "fused RMSNorm input load is invalid");
+  require_var(calls[1], 0, function->params_[1],
+              "fused RMSNorm residual load is invalid");
+  require_var(calls[2], 0, function->params_[2],
+              "fused RMSNorm weight load is invalid");
+  require_var(calls[3], 0, assignments[0]->var_,
+              "fused RMSNorm add lhs is invalid");
+  require_var(calls[3], 1, assignments[1]->var_,
+              "fused RMSNorm add rhs is invalid");
+  require_var(calls[4], 0, assignments[3]->var_,
+              "fused RMSNorm residual cast is invalid");
+  require_var(calls[5], 0, assignments[4]->var_,
+              "fused RMSNorm square lhs is invalid");
+  require_var(calls[5], 1, assignments[4]->var_,
+              "fused RMSNorm square rhs is invalid");
+  require_var(calls[7], 0, assignments[5]->var_,
+              "fused RMSNorm row sum input is invalid");
+  require_var(calls[7], 1, assignments[6]->var_,
+              "fused RMSNorm row sum scratch is invalid");
+  for (size_t index = 8; index <= 10; ++index) {
+    require_var(calls[index], 0, assignments[index - 1]->var_,
+                "fused RMSNorm reduction epilogue is not linear");
+  }
+  require_var(calls[11], 0, assignments[4]->var_,
+              "fused RMSNorm normalization input is invalid");
+  require_var(calls[11], 1, assignments[10]->var_,
+              "fused RMSNorm inverse RMS is invalid");
+  require_var(calls[12], 0, assignments[2]->var_,
+              "fused RMSNorm weight cast is invalid");
+  require_var(calls[13], 0, assignments[12]->var_,
+              "fused RMSNorm scale is invalid");
+  require_var(calls[14], 0, assignments[11]->var_,
+              "fused RMSNorm normalized value is invalid");
+  require_var(calls[14], 1, assignments[13]->var_,
+              "fused RMSNorm weighted scale is invalid");
+  require_var(calls[15], 0, assignments[14]->var_,
+              "fused RMSNorm result cast is invalid");
+
+  std::array<ir::CallPtr, 2> stores;
+  for (size_t index = 0; index < stores.size(); ++index) {
+    const auto statement =
+        ir::As<ir::EvalStmt>(loop_nest.leaf->stmts_[16 + index]);
+    stores[index] = statement ? ir::As<ir::Call>(statement->expr_) : nullptr;
+    if (!stores[index] || !ir::IsOp(stores[index], "tile.store")) {
+      Reject("native fused add RMSNorm must end in two tile.store calls",
+             &loop_nest.leaf->stmts_[16 + index]->span_);
+    }
+  }
+  require_var(stores[0], 0, assignments[15]->var_,
+              "fused RMSNorm normalized store value is invalid");
+  require_var(stores[0], 2, function->params_[3],
+              "fused RMSNorm normalized store target is invalid");
+  require_var(stores[1], 0, assignments[3]->var_,
+              "fused RMSNorm residual store value is invalid");
+  require_var(stores[1], 2, function->params_[4],
+              "fused RMSNorm residual store target is invalid");
+
+  const StaticTensor expected_bf16{DataType::BF16, {1, input.shape[1]},
+                                   {input.shape[1], 1}};
+  for (size_t index : {0U, 1U, 2U, 3U, 15U}) {
+    const StaticTensor tile = ReadStaticTile(
+        assignments[index]->var_->GetType(), assignments[index]->span_,
+        "native fused add RMSNorm BF16 tile");
+    if (!SameTensor(tile, expected_bf16)) {
+      Reject("native fused add RMSNorm BF16 tile shape is invalid",
+             &assignments[index]->span_);
+    }
+  }
+  const auto mean_scale = calls[8]->args_.size() == 2
+                              ? ir::As<ir::ConstFloat>(calls[8]->args_[1])
+                              : nullptr;
+  const auto epsilon = calls[9]->args_.size() == 2
+                           ? ir::As<ir::ConstFloat>(calls[9]->args_[1])
+                           : nullptr;
+  const auto weight_one = calls[13]->args_.size() == 2
+                              ? ir::As<ir::ConstFloat>(calls[13]->args_[1])
+                              : nullptr;
+  const double expected_mean = 1.0 / static_cast<double>(input.shape[1]);
+  if (!mean_scale || !epsilon || !weight_one ||
+      !std::isfinite(mean_scale->value_) || !std::isfinite(epsilon->value_) ||
+      epsilon->value_ <= 0.0 || weight_one->value_ != 1.0 ||
+      std::fabs(mean_scale->value_ - expected_mean) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native fused add RMSNorm scalar constants are invalid", &scope->span_);
+  }
+  return NativeTileFusedAddRmsNormGraph{
+      input, weight, normalized_result, mean_scale->value_, epsilon->value_};
+}
