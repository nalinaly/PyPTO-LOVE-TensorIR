+bool ValidateNativePagedPrefillSpec(
+    const NativePagedPrefillTensorIrSpec& spec, std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR paged-prefill specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (const auto& input : spec.inputs) {
+    if (!HasValidStaticMetadata(input)) {
+      return reject("inputs must have fully static explicit metadata");
+    }
+  }
+  if (!HasValidStaticMetadata(spec.result)) {
+    return reject("result must have fully static explicit metadata");
+  }
+  const auto& query = spec.inputs[0];
+  const auto& key_cache = spec.inputs[1];
+  const auto& value_cache = spec.inputs[2];
+  const auto& request_table = spec.inputs[3];
+  const auto& request_index = spec.inputs[4];
+  const auto& prefix_tokens = spec.inputs[5];
+  const auto& mapping = spec.inputs[6];
+  if (query.element_type != TypedTensorIrElementType::BF16 ||
+      query.shape != std::vector<int64_t>({spec.query_rows, spec.query_heads,
+                                           spec.head_dim}) ||
+      query.shape.size() != 3 || query.strides[2] != 1 ||
+      query.strides[1] < spec.head_dim ||
+      key_cache.element_type != TypedTensorIrElementType::BF16 ||
+      value_cache.element_type != TypedTensorIrElementType::BF16 ||
+      key_cache.shape != value_cache.shape || key_cache.shape.size() != 2 ||
+      key_cache.strides[1] != 1 || key_cache.strides[0] < key_cache.shape[1] ||
+      request_table.element_type != TypedTensorIrElementType::INT32 ||
+      request_table.shape.size() != 2 || !IsDense(request_table) ||
+      request_index.element_type != TypedTensorIrElementType::INT64 ||
+      request_index.shape != std::vector<int64_t>({1, spec.tokens}) ||
+      request_index.strides != std::vector<int64_t>({0, 0}) ||
+      prefix_tokens.element_type != TypedTensorIrElementType::INT32 ||
+      prefix_tokens.shape != request_index.shape ||
+      prefix_tokens.strides != std::vector<int64_t>({0, 0}) ||
+      mapping.element_type != TypedTensorIrElementType::INT64 ||
+      mapping.shape.size() != 2 || mapping.shape[0] <= 0 ||
+      mapping.shape[1] != 1 || mapping.strides[1] != 1 ||
+      mapping.strides[0] < 1 ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      spec.result.shape != query.shape || spec.result.strides[2] != 1 ||
+      spec.result.strides[1] < spec.head_dim ||
+      spec.result.strides[0] < spec.query_heads * spec.head_dim) {
+    return reject("tensor dtype, shape, or stride contract is invalid");
+  }
+  if (spec.query_rows <= 0 || spec.query_heads <= 0 || spec.kv_heads <= 0 ||
+      spec.tokens <= 0 || spec.head_dim <= 0 || spec.cache_rows <= 0 ||
+      spec.query_heads % spec.kv_heads != 0 || spec.head_dim % 128 != 0 ||
+      spec.tokens % 16 != 0 || key_cache.shape[1] != spec.kv_heads * spec.head_dim ||
+      request_table.shape[0] <= 0 || request_table.shape[1] < spec.tokens ||
+      request_index.shape[0] != 1 || !std::isfinite(spec.scale)) {
+    return reject("static GQA or cache geometry is invalid");
+  }
+  int64_t query_work = 0;
+  int64_t kv_work = 0;
+  if (!CheckedMultiply(spec.query_rows, spec.query_heads, query_work) ||
+      !CheckedMultiply(spec.kv_heads, spec.query_rows, kv_work) ||
+      query_work > kMaximumBatchTokenProduct || kv_work > kMaximumBatchTokenProduct) {
+    return reject("paged-prefill operation count exceeds the bounded builder");
+  }
+  const double expected_scale =
+      1.0 / std::sqrt(static_cast<double>(spec.head_dim));
+  if (std::fabs(spec.scale - expected_scale) >
+      std::numeric_limits<double>::epsilon()) {
+    return reject("scale does not equal 1/sqrt(head_dim)");
+  }
+  return true;
+}
