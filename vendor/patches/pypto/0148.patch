+@pl.jit
+def _native_tile_paged_prefill(
+    query: pl.Tensor[[2, 2, 256], pl.BF16],
+    key_cache: pl.Tensor[[1024, 256], pl.BF16],
+    value_cache: pl.Tensor[[1024, 256], pl.BF16],
+    req_to_token: pl.Tensor[[65, 4096], pl.INT32],
+    request_index: pl.Tensor[[1, 16], pl.INT64],
+    prefix_tokens: pl.Tensor[[1, 16], pl.INT32],
+    scale: pl.FP32,
+    out: pl.Out[pl.Tensor[[2, 2, 256], pl.BF16]],
+):
+    with pl.at(level=pl.Level.CORE_GROUP):
+        request_id = pl.read(request_index, [0, 0])
+        prefix_token_count = pl.read(prefix_tokens, [0, 0])
+        positions = pl.tile.ci(0, [1, 16], dtype=pl.INT32)
+        kv_heads = key_cache.shape[1] // query.shape[2]
+        queries_per_kv = query.shape[1] // kv_heads
+        for kv_head in pl.range(kv_heads):
+            keys = pl.tile.create(
+                [256, 16],
+                dtype=pl.BF16,
+                target_memory=pl.MemorySpace.Mat,
+                transpose=True,
+            )
+            values = pl.tile.create(
+                [16, 256], dtype=pl.BF16, target_memory=pl.MemorySpace.Mat
+            )
+            for slot in pl.range(16):
+                physical = pl.read(req_to_token, [request_id, slot])
+                cache_column = kv_head * 256
+                keys = pl.tile.gather_row(
+                    keys,
+                    key_cache,
+                    [0, slot],
+                    [physical, cache_column],
+                    [1, 256],
+                    transpose=True,
+                )
+                values = pl.tile.gather_row(
+                    values,
+                    value_cache,
+                    [slot, 0],
+                    [physical, cache_column],
+                    [1, 256],
+                )
+            for q_group in pl.range(queries_per_kv):
+                q_head = kv_head * queries_per_kv + q_group
+                for query_row in pl.range(2):
+                    query_box = pl.load(
+                        query,
+                        [query_row, q_head, 0],
+                        [1, 1, 256],
+                        target_memory=pl.MemorySpace.Mat,
+                    )
+                    query_tile = pl.reshape(query_box, [1, 256])
+                    score = pl.matmul(query_tile, keys, out_dtype=pl.FP32)
