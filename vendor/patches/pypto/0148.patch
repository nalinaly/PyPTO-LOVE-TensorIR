+bool IsNativeTilePagedPrefillCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 8) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto body = scope ? ir::As<ir::SeqStmts>(scope->body_) : nullptr;
+  const auto kv_loop = body && body->stmts_.size() == 6
+                           ? ir::As<ir::ForStmt>(body->stmts_[5])
+                           : nullptr;
+  const auto kv_body = kv_loop ? ir::As<ir::SeqStmts>(kv_loop->body_) : nullptr;
+  const auto q_group_loop = kv_body && kv_body->stmts_.size() == 4
+                                ? ir::As<ir::ForStmt>(kv_body->stmts_[3])
+                                : nullptr;
+  const auto q_group_body =
+      q_group_loop ? ir::As<ir::SeqStmts>(q_group_loop->body_) : nullptr;
+  const auto query_loop = q_group_body && q_group_body->stmts_.size() == 2
+                              ? ir::As<ir::ForStmt>(q_group_body->stmts_[1])
+                              : nullptr;
+  const auto query_body =
+      query_loop ? ir::As<ir::SeqStmts>(query_loop->body_) : nullptr;
+  return query_body && query_body->stmts_.size() == 22;
+}
+
+NativeTilePagedPrefillGraph AnalyzeNativeTilePagedPrefill(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native paged prefill must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 8 ||
+      function->param_directions_.size() != 8 ||
+      function->return_types_.size() != 1) {
+    Reject("native paged prefill parameter contract is invalid",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 7; ++index) {
+    if (function->param_directions_[index] != ir::ParamDirection::In) {
+      Reject("native paged prefill inputs must have direction In",
+             &function->span_);
+    }
+  }
+  if (function->param_directions_[7] != ir::ParamDirection::Out) {
+    Reject("native paged prefill output must have direction Out",
+           &function->span_);
+  }
+
+  const StaticTensor query = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native paged prefill query");
+  const StaticTensor key_cache = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native paged prefill key cache");
+  const StaticTensor value_cache = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native paged prefill value cache");
+  const StaticTensor req_to_token = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native paged prefill request table");
+  StaticTensor request_index = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native paged prefill request index");
+  StaticTensor prefix_tokens = ReadStaticTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native paged prefill prefix length");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[7]->GetType(), function->params_[7]->span_,
+      "native paged prefill output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native paged prefill declared output");
+  if (query.dtype != DataType::BF16 || query.shape.size() != 3 ||
+      key_cache.dtype != DataType::BF16 ||
+      !SameTensor(key_cache, value_cache) || key_cache.shape.size() != 2 ||
+      req_to_token.dtype != DataType::INT32 ||
+      req_to_token.shape.size() != 2 ||
+      request_index.dtype != DataType::INT64 ||
+      request_index.shape.size() != 2 ||
+      prefix_tokens.dtype != DataType::INT32 ||
+      prefix_tokens.shape != request_index.shape ||
+      !SameTensor(query, result) || !SameTensor(result, declared)) {
+    Reject("native paged prefill tensor types or ranks are invalid",
+           &function->span_);
+  }
+  const int64_t query_rows = query.shape[0];
+  const int64_t q_heads = query.shape[1];
+  const int64_t head_dim = query.shape[2];
+  const int64_t cache_rows = key_cache.shape[0];
+  const int64_t tokens = request_index.shape[1];
+  if (query_rows <= 0 || q_heads <= 0 || head_dim <= 0 ||
+      head_dim % 128 != 0 || cache_rows <= 0 || tokens <= 0 ||
+      tokens % 16 != 0 || key_cache.shape[1] % head_dim != 0 ||
+      req_to_token.shape[0] <= 0 || req_to_token.shape[1] < tokens ||
+      request_index.shape[0] != 1) {
+    Reject("native paged prefill static geometry is invalid", &function->span_);
+  }
+  const int64_t kv_heads = key_cache.shape[1] / head_dim;
+  if (kv_heads <= 0 || q_heads % kv_heads != 0) {
+    Reject("native paged prefill GQA mapping is invalid", &function->span_);
+  }
+  request_index.dense_strides = {0, 0};
+  prefix_tokens.dense_strides = {0, 0};
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  const auto body = scope ? ir::As<ir::SeqStmts>(scope->body_) : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[7].get() || !body ||
+      body->stmts_.size() != 6) {
+    Reject("native paged prefill scope or return is invalid", &function->span_);
+  }
+
+  const auto request_assignment = ir::As<ir::AssignStmt>(body->stmts_[0]);
+  const auto prefix_assignment = ir::As<ir::AssignStmt>(body->stmts_[1]);
+  const auto positions_assignment = ir::As<ir::AssignStmt>(body->stmts_[2]);
+  const auto kv_heads_assignment = ir::As<ir::AssignStmt>(body->stmts_[3]);
+  const auto queries_assignment = ir::As<ir::AssignStmt>(body->stmts_[4]);
+  const auto kv_loop = ir::As<ir::ForStmt>(body->stmts_[5]);
+  const auto request_call = request_assignment
+                                ? ir::As<ir::Call>(request_assignment->value_)
+                                : nullptr;
+  const auto prefix_call = prefix_assignment
+                               ? ir::As<ir::Call>(prefix_assignment->value_)
+                               : nullptr;
+  const auto positions_call = positions_assignment
+                                  ? ir::As<ir::Call>(positions_assignment->value_)
+                                  : nullptr;
+  const auto kv_heads_value = kv_heads_assignment
+                                  ? ir::As<ir::ConstInt>(kv_heads_assignment->value_)
+                                  : nullptr;
+  if (!request_assignment || !request_assignment->var_ || !request_call ||
+      !ir::IsOp(request_call, "tensor.read") ||
+      request_call->args_.empty() ||
+      request_call->args_[0].get() != function->params_[4].get() ||
+      !prefix_assignment || !prefix_assignment->var_ || !prefix_call ||
+      !ir::IsOp(prefix_call, "tensor.read") || prefix_call->args_.empty() ||
+      prefix_call->args_[0].get() != function->params_[5].get() ||
+      !positions_assignment || !positions_assignment->var_ ||
+      !positions_call || !ir::IsOp(positions_call, "tile.ci") ||
+      !kv_heads_assignment || !kv_heads_assignment->var_ || !kv_heads_value ||
+      kv_heads_value->value_ != kv_heads || !queries_assignment ||
+      !queries_assignment->var_ || !kv_loop ||
+      kv_loop->stop_.get() != kv_heads_assignment->var_.get() ||
+      kv_loop->kind_ != ir::ForKind::Sequential) {
+    Reject("native paged prefill outer metadata is invalid", &body->span_);
+  }
+
+  const auto kv_body = ir::As<ir::SeqStmts>(kv_loop->body_);
+  const auto slot_loop = kv_body && kv_body->stmts_.size() == 4
+                             ? ir::As<ir::ForStmt>(kv_body->stmts_[2])
+                             : nullptr;
+  const auto q_group_loop = kv_body && kv_body->stmts_.size() == 4
+                                ? ir::As<ir::ForStmt>(kv_body->stmts_[3])
+                                : nullptr;
+  const auto slot_stop =
+      slot_loop ? ir::As<ir::ConstInt>(slot_loop->stop_) : nullptr;
+  if (!kv_body || !slot_loop || !slot_stop || slot_stop->value_ != tokens ||
+      slot_loop->kind_ != ir::ForKind::Sequential || !q_group_loop ||
+      q_group_loop->stop_.get() != queries_assignment->var_.get() ||
+      q_group_loop->kind_ != ir::ForKind::Sequential) {
+    Reject("native paged prefill KV/GQA loops are invalid", &kv_loop->span_);
+  }
+  const auto slot_body = ir::As<ir::SeqStmts>(slot_loop->body_);
+  if (!slot_body || slot_body->stmts_.size() != 4) {
+    Reject("native paged prefill slot loop is invalid", &slot_loop->span_);
+  }
+  for (size_t index : {size_t{2}, size_t{3}}) {
+    const auto assignment = ir::As<ir::AssignStmt>(slot_body->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, "tile.gather_row")) {
+      Reject("native paged prefill must gather K/V rows directly into L1",
+             &slot_body->stmts_[index]->span_);
+    }
+  }
+
+  const auto q_group_body = ir::As<ir::SeqStmts>(q_group_loop->body_);
+  const auto query_loop = q_group_body && q_group_body->stmts_.size() == 2
+                              ? ir::As<ir::ForStmt>(q_group_body->stmts_[1])
+                              : nullptr;
+  const auto query_stop =
+      query_loop ? ir::As<ir::ConstInt>(query_loop->stop_) : nullptr;
+  const auto query_body =
+      query_loop ? ir::As<ir::SeqStmts>(query_loop->body_) : nullptr;
+  if (!q_group_body || !query_loop || !query_stop ||
+      query_stop->value_ != query_rows ||
+      query_loop->kind_ != ir::ForKind::Sequential || !query_body ||
+      query_body->stmts_.size() != 22) {
+    Reject("native paged prefill query loop is invalid", &q_group_loop->span_);
+  }
+  constexpr std::array<std::pair<size_t, std::string_view>, 17> kExpectedOps = {{
+      {0, "tile.load"},
+      {1, "tile.reshape"},
+      {2, "tile.matmul"},
+      {3, "tile.muls"},
+      {7, "tile.cmps"},
+      {8, "tile.create"},
+      {9, "tile.sels"},
+      {10, "tile.create"},
+      {11, "tile.row_max"},
+      {12, "tile.row_expand_sub"},
+      {13, "tile.exp"},
+      {14, "tile.create"},
+      {15, "tile.row_sum"},
+      {16, "tile.row_expand_div"},
+      {17, "tile.cast"},
+      {18, "tile.matmul"},
+      {19, "tile.cast"},
+  }};
+  for (const auto& [index, expected] : kExpectedOps) {
+    const auto assignment = ir::As<ir::AssignStmt>(query_body->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, std::string(expected))) {
+      Reject("native paged prefill attention operation sequence is invalid",
+             &query_body->stmts_[index]->span_);
+    }
+  }
+  const auto result_reshape = ir::As<ir::AssignStmt>(query_body->stmts_[20]);
+  const auto result_reshape_call = result_reshape
+                                       ? ir::As<ir::Call>(result_reshape->value_)
+                                       : nullptr;
+  const auto store = ir::As<ir::EvalStmt>(query_body->stmts_[21]);
+  const auto store_call = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  if (!result_reshape_call || !ir::IsOp(result_reshape_call, "tile.reshape") ||
+      !store_call || !ir::IsOp(store_call, "tile.store")) {
+    Reject("native paged prefill output sequence is invalid", &query_body->span_);
+  }
+  const auto scale_assignment = ir::As<ir::AssignStmt>(query_body->stmts_[3]);
+  const auto scale_call = scale_assignment
+                              ? ir::As<ir::Call>(scale_assignment->value_)
+                              : nullptr;
+  const auto scale = scale_call && scale_call->args_.size() == 2
+                         ? ir::As<ir::ConstFloat>(scale_call->args_[1])
+                         : nullptr;
+  const double expected_scale = 1.0 / std::sqrt(static_cast<double>(head_dim));
+  if (!scale || !std::isfinite(scale->value_) ||
+      std::fabs(scale->value_ - expected_scale) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native paged prefill scale must equal 1/sqrt(head_dim)",
+           scale_call ? &scale_call->span_ : &query_body->span_);
+  }
+
+  return NativeTilePagedPrefillGraph{
+      query,         key_cache, value_cache, req_to_token, request_index,
+      prefix_tokens, result,    query_rows, q_heads,      kv_heads,
+      tokens,        head_dim,  cache_rows, scale->value_};
+}
+
 NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
     const ir::ProgramPtr& program) {
   const auto& [global, function] = *program->functions_.begin();
@@ -6143,6 +6425,328 @@ std::string EmitNativeTilePagedCacheWriteSource(
   return source;
 }
 
+std::string EmitNativeTilePagedPrefillSource(
+    const NativeTilePagedPrefillGraph& graph) {
+  StaticTensor request_prefix{DataType::INT32,
+                              {graph.req_to_token.shape[0], graph.tokens}, {}};
+  request_prefix.dense_strides =
+      MakeDenseStridesForMetadata(request_prefix.shape);
+  StaticTensor index_row{DataType::INT32, {1, graph.tokens}, {}};
+  index_row.dense_strides = MakeDenseStridesForMetadata(index_row.shape);
+  StaticTensor physical_column{DataType::INT32, {graph.tokens, 1}, {}};
+  physical_column.dense_strides =
+      MakeDenseStridesForMetadata(physical_column.shape);
+  StaticTensor physical_indices{DataType::INT32,
+                                {graph.tokens, graph.head_dim}, {}};
+  physical_indices.dense_strides =
+      MakeDenseStridesForMetadata(physical_indices.shape);
+  StaticTensor cache_head{DataType::BF16,
+                          {graph.cache_rows, graph.head_dim}, {}};
+  cache_head.dense_strides = MakeDenseStridesForMetadata(cache_head.shape);
+  StaticTensor gathered{DataType::BF16, {graph.tokens, graph.head_dim}, {}};
+  gathered.dense_strides = MakeDenseStridesForMetadata(gathered.shape);
+  StaticTensor gathered_transposed{DataType::BF16,
+                                   {graph.head_dim, graph.tokens}, {}};
+  gathered_transposed.dense_strides =
+      MakeDenseStridesForMetadata(gathered_transposed.shape);
+  StaticTensor query_box{DataType::BF16, {1, 1, graph.head_dim}, {}};
+  query_box.dense_strides = MakeDenseStridesForMetadata(query_box.shape);
+  StaticTensor query_head{DataType::BF16, {1, graph.head_dim}, {}};
+  query_head.dense_strides = MakeDenseStridesForMetadata(query_head.shape);
+  StaticTensor score{DataType::FP32, {1, graph.tokens}, {}};
+  score.dense_strides = MakeDenseStridesForMetadata(score.shape);
+  StaticTensor row{DataType::FP32, {1, 1}, {1, 1}};
+  StaticTensor probability = score;
+  probability.dtype = DataType::BF16;
+  StaticTensor accumulation{DataType::FP32, {1, graph.head_dim}, {}};
+  accumulation.dense_strides =
+      MakeDenseStridesForMetadata(accumulation.shape);
+  StaticTensor head_result{DataType::BF16, {1, graph.head_dim}, {}};
+  head_result.dense_strides = MakeDenseStridesForMetadata(head_result.shape);
+  StaticTensor head_box{DataType::BF16, {1, 1, graph.head_dim}, {}};
+  head_box.dense_strides = MakeDenseStridesForMetadata(head_box.shape);
+  StaticTensor row_result{DataType::BF16,
+                          {1, graph.q_heads, graph.head_dim}, {}};
+  row_result.dense_strides = MakeDenseStridesForMetadata(row_result.shape);
+
+  const std::string query_type = TensorTypeText(graph.query);
+  const std::string cache_type = TensorTypeText(graph.key_cache);
+  const std::string request_table_type = TensorTypeText(graph.req_to_token);
+  const std::string request_index_type = TensorTypeText(graph.request_index);
+  const std::string request_prefix_type = TensorTypeText(request_prefix);
+  const std::string index_row_type = TensorTypeText(index_row);
+  const std::string physical_column_type = TensorTypeText(physical_column);
+  const std::string physical_indices_type = TensorTypeText(physical_indices);
+  const std::string cache_head_type = TensorTypeText(cache_head);
+  const std::string gathered_type = TensorTypeText(gathered);
+  const std::string gathered_transposed_type =
+      TensorTypeText(gathered_transposed);
+  const std::string query_box_type = TensorTypeText(query_box);
+  const std::string query_head_type = TensorTypeText(query_head);
+  const std::string score_type = TensorTypeText(score);
+  const std::string row_type = TensorTypeText(row);
+  const std::string probability_type = TensorTypeText(probability);
+  const std::string accumulation_type = TensorTypeText(accumulation);
+  const std::string head_result_type = TensorTypeText(head_result);
+  const std::string head_box_type = TensorTypeText(head_box);
+  const std::string row_result_type = TensorTypeText(row_result);
+  const std::string result_type = TensorTypeText(graph.result);
+
+  std::string source;
+  source.reserve(static_cast<size_t>(graph.query_rows * graph.q_heads) * 2048 +
+                 4096);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.key_cache);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.value_cache);
+  source += ",\n    %arg3: ";
+  source += TensorWithStrideText(graph.req_to_token);
+  source += ",\n    %arg4: ";
+  source += TensorWithStrideText(graph.request_index);
+  source += ",\n    %arg5: ";
+  source += TensorWithStrideText(graph.prefix_tokens);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %request_index32 = convert %arg4 : ";
+  source += request_index_type;
+  source += " -> ";
+  source += index_row_type;
+  source += "\n    %request_prefix = slice %arg3 starts = [0, 0] limits = [";
+  source += std::to_string(graph.req_to_token.shape[0]);
+  source += ", ";
+  source += std::to_string(graph.tokens);
+  source += "] strides = [1, 1] : ";
+  source += request_table_type;
+  source += " -> ";
+  source += request_prefix_type;
+  source += "\n    %request_row = gather_rows %request_prefix, "
+            "%request_index32 : (";
+  source += request_prefix_type;
+  source += ", ";
+  source += index_row_type;
+  source += ") -> ";
+  source += index_row_type;
+  source += "\n    %physical_column = transpose %request_row permutation = [1, 0] : ";
+  source += index_row_type;
+  source += " -> ";
+  source += physical_column_type;
+  source += "\n    %physical_indices = broadcast %physical_column : ";
+  source += physical_column_type;
+  source += " -> ";
+  source += physical_indices_type;
+  source += "\n    %valid_positions = iota dimension = 1 : ";
+  source += index_row_type;
+  source += "\n    %mask_floor = constant 0xFF7FFFFF : f32";
+  source += "\n    %mask_floor_splat = splat %mask_floor : ";
+  source += score_type;
+  source += "\n    %scale = constant ";
+  AppendFloat(source, graph.scale);
+  source += " : f32\n    %scale_splat = splat %scale : ";
+  source += score_type;
+
+  std::vector<std::vector<std::string>> head_boxes(
+      static_cast<size_t>(graph.query_rows),
+      std::vector<std::string>(static_cast<size_t>(graph.q_heads)));
+  const int64_t queries_per_kv = graph.q_heads / graph.kv_heads;
+  for (int64_t kv_head = 0; kv_head < graph.kv_heads; ++kv_head) {
+    const int64_t column_start = kv_head * graph.head_dim;
+    const int64_t column_limit = column_start + graph.head_dim;
+    const std::string kv_suffix = std::to_string(kv_head);
+    source += "\n    %k_table_" + kv_suffix +
+              " = slice %arg1 starts = [0, " +
+              std::to_string(column_start) + "] limits = [" +
+              std::to_string(graph.cache_rows) + ", " +
+              std::to_string(column_limit) + "] strides = [1, 1] : ";
+    source += cache_type;
+    source += " -> ";
+    source += cache_head_type;
+    source += "\n    %k_" + kv_suffix + " = gather_rows %k_table_" +
+              kv_suffix + ", %physical_indices : (";
+    source += cache_head_type;
+    source += ", ";
+    source += physical_indices_type;
+    source += ") -> ";
+    source += gathered_type;
+    source += "\n    %kt_" + kv_suffix + " = transpose %k_" + kv_suffix +
+              " permutation = [1, 0] : ";
+    source += gathered_type;
+    source += " -> ";
+    source += gathered_transposed_type;
+    source += "\n    %v_table_" + kv_suffix +
+              " = slice %arg2 starts = [0, " +
+              std::to_string(column_start) + "] limits = [" +
