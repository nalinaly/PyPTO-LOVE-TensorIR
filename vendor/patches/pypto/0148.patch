+  std::vector<std::string> row_values;
+  row_values.reserve(static_cast<size_t>(graph.query_rows));
+  for (int64_t query_row = 0; query_row < graph.query_rows; ++query_row) {
+    const auto& heads = head_boxes[static_cast<size_t>(query_row)];
+    if (graph.q_heads == 1) {
+      row_values.push_back(heads[0]);
+      continue;
+    }
+    const std::string row_name = "%row_" + std::to_string(query_row);
+    source += "\n    " + row_name + " = concatenate ";
+    for (size_t head = 0; head < heads.size(); ++head) {
+      if (head != 0) source += ", ";
+      source += heads[head];
+    }
+    source += " dimension = 1 : (";
+    for (size_t head = 0; head < heads.size(); ++head) {
+      if (head != 0) source += ", ";
+      source += head_box_type;
+    }
+    source += ") -> ";
+    source += row_result_type;
+    row_values.push_back(row_name);
