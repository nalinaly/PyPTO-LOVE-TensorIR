+std::string EmitStructuredMatmulSource(const StructuredMatmulGraph& graph) {
+  const std::string lhs_physical = TensorTypeText(graph.lhs);
+  const std::string rhs_physical = TensorTypeText(graph.rhs);
+  const std::string result_type = TensorTypeText(graph.result);
+  const StaticTensor lhs_logical =
+      graph.a_trans ? TransposeMatrixDims(graph.lhs) : graph.lhs;
+  const StaticTensor rhs_logical =
+      graph.b_trans ? TransposeMatrixDims(graph.rhs) : graph.rhs;
+  StaticTensor accumulation = graph.result;
+  accumulation.dtype = DataType::FP32;
+  const std::string lhs_logical_type = TensorTypeText(lhs_logical);
+  const std::string rhs_logical_type = TensorTypeText(rhs_logical);
+  const std::string accumulation_type = TensorTypeText(accumulation);
+  const std::string permutation =
+      graph.lhs.shape.size() == 2 ? "[1, 0]" : "[0, 2, 1]";
+
+  std::string source;
+  source.reserve(1024 + lhs_physical.size() * 3 + rhs_physical.size() * 3 +
+                 result_type.size() * 3);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kStructuredMatmulEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.lhs);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.rhs);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n";
+  if (graph.a_trans) {
+    source += "    %lhs0 = transpose %arg0 permutation = ";
+    source += permutation;
+    source += " : ";
+    source += lhs_physical;
+    source += " -> ";
+    source += lhs_logical_type;
+    source += "\n";
+  }
+  if (graph.b_trans) {
+    source += "    %rhs0 = transpose %arg1 permutation = ";
+    source += permutation;
+    source += " : ";
+    source += rhs_physical;
+    source += " -> ";
+    source += rhs_logical_type;
+    source += "\n";
+  }
+  source += "    %accum0 = matmul(";
+  source += graph.a_trans ? "%lhs0, " : "%arg0, ";
+  source += graph.b_trans ? "%rhs0)\n" : "%arg1)\n";
+  source += "      : (";
+  source += lhs_logical_type;
+  source += ", ";
+  source += rhs_logical_type;
+  source += ") -> ";
+  source += accumulation_type;
+  source += "\n    %result0 = convert %accum0 : ";
+  source += accumulation_type;
+  source += " -> ";
+  source += result_type;
+  source += "\n    results %result0 : ";
+  source += result_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
