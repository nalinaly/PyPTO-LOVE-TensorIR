+  REQUIRE(Rejects([&] { (void)EmitTensorIr(extra_statement_program); },
+                  "exactly one assignment and one return"));
+
+  const ir::StmtPtr& valid_body =
+      valid.program->functions_.begin()->second->body_;
+  auto attributed_function = MakeRawProgram(
+      {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.result_type},
+      valid_body, {{"ignored", true}}, false, ir::FunctionType::Opaque,
+      "matmul");
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(attributed_function); },
+                  "function attributes"));
+  auto runtime_bound = MakeRawProgram(
+      {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.result_type},
+      valid_body, {}, true, ir::FunctionType::Opaque, "matmul");
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(runtime_bound); },
+                  "runtime-bound functions"));
+  auto incore = MakeRawProgram(
+      {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.result_type},
+      valid_body, {}, false, ir::FunctionType::InCore, "matmul");
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(incore); },
+                  "must be Opaque with no hierarchy"));
+  auto wrong_direction = MakeRawProgram(
+      {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::Out}, {valid.result_type},
+      valid_body, {}, false, ir::FunctionType::Opaque, "matmul");
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(wrong_direction); },
+                  "must have direction In"));
+  auto missing_direction = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In}, {valid.result_type},
+      valid_body, {}, false, ir::FunctionType::Opaque, "matmul");
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(missing_direction); },
+                  "parameter-direction count must be 2, got 1"));
+  auto missing_return_type = MakeProgram(
+      "matmul", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {},
+      {std::make_shared<ir::AssignStmt>(
+           valid.result,
+           OpCall("tensor.matmul", {valid.lhs, valid.rhs}, valid.result_type),
+           TestSpan()),
+       returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(missing_return_type); },
+                  "exactly one declared return"));
+  return 0;
+}
