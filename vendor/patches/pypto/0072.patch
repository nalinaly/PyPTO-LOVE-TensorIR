+  if (!assignment || !assignment->value_) return false;
+  const auto call = ir::As<ir::Call>(assignment->value_);
+  return call && call->op_ &&
+         (ir::IsOp(call, "tensor.matmul") || ir::IsOp(call, "tensor.matmul_acc"));
