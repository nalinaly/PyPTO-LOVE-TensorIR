+struct StructuredMatmulProgram {
+  ir::ProgramPtr program;
+  ir::VarPtr lhs;
+  ir::VarPtr rhs;
+  ir::VarPtr result;
+  ir::TensorTypePtr lhs_type;
+  ir::TensorTypePtr rhs_type;
+  ir::TensorTypePtr result_type;
+};
+
+StructuredMatmulProgram MakeStructuredMatmul(
+    const std::vector<int64_t>& lhs_shape = {32, 128},
+    const std::vector<int64_t>& rhs_shape = {128, 16},
+    const std::vector<int64_t>& result_shape = {32, 16},
+    DataType lhs_dtype = DataType::BF16, DataType rhs_dtype = DataType::BF16,
+    DataType result_dtype = DataType::BF16,
+    std::vector<std::pair<std::string, std::any>> kwargs = {},
+    std::vector<std::pair<std::string, std::any>> attrs = {},
+    const std::string& op_name = "tensor.matmul",
+    const std::string& function_name = "structured_matmul",
+    const std::string& lhs_name = "lhs", const std::string& rhs_name = "rhs",
+    const std::string& result_name = "result") {
+  auto lhs_type = PlainTensor(lhs_shape, lhs_dtype);
+  auto rhs_type = PlainTensor(rhs_shape, rhs_dtype);
+  auto result_type = PlainTensor(result_shape, result_dtype);
+  auto lhs = std::make_shared<ir::Var>(lhs_name, lhs_type, TestSpan());
+  auto rhs = std::make_shared<ir::Var>(rhs_name, rhs_type, TestSpan());
+  auto result = std::make_shared<ir::Var>(result_name, result_type, TestSpan());
+  auto call = OpCall(op_name, {lhs, rhs}, result_type, std::move(kwargs),
+                     std::move(attrs));
+  auto assignment = std::make_shared<ir::AssignStmt>(result, call, TestSpan());
+  auto returned =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  return {MakeProgram(function_name, {lhs, rhs},
+                      {ir::ParamDirection::In, ir::ParamDirection::In},
+                      {result_type}, {assignment, returned}),
+          lhs, rhs, result, lhs_type, rhs_type, result_type};
+}
