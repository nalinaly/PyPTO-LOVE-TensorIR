+KernelOptions StructuredMatmulKernelOptions(
+    const std::vector<int64_t>& lhs_shape = {32, 128},
+    const std::vector<int64_t>& rhs_shape = {128, 16},
+    const std::vector<int64_t>& result_shape = {32, 16},
+    const std::vector<uint32_t>& tile_sizes = {32, 16}, uint32_t grid_x = 1) {
+  const auto dense_strides = [](const std::vector<int64_t>& shape) {
+    std::vector<int64_t> strides(shape.size());
+    int64_t running = 1;
+    for (size_t reverse_index = shape.size(); reverse_index > 0; --reverse_index) {
+      const size_t index = reverse_index - 1;
+      strides[index] = running;
+      running *= shape[index];
+    }
+    return strides;
+  };
+  KernelOptions options;
+  options.entry_function_name = "pypto_structured_matmul_v4";
+  options.input_count = 2;
+  options.grid_shape_operand_index = 2;
+  options.static_grid = {grid_x, 1, 1};
+  options.tile_sizes = tile_sizes;
+  options.descriptors = DescriptorVector(
+      TensorDescriptor(lhs_shape, dense_strides(lhs_shape)),
+      TensorDescriptor(rhs_shape, dense_strides(rhs_shape)),
+      TensorDescriptor(result_shape, dense_strides(result_shape)));
+  return options;
+}
