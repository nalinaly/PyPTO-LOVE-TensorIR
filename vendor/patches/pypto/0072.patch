+    const codegen::nvidia::TensorIrModule& module,
+    const StrictTensorIrProducerOptions& resolved_options,
+    const CompileRequest& request) {
+  if (module.GetKind() !=
+      codegen::nvidia::TensorIrModuleKind::StructuredMatmulV4) {
+    return;
+  }
+  INTERNAL_CHECK(module.GetValueMetadata().size() == 3 &&
+                 module.GetInputCount() == 2 && module.GetResultCount() == 1)
+      << "structured matmul v4 module must contain two inputs and one result";
+  const auto& result_shape = module.GetValueMetadata()[2].GetShape();
+  const std::vector<uint64_t> extents =
+      StructuredMatmulIterationExtents(result_shape);
+  CHECK(resolved_options.tile_sizes.size() == extents.size())
+      << "structured matmul v4 requires " << extents.size()
+      << " normalized tile dimensions, got " << resolved_options.tile_sizes.size();
+
+  uint64_t tile_product = 1;
+  uint64_t grid_product = 1;
+  for (size_t index = 0; index < extents.size(); ++index) {
+    const uint32_t tile = resolved_options.tile_sizes[index];
+    CHECK(tile != 0 && (tile & (tile - 1)) == 0)
+        << "structured matmul v4 tile dim_" << index
+        << " must be a positive power of two, got " << tile;
+    CHECK(static_cast<uint64_t>(tile) <= extents[index])
+        << "structured matmul v4 tile dim_" << index
+        << " must not exceed bit_floor(normalized extent " << extents[index]
+        << "), got " << tile;
+    CHECK(static_cast<uint64_t>(tile) <=
+          std::numeric_limits<uint64_t>::max() / tile_product)
+        << "structured matmul v4 tile product overflows uint64";
+    tile_product *= static_cast<uint64_t>(tile);
+    const uint64_t grid_extent =
+        extents[index] / tile + (extents[index] % tile == 0 ? 0 : 1);
+    CHECK(grid_extent <= std::numeric_limits<uint64_t>::max() / grid_product)
+        << "structured matmul v4 grid product overflows uint64";
+    grid_product *= grid_extent;
+  }
+
+  const uint64_t contraction_extent = module.GetContractionExtent();
+  INTERNAL_CHECK(contraction_extent != 0 && contraction_extent % 128 == 0)
+      << "structured matmul v4 contraction extent must be a positive multiple of 128";
+  INTERNAL_CHECK(result_shape.back() % 16 == 0)
+      << "structured matmul v4 N must be a multiple of 16";
+  const uint64_t contraction_tile =
+      StructuredMatmulContractionTile(contraction_extent, resolved_options);
+  const uint64_t contraction_chunks =
+      contraction_extent / contraction_tile +
+      (contraction_extent % contraction_tile == 0 ? 0 : 1);
+  CHECK(tile_product <=
+        kCudaTileCompilerMaximumTileElements / contraction_tile)
+      << "structured matmul v4 resolved tile product*r exceeds the pinned CUDA Tile compiler "
+         "maximum tile elements "
+      << kCudaTileCompilerMaximumTileElements << " (tile product=" << tile_product
+      << ", r=" << contraction_tile << ")";
+  CHECK(contraction_chunks <=
+        static_cast<uint64_t>(std::numeric_limits<int32_t>::max()))
+      << "structured matmul v4 contraction chunk count ceil(K/r)="
+      << contraction_chunks << " (K=" << contraction_extent
+      << ", r=" << contraction_tile
+      << ") exceeds INT32_MAX because TensorIR lowering materializes an i32 loop bound";
+  const int64_t max_grid_x = request.GetTargetInfo().GetTraits().GetMaxGridDimX();
+  CHECK(grid_product <=
+            static_cast<uint64_t>(std::numeric_limits<int32_t>::max()) &&
+        grid_product <= static_cast<uint64_t>(max_grid_x))
+      << "structured matmul v4 static grid x=" << grid_product
+      << " exceeds the prepared target limit " << max_grid_x;
+}
