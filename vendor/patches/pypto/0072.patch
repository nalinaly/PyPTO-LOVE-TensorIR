+StaticTensor TransposeMatrixDims(const StaticTensor& tensor) {
+  StaticTensor transposed = tensor;
+  std::swap(transposed.shape[transposed.shape.size() - 2], transposed.shape.back());
+  transposed.dense_strides = MakeDenseStridesForMetadata(transposed.shape);
+  return transposed;
+}
