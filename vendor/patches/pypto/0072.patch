+StructuredMatmulGraph AnalyzeStructuredMatmulV4(const ir::ProgramPtr& program) {
+  if (!program) Reject("program must not be null");
+  if (program->functions_.size() != 1) {
+    Reject("program must contain exactly one function", &program->span_);
+  }
+
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function) Reject("program contains a null function binding", &program->span_);
+  if (global->name_ != function->name_) {
+    Reject("global function name does not match the bound function name", &function->span_);
+  }
+  if (function->requires_runtime_binding_) {
+    Reject("runtime-bound functions are not supported", &function->span_);
+  }
+  if (function->func_type_ != ir::FunctionType::Opaque || function->level_.has_value() ||
+      function->role_.has_value()) {
+    Reject("function must be Opaque with no hierarchy level or role", &function->span_);
+  }
+  if (!function->attrs_.empty()) {
+    Reject("function attributes are not supported", &function->span_);
+  }
+  if (function->params_.size() != 2) {
+    Reject("structured matmul v4 requires exactly two function parameters, got " +
+               std::to_string(function->params_.size()),
+           &function->span_);
+  }
+  if (function->param_directions_.size() != 2) {
+    Reject("structured matmul v4 parameter-direction count must be 2, got " +
+               std::to_string(function->param_directions_.size()),
+           &function->span_);
+  }
+  if (!std::all_of(function->param_directions_.begin(), function->param_directions_.end(),
+                   [](ir::ParamDirection direction) {
+                     return direction == ir::ParamDirection::In;
+                   })) {
+    Reject("both structured matmul parameters must have direction In", &function->span_);
+  }
+  if (function->return_types_.size() != 1) {
+    Reject("structured matmul v4 requires exactly one declared return, got " +
+               std::to_string(function->return_types_.size()),
+           &function->span_);
+  }
+
+  std::vector<StaticTensor> inputs;
+  inputs.reserve(2);
+  std::unordered_set<const ir::Var*> parameter_identities;
+  for (size_t index = 0; index < function->params_.size(); ++index) {
+    const ir::VarPtr& parameter = function->params_[index];
+    if (!parameter) Reject("function contains a null parameter", &function->span_);
+    if (parameter->GetKind() != ir::ObjectKind::Var) {
+      Reject("structured matmul parameters must be exact Var nodes", &parameter->span_);
+    }
+    if (!parameter_identities.insert(parameter.get()).second) {
+      Reject("structured matmul parameters must have distinct IR identities",
+             &parameter->span_);
+    }
+    inputs.push_back(ReadStaticTensor(parameter->GetType(), parameter->span_,
+                                      "structured matmul parameter"));
+    if (inputs.back().dtype != DataType::BF16) {
+      Reject("structured matmul parameters must have BF16 dtype, got " +
+                 inputs.back().dtype.ToString(),
+             &parameter->span_);
+    }
+    if (inputs.back().shape.size() != 2 && inputs.back().shape.size() != 3) {
+      Reject("structured matmul parameters must both have rank 2 or rank 3, got rank " +
+                 std::to_string(inputs.back().shape.size()),
+             &parameter->span_);
+    }
+  }
+  if (inputs[0].shape.size() != inputs[1].shape.size()) {
