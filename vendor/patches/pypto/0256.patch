         llvm::ArrayRef<int64_t>{1, 1, 1})
         .getOutput();
+    mlir::Value query = query_box;
+    if (rank_two_attention) {
+      query = tir::ReshapeOp::create(
+                  builder, location, query_row_group_type, query_box,
+                  mlir::ValueRange{})
+                  .getOutput();
+    }
     const mlir::Value scores = tir::MatmulOp::create(
         builder, location, score_type, query, key_batch)
         .getC();
@@ -1069,7 +1093,8 @@ mlir::Value BuildNativePagedPrefillBatched(
         .getOutput();
     const mlir::Value row_max = tir::ReduceOp::create(
         builder, location, row_type, masked,
