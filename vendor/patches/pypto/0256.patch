+        llvm::ArrayRef<int32_t>{rank_two_attention ? 1 : 2},
+        tir::ReductionMode::max)
         .getOutput();
     const mlir::Value max_broadcast = tir::BroadcastOp::create(
         builder, location, score_type, row_max, mlir::ValueRange{})
@@ -1082,7 +1107,8 @@ mlir::Value BuildNativePagedPrefillBatched(
         .getOutput();
     const mlir::Value row_sum = tir::ReduceOp::create(
         builder, location, row_type, exponent,
-        llvm::ArrayRef<int32_t>{2}, tir::ReductionMode::add)
+        llvm::ArrayRef<int32_t>{rank_two_attention ? 1 : 2},
+        tir::ReductionMode::add)
         .getOutput();
     const mlir::Value inverse = tir::ReciprocalOp::create(
         builder, location, row_type, row_sum)
@@ -1099,9 +1125,14 @@ mlir::Value BuildNativePagedPrefillBatched(
     const mlir::Value mixed = tir::MatmulOp::create(
         builder, location, accumulation_type, probability, value_batch)
         .getC();
-    const mlir::Value head = tir::ConvertOp::create(
+    mlir::Value head = tir::ConvertOp::create(
         builder, location, head_result_type, mixed)
         .getOutput();
+    if (rank_two_attention) {
+      head = tir::ReshapeOp::create(builder, location, head_box_type, head,
+                                    mlir::ValueRange{})
+                 .getOutput();
+    }
     head_boxes.push_back(head);
   }
   if (head_boxes.size() == 1) return head_boxes.front();
diff --git a/tests/ut/cpp/structured_compile_test.cpp b/tests/ut/cpp/structured_compile_test.cpp
index e81a00d882bafc5a4c93d91162553543c928b5ed..d3aa757f346a5221edf9874acdd8f8eb41d329d2 100644
--- a/tests/ut/cpp/structured_compile_test.cpp
+++ b/tests/ut/cpp/structured_compile_test.cpp
@@ -1132,6 +1132,27 @@ int TestTypedPagedPrefillHeadMajorModuleBuilder() {
       BuildTypedTensorIrModule(module_spec, one_row_diagnostic);
   REQUIRE(one_row.has_value());
   REQUIRE(one_row_diagnostic.empty());
+
+  module_spec.native_paged_prefill.query_rows = 19;
+  module_spec.native_paged_prefill.query_heads = 1;
+  module_spec.native_paged_prefill.kv_heads = 1;
+  module_spec.native_paged_prefill.inputs[0].shape = {1, 19, 256};
+  module_spec.native_paged_prefill.inputs[1].shape = {257, 256};
+  module_spec.native_paged_prefill.inputs[1].strides = {256, 1};
+  module_spec.native_paged_prefill.inputs[2].shape = {257, 256};
+  module_spec.native_paged_prefill.inputs[2].strides = {256, 1};
+  module_spec.native_paged_prefill.result.shape = {1, 19, 256};
+  std::string single_head_diagnostic;
+  auto single_head =
+      BuildTypedTensorIrModule(module_spec, single_head_diagnostic);
+  REQUIRE(single_head.has_value());
+  REQUIRE(single_head_diagnostic.empty());
+  const std::string single_head_source(single_head->canonical_source.begin(),
+                                       single_head->canonical_source.end());
+  REQUIRE(single_head_source.find("tensor<19x32xf32>") !=
+          std::string::npos);
+  REQUIRE(single_head_source.find("tensor<1x19x32xf32>") ==
+          std::string::npos);
 #endif
   return 0;
 }
