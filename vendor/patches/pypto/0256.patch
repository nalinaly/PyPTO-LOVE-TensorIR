-      {queries_per_kv, spec.query_rows, tokens});
+      rank_two_attention
+          ? std::vector<int64_t>{spec.query_rows, tokens}
+          : std::vector<int64_t>{queries_per_kv, spec.query_rows, tokens});
   const auto accumulation_type = TensorType(
       builder, TypedTensorIrElementType::FP32,
-      {queries_per_kv, spec.query_rows, head_dim});
+      rank_two_attention
+          ? std::vector<int64_t>{spec.query_rows, head_dim}
+          : std::vector<int64_t>{queries_per_kv, spec.query_rows, head_dim});
   const auto head_result_type = TensorType(
