+  if (!rank_two_attention) {
+    const mlir::Value positions_seed = tir::ReshapeOp::create(
+        builder, location, position_seed_type, positions_matrix,
+        mlir::ValueRange{})
+        .getOutput();
     positions_batch = tir::BroadcastOp::create(
                           builder, location, position_batch_type, positions_seed,
                           mlir::ValueRange{})
@@ -972,16 +991,14 @@ mlir::Value BuildNativePagedPrefillBatched(
                       valid_count_column, mlir::ValueRange{})
                       .getOutput();
   }
-  const mlir::Value valid_count_seed = tir::ReshapeOp::create(
-      builder, location, position_seed_type, valid_count, mlir::ValueRange{})
-      .getOutput();
-  if (queries_per_kv != 1) {
+  if (!rank_two_attention) {
+    const mlir::Value valid_count_seed = tir::ReshapeOp::create(
+        builder, location, position_seed_type, valid_count, mlir::ValueRange{})
+        .getOutput();
     valid_count = tir::BroadcastOp::create(
                       builder, location, position_batch_type, valid_count_seed,
                       mlir::ValueRange{})
                       .getOutput();
-  } else {
-    valid_count = valid_count_seed;
   }
   const mlir::Value valid_mask = tir::CmpOp::create(
       builder, location, mask_type, tir::Comparator::lt, positions_batch,
@@ -1021,11 +1038,11 @@ mlir::Value BuildNativePagedPrefillBatched(
         builder, location, gathered_transposed_type, key,
         llvm::ArrayRef<int64_t>{1, 0})
         .getOutput();
-    const mlir::Value key_seed = tir::ReshapeOp::create(
-        builder, location, key_seed_type, key_transposed, mlir::ValueRange{})
-        .getOutput();
-    mlir::Value key_batch = key_seed;
-    if (queries_per_kv != 1) {
+    mlir::Value key_batch = key_transposed;
+    if (!rank_two_attention) {
+      const mlir::Value key_seed = tir::ReshapeOp::create(
+          builder, location, key_seed_type, key_transposed, mlir::ValueRange{})
+          .getOutput();
       key_batch = tir::BroadcastOp::create(
                       builder, location, key_batch_type, key_seed,
                       mlir::ValueRange{})
@@ -1040,24 +1057,31 @@ mlir::Value BuildNativePagedPrefillBatched(
     const mlir::Value value = tir::GatherRowsOp::create(
