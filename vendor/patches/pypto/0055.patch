From b5e5cae16bdf2344120b780340a6bc6d0a6da79f Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Thu, 27 Aug 2026 01:01:06 +0800
Subject: [PATCH 055/263] codegen: pin row-sum accumulator identity with an
 explicit +0 epilogue

The frozen RowReductionV3 contract requires an FP32 accumulator with
the +0 identity, so a row of negative zeros must reduce to +0. The
tile backend's single-element reduction fast path can return the
element itself, producing -0 (observed on real SM120 in run
pypto-20260826T165111Z-173109-3f7a6a). Emit an explicit
constant/splat/add of +0 after every row_sum reduction in the FP32
compute domain: IEEE x + (+0) leaves every value bit-identical except
-0, which becomes +0. row_max is unchanged because its contract
preserves -0. Source goldens updated.
---
 src/codegen/nvidia/tensor_ir_codegen.cpp | 34 +++++++++++++++++++++---
 tests/ut/cpp/tensor_ir_codegen_test.cpp  | 28 +++++++++++++------
 2 files changed, 50 insertions(+), 12 deletions(-)

diff --git a/src/codegen/nvidia/tensor_ir_codegen.cpp b/src/codegen/nvidia/tensor_ir_codegen.cpp
index 754f65edf7b444a88e47fc7e813411c78c0080ca..0a25fd4e54a3cc79078073259e503c092fecde7a 100644
--- a/src/codegen/nvidia/tensor_ir_codegen.cpp
+++ b/src/codegen/nvidia/tensor_ir_codegen.cpp
@@ -507,7 +507,8 @@ std::string EmitRowReductionSource(const RowReductionGraph& graph) {
     source += "\n";
   }
 
-  const bool reduction_is_result = !flatten && !widen;
+  const bool normalize_sum = graph.mode == RowReductionMode::Sum;
+  const bool reduction_is_result = !flatten && !widen && !normalize_sum;
   source += reduction_is_result ? "    %result0 = reduce(" : "    %reduce0 = reduce(";
   source += flatten ? "%flat0" : (widen ? "%wide0" : "%arg0");
   source += ") <dimensions = [";
@@ -522,9 +523,34 @@ std::string EmitRowReductionSource(const RowReductionGraph& graph) {
                   : TensorTypeText(reduction_result);
   source += "\n";
 
+  if (normalize_sum) {
+    // The frozen row_sum contract is an FP32 accumulator with the +0
+    // identity, so a row of negative zeros must produce +0. Adding the
+    // explicit +0 splat after the reduction keeps every other value
+    // bit-identical while pinning the accumulator semantics the tile
+    // backend's single-element fast path does not guarantee.
+    const std::string compute_type =
+        widen ? TensorTypeText(compute_reduction_result)
+              : TensorTypeText(reduction_result);
+    const char* const sum_result_name =
+        (!flatten && !widen) ? "%result0" : "%sum0";
+    source += "    %sumzero = constant ";
+    AppendFloat(source, 0.0);
+    source += " : ";
+    source += TensorIrDtype(DataType::FP32);
+    source += "\n    %sumsplat = splat %sumzero : ";
+    source += compute_type;
+    source += "\n";
+    source += "    ";
+    source += sum_result_name;
+    source += " = add %reduce0, %sumsplat : ";
+    source += compute_type;
+    source += "\n";
+  }
+
   if (flatten) {
-    source += widen ? "    %shape0 = reshape %reduce0 : "
-                    : "    %result0 = reshape %reduce0 : ";
+    source += widen ? "    %shape0 = reshape %sum0 : "
+                    : "    %result0 = reshape %sum0 : ";
     source += widen ? TensorTypeText(compute_reduction_result)
                     : TensorTypeText(reduction_result);
     source += " -> ";
@@ -533,7 +559,7 @@ std::string EmitRowReductionSource(const RowReductionGraph& graph) {
   }
   if (widen) {
     source += flatten ? "    %result0 = convert %shape0 : "
-                      : "    %result0 = convert %reduce0 : ";
+                      : "    %result0 = convert %sum0 : ";
     source += TensorTypeText(compute_result);
     source += " -> ";
     source += result_type;
