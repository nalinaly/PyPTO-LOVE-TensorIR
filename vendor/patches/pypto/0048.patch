+def test_round_trip_preserves_all_scalar_extrema_and_categories() -> None:
+    canonical = boundary_schedule().serialize()
+    restored = CanonicalSchedule.deserialize(canonical)
+
+    assert restored.serialize() == canonical
+    assert restored.schedule[0].canonical_value == "false"
+    assert restored.tile[0].canonical_value == "true"
+    assert restored.layout[0].canonical_value == str(-(1 << 63))
+    assert restored.persistence[0].canonical_value == str((1 << 63) - 1)
+    assert restored.cta[0].canonical_value == "0"
+    assert restored.warp[0].canonical_value == str((1 << 64) - 1)
+    assert restored.stage[0].canonical_value == "three-stage"
+    assert restored.options[0].canonical_value == "0"
+    assert restored.layout[0].value_kind == ScheduleValueKind.SignedInteger
+    assert restored.warp[0].value_kind == ScheduleValueKind.UnsignedInteger
+    with pytest.raises(AttributeError):
+        setattr(restored, "tile", [])
+    with pytest.raises(AttributeError):
+        setattr(restored.tile[0], "canonical_value", "false")
+    copied_tile = restored.tile
+    copied_tile.clear()
+    assert restored.tile[0].canonical_value == "true"
