+int main() {
+  static_assert(CanonicalSchedule::kCanonicalScheduleSchemaVersion == 1);
+  static_assert(CanonicalSchedule::kContract == "pypto.canonical_schedule.v1");
+  static_assert(!std::is_default_constructible_v<CanonicalSchedule>);
+  static_assert(!std::is_copy_assignable_v<CanonicalSchedule>);
+  static_assert(!std::is_move_assignable_v<CanonicalSchedule>);
+
+  const CanonicalSchedule empty = EmptySchedule();
+  const std::vector<uint8_t> empty_golden = BytesFromHex(kEmptyScheduleGoldenHex);
+  REQUIRE(empty.SerializeCanonical() == empty_golden);
+  REQUIRE(empty.GetCanonicalScheduleSchemaVersion() == 1);
+  REQUIRE(empty.GetContract() == "pypto.canonical_schedule.v1");
+  REQUIRE(empty.GetIdentityDigest() ==
+          "3d1ea8ab4f5053d979ff9ac4d8d9cf6f90188578f25fa976c185a65ebfd19c0e");
+  const CanonicalSchedule empty_round_trip = CanonicalSchedule::DeserializeCanonical(empty_golden);
+  REQUIRE(empty_round_trip.SerializeCanonical() == empty_golden);
+  REQUIRE(empty_round_trip.GetSchedule().empty());
+  REQUIRE(empty_round_trip.GetTile().empty());
+  REQUIRE(empty_round_trip.GetLayout().empty());
+  REQUIRE(empty_round_trip.GetPersistence().empty());
+  REQUIRE(empty_round_trip.GetCta().empty());
+  REQUIRE(empty_round_trip.GetWarp().empty());
+  REQUIRE(empty_round_trip.GetStage().empty());
+  REQUIRE(empty_round_trip.GetOptions().empty());
+
+  const CanonicalSchedule boundaries =
+      CanonicalSchedule::DeserializeCanonical(BoundarySchedule().SerializeCanonical());
+  REQUIRE(boundaries.GetSchedule().front().GetCanonicalValue() == "false");
+  REQUIRE(boundaries.GetTile().front().GetCanonicalValue() == "true");
+  REQUIRE(boundaries.GetLayout().front().GetCanonicalValue() ==
+          std::to_string(std::numeric_limits<int64_t>::min()));
+  REQUIRE(boundaries.GetPersistence().front().GetCanonicalValue() ==
+          std::to_string(std::numeric_limits<int64_t>::max()));
+  REQUIRE(boundaries.GetCta().front().GetCanonicalValue() == "0");
+  REQUIRE(boundaries.GetWarp().front().GetCanonicalValue() ==
+          std::to_string(std::numeric_limits<uint64_t>::max()));
+  REQUIRE(boundaries.GetStage().front().GetCanonicalValue() == "three-stage");
+  REQUIRE(boundaries.GetOptions().front().GetCanonicalValue() == "0");
+
+  std::vector<std::string> category_digests = {
+      CanonicalSchedule({Parameter("value", ScheduleValueKind::Boolean, "true")}, {}, {}, {}, {}, {},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {Parameter("value", ScheduleValueKind::Boolean, "true")}, {}, {}, {}, {},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {Parameter("value", ScheduleValueKind::Boolean, "true")}, {}, {}, {},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {}, {Parameter("value", ScheduleValueKind::Boolean, "true")}, {}, {},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {}, {}, {Parameter("value", ScheduleValueKind::Boolean, "true")}, {},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {}, {}, {}, {Parameter("value", ScheduleValueKind::Boolean, "true")},
+                        {}, {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {}, {}, {}, {}, {Parameter("value", ScheduleValueKind::Boolean, "true")},
+                        {})
+          .GetIdentityDigest(),
+      CanonicalSchedule({}, {}, {}, {}, {}, {}, {},
+                        {Parameter("value", ScheduleValueKind::Boolean, "true")})
+          .GetIdentityDigest(),
+  };
+  std::sort(category_digests.begin(), category_digests.end());
+  REQUIRE(std::adjacent_find(category_digests.begin(), category_digests.end()) ==
+          category_digests.end());
+
+  const auto maximum_category = MaximumCardinalityCategory(ScheduleValueKind::Boolean, "false");
+  const CanonicalSchedule maximum_cardinality(maximum_category, maximum_category, maximum_category,
+                                              maximum_category, maximum_category, maximum_category,
+                                              maximum_category, maximum_category);
+  REQUIRE(CanonicalSchedule::DeserializeCanonical(maximum_cardinality.SerializeCanonical())
+              .GetOptions()
+              .size() == 128);
+  const CanonicalSchedule maximum_text(
+      {Parameter("value", ScheduleValueKind::Text, std::string(4096, 'x'))}, {}, {}, {}, {}, {}, {}, {});
+  REQUIRE(CanonicalSchedule::DeserializeCanonical(maximum_text.SerializeCanonical())
+              .GetSchedule()
+              .front()
+              .GetCanonicalValue()
+              .size() == 4096);
+
+  REQUIRE(RejectsConstruction([&] {
+    const auto maximum_text_category =
+        MaximumCardinalityCategory(ScheduleValueKind::Text, std::string(4096, 'x'));
+    (void)CanonicalSchedule(maximum_text_category, maximum_text_category, {}, {}, {}, {}, {}, {});
+  }));
+  REQUIRE(RejectsConstruction([] {
+    auto too_many = MaximumCardinalityCategory(ScheduleValueKind::Boolean, "false");
+    too_many.emplace_back("value_128", ScheduleValueKind::Boolean, "false");
+    (void)CanonicalSchedule(std::move(too_many), {}, {}, {}, {}, {}, {}, {});
+  }));
+
+  const KernelBuildSpec existing_spec = BuildSpec(ExistingKernelBuildSpecSchedule(), true);
+  REQUIRE(existing_spec.GetIdentityDigest() ==
+          "93cab0033e5eb53ca87468c52348ffbfe5e17cd5d611080b2b8087af67fa93f6");
+  const KernelBuildSpec empty_spec = BuildSpec(EmptySchedule(), false);
+  const std::vector<uint8_t> nested_empty_body =
+      ExtractResolvedScheduleBody(empty_spec.SerializeCanonical());
+  REQUIRE(nested_empty_body == BytesFromHex(kEmptyResolvedScheduleBodyGoldenHex));
+  REQUIRE(nested_empty_body == ExtractResolvedScheduleBody(empty.SerializeCanonical()));
+  REQUIRE(RejectsSchedule(nested_empty_body));
+  REQUIRE(RejectsBuildSpec(
+      WrapKernelBuildSpecSchedule(empty_spec.SerializeCanonical(), empty.SerializeCanonical())));
+
+  REQUIRE(RejectsSchedule({}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xc1}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xc0}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xca, 0x00, 0x00, 0x00, 0x00}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xd4, 0x00, 0x00}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xc4, 0x00}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xdc, 0x00, 0x81}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0x89}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>{0xdb, 0x00, 0x00, 0x10, 0x01}));
+  REQUIRE(RejectsSchedule(std::vector<uint8_t>(1024 * 1024 + 1, 0)));
+  std::vector<uint8_t> depth_bomb(6, 0x91);
+  depth_bomb.back() = 0xc0;
+  REQUIRE(RejectsSchedule(depth_bomb));
+
+  REQUIRE(RejectsSchedule(AddUnknownRootField(empty_golden)));
+  REQUIRE(RejectsSchedule(AddDuplicateRootField(empty_golden)));
+  REQUIRE(RejectsSchedule(DropRootField(empty_golden, "contract")));
+  REQUIRE(RejectsSchedule(ReverseRootOrder(empty_golden)));
+  REQUIRE(RejectsSchedule(ReplaceRootText(empty_golden, "contract", "pypto.canonical_schedule.v2")));
+  REQUIRE(RejectsSchedule(ReplaceVersion(empty_golden, 2, false)));
+  REQUIRE(RejectsSchedule(ReplaceVersion(empty_golden, 1, true)));
+  const std::vector<uint8_t> populated = ExistingKernelBuildSpecSchedule().SerializeCanonical();
+  REQUIRE(RejectsSchedule(MutateResolvedScheduleMap(populated, MapMutation::Unknown)));
+  REQUIRE(RejectsSchedule(MutateResolvedScheduleMap(populated, MapMutation::Duplicate)));
+  REQUIRE(RejectsSchedule(MutateResolvedScheduleMap(populated, MapMutation::Missing)));
+  REQUIRE(RejectsSchedule(MutateResolvedScheduleMap(populated, MapMutation::Reordered)));
+  REQUIRE(RejectsSchedule(MutateFirstTileParameterMap(populated, MapMutation::Unknown)));
+  REQUIRE(RejectsSchedule(MutateFirstTileParameterMap(populated, MapMutation::Duplicate)));
+  REQUIRE(RejectsSchedule(MutateFirstTileParameterMap(populated, MapMutation::Missing)));
+  REQUIRE(RejectsSchedule(MutateFirstTileParameterMap(populated, MapMutation::Reordered)));
+  REQUIRE(RejectsSchedule(MutateTileArray(populated, TileArrayMutation::Reordered)));
+  REQUIRE(RejectsSchedule(MutateTileArray(populated, TileArrayMutation::Duplicate)));
+  REQUIRE(RejectsSchedule(MutateTileArray(populated, TileArrayMutation::NonminimalInteger)));
+  auto trailing = empty_golden;
+  trailing.push_back(0);
+  REQUIRE(RejectsSchedule(trailing));
+  auto truncated = empty_golden;
+  truncated.pop_back();
+  REQUIRE(RejectsSchedule(truncated));
+
+  return 0;
+}
