+        semantic_route=SemanticRoute.GenericDirect,
+        pipeline_revision="c" * 40,
+        resolved_schedule=empty_schedule(),
+        static_specialization_digest="3" * 64,
+        symbolic_specialization_digest="4" * 64,
+        argument_abi_digest="5" * 64,
+        result_abi_digest="6" * 64,
+        mutation_abi_digest="7" * 64,
+        compile_request_byte_identity_digest="8" * 64,
+    )
+
+
+def _pack_text(value: str) -> bytes:
+    encoded = value.encode("ascii")
+    if len(encoded) <= 31:
+        return bytes([0xA0 | len(encoded)]) + encoded
+    if len(encoded) <= 255:
+        return b"\xd9" + bytes([len(encoded)]) + encoded
+    raise AssertionError("test helper only supports strings up to 255 bytes")
+
+
+SCHEMA_KEY = _pack_text("canonical_schedule_schema_version")
+SCHEMA_ENTRY = SCHEMA_KEY + b"\x01"
+CONTRACT_KEY = _pack_text("contract")
+CONTRACT_ENTRY = CONTRACT_KEY + _pack_text("pypto.canonical_schedule.v1")
+SCHEDULE_KEY = _pack_text("resolved_schedule")
+SCHEDULE_ENTRY = SCHEDULE_KEY + EMPTY_RESOLVED_SCHEDULE_BODY
