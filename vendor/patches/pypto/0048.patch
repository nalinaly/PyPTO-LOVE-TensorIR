+    assert value.canonical_schedule_schema_version == 1
+    assert value.contract == "pypto.canonical_schedule.v1"
+    assert value.identity_digest == hashlib.sha256(canonical).hexdigest()
+    assert value.identity_digest == "3d1ea8ab4f5053d979ff9ac4d8d9cf6f90188578f25fa976c185a65ebfd19c0e"
