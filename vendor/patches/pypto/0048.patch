+void PackText(msgpack::packer<msgpack::sbuffer>& packer, std::string_view text) {
+  packer.pack_str(static_cast<uint32_t>(text.size()));
+  packer.pack_str_body(text.data(), static_cast<uint32_t>(text.size()));
+}
+
+std::vector<uint8_t> BufferBytes(const msgpack::sbuffer& buffer) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+std::string ObjectKey(const msgpack::object& object) {
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+std::vector<uint8_t> AddUnknownRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    packer.pack(root.get().via.map.ptr[index].key);
+    packer.pack(root.get().via.map.ptr[index].val);
+  }
+  PackText(packer, "unknown_field");
+  packer.pack(1);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddDuplicateRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    packer.pack(root.get().via.map.ptr[index].key);
+    packer.pack(root.get().via.map.ptr[index].val);
+  }
+  packer.pack(root.get().via.map.ptr[1].key);
+  packer.pack(root.get().via.map.ptr[1].val);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> DropRootField(const std::vector<uint8_t>& canonical,
+                                   std::string_view field_name) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size - 1);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    if (ObjectKey(entry.key) == field_name) continue;
+    packer.pack(entry.key);
+    packer.pack(entry.val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReverseRootOrder(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = root.get().via.map.size; index > 0; --index) {
+    packer.pack(root.get().via.map.ptr[index - 1].key);
+    packer.pack(root.get().via.map.ptr[index - 1].val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceRootText(const std::vector<uint8_t>& canonical,
+                                     std::string_view field_name,
+                                     std::string_view replacement) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == field_name) {
+      PackText(packer, replacement);
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceVersion(const std::vector<uint8_t>& canonical, uint32_t version,
+                                    bool nonminimal) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "canonical_schedule_schema_version") {
+      packer.pack(entry.val);
+      continue;
+    }
+    if (nonminimal) {
+      const char encoded_uint32_one[] = {static_cast<char>(0xce), 0x00, 0x00, 0x00, 0x01};
+      buffer.write(encoded_uint32_one, sizeof(encoded_uint32_one));
+    } else {
+      packer.pack(version);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+enum class MapMutation { Unknown, Duplicate, Missing, Reordered };
+
+void PackMutatedMap(msgpack::packer<msgpack::sbuffer>& packer, const msgpack::object_map& map,
+                    MapMutation mutation, std::string_view unknown_key) {
+  if (mutation == MapMutation::Unknown) {
+    packer.pack_map(map.size + 1);
+    for (uint32_t index = 0; index < map.size; ++index) {
+      packer.pack(map.ptr[index].key);
+      packer.pack(map.ptr[index].val);
+    }
+    PackText(packer, unknown_key);
+    packer.pack_nil();
+    return;
+  }
+  if (mutation == MapMutation::Duplicate) {
+    packer.pack_map(map.size + 1);
+    for (uint32_t index = 0; index < map.size; ++index) {
+      packer.pack(map.ptr[index].key);
+      packer.pack(map.ptr[index].val);
+    }
+    packer.pack(map.ptr[0].key);
+    packer.pack(map.ptr[0].val);
+    return;
+  }
+  if (mutation == MapMutation::Missing) {
+    packer.pack_map(map.size - 1);
+    for (uint32_t index = 0; index + 1 < map.size; ++index) {
+      packer.pack(map.ptr[index].key);
+      packer.pack(map.ptr[index].val);
+    }
+    return;
+  }
+  packer.pack_map(map.size);
+  for (uint32_t index = map.size; index > 0; --index) {
+    packer.pack(map.ptr[index - 1].key);
+    packer.pack(map.ptr[index - 1].val);
+  }
+}
+
+std::vector<uint8_t> MutateResolvedScheduleMap(const std::vector<uint8_t>& canonical,
+                                               MapMutation mutation) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == "resolved_schedule") {
+      PackMutatedMap(packer, entry.val.via.map, mutation, "unknown_category");
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> MutateFirstTileParameterMap(const std::vector<uint8_t>& canonical,
+                                                 MapMutation mutation) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t root_index = 0; root_index < root.get().via.map.size; ++root_index) {
+    const auto& root_entry = root.get().via.map.ptr[root_index];
+    packer.pack(root_entry.key);
+    if (ObjectKey(root_entry.key) != "resolved_schedule") {
+      packer.pack(root_entry.val);
+      continue;
+    }
+    packer.pack_map(root_entry.val.via.map.size);
+    for (uint32_t category_index = 0; category_index < root_entry.val.via.map.size;
+         ++category_index) {
+      const auto& category = root_entry.val.via.map.ptr[category_index];
+      packer.pack(category.key);
+      if (ObjectKey(category.key) != "tile") {
+        packer.pack(category.val);
+        continue;
+      }
+      packer.pack_array(category.val.via.array.size);
+      for (uint32_t parameter_index = 0; parameter_index < category.val.via.array.size;
+           ++parameter_index) {
+        const auto& parameter = category.val.via.array.ptr[parameter_index];
+        if (parameter_index == 0) {
+          PackMutatedMap(packer, parameter.via.map, mutation, "unknown_parameter_field");
+        } else {
+          packer.pack(parameter);
+        }
+      }
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+enum class TileArrayMutation { Reordered, Duplicate, NonminimalInteger };
+
+std::vector<uint8_t> MutateTileArray(const std::vector<uint8_t>& canonical,
+                                     TileArrayMutation mutation) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t root_index = 0; root_index < root.get().via.map.size; ++root_index) {
+    const auto& root_entry = root.get().via.map.ptr[root_index];
+    packer.pack(root_entry.key);
+    if (ObjectKey(root_entry.key) != "resolved_schedule") {
+      packer.pack(root_entry.val);
+      continue;
+    }
+    packer.pack_map(root_entry.val.via.map.size);
+    for (uint32_t category_index = 0; category_index < root_entry.val.via.map.size;
+         ++category_index) {
+      const auto& category = root_entry.val.via.map.ptr[category_index];
+      packer.pack(category.key);
+      if (ObjectKey(category.key) != "tile") {
+        packer.pack(category.val);
+        continue;
+      }
+      if (mutation == TileArrayMutation::Reordered) {
+        packer.pack_array(category.val.via.array.size);
+        for (uint32_t parameter_index = category.val.via.array.size; parameter_index > 0;
+             --parameter_index) {
+          packer.pack(category.val.via.array.ptr[parameter_index - 1]);
+        }
+        continue;
+      }
+      if (mutation == TileArrayMutation::Duplicate) {
+        packer.pack_array(category.val.via.array.size + 1);
+        for (uint32_t parameter_index = 0; parameter_index < category.val.via.array.size;
+             ++parameter_index) {
+          packer.pack(category.val.via.array.ptr[parameter_index]);
+        }
+        packer.pack(category.val.via.array.ptr[category.val.via.array.size - 1]);
+        continue;
+      }
+      packer.pack_array(category.val.via.array.size);
+      for (uint32_t parameter_index = 0; parameter_index < category.val.via.array.size;
+           ++parameter_index) {
+        const auto& parameter = category.val.via.array.ptr[parameter_index];
+        if (parameter_index != 0) {
+          packer.pack(parameter);
+          continue;
+        }
+        packer.pack_map(parameter.via.map.size);
+        for (uint32_t field_index = 0; field_index < parameter.via.map.size; ++field_index) {
+          const auto& field = parameter.via.map.ptr[field_index];
+          packer.pack(field.key);
+          if (ObjectKey(field.key) == "value") {
+            const char nonminimal_uint8_64[] = {static_cast<char>(0xcc), 0x40};
+            buffer.write(nonminimal_uint8_64, sizeof(nonminimal_uint8_64));
+          } else {
+            packer.pack(field.val);
+          }
+        }
+      }
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ExtractResolvedScheduleBody(const std::vector<uint8_t>& envelope) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(envelope.data()), envelope.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    if (ObjectKey(entry.key) == "resolved_schedule") {
+      packer.pack(entry.val);
+      return BufferBytes(buffer);
+    }
+  }
+  return {};
+}
+
+std::vector<uint8_t> WrapKernelBuildSpecSchedule(const std::vector<uint8_t>& build_spec,
+                                                 const std::vector<uint8_t>& schedule_envelope) {
+  auto build_spec_root =
+      msgpack::unpack(reinterpret_cast<const char*>(build_spec.data()), build_spec.size());
+  auto schedule_root = msgpack::unpack(reinterpret_cast<const char*>(schedule_envelope.data()),
+                                       schedule_envelope.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(build_spec_root.get().via.map.size);
+  for (uint32_t index = 0; index < build_spec_root.get().via.map.size; ++index) {
+    const auto& entry = build_spec_root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == "resolved_schedule") {
+      packer.pack(schedule_root.get());
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+bool RejectsSchedule(const std::vector<uint8_t>& data) {
+  try {
+    (void)CanonicalSchedule::DeserializeCanonical(data);
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+bool RejectsBuildSpec(const std::vector<uint8_t>& data) {
+  try {
+    (void)KernelBuildSpec::DeserializeCanonical(data);
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+template <typename Function>
+bool RejectsConstruction(Function&& function) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+std::vector<ScheduleParameter> MaximumCardinalityCategory(ScheduleValueKind kind,
+                                                          const std::string& value) {
+  std::vector<ScheduleParameter> parameters;
+  parameters.reserve(128);
+  for (size_t index = 0; index < 128; ++index) {
+    const std::string ordinal = std::to_string(1000 + index).substr(1);
+    parameters.emplace_back("value_" + ordinal, kind, value);
+  }
+  return parameters;
+}
