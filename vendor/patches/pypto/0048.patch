+KernelBuildSpec BuildSpec(CanonicalSchedule schedule, bool with_catalog) {
+  std::optional<CatalogProvenance> catalog;
+  if (with_catalog) {
+    catalog.emplace(std::string(64, '9'), std::string(64, 'a'), std::string(64, 'b'));
+  }
+  return KernelBuildSpec(std::string(64, '1'), std::string(64, '2'), SemanticRoute::GenericDirect,
+                         std::string(kPipelineRevision), std::move(schedule), std::string(64, '3'),
+                         std::string(64, '4'), std::string(64, '5'), std::string(64, '6'),
+                         std::string(64, '7'), std::string(64, '8'), std::move(catalog));
+}
+
+uint8_t HexNibble(char character) {
+  if (character >= '0' && character <= '9') return static_cast<uint8_t>(character - '0');
+  if (character >= 'a' && character <= 'f') {
+    return static_cast<uint8_t>(character - 'a' + 10);
+  }
+  return 0xff;
+}
+
+std::vector<uint8_t> BytesFromHex(std::string_view hex) {
+  if (hex.size() % 2 != 0) return {};
+  std::vector<uint8_t> bytes;
+  bytes.reserve(hex.size() / 2);
+  for (size_t index = 0; index < hex.size(); index += 2) {
+    const uint8_t high = HexNibble(hex[index]);
+    const uint8_t low = HexNibble(hex[index + 1]);
+    if (high == 0xff || low == 0xff) return {};
+    bytes.push_back(static_cast<uint8_t>((high << 4U) | low));
+  }
+  return bytes;
+}
