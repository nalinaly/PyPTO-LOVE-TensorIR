+def parameter(name: str, kind: ScheduleValueKind, value: str) -> ScheduleParameter:
+    return ScheduleParameter(name, kind, value)
+
+
+def empty_schedule() -> CanonicalSchedule:
+    return CanonicalSchedule([], [], [], [], [], [], [], [])
+
+
+def schedule_with_one_category(category: str) -> CanonicalSchedule:
+    value = [parameter("value", ScheduleValueKind.Boolean, "true")]
+    return CanonicalSchedule(
+        schedule=value if category == "schedule" else [],
+        tile=value if category == "tile" else [],
+        layout=value if category == "layout" else [],
+        persistence=value if category == "persistence" else [],
+        cta=value if category == "cta" else [],
+        warp=value if category == "warp" else [],
+        stage=value if category == "stage" else [],
+        options=value if category == "options" else [],
+    )
+
+
+def boundary_schedule() -> CanonicalSchedule:
+    return CanonicalSchedule(
+        schedule=[parameter("false_value", ScheduleValueKind.Boolean, "false")],
+        tile=[parameter("true_value", ScheduleValueKind.Boolean, "true")],
+        layout=[parameter("signed_min", ScheduleValueKind.SignedInteger, str(-(1 << 63)))],
+        persistence=[parameter("signed_max", ScheduleValueKind.SignedInteger, str((1 << 63) - 1))],
+        cta=[parameter("unsigned_min", ScheduleValueKind.UnsignedInteger, "0")],
+        warp=[parameter("unsigned_max", ScheduleValueKind.UnsignedInteger, str((1 << 64) - 1))],
+        stage=[parameter("text", ScheduleValueKind.Text, "three-stage")],
+        options=[parameter("signed_zero", ScheduleValueKind.SignedInteger, "0")],
+    )
