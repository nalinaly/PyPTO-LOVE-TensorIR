+
+std::vector<uint8_t> CanonicalSchedule::SerializeCanonical() const {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(3);
+  PackKey(packer, "canonical_schedule_schema_version");
+  packer.pack(kCanonicalScheduleSchemaVersion);
+  PackKey(packer, "contract");
+  PackText(packer, kContract);
+  PackKey(packer, "resolved_schedule");
+  PackResolvedSchedule(packer, *this);
+  std::vector<uint8_t> bytes = FinishBuffer(buffer);
+  if (bytes.size() > kMaximumSerializedCanonicalScheduleBytes) {
+    throw ValueError("CanonicalSchedule canonical payload exceeds the 1 MiB v1 limit");
+  }
+  return bytes;
+}
+
+CanonicalSchedule CanonicalSchedule::DeserializeCanonical(const std::vector<uint8_t>& data) {
+  auto handle = UnpackCanonicalSchedule(data);
+  StrictMap fields(handle.get(), "CanonicalSchedule",
+                   {"canonical_schedule_schema_version", "contract", "resolved_schedule"});
+  const uint32_t schema_version = ReadUint32(fields.Get("canonical_schedule_schema_version"),
+                                             "canonical_schedule_schema_version");
+  if (schema_version != kCanonicalScheduleSchemaVersion) {
+    throw ValueError("unsupported CanonicalSchedule canonical_schedule_schema_version " +
+                     std::to_string(schema_version));
+  }
+  const std::string contract = ReadText(fields.Get("contract"), "contract");
+  if (contract != kContract) {
+    throw ValueError("unsupported CanonicalSchedule contract '" + contract + "'");
+  }
+  CanonicalSchedule schedule =
+      ParseResolvedSchedule(fields.Get("resolved_schedule"), "CanonicalSchedule.resolved_schedule");
+  if (schedule.SerializeCanonical() != data) {
+    throw ValueError("CanonicalSchedule payload is valid MessagePack but is not in canonical form");
+  }
+  return schedule;
+}
+
+std::string CanonicalSchedule::GetIdentityDigest() const {
