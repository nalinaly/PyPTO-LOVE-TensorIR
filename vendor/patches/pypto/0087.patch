+    assert rope_kernel.grid_abi.tile_sizes == [1, 64]
     assert rope_kernel.argument_layout.input_operand_count == 3
     assert rope_kernel.argument_layout.total_kernel_argument_count == 4
     assert [d.shape for d in rope_kernel.argument_layout.operand_descriptors] == [
