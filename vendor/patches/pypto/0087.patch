+++ b/tests/ut/compiler/test_structured_compile.py
@@ -373,12 +373,12 @@ def _assert_native_tile_compilation(request: CompileRequest) -> None:
     assert not rmsnorm.artifact.fallback_used
 
     rope = compile_structured_strict(
