+TypedTensorIrModuleSpec MakeGenericRopeTensorIrSpec(
+    const NativeTileRopeGraph& graph) {
+  if (graph.input.shape.size() != 2 || graph.input.shape[1] % 2 != 0 ||
+      graph.frequency.shape != graph.input.shape) {
+    InternalReject("generic TensorIR RoPE builder received invalid rank or shape");
+  }
+  StaticTensor half = graph.input;
+  half.shape[1] /= 2;
+  half.dense_strides = MakeDenseStridesForMetadata(half.shape);
+  GenericTensorIrSpecBuilder builder(
+      {graph.input, graph.frequency, graph.frequency});
+  builder.AddResult(graph.result);
+  const int64_t rows = graph.input.shape[0];
+  const int64_t half_width = half.shape[1];
+  const auto slice = [&](uint32_t input, int64_t column_start) {
+    TypedTensorIrOperationSpec operation = MakeGenericOperation(
+        TypedTensorIrOpKind::Slice, {input}, half);
+    operation.starts = {0, column_start};
+    operation.limits = {rows, column_start + half_width};
+    operation.strides = {1, 1};
+    return builder.Append(std::move(operation));
+  };
+  const uint32_t xlow = slice(builder.Input(0), 0);
+  const uint32_t xhigh = slice(builder.Input(0), half_width);
+  const uint32_t cosine = slice(builder.Input(1), 0);
+  const uint32_t sine = slice(builder.Input(2), 0);
+  const uint32_t low_cos = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {xlow, cosine}, half);
+  const uint32_t high_sin = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {xhigh, sine}, half);
+  const uint32_t low = builder.TensorOp(
+      TypedTensorIrOpKind::Sub, {low_cos, high_sin}, half);
+  const uint32_t high_cos = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {xhigh, cosine}, half);
+  const uint32_t low_sin = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {xlow, sine}, half);
+  const uint32_t high = builder.TensorOp(
+      TypedTensorIrOpKind::Add, {high_cos, low_sin}, half);
+  const uint32_t output = builder.Concatenate({low, high}, graph.result, 1);
+  return std::move(builder).Finish({output});
+}
+
