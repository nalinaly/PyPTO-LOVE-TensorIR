+++ b/src/compiler/nvidia_typed_tensor_ir_builder.cpp
@@ -16,6 +16,7 @@
 #include <cmath>
 #include <cstddef>
 #include <cstdint>
+#include <cstdlib>
 #include <initializer_list>
 #include <limits>
 #include <memory>
@@ -1928,6 +1929,9 @@ std::optional<BuiltTypedTensorIrModule> BuildTypedTensorIrModule(
   module.print(stream);
   stream << '\n';
   stream.flush();
+  if (std::getenv("PYPTO_DUMP_TYPED_IR") != nullptr) {
+    llvm::errs() << canonical_text;
