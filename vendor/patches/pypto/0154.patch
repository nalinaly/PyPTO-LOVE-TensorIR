                                /*b_trans=*/true, lhs.shape[1]};
 }
 
+bool IsNativeTileGdnRecurrentCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 10) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto batch_loop = scope ? ir::As<ir::ForStmt>(scope->body_) : nullptr;
+  const auto batch_body =
+      batch_loop ? ir::As<ir::SeqStmts>(batch_loop->body_) : nullptr;
+  const auto head_loop = batch_body && batch_body->stmts_.size() == 5
+                             ? ir::As<ir::ForStmt>(batch_body->stmts_[4])
+                             : nullptr;
+  const auto head_body =
+      head_loop ? ir::As<ir::SeqStmts>(head_loop->body_) : nullptr;
+  const auto token_loop = head_body && head_body->stmts_.size() == 7
+                              ? ir::As<ir::ForStmt>(head_body->stmts_[4])
+                              : nullptr;
+  const auto token_body =
+      token_loop ? ir::As<ir::SeqStmts>(token_loop->body_) : nullptr;
+  return token_body && token_body->stmts_.size() == 61;
+}
+
+NativeTileGdnRecurrentGraph AnalyzeNativeTileGdnRecurrent(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native GDN recurrent must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 10 ||
+      function->param_directions_.size() != 10 ||
+      function->return_types_.size() != 1) {
+    Reject("native GDN recurrent parameter contract is invalid",
+           &function->span_);
+  }
+  for (size_t index : {size_t{0}, size_t{1}, size_t{2}, size_t{3},
+                       size_t{4}, size_t{6}, size_t{7}, size_t{8}}) {
+    if (function->param_directions_[index] != ir::ParamDirection::In) {
+      Reject("native GDN recurrent inputs must have direction In",
+             &function->span_);
+    }
+  }
+  if (function->param_directions_[5] != ir::ParamDirection::InOut ||
+      function->param_directions_[9] != ir::ParamDirection::Out) {
+    Reject("native GDN recurrent state/output directions are invalid",
+           &function->span_);
+  }
+
+  const StaticTensor mixed_qkv = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native GDN packed QKV");
+  const StaticTensor a = ReadStaticNdStridedTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native GDN a gate");
+  const StaticTensor b = ReadStaticNdStridedTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native GDN b gate");
+  const StaticTensor a_log = ReadStaticNdStridedTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native GDN A_log");
+  const StaticTensor dt_bias = ReadStaticNdStridedTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native GDN dt_bias");
+  const StaticTensor state = ReadStaticNdStridedTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native GDN recurrent state");
+  const StaticTensor state_indices = ReadStaticIntegerTensor(
+      function->params_[6]->GetType(), function->params_[6]->span_,
+      "native GDN state indices");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[9]->GetType(), function->params_[9]->span_,
+      "native GDN recurrent output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native GDN recurrent declared output");
+  if (mixed_qkv.dtype != DataType::BF16 || mixed_qkv.shape.size() != 3 ||
+      a.dtype != DataType::BF16 || b.dtype != DataType::BF16 ||
+      a.shape.size() != 4 || a.shape != b.shape ||
+      a.dense_strides != b.dense_strides || a_log.dtype != DataType::FP32 ||
+      dt_bias.dtype != DataType::FP32 || !SameTensor(a_log, dt_bias) ||
+      state.dtype != DataType::FP32 || state.shape.size() != 2 ||
+      state.dense_strides[1] != 1 ||
+      state.dense_strides[0] < state.shape[1] ||
+      (state_indices.dtype != DataType::INT32 &&
+       state_indices.dtype != DataType::INT64) ||
+      state_indices.shape.size() != 2 || result.dtype != DataType::BF16 ||
+      result.shape.size() != 4 || !SameTensor(result, declared)) {
+    Reject("native GDN recurrent tensor types or ranks are invalid",
+           &function->span_);
+  }
+
+  const int64_t batch_size = result.shape[0];
+  const int64_t tokens_per_request = result.shape[1];
+  const int64_t value_heads = result.shape[2];
+  const int64_t value_dim = result.shape[3];
+  if (batch_size <= 0 || tokens_per_request <= 0 || value_heads <= 0 ||
+      value_dim <= 0 || value_dim % 16 != 0 || state.shape[0] <= 0 ||
+      value_heads > std::numeric_limits<int64_t>::max() / value_dim) {
+    Reject("native GDN recurrent static geometry is invalid", &function->span_);
+  }
+  const int64_t state_value_width = value_heads * value_dim;
+  if (state.shape[1] % state_value_width != 0) {
+    Reject("native GDN state width is incompatible with value heads",
+           &function->span_);
+  }
+  const int64_t key_dim = state.shape[1] / state_value_width;
+  if (key_dim <= 0 || key_dim % 128 != 0 ||
+      mixed_qkv.shape[0] != batch_size ||
+      mixed_qkv.shape[1] != tokens_per_request ||
+      a.shape != result.shape || a_log.shape != std::vector<int64_t>{value_heads, value_dim} ||
+      state_indices.shape != std::vector<int64_t>{batch_size, 1}) {
+    Reject("native GDN recurrent shared shapes are incompatible",
+           &function->span_);
+  }
+  const int64_t qk_width = mixed_qkv.shape[2] - state_value_width;
+  if (qk_width <= 0 || qk_width % (2 * key_dim) != 0) {
+    Reject("native GDN packed QK width is invalid", &function->span_);
+  }
+  const int64_t q_heads = qk_width / (2 * key_dim);
+  if (q_heads <= 0 || value_heads % q_heads != 0) {
+    Reject("native GDN Q/value head grouping is invalid", &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  const auto batch_loop = scope ? ir::As<ir::ForStmt>(scope->body_) : nullptr;
+  const auto batch_stop =
+      batch_loop ? ir::As<ir::ConstInt>(batch_loop->stop_) : nullptr;
+  const auto batch_body =
+      batch_loop ? ir::As<ir::SeqStmts>(batch_loop->body_) : nullptr;
+  const auto head_loop = batch_body && batch_body->stmts_.size() == 5
+                             ? ir::As<ir::ForStmt>(batch_body->stmts_[4])
+                             : nullptr;
+  const auto head_stop =
+      head_loop ? ir::As<ir::ConstInt>(head_loop->stop_) : nullptr;
+  const auto head_body =
+      head_loop ? ir::As<ir::SeqStmts>(head_loop->body_) : nullptr;
+  const auto token_loop = head_body && head_body->stmts_.size() == 7
+                              ? ir::As<ir::ForStmt>(head_body->stmts_[4])
+                              : nullptr;
+  const auto token_stop =
+      token_loop ? ir::As<ir::ConstInt>(token_loop->stop_) : nullptr;
+  const auto token_body =
+      token_loop ? ir::As<ir::SeqStmts>(token_loop->body_) : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[9].get() || !batch_loop ||
+      !batch_stop || batch_stop->value_ != batch_size || !batch_body ||
+      !head_loop || !head_stop || head_stop->value_ != value_heads ||
+      !head_body || !token_loop || !token_stop ||
+      token_stop->value_ != tokens_per_request || !token_body ||
+      token_body->stmts_.size() != 61) {
+    Reject("native GDN recurrent loop structure is invalid", &function->span_);
+  }
+
+  constexpr std::array<std::pair<size_t, std::string_view>, 57> kExpectedOps = {{
+      {3, "tile.load"},          {4, "tile.load"},
+      {5, "tile.load"},          {6, "tile.reshape"},
+      {7, "tile.reshape"},       {8, "tile.reshape"},
+      {9, "tile.cast"},          {10, "tile.mul"},
+      {11, "tile.create"},       {12, "tile.row_sum"},
+      {13, "tile.adds"},         {14, "tile.rsqrt"},
+      {15, "tile.row_expand_mul"}, {16, "tile.muls"},
+      {17, "tile.cast"},         {18, "tile.mul"},
+      {19, "tile.create"},       {20, "tile.row_sum"},
+      {21, "tile.adds"},         {22, "tile.rsqrt"},
+      {23, "tile.row_expand_mul"}, {24, "tile.load"},
+      {25, "tile.load"},         {26, "tile.load"},
+      {27, "tile.load"},         {28, "tile.cast"},
+      {29, "tile.cast"},         {30, "tile.reshape"},
+      {31, "tile.reshape"},      {32, "tile.add"},
+      {33, "tile.abs"},          {34, "tile.exp"},
+      {35, "tile.log"},          {36, "tile.add"},
+      {37, "tile.neg"},          {38, "tile.exp"},
+      {39, "tile.row_expand_mul"}, {40, "tile.neg"},
+      {41, "tile.abs"},          {42, "tile.exp"},
+      {43, "tile.log"},          {44, "tile.add"},
+      {45, "tile.exp"},          {46, "tile.cast"},
+      {47, "tile.cast"},         {48, "tile.transpose_view"},
+      {49, "tile.matmul"},       {50, "tile.cast"},
+      {51, "tile.sub"},          {52, "tile.mul"},
+      {53, "tile.row_expand"},   {54, "tile.col_expand_mul"},
+      {55, "tile.add"},          {56, "tile.transpose_view"},
+      {57, "tile.matmul"},       {58, "tile.cast"},
+      {59, "tile.reshape"},
+  }};
+  for (const auto& [index, expected] : kExpectedOps) {
+    const auto assignment = ir::As<ir::AssignStmt>(token_body->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, std::string(expected))) {
+      Reject("native GDN recurrent operation sequence is invalid",
+             &token_body->stmts_[index]->span_);
+    }
+  }
+  const auto token_store = ir::As<ir::EvalStmt>(token_body->stmts_[60]);
+  const auto token_store_call =
+      token_store ? ir::As<ir::Call>(token_store->expr_) : nullptr;
+  const auto state_store = ir::As<ir::EvalStmt>(head_body->stmts_[6]);
+  const auto state_store_call =
+      state_store ? ir::As<ir::Call>(state_store->expr_) : nullptr;
+  if (!token_store_call || !ir::IsOp(token_store_call, "tile.store") ||
+      token_store_call->args_.size() != 3 ||
+      token_store_call->args_[2].get() != function->params_[9].get() ||
+      !state_store_call || !ir::IsOp(state_store_call, "tile.store") ||
+      state_store_call->args_.size() != 3 ||
+      state_store_call->args_[2].get() != function->params_[5].get()) {
+    Reject("native GDN recurrent stores are invalid", &head_body->span_);
+  }
+  const auto scale_assignment =
+      ir::As<ir::AssignStmt>(token_body->stmts_[16]);
+  const auto scale_call = scale_assignment
+                              ? ir::As<ir::Call>(scale_assignment->value_)
+                              : nullptr;
+  const auto scale = scale_call && scale_call->args_.size() == 2
+                         ? ir::As<ir::ConstFloat>(scale_call->args_[1])
+                         : nullptr;
+  const double expected_scale = 1.0 / std::sqrt(static_cast<double>(key_dim));
+  if (!scale || !std::isfinite(scale->value_) ||
+      std::fabs(scale->value_ - expected_scale) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native GDN recurrent scale must equal 1/sqrt(key_dim)",
+           scale_call ? &scale_call->span_ : &token_body->span_);
+  }
+
+  return NativeTileGdnRecurrentGraph{
+      mixed_qkv, a, b, a_log, dt_bias, state, state_indices, result,
+      batch_size, tokens_per_request, q_heads, value_heads, key_dim,
+      value_dim, state.shape[0], scale->value_};
+}
+
 bool IsNativeTileGdnUpdateCandidate(const ir::ProgramPtr& program) {
   if (!IsNativeTilePointwiseCandidate(program)) return false;
   const ir::FunctionPtr& function = program->functions_.begin()->second;
@@ -7264,6 +7529,613 @@ std::string EmitNativeTileAttentionSource(
   return source;
 }
 
+std::string EmitNativeTileGdnRecurrentSource(
+    const NativeTileGdnRecurrentGraph& graph) {
+  const int64_t state_width = graph.value_heads * graph.value_dim * graph.key_dim;
+  StaticTensor indices_i32 = graph.state_indices;
+  indices_i32.dtype = DataType::INT32;
+  StaticTensor indices_full{DataType::INT32,
+                            {graph.batch_size, state_width}, {}};
+  indices_full.dense_strides =
+      MakeDenseStridesForMetadata(indices_full.shape);
+  StaticTensor state_rows{DataType::FP32,
+                          {graph.batch_size, state_width}, {}};
+  state_rows.dense_strides = MakeDenseStridesForMetadata(state_rows.shape);
+  StaticTensor state_head_flat{DataType::FP32,
+                               {1, graph.value_dim * graph.key_dim}, {}};
+  state_head_flat.dense_strides =
+      MakeDenseStridesForMetadata(state_head_flat.shape);
+  StaticTensor state_matrix{DataType::FP32,
+                            {graph.value_dim, graph.key_dim}, {}};
+  state_matrix.dense_strides =
+      MakeDenseStridesForMetadata(state_matrix.shape);
+  StaticTensor query_box{DataType::BF16, {1, 1, graph.key_dim}, {}};
+  query_box.dense_strides = MakeDenseStridesForMetadata(query_box.shape);
+  StaticTensor query{DataType::BF16, {1, graph.key_dim}, {}};
+  query.dense_strides = MakeDenseStridesForMetadata(query.shape);
+  StaticTensor wide_query = query;
+  wide_query.dtype = DataType::FP32;
+  StaticTensor key_column{DataType::FP32, {graph.key_dim, 1}, {}};
+  key_column.dense_strides = MakeDenseStridesForMetadata(key_column.shape);
+  StaticTensor state_transposed{DataType::FP32,
+                                {graph.key_dim, graph.value_dim}, {}};
+  state_transposed.dense_strides =
+      MakeDenseStridesForMetadata(state_transposed.shape);
+  StaticTensor value_box{DataType::BF16, {1, 1, graph.value_dim}, {}};
+  value_box.dense_strides = MakeDenseStridesForMetadata(value_box.shape);
+  StaticTensor value_column{DataType::BF16, {graph.value_dim, 1}, {}};
+  value_column.dense_strides =
+      MakeDenseStridesForMetadata(value_column.shape);
+  StaticTensor wide_value_column = value_column;
+  wide_value_column.dtype = DataType::FP32;
+  StaticTensor gate_box{DataType::BF16,
+                        {1, 1, 1, graph.value_dim}, {}};
+  gate_box.dense_strides = MakeDenseStridesForMetadata(gate_box.shape);
+  StaticTensor gate_column{DataType::BF16, {graph.value_dim, 1}, {}};
+  gate_column.dense_strides = MakeDenseStridesForMetadata(gate_column.shape);
+  StaticTensor wide_gate_column = gate_column;
+  wide_gate_column.dtype = DataType::FP32;
+  StaticTensor parameter_row{DataType::FP32, {1, graph.value_dim}, {}};
+  parameter_row.dense_strides =
+      MakeDenseStridesForMetadata(parameter_row.shape);
+  StaticTensor parameter_column{DataType::FP32, {graph.value_dim, 1}, {}};
+  parameter_column.dense_strides =
+      MakeDenseStridesForMetadata(parameter_column.shape);
+  StaticTensor norm{DataType::FP32, {1, 1}, {1, 1}};
+  StaticTensor output_wide{DataType::FP32, {1, graph.value_dim}, {}};
+  output_wide.dense_strides =
+      MakeDenseStridesForMetadata(output_wide.shape);
+  StaticTensor output = output_wide;
+  output.dtype = DataType::BF16;
+  StaticTensor output_box{DataType::BF16,
+                          {1, 1, 1, graph.value_dim}, {}};
+  output_box.dense_strides = MakeDenseStridesForMetadata(output_box.shape);
+  StaticTensor head_sequence{DataType::BF16,
+                             {1, graph.tokens_per_request, 1,
+                              graph.value_dim}, {}};
+  head_sequence.dense_strides =
+      MakeDenseStridesForMetadata(head_sequence.shape);
+  StaticTensor batch_result{DataType::BF16,
+                            {1, graph.tokens_per_request, graph.value_heads,
+                             graph.value_dim}, {}};
+  batch_result.dense_strides =
+      MakeDenseStridesForMetadata(batch_result.shape);
+  StaticTensor batch_state{DataType::FP32, {1, state_width}, {}};
+  batch_state.dense_strides = MakeDenseStridesForMetadata(batch_state.shape);
+
+  const std::string mixed_type = TensorTypeText(graph.mixed_qkv);
+  const std::string a_type = TensorTypeText(graph.a);
+  const std::string parameter_type = TensorTypeText(graph.a_log);
+  const std::string state_type = TensorTypeText(graph.state);
+  const std::string indices_type = TensorTypeText(graph.state_indices);
+  const std::string indices_i32_type = TensorTypeText(indices_i32);
+  const std::string indices_full_type = TensorTypeText(indices_full);
+  const std::string state_rows_type = TensorTypeText(state_rows);
+  const std::string state_head_flat_type = TensorTypeText(state_head_flat);
+  const std::string state_matrix_type = TensorTypeText(state_matrix);
+  const std::string query_box_type = TensorTypeText(query_box);
+  const std::string query_type = TensorTypeText(query);
+  const std::string wide_query_type = TensorTypeText(wide_query);
+  const std::string key_column_type = TensorTypeText(key_column);
+  const std::string state_transposed_type =
+      TensorTypeText(state_transposed);
+  const std::string value_box_type = TensorTypeText(value_box);
+  const std::string value_column_type = TensorTypeText(value_column);
+  const std::string wide_value_column_type =
+      TensorTypeText(wide_value_column);
+  const std::string gate_box_type = TensorTypeText(gate_box);
+  const std::string gate_column_type = TensorTypeText(gate_column);
+  const std::string wide_gate_column_type =
+      TensorTypeText(wide_gate_column);
+  const std::string parameter_row_type = TensorTypeText(parameter_row);
+  const std::string parameter_column_type = TensorTypeText(parameter_column);
+  const std::string norm_type = TensorTypeText(norm);
+  const std::string output_wide_type = TensorTypeText(output_wide);
+  const std::string output_type = TensorTypeText(output);
+  const std::string output_box_type = TensorTypeText(output_box);
+  const std::string head_sequence_type = TensorTypeText(head_sequence);
+  const std::string batch_result_type = TensorTypeText(batch_result);
+  const std::string batch_state_type = TensorTypeText(batch_state);
+  const std::string result_type = TensorTypeText(graph.result);
+
+  std::string source;
+  source.reserve(8192);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.mixed_qkv);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.a);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.b);
+  source += ",\n    %arg3: ";
+  source += TensorWithStrideText(graph.a_log);
+  source += ",\n    %arg4: ";
+  source += TensorWithStrideText(graph.dt_bias);
+  source += ",\n    %arg5: ";
+  source += TensorWithStrideText(graph.state);
+  source += ",\n    %arg6: ";
+  source += TensorWithStrideText(graph.state_indices);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n";
+  std::string indices_value = "%arg6";
+  if (graph.state_indices.dtype == DataType::INT64) {
+    source += "    %state_indices32 = convert %arg6 : ";
+    source += indices_type;
+    source += " -> ";
+    source += indices_i32_type;
+    source += "\n";
+    indices_value = "%state_indices32";
+  }
+  source += "    %state_indices_full = broadcast ";
+  source += indices_value;
+  source += " : ";
+  source += indices_i32_type;
+  source += " -> ";
+  source += indices_full_type;
+  source += "\n    %state_rows = gather_rows %arg5, %state_indices_full : (";
+  source += state_type;
+  source += ", ";
+  source += indices_full_type;
+  source += ") -> ";
+  source += state_rows_type;
+  source += "\n    %epsilon = constant 9.999999974752427e-07 : f32";
+  source += "\n    %epsilon_splat = splat %epsilon : ";
+  source += norm_type;
+  source += "\n    %one = constant 1.0 : f32";
+  source += "\n    %one_gate = splat %one : ";
+  source += parameter_column_type;
+  source += "\n    %zero = constant 0.0 : f32";
+  source += "\n    %zero_gate = splat %zero : ";
+  source += parameter_column_type;
+  source += "\n    %scale = constant ";
+  AppendFloat(source, graph.scale);
+  source += " : f32\n    %scale_splat = splat %scale : ";
+  source += wide_query_type;
