+struct StrictTensorIrProducerOptions {
+  int32_t cta_count = 1;
+  int32_t warp_count = 4;
+  int32_t occupancy = 1;
+  int32_t sm_count = 0;
+  int64_t reduction_tile_size = 128;
+  int32_t max_tile_candidates = 0;
+  bool persistent = false;
+  bool uniform_signature = false;
+  bool ir_debug_options_empty = true;
+  bool in_process_diagnostics_suppressed = true;
+  uint8_t bytecode_major = 13;
+  uint8_t bytecode_minor = 3;
+  uint16_t bytecode_tag = 0;
+  uint32_t assembler_timeout_seconds = 300;
+  uint32_t assembler_memory_limit_mib = 4096;
+  uint64_t assembler_file_size_limit_bytes = 64ULL * 1024ULL * 1024ULL;
+  uint32_t diagnostic_limit_bytes = 64 * 1024;
+  std::vector<uint32_t> tile_sizes;
+};
