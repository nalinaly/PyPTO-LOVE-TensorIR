+#ifndef PYPTO_SRC_COMPILER_ARTIFACT_INTERNAL_H_
+#define PYPTO_SRC_COMPILER_ARTIFACT_INTERNAL_H_
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "pypto/compiler/artifact.h"
+
+namespace pypto::compiler::detail {
+
+/** Passive private-producer output; unavailable from the public API. */
+class ArtifactProducerResult {
+ public:
+  ArtifactProducerResult(ArtifactTarget requested_target,
+                         ArtifactTarget actual_target,
+                         ArtifactKind actual_artifact_kind,
+                         ArtifactBytecodeVersion tile_ir_bytecode_version,
+                         ArtifactKernelAbi kernel_abi,
+                         ArtifactProducerIdentity producer_identity,
+                         bool fallback_used, std::vector<uint8_t> device_code);
+
+  [[nodiscard]] const ArtifactTarget& GetRequestedTarget() const noexcept {
+    return requested_target_;
+  }
+  [[nodiscard]] const ArtifactTarget& GetActualTarget() const noexcept {
+    return actual_target_;
+  }
+  [[nodiscard]] ArtifactKind GetActualArtifactKind() const noexcept {
+    return actual_artifact_kind_;
+  }
+  [[nodiscard]] const ArtifactBytecodeVersion& GetTileIrBytecodeVersion() const noexcept {
+    return tile_ir_bytecode_version_;
+  }
+  [[nodiscard]] const ArtifactKernelAbi& GetKernelAbi() const noexcept {
+    return kernel_abi_;
+  }
+  [[nodiscard]] const ArtifactProducerIdentity& GetProducerIdentity() const noexcept {
+    return producer_identity_;
+  }
+  [[nodiscard]] bool UsedFallback() const noexcept { return fallback_used_; }
+  [[nodiscard]] const std::vector<uint8_t>& GetDeviceCode() const noexcept {
+    return device_code_;
+  }
+
+ private:
+  friend class ArtifactBuilder;
+
+  ArtifactTarget requested_target_;
+  ArtifactTarget actual_target_;
+  ArtifactKind actual_artifact_kind_;
+  ArtifactBytecodeVersion tile_ir_bytecode_version_;
+  ArtifactKernelAbi kernel_abi_;
+  ArtifactProducerIdentity producer_identity_;
+  bool fallback_used_;
+  std::vector<uint8_t> device_code_;
+};
+
+/** Sole internal owner of producer provenance and Artifact construction. */
+class ArtifactBuilder {
+ public:
+  [[nodiscard]] static ArtifactProducerIdentity MakeProducerIdentity(
+      ArtifactProducerKind kind, ToolchainIdentity toolchain_identity,
+      std::string pipeline_revision, std::string producer_result_contract,
+      std::string options_identity_digest, bool environment_overrides_enabled,
+      bool artifact_fallback_allowed);
+
+  [[nodiscard]] static ArtifactProducerIdentity MakeStrictProducerIdentity(
+      const CompileRequest& request, const KernelBuildSpec& build_spec);
+
+  [[nodiscard]] static Artifact CreateStrict(
+      const CompileRequest& request, const KernelBuildSpec& build_spec,
+      ArtifactProducerResult producer_result);
+};
+
+}  // namespace pypto::compiler::detail
+
