+using detail::NvidiaProducerOptions;
+
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+static_assert(std::atomic<pid_t>::is_always_lock_free,
+              "fork ownership check requires a lock-free pid atomic");
+
+std::atomic<pid_t> g_producer_process_id{0};
+std::mutex g_producer_compile_mutex;
+
+void ClaimProducerProcess() {
+  const pid_t current_process = ::getpid();
+  pid_t expected_process = 0;
+  if (g_producer_process_id.compare_exchange_strong(
+          expected_process, current_process, std::memory_order_acq_rel,
+          std::memory_order_acquire)) {
+    return;
+  }
+  if (expected_process != current_process) {
+    throw RuntimeError(
+        "strict TensorIR compilation is unavailable after fork in a process "
+        "that inherited prior compiler use; create workers with spawn/exec "
+        "before compilation");
+  }
+}
+#endif
+
+void RequireProducerContract(bool condition, const std::string& message) {
+  if (!condition) {
+    throw InternalError("private TensorIR producer contract violation: " + message);
+  }
+}
+
+NvidiaProducerOptions MakeProducerOptions(
+    const CompileRequest& request,
+    const detail::StrictTensorIrProducerOptions& resolved) {
+  const ToolchainIdentity& toolchain = request.GetToolchainIdentity();
+  NvidiaProducerOptions options;
+  options.compute_capability = Artifact::kRequiredComputeCapability;
+  options.target_name = std::string(Artifact::kRequiredTargetName);
+  options.target_portability = "arch-conditional";
+  options.cta_count = resolved.cta_count;
+  options.warp_count = resolved.warp_count;
+  options.occupancy = resolved.occupancy;
+  options.sm_count = resolved.sm_count;
+  options.reduction_tile_size = resolved.reduction_tile_size;
+  options.persistence = resolved.persistent ? "static" : "none";
+  options.tile_sizes = resolved.tile_sizes;
+  options.uniform_signature = resolved.uniform_signature;
+  options.codegen_strategy = "layout-propagation";
+  options.max_tile_candidates = resolved.max_tile_candidates;
+  options.environment_overrides_enabled = false;
+  options.artifact_fallback_allowed = false;
+  options.ir_debug_options_empty = resolved.ir_debug_options_empty;
+  options.bytecode_version = {resolved.bytecode_major, resolved.bytecode_minor,
+                              resolved.bytecode_tag};
+  options.artifact_kind = "cubin";
+  options.tile_ir_assembler_path = toolchain.GetTileirasRealPath();
+  options.tile_ir_assembler_version = toolchain.GetTileirasVersion();
+  options.tile_ir_assembler_sha256 = toolchain.GetTileirasSha256();
+  options.diagnostic_limit_bytes = resolved.diagnostic_limit_bytes;
+  return options;
+}
+
+bool SameBytecodeVersion(const detail::NvidiaProducerBytecodeVersion& lhs,
+                         const detail::NvidiaProducerBytecodeVersion& rhs) {
+  return lhs.major == rhs.major && lhs.minor == rhs.minor && lhs.tag == rhs.tag;
+}
+
+bool SameProducerOptions(const NvidiaProducerOptions& lhs,
+                         const NvidiaProducerOptions& rhs) {
+  return lhs.compute_capability == rhs.compute_capability &&
+         lhs.target_name == rhs.target_name &&
+         lhs.target_portability == rhs.target_portability &&
+         lhs.cta_count == rhs.cta_count &&
+         lhs.warp_count == rhs.warp_count &&
+         lhs.occupancy == rhs.occupancy && lhs.sm_count == rhs.sm_count &&
+         lhs.reduction_tile_size == rhs.reduction_tile_size &&
+         lhs.persistence == rhs.persistence && lhs.tile_sizes == rhs.tile_sizes &&
+         lhs.uniform_signature == rhs.uniform_signature &&
+         lhs.codegen_strategy == rhs.codegen_strategy &&
+         lhs.max_tile_candidates == rhs.max_tile_candidates &&
+         lhs.environment_overrides_enabled == rhs.environment_overrides_enabled &&
+         lhs.artifact_fallback_allowed == rhs.artifact_fallback_allowed &&
+         lhs.ir_debug_options_empty == rhs.ir_debug_options_empty &&
+         SameBytecodeVersion(lhs.bytecode_version, rhs.bytecode_version) &&
+         lhs.artifact_kind == rhs.artifact_kind &&
+         lhs.tile_ir_assembler_path == rhs.tile_ir_assembler_path &&
+         lhs.tile_ir_assembler_version == rhs.tile_ir_assembler_version &&
+         lhs.tile_ir_assembler_sha256 == rhs.tile_ir_assembler_sha256 &&
+         lhs.diagnostic_limit_bytes == rhs.diagnostic_limit_bytes;
+}
+
+std::string ExpectedCompileOptionsIdentity(const NvidiaProducerOptions& options) {
+  std::string identity = "cuda_tile_" + options.target_name + "_" +
+                         std::to_string(options.cta_count) + "_" +
+                         std::to_string(options.warp_count);
+  identity += "_occupancy_" + std::to_string(options.occupancy);
+  identity += "_sms_" + std::to_string(options.sm_count);
+  identity += "_reduction_" + std::to_string(options.reduction_tile_size);
+  identity += "_persistence_" +
+              std::to_string(options.persistence == "none" ? 0 : 1);
+  if (!options.tile_sizes.empty()) {
+    identity += "_tile";
+    for (uint32_t tile_size : options.tile_sizes) {
+      identity += "_" + std::to_string(tile_size);
+    }
+  }
+  identity += "_uniform_" + std::to_string(options.uniform_signature);
+  identity += "_strategy_" + options.codegen_strategy;
+  identity += "_candidates_" + std::to_string(options.max_tile_candidates);
+  identity += "_env_" + std::to_string(options.environment_overrides_enabled);
+  identity += "_fallback_" + std::to_string(options.artifact_fallback_allowed);
+  identity += "_assembler_" +
+              std::to_string(options.tile_ir_assembler_path.size()) + ":" +
+              options.tile_ir_assembler_path;
+  identity += "_assembler_version_" +
+              std::to_string(options.tile_ir_assembler_version.size()) + ":" +
+              options.tile_ir_assembler_version;
+  identity += "_assembler_sha256_" +
+              std::to_string(options.tile_ir_assembler_sha256.size()) + ":" +
+              options.tile_ir_assembler_sha256;
+  identity += "_loadbc_0:_bc" +
+              std::to_string(static_cast<unsigned>(options.bytecode_version.major)) + "_" +
+              std::to_string(static_cast<unsigned>(options.bytecode_version.minor)) + "_" +
+              std::to_string(options.bytecode_version.tag);
+  identity += options.artifact_kind == "cubin" ? "_cubin" : "_tileir";
+  return identity;
+}
+
+ArtifactArgumentPackingPolicy ConvertPackingPolicy(const std::string& value) {
+  if (value == "pointer-only") return ArtifactArgumentPackingPolicy::PointerOnly;
+  if (value == "flat") return ArtifactArgumentPackingPolicy::Flat;
+  throw InternalError("private TensorIR producer returned an unknown argument packing policy");
+}
+
+ArtifactGridPolicy ConvertGridPolicy(const std::string& value) {
+  if (value == "static") return ArtifactGridPolicy::Static;
+  if (value == "tile-based-runtime") return ArtifactGridPolicy::TileBasedRuntime;
+  throw InternalError("private TensorIR producer returned an unknown grid policy");
+}
+
+std::vector<ArtifactArgumentDescriptor> ConvertDescriptors(
+    detail::NvidiaProducerArgumentLayout layout) {
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  descriptors.reserve(layout.operand_descriptors.size());
+  for (auto& descriptor : layout.operand_descriptors) {
+    const uint64_t expected_arguments =
+        descriptor.is_scalar
+            ? 1
+            : 1ULL + descriptor.dynamic_size_count +
+                  descriptor.dynamic_stride_count;
+    RequireProducerContract(descriptor.total_argument_count == expected_arguments,
+                            "operand total-argument count differs from metadata");
+    descriptors.emplace_back(
+        descriptor.is_scalar ? ArtifactOperandKind::Scalar
+                             : ArtifactOperandKind::Tensor,
+        descriptor.rank, std::move(descriptor.shape),
+        std::move(descriptor.strides), descriptor.dynamic_size_count,
+        descriptor.dynamic_stride_count, descriptor.explicit_strides,
+        descriptor.scalar_size_bytes);
+  }
+  return descriptors;
+}
+
+void ValidateProducerArtifact(const NvidiaProducerArtifact& artifact,
+                              const NvidiaProducerOptions& options) {
+  RequireProducerContract(artifact.schema_version == Artifact::kArtifactSchemaVersion,
+                          "unsupported artifact schema");
+  RequireProducerContract(artifact.requested_artifact_kind == "cubin" &&
+                              artifact.actual_artifact_kind == "cubin",
+                          "strict compilation did not produce Cubin");
+  RequireProducerContract(
+      artifact.requested_target.compute_capability ==
+              Artifact::kRequiredComputeCapability &&
+          artifact.actual_target.compute_capability ==
+              Artifact::kRequiredComputeCapability &&
+          artifact.requested_target.name == Artifact::kRequiredTargetName &&
+          artifact.actual_target.name == Artifact::kRequiredTargetName &&
+          artifact.requested_target.portability == "arch-conditional" &&
+          artifact.actual_target.portability == "arch-conditional",
+      "requested or actual target differs from sm_120a");
+  RequireProducerContract(
+      SameBytecodeVersion(artifact.tile_ir_bytecode_version,
+                          options.bytecode_version),
+      "bytecode version differs from the strict producer input");
+  RequireProducerContract(!artifact.environment_overrides_enabled &&
+                              !artifact.artifact_fallback_allowed &&
+                              !artifact.used_artifact_fallback,
+                          "environment override or artifact fallback was used");
+  RequireProducerContract(
+      artifact.tile_ir_assembler_path == options.tile_ir_assembler_path &&
+          artifact.tile_ir_assembler_version ==
+              options.tile_ir_assembler_version &&
+          artifact.tile_ir_assembler_sha256 ==
+              options.tile_ir_assembler_sha256,
+      "assembler identity differs from the strict producer input");
+  RequireProducerContract(
+      artifact.compile_options_identity ==
+          ExpectedCompileOptionsIdentity(options),
+      "TensorIR compile-options identity differs from the exact input mapping");
+  RequireProducerContract(
+      artifact.argument_layout.tile_sizes == options.tile_sizes,
+      "producer tile sizes differ from the exact input mapping");
+  RequireProducerContract(
+      artifact.argument_layout.uniform_signature == options.uniform_signature,
+      "producer uniform-signature flag differs from the exact input mapping");
+  RequireProducerContract(artifact.workspace_size_bytes == 0 &&
+                              artifact.workspace_alignment_bytes == 1,
+                          "Artifact v1 accepts only the reviewed zero-workspace ABI");
+}
+
+Artifact MakeArtifact(const CompileRequest& request,
+                      const KernelBuildSpec& build_spec,
+                      NvidiaProducerArtifact producer_artifact) {
+  const ArtifactArgumentPackingPolicy packing_policy =
+      ConvertPackingPolicy(producer_artifact.argument_packing_policy);
+  const ArtifactGridPolicy grid_policy =
+      ConvertGridPolicy(producer_artifact.grid_policy);
+  std::array<uint32_t, 3> static_grid{};
+  for (size_t index = 0; index < static_grid.size(); ++index) {
+    RequireProducerContract(producer_artifact.static_grid[index] > 0,
+                            "static grid dimensions must be positive");
+    static_grid[index] =
+        static_cast<uint32_t>(producer_artifact.static_grid[index]);
+  }
+
+  const uint32_t input_operand_count =
+      producer_artifact.argument_layout.input_operand_count;
+  const uint32_t total_kernel_argument_count =
+      producer_artifact.argument_layout.total_kernel_argument_count;
+  const uint32_t grid_shape_operand_index =
+      producer_artifact.argument_layout.grid_shape_operand_index;
+  const bool uniform_signature =
+      producer_artifact.argument_layout.uniform_signature;
+  std::vector<uint32_t> tile_sizes =
+      std::move(producer_artifact.argument_layout.tile_sizes);
+  std::vector<ArtifactArgumentDescriptor> descriptors =
+      ConvertDescriptors(std::move(producer_artifact.argument_layout));
+
+  ArtifactKernelAbi kernel_abi(
+      std::move(producer_artifact.runtime_kernel_name),
+      std::move(producer_artifact.entry_function_name),
+      ArtifactArgumentLayout(std::move(descriptors), input_operand_count,
+                             total_kernel_argument_count,
+                             uniform_signature),
+      packing_policy,
+      ArtifactGridAbi(grid_policy, grid_shape_operand_index, static_grid,
+                      std::move(tile_sizes)),
+      ArtifactWorkspaceAbi(ArtifactWorkspaceKind::Static,
+                           producer_artifact.workspace_size_bytes,
+                           producer_artifact.workspace_alignment_bytes),
+      ArtifactLaunchAbi({1, 1, 1},
+                        ArtifactClusterSchedulingPolicy::Spread,
+                        /*dynamic_shared_memory_bytes=*/0,
+                        /*kernel_argument_slot_bytes=*/8),
+      ArtifactLoaderAbi(Artifact::kMinimumCudaDriverApiVersion,
+                        Artifact::kMinimumCudaRuntimeApiVersion));
+
+  detail::ArtifactProducerResult producer_result(
+      ArtifactTarget(producer_artifact.requested_target.compute_capability,
+                     std::move(producer_artifact.requested_target.name),
+                     ArtifactTargetPortability::ArchConditional),
+      ArtifactTarget(producer_artifact.actual_target.compute_capability,
+                     std::move(producer_artifact.actual_target.name),
+                     ArtifactTargetPortability::ArchConditional),
+      ArtifactKind::Cubin,
+      ArtifactBytecodeVersion(
+          producer_artifact.tile_ir_bytecode_version.major,
+          producer_artifact.tile_ir_bytecode_version.minor,
+          producer_artifact.tile_ir_bytecode_version.tag),
+      std::move(kernel_abi),
+      detail::ArtifactBuilder::MakeStrictProducerIdentity(request, build_spec),
+      producer_artifact.used_artifact_fallback,
+      std::move(producer_artifact.device_code));
+  return detail::ArtifactBuilder::CreateStrict(request, build_spec,
+                                               std::move(producer_result));
+}
+
+}  // namespace
+
+Artifact Artifact::CompileStrict(std::vector<uint8_t> canonical_source,
+                                 const CompileRequest& request,
+                                 const KernelBuildSpec& build_spec) {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  ClaimProducerProcess();
+#endif
+  const std::string actual_source_digest =
+      ComputeSourceIrDigest(canonical_source);
+  if (actual_source_digest != build_spec.GetSourceIrDigest()) {
+    throw ValueError(
+        "canonical TensorIR source SHA-256 differs from KernelBuildSpec.source_ir_digest");
+  }
+
+  const detail::StrictTensorIrProducerOptions resolved =
+      detail::ResolveStrictTensorIrProducerOptions(request, build_spec);
+  (void)GetProducerOptionsIdentityDigest(request, build_spec);
+  detail::ValidateStrictTensorIrBuildInfo(request);
+  const NvidiaProducerOptions options = MakeProducerOptions(request, resolved);
+
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  detail::NvidiaProducerResult result;
+  {
+    std::lock_guard<std::mutex> lock(g_producer_compile_mutex);
+    result = detail::CompilePrivateNvidiaArtifact(canonical_source, options);
+  }
+  if (!result.ok) {
+    RequireProducerContract(
+        result.status_code != 0 && !result.error.empty() &&
+            result.error.size() <= options.diagnostic_limit_bytes &&
+            !result.artifact.has_value(),
+        "failure result has an invalid status, diagnostic, or artifact");
+    if (result.applied_options.has_value()) {
+      RequireProducerContract(
+          SameProducerOptions(*result.applied_options, options),
+          "failed producer applied options differ from the exact request");
+    }
+    if (result.status_code == 1) {
+      throw ValueError("private TensorIR producer rejected compilation: " +
+                       result.error);
+    }
+    throw RuntimeError("private TensorIR producer failed with status " +
+                       std::to_string(result.status_code) + ": " + result.error);
+  }
+  RequireProducerContract(result.status_code == 0 && result.error.empty(),
+                          "successful result contains a failure status");
+  RequireProducerContract(result.applied_options.has_value() &&
+                              result.artifact.has_value(),
+                          "successful result is incomplete");
+  RequireProducerContract(SameProducerOptions(*result.applied_options, options),
+                          "applied options differ from the exact requested options");
+  ValidateProducerArtifact(*result.artifact, options);
+  return MakeArtifact(request, build_spec, std::move(*result.artifact));
+#else
+  (void)canonical_source;
+  (void)options;
+  throw ValueError(
+      "strict Artifact compilation requires the private TensorIR backend");
+#endif
+}
+
+}  // namespace pypto::compiler
