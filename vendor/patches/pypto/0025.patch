+#ifndef PYPTO_COMPILER_NVIDIA_PRODUCER_BRIDGE_H_
+#define PYPTO_COMPILER_NVIDIA_PRODUCER_BRIDGE_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace pypto::compiler::detail {
+
+/** CUDA Tile bytecode version crossing the private no-RTTI/no-EH bridge. */
+struct NvidiaProducerBytecodeVersion {
+  uint8_t major = 13;
+  uint8_t minor = 3;
+  uint16_t tag = 0;
+};
+
+/** Fully explicit CUDA Tile producer inputs. No ambient GPU state is consulted. */
+struct NvidiaProducerOptions {
+  int32_t compute_capability = 120;
+  std::string target_name = "sm_120a";
+  std::string target_portability = "arch-conditional";
+  int32_t cta_count = 1;
+  int32_t warp_count = 4;
+  int32_t occupancy = 1;
+  int32_t sm_count = 0;
+  int64_t reduction_tile_size = 128;
+  std::string persistence = "none";
+  std::vector<uint32_t> tile_sizes;
+  bool uniform_signature = false;
+  std::string codegen_strategy = "layout-propagation";
+  int32_t max_tile_candidates = 0;
+  bool environment_overrides_enabled = false;
+  bool artifact_fallback_allowed = false;
+  bool ir_debug_options_empty = true;
+  NvidiaProducerBytecodeVersion bytecode_version;
+  std::string artifact_kind = "cubin";
+  std::string tile_ir_assembler_path;
+  std::string tile_ir_assembler_version;
+  std::string tile_ir_assembler_sha256;
+  uint32_t diagnostic_limit_bytes = 64U * 1024U;
+};
+
+/** Detached requested or actual TensorIR target identity. */
+struct NvidiaProducerTarget {
+  int32_t compute_capability = 0;
+  std::string name;
+  std::string portability;
+};
+
+/** Detached TensorIR operand descriptor. A null value denotes a dynamic dimension or stride. */
+struct NvidiaProducerArgumentDescriptor {
+  bool is_scalar = false;
+  uint32_t rank = 0;
+  std::vector<std::optional<int64_t>> shape;
+  std::vector<std::optional<int64_t>> strides;
+  uint32_t dynamic_size_count = 0;
+  uint32_t dynamic_stride_count = 0;
+  bool explicit_strides = false;
+  uint32_t scalar_size_bytes = 0;
+  uint32_t total_argument_count = 0;
+};
+
+/** Detached flat kernel-argument layout. */
+struct NvidiaProducerArgumentLayout {
+  std::vector<NvidiaProducerArgumentDescriptor> operand_descriptors;
+  std::vector<uint32_t> tile_sizes;
+  uint32_t input_operand_count = 0;
+  uint32_t total_kernel_argument_count = 0;
+  uint32_t grid_shape_operand_index = 0;
+  bool uniform_signature = false;
+};
+
+/** Runtime-free, process-independent result from TensorIR's artifact producer. */
+struct NvidiaProducerArtifact {
+  uint32_t schema_version = 0;
+  std::string requested_artifact_kind;
+  std::string actual_artifact_kind;
+  NvidiaProducerTarget requested_target;
+  NvidiaProducerTarget actual_target;
+  NvidiaProducerBytecodeVersion tile_ir_bytecode_version;
+  std::vector<uint8_t> device_code;
+  std::string runtime_kernel_name;
+  std::string entry_function_name;
+  NvidiaProducerArgumentLayout argument_layout;
+  std::string argument_packing_policy;
+  std::string grid_policy;
+  std::array<int32_t, 3> static_grid = {1, 1, 1};
+  uint64_t workspace_size_bytes = 0;
+  uint64_t workspace_alignment_bytes = 1;
+  bool environment_overrides_enabled = false;
+  bool artifact_fallback_allowed = false;
+  bool used_artifact_fallback = false;
+  std::string tile_ir_assembler_path;
+  std::string tile_ir_assembler_version;
+  std::string tile_ir_assembler_sha256;
+  std::string compile_options_identity;
+};
+
+/**
+ * Status plus an optional detached artifact; diagnostics never exceed 64 KiB.
+ *
+ * Success has ok=true, status_code=0, an empty error, and a populated artifact.
+ * Failure has ok=false, a nonzero status_code, a nonempty bounded error, and no artifact.
+ * Applied options are present once the concrete TensorIR options have been fully populated.
+ */
+struct NvidiaProducerResult {
+  bool ok = false;
+  int32_t status_code = 8;
+  std::string error;
+  std::optional<NvidiaProducerOptions> applied_options;
+  std::optional<NvidiaProducerArtifact> artifact;
+};
+
+[[nodiscard]] NvidiaProducerResult CompilePrivateNvidiaArtifact(
+    const std::vector<uint8_t>& canonical_source, const NvidiaProducerOptions& options);
+
+}  // namespace pypto::compiler::detail
