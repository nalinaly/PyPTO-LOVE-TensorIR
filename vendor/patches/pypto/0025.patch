+constexpr int32_t kStatusSuccess = static_cast<int32_t>(StatusCode::kSuccess);
+constexpr int32_t kStatusInvalidArgument = static_cast<int32_t>(StatusCode::kInvalidArgument);
+constexpr int32_t kStatusCompilationError = static_cast<int32_t>(StatusCode::kCompilationError);
+constexpr size_t kMaximumCanonicalSourceBytes = 16ULL * 1024ULL * 1024ULL;
+constexpr size_t kMaximumDeviceCodeBytes = 64ULL * 1024ULL * 1024ULL;
+constexpr size_t kMinimumDeviceCodeBytes = 64;
+constexpr size_t kMaximumOperandDescriptors = 1024;
+constexpr int32_t kMaximumRank = 32;
+constexpr size_t kMaximumTileDimensions = 32;
+constexpr int32_t kMaximumKernelArguments = 4096;
+constexpr size_t kMaximumNameBytes = 1024;
+constexpr size_t kMaximumDiagnosticBytes = 64ULL * 1024ULL;
+constexpr uint64_t kMaximumWorkspaceSizeBytes = 1ULL << 40;
+constexpr uint64_t kMaximumWorkspaceAlignmentBytes = 2ULL * 1024ULL * 1024ULL;
+
+std::string BoundedDiagnostic(std::string_view diagnostic) {
+  if (diagnostic.empty()) return "NVIDIA producer failed without a diagnostic";
+  const size_t count = std::min(diagnostic.size(), kMaximumDiagnosticBytes);
+  return std::string(diagnostic.data(), count);
+}
+
+NvidiaProducerResult Failure(int32_t status_code, std::string_view error,
+                             const NvidiaProducerOptions* applied_options = nullptr) {
+  NvidiaProducerResult result;
+  result.status_code = status_code == kStatusSuccess ? kStatusCompilationError : status_code;
+  result.error = BoundedDiagnostic(error);
+  if (applied_options != nullptr) result.applied_options = *applied_options;
+  return result;
+}
+
+bool IsLowercaseSha256(std::string_view value) {
+  if (value.size() != 64) return false;
+  return std::all_of(value.begin(), value.end(), [](char character) {
+    return (character >= '0' && character <= '9') ||
+           (character >= 'a' && character <= 'f');
+  });
+}
+
+bool ContainsNul(std::string_view value) {
+  return std::find(value.begin(), value.end(), '\0') != value.end();
+}
+
+const char* ValidateSource(const std::vector<uint8_t>& canonical_source) {
+  if (canonical_source.empty()) return "canonical TensorIR source must not be empty";
+  if (canonical_source.size() > kMaximumCanonicalSourceBytes) {
+    return "canonical TensorIR source exceeds 16 MiB";
+  }
+  if (std::find(canonical_source.begin(), canonical_source.end(), uint8_t{0}) !=
+      canonical_source.end()) {
+    return "canonical TensorIR source must not contain NUL bytes";
+  }
+  return nullptr;
+}
+
+const char* ValidateStrictOptions(const NvidiaProducerOptions& options) {
+  if (options.compute_capability != 120 || options.target_name != "sm_120a" ||
+      options.target_portability != "arch-conditional") {
+    return "NVIDIA producer target must be the architecture-conditional SM120 target sm_120a";
+  }
+  if (options.cta_count != 1 || options.warp_count != 4 || options.occupancy != 1) {
+    return "NVIDIA producer CTA, warp, and occupancy options must be 1, 4, and 1";
+  }
+  if (options.sm_count <= 0) {
+    return "NVIDIA producer SM count must be supplied by the caller and be positive";
+  }
+  if (options.reduction_tile_size != 128 || options.persistence != "none") {
+    return "NVIDIA producer reduction tile size and persistence must be 128 and none";
+  }
+  if (options.tile_sizes.empty() || options.tile_sizes.size() > kMaximumTileDimensions) {
+    return "NVIDIA producer requires between 1 and 32 explicit tile sizes";
+  }
+  for (uint32_t tile_size : options.tile_sizes) {
+    if (tile_size == 0 ||
+        tile_size > static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) {
+      return "NVIDIA producer tile sizes must fit the positive int32 range";
+    }
+  }
+  if (options.uniform_signature || options.codegen_strategy != "layout-propagation" ||
+      options.max_tile_candidates != 0) {
+    return "NVIDIA producer requires non-uniform layout propagation with zero tile candidates";
+  }
+  if (options.environment_overrides_enabled || options.artifact_fallback_allowed ||
+      !options.ir_debug_options_empty) {
+    return "NVIDIA producer environment overrides, fallback, and IR debug options must be disabled";
+  }
+  if (options.bytecode_version.major != 13 || options.bytecode_version.minor != 3 ||
+      options.bytecode_version.tag != 0 || options.artifact_kind != "cubin") {
+    return "NVIDIA producer requires CUDA Tile bytecode 13.3.0 and Cubin output";
+  }
+  if (options.tile_ir_assembler_path.empty() ||
+      options.tile_ir_assembler_path.size() > kMaximumNameBytes ||
+      ContainsNul(options.tile_ir_assembler_path) ||
+      !llvm::sys::path::is_absolute(options.tile_ir_assembler_path)) {
+    return "NVIDIA producer requires an absolute TileIR assembler path of at most 1024 bytes";
+  }
+  if (options.tile_ir_assembler_version.empty() ||
+      options.tile_ir_assembler_version.size() > kMaximumNameBytes ||
+      ContainsNul(options.tile_ir_assembler_version) ||
+      !IsLowercaseSha256(options.tile_ir_assembler_sha256)) {
+    return "NVIDIA producer requires a bounded assembler version and lowercase SHA-256";
+  }
+  if (options.diagnostic_limit_bytes != kMaximumDiagnosticBytes) {
+    return "NVIDIA producer diagnostic limit must be exactly 64 KiB";
+  }
+  return nullptr;
+}
+
+const char* ArtifactKindName(CudaTileArtifactKind kind) {
+  switch (kind) {
+    case CudaTileArtifactKind::TileIR:
+      return "tileir";
+    case CudaTileArtifactKind::Cubin:
+      return "cubin";
+  }
+  return "unknown";
+}
+
+const char* PortabilityName(ArchPortability portability) {
+  switch (portability) {
+    case ArchPortability::portable:
+      return "portable";
+    case ArchPortability::family_portable:
+      return "family-portable";
+    case ArchPortability::arch_conditional:
+      return "arch-conditional";
+  }
+  return "unknown";
+}
+
+const char* ArgumentPackingPolicyName(CudaTileArgumentPackingPolicy policy) {
+  switch (policy) {
+    case CudaTileArgumentPackingPolicy::PointerOnly:
+      return "pointer-only";
+    case CudaTileArgumentPackingPolicy::Flat:
+      return "flat";
+  }
+  return "unknown";
+}
+
+const char* GridPolicyName(CudaTileGridPolicy policy) {
+  switch (policy) {
+    case CudaTileGridPolicy::Static:
+      return "static";
+    case CudaTileGridPolicy::TileBasedRuntime:
+      return "tile-based-runtime";
+  }
+  return "unknown";
+}
+
+const char* PersistenceName(PersistenceMode persistence) {
+  switch (persistence) {
+    case PersistenceMode::None:
+      return "none";
+    case PersistenceMode::Static:
+      return "static";
+  }
+  return "unknown";
+}
+
+const char* CodegenStrategyName(CudaTileCodegenStrategy strategy) {
+  switch (strategy) {
+    case CudaTileCodegenStrategy::AffineMap:
+      return "affine-map";
+    case CudaTileCodegenStrategy::LayoutPropagation:
+      return "layout-propagation";
+  }
+  return "unknown";
+}
+
+bool IrDebugOptionsEmpty(const CudaTileCompileOptions& options) {
+  return options.irDebug.dumpCudaTileIRPath.empty() &&
+         options.irDebug.dumpTileIRBCPath.empty() && !options.irDebug.printIRAfterAll &&
+         options.irDebug.printIRTreeDir.empty() && !options.irDebug.enableTiming &&
+         options.irDebug.loadTileIRBCPath.empty();
+}
+
+NvidiaProducerOptions CopyAppliedOptions(const CudaTileCompileOptions& options) {
+  NvidiaProducerOptions output;
+  output.compute_capability = options.computeCapability.getComputeCapabilityVersion();
+  output.target_name = options.computeCapability.toString();
+  output.target_portability = PortabilityName(options.computeCapability.getPortability());
+  output.cta_count = options.ctaCount;
+  output.warp_count = options.warpCount;
+  output.occupancy = options.occupancy;
+  output.sm_count = options.smCount;
+  output.reduction_tile_size = options.reductionTileSize;
+  output.persistence = PersistenceName(options.persistence);
+  output.tile_sizes.reserve(options.tileSize.size());
+  for (int32_t tile_size : options.tileSize) {
+    output.tile_sizes.push_back(static_cast<uint32_t>(tile_size));
+  }
+  output.uniform_signature = options.uniformSignature;
+  output.codegen_strategy = CodegenStrategyName(options.codegenStrategy);
+  output.max_tile_candidates = options.maxTileCandidates;
+  output.environment_overrides_enabled = options.allowEnvironmentOverrides;
+  output.artifact_fallback_allowed = options.allowArtifactFallback;
+  output.ir_debug_options_empty = IrDebugOptionsEmpty(options);
+  output.bytecode_version = {options.bytecodeVersion.getMajor(), options.bytecodeVersion.getMinor(),
+                             options.bytecodeVersion.getTag()};
+  output.artifact_kind = ArtifactKindName(options.artifactKind);
+  output.tile_ir_assembler_path = options.tileIRAssemblerPath;
+  output.tile_ir_assembler_version = options.tileIRAssemblerVersion;
+  output.tile_ir_assembler_sha256 = options.tileIRAssemblerSha256;
+  output.diagnostic_limit_bytes = static_cast<uint32_t>(kMaximumDiagnosticBytes);
+  return output;
+}
+
+bool IsPowerOfTwo(uint64_t value) { return value != 0 && (value & (value - 1)) == 0; }
+
+const char* ValidateDescriptorBounds(const TensorArgDesc& descriptor) {
+  if (descriptor.rank < 0 || descriptor.rank > kMaximumRank ||
+      descriptor.staticShape.size() != static_cast<size_t>(descriptor.rank) ||
+      descriptor.staticShape.size() > static_cast<size_t>(kMaximumRank) ||
+      descriptor.staticStrides.size() > static_cast<size_t>(kMaximumRank) ||
+      (!descriptor.staticStrides.empty() &&
+       descriptor.staticStrides.size() != static_cast<size_t>(descriptor.rank))) {
+    return "TensorIR artifact operand rank or shape metadata exceeds the bridge bound";
+  }
+  if (descriptor.numDynSizes < 0 || descriptor.numDynSizes > kMaximumRank ||
+      descriptor.numDynStrides < 0 || descriptor.numDynStrides > kMaximumRank ||
+      descriptor.totalArgs() <= 0 || descriptor.totalArgs() > kMaximumKernelArguments) {
+    return "TensorIR artifact operand argument count exceeds the bridge bound";
+  }
+  if (descriptor.isScalar) {
+    if (descriptor.rank != 0 || !descriptor.staticShape.empty() ||
+        !descriptor.staticStrides.empty() || descriptor.hasExplicitStrides ||
+        descriptor.scalarSizeInBytes <= 0 || descriptor.scalarSizeInBytes > 8) {
+      return "TensorIR artifact contains invalid scalar operand metadata";
+    }
+    return nullptr;
+  }
+  if (descriptor.scalarSizeInBytes != 0 ||
+      descriptor.hasExplicitStrides != !descriptor.staticStrides.empty()) {
+    return "TensorIR artifact contains inconsistent tensor operand metadata";
+  }
+  for (int64_t dimension : descriptor.staticShape) {
+    if (dimension != TensorArgDesc::kDynamic && dimension <= 0) {
+      return "TensorIR artifact contains a non-positive static dimension";
+    }
+  }
+  for (int64_t stride : descriptor.staticStrides) {
+    if (stride != TensorArgDesc::kDynamic && stride < 0) {
+      return "TensorIR artifact contains a negative static stride";
+    }
+  }
+  return nullptr;
+}
+
+const char* ValidateLayoutBounds(const KernelArgLayout& layout,
+                                 const NvidiaProducerOptions& options) {
+  if (layout.tensorDescs.empty() ||
+      layout.tensorDescs.size() > kMaximumOperandDescriptors) {
+    return "TensorIR artifact operand descriptor count exceeds the bridge bound";
+  }
+  if (layout.numInputs < 0 ||
+      layout.numInputs > static_cast<int32_t>(layout.tensorDescs.size()) ||
+      layout.totalKernelArgs <= 0 || layout.totalKernelArgs > kMaximumKernelArguments) {
+    return "TensorIR artifact flat argument layout exceeds the bridge bound";
+  }
+  if (layout.gridShapeTensorIdx < 0 ||
+      layout.gridShapeTensorIdx >= static_cast<int32_t>(layout.tensorDescs.size())) {
+    return "TensorIR artifact grid-shape operand index is outside the descriptor layout";
+  }
+  if (layout.tileSizes.empty() || layout.tileSizes.size() > kMaximumTileDimensions ||
+      layout.tileSizes.size() != options.tile_sizes.size()) {
+    return "TensorIR artifact tile layout differs from the bounded explicit producer input";
+  }
+  for (size_t index = 0; index < layout.tileSizes.size(); ++index) {
+    if (layout.tileSizes[index] <= 0 ||
+        static_cast<uint32_t>(layout.tileSizes[index]) != options.tile_sizes[index]) {
+      return "TensorIR artifact tile layout differs from the explicit producer input";
+    }
+  }
+  if (layout.uniformSignature != options.uniform_signature) {
+    return "TensorIR artifact uniform-signature flag differs from the producer input";
+  }
+  for (const TensorArgDesc& descriptor : layout.tensorDescs) {
+    if (const char* error = ValidateDescriptorBounds(descriptor)) return error;
+  }
+  return nullptr;
+}
+
+const char* ValidateArtifactBounds(const CudaTileCompiledArtifact& artifact,
+                                   const NvidiaProducerOptions& options) {
+  if (artifact.schemaVersion != CudaTileCompiledArtifact::kSchemaVersion) {
+    return "TensorIR artifact schema version is unsupported";
+  }
+  if (artifact.requestedArtifactKind != CudaTileArtifactKind::Cubin ||
+      artifact.actualArtifactKind != CudaTileArtifactKind::Cubin ||
+      artifact.usedArtifactFallback()) {
+    return "TensorIR artifact is not a strict non-fallback Cubin result";
+  }
+  if (artifact.requestedTarget.getComputeCapabilityVersion() != 120 ||
+      artifact.actualTarget.getComputeCapabilityVersion() != 120 ||
+      artifact.requestedTarget.getPortability() != ArchPortability::arch_conditional ||
+      artifact.actualTarget.getPortability() != ArchPortability::arch_conditional ||
+      artifact.requestedTarget.toString() != "sm_120a" ||
+      artifact.actualTarget.toString() != "sm_120a") {
+    return "TensorIR artifact target differs from strict sm_120a";
+  }
+  if (artifact.tileIRBytecodeVersion.getMajor() != 13 ||
+      artifact.tileIRBytecodeVersion.getMinor() != 3 ||
+      artifact.tileIRBytecodeVersion.getTag() != 0) {
+    return "TensorIR artifact bytecode version differs from 13.3.0";
+  }
+  if (artifact.deviceCode.size() < kMinimumDeviceCodeBytes ||
+      artifact.deviceCode.size() > kMaximumDeviceCodeBytes) {
+    return "TensorIR Cubin size must be between 64 bytes and 64 MiB";
+  }
+  if (artifact.runtimeKernelName.empty() ||
+      artifact.runtimeKernelName.size() > kMaximumNameBytes ||
+      artifact.entryFunctionName.empty() ||
+      artifact.entryFunctionName.size() > kMaximumNameBytes) {
+    return "TensorIR artifact kernel names must contain at most 1024 bytes";
+  }
+  if (const char* error = ValidateLayoutBounds(artifact.argLayout, options)) return error;
+  if (ArgumentPackingPolicyName(artifact.argumentPackingPolicy) == std::string_view("unknown") ||
+      GridPolicyName(artifact.gridPolicy) == std::string_view("unknown")) {
+    return "TensorIR artifact contains an unknown packing or grid policy";
+  }
+  if (std::any_of(artifact.staticGrid.begin(), artifact.staticGrid.end(),
+                  [](int32_t dimension) { return dimension <= 0; })) {
+    return "TensorIR artifact static grid contains a non-positive dimension";
+  }
+  if (artifact.workspaceSizeBytes > kMaximumWorkspaceSizeBytes ||
+      artifact.workspaceAlignmentBytes > kMaximumWorkspaceAlignmentBytes ||
+      !IsPowerOfTwo(artifact.workspaceAlignmentBytes) ||
+      artifact.workspaceSizeBytes % artifact.workspaceAlignmentBytes != 0) {
+    return "TensorIR artifact workspace metadata exceeds the bridge bound";
+  }
+  if (artifact.environmentOverridesEnabled || artifact.artifactFallbackAllowed ||
+      artifact.tileIRAssemblerPath != options.tile_ir_assembler_path ||
+      artifact.tileIRAssemblerVersion != options.tile_ir_assembler_version ||
+      artifact.tileIRAssemblerSha256 != options.tile_ir_assembler_sha256) {
+    return "TensorIR artifact producer flags or assembler identity differ from the applied options";
+  }
+  if (artifact.compileOptionsIdentity.empty() ||
+      artifact.compileOptionsIdentity.size() > kMaximumDiagnosticBytes) {
+    return "TensorIR artifact compile-options identity exceeds the bridge bound";
+  }
+  return nullptr;
+}
+
+NvidiaProducerTarget CopyTarget(const SmTarget& target) {
+  NvidiaProducerTarget output;
+  output.compute_capability = target.getComputeCapabilityVersion();
+  output.name = target.toString();
+  output.portability = PortabilityName(target.getPortability());
+  return output;
+}
+
+std::optional<int64_t> CopyStaticValue(int64_t value) {
+  if (value == TensorArgDesc::kDynamic) return std::nullopt;
+  return value;
+}
+
+NvidiaProducerArgumentDescriptor CopyDescriptor(const TensorArgDesc& descriptor) {
+  NvidiaProducerArgumentDescriptor output;
+  output.is_scalar = descriptor.isScalar;
+  output.rank = static_cast<uint32_t>(descriptor.rank);
+  output.shape.reserve(descriptor.staticShape.size());
+  for (int64_t dimension : descriptor.staticShape) {
+    output.shape.push_back(CopyStaticValue(dimension));
+  }
+  output.strides.reserve(descriptor.staticStrides.size());
+  for (int64_t stride : descriptor.staticStrides) {
+    output.strides.push_back(CopyStaticValue(stride));
+  }
+  output.dynamic_size_count = static_cast<uint32_t>(descriptor.numDynSizes);
+  output.dynamic_stride_count = static_cast<uint32_t>(descriptor.numDynStrides);
+  output.explicit_strides = descriptor.hasExplicitStrides;
+  output.scalar_size_bytes = static_cast<uint32_t>(descriptor.scalarSizeInBytes);
+  output.total_argument_count = static_cast<uint32_t>(descriptor.totalArgs());
+  return output;
+}
+
+NvidiaProducerArgumentLayout CopyLayout(const KernelArgLayout& layout) {
+  NvidiaProducerArgumentLayout output;
+  output.operand_descriptors.reserve(layout.tensorDescs.size());
+  for (const TensorArgDesc& descriptor : layout.tensorDescs) {
+    output.operand_descriptors.push_back(CopyDescriptor(descriptor));
+  }
+  output.tile_sizes.reserve(layout.tileSizes.size());
+  for (int32_t tile_size : layout.tileSizes) {
+    output.tile_sizes.push_back(static_cast<uint32_t>(tile_size));
+  }
+  output.input_operand_count = static_cast<uint32_t>(layout.numInputs);
+  output.total_kernel_argument_count = static_cast<uint32_t>(layout.totalKernelArgs);
+  output.grid_shape_operand_index = static_cast<uint32_t>(layout.gridShapeTensorIdx);
+  output.uniform_signature = layout.uniformSignature;
+  return output;
+}
+
+NvidiaProducerArtifact CopyArtifact(const CudaTileCompiledArtifact& artifact) {
+  NvidiaProducerArtifact output;
+  output.schema_version = artifact.schemaVersion;
+  output.requested_artifact_kind = ArtifactKindName(artifact.requestedArtifactKind);
+  output.actual_artifact_kind = ArtifactKindName(artifact.actualArtifactKind);
+  output.requested_target = CopyTarget(artifact.requestedTarget);
+  output.actual_target = CopyTarget(artifact.actualTarget);
+  output.tile_ir_bytecode_version = {
+      artifact.tileIRBytecodeVersion.getMajor(), artifact.tileIRBytecodeVersion.getMinor(),
+      artifact.tileIRBytecodeVersion.getTag()};
+  output.device_code.reserve(artifact.deviceCode.size());
+  for (char byte : artifact.deviceCode) {
+    output.device_code.push_back(static_cast<uint8_t>(static_cast<unsigned char>(byte)));
+  }
+  output.runtime_kernel_name = artifact.runtimeKernelName;
+  output.entry_function_name = artifact.entryFunctionName;
+  output.argument_layout = CopyLayout(artifact.argLayout);
+  output.argument_packing_policy = ArgumentPackingPolicyName(artifact.argumentPackingPolicy);
+  output.grid_policy = GridPolicyName(artifact.gridPolicy);
+  output.static_grid = artifact.staticGrid;
+  output.workspace_size_bytes = artifact.workspaceSizeBytes;
+  output.workspace_alignment_bytes = artifact.workspaceAlignmentBytes;
+  output.environment_overrides_enabled = artifact.environmentOverridesEnabled;
+  output.artifact_fallback_allowed = artifact.artifactFallbackAllowed;
+  output.used_artifact_fallback = artifact.usedArtifactFallback();
+  output.tile_ir_assembler_path = artifact.tileIRAssemblerPath;
+  output.tile_ir_assembler_version = artifact.tileIRAssemblerVersion;
+  output.tile_ir_assembler_sha256 = artifact.tileIRAssemblerSha256;
+  output.compile_options_identity = artifact.compileOptionsIdentity;
+  return output;
+}
+
+}  // namespace
+
+NvidiaProducerResult CompilePrivateNvidiaArtifact(
+    const std::vector<uint8_t>& canonical_source, const NvidiaProducerOptions& options) {
+  if (const char* error = ValidateSource(canonical_source)) {
+    return Failure(kStatusInvalidArgument, error);
+  }
+  if (const char* error = ValidateStrictOptions(options)) {
+    return Failure(kStatusInvalidArgument, error);
+  }
+
+  auto target = SmTarget::fromCc(options.compute_capability, ArchPortability::arch_conditional);
+  if (mlir::failed(target) || target->toString() != options.target_name) {
+    return Failure(kStatusInvalidArgument, "TensorIR rejected the explicit sm_120a target");
+  }
+  auto bytecode_version = mlir::cuda_tile::BytecodeVersion::fromVersion(
+      options.bytecode_version.major, options.bytecode_version.minor,
+      options.bytecode_version.tag);
+  if (!bytecode_version) {
+    return Failure(kStatusInvalidArgument, "CUDA Tile rejected bytecode version 13.3.0");
+  }
+
+  CudaTileCompileOptions compile_options(*target);
+  compile_options.ctaCount = options.cta_count;
+  compile_options.warpCount = options.warp_count;
+  compile_options.occupancy = options.occupancy;
+  compile_options.smCount = options.sm_count;
+  compile_options.reductionTileSize = options.reduction_tile_size;
+  compile_options.persistence = PersistenceMode::None;
+  compile_options.tileSize.reserve(options.tile_sizes.size());
+  for (uint32_t tile_size : options.tile_sizes) {
+    compile_options.tileSize.push_back(static_cast<int32_t>(tile_size));
+  }
+  compile_options.uniformSignature = options.uniform_signature;
+  compile_options.codegenStrategy = CudaTileCodegenStrategy::LayoutPropagation;
+  compile_options.maxTileCandidates = options.max_tile_candidates;
+  compile_options.allowEnvironmentOverrides = options.environment_overrides_enabled;
+  compile_options.allowArtifactFallback = options.artifact_fallback_allowed;
+  compile_options.irDebug.dumpCudaTileIRPath.clear();
+  compile_options.irDebug.dumpTileIRBCPath.clear();
+  compile_options.irDebug.printIRAfterAll = false;
+  compile_options.irDebug.printIRTreeDir.clear();
+  compile_options.irDebug.enableTiming = false;
+  compile_options.irDebug.loadTileIRBCPath.clear();
+  compile_options.bytecodeVersion = *bytecode_version;
+  compile_options.artifactKind = CudaTileArtifactKind::Cubin;
+  compile_options.tileIRAssemblerPath = options.tile_ir_assembler_path;
+  compile_options.tileIRAssemblerVersion = options.tile_ir_assembler_version;
+  compile_options.tileIRAssemblerSha256 = options.tile_ir_assembler_sha256;
+
+  NvidiaProducerOptions applied_options = CopyAppliedOptions(compile_options);
+  if (!applied_options.ir_debug_options_empty) {
+    return Failure(kStatusCompilationError,
+                   "TensorIR IR debug options were not cleared at the private producer boundary");
+  }
+
+  const llvm::StringRef source(reinterpret_cast<const char*>(canonical_source.data()),
+                               canonical_source.size());
+  CudaTileCompiler compiler;
+  auto compiled = compiler.compileToArtifact(source, compile_options);
+  if (!compiled.ok()) {
+    return Failure(static_cast<int32_t>(compiled.status().code()), compiled.status().message(),
+                   &applied_options);
+  }
+  if (const char* error = ValidateArtifactBounds(*compiled, applied_options)) {
+    return Failure(kStatusCompilationError, error, &applied_options);
+  }
+
+  NvidiaProducerResult result;
+  result.ok = true;
+  result.status_code = kStatusSuccess;
+  result.applied_options = std::move(applied_options);
+  result.artifact = CopyArtifact(*compiled);
+  return result;
+}
+
