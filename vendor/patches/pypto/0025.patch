+"""Python-only public API checks for strict NVIDIA Artifact compilation."""
+
+import hashlib
+
+import pypto.compiler as compiler_api
+import pytest
+from pypto.pypto_core import compiler as compiler_core
+
+CANONICAL_SOURCE_LIMIT_BYTES = 16 * 1024 * 1024
+
+
+def _signature_line(function: object) -> str:
+    doc = getattr(function, "__doc__", None)
+    assert isinstance(doc, str)
+    return doc.splitlines()[0]
+
+
+def test_forgeable_artifact_producer_surfaces_are_removed() -> None:
+    assert not hasattr(compiler_api, "ArtifactProducerResult")
+    assert "ArtifactProducerResult" not in compiler_api.__all__
+    assert not hasattr(compiler_core, "ArtifactProducerResult")
+    assert not hasattr(compiler_api.Artifact, "create_strict")
+
+    with pytest.raises(TypeError):
+        compiler_api.ArtifactProducerIdentity()
+
+    toolchain_identity = compiler_api.ToolchainIdentity(
+        pypto_revision="0" * 40,
+        tensor_ir_revision="1" * 40,
+        cuda_tile_revision="2" * 40,
+        llvm_revision="3" * 40,
+        cuda_toolkit_root="/opt/cuda-13.3",
+        cuda_toolkit_version="13.3",
+        tileiras_real_path="/opt/cuda-13.3/bin/tileiras",
+        tileiras_version="13.3.0",
+        tileiras_sha256="4" * 64,
+    )
+    with pytest.raises(TypeError):
+        compiler_api.ArtifactProducerIdentity(
+            compiler_api.ArtifactProducerKind.TensorIrCudaTile,
+            toolchain_identity,
+            "5" * 40,
+            "tensorir.cuda_tile_compiled_artifact.v1",
+            "6" * 64,
+            False,
+            False,
+        )
+
+
+def test_bytes_only_artifact_method_signatures() -> None:
+    digest_signature = _signature_line(compiler_api.Artifact.compute_source_ir_digest)
+    assert digest_signature == "compute_source_ir_digest(canonical_source: bytes) -> str"
+
+    compile_signature = _signature_line(compiler_api.Artifact.compile_strict)
+    assert compile_signature.count("compile_strict(") == 1
+    assert compile_signature.count(",") == 2
+    assert compile_signature.startswith("compile_strict(canonical_source: bytes, request:")
+    assert "CompileRequest" in compile_signature
+    assert "KernelBuildSpec" in compile_signature
+    assert "producer" not in compile_signature
+
+    for method in (
+        compiler_api.Artifact.serialize_cache_key_identity_for,
+        compiler_api.Artifact.get_cache_key_digest_for,
+    ):
+        cache_key_signature = _signature_line(method)
+        assert cache_key_signature.count(",") == 1
+        assert "CompileRequest" in cache_key_signature
+        assert "KernelBuildSpec" in cache_key_signature
+        assert "producer_identity" not in cache_key_signature
+
+
+def test_source_ir_digest_hashes_exact_bytes_and_rejects_str() -> None:
+    canonical_source = b"module {\n  func.func @main()\n}\n"
+
+    assert compiler_api.Artifact.compute_source_ir_digest(
+        canonical_source
+    ) == hashlib.sha256(canonical_source).hexdigest()
+    with pytest.raises(TypeError):
+        compiler_api.Artifact.compute_source_ir_digest(canonical_source.decode("ascii"))
+
+
+def test_source_ir_digest_validates_content_and_size_boundary() -> None:
+    with pytest.raises(ValueError, match="must not be empty"):
+        compiler_api.Artifact.compute_source_ir_digest(b"")
+    with pytest.raises(ValueError, match="must not contain NUL bytes"):
+        compiler_api.Artifact.compute_source_ir_digest(b"module {}\x00")
