 using pypto::codegen::nvidia::TensorIrValueRole;
+using pypto::codegen::nvidia::TypedTensorIrOpKind;
 using pypto::compiler::Artifact;
 using pypto::compiler::detail::BuildTypedTensorIrModule;
 
@@ -302,6 +304,20 @@ std::string MaterializedCanonicalSource(const TensorIrModule& module) {
              : std::string{};
 }
 
+bool HasTypedOperation(const TensorIrModule& module,
+                       pypto::codegen::nvidia::TypedTensorIrOpKind kind) {
+  if (!module.HasTypedModuleSpec() ||
+      module.GetTypedModuleSpec()->kind !=
+          pypto::codegen::nvidia::TypedTensorIrModuleKind::Generic) {
+    return false;
+  }
+  const auto& operations = module.GetTypedModuleSpec()->generic.operations;
+  return std::any_of(operations.begin(), operations.end(),
+                     [kind](const auto& operation) {
+                       return operation.kind == kind;
+                     });
+}
+
