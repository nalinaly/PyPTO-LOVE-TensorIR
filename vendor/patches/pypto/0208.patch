+bool IsNativeTileSiluAndMulCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 3) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const TileLoopNest loop_nest =
+      scope ? UnwrapStaticTileLoops(scope->body_) : TileLoopNest{};
+  if (!loop_nest.leaf || loop_nest.leaf->stmts_.size() != 12) return false;
+  const auto first_cast =
+      ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[2]);
+  const auto final_cast =
+      ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[10]);
+  const auto first_call =
+      first_cast ? ir::As<ir::Call>(first_cast->value_) : nullptr;
+  const auto final_call =
+      final_cast ? ir::As<ir::Call>(final_cast->value_) : nullptr;
+  return first_call && final_call && ir::IsOp(first_call, "tile.cast") &&
+         ir::IsOp(final_call, "tile.cast");
+}
+
+NativeTileSiluAndMulGraph AnalyzeNativeTileSiluAndMul(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native SiLU-and-mul must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 3 ||
+      function->param_directions_.size() != 3 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native SiLU-and-mul requires two inputs and one output",
+           &function->span_);
+  }
+  const StaticTensor gate = ReadStaticNdStridedTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native SiLU gate");
+  const StaticTensor up = ReadStaticNdStridedTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native SiLU up input");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native SiLU result");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native SiLU declared result");
+  if (gate.dtype != DataType::BF16 || up.dtype != DataType::BF16 ||
+      result.dtype != DataType::BF16 || gate.shape.size() != 2 ||
+      gate.shape != up.shape || gate.shape != result.shape ||
+      gate.dense_strides[1] != 1 || up.dense_strides[1] != 1 ||
+      gate.dense_strides[0] < gate.shape[1] ||
+      up.dense_strides[0] < up.shape[1] || !SameTensor(result, declared) ||
+      result.shape[1] % 128 != 0) {
+    Reject("native SiLU-and-mul tensor types, shapes, or strides are invalid",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[2].get()) {
+    Reject("native SiLU-and-mul scope or return is invalid", &function->span_);
+  }
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  const uint64_t expected_repetitions =
+      static_cast<uint64_t>(result.shape[0]) *
+      static_cast<uint64_t>(result.shape[1] / 128);
+  if (!loop_nest.leaf || loop_nest.leaf->stmts_.size() != 12 ||
+      loop_nest.repetitions != expected_repetitions) {
+    Reject("native SiLU-and-mul loops must cover [1,128] tiles exactly",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 11> kOps = {
+      "tile.load", "tile.load", "tile.cast", "tile.cast", "tile.muls",
+      "tile.exp",  "tile.adds", "tile.recip", "tile.mul",  "tile.mul",
+      "tile.cast"};
+  std::array<ir::AssignStmtPtr, kOps.size()> assignments;
+  std::array<ir::CallPtr, kOps.size()> calls;
+  for (size_t index = 0; index < kOps.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native SiLU-and-mul operation sequence is invalid",
+             &loop_nest.leaf->stmts_[index]->span_);
+    }
+  }
+  const auto require_source = [&](size_t call_index, size_t argument_index,
+                                  const ir::VarPtr& expected) {
+    if (argument_index >= calls[call_index]->args_.size()) return false;
+    const auto value =
+        ir::As<ir::Var>(calls[call_index]->args_[argument_index]);
+    return value && value.get() == expected.get();
+  };
+  if (!require_source(0, 0, function->params_[0]) ||
+      !require_source(1, 0, function->params_[1]) ||
+      !require_source(2, 0, assignments[0]->var_) ||
+      !require_source(3, 0, assignments[1]->var_) ||
+      !require_source(4, 0, assignments[2]->var_) ||
+      !require_source(5, 0, assignments[4]->var_) ||
+      !require_source(6, 0, assignments[5]->var_) ||
+      !require_source(7, 0, assignments[6]->var_) ||
+      !require_source(8, 0, assignments[2]->var_) ||
+      !require_source(8, 1, assignments[7]->var_) ||
+      !require_source(9, 0, assignments[8]->var_) ||
+      !require_source(9, 1, assignments[3]->var_) ||
+      !require_source(10, 0, assignments[9]->var_)) {
+    Reject("native SiLU-and-mul SSA dataflow is invalid", &scope->span_);
+  }
+  const StaticTensor bf16_tile{DataType::BF16, {1, 128}, {128, 1}};
+  const StaticTensor fp32_tile{DataType::FP32, {1, 128}, {128, 1}};
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    const StaticTensor tile = ReadStaticTile(
+        assignments[index]->var_->GetType(), assignments[index]->span_,
+        "native SiLU-and-mul tile");
+    const bool expects_bf16 = index < 2 || index == assignments.size() - 1;
+    if (!SameTensor(tile, expects_bf16 ? bf16_tile : fp32_tile)) {
+      Reject("native SiLU-and-mul tile dtype or shape is invalid",
+             &assignments[index]->span_);
+    }
+  }
+  const auto store = ir::As<ir::EvalStmt>(loop_nest.leaf->stmts_.back());
+  const auto store_call = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  const auto stored = store_call && store_call->args_.size() == 3
+                          ? ir::As<ir::Var>(store_call->args_[0])
+                          : nullptr;
+  const auto target = store_call && store_call->args_.size() == 3
+                          ? ir::As<ir::Var>(store_call->args_[2])
+                          : nullptr;
+  if (!store_call || !ir::IsOp(store_call, "tile.store") || !stored ||
+      stored.get() != assignments.back()->var_.get() || !target ||
+      target.get() != function->params_[2].get()) {
+    Reject("native SiLU-and-mul store is invalid", &scope->span_);
+  }
+  return NativeTileSiluAndMulGraph{gate, up, result};
+}
