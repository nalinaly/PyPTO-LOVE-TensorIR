+bool ValidateNativeSiluAndMulSpec(const NativeSiluAndMulTensorIrSpec& spec,
+                                  std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR SiLU-and-mul specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (const auto& input : spec.inputs) {
+    if (!HasValidStaticMetadata(input) || input.shape.size() != 2 ||
+        input.element_type != TypedTensorIrElementType::BF16 ||
+        input.strides[1] != 1 || input.strides[0] < input.shape[1]) {
+      return reject("inputs must be row-pitched rank-2 BF16 tensors");
+    }
+  }
+  if (!HasValidStaticMetadata(spec.result) || !IsDense(spec.result) ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      spec.inputs[0].shape != spec.inputs[1].shape ||
+      spec.inputs[0].shape != spec.result.shape ||
+      spec.result.shape[1] % 128 != 0) {
+    return reject("result dtype, shape, or tile geometry is invalid");
+  }
+  return true;
+}
