+mlir::Value BuildNativeSiluAndMul(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const NativeSiluAndMulTensorIrSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                           entry.getArguments().end());
+  const auto wide_type = TensorType(
+      builder, TypedTensorIrElementType::FP32, spec.result.shape);
+  const auto result_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, spec.result.shape);
+  const mlir::Value gate =
+      tir::ConvertOp::create(builder, location, wide_type, arguments[0])
+          .getOutput();
+  const mlir::Value up =
+      tir::ConvertOp::create(builder, location, wide_type, arguments[1])
+          .getOutput();
+  const mlir::Value negative =
+      tir::NegOp::create(builder, location, wide_type, gate).getOutput();
+  const mlir::Value exponent =
+      tir::ExpOp::create(builder, location, wide_type, negative).getOutput();
+  const mlir::Value one =
+      tir::ConstantOp::create(builder, location, builder.getF32FloatAttr(1.0F))
+          .getResult();
+  const mlir::Value one_full =
+      tir::SplatOp::create(builder, location, wide_type, one,
+                           mlir::ValueRange{})
+          .getOutput();
+  const mlir::Value denominator =
+      tir::AddOp::create(builder, location, wide_type, exponent, one_full)
+          .getOutput();
+  const mlir::Value sigmoid =
+      tir::ReciprocalOp::create(builder, location, wide_type, denominator)
+          .getOutput();
+  const mlir::Value silu =
+      tir::MulOp::create(builder, location, wide_type, gate, sigmoid)
+          .getOutput();
+  const mlir::Value product =
+      tir::MulOp::create(builder, location, wide_type, silu, up).getOutput();
+  return tir::ConvertOp::create(builder, location, result_type, product)
+      .getOutput();
+}
