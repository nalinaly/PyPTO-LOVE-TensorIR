+++ b/tests/lint/check_nvidia_typed_codegen.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Reject textual TensorIR construction in the NVIDIA codegen boundary.
+
+Canonical TensorIR modules must be described by typed specs and materialized by
+the MLIR builder.  This small source lint intentionally has no dependency on
+the compiler build, so it can run in pre-commit and source-release checks.
+"""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import re
+import sys
+
+
+FORBIDDEN = (
+    re.compile(r"\bsource\s*\+="),
+    re.compile(r"\bsource\s*\.append\s*\("),
+)
+
+
+def find_violations(root: Path) -> list[str]:
+    codegen = (root / "src/codegen/nvidia").resolve()
+    violations: list[str] = []
+    for path in sorted(codegen.glob("*.cpp")):
+        for line_number, line in enumerate(path.read_text().splitlines(), 1):
+            if any(pattern.search(line) for pattern in FORBIDDEN):
+                violations.append(f"{path.relative_to(root)}:{line_number}: {line.strip()}")
+    return violations
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
+    args = parser.parse_args(argv)
+    violations = find_violations(args.root.resolve())
+    if violations:
+        print("textual NVIDIA TensorIR construction is forbidden:", file=sys.stderr)
+        print("\n".join(violations), file=sys.stderr)
+        return 1
+    print("typed NVIDIA TensorIR source lint: pass")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
