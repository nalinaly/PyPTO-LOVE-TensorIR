+TypedTensorIrElementType ToTypedTensorIrElementType(DataType dtype) {
+  if (dtype == DataType::BF16) return TypedTensorIrElementType::BF16;
+  if (dtype == DataType::FP32) return TypedTensorIrElementType::FP32;
+  if (dtype == DataType::INT32) return TypedTensorIrElementType::INT32;
+  if (dtype == DataType::INT64) return TypedTensorIrElementType::INT64;
+  InternalReject("unsupported dtype reached typed TensorIR module construction");
+}
+
+TypedTensorIrTensorSpec MakeTypedTensorIrTensorSpec(
+    const StaticTensor& tensor, bool has_explicit_strides) {
+  return TypedTensorIrTensorSpec{ToTypedTensorIrElementType(tensor.dtype),
+                                 tensor.shape, tensor.dense_strides,
+                                 has_explicit_strides};
+}
+
+TypedTensorIrModuleSpec MakeNativeGdnRecurrentTensorIrSpec(
+    const NativeTileGdnRecurrentGraph& graph) {
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativeGdnRecurrent;
+  NativeGdnRecurrentTensorIrSpec& spec = module_spec.native_gdn_recurrent;
+  const std::array<StaticTensor, NativeGdnRecurrentTensorIrSpec::kInputCount>
+      inputs = {graph.mixed_qkv, graph.a,     graph.b,       graph.a_log,
+                graph.dt_bias,   graph.state, graph.state_indices};
+  for (size_t index = 0; index < inputs.size(); ++index) {
+    spec.inputs[index] = MakeTypedTensorIrTensorSpec(
+        inputs[index], /*has_explicit_strides=*/true);
+  }
+  spec.result = MakeTypedTensorIrTensorSpec(
+      graph.result, /*has_explicit_strides=*/true);
+  spec.batch_size = graph.batch_size;
+  spec.tokens_per_request = graph.tokens_per_request;
+  spec.query_heads = graph.q_heads;
+  spec.value_heads = graph.value_heads;
+  spec.key_dim = graph.key_dim;
+  spec.value_dim = graph.value_dim;
+  spec.state_slots = graph.state_slots;
+  spec.scale = graph.scale;
+  return module_spec;
+}
