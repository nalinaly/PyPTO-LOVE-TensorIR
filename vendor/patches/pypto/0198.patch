+constexpr std::string_view kEntryName = "pypto_fused_pointwise";
+constexpr std::string_view kAlignedAddAttribute =
+    "_pypto_align_rhs_trailing_transpose";
+constexpr size_t kMaximumCanonicalSourceBytes = 16ULL * 1024ULL * 1024ULL;
+constexpr size_t kMaximumCapturedDiagnosticBytes = 64ULL * 1024ULL;
+constexpr int64_t kMaximumBatchTokenProduct = 4096;
+
+bool CheckedMultiply(int64_t left, int64_t right, int64_t& result) {
+  if (left <= 0 || right <= 0 ||
+      left > std::numeric_limits<int64_t>::max() / right) {
+    return false;
+  }
+  result = left * right;
+  return true;
+}
+
+bool IsDense(const TypedTensorIrTensorSpec& tensor) {
+  if (tensor.shape.size() != tensor.strides.size() || tensor.shape.empty()) {
+    return false;
+  }
+  int64_t running = 1;
+  for (size_t reverse_index = tensor.shape.size(); reverse_index > 0;
+       --reverse_index) {
+    const size_t index = reverse_index - 1;
+    if (tensor.shape[index] <= 0 || tensor.strides[index] != running ||
+        tensor.shape[index] > std::numeric_limits<int64_t>::max() / running) {
+      return false;
+    }
+    running *= tensor.shape[index];
+  }
+  return true;
+}
+
+bool IsDenseOrZeroStrideBroadcast(const TypedTensorIrTensorSpec& tensor) {
+  return IsDense(tensor) ||
+         std::any_of(tensor.strides.begin(), tensor.strides.end(),
+                     [](int64_t stride) { return stride == 0; });
+}
+
+bool HasValidStaticMetadata(const TypedTensorIrTensorSpec& tensor) {
+  if (!tensor.has_explicit_strides || tensor.shape.empty() ||
+      tensor.shape.size() > 32 || tensor.shape.size() != tensor.strides.size()) {
+    return false;
+  }
+  return std::all_of(tensor.shape.begin(), tensor.shape.end(),
+                     [](int64_t dimension) { return dimension > 0; }) &&
+         std::all_of(tensor.strides.begin(), tensor.strides.end(),
+                     [](int64_t stride) { return stride >= 0; });
+}
+
+bool SameShape(const TypedTensorIrTensorSpec& tensor,
+               std::initializer_list<int64_t> shape) {
+  return tensor.shape == std::vector<int64_t>(shape);
+}
+
+bool ValidateNativeGdnRecurrentSpec(
+    const NativeGdnRecurrentTensorIrSpec& spec, std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR GDN specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (const TypedTensorIrTensorSpec& input : spec.inputs) {
+    if (!HasValidStaticMetadata(input)) {
+      return reject("input metadata is not fully static with explicit strides");
+    }
+  }
+  if (!HasValidStaticMetadata(spec.result)) {
+    return reject("result metadata is not fully static with explicit strides");
+  }
+  if (spec.batch_size <= 0 || spec.tokens_per_request <= 0 ||
+      spec.query_heads <= 0 || spec.value_heads <= 0 || spec.key_dim <= 0 ||
+      spec.value_dim <= 0 || spec.state_slots <= 0 ||
+      spec.value_heads % spec.query_heads != 0 || spec.key_dim % 128 != 0 ||
+      spec.value_dim % 16 != 0 || !std::isfinite(spec.scale)) {
+    return reject("static geometry is invalid");
+  }
+  int64_t batch_token_product = 0;
+  if (!CheckedMultiply(spec.batch_size, spec.tokens_per_request,
+                       batch_token_product) ||
+      batch_token_product > kMaximumBatchTokenProduct) {
+    return reject("batch-token product exceeds the bounded typed builder");
+  }
+  int64_t qk_width = 0;
+  int64_t value_width = 0;
+  int64_t state_width = 0;
+  int64_t mixed_width = 0;
+  if (!CheckedMultiply(spec.query_heads, spec.key_dim, qk_width) ||
+      !CheckedMultiply(spec.value_heads, spec.value_dim, value_width) ||
+      !CheckedMultiply(value_width, spec.key_dim, state_width) ||
+      qk_width > (std::numeric_limits<int64_t>::max() - value_width) / 2) {
+    return reject("static geometry overflows signed 64-bit metadata");
+  }
+  mixed_width = 2 * qk_width + value_width;
+  const auto& mixed_qkv = spec.inputs[0];
+  const auto& a = spec.inputs[1];
+  const auto& b = spec.inputs[2];
+  const auto& a_log = spec.inputs[3];
+  const auto& dt_bias = spec.inputs[4];
+  const auto& state = spec.inputs[5];
+  const auto& state_indices = spec.inputs[6];
+  if (mixed_qkv.element_type != TypedTensorIrElementType::BF16 ||
+      !SameShape(mixed_qkv,
+                 {spec.batch_size, spec.tokens_per_request, mixed_width}) ||
+      !IsDense(mixed_qkv) || a.element_type != TypedTensorIrElementType::BF16 ||
+      b.element_type != TypedTensorIrElementType::BF16 ||
+      a.shape != spec.result.shape || b.shape != spec.result.shape ||
+      a.strides != b.strides || !IsDenseOrZeroStrideBroadcast(a) ||
+      !IsDenseOrZeroStrideBroadcast(b) ||
+      a_log.element_type != TypedTensorIrElementType::FP32 ||
+      dt_bias.element_type != TypedTensorIrElementType::BF16 ||
+      !SameShape(a_log, {spec.value_heads, spec.value_dim}) ||
+      a_log.shape != dt_bias.shape || a_log.strides != dt_bias.strides ||
+      !IsDenseOrZeroStrideBroadcast(a_log) ||
+      !IsDenseOrZeroStrideBroadcast(dt_bias) ||
+      state.element_type != TypedTensorIrElementType::FP32 ||
+      !SameShape(state, {spec.state_slots, state_width}) ||
+      state.strides.size() != 2 || state.strides[1] != 1 ||
+      state.strides[0] < state_width ||
+      (state_indices.element_type != TypedTensorIrElementType::INT32 &&
+       state_indices.element_type != TypedTensorIrElementType::INT64) ||
+      !SameShape(state_indices, {spec.batch_size, 1}) ||
+      !IsDense(state_indices) ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      !SameShape(spec.result,
+                 {spec.batch_size, spec.tokens_per_request, spec.value_heads,
+                  spec.value_dim}) ||
+      !IsDense(spec.result)) {
+    return reject("tensor dtype, shape, or stride contract is invalid");
+  }
+  const double expected_scale =
+      1.0 / std::sqrt(static_cast<double>(spec.key_dim));
+  if (std::fabs(spec.scale - expected_scale) >
+      std::numeric_limits<double>::epsilon()) {
+    return reject("scale does not equal 1/sqrt(key_dim)");
+  }
+  return true;
+}
+
+class NativeGdnRecurrentBuilder {
+ public:
+  NativeGdnRecurrentBuilder(mlir::OpBuilder& builder, mlir::Location location,
+                            const NativeGdnRecurrentTensorIrSpec& spec)
+      : builder_(builder), location_(location), spec_(spec) {}
+
+  mlir::Value Build(mlir::Block& entry) {
+    const int64_t heads_per_query = spec_.value_heads / spec_.query_heads;
+    const int64_t qk_width = spec_.query_heads * spec_.key_dim;
+    const int64_t value_width = spec_.value_heads * spec_.value_dim;
+    const int64_t state_width = value_width * spec_.key_dim;
+
+    const auto i32_indices_type = Tensor(
+        TypedTensorIrElementType::INT32, spec_.inputs[6].shape);
+    const auto indices_column_type =
+        Tensor(TypedTensorIrElementType::INT32, {1, 1});
+    const auto indices_full_type =
+        Tensor(TypedTensorIrElementType::INT32, {1, state_width});
+    const auto state_row_type =
+        Tensor(TypedTensorIrElementType::FP32, {1, state_width});
+    const auto state_group_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, spec_.value_dim, spec_.key_dim});
+    const auto state_transposed_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, spec_.key_dim, spec_.value_dim});
+    const auto qk_box_type =
+        Tensor(TypedTensorIrElementType::BF16, {1, 1, qk_width});
+    const auto query_seed_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {spec_.query_heads, 1, 1, spec_.key_dim});
+    const auto query_group_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {spec_.query_heads, heads_per_query, 1, spec_.key_dim});
+    const auto wide_query_group_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, 1, spec_.key_dim});
+    const auto key_column_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, spec_.key_dim, 1});
+    const auto norm_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, 1, 1});
+    const auto value_box_type =
+        Tensor(TypedTensorIrElementType::BF16, {1, 1, value_width});
+    const auto value_group_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {spec_.query_heads, heads_per_query, spec_.value_dim, 1});
+    const auto wide_value_group_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, spec_.value_dim, 1});
+    const auto gate_box_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {1, 1, spec_.value_heads, spec_.value_dim});
+    const auto parameter_group_type = wide_value_group_type;
+    const auto dt_parameter_group_type = value_group_type;
+    const auto output_group_type = Tensor(
+        TypedTensorIrElementType::FP32,
+        {spec_.query_heads, heads_per_query, 1, spec_.value_dim});
+    const auto output_group_bf16_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {spec_.query_heads, heads_per_query, 1, spec_.value_dim});
+    const auto output_box_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {1, 1, spec_.value_heads, spec_.value_dim});
+    const auto batch_result_type = Tensor(
+        TypedTensorIrElementType::BF16,
+        {1, spec_.tokens_per_request, spec_.value_heads, spec_.value_dim});
+    const auto result_type = Tensor(spec_.result.element_type, spec_.result.shape);
+
+    llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                             entry.getArguments().end());
+    mlir::Value indices = arguments[6];
+    if (spec_.inputs[6].element_type == TypedTensorIrElementType::INT64) {
+      indices = Convert(indices, i32_indices_type);
+    }
+    const mlir::Value a_group = Reshape(arguments[3], parameter_group_type);
+    const mlir::Value exp_a_group = Unary<tir::ExpOp>(a_group);
+    const mlir::Value dt_group_bf16 =
+        Reshape(arguments[4], dt_parameter_group_type);
+    const mlir::Value dt_group =
+        Convert(dt_group_bf16, parameter_group_type);
+    const mlir::Value epsilon_splat =
+        Splat(Constant(1.0e-6F), norm_type);
+    const mlir::Value one_gate =
+        Splat(Constant(1.0F), parameter_group_type);
+    const mlir::Value zero_gate =
+        Splat(Constant(0.0F), parameter_group_type);
+    const mlir::Value scale_splat =
+        Splat(Constant(static_cast<float>(spec_.scale)),
+              wide_query_group_type);
+
+    llvm::SmallVector<mlir::Value> batch_outputs;
+    batch_outputs.reserve(static_cast<size_t>(spec_.batch_size));
+    for (int64_t batch = 0; batch < spec_.batch_size; ++batch) {
+      const mlir::Value state_index =
+          Slice(indices, indices_column_type, {batch, 0}, {batch + 1, 1},
+                {1, 1});
+      const mlir::Value indices_full =
+          Broadcast(state_index, indices_full_type);
+      const mlir::Value state_row =
+          tir::GatherRowsOp::create(builder_, location_, state_row_type,
+                                    arguments[5], indices_full)
+              .getOutput();
+      mlir::Value current_state = Reshape(state_row, state_group_type);
+      mlir::Value final_scaled_query;
+      llvm::SmallVector<mlir::Value> token_outputs;
+      token_outputs.reserve(static_cast<size_t>(spec_.tokens_per_request));
+
+      for (int64_t token = 0; token < spec_.tokens_per_request; ++token) {
+        const auto build_normalized_qk = [&](int64_t offset) {
+          const mlir::Value box = Slice(
+              arguments[0], qk_box_type, {batch, token, offset},
+              {batch + 1, token + 1, offset + qk_width}, {1, 1, 1});
+          const mlir::Value seed = Reshape(box, query_seed_type);
+          const mlir::Value group = Broadcast(seed, query_group_type);
+          const mlir::Value wide = Convert(group, wide_query_group_type);
+          const mlir::Value square = Binary<tir::MulOp>(wide, wide);
+          const mlir::Value sum = Reduce(square, norm_type, {3});
+          const mlir::Value norm2 = Binary<tir::AddOp>(sum, epsilon_splat);
+          const mlir::Value inverse = Unary<tir::RsqrtOp>(norm2);
+          const mlir::Value inverse_full =
+              Broadcast(inverse, wide_query_group_type);
+          return Binary<tir::MulOp>(wide, inverse_full);
+        };
+        const mlir::Value query = build_normalized_qk(/*offset=*/0);
+        const mlir::Value key = build_normalized_qk(/*offset=*/qk_width);
+        const mlir::Value scaled_query =
+            Binary<tir::MulOp>(query, scale_splat);
+        final_scaled_query = scaled_query;
+
+        const mlir::Value value_box = Slice(
+            arguments[0], value_box_type,
+            {batch, token, 2 * qk_width},
+            {batch + 1, token + 1, 2 * qk_width + value_width},
+            {1, 1, 1});
+        const mlir::Value value = Reshape(value_box, value_group_type);
+        const mlir::Value wide_value =
+            Convert(value, wide_value_group_type);
+
+        const auto build_gate = [&](mlir::Value argument) {
+          const mlir::Value box = Slice(
+              argument, gate_box_type, {batch, token, 0, 0},
+              {batch + 1, token + 1, spec_.value_heads, spec_.value_dim},
+              {1, 1, 1, 1});
+          const mlir::Value gate_bf16 = Reshape(box, value_group_type);
+          return Convert(gate_bf16, parameter_group_type);
+        };
+        const mlir::Value a = build_gate(arguments[1]);
+        const mlir::Value b = build_gate(arguments[2]);
+
+        const mlir::Value gate_x = Binary<tir::AddOp>(a, dt_group);
+        const mlir::Value gate_abs = Unary<tir::AbsOp>(gate_x);
+        const mlir::Value gate_neg_abs = Unary<tir::NegOp>(gate_abs);
+        const mlir::Value gate_tail_exp = Unary<tir::ExpOp>(gate_neg_abs);
+        const mlir::Value gate_tail_shift =
+            Binary<tir::AddOp>(gate_tail_exp, one_gate);
+        const mlir::Value gate_tail = Unary<tir::LogOp>(gate_tail_shift);
+        const mlir::Value gate_positive =
+            Binary<tir::MaxOp>(gate_x, zero_gate);
+        const mlir::Value softplus =
+            Binary<tir::AddOp>(gate_positive, gate_tail);
+        const mlir::Value g_positive =
+            Binary<tir::MulOp>(exp_a_group, softplus);
+        const mlir::Value g = Unary<tir::NegOp>(g_positive);
+        const mlir::Value decay = Unary<tir::ExpOp>(g);
+        const mlir::Value decay_full = Broadcast(decay, state_group_type);
+        const mlir::Value decayed =
+            Binary<tir::MulOp>(current_state, decay_full);
+
+        const mlir::Value beta_x = Unary<tir::NegOp>(b);
+        const mlir::Value beta_abs = Unary<tir::AbsOp>(beta_x);
+        const mlir::Value beta_neg_abs = Unary<tir::NegOp>(beta_abs);
+        const mlir::Value beta_tail_exp = Unary<tir::ExpOp>(beta_neg_abs);
+        const mlir::Value beta_tail_shift =
+            Binary<tir::AddOp>(beta_tail_exp, one_gate);
+        const mlir::Value beta_tail = Unary<tir::LogOp>(beta_tail_shift);
+        const mlir::Value beta_positive =
+            Binary<tir::MaxOp>(beta_x, zero_gate);
+        const mlir::Value beta_softplus =
+            Binary<tir::AddOp>(beta_positive, beta_tail);
+        const mlir::Value beta_neg_softplus =
+            Unary<tir::NegOp>(beta_softplus);
+        const mlir::Value beta = Unary<tir::ExpOp>(beta_neg_softplus);
+        const mlir::Value beta_bf16 = Convert(beta, value_group_type);
+        const mlir::Value beta_rounded =
+            Convert(beta_bf16, parameter_group_type);
+
+        const mlir::Value key_column =
+            Transpose(key, key_column_type, {0, 1, 3, 2});
+        const mlir::Value state_key =
+            Matmul(decayed, key_column, parameter_group_type);
+        const mlir::Value residual =
+            Binary<tir::SubOp>(wide_value, state_key);
+        const mlir::Value delta =
+            Binary<tir::MulOp>(residual, beta_rounded);
+        const mlir::Value outer = Matmul(delta, key, state_group_type);
+        const mlir::Value decayed_flat = Reshape(decayed, state_row_type);
+        const mlir::Value outer_flat = Reshape(outer, state_row_type);
+        auto updated_flat = tir::AddOp::create(
+            builder_, location_, state_row_type, decayed_flat, outer_flat);
+        updated_flat->setAttr(kAlignedAddAttribute,
+                              builder_.getBoolAttr(true));
+        current_state = Reshape(updated_flat.getOutput(), state_group_type);
+
+        if (token + 1 != spec_.tokens_per_request) {
+          token_outputs.push_back(BuildOutput(
+              scaled_query, current_state, state_transposed_type,
+              output_group_type, output_group_bf16_type, output_box_type));
+        }
+      }
+
+      const mlir::Value final_state = Reshape(current_state, state_row_type);
+      const mlir::Value stored_state =
+          tir::ScatterRowsOp::create(builder_, location_, state_row_type,
+                                     arguments[5], indices_full, final_state)
+              .getOutput();
+      const mlir::Value stored_group = Reshape(stored_state, state_group_type);
+      const mlir::Value final_output = BuildOutput(
+          final_scaled_query, stored_group, state_transposed_type,
+          output_group_type, output_group_bf16_type, output_box_type);
+      token_outputs.push_back(final_output);
+
+      if (token_outputs.size() == 1) {
+        batch_outputs.push_back(token_outputs.front());
+      } else {
+        batch_outputs.push_back(Concatenate(token_outputs, batch_result_type,
+                                            /*dimension=*/1));
+      }
+    }
+
+    if (batch_outputs.size() == 1) return batch_outputs.front();
+    return Concatenate(batch_outputs, result_type, /*dimension=*/0);
+  }
+
+ private:
+  mlir::Type ElementType(TypedTensorIrElementType element_type) const {
+    if (element_type == TypedTensorIrElementType::BF16) {
+      return builder_.getBF16Type();
+    }
+    if (element_type == TypedTensorIrElementType::FP32) {
+      return builder_.getF32Type();
+    }
+    if (element_type == TypedTensorIrElementType::INT32) {
+      return builder_.getIntegerType(32, mlir::IntegerType::Signed);
+    }
+    return builder_.getIntegerType(64, mlir::IntegerType::Signed);
+  }
+
+  mlir::RankedTensorType Tensor(TypedTensorIrElementType element_type,
+                                llvm::ArrayRef<int64_t> shape) const {
+    return mlir::RankedTensorType::get(shape, ElementType(element_type));
+  }
+
+  mlir::Value Constant(float value) {
+    return tir::ConstantOp::create(builder_, location_,
+                                   builder_.getF32FloatAttr(value))
+        .getResult();
+  }
+
+  mlir::Value Reshape(mlir::Value input, mlir::RankedTensorType output_type) {
+    return tir::ReshapeOp::create(builder_, location_, output_type, input,
+                                  mlir::ValueRange{})
+        .getOutput();
+  }
+
+  mlir::Value Convert(mlir::Value input, mlir::RankedTensorType output_type) {
+    return tir::ConvertOp::create(builder_, location_, output_type, input)
+        .getOutput();
+  }
+
+  mlir::Value Broadcast(mlir::Value input,
+                        mlir::RankedTensorType output_type) {
+    if (input.getType() == output_type) return input;
+    return tir::BroadcastOp::create(builder_, location_, output_type, input,
+                                    mlir::ValueRange{})
+        .getOutput();
+  }
+
+  mlir::Value Splat(mlir::Value input, mlir::RankedTensorType output_type) {
+    return tir::SplatOp::create(builder_, location_, output_type, input,
+                                mlir::ValueRange{})
+        .getOutput();
+  }
+
+  mlir::Value Slice(mlir::Value input, mlir::RankedTensorType output_type,
+                    llvm::ArrayRef<int64_t> starts,
+                    llvm::ArrayRef<int64_t> limits,
+                    llvm::ArrayRef<int64_t> strides) {
+    return tir::SliceOp::create(builder_, location_, output_type, input, starts,
+                                limits, strides)
+        .getOutput();
+  }
+
+  mlir::Value Transpose(mlir::Value input,
+                        mlir::RankedTensorType output_type,
+                        llvm::ArrayRef<int64_t> permutation) {
+    return tir::TransposeOp::create(builder_, location_, output_type, input,
+                                    permutation)
+        .getOutput();
+  }
+
+  mlir::Value Reduce(mlir::Value input, mlir::RankedTensorType output_type,
+                     llvm::ArrayRef<int32_t> dimensions) {
+    return tir::ReduceOp::create(builder_, location_, output_type, input,
+                                 dimensions, tir::ReductionMode::add)
+        .getOutput();
+  }
+
+  mlir::Value Matmul(mlir::Value left, mlir::Value right,
+                     mlir::RankedTensorType output_type) {
+    return tir::MatmulOp::create(builder_, location_, output_type, left, right)
+        .getC();
+  }
+
+  mlir::Value Concatenate(llvm::ArrayRef<mlir::Value> inputs,
+                          mlir::RankedTensorType output_type,
+                          uint64_t dimension) {
+    return tir::ConcatenateOp::create(builder_, location_, output_type, inputs,
+                                      dimension)
+        .getOutput();
+  }
+
+  template <typename Op>
+  mlir::Value Unary(mlir::Value input) {
+    return Op::create(builder_, location_, input.getType(), input).getOutput();
+  }
+
+  template <typename Op>
+  mlir::Value Binary(mlir::Value left, mlir::Value right) {
+    return Op::create(builder_, location_, left.getType(), left, right)
+        .getOutput();
+  }
+
+  mlir::Value BuildOutput(
+      mlir::Value scaled_query, mlir::Value state,
+      mlir::RankedTensorType state_transposed_type,
+      mlir::RankedTensorType output_group_type,
+      mlir::RankedTensorType output_group_bf16_type,
+      mlir::RankedTensorType output_box_type) {
+    const mlir::Value state_transposed =
+        Transpose(state, state_transposed_type, {0, 1, 3, 2});
+    const mlir::Value output_wide =
+        Matmul(scaled_query, state_transposed, output_group_type);
+    const mlir::Value output =
+        Convert(output_wide, output_group_bf16_type);
+    return Reshape(output, output_box_type);
+  }
+
+  mlir::OpBuilder& builder_;
+  mlir::Location location_;
+  const NativeGdnRecurrentTensorIrSpec& spec_;
+};
+
+mlir::StringAttr MakeStrideAttribute(mlir::OpBuilder& builder,
+                                     llvm::ArrayRef<int64_t> strides) {
+  tcg::Stride stride;
+  for (int64_t value : strides) stride.append(value);
+  return builder.getStringAttr(tcg::to_string(stride));
+}
+
+void AppendDiagnostic(std::string& output, mlir::Diagnostic& diagnostic) {
+  if (output.size() >= kMaximumCapturedDiagnosticBytes) return;
+  std::string rendered;
+  llvm::raw_string_ostream stream(rendered);
+  diagnostic.print(stream);
+  stream.flush();
+  const size_t remaining = kMaximumCapturedDiagnosticBytes - output.size();
+  output.append(rendered.data(), std::min(rendered.size(), remaining));
+  if (output.size() < kMaximumCapturedDiagnosticBytes) output.push_back('\n');
+}
+
+}  // namespace
+
+std::optional<BuiltTypedTensorIrModule> BuildTypedTensorIrModule(
+    const TypedTensorIrModuleSpec& spec, std::string& diagnostic) {
+  if (spec.kind != TypedTensorIrModuleKind::NativeGdnRecurrent) {
+    diagnostic = "typed TensorIR module kind is unsupported";
+    return std::nullopt;
+  }
+  if (!ValidateNativeGdnRecurrentSpec(spec.native_gdn_recurrent,
+                                      diagnostic)) {
+    return std::nullopt;
+  }
+
+  mlir::DialectRegistry registry;
+  tir::registerDialects(registry);
+  auto context = std::make_unique<mlir::MLIRContext>(registry);
+  context->loadAllAvailableDialects();
+  auto diagnostic_handler = std::make_unique<mlir::ScopedDiagnosticHandler>(
+      context.get(), [&](mlir::Diagnostic& value) {
+        AppendDiagnostic(diagnostic, value);
+      });
+  mlir::OpBuilder builder(context.get());
+  const mlir::Location location = builder.getUnknownLoc();
+  auto module = mlir::ModuleOp::create(location);
+  builder.setInsertionPointToStart(module.getBody());
+
+  const NativeGdnRecurrentTensorIrSpec& gdn = spec.native_gdn_recurrent;
+  llvm::SmallVector<mlir::Type> input_types;
+  input_types.reserve(gdn.inputs.size());
+  const auto element_type = [&](TypedTensorIrElementType type) -> mlir::Type {
+    if (type == TypedTensorIrElementType::BF16) return builder.getBF16Type();
+    if (type == TypedTensorIrElementType::FP32) return builder.getF32Type();
+    if (type == TypedTensorIrElementType::INT32) {
+      return builder.getIntegerType(32, mlir::IntegerType::Signed);
+    }
+    return builder.getIntegerType(64, mlir::IntegerType::Signed);
+  };
+  for (const TypedTensorIrTensorSpec& input : gdn.inputs) {
+    input_types.push_back(mlir::RankedTensorType::get(
+        input.shape, element_type(input.element_type)));
+  }
+  const mlir::Type result_type = mlir::RankedTensorType::get(
+      gdn.result.shape, element_type(gdn.result.element_type));
+  const mlir::FunctionType function_type =
+      builder.getFunctionType(input_types, {result_type});
+  auto graph = tir::GraphOp::create(
+      builder, location, kEntryName, function_type, /*arg_attrs=*/nullptr,
+      /*res_attrs=*/nullptr);
+  for (size_t index = 0; index < gdn.inputs.size(); ++index) {
+    graph.setArgAttr(index, tir::TensorIRDialect::getStrideAttrName(),
+                     MakeStrideAttribute(builder, gdn.inputs[index].strides));
+  }
+  graph.setResultAttr(0, tir::TensorIRDialect::getStrideAttrName(),
+                      MakeStrideAttribute(builder, gdn.result.strides));
+  mlir::Block* entry = graph.addEntryBlock();
+  builder.setInsertionPointToStart(entry);
+  NativeGdnRecurrentBuilder gdn_builder(builder, location, gdn);
+  const mlir::Value result = gdn_builder.Build(*entry);
+  (void)tir::ResultsOp::create(builder, location, mlir::ValueRange{result});
+
+  if (mlir::failed(mlir::verify(module))) {
+    if (diagnostic.empty()) {
+      diagnostic = "typed TensorIR module verification failed";
+    }
+    return std::nullopt;
+  }
+  std::string canonical_text;
+  llvm::raw_string_ostream stream(canonical_text);
+  module.print(stream);
+  stream << '\n';
+  stream.flush();
+  if (canonical_text.empty() ||
+      canonical_text.size() > kMaximumCanonicalSourceBytes ||
+      canonical_text.find('\0') != std::string::npos) {
+    diagnostic = "typed TensorIR canonical print is empty or exceeds 16 MiB";
+    return std::nullopt;
+  }
+  const auto* begin =
+      reinterpret_cast<const uint8_t*>(canonical_text.data());
+  std::vector<uint8_t> canonical_source(begin, begin + canonical_text.size());
+  return BuiltTypedTensorIrModule{std::move(context), std::move(module),
+                                  std::move(diagnostic_handler),
+                                  std::move(canonical_source)};
+}
+
+}  // namespace pypto::compiler::detail
