+/** Tensor element types allowed across the private typed-TensorIR seam. */
+enum class TypedTensorIrElementType : uint8_t {
+  BF16 = 0,
+  FP32 = 1,
+  INT32 = 2,
+  INT64 = 3,
+};
+
+/** Compiler-neutral description of one static TensorIR graph value. */
+struct TypedTensorIrTensorSpec {
+  TypedTensorIrElementType element_type = TypedTensorIrElementType::BF16;
+  std::vector<int64_t> shape;
+  std::vector<int64_t> strides;
+  bool has_explicit_strides = false;
+};
+
+/** Bounded semantic inputs for the native stateful GDN TensorIR builder. */
+struct NativeGdnRecurrentTensorIrSpec {
+  static constexpr std::size_t kInputCount = 7;
+
+  std::array<TypedTensorIrTensorSpec, kInputCount> inputs;
+  TypedTensorIrTensorSpec result;
+  int64_t batch_size = 0;
+  int64_t tokens_per_request = 0;
+  int64_t query_heads = 0;
+  int64_t value_heads = 0;
+  int64_t key_dim = 0;
+  int64_t value_dim = 0;
+  int64_t state_slots = 0;
+  double scale = 0.0;
+};
+
+/** Typed TensorIR builders available through the private NVIDIA bridge. */
+enum class TypedTensorIrModuleKind : uint8_t {
+  NativeGdnRecurrent = 0,
+};
+
+/** One compiler-neutral request for typed MLIR/TensorIR construction. */
+struct TypedTensorIrModuleSpec {
+  TypedTensorIrModuleKind kind = TypedTensorIrModuleKind::NativeGdnRecurrent;
+  NativeGdnRecurrentTensorIrSpec native_gdn_recurrent;
+};
+
+}  // namespace pypto::codegen::nvidia
