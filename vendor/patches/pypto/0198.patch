+                         std::vector<int64_t> shape,
+                         std::vector<int64_t> strides) {
+    return TypedTensorIrTensorSpec{element_type, std::move(shape),
+                                   std::move(strides), true};
+  };
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativeGdnRecurrent;
+  NativeGdnRecurrentTensorIrSpec& spec = module_spec.native_gdn_recurrent;
+  spec.batch_size = 1;
+  spec.tokens_per_request = 1;
+  spec.query_heads = 16;
+  spec.value_heads = 16;
+  spec.key_dim = 128;
+  spec.value_dim = 128;
+  spec.state_slots = 4;
+  spec.scale = 1.0 / std::sqrt(128.0);
+  spec.inputs = {
+      tensor(TypedTensorIrElementType::BF16, {1, 1, 6144}, {6144, 6144, 1}),
+      tensor(TypedTensorIrElementType::BF16, {1, 1, 16, 128},
+             {16, 16, 1, 0}),
+      tensor(TypedTensorIrElementType::BF16, {1, 1, 16, 128},
+             {16, 16, 1, 0}),
+      tensor(TypedTensorIrElementType::FP32, {16, 128}, {1, 0}),
+      tensor(TypedTensorIrElementType::BF16, {16, 128}, {1, 0}),
+      tensor(TypedTensorIrElementType::FP32, {4, 262144}, {262144, 1}),
+      tensor(TypedTensorIrElementType::INT32, {1, 1}, {1, 1}),
+  };
+  spec.result = tensor(TypedTensorIrElementType::BF16, {1, 1, 16, 128},
+                       {2048, 2048, 128, 1});
+
+  std::string first_diagnostic;
+  auto first = BuildTypedTensorIrModule(module_spec, first_diagnostic);
+  REQUIRE(first.has_value());
+  REQUIRE(first_diagnostic.empty());
+  REQUIRE(first->module);
+  REQUIRE(!first->canonical_source.empty());
+  const std::string first_source(first->canonical_source.begin(),
+                                 first->canonical_source.end());
+  REQUIRE(first_source.find("nv_tensor_ir.graph @pypto_fused_pointwise") !=
+          std::string::npos);
+  REQUIRE(first_source.find("scatter_rows") != std::string::npos);
+  REQUIRE(first_source.find("convert") != std::string::npos);
+
+  std::string second_diagnostic;
+  auto second = BuildTypedTensorIrModule(module_spec, second_diagnostic);
+  REQUIRE(second.has_value());
+  REQUIRE(second_diagnostic.empty());
+  REQUIRE(first->canonical_source == second->canonical_source);
+
+  const CompileRequest request = MakeRequest();
+  const CanonicalSchedule schedule =
