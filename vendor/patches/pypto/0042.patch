+from .compiler import Artifact, CompileRequest
+
+class NvidiaExecutableState(Enum):
+    """Host-side lifecycle of one NVIDIA executable."""
+
+    Unloaded = ...
+    Prewarming = ...
+    Ready = ...
+    Failed = ...
+    Unloading = ...
+
+class NvidiaLaunchArgumentKind(Enum):
+    """Category of one framework-neutral launch operand."""
+
+    Tensor = ...
+    Scalar = ...
+
+class NvidiaLaunchArgument:
+    """Immutable framework-neutral tensor address or by-value scalar operand."""
+
+    @staticmethod
+    def tensor(data_address: int, shape: list[int], strides: list[int]) -> NvidiaLaunchArgument: ...
+    @staticmethod
+    def scalar(value_bytes: bytes) -> NvidiaLaunchArgument: ...
+    @property
+    def kind(self) -> NvidiaLaunchArgumentKind: ...
+    @property
+    def data_address(self) -> int: ...
+    @property
+    def shape(self) -> list[int]: ...
+    @property
+    def strides(self) -> list[int]: ...
+    @property
+    def scalar_bytes(self) -> bytes: ...
+
+class NvidiaLaunchPacket:
+    """Move-only immutable packet with stable preallocated CUDA launch storage."""
+
+    @property
+    def grid_dimensions(self) -> list[int]: ...
+    @property
+    def kernel_argument_count(self) -> int: ...
+
+class NvidiaCudaGraphLease:
+    """Move-only lifetime lease retained by an instantiated CUDA Graph owner."""
+
+    def release(self) -> None: ...
+    @property
+    def released(self) -> bool: ...
+
+class NvidiaExecutable:
+    """Process, device, and CUDA-context-bound executable reconstructed from Artifact v1."""
+
+    def __init__(self, artifact: Artifact, request: CompileRequest) -> None: ...
+    def prewarm(self, active_cuda_runtime_api_version: int) -> None: ...
+    def prepare_launch(self, arguments: list[NvidiaLaunchArgument]) -> NvidiaLaunchPacket: ...
+    def launch(self, packet: NvidiaLaunchPacket, raw_current_stream: int) -> None: ...
+    def acquire_cuda_graph_lease(self) -> NvidiaCudaGraphLease: ...
+    def unload(self) -> None: ...
+    @property
+    def state(self) -> NvidiaExecutableState: ...
+    @property
+    def ready(self) -> bool: ...
+    @property
+    def failure_message(self) -> str: ...
+    @property
+    def artifact_identity_digest(self) -> str: ...
+    @property
+    def loader_compatibility_digest(self) -> str: ...
+    @property
+    def device_ordinal(self) -> int: ...
+    @property
+    def bound_context_address(self) -> int: ...
