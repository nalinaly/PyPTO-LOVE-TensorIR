+int TestSuccessfulPrewarmAndConcurrentLaunch(const ArtifactSet& artifacts) {
+  auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  driver->device_properties.uuid =
+      "GPU-01234567-89AB-CDEF-0123-456789ABCDEF";
+  driver->device_properties.pci_device_id = "00000000:01:00.0";
+  auto executable =
+      MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+
+  std::atomic<int> prewarm_failures{0};
+  std::vector<std::thread> prewarm_threads;
+  for (size_t index = 0; index < 8; ++index) {
+    prewarm_threads.emplace_back([&]() {
+      try {
+        executable->Prewarm(kRuntimeApiVersion);
+      } catch (...) {
+        ++prewarm_failures;
+      }
+    });
+  }
+  for (std::thread& thread : prewarm_threads) thread.join();
+  REQUIRE(prewarm_failures == 0);
+
+  const std::vector<std::string> expected_calls = {
+      "Initialize",
+      "GetDriverApiVersion",
+      "GetCurrentContext",
+      "GetCurrentContextBinding",
+      "GetContextId",
+      "GetContextDeviceOrdinal",
+      "GetDeviceProperties",
+      "LoadModule",
+      "GetFunction",
+      "ForceFunctionLoad",
+      "IsFunctionLoaded",
+      "GetFunctionParameterInfo:0",
+      "GetFunctionParameterInfo:1",
+      "GetFunctionParameterInfo:2",
+      "GetFunctionParameterInfo:3",
+      "GetFunctionProperties",
+      "GetActiveBlocksPerMultiprocessor",
+  };
+  REQUIRE(driver->GetCalls() == expected_calls);
+  REQUIRE(driver->loaded_cubin == artifacts.static_artifact.GetDeviceCode());
+  REQUIRE(driver->last_context_id_query == kContextAddress);
+  REQUIRE(driver->last_context_device_query == kContextAddress);
+  REQUIRE(driver->last_device_properties_query == 0);
+  REQUIRE(driver->function_lookup_module == kModuleAddress);
+  REQUIRE(driver->function_lookup_entry == "add_op_simple");
+  REQUIRE(driver->forced_function_address == kFunctionAddress);
+  REQUIRE(driver->loaded_function_query == kFunctionAddress);
+  REQUIRE(driver->parameter_function_queries ==
+          std::vector<uintptr_t>({kFunctionAddress, kFunctionAddress,
+                                  kFunctionAddress, kFunctionAddress}));
+  REQUIRE(driver->function_properties_query == kFunctionAddress);
+  REQUIRE(driver->occupancy_function_query == kFunctionAddress);
+  REQUIRE(driver->occupancy_block_threads == 1);
+  REQUIRE(driver->occupancy_dynamic_shared_memory_bytes == 0);
+  REQUIRE(executable->GetState() == NvidiaExecutableState::Ready);
+  REQUIRE(executable->IsReady());
+  REQUIRE(executable->GetBoundContextAddress() == kContextAddress);
+  REQUIRE(executable->GetBoundContextId() == kContextId);
+
+  executable->Prewarm(kRuntimeApiVersion);
+  REQUIRE(driver->GetCalls() == expected_calls);
+  REQUIRE(RejectsWith<RuntimeError>(
+      [&]() { executable->Prewarm(kRuntimeApiVersion + 1); },
+      "different CUDA Runtime API version"));
+  REQUIRE(executable->IsReady());
+  REQUIRE(driver->GetCalls() == expected_calls);
+
+  {
+    NvidiaLaunchPacket packet = executable->PrepareLaunch(MakeStaticArguments());
+    REQUIRE(packet.GetGridDimensions() == std::vector<uint32_t>({4, 1, 1}));
+    REQUIRE(packet.GetKernelArgumentCount() == 3);
+    executable->Launch(packet, kStreamAddress);
+
+    std::vector<LaunchRecord> launches = driver->GetLaunches();
+    REQUIRE(launches.size() == 1);
+    REQUIRE(launches[0].function_address == kFunctionAddress);
+    REQUIRE((launches[0].config.grid_dimensions ==
+             std::array<uint32_t, 3>{4, 1, 1}));
+    REQUIRE((launches[0].config.block_dimensions ==
+             std::array<uint32_t, 3>{1, 1, 1}));
+    REQUIRE(launches[0].config.dynamic_shared_memory_bytes == 0);
+    REQUIRE(launches[0].config.stream_address == kStreamAddress);
+    REQUIRE(launches[0].config.cluster_scheduling_policy ==
+            ArtifactClusterSchedulingPolicy::Spread);
+    REQUIRE(launches[0].parameter_bytes.size() == 3);
+    REQUIRE(ReadUint64(launches[0].parameter_bytes[0]) == 0x1000U);
+    REQUIRE(ReadUint64(launches[0].parameter_bytes[1]) == 0x2000U);
+    REQUIRE(ReadUint64(launches[0].parameter_bytes[2]) == 0x3000U);
+    REQUIRE(driver->last_stream_query == kStreamAddress);
+
+    std::atomic<int> launch_failures{0};
+    std::vector<std::thread> launch_threads;
+    for (size_t index = 0; index < 8; ++index) {
+      launch_threads.emplace_back([&]() {
+        try {
+          executable->Launch(packet, kStreamAddress);
+        } catch (...) {
+          ++launch_failures;
+        }
+      });
+    }
+    for (std::thread& thread : launch_threads) thread.join();
+    REQUIRE(launch_failures == 0);
+    launches = driver->GetLaunches();
+    REQUIRE(launches.size() == 9);
+    for (const LaunchRecord& launch : launches) {
+      REQUIRE(launch.parameter_addresses == launches[0].parameter_addresses);
+      REQUIRE(launch.parameter_bytes == launches[0].parameter_bytes);
+      REQUIRE(launch.config.stream_address == kStreamAddress);
+    }
+  }
+
+  executable->Unload();
+  REQUIRE(executable->GetState() == NvidiaExecutableState::Unloaded);
+  REQUIRE(driver->unloaded_modules == std::vector<uintptr_t>({kModuleAddress}));
+  return 0;
+}
