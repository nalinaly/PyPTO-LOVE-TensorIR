+int TestFailureLatchAndPrewarmValidation(const ArtifactSet& artifacts) {
+  {
+    auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    std::string failure;
+    REQUIRE(RejectsWith<RuntimeError>(
+        [&]() { executable->Prewarm(kRuntimeApiVersion - 1); },
+        "Runtime API version is below", &failure));
+    REQUIRE(executable->GetState() == NvidiaExecutableState::Failed);
+    REQUIRE(executable->GetFailureMessage() == failure);
+    REQUIRE(driver->GetCalls().empty());
+    std::string repeated;
+    REQUIRE(RejectsWith<RuntimeError>(
+        [&]() { executable->Prewarm(kRuntimeApiVersion); },
+        "Runtime API version is below", &repeated));
+    REQUIRE(repeated == failure);
+    REQUIRE(driver->GetCalls().empty());
+  }
+
+  int result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) {
+        driver.driver_api_version = Artifact::kMinimumCudaDriverApiVersion - 1;
+      },
+      "Driver API version is below", 0);
+  if (result != 0) return result;
+  result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) { driver.function_loaded = false; },
+      "remained lazy", 1);
+  if (result != 0) return result;
+  result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) { driver.current_context_address = 0; },
+      "non-null current CUDA context", 0);
+  if (result != 0) return result;
+  result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) {
+        driver.current_green_context_address = kContextAddress + 2;
+      },
+      "current CUDA green context", 0);
+  if (result != 0) return result;
+  result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) { driver.context_device_ordinal = 1; },
+      "context device differs", 0);
+  if (result != 0) return result;
+  result = ExpectLatchedPrewarmFailure(
+      artifacts,
+      [](FakeDriver& driver) { driver.device_properties.name = "Other GPU"; },
+      "device_name", 0);
+  if (result != 0) return result;
+  return 0;
+}
