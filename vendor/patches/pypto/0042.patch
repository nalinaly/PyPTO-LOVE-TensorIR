+
+nb::bytes ToPythonBytes(const std::vector<uint8_t>& data) {
+  if (data.empty()) return nb::bytes("", 0);
+  return nb::bytes(reinterpret_cast<const char*>(data.data()), data.size());
+}
+
+std::vector<uint8_t> FromPythonBytes(const nb::bytes& data) {
+  if (data.size() == 0) return {};
+  const auto* begin = static_cast<const uint8_t*>(data.data());
+  return std::vector<uint8_t>(begin, begin + data.size());
+}
+
+}  // namespace
+
+void BindNvidiaRuntime(nb::module_& m) {
+  using runtime::nvidia::NvidiaCudaGraphLease;
+  using runtime::nvidia::NvidiaExecutable;
+  using runtime::nvidia::NvidiaExecutableState;
+  using runtime::nvidia::NvidiaLaunchArgument;
+  using runtime::nvidia::NvidiaLaunchArgumentKind;
+  using runtime::nvidia::NvidiaLaunchPacket;
+
+  nb::module_ runtime_mod =
+      m.def_submodule("nvidia_runtime", "PyPTO process/context-owned NVIDIA executable runtime");
+
+  nb::enum_<NvidiaExecutableState>(runtime_mod, "NvidiaExecutableState",
+                                   "Host-side lifecycle of one NVIDIA executable")
+      .value("Unloaded", NvidiaExecutableState::Unloaded)
+      .value("Prewarming", NvidiaExecutableState::Prewarming)
+      .value("Ready", NvidiaExecutableState::Ready)
+      .value("Failed", NvidiaExecutableState::Failed)
+      .value("Unloading", NvidiaExecutableState::Unloading);
+
+  nb::enum_<NvidiaLaunchArgumentKind>(runtime_mod, "NvidiaLaunchArgumentKind",
+                                      "Category of one framework-neutral launch operand")
+      .value("Tensor", NvidiaLaunchArgumentKind::Tensor)
+      .value("Scalar", NvidiaLaunchArgumentKind::Scalar);
+
+  nb::class_<NvidiaLaunchArgument>(
+      runtime_mod, "NvidiaLaunchArgument",
+      "Immutable framework-neutral tensor address or by-value scalar operand")
+      .def_static("tensor", &NvidiaLaunchArgument::Tensor, nb::arg("data_address"),
+                  nb::arg("shape"), nb::arg("strides"),
+                  "Create an opaque non-null device address with element shape and strides")
+      .def_static(
+          "scalar",
+          [](const nb::bytes& value_bytes) {
+            return NvidiaLaunchArgument::Scalar(FromPythonBytes(value_bytes));
+          },
+          nb::arg("value_bytes"), "Create a scalar operand from one through eight exact value bytes")
+      .def_prop_ro("kind", &NvidiaLaunchArgument::GetKind)
+      .def_prop_ro("data_address", &NvidiaLaunchArgument::GetDataAddress)
+      .def_prop_ro("shape", &NvidiaLaunchArgument::GetShape)
+      .def_prop_ro("strides", &NvidiaLaunchArgument::GetStrides)
+      .def_prop_ro("scalar_bytes", [](const NvidiaLaunchArgument& argument) {
+        return ToPythonBytes(argument.GetScalarBytes());
+      });
+
+  nb::class_<NvidiaLaunchPacket>(
+      runtime_mod, "NvidiaLaunchPacket",
+      "Move-only immutable packet with stable preallocated CUDA launch storage")
+      .def_prop_ro("grid_dimensions", &NvidiaLaunchPacket::GetGridDimensions)
+      .def_prop_ro("kernel_argument_count", &NvidiaLaunchPacket::GetKernelArgumentCount);
+
+  nb::class_<NvidiaCudaGraphLease>(
+      runtime_mod, "NvidiaCudaGraphLease",
+      "Move-only lifetime lease retained by an instantiated CUDA Graph owner")
+      .def("release", &NvidiaCudaGraphLease::Release, "Release this graph lifetime lease")
+      .def_prop_ro("released", &NvidiaCudaGraphLease::IsReleased);
+
+  nb::class_<NvidiaExecutable>(
+      runtime_mod, "NvidiaExecutable",
+      "Process, device, and CUDA-context-bound executable reconstructed from Artifact v1")
+      .def(nb::init<compiler::Artifact, compiler::CompileRequest>(), nb::arg("artifact"),
+           nb::arg("request"), "Validate immutable inputs without calling CUDA")
+      .def("prewarm", &NvidiaExecutable::Prewarm,
+           nb::arg("active_cuda_runtime_api_version"),
+           nb::call_guard<nb::gil_scoped_release>(),
+           "Load and validate in the caller's current CUDA context")
+      .def("prepare_launch", &NvidiaExecutable::PrepareLaunch, nb::arg("arguments"),
+           "Validate operands and allocate one immutable launch packet outside capture")
+      .def("launch", &NvidiaExecutable::Launch, nb::arg("packet"),
+           nb::arg("raw_current_stream"), nb::call_guard<nb::gil_scoped_release>(),
+           "Enqueue on a non-null, non-legacy, non-PTDS caller-owned raw CUstream")
+      .def("acquire_cuda_graph_lease", &NvidiaExecutable::AcquireCudaGraphLease,
+           nb::call_guard<nb::gil_scoped_release>(),
+           "Acquire a module lifetime lease for an instantiated CUDA Graph owner")
+      .def("unload", &NvidiaExecutable::Unload, nb::call_guard<nb::gil_scoped_release>(),
+           "Explicitly and terminally unload after every execution lease is gone")
+      .def_prop_ro("state", &NvidiaExecutable::GetState)
+      .def_prop_ro("ready", &NvidiaExecutable::IsReady)
+      .def_prop_ro("failure_message", &NvidiaExecutable::GetFailureMessage)
+      .def_prop_ro("artifact_identity_digest", &NvidiaExecutable::GetArtifactIdentityDigest)
+      .def_prop_ro("loader_compatibility_digest",
+                   &NvidiaExecutable::GetLoaderCompatibilityDigest)
+      .def_prop_ro("device_ordinal", &NvidiaExecutable::GetDeviceOrdinal)
+      .def_prop_ro("bound_context_address", &NvidiaExecutable::GetBoundContextAddress)
+      .def_prop_ro("bound_context_id", &NvidiaExecutable::GetBoundContextId);
+}
+
+}  // namespace pypto::python
