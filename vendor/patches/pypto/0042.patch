+NvidiaLaunchArgument NvidiaLaunchArgument::Tensor(
+    uintptr_t data_address, std::vector<int64_t> shape,
+    std::vector<int64_t> strides) {
+  if (data_address == 0) throw ValueError("NVIDIA tensor data address must be non-null");
+  if (shape.size() != strides.size() || shape.size() > compiler::Artifact::kMaximumRank) {
+    throw ValueError("NVIDIA tensor shape/stride rank is invalid");
+  }
+  return NvidiaLaunchArgument(NvidiaLaunchArgumentKind::Tensor, data_address,
+                              std::move(shape), std::move(strides), {});
+}
