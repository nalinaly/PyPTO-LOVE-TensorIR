+int TestDeterministicLifecycleRaces(const ArtifactSet& artifacts) {
+  {
+    auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+    driver->block_get_function = true;
+    driver->get_function_failure = true;
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    std::array<std::string, 8> failures;
+    std::array<bool, 8> rejected{};
+    std::vector<std::thread> threads;
+    for (size_t index = 0; index < failures.size(); ++index) {
+      threads.emplace_back([&, index]() {
+        rejected[index] = RejectsWith<RuntimeError>(
+            [&]() { executable->Prewarm(kRuntimeApiVersion); },
+            "fake get function failure", &failures[index]);
+      });
+    }
+    const bool function_entered = driver->WaitForGetFunction();
+    const bool concurrent_waiter =
+        function_entered && WaitForLifecycleWaiters(*executable, 1);
+    driver->ReleaseGetFunction();
+    for (std::thread& thread : threads) thread.join();
+    REQUIRE(function_entered);
+    REQUIRE(concurrent_waiter);
+    REQUIRE(!failures[0].empty());
+    for (size_t index = 0; index < failures.size(); ++index) {
+      REQUIRE(rejected[index]);
+      REQUIRE(failures[index] == failures[0]);
+    }
+    REQUIRE(driver->CountCalls("LoadModule") == 1);
+    REQUIRE(driver->CountCalls("GetFunction") == 1);
+    REQUIRE(driver->CountCalls("UnloadModule") == 1);
+    REQUIRE(executable->GetState() == NvidiaExecutableState::Failed);
+  }
+
+  {
+    auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+    driver->block_get_function = true;
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    std::atomic<bool> prewarm_failed{false};
+    std::thread prewarm([&]() {
+      try {
+        executable->Prewarm(kRuntimeApiVersion);
+      } catch (...) {
+        prewarm_failed.store(true, std::memory_order_relaxed);
+      }
+    });
+    const bool function_entered = driver->WaitForGetFunction();
+    std::atomic<bool> unload_finished{false};
+    std::atomic<bool> unload_failed{false};
+    std::thread unload([&]() {
+      try {
+        executable->Unload();
+        unload_finished.store(true, std::memory_order_release);
+      } catch (...) {
+        unload_failed.store(true, std::memory_order_release);
+      }
+    });
+    const bool unload_waiting = WaitForLifecycleWaiters(*executable, 1);
+    const size_t unload_calls_while_prewarming =
+        driver->CountCalls("UnloadModule");
+    driver->ReleaseGetFunction();
+    prewarm.join();
+    unload.join();
+    REQUIRE(function_entered);
+    REQUIRE(unload_waiting);
+    REQUIRE(unload_calls_while_prewarming == 0);
+    REQUIRE(!prewarm_failed.load(std::memory_order_relaxed));
+    REQUIRE(!unload_failed.load(std::memory_order_acquire));
+    REQUIRE(unload_finished.load(std::memory_order_acquire));
+    REQUIRE(driver->CountCalls("UnloadModule") == 1);
+    REQUIRE(executable->GetState() == NvidiaExecutableState::Unloaded);
+  }
+
+  {
+    auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    executable->Prewarm(kRuntimeApiVersion);
+    std::optional<NvidiaLaunchPacket> packet;
+    packet.emplace(executable->PrepareLaunch(MakeStaticArguments()));
+    driver->block_launch = true;
+    std::atomic<bool> launch_failed{false};
+    std::thread launch([&]() {
+      try {
+        executable->Launch(*packet, kStreamAddress);
+      } catch (...) {
+        launch_failed.store(true, std::memory_order_relaxed);
+      }
+    });
+    const bool launch_entered = driver->WaitForLaunch();
+    const bool unload_rejected = RejectsWith<RuntimeError>(
+        [&]() { executable->Unload(); }, "live launch/packet/graph leases");
+    const size_t unload_calls_during_launch =
+        driver->CountCalls("UnloadModule");
+    driver->ReleaseLaunch();
+    launch.join();
+    REQUIRE(launch_entered);
+    REQUIRE(unload_rejected);
+    REQUIRE(unload_calls_during_launch == 0);
+    REQUIRE(!launch_failed.load(std::memory_order_relaxed));
+    packet.reset();
+    executable->Unload();
+    REQUIRE(driver->CountCalls("UnloadModule") == 1);
+  }
+
+  {
+    auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    executable->Prewarm(kRuntimeApiVersion);
+    driver->block_unload = true;
+    std::atomic<int> unload_failures{0};
+    auto unload = [&]() {
+      try {
+        executable->Unload();
+      } catch (...) {
+        unload_failures.fetch_add(1, std::memory_order_relaxed);
+      }
+    };
+    std::thread first(unload);
+    const bool unload_entered = driver->WaitForUnload();
+    std::thread second(unload);
+    const bool second_waiting = WaitForLifecycleWaiters(*executable, 1);
+    const size_t concurrent_unload_calls = driver->CountCalls("UnloadModule");
+    driver->ReleaseUnload();
+    first.join();
+    second.join();
+    REQUIRE(unload_entered);
+    REQUIRE(second_waiting);
+    REQUIRE(concurrent_unload_calls == 1);
+    REQUIRE(unload_failures.load(std::memory_order_relaxed) == 0);
+    REQUIRE(driver->CountCalls("UnloadModule") == 1);
+    REQUIRE(executable->GetState() == NvidiaExecutableState::Unloaded);
+  }
+  return 0;
+}
+
+#if defined(__linux__)
+bool WaitForOwnedChild(pid_t child, int* exit_code) {
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  int status = 0;
+  while (std::chrono::steady_clock::now() < deadline) {
+    const pid_t waited = ::waitpid(child, &status, WNOHANG);
+    if (waited == child) {
+      if (!WIFEXITED(status)) return false;
+      *exit_code = WEXITSTATUS(status);
+      return true;
+    }
+    if (waited == -1) {
+      if (errno == EINTR) continue;
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  (void)::kill(child, SIGKILL);
+  while (::waitpid(child, &status, 0) == -1 && errno == EINTR) {
+  }
+  return false;
+}
+#endif
+
+int TestForkRejection(const ArtifactSet& artifacts) {
+#if defined(__linux__)
+  auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  auto executable =
+      MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+  const pid_t child = ::fork();
+  REQUIRE(child >= 0);
+  if (child == 0) {
+    const bool rejected = RejectsWith<RuntimeError>(
+        [&]() { executable->Prewarm(kRuntimeApiVersion); }, "across fork");
+    executable.reset();
+    _exit(rejected ? 0 : 1);
+  }
+  int exit_code = -1;
+  REQUIRE(WaitForOwnedChild(child, &exit_code));
+  REQUIRE(exit_code == 0);
+  REQUIRE(driver->GetCalls().empty());
+  executable->Prewarm(kRuntimeApiVersion);
+  executable->Unload();
+
+  auto ready_driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  auto ready =
+      MakeExecutable(artifacts.static_artifact, artifacts.request, ready_driver);
+  ready->Prewarm(kRuntimeApiVersion);
+  std::optional<NvidiaLaunchPacket> packet;
+  packet.emplace(ready->PrepareLaunch(MakeStaticArguments()));
+  std::optional<NvidiaCudaGraphLease> lease;
+  lease.emplace(ready->AcquireCudaGraphLease());
+  const pid_t lease_child = ::fork();
+  REQUIRE(lease_child >= 0);
+  if (lease_child == 0) {
+    const bool getter_rejected = RejectsWith<RuntimeError>(
+        [&]() { (void)ready->GetState(); }, "across fork");
+    packet.reset();
+    lease->Release();
+    lease.reset();
+    ready.reset();
+    _exit(getter_rejected ? 0 : 1);
+  }
+  exit_code = -1;
+  REQUIRE(WaitForOwnedChild(lease_child, &exit_code));
+  REQUIRE(exit_code == 0);
+  packet.reset();
+  lease->Release();
+  lease.reset();
+  ready->Unload();
+#else
+  (void)artifacts;
+#endif
+  return 0;
+}
+
+}  // namespace
+
+int main() {
+  const ArtifactSet artifacts = MakeArtifactSet();
+  int result = TestConstructionDoesNotTouchDriver(artifacts);
+  if (result != 0) return result;
+  result = TestSuccessfulPrewarmAndConcurrentLaunch(artifacts);
+  if (result != 0) return result;
+  result = TestDynamicAndScalarPacking(artifacts);
+  if (result != 0) return result;
+  result = TestAllocationFreePreparedLaunch(artifacts);
+  if (result != 0) return result;
+  result = TestFailureLatchAndPrewarmValidation(artifacts);
+  if (result != 0) return result;
+  result = TestParameterAndResourceValidation(artifacts);
+  if (result != 0) return result;
+  result = TestLaunchArgumentAndLiveBindingRejections(artifacts);
+  if (result != 0) return result;
+  result = TestLeasesUnloadFailureAndTerminalUnload(artifacts);
+  if (result != 0) return result;
+  result = TestDeterministicLifecycleRaces(artifacts);
+  if (result != 0) return result;
+  return TestForkRejection(artifacts);
+}
