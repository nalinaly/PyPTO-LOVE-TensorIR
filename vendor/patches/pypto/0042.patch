+CanonicalSchedule MakeSchedule(const std::vector<uint32_t>& tile_sizes) {
+  std::vector<ScheduleParameter> tile;
+  tile.reserve(tile_sizes.size());
+  for (size_t index = 0; index < tile_sizes.size(); ++index) {
+    tile.emplace_back(TileParameterName(index),
+                      ScheduleValueKind::UnsignedInteger,
+                      std::to_string(tile_sizes[index]));
+  }
+  return CanonicalSchedule(
+      {ScheduleParameter("codegen_strategy", ScheduleValueKind::Text,
+                         "layout-propagation")},
+      std::move(tile), {}, {},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "1")},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "4")},
+      {},
+      {ScheduleParameter("bytecode_major", ScheduleValueKind::UnsignedInteger,
+                         "13"),
+       ScheduleParameter("bytecode_minor", ScheduleValueKind::UnsignedInteger,
+                         "3"),
+       ScheduleParameter("bytecode_tag", ScheduleValueKind::UnsignedInteger,
