+ private:
+  enum class State : uint8_t {
+    Uninitialized = 0,
+    Ready = 1,
+    Failed = 2,
+  };
+
+  void RequireOwnerProcess() const {
+    if (CurrentProcessId() != owner_pid_) {
+      throw RuntimeError(
+          "private NVIDIA CUDA Driver state cannot be inherited across fork");
+    }
+  }
+
+  void RequireCallable() const {
+    RequireOwnerProcess();
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (state_ == State::Ready) return;
+    if (state_ == State::Failed) throw RuntimeError(failure_message_);
+    throw RuntimeError(
+        "private NVIDIA CUDA Driver API must be initialized before use");
+  }
+
+  [[nodiscard]] std::string DescribeCudaError(CUresult result,
+                                              const char* operation) const {
+    std::ostringstream message;
+    message << operation << " failed with CUDA error "
+            << static_cast<int>(result);
+
+    const char* name = nullptr;
+    if (get_error_name_ != nullptr &&
+        get_error_name_(result, &name) == CUDA_SUCCESS && name != nullptr) {
+      message << " (" << CopyBoundedCString(name) << ')';
+    }
+    const char* description = nullptr;
+    if (get_error_string_ != nullptr &&
+        get_error_string_(result, &description) == CUDA_SUCCESS &&
+        description != nullptr) {
+      message << ": " << CopyBoundedCString(description);
+    }
+    return BoundText(message.str());
+  }
+
+  void CheckCuda(CUresult result, const char* operation) const {
+    if (result != CUDA_SUCCESS) {
+      throw RuntimeError(DescribeCudaError(result, operation));
+    }
+  }
+
+  template <typename Function>
+  void ResolveLocked(Function& function, const char* symbol,
+                     int api_version) {
+    void* address = nullptr;
+    CUdriverProcAddressQueryResult query_result =
+        CU_GET_PROC_ADDRESS_SYMBOL_NOT_FOUND;
+    const CUresult result = get_proc_address_(
+        symbol, &address, api_version,
+        static_cast<cuuint64_t>(CU_GET_PROC_ADDRESS_LEGACY_STREAM),
+        &query_result);
+    if (result != CUDA_SUCCESS) {
+      throw RuntimeError(DescribeCudaError(result, "cuGetProcAddress_v2"));
+    }
+    if (address == nullptr || query_result != CU_GET_PROC_ADDRESS_SUCCESS) {
+      std::ostringstream message;
+      message << "cuGetProcAddress_v2 could not resolve required symbol "
+              << symbol << " at CUDA API version " << api_version
+              << " with legacy-stream semantics (query status "
+              << static_cast<int>(query_result) << ')';
+      throw RuntimeError(BoundText(message.str()));
+    }
+    function = FunctionFromAddress<Function>(address);
+  }
+
+  void OpenAndResolveLocked() {
+    library_ = ::dlopen(kCudaDriverSoname, RTLD_NOW | RTLD_LOCAL);
+    if (library_ == nullptr) {
+      throw RuntimeError(BoundText(
+          std::string("dlopen(libcuda.so.1) failed: ") +
+          CopyBoundedCString(::dlerror())));
+    }
+
+    (void)::dlerror();
+    void* bootstrap_address = ::dlsym(library_, "cuGetProcAddress_v2");
+    const char* bootstrap_error = ::dlerror();
+    if (bootstrap_error != nullptr || bootstrap_address == nullptr) {
+      throw RuntimeError(BoundText(
+          std::string("dlsym(cuGetProcAddress_v2) failed: ") +
+          CopyBoundedCString(bootstrap_error)));
+    }
+    get_proc_address_ =
+        FunctionFromAddress<PFN_cuGetProcAddress_v12000>(bootstrap_address);
+
+    ResolveLocked(get_error_name_, "cuGetErrorName", 6000);
+    ResolveLocked(get_error_string_, "cuGetErrorString", 6000);
+    ResolveLocked(init_, "cuInit", 2000);
+    ResolveLocked(driver_get_version_, "cuDriverGetVersion", 2020);
+
+    CheckCuda(init_(0), "cuInit");
+    int driver_api_version = 0;
+    CheckCuda(driver_get_version_(&driver_api_version),
+              "cuDriverGetVersion");
+    if (driver_api_version < kRequiredDriverApiVersion) {
+      throw RuntimeError(
+          "CUDA Driver API version is below the private runtime minimum 13000");
+    }
+    driver_api_version_ = static_cast<uint32_t>(driver_api_version);
+
+    ResolveLocked(device_get_, "cuDeviceGet", 2000);
+    ResolveLocked(device_get_name_, "cuDeviceGetName", 2000);
+    ResolveLocked(device_get_uuid_, "cuDeviceGetUuid", 11040);
+    ResolveLocked(device_total_memory_, "cuDeviceTotalMem", 3020);
+    ResolveLocked(device_get_attribute_, "cuDeviceGetAttribute", 2000);
+    ResolveLocked(device_get_pci_bus_id_, "cuDeviceGetPCIBusId", 4010);
+    ResolveLocked(ctx_get_current_, "cuCtxGetCurrent", 4000);
+    ResolveLocked(ctx_get_id_, "cuCtxGetId", 12000);
+    ResolveLocked(ctx_get_device_, "cuCtxGetDevice", 13000);
+    ResolveLocked(module_load_data_, "cuModuleLoadData", 2000);
+    ResolveLocked(module_unload_, "cuModuleUnload", 2000);
+    ResolveLocked(module_get_function_, "cuModuleGetFunction", 2000);
+    ResolveLocked(func_get_attribute_, "cuFuncGetAttribute", 2020);
+    ResolveLocked(func_get_param_info_, "cuFuncGetParamInfo", 12040);
+    ResolveLocked(func_is_loaded_, "cuFuncIsLoaded", 12040);
+    ResolveLocked(func_load_, "cuFuncLoad", 12040);
+    ResolveLocked(occupancy_max_active_blocks_,
+                  "cuOccupancyMaxActiveBlocksPerMultiprocessor", 6050);
+    ResolveLocked(stream_get_ctx_, "cuStreamGetCtx", 12050);
+    ResolveLocked(launch_kernel_ex_, "cuLaunchKernelEx", 11060);
+  }
+
+  void CloseLibraryLocked() noexcept {
+    if (library_ != nullptr) {
+      (void)::dlclose(library_);
+      library_ = nullptr;
+    }
+  }
+
+  void CheckFunctionAddress(uintptr_t function_address) const {
+    if (function_address == 0) {
+      throw ValueError("CUDA function address must be non-null");
+    }
+  }
+
+  [[nodiscard]] int DeviceAttribute(CUdevice device,
+                                    CUdevice_attribute attribute) const {
+    int value = 0;
+    CheckCuda(device_get_attribute_(&value, attribute, device),
+              "cuDeviceGetAttribute");
+    return value;
+  }
+
+  [[nodiscard]] int FunctionAttribute(
+      CUfunction function, CUfunction_attribute attribute) const {
+    int value = 0;
+    CheckCuda(func_get_attribute_(&value, attribute, function),
+              "cuFuncGetAttribute");
+    return value;
+  }
+
+  const int64_t owner_pid_;
+  mutable std::mutex mutex_;
+  State state_ = State::Uninitialized;
+  std::string failure_message_;
+  void* library_ = nullptr;
+  uint32_t driver_api_version_ = 0;
+
+  PFN_cuGetProcAddress_v12000 get_proc_address_ = nullptr;
+  PFN_cuGetErrorName_v6000 get_error_name_ = nullptr;
+  PFN_cuGetErrorString_v6000 get_error_string_ = nullptr;
+  PFN_cuInit_v2000 init_ = nullptr;
+  PFN_cuDriverGetVersion_v2020 driver_get_version_ = nullptr;
+  PFN_cuDeviceGet_v2000 device_get_ = nullptr;
+  PFN_cuDeviceGetName_v2000 device_get_name_ = nullptr;
+  PFN_cuDeviceGetUuid_v11040 device_get_uuid_ = nullptr;
+  PFN_cuDeviceTotalMem_v3020 device_total_memory_ = nullptr;
+  PFN_cuDeviceGetAttribute_v2000 device_get_attribute_ = nullptr;
+  PFN_cuDeviceGetPCIBusId_v4010 device_get_pci_bus_id_ = nullptr;
+  PFN_cuCtxGetCurrent_v4000 ctx_get_current_ = nullptr;
+  PFN_cuCtxGetId_v12000 ctx_get_id_ = nullptr;
+  PFN_cuCtxGetDevice_v13000 ctx_get_device_ = nullptr;
+  PFN_cuModuleLoadData_v2000 module_load_data_ = nullptr;
+  PFN_cuModuleUnload_v2000 module_unload_ = nullptr;
+  PFN_cuModuleGetFunction_v2000 module_get_function_ = nullptr;
+  PFN_cuFuncGetAttribute_v2020 func_get_attribute_ = nullptr;
+  PFN_cuFuncGetParamInfo_v12040 func_get_param_info_ = nullptr;
+  PFN_cuFuncIsLoaded_v12040 func_is_loaded_ = nullptr;
+  PFN_cuFuncLoad_v12040 func_load_ = nullptr;
+  PFN_cuOccupancyMaxActiveBlocksPerMultiprocessor_v6050
+      occupancy_max_active_blocks_ = nullptr;
+  PFN_cuStreamGetCtx_v12050 stream_get_ctx_ = nullptr;
+  PFN_cuLaunchKernelEx_v11060 launch_kernel_ex_ = nullptr;
+};
