+thread_local bool g_count_host_allocations = false;
+std::atomic<uint64_t> g_host_allocation_count{0};
+
+void CountAllocation() noexcept {
+  if (g_count_host_allocations) {
+    g_host_allocation_count.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void* AllocateHost(size_t size) {
+  CountAllocation();
+  if (void* pointer = std::malloc(size == 0 ? 1 : size)) return pointer;
+  throw std::bad_alloc();
+}
+
+void* AllocateAlignedHost(size_t size, size_t alignment) {
+  CountAllocation();
+  void* pointer = nullptr;
+  if (::posix_memalign(&pointer, alignment, size == 0 ? 1 : size) != 0) {
+    throw std::bad_alloc();
+  }
+  return pointer;
+}
+}  // namespace
