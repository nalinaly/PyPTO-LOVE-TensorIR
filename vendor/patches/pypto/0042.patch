+class HostAllocationCounterGuard {
+ public:
+  HostAllocationCounterGuard() {
+    g_host_allocation_count.store(0, std::memory_order_relaxed);
+    g_count_host_allocations = true;
+  }
+  ~HostAllocationCounterGuard() { g_count_host_allocations = false; }
