+#ifndef PYPTO_RUNTIME_NVIDIA_EXECUTABLE_H_
+#define PYPTO_RUNTIME_NVIDIA_EXECUTABLE_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "pypto/compiler/artifact.h"
+#include "pypto/compiler/compile_request.h"
+
+namespace pypto::runtime::nvidia {
+
+namespace detail {
+class NvidiaDriverApi;
+class NvidiaExecutableTestAccess;
+struct NvidiaExecutableSharedState;
+struct NvidiaPreparedLaunchData;
+}  // namespace detail
+
+/** Host-side lifecycle of one process/context-bound NVIDIA executable. */
+enum class NvidiaExecutableState : uint8_t {
+  Unloaded = 0,
+  Prewarming = 1,
+  Ready = 2,
+  Failed = 3,
+  Unloading = 4,
+};
+
+/** Category of one framework-neutral launch operand. */
+enum class NvidiaLaunchArgumentKind : uint8_t {
+  Tensor = 0,
+  Scalar = 1,
+};
+
+/**
+ * Framework-neutral launch operand.
+ *
+ * Tensor addresses are opaque device addresses. Shape and stride metadata are
+ * measured in elements. Scalar bytes are passed by value exactly as supplied.
+ * Artifact v1 does not encode tensor dtype, data alignment, address space or
+ * access mode, so those remain obligations of the later typed adapter.
+ */
+class NvidiaLaunchArgument {
+ public:
+  [[nodiscard]] static NvidiaLaunchArgument Tensor(
+      uintptr_t data_address, std::vector<int64_t> shape,
+      std::vector<int64_t> strides);
+  [[nodiscard]] static NvidiaLaunchArgument Scalar(std::vector<uint8_t> value_bytes);
+
+  NvidiaLaunchArgument(const NvidiaLaunchArgument&) = default;
+  NvidiaLaunchArgument(NvidiaLaunchArgument&&) = default;
+  NvidiaLaunchArgument& operator=(const NvidiaLaunchArgument&) = delete;
+  NvidiaLaunchArgument& operator=(NvidiaLaunchArgument&&) = delete;
+
+  [[nodiscard]] NvidiaLaunchArgumentKind GetKind() const noexcept { return kind_; }
+  [[nodiscard]] uintptr_t GetDataAddress() const noexcept { return data_address_; }
+  [[nodiscard]] const std::vector<int64_t>& GetShape() const noexcept { return shape_; }
+  [[nodiscard]] const std::vector<int64_t>& GetStrides() const noexcept { return strides_; }
+  [[nodiscard]] const std::vector<uint8_t>& GetScalarBytes() const noexcept {
+    return scalar_bytes_;
+  }
+
+ private:
+  NvidiaLaunchArgument(NvidiaLaunchArgumentKind kind, uintptr_t data_address,
+                       std::vector<int64_t> shape, std::vector<int64_t> strides,
+                       std::vector<uint8_t> scalar_bytes);
+
+  NvidiaLaunchArgumentKind kind_;
+  uintptr_t data_address_;
+  std::vector<int64_t> shape_;
+  std::vector<int64_t> strides_;
+  std::vector<uint8_t> scalar_bytes_;
+};
+
+/**
+ * Immutable preallocated CUDA launch packet.
+ *
+ * Construction performs every argument/grid check and allocates stable host
+ * parameter storage. Launch itself only validates the live process/context/
+ * stream and calls the driver. A packet is an execution lease and therefore
+ * prevents module unload until it is destroyed.
+ */
+class NvidiaLaunchPacket {
+ public:
+  NvidiaLaunchPacket() = delete;
+  ~NvidiaLaunchPacket();
+  NvidiaLaunchPacket(const NvidiaLaunchPacket&) = delete;
+  NvidiaLaunchPacket& operator=(const NvidiaLaunchPacket&) = delete;
+  NvidiaLaunchPacket(NvidiaLaunchPacket&& other) noexcept;
+  NvidiaLaunchPacket& operator=(NvidiaLaunchPacket&& other) noexcept;
+
+  [[nodiscard]] const std::vector<uint32_t>& GetGridDimensions() const;
+  [[nodiscard]] uint32_t GetKernelArgumentCount() const;
+
+ private:
+  friend class NvidiaExecutable;
+  NvidiaLaunchPacket(std::shared_ptr<detail::NvidiaExecutableSharedState> state,
+                     std::shared_ptr<const detail::NvidiaPreparedLaunchData> data);
+  void Release() noexcept;
+
+  std::shared_ptr<detail::NvidiaExecutableSharedState> state_;
+  std::shared_ptr<const detail::NvidiaPreparedLaunchData> data_;
+};
+
+/** Move-only lifetime lease retained by an instantiated CUDA Graph owner. */
+class NvidiaCudaGraphLease {
+ public:
+  NvidiaCudaGraphLease() = delete;
+  ~NvidiaCudaGraphLease();
+  NvidiaCudaGraphLease(const NvidiaCudaGraphLease&) = delete;
+  NvidiaCudaGraphLease& operator=(const NvidiaCudaGraphLease&) = delete;
+  NvidiaCudaGraphLease(NvidiaCudaGraphLease&& other) noexcept;
+  NvidiaCudaGraphLease& operator=(NvidiaCudaGraphLease&& other) noexcept;
+
+  void Release() noexcept;
+  [[nodiscard]] bool IsReleased() const noexcept { return state_ == nullptr; }
+
+ private:
+  friend class NvidiaExecutable;
+  explicit NvidiaCudaGraphLease(
+      std::shared_ptr<detail::NvidiaExecutableSharedState> state);
+
+  std::shared_ptr<detail::NvidiaExecutableSharedState> state_;
+};
+
+/**
+ * Process/device/CUcontext-bound executable reconstructed from Artifact v1.
+ *
+ * Construction is CUDA-free. Prewarm is once-only, validates the complete
+ * loader/runtime/device/function contract and latches failure. No stream is
+ * ever retained: every launch requires the caller's non-null raw current
+ * CUstream address.
+ */
+class NvidiaExecutable {
+ public:
+  NvidiaExecutable(compiler::Artifact artifact, compiler::CompileRequest request);
+  ~NvidiaExecutable();
+  NvidiaExecutable(const NvidiaExecutable&) = delete;
+  NvidiaExecutable& operator=(const NvidiaExecutable&) = delete;
+  NvidiaExecutable(NvidiaExecutable&&) = delete;
+  NvidiaExecutable& operator=(NvidiaExecutable&&) = delete;
+
+  /**
+   * Load and validate in the caller's current CUDA context.
+   *
+   * active_cuda_runtime_api_version must be obtained by the parent runtime
+   * integration (for example cudaRuntimeGetVersion from PyTorch's loaded
+   * runtime). The driver-only loader deliberately does not load libcudart.
+   */
+  void Prewarm(uint32_t active_cuda_runtime_api_version);
+
+  /** Validate and allocate one immutable launch packet outside capture. */
+  [[nodiscard]] NvidiaLaunchPacket PrepareLaunch(
+      std::vector<NvidiaLaunchArgument> arguments) const;
+
+  /** Enqueue on a non-null, non-legacy, non-PTDS caller-owned raw CUstream. */
+  void Launch(const NvidiaLaunchPacket& packet, uintptr_t raw_current_stream);
+
+  /** Acquire a module lifetime lease for an instantiated CUDA Graph owner. */
+  [[nodiscard]] NvidiaCudaGraphLease AcquireCudaGraphLease();
+
+  /** Explicitly unload after all packets, launches and graph leases are gone. */
+  void Unload();
+
+  [[nodiscard]] NvidiaExecutableState GetState() const;
+  [[nodiscard]] bool IsReady() const;
+  [[nodiscard]] std::string GetFailureMessage() const;
+  [[nodiscard]] std::string GetArtifactIdentityDigest() const;
+  [[nodiscard]] std::string GetLoaderCompatibilityDigest() const;
+  [[nodiscard]] int GetDeviceOrdinal() const;
+  [[nodiscard]] uintptr_t GetBoundContextAddress() const;
+  [[nodiscard]] uint64_t GetBoundContextId() const;
+
+ private:
+  friend class detail::NvidiaExecutableTestAccess;
+  NvidiaExecutable(compiler::Artifact artifact, compiler::CompileRequest request,
+                   std::shared_ptr<detail::NvidiaDriverApi> driver);
+
+  std::shared_ptr<detail::NvidiaExecutableSharedState> state_;
+};
+
+}  // namespace pypto::runtime::nvidia
+
+#endif  // PYPTO_RUNTIME_NVIDIA_EXECUTABLE_H_
