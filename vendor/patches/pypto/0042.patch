+int TestConstructionDoesNotTouchDriver(const ArtifactSet& artifacts) {
+  REQUIRE(RejectsWith<ValueError>(
+      [&]() {
+        (void)NvidiaExecutableTestAccess::Create(
+            artifacts.static_artifact, artifacts.request,
+            std::shared_ptr<NvidiaDriverApi>{});
+      },
+      "driver boundary must not be null"));
+  auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  {
+    auto executable =
+        MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+    REQUIRE(driver->GetCalls().empty());
+    REQUIRE(executable->GetState() == NvidiaExecutableState::Unloaded);
+    REQUIRE(!executable->IsReady());
+    REQUIRE(executable->GetFailureMessage().empty());
+    REQUIRE(executable->GetArtifactIdentityDigest() ==
+            artifacts.static_artifact.GetIdentityDigest());
+    REQUIRE(executable->GetLoaderCompatibilityDigest() ==
+            artifacts.static_artifact.GetLoaderCompatibilityDigest());
+    REQUIRE(executable->GetDeviceOrdinal() == 0);
+    REQUIRE(executable->GetBoundContextAddress() == 0);
+    REQUIRE(executable->GetBoundContextId() == 0);
+    REQUIRE(driver->GetCalls().empty());
+  }
+  REQUIRE(driver->GetCalls().empty());
+
+  auto terminal_driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  auto terminal = MakeExecutable(artifacts.static_artifact, artifacts.request,
+                                 terminal_driver);
+  terminal->Unload();
+  REQUIRE(terminal->GetState() == NvidiaExecutableState::Unloaded);
+  REQUIRE(RejectsWith<RuntimeError>(
+      [&]() { terminal->Prewarm(kRuntimeApiVersion); },
+      "after explicit unload"));
+  REQUIRE(terminal_driver->GetCalls().empty());
+  return 0;
+}
