+class FakeDriver final : public NvidiaDriverApi {
+ public:
+  FakeDriver(const CompileRequest& request, std::vector<uint64_t> widths)
+      : parameter_widths(std::move(widths)) {
+    device_properties = MakeDeviceProperties(request.GetTargetInfo());
+    uint64_t offset = 0;
+    for (uint64_t width : parameter_widths) {
+      parameter_info.push_back(NvidiaFunctionParameterInfo{offset, width});
+      offset += width;
+    }
+    function_properties.binary_version = Artifact::kRequiredComputeCapability;
+    function_properties.max_threads_per_block =
+        request.GetTargetInfo().GetTraits().GetMaxThreadsPerBlock();
+    function_properties.static_shared_memory_bytes = 0;
+    function_properties.max_dynamic_shared_memory_bytes = static_cast<int>(
+        request.GetTargetInfo().GetTraits().GetMaxSharedMemoryPerCtaBytes());
+    function_properties.register_count = 32;
+  }
+
+  void Initialize() override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("Initialize");
+    if (initialize_failure) throw RuntimeError("fake initialize failure");
+  }
+
+  uint32_t GetDriverApiVersion() override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetDriverApiVersion");
+    return driver_api_version;
+  }
+
+  uintptr_t GetCurrentContext() override {
+    if (allocation_free_launch_mode) return current_context_address;
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetCurrentContext");
+    return current_context_address;
+  }
+
+  NvidiaStreamBinding GetCurrentContextBinding() override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetCurrentContextBinding");
+    return NvidiaStreamBinding{current_binding_context_address,
+                               current_green_context_address};
+  }
+
+  uint64_t GetContextId(uintptr_t context_address) override {
+    if (allocation_free_launch_mode) return context_id;
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetContextId");
+    last_context_id_query = context_address;
+    return context_id;
+  }
+
+  int GetContextDeviceOrdinal(uintptr_t context_address) override {
+    if (allocation_free_launch_mode) return context_device_ordinal;
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetContextDeviceOrdinal");
+    last_context_device_query = context_address;
+    return context_device_ordinal;
+  }
+
+  NvidiaDeviceProperties GetDeviceProperties(int device_ordinal) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetDeviceProperties");
+    last_device_properties_query = device_ordinal;
+    return device_properties;
+  }
+
+  uintptr_t LoadModule(const std::vector<uint8_t>& cubin) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("LoadModule");
+    loaded_cubin = cubin;
+    return module_address;
+  }
+
+  uintptr_t GetFunction(uintptr_t loaded_module_address,
+                        const std::string& entry_name) override {
+    std::unique_lock<std::mutex> lock(mutex_);
+    RecordLocked("GetFunction");
+    function_lookup_module = loaded_module_address;
+    function_lookup_entry = entry_name;
+    get_function_entered = true;
+    control_condition_.notify_all();
+    while (block_get_function && !release_get_function) {
+      control_condition_.wait(lock);
+    }
+    if (get_function_failure) throw RuntimeError("fake get function failure");
+    return function_address;
+  }
+
+  void ForceFunctionLoad(uintptr_t loaded_function_address) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("ForceFunctionLoad");
+    forced_function_address = loaded_function_address;
+  }
+
+  bool IsFunctionLoaded(uintptr_t loaded_function_address) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("IsFunctionLoaded");
+    loaded_function_query = loaded_function_address;
+    return function_loaded;
+  }
+
+  std::optional<NvidiaFunctionParameterInfo> GetFunctionParameterInfo(
+      uintptr_t loaded_function_address, uint32_t index) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetFunctionParameterInfo:" + std::to_string(index));
+    parameter_function_queries.push_back(loaded_function_address);
+    if (index < parameter_info.size()) return parameter_info[index];
+    return extra_parameter_info;
+  }
+
+  NvidiaFunctionProperties GetFunctionProperties(
+      uintptr_t loaded_function_address) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetFunctionProperties");
+    function_properties_query = loaded_function_address;
+    return function_properties;
+  }
+
+  int GetActiveBlocksPerMultiprocessor(
+      uintptr_t loaded_function_address, uint32_t block_threads,
+      uint64_t dynamic_shared_memory_bytes) override {
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetActiveBlocksPerMultiprocessor");
+    occupancy_function_query = loaded_function_address;
+    occupancy_block_threads = block_threads;
+    occupancy_dynamic_shared_memory_bytes = dynamic_shared_memory_bytes;
+    return active_blocks_per_multiprocessor;
+  }
+
+  NvidiaStreamBinding GetStreamBinding(uintptr_t stream_address) override {
+    if (allocation_free_launch_mode) {
+      return NvidiaStreamBinding{stream_context_address,
+                                 stream_green_context_address};
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    RecordLocked("GetStreamBinding");
+    last_stream_query = stream_address;
+    return NvidiaStreamBinding{stream_context_address,
+                               stream_green_context_address};
+  }
+
+  void Launch(uintptr_t loaded_function_address,
+              const NvidiaDriverLaunchConfig& config,
+              const std::vector<void*>& kernel_parameters) override {
+    if (allocation_free_launch_mode) {
+      if (kernel_parameters.size() != parameter_widths.size()) {
+        throw RuntimeError("fake launch parameter count mismatch");
+      }
+      for (const void* parameter : kernel_parameters) {
+        if (parameter == nullptr) {
+          throw RuntimeError(
+              "fake launch received a null parameter storage pointer");
+        }
+      }
+      allocation_free_launch_calls.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    std::unique_lock<std::mutex> lock(mutex_);
+    RecordLocked("Launch");
+    launch_entered = true;
+    control_condition_.notify_all();
+    while (block_launch && !release_launch) {
+      control_condition_.wait(lock);
+    }
+    if (kernel_parameters.size() != parameter_widths.size()) {
+      throw RuntimeError("fake launch parameter count mismatch");
+    }
+    LaunchRecord record;
+    record.function_address = loaded_function_address;
+    record.config = config;
+    record.parameter_addresses = kernel_parameters;
+    record.parameter_bytes.reserve(kernel_parameters.size());
+    for (size_t index = 0; index < kernel_parameters.size(); ++index) {
+      if (kernel_parameters[index] == nullptr) {
+        throw RuntimeError("fake launch received a null parameter storage pointer");
+      }
+      std::vector<uint8_t> bytes(static_cast<size_t>(parameter_widths[index]));
+      std::memcpy(bytes.data(), kernel_parameters[index], bytes.size());
+      record.parameter_bytes.push_back(std::move(bytes));
+    }
+    launches_.push_back(std::move(record));
+    if (launch_failure) throw RuntimeError("fake launch failure");
+  }
+
+  void UnloadModule(uintptr_t loaded_module_address) override {
+    std::unique_lock<std::mutex> lock(mutex_);
+    RecordLocked("UnloadModule");
+    unload_entered = true;
+    control_condition_.notify_all();
+    while (block_unload && !release_unload) {
+      control_condition_.wait(lock);
+    }
+    unloaded_modules.push_back(loaded_module_address);
+    if (unload_failure) throw RuntimeError("fake unload failure");
+  }
+
+  std::vector<std::string> GetCalls() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return calls_;
+  }
+
+  size_t CountCalls(std::string_view name) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return static_cast<size_t>(
+        std::count(calls_.begin(), calls_.end(), std::string(name)));
+  }
+
+  std::vector<LaunchRecord> GetLaunches() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return launches_;
+  }
+
+  bool WaitForGetFunction() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return control_condition_.wait_for(
+        lock, std::chrono::seconds(5), [&]() { return get_function_entered; });
+  }
+
+  void ReleaseGetFunction() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    release_get_function = true;
+    control_condition_.notify_all();
+  }
+
+  bool WaitForLaunch() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return control_condition_.wait_for(
+        lock, std::chrono::seconds(5), [&]() { return launch_entered; });
+  }
+
+  void ReleaseLaunch() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    release_launch = true;
+    control_condition_.notify_all();
+  }
+
+  bool WaitForUnload() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return control_condition_.wait_for(
+        lock, std::chrono::seconds(5), [&]() { return unload_entered; });
+  }
+
+  void ReleaseUnload() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    release_unload = true;
+    control_condition_.notify_all();
+  }
+
+  uint32_t driver_api_version = Artifact::kMinimumCudaDriverApiVersion;
+  uintptr_t current_context_address = kContextAddress;
+  uintptr_t current_binding_context_address = kContextAddress;
+  uintptr_t current_green_context_address = 0;
+  uint64_t context_id = kContextId;
+  int context_device_ordinal = 0;
+  NvidiaDeviceProperties device_properties;
+  uintptr_t module_address = kModuleAddress;
+  uintptr_t function_address = kFunctionAddress;
+  bool function_loaded = true;
+  std::vector<uint64_t> parameter_widths;
+  std::vector<std::optional<NvidiaFunctionParameterInfo>> parameter_info;
+  std::optional<NvidiaFunctionParameterInfo> extra_parameter_info;
+  NvidiaFunctionProperties function_properties;
+  int active_blocks_per_multiprocessor = 1;
+  uintptr_t stream_context_address = kContextAddress;
+  uintptr_t stream_green_context_address = 0;
+  bool initialize_failure = false;
+  bool launch_failure = false;
+  bool unload_failure = false;
+  bool allocation_free_launch_mode = false;
+  std::atomic<uint64_t> allocation_free_launch_calls{0};
+  bool block_get_function = false;
+  bool get_function_failure = false;
+  bool get_function_entered = false;
+  bool release_get_function = false;
+  bool block_launch = false;
+  bool launch_entered = false;
+  bool release_launch = false;
+  bool block_unload = false;
+  bool unload_entered = false;
+  bool release_unload = false;
+
+  uintptr_t last_context_id_query = 0;
+  uintptr_t last_context_device_query = 0;
+  int last_device_properties_query = -1;
+  std::vector<uint8_t> loaded_cubin;
+  uintptr_t function_lookup_module = 0;
+  std::string function_lookup_entry;
+  uintptr_t forced_function_address = 0;
+  uintptr_t loaded_function_query = 0;
+  std::vector<uintptr_t> parameter_function_queries;
+  uintptr_t function_properties_query = 0;
+  uintptr_t occupancy_function_query = 0;
+  uint32_t occupancy_block_threads = 0;
+  uint64_t occupancy_dynamic_shared_memory_bytes = 0;
+  uintptr_t last_stream_query = 0;
+  std::vector<uintptr_t> unloaded_modules;
+
+ private:
+  void RecordLocked(std::string call) { calls_.push_back(std::move(call)); }
+
+  mutable std::mutex mutex_;
+  mutable std::condition_variable control_condition_;
+  std::vector<std::string> calls_;
+  std::vector<LaunchRecord> launches_;
+};
