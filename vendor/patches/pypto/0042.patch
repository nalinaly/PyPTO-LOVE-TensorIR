+
+#include <unistd.h>
+
+#include <string>
+
+#if defined(__linux__)
+#include <sys/wait.h>
+#endif
+
+#include "pypto/core/error.h"
+#include "runtime/nvidia/driver_api.h"
+
+using pypto::RuntimeError;
+using pypto::runtime::nvidia::detail::GetProductionNvidiaDriver;
+
+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+int main() {
+  const auto driver = GetProductionNvidiaDriver();
+  bool rejected = false;
+  try {
+    driver->Initialize();
+  } catch (const RuntimeError& error) {
+    rejected = std::string(error.what()).find("PYPTO_ENABLE_NVIDIA_BACKEND=OFF") !=
+               std::string::npos;
+  }
+  REQUIRE(rejected);
+
+#if defined(__linux__)
+  const pid_t child = ::fork();
+  REQUIRE(child >= 0);
+  if (child == 0) {
+    bool fork_rejected = false;
+    try {
+      driver->Initialize();
+    } catch (const RuntimeError& error) {
+      fork_rejected = std::string(error.what()).find("across fork") !=
+                      std::string::npos;
+    }
+    _exit(fork_rejected ? 0 : 1);
+  }
+  int status = 0;
+  REQUIRE(::waitpid(child, &status, 0) == child);
+  REQUIRE(WIFEXITED(status));
+  REQUIRE(WEXITSTATUS(status) == 0);
+#endif
+  return 0;
+}
