+uint64_t ReadUint64(const std::vector<uint8_t>& bytes) {
+  if (bytes.size() != sizeof(uint64_t)) return 0;
+  uint64_t value = 0;
+  std::memcpy(&value, bytes.data(), sizeof(value));
+  return value;
+}
