+# -----------------------------------------------------------------------------------------------------------
+
+"""CUDA-free Python public API checks for the NVIDIA executable runtime."""
+
+import hashlib
+from pathlib import Path
+
+import pypto
+import pytest
+from pypto.compiler import (
+    Artifact,
+    ArtifactArgumentDescriptor,
+    ArtifactArgumentLayout,
+    ArtifactArgumentPackingPolicy,
+    ArtifactClusterSchedulingPolicy,
+    ArtifactGridAbi,
+    ArtifactGridPolicy,
+    ArtifactKernelAbi,
+    ArtifactLaunchAbi,
+    ArtifactLoaderAbi,
+    ArtifactOperandKind,
+    ArtifactWorkspaceAbi,
+    ArtifactWorkspaceKind,
+    CanonicalSchedule,
+    CompileRequest,
+    KernelBuildSpec,
+    NvidiaBackendBuildInfo,
+    NvidiaTargetInfo,
+    ScheduleParameter,
+    ScheduleValueKind,
+    SemanticRoute,
+    TargetTraits,
+    ToolchainIdentity,
+    get_nvidia_backend_build_info,
+)
+from pypto.pypto_core import nvidia_runtime as runtime_core
+from pypto.runtime import nvidia as runtime_api
+
+PIPELINE_REVISION = "46610e0415598d010981e4bd07d0660c592401ac"
+CANONICAL_SOURCE = b"""module {
+  nv_tensor_ir.graph @add_op_simple(
+    %a: tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"},
+    %b: tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"}
+  ) -> (tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"}) {
+    %add = add %a, %b : tensor<8x8xf32>
+    results %add : tensor<8x8xf32>
+  }
+}
+"""
+
+
+def _digest(label: str) -> str:
+    return hashlib.sha256(label.encode("ascii")).hexdigest()
+
+
+def _traits() -> TargetTraits:
+    return TargetTraits(
+        compute_capability=120,
+        multiprocessor_count=82,
+        warp_size=32,
+        max_threads_per_block=1024,
+        max_threads_per_multiprocessor=1536,
+        max_blocks_per_multiprocessor=24,
+        max_block_dim_x=1024,
+        max_block_dim_y=1024,
+        max_block_dim_z=64,
+        max_grid_dim_x=(1 << 31) - 1,
+        max_grid_dim_y=65535,
+        max_grid_dim_z=65535,
+        l1_cache_line_bytes=128,
+        default_shared_memory_per_cta_bytes=48 * 1024,
+        max_shared_memory_per_cta_bytes=101376,
+        shared_memory_per_multiprocessor_bytes=131072,
+        registers_per_cta=65536,
+        max_registers_per_thread=255,
+        registers_per_multiprocessor=65536,
+        l2_cache_size_bytes=96 * 1024 * 1024,
+        total_global_memory_bytes=24 * 1024 * 1024 * 1024,
+    )
+
+
+def _toolchain(info: NvidiaBackendBuildInfo) -> ToolchainIdentity:
+    return ToolchainIdentity(
+        pypto_revision=info.pypto_revision,
+        tensor_ir_revision=info.tensor_ir_revision,
+        cuda_tile_revision=info.cuda_tile_revision,
+        llvm_revision=info.llvm_revision,
+        cuda_toolkit_root=info.cuda_toolkit_root,
+        cuda_toolkit_version=info.cuda_toolkit_version,
+        tileiras_real_path=info.tileiras_real_path,
+        tileiras_version=info.tileiras_version,
+        tileiras_sha256=info.tileiras_sha256,
+    )
+
+
+def _request(info: NvidiaBackendBuildInfo) -> CompileRequest:
+    target = NvidiaTargetInfo(
+        device_ordinal=0,
+        device_name="NVIDIA executable public API test device",
+        device_uuid="GPU-01234567-89ab-cdef-0123-456789abcdef",
+        pci_device_id="0000:01:00.0",
+        traits=_traits(),
+        cuda_toolkit_version=info.cuda_toolkit_version,
+        cuda_driver_version="610.74",
+        tensor_ir_revision=info.tensor_ir_revision,
+        cuda_tile_revision=info.cuda_tile_revision,
+        supported_compute_dtypes=[pypto.DataType.BF16, pypto.DataType.FP32],
+    )
+    return CompileRequest(target, _toolchain(info))
+
+
+def _parameter(name: str, kind: ScheduleValueKind, value: str) -> ScheduleParameter:
+    return ScheduleParameter(name, kind, value)
+
+
+def _strict_schedule() -> CanonicalSchedule:
+    return CanonicalSchedule(
+        schedule=[_parameter("codegen_strategy", ScheduleValueKind.Text, "layout-propagation")],
+        tile=[_parameter("dim_000", ScheduleValueKind.UnsignedInteger, "16")],
+        layout=[],
+        persistence=[],
+        cta=[_parameter("count", ScheduleValueKind.UnsignedInteger, "1")],
+        warp=[_parameter("count", ScheduleValueKind.UnsignedInteger, "4")],
+        stage=[],
+        options=[
+            _parameter("bytecode_major", ScheduleValueKind.UnsignedInteger, "13"),
+            _parameter("bytecode_minor", ScheduleValueKind.UnsignedInteger, "3"),
+            _parameter("bytecode_tag", ScheduleValueKind.UnsignedInteger, "0"),
+            _parameter("max_candidates", ScheduleValueKind.UnsignedInteger, "0"),
+            _parameter("uniform_signature", ScheduleValueKind.Boolean, "false"),
+        ],
+    )
+
+
+def _expected_kernel_abi() -> ArtifactKernelAbi:
+    tensor_descriptor = ArtifactArgumentDescriptor(
+        kind=ArtifactOperandKind.Tensor,
+        rank=2,
+        shape=[8, 8],
+        strides=[8, 1],
+        dynamic_size_count=0,
+        dynamic_stride_count=0,
+        explicit_strides=True,
+        scalar_size_bytes=0,
+    )
+    return ArtifactKernelAbi(
+        runtime_kernel_name="tensor_ir_rtk",
+        entry_function_name="add_op_simple",
+        argument_layout=ArtifactArgumentLayout(
+            operand_descriptors=[tensor_descriptor, tensor_descriptor, tensor_descriptor],
+            input_operand_count=2,
+            total_kernel_argument_count=3,
+            uniform_signature=False,
+        ),
+        argument_packing_policy=ArtifactArgumentPackingPolicy.PointerOnly,
+        grid_abi=ArtifactGridAbi(
+            policy=ArtifactGridPolicy.Static,
+            shape_operand_index=0,
+            static_dimensions=[4, 1, 1],
+            tile_sizes=[16],
+        ),
+        workspace_abi=ArtifactWorkspaceAbi(ArtifactWorkspaceKind.Static, 0, 1),
+        launch_abi=ArtifactLaunchAbi(
+            block_dimensions=[1, 1, 1],
+            cluster_scheduling_policy=ArtifactClusterSchedulingPolicy.Spread,
+            dynamic_shared_memory_bytes=0,
+            kernel_argument_slot_bytes=8,
+        ),
+        loader_abi=ArtifactLoaderAbi(
+            minimum_cuda_driver_api_version=13000,
+            minimum_cuda_runtime_api_version=13000,
+        ),
+    )
+
+
+def _artifact_and_request() -> tuple[Artifact, CompileRequest]:
+    info = get_nvidia_backend_build_info()
+    if not info.compiled:
+        pytest.skip("NvidiaExecutable construction requires a strict backend-ON Artifact")
+    request = _request(info)
+    kernel_abi = _expected_kernel_abi()
+    build_spec = KernelBuildSpec(
+        source_ir_digest=Artifact.compute_source_ir_digest(CANONICAL_SOURCE),
+        callable_abi_digest=kernel_abi.identity_digest,
+        semantic_route=SemanticRoute.StructuredTensorIr,
+        pipeline_revision=PIPELINE_REVISION,
+        resolved_schedule=_strict_schedule(),
+        static_specialization_digest=_digest("executable-static-specialization"),
+        symbolic_specialization_digest=_digest("executable-symbolic-specialization"),
+        argument_abi_digest=_digest("executable-argument-abi"),
+        result_abi_digest=_digest("executable-result-abi"),
+        mutation_abi_digest=_digest("executable-mutation-abi"),
+        compile_request_byte_identity_digest=request.byte_compile_identity_digest,
+        catalog_provenance=None,
+    )
+    return Artifact.compile_strict(CANONICAL_SOURCE, request, build_spec), request
+
+
+def _mapped_cuda_driver_paths() -> set[str]:
+    maps = Path("/proc/self/maps")
+    if not maps.is_file():
+        return set()
+    paths: set[str] = set()
+    for line in maps.read_text(encoding="utf-8").splitlines():
+        path = line.rsplit(maxsplit=1)[-1]
+        if "libcuda.so" in path:
+            paths.add(path)
+    return paths
+
+
+def test_public_wrapper_exports_exact_native_types() -> None:
+    expected = {
+        "NvidiaCudaGraphLease",
+        "NvidiaExecutable",
+        "NvidiaExecutableState",
+        "NvidiaLaunchArgument",
+        "NvidiaLaunchArgumentKind",
+        "NvidiaLaunchPacket",
+    }
+    assert set(runtime_api.__all__) == expected
+    for name in expected:
+        assert getattr(runtime_api, name) is getattr(runtime_core, name)
+
+    assert not hasattr(runtime_api, "CudaGraphLease")
+    for forbidden in (
+        "NvidiaDriverApi",
+        "NvidiaExecutableTestAccess",
+        "create_with_driver",
+        "get_production_nvidia_driver",
+    ):
+        assert not hasattr(runtime_api, forbidden)
+        assert not hasattr(runtime_core, forbidden)
+
+
+def test_launch_argument_factories_are_typed_immutable_values() -> None:
+    tensor = runtime_api.NvidiaLaunchArgument.tensor(0x1234, [2, 3], [3, 1])
+    assert tensor.kind == runtime_api.NvidiaLaunchArgumentKind.Tensor
+    assert tensor.data_address == 0x1234
+    assert tensor.shape == [2, 3]
+    assert tensor.strides == [3, 1]
+    assert tensor.scalar_bytes == b""
+
+    returned_shape = tensor.shape
+    returned_shape[0] = 99
+    assert tensor.shape == [2, 3]
+
+    scalar = runtime_api.NvidiaLaunchArgument.scalar(b"\x01\x02\x03\x04")
+    assert scalar.kind == runtime_api.NvidiaLaunchArgumentKind.Scalar
+    assert scalar.data_address == 0
+    assert scalar.shape == []
+    assert scalar.strides == []
+    assert scalar.scalar_bytes == b"\x01\x02\x03\x04"
+
+    with pytest.raises(AttributeError):
+        tensor.data_address = 0x5678  # type: ignore[misc]
+    with pytest.raises(TypeError):
+        runtime_api.NvidiaLaunchArgument()
+    with pytest.raises(TypeError):
+        runtime_api.NvidiaLaunchArgument.scalar(bytearray(b"\x01"))  # type: ignore[arg-type]
+
+
+def test_launch_argument_factories_reject_invalid_host_metadata() -> None:
+    with pytest.raises(ValueError, match="non-null"):
+        runtime_api.NvidiaLaunchArgument.tensor(0, [2], [1])
+    with pytest.raises(ValueError, match="rank"):
+        runtime_api.NvidiaLaunchArgument.tensor(1, [2, 3], [1])
+    with pytest.raises(ValueError, match="1 through 8"):
+        runtime_api.NvidiaLaunchArgument.scalar(b"")
+    with pytest.raises(ValueError, match="1 through 8"):
+        runtime_api.NvidiaLaunchArgument.scalar(b"123456789")
+
+
+def test_move_only_lease_types_have_no_public_constructor() -> None:
+    with pytest.raises(TypeError):
+        runtime_api.NvidiaLaunchPacket()
+    with pytest.raises(TypeError):
+        runtime_api.NvidiaCudaGraphLease()
+
+
+def test_executable_construction_is_cuda_free_and_exposes_initial_state() -> None:
+    artifact, request = _artifact_and_request()
+    driver_mappings_before = _mapped_cuda_driver_paths()
+
+    executable = runtime_api.NvidiaExecutable(artifact, request)
+
+    assert _mapped_cuda_driver_paths() == driver_mappings_before
+    assert executable.state == runtime_api.NvidiaExecutableState.Unloaded
+    assert not executable.ready
+    assert executable.failure_message == ""
+    assert executable.artifact_identity_digest == artifact.identity_digest
+    assert executable.loader_compatibility_digest == artifact.loader_compatibility_digest
+    assert executable.device_ordinal == request.target_info.device_ordinal
+    assert executable.bound_context_address == 0
+    assert executable.bound_context_id == 0
+
+    with pytest.raises(RuntimeError, match="ready before preparing"):
+        executable.prepare_launch([])
+    with pytest.raises(RuntimeError, match="ready before acquiring"):
+        executable.acquire_cuda_graph_lease()
+    assert _mapped_cuda_driver_paths() == driver_mappings_before
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
