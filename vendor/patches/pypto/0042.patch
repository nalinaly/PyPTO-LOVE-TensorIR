+NvidiaLaunchArgument::NvidiaLaunchArgument(
+    NvidiaLaunchArgumentKind kind, uintptr_t data_address,
+    std::vector<int64_t> shape, std::vector<int64_t> strides,
+    std::vector<uint8_t> scalar_bytes)
