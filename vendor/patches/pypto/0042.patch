+/** Private, injectable CUDA Driver boundary. No implementation is public ABI. */
+class NvidiaDriverApi {
+ public:
+  virtual ~NvidiaDriverApi() = default;
+
+  virtual void Initialize() = 0;
+  [[nodiscard]] virtual uint32_t GetDriverApiVersion() = 0;
+  [[nodiscard]] virtual uintptr_t GetCurrentContext() = 0;
+  [[nodiscard]] virtual NvidiaStreamBinding GetCurrentContextBinding() = 0;
+  [[nodiscard]] virtual uint64_t GetContextId(uintptr_t context_address) = 0;
+  [[nodiscard]] virtual int GetContextDeviceOrdinal(uintptr_t context_address) = 0;
