+    FailClosed();
+  }
+  void Launch(uintptr_t, const NvidiaDriverLaunchConfig&,
+              const std::vector<void*>&) override {
+    FailClosed();
+  }
+  void UnloadModule(uintptr_t) override { FailClosed(); }
