+ArtifactSet MakeArtifactSet() {
+  CompileRequest request = MakeRequest();
+  Artifact static_artifact = CompileArtifact(
+      request, MakeStaticKernelAbi(), kStaticTensorIrSource, {16});
+  Artifact dynamic_artifact = CompileArtifact(
+      request, MakeDynamicKernelAbi(), kDynamicTensorIrSource, {8, 8});
+  Artifact scalar_artifact = CompileArtifact(
+      request, MakeScalarKernelAbi(), kScalarTensorIrSource, {16});
+  return {std::move(request), std::move(static_artifact),
+          std::move(dynamic_artifact), std::move(scalar_artifact)};
+}
