+class DisabledNvidiaDriver final : public NvidiaDriverApi {
+ public:
+  DisabledNvidiaDriver() : owner_pid_(CurrentProcessId()) {}
+
+  void Initialize() override { FailClosed(); }
+
+  [[nodiscard]] uint32_t GetDriverApiVersion() override { FailClosed(); }
+  [[nodiscard]] uintptr_t GetCurrentContext() override { FailClosed(); }
+  [[nodiscard]] NvidiaStreamBinding GetCurrentContextBinding() override {
+    FailClosed();
+  }
