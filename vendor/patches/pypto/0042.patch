+                             total_kernel_argument_count, false),
+      packing_policy,
+      ArtifactGridAbi(grid_policy, 0, static_dimensions,
+                      std::move(tile_sizes)),
+      ArtifactWorkspaceAbi(ArtifactWorkspaceKind::Static, 0, 1),
+      ArtifactLaunchAbi({1, 1, 1}, ArtifactClusterSchedulingPolicy::Spread, 0,
+                        8),
+      ArtifactLoaderAbi(Artifact::kMinimumCudaDriverApiVersion,
+                        Artifact::kMinimumCudaRuntimeApiVersion));
+}
