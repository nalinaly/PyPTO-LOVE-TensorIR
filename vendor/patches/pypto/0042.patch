+ArtifactKernelAbi MakeStaticKernelAbi() {
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  for (size_t index = 0; index < 3; ++index) {
+    descriptors.push_back(MakeTensorDescriptor(
+        {std::optional<int64_t>{8}, std::optional<int64_t>{8}},
+        {std::optional<int64_t>{8}, std::optional<int64_t>{1}}, 0, 0, true));
+  }
+  return MakeKernelAbi("add_op_simple", std::move(descriptors), 2, 3,
+                       ArtifactArgumentPackingPolicy::PointerOnly,
+                       ArtifactGridPolicy::Static, {4, 1, 1}, {16});
+}
+
+ArtifactKernelAbi MakeDynamicKernelAbi() {
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  for (size_t index = 0; index < 3; ++index) {
+    descriptors.push_back(MakeTensorDescriptor(
+        {std::nullopt, std::nullopt},
+        {std::nullopt, std::optional<int64_t>{1}}, 2, 1, true));
+  }
+  return MakeKernelAbi("add_dynamic_shape", std::move(descriptors), 2, 12,
+                       ArtifactArgumentPackingPolicy::Flat,
+                       ArtifactGridPolicy::TileBasedRuntime, {1, 1, 1},
+                       {8, 8});
+}
+
+ArtifactKernelAbi MakeScalarKernelAbi() {
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  descriptors.push_back(MakeTensorDescriptor(
+      {std::optional<int64_t>{4}, std::optional<int64_t>{4},
+       std::optional<int64_t>{4}},
+      {}, 0, 0, false));
+  descriptors.push_back(MakeScalarDescriptor());
+  descriptors.push_back(MakeTensorDescriptor(
+      {std::optional<int64_t>{4}, std::optional<int64_t>{4},
+       std::optional<int64_t>{4}},
+      {}, 0, 0, false));
+  return MakeKernelAbi("add_tensor_scalar", std::move(descriptors), 2, 3,
+                       ArtifactArgumentPackingPolicy::PointerOnly,
+                       ArtifactGridPolicy::Static, {4, 1, 1}, {16});
+}
