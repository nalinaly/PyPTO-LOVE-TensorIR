+NvidiaExecutable::NvidiaExecutable(compiler::Artifact artifact,
+                                   compiler::CompileRequest request)
+    : NvidiaExecutable(std::move(artifact), std::move(request),
+                       detail::GetProductionNvidiaDriver()) {}
+
+NvidiaExecutable::NvidiaExecutable(
+    compiler::Artifact artifact, compiler::CompileRequest request,
+    std::shared_ptr<detail::NvidiaDriverApi> driver) {
+  if (!driver) throw ValueError("NvidiaExecutable driver boundary must not be null");
+  ValidateStaticExecutableInputs(artifact, request);
+  const int64_t creator_pid = CurrentProcessId();
+  state_ = std::shared_ptr<detail::NvidiaExecutableSharedState>(
+      new detail::NvidiaExecutableSharedState(
+          std::move(artifact), std::move(request), std::move(driver)),
+      [creator_pid](detail::NvidiaExecutableSharedState* state) noexcept {
+        // Do not even run std::mutex/condition_variable member destructors in
+        // a fork child: either may have been owned by a vanished parent thread.
+        // The child has a private copy-on-write address space, so leaking that
+        // inherited state until exec/_exit cannot affect the parent.
+        if (CurrentProcessId() == creator_pid) delete state;
+      });
+}
+
+NvidiaExecutable::~NvidiaExecutable() = default;
+
+void NvidiaExecutable::Prewarm(uint32_t active_cuda_runtime_api_version) {
+  RequireCreatorProcess(*state_);
+  const auto& loader = state_->artifact.GetKernelAbi().GetLoaderAbi();
+
+  {
+    std::unique_lock<std::mutex> lock(state_->mutex);
+    while (state_->state == NvidiaExecutableState::Prewarming ||
+           state_->state == NvidiaExecutableState::Unloading) {
+      state_->lifecycle_waiters.fetch_add(1, std::memory_order_release);
+      state_->condition.wait(lock);
+      state_->lifecycle_waiters.fetch_sub(1, std::memory_order_release);
+    }
+    if (state_->state == NvidiaExecutableState::Ready) {
+      if (state_->active_cuda_runtime_api_version != active_cuda_runtime_api_version) {
+        throw RuntimeError("NvidiaExecutable was prewarmed against a different CUDA Runtime API version");
+      }
+      return;
+    }
+    if (state_->state == NvidiaExecutableState::Failed) ThrowLatchedFailure(*state_);
+    if (state_->terminally_unloaded) {
+      throw RuntimeError("NvidiaExecutable cannot be prewarmed after explicit unload");
+    }
+    state_->state = NvidiaExecutableState::Prewarming;
+  }
+
+  uintptr_t module_address = 0;
+  try {
+    if (active_cuda_runtime_api_version <
+        loader.GetMinimumCudaRuntimeApiVersion()) {
+      throw RuntimeError("active CUDA Runtime API version is below the Artifact minimum");
+    }
+    state_->driver->Initialize();
+    if (state_->driver->GetDriverApiVersion() <
+        loader.GetMinimumCudaDriverApiVersion()) {
+      throw RuntimeError("CUDA Driver API version is below the Artifact minimum");
+    }
+    const uintptr_t context_address = state_->driver->GetCurrentContext();
+    if (context_address == 0) {
+      throw RuntimeError("NvidiaExecutable prewarm requires a non-null current CUDA context");
+    }
+    const detail::NvidiaStreamBinding current_binding =
+        state_->driver->GetCurrentContextBinding();
+    if (current_binding.green_context_address != 0 ||
+        current_binding.context_address != context_address) {
+      throw RuntimeError("NvidiaExecutable v1 does not support a current CUDA green context");
+    }
+    const uint64_t context_id = state_->driver->GetContextId(context_address);
+    const int context_device =
+        state_->driver->GetContextDeviceOrdinal(context_address);
+    const auto& expected_target = state_->request.GetTargetInfo();
+    if (context_device != expected_target.GetDeviceOrdinal()) {
+      throw RuntimeError("current CUDA context device differs from CompileRequest device ordinal");
+    }
+    const detail::NvidiaDeviceProperties live_device =
+        state_->driver->GetDeviceProperties(context_device);
+    ValidateLiveDevice(live_device, expected_target);
+
+    module_address = state_->driver->LoadModule(state_->artifact.GetDeviceCode());
+    if (module_address == 0) {
+      throw InternalError("CUDA driver returned a null module after successful load");
+    }
+    const uintptr_t function_address = state_->driver->GetFunction(
+        module_address, state_->artifact.GetKernelAbi().GetEntryFunctionName());
+    if (function_address == 0) {
+      throw InternalError("CUDA driver returned a null function after successful lookup");
+    }
+    state_->driver->ForceFunctionLoad(function_address);
+    if (!state_->driver->IsFunctionLoaded(function_address)) {
+      throw RuntimeError("CUDA function remained lazy after forced prewarm");
+    }
+
+    const std::vector<uint64_t> widths = ExpectedParameterWidths(
+        state_->artifact.GetKernelAbi().GetArgumentLayout());
+    uint64_t previous_end = 0;
+    for (size_t index = 0; index < widths.size(); ++index) {
+      const auto info = state_->driver->GetFunctionParameterInfo(
+          function_address, static_cast<uint32_t>(index));
+      if (!info.has_value() || info->size_bytes != widths[index] ||
+          info->offset_bytes < previous_end ||
+          info->offset_bytes > std::numeric_limits<uint64_t>::max() -
+                                   info->size_bytes) {
+        throw RuntimeError("loaded CUDA function parameter ABI differs from Artifact");
+      }
+      previous_end = info->offset_bytes + info->size_bytes;
+    }
+    if (state_->driver->GetFunctionParameterInfo(
+            function_address, static_cast<uint32_t>(widths.size()))
+            .has_value()) {
+      throw RuntimeError("loaded CUDA function has parameters absent from Artifact ABI");
+    }
+
+    const auto properties = state_->driver->GetFunctionProperties(function_address);
+    const auto& launch = state_->artifact.GetKernelAbi().GetLaunchAbi();
+    const uint64_t block_threads = BlockThreadCount(launch.GetBlockDimensions());
+    const int occupancy = state_->driver->GetActiveBlocksPerMultiprocessor(
+        function_address, static_cast<uint32_t>(block_threads),
+        launch.GetDynamicSharedMemoryBytes());
+    ValidateFunction(properties, state_->artifact.GetKernelAbi(),
+                     expected_target.GetTraits(), occupancy);
+
+    {
+      std::lock_guard<std::mutex> lock(state_->mutex);
+      state_->active_cuda_runtime_api_version = active_cuda_runtime_api_version;
+      state_->context_address = context_address;
+      state_->context_id = context_id;
+      state_->device_ordinal = context_device;
+      state_->module_address = module_address;
+      state_->function_address = function_address;
+      state_->state = NvidiaExecutableState::Ready;
+    }
+    state_->condition.notify_all();
+  } catch (const std::exception& error) {
+    std::string failure = BoundFailureMessage(error);
+    if (module_address != 0) {
+      try {
+        state_->driver->UnloadModule(module_address);
+      } catch (const std::exception& cleanup_error) {
+        failure += "; module rollback also failed: ";
+        failure += cleanup_error.what();
+        if (failure.size() > 4096) failure.resize(4096);
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(state_->mutex);
+      state_->failure_message = std::move(failure);
+      state_->state = NvidiaExecutableState::Failed;
+    }
+    state_->condition.notify_all();
+    ThrowLatchedFailure(*state_);
+  }
+}
+
+NvidiaLaunchPacket NvidiaExecutable::PrepareLaunch(
+    std::vector<NvidiaLaunchArgument> arguments) const {
+  RequireCreatorProcess(*state_);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  if (state_->state == NvidiaExecutableState::Failed) ThrowLatchedFailure(*state_);
+  if (state_->state != NvidiaExecutableState::Ready) {
+    throw RuntimeError("NvidiaExecutable must be ready before preparing a launch");
+  }
+  auto data = BuildPreparedLaunch(state_->artifact.GetKernelAbi(),
+                                  state_->request.GetTargetInfo().GetTraits(),
+                                  arguments);
+  ++state_->prepared_packets;
+  return NvidiaLaunchPacket(state_, std::move(data));
+}
+
+void NvidiaExecutable::Launch(const NvidiaLaunchPacket& packet,
+                              uintptr_t raw_current_stream) {
+  if (raw_current_stream == 0 ||
+      raw_current_stream == kCudaLegacyStreamAddress ||
+      raw_current_stream == kCudaPerThreadStreamAddress) {
+    throw ValueError(
+        "NvidiaExecutable rejects CUDA null, legacy and per-thread default streams");
+  }
+  RequireCreatorProcess(*state_);
+  if (!packet.state_ || !packet.data_ || packet.state_.get() != state_.get()) {
+    throw ValueError("NvidiaLaunchPacket belongs to another or released executable");
+  }
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    if (state_->state == NvidiaExecutableState::Failed) ThrowLatchedFailure(*state_);
+    if (state_->state != NvidiaExecutableState::Ready) {
+      throw RuntimeError("NvidiaExecutable is not ready for launch");
+    }
+    ++state_->active_launches;
+  }
+  ActiveLaunchGuard guard(state_);
+
+  ValidateBoundContext(*state_);
+  const detail::NvidiaStreamBinding stream =
+      state_->driver->GetStreamBinding(raw_current_stream);
+  if (stream.green_context_address != 0) {
+    throw RuntimeError("NvidiaExecutable v1 does not support CUDA green-context streams");
+  }
+  if (stream.context_address == 0 ||
+      stream.context_address != state_->context_address) {
+    throw RuntimeError("CUDA stream context differs from the prewarmed NvidiaExecutable");
+  }
+
+  const auto& launch = state_->artifact.GetKernelAbi().GetLaunchAbi();
+  detail::NvidiaDriverLaunchConfig config;
+  std::copy(packet.data_->grid_dimensions.begin(),
+            packet.data_->grid_dimensions.end(), config.grid_dimensions.begin());
+  config.block_dimensions = launch.GetBlockDimensions();
+  config.dynamic_shared_memory_bytes = launch.GetDynamicSharedMemoryBytes();
+  config.stream_address = raw_current_stream;
+  config.cluster_scheduling_policy = launch.GetClusterSchedulingPolicy();
+  state_->driver->Launch(state_->function_address, config,
+                         packet.data_->kernel_parameters);
+}
+
+NvidiaCudaGraphLease NvidiaExecutable::AcquireCudaGraphLease() {
+  RequireCreatorProcess(*state_);
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    if (state_->state == NvidiaExecutableState::Failed) ThrowLatchedFailure(*state_);
+    if (state_->state != NvidiaExecutableState::Ready) {
+      throw RuntimeError("NvidiaExecutable must be ready before acquiring a graph lease");
+    }
+    ++state_->graph_leases;
+  }
+  try {
+    ValidateBoundContext(*state_);
+  } catch (...) {
+    ReleaseGraphLease(*state_);
+    throw;
+  }
+  return NvidiaCudaGraphLease(state_);
+}
+
+void NvidiaExecutable::Unload() {
+  RequireCreatorProcess(*state_);
+  uintptr_t module_address = 0;
+  {
+    std::unique_lock<std::mutex> lock(state_->mutex);
+    while (state_->state == NvidiaExecutableState::Prewarming ||
+           state_->state == NvidiaExecutableState::Unloading) {
+      state_->lifecycle_waiters.fetch_add(1, std::memory_order_release);
+      state_->condition.wait(lock);
+      state_->lifecycle_waiters.fetch_sub(1, std::memory_order_release);
+    }
+    if (state_->state == NvidiaExecutableState::Unloaded) {
+      state_->terminally_unloaded = true;
+      return;
+    }
+    if (state_->state == NvidiaExecutableState::Failed) ThrowLatchedFailure(*state_);
+    if (state_->active_launches != 0 || state_->prepared_packets != 0 ||
+        state_->graph_leases != 0) {
+      throw RuntimeError("NvidiaExecutable cannot unload with live launch/packet/graph leases");
+    }
+    state_->state = NvidiaExecutableState::Unloading;
+    module_address = state_->module_address;
+  }
+
+  try {
+    ValidateBoundContext(*state_);
+  } catch (...) {
+    {
+      std::lock_guard<std::mutex> lock(state_->mutex);
+      state_->state = NvidiaExecutableState::Ready;
+    }
+    state_->condition.notify_all();
+    throw;
+  }
+
+  try {
+    state_->driver->UnloadModule(module_address);
+  } catch (const std::exception& error) {
+    {
+      std::lock_guard<std::mutex> lock(state_->mutex);
+      state_->failure_message = std::string("NvidiaExecutable unload failed: ") + error.what();
+      state_->state = NvidiaExecutableState::Failed;
+    }
+    state_->condition.notify_all();
+    ThrowLatchedFailure(*state_);
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    state_->module_address = 0;
+    state_->function_address = 0;
+    state_->context_address = 0;
+    state_->context_id = 0;
+    state_->device_ordinal = -1;
+    state_->terminally_unloaded = true;
+    state_->state = NvidiaExecutableState::Unloaded;
+  }
+  state_->condition.notify_all();
+}
+
+NvidiaExecutableState NvidiaExecutable::GetState() const {
+  RequireCreatorProcess(*state_);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  return state_->state;
+}
+
+bool NvidiaExecutable::IsReady() const {
+  return GetState() == NvidiaExecutableState::Ready;
+}
+
+std::string NvidiaExecutable::GetFailureMessage() const {
+  RequireCreatorProcess(*state_);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  return state_->failure_message;
+}
+
+std::string NvidiaExecutable::GetArtifactIdentityDigest() const {
+  return state_->artifact_identity_digest;
+}
+
+std::string NvidiaExecutable::GetLoaderCompatibilityDigest() const {
+  return state_->loader_compatibility_digest;
+}
+
+int NvidiaExecutable::GetDeviceOrdinal() const {
+  return state_->request.GetTargetInfo().GetDeviceOrdinal();
+}
+
+uintptr_t NvidiaExecutable::GetBoundContextAddress() const {
+  RequireCreatorProcess(*state_);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  return state_->context_address;
+}
+
+uint64_t NvidiaExecutable::GetBoundContextId() const {
+  RequireCreatorProcess(*state_);
+  std::lock_guard<std::mutex> lock(state_->mutex);
+  return state_->context_id;
+}
