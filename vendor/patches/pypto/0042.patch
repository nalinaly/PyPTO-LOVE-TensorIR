+
+void RequireCreatorProcess(const detail::NvidiaExecutableSharedState& state) {
+  if (CurrentProcessId() != state.creator_pid) {
+    throw RuntimeError("NvidiaExecutable cannot be inherited across fork; create it in this process");
+  }
+}
+
+[[noreturn]] void ThrowLatchedFailure(const detail::NvidiaExecutableSharedState& state) {
+  throw RuntimeError(state.failure_message.empty()
+                         ? "NvidiaExecutable is in a terminal failed state"
+                         : state.failure_message);
+}
+
+void ReleasePreparedPacket(detail::NvidiaExecutableSharedState& state) noexcept {
+  // A child inherited only a copy-on-write lease count. Never touch a mutex
+  // that may have been owned by a vanished parent thread at fork time.
+  if (CurrentProcessId() != state.creator_pid) return;
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.prepared_packets > 0) --state.prepared_packets;
+  state.condition.notify_all();
+}
+
+void ReleaseGraphLease(detail::NvidiaExecutableSharedState& state) noexcept {
+  if (CurrentProcessId() != state.creator_pid) return;
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.graph_leases > 0) --state.graph_leases;
+  state.condition.notify_all();
+}
+
+class ActiveLaunchGuard {
+ public:
+  explicit ActiveLaunchGuard(std::shared_ptr<detail::NvidiaExecutableSharedState> state)
+      : state_(std::move(state)) {}
+  ~ActiveLaunchGuard() {
+    if (!state_) return;
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    if (state_->active_launches > 0) --state_->active_launches;
+    state_->condition.notify_all();
+  }
+  ActiveLaunchGuard(const ActiveLaunchGuard&) = delete;
+  ActiveLaunchGuard& operator=(const ActiveLaunchGuard&) = delete;
+
+ private:
+  std::shared_ptr<detail::NvidiaExecutableSharedState> state_;
+};
+
+void ValidateBoundContext(detail::NvidiaExecutableSharedState& state) {
+  const uintptr_t current_context = state.driver->GetCurrentContext();
+  if (current_context == 0 || current_context != state.context_address ||
+      state.driver->GetContextId(current_context) != state.context_id ||
+      state.driver->GetContextDeviceOrdinal(current_context) != state.device_ordinal) {
+    throw RuntimeError("current CUDA context/device differs from the prewarmed NvidiaExecutable");
+  }
+}
+
+[[nodiscard]] std::shared_ptr<const detail::NvidiaPreparedLaunchData> BuildPreparedLaunch(
+    const compiler::ArtifactKernelAbi& kernel,
+    const compiler::TargetTraits& target,
+    const std::vector<NvidiaLaunchArgument>& arguments) {
+  const auto& layout = kernel.GetArgumentLayout();
+  const auto& descriptors = layout.GetOperandDescriptors();
+  if (arguments.size() != descriptors.size()) {
+    throw ValueError("NvidiaExecutable launch operand count differs from Artifact ABI");
+  }
+
+  auto data = std::make_shared<detail::NvidiaPreparedLaunchData>();
+  data->argument_slots.assign(layout.GetTotalKernelArgumentCount(), 0);
+  size_t slot_index = 0;
+  for (size_t operand_index = 0; operand_index < descriptors.size(); ++operand_index) {
+    const auto& descriptor = descriptors[operand_index];
+    const auto& argument = arguments[operand_index];
+    if (descriptor.GetKind() == compiler::ArtifactOperandKind::Scalar) {
+      if (argument.GetKind() != NvidiaLaunchArgumentKind::Scalar ||
+          argument.GetScalarBytes().size() != descriptor.GetScalarSizeBytes()) {
+        throw ValueError("NvidiaExecutable scalar operand differs from Artifact ABI");
+      }
+      if (slot_index >= data->argument_slots.size()) {
+        throw InternalError("NvidiaExecutable scalar packing exceeded allocated slots");
+      }
+      uint64_t slot = 0;
+      std::memcpy(&slot, argument.GetScalarBytes().data(),
+                  argument.GetScalarBytes().size());
+      data->argument_slots[slot_index++] = slot;
+      continue;
+    }
+
+    if (argument.GetKind() != NvidiaLaunchArgumentKind::Tensor ||
+        argument.GetDataAddress() == 0 ||
+        argument.GetShape().size() != descriptor.GetRank() ||
+        argument.GetStrides().size() != descriptor.GetRank()) {
+      throw ValueError("NvidiaExecutable tensor operand differs from Artifact rank/pointer ABI");
+    }
+    for (size_t dimension = 0; dimension < descriptor.GetRank(); ++dimension) {
+      const int64_t size = argument.GetShape()[dimension];
+      const int64_t stride = argument.GetStrides()[dimension];
+      if (size <= 0 || stride < 0) {
+        throw ValueError("NvidiaExecutable tensor sizes must be positive and strides nonnegative");
+      }
+      const auto& static_size = descriptor.GetShape()[dimension];
+      if (static_size.has_value() && *static_size != size) {
+        throw ValueError("NvidiaExecutable tensor size differs from static Artifact ABI");
+      }
+      if (descriptor.HasExplicitStrides()) {
+        const auto& static_stride = descriptor.GetStrides()[dimension];
+        if (static_stride.has_value() && *static_stride != stride) {
+          throw ValueError("NvidiaExecutable tensor stride differs from static Artifact ABI");
+        }
+      } else if (static_cast<uint64_t>(stride) !=
+                 CheckedDenseStride(argument.GetShape(), dimension)) {
+        throw ValueError("NvidiaExecutable tensor without stride ABI must be dense contiguous");
+      }
+    }
+
+    if (slot_index >= data->argument_slots.size()) {
+      throw InternalError("NvidiaExecutable tensor packing exceeded allocated slots");
+    }
+    data->argument_slots[slot_index++] =
+        static_cast<uint64_t>(argument.GetDataAddress());
+    for (size_t dimension = 0; dimension < descriptor.GetRank(); ++dimension) {
+      if (layout.HasUniformSignature() ||
+          !descriptor.GetShape()[dimension].has_value()) {
+        if (slot_index >= data->argument_slots.size()) {
+          throw InternalError("NvidiaExecutable shape packing exceeded allocated slots");
+        }
+        data->argument_slots[slot_index++] =
+            static_cast<uint64_t>(argument.GetShape()[dimension]);
+      }
+    }
+    if (descriptor.HasExplicitStrides()) {
+      for (size_t dimension = 0; dimension < descriptor.GetRank(); ++dimension) {
+        if (layout.HasUniformSignature() ||
+            !descriptor.GetStrides()[dimension].has_value()) {
+          if (slot_index >= data->argument_slots.size()) {
+            throw InternalError("NvidiaExecutable stride packing exceeded allocated slots");
+          }
+          data->argument_slots[slot_index++] =
+              static_cast<uint64_t>(argument.GetStrides()[dimension]);
+        }
+      }
+    }
+  }
+  if (slot_index != data->argument_slots.size()) {
+    throw InternalError("NvidiaExecutable did not fill the complete flattened argument ABI");
+  }
+
+  const auto& grid_abi = kernel.GetGridAbi();
+  std::array<uint32_t, 3> grid = grid_abi.GetStaticDimensions();
+  if (grid_abi.GetPolicy() == compiler::ArtifactGridPolicy::TileBasedRuntime) {
+    const size_t shape_index = grid_abi.GetShapeOperandIndex();
+    if (shape_index >= arguments.size() ||
+        arguments[shape_index].GetKind() != NvidiaLaunchArgumentKind::Tensor) {
+      throw ValueError("NvidiaExecutable runtime grid shape operand is unavailable");
+    }
+    const auto& shape = arguments[shape_index].GetShape();
+    const auto& tiles = grid_abi.GetTileSizes();
+    if (tiles.empty() || tiles.size() > shape.size()) {
+      throw ValueError("NvidiaExecutable cannot reproduce the runtime grid tile rank");
+    }
+    uint64_t total_tiles = 1;
+    for (size_t dimension = 0; dimension < tiles.size(); ++dimension) {
+      const uint64_t size = static_cast<uint64_t>(shape[dimension]);
+      const uint64_t tile = tiles[dimension];
+      const uint64_t count = 1 + (size - 1) / tile;
+      total_tiles = CheckedMultiply(total_tiles, count, "runtime CUDA grid");
+    }
+    grid = {CheckedDimension(total_tiles,
+                             static_cast<uint32_t>(target.GetMaxGridDimX()),
+                             "runtime CUDA grid x"),
+            1, 1};
+  }
+  grid[0] = CheckedDimension(grid[0],
+                             static_cast<uint32_t>(target.GetMaxGridDimX()),
+                             "CUDA grid x");
+  grid[1] = CheckedDimension(grid[1],
+                             static_cast<uint32_t>(target.GetMaxGridDimY()),
+                             "CUDA grid y");
+  grid[2] = CheckedDimension(grid[2],
+                             static_cast<uint32_t>(target.GetMaxGridDimZ()),
+                             "CUDA grid z");
+  data->grid_dimensions.assign(grid.begin(), grid.end());
+
+  data->kernel_parameters.reserve(data->argument_slots.size());
+  for (uint64_t& slot : data->argument_slots) {
+    data->kernel_parameters.push_back(&slot);
+  }
+  return data;
+}
