+KernelBuildSpec MakeBuildSpec(const CompileRequest& request,
+                              const ArtifactKernelAbi& kernel,
+                              const std::vector<uint8_t>& canonical_source,
+                              const std::vector<uint32_t>& tile_sizes) {
+  return KernelBuildSpec(
+      Artifact::ComputeSourceIrDigest(canonical_source),
+      kernel.GetIdentityDigest(), SemanticRoute::StructuredTensorIr,
+      std::string(Artifact::kStructuredTensorIrPipelineRevision),
+      MakeSchedule(tile_sizes), std::string(kStaticSpecializationDigest),
+      std::string(kSymbolicSpecializationDigest),
+      std::string(kArgumentAbiDigest), std::string(kResultAbiDigest),
+      std::string(kMutationAbiDigest), request.GetByteCompileIdentityDigest());
+}
+
+Artifact CompileArtifact(const CompileRequest& request,
+                         const ArtifactKernelAbi& kernel,
+                         std::string_view source,
+                         const std::vector<uint32_t>& tile_sizes) {
+  std::vector<uint8_t> source_bytes = SourceBytes(source);
+  const KernelBuildSpec build_spec =
+      MakeBuildSpec(request, kernel, source_bytes, tile_sizes);
+  return Artifact::CompileStrict(std::move(source_bytes), request, build_spec);
+}
