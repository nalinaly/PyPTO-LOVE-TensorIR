+  [[nodiscard]] bool IsFunctionLoaded(uintptr_t) override { FailClosed(); }
+  [[nodiscard]] std::optional<NvidiaFunctionParameterInfo>
+  GetFunctionParameterInfo(uintptr_t, uint32_t) override {
+    FailClosed();
+  }
+  [[nodiscard]] NvidiaFunctionProperties GetFunctionProperties(
+      uintptr_t) override {
+    FailClosed();
+  }
+  [[nodiscard]] int GetActiveBlocksPerMultiprocessor(
+      uintptr_t, uint32_t, uint64_t) override {
+    FailClosed();
