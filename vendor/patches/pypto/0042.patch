+    REQUIRE(executable->GetFailureMessage() == failure);
+    const std::vector<std::string> calls = driver->GetCalls();
+    std::string repeated;
+    REQUIRE(RejectsWith<RuntimeError>([&]() { executable->Unload(); },
+                                      "unload failed", &repeated));
