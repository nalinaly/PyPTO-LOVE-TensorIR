+
+#include "runtime/nvidia/driver_api.h"
+
+#include <cudaTypedefs.h>
+#include <dlfcn.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstring>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <type_traits>
+#include <utility>
+
+#include "pypto/core/error.h"
+
+namespace pypto::runtime::nvidia::detail {
+namespace {
+
+constexpr char kCudaDriverSoname[] = "libcuda.so.1";
+constexpr int kRequiredDriverApiVersion = 13000;
+constexpr size_t kMaximumDiagnosticBytes = 2048;
+constexpr size_t kMaximumDriverTextBytes = 512;
+constexpr size_t kDeviceNameBytes = 256;
+constexpr size_t kPciBusIdBytes = 32;
+constexpr uint64_t kSm120L1CacheLineBytes = 128;
+constexpr uint64_t kSm120MaximumRegistersPerThread = 255;
+constexpr uintptr_t kCudaLegacyStreamAddress = 1;
+constexpr uintptr_t kCudaPerThreadStreamAddress = 2;
+
+[[nodiscard]] int64_t CurrentProcessId() noexcept {
+  return static_cast<int64_t>(::getpid());
+}
+
+static_assert(std::atomic<int64_t>::is_always_lock_free,
+              "fork ownership requires a lock-free PID latch");
+std::atomic<int64_t> g_driver_initialized_pid{0};
+
+void ClaimDriverProcess() {
+  const int64_t current_pid = CurrentProcessId();
+  int64_t owner_pid = g_driver_initialized_pid.load(std::memory_order_acquire);
+  if (owner_pid == current_pid) return;
+  if (owner_pid != 0) {
+    throw RuntimeError(
+        "private NVIDIA CUDA Driver state was initialized before fork; use spawn/exec");
+  }
+  if (!g_driver_initialized_pid.compare_exchange_strong(
+          owner_pid, current_pid, std::memory_order_acq_rel,
+          std::memory_order_acquire) && owner_pid != current_pid) {
+    throw RuntimeError(
+        "private NVIDIA CUDA Driver state belongs to another process");
+  }
+}
+
+[[nodiscard]] std::string BoundText(std::string text,
+                                    size_t maximum_bytes =
+                                        kMaximumDiagnosticBytes) {
+  constexpr char kTruncated[] = " [truncated]";
+  constexpr size_t kTruncatedBytes = sizeof(kTruncated) - 1;
+  if (text.size() <= maximum_bytes) return text;
+  if (maximum_bytes <= kTruncatedBytes) {
+    text.resize(maximum_bytes);
+    return text;
+  }
+  text.resize(maximum_bytes - kTruncatedBytes);
+  text += kTruncated;
+  return text;
+}
+
+[[nodiscard]] std::string CopyBoundedCString(const char* text) {
+  if (text == nullptr) return {};
+  size_t length = 0;
+  while (length < kMaximumDriverTextBytes && text[length] != '\0') ++length;
+  return std::string(text, length);
+}
+
+template <typename Function>
+[[nodiscard]] Function FunctionFromAddress(void* address) noexcept {
+  static_assert(std::is_pointer_v<Function>,
+                "CUDA function typedef must be a pointer");
+  static_assert(sizeof(Function) == sizeof(address),
+                "CUDA function pointer and dlsym address must have equal size");
+  Function function = nullptr;
+  std::memcpy(&function, &address, sizeof(function));
+  return function;
+}
+
+template <typename Handle>
+[[nodiscard]] uintptr_t HandleAddress(Handle handle) noexcept {
+  static_assert(std::is_pointer_v<Handle>, "CUDA handle must be a pointer");
+  return reinterpret_cast<uintptr_t>(handle);
+}
+
+template <typename Handle>
+[[nodiscard]] Handle AddressHandle(uintptr_t address) noexcept {
+  static_assert(std::is_pointer_v<Handle>, "CUDA handle must be a pointer");
+  return reinterpret_cast<Handle>(address);
+}
+
+template <size_t Size>
+[[nodiscard]] std::string StringFromFixedBuffer(
+    const std::array<char, Size>& buffer, const char* description) {
+  const auto end = std::find(buffer.begin(), buffer.end(), '\0');
+  if (end == buffer.end()) {
+    throw RuntimeError(std::string(description) +
+                       " was not NUL-terminated by the CUDA Driver");
+  }
+  if (end == buffer.begin()) {
+    throw RuntimeError(std::string(description) +
+                       " was empty after a successful CUDA Driver query");
+  }
+  return std::string(buffer.begin(), end);
+}
+
+[[nodiscard]] std::string FormatUuid(const CUuuid& uuid) {
+  constexpr char kHex[] = "0123456789abcdef";
+  std::string formatted = "GPU-";
+  formatted.reserve(40);
+  for (size_t index = 0; index < sizeof(uuid.bytes); ++index) {
+    if (index == 4 || index == 6 || index == 8 || index == 10) {
+      formatted.push_back('-');
+    }
+    const auto byte = static_cast<unsigned char>(uuid.bytes[index]);
+    formatted.push_back(kHex[byte >> 4]);
+    formatted.push_back(kHex[byte & 0x0f]);
+  }
+  return formatted;
+}
+
+[[nodiscard]] uint64_t NonnegativeAttribute(int value,
+                                            const char* description) {
+  if (value < 0) {
+    throw RuntimeError(std::string("CUDA Driver returned a negative ") +
+                       description);
+  }
+  return static_cast<uint64_t>(value);
+}
+
+class DynamicNvidiaDriver final : public NvidiaDriverApi {
+ public:
+  DynamicNvidiaDriver() : owner_pid_(CurrentProcessId()) {}
+
+  ~DynamicNvidiaDriver() override {
+    if (CurrentProcessId() != owner_pid_) return;
+    std::lock_guard<std::mutex> lock(mutex_);
+    CloseLibraryLocked();
+  }
+
+  DynamicNvidiaDriver(const DynamicNvidiaDriver&) = delete;
+  DynamicNvidiaDriver& operator=(const DynamicNvidiaDriver&) = delete;
+
+  void Initialize() override {
+    RequireOwnerProcess();
+    // This lock-free latch is safe to inspect in a fork child before touching
+    // any inherited mutex. A child may initialize a freshly constructed
+    // executable only when no parent process attempted Driver initialization.
+    ClaimDriverProcess();
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (state_ == State::Ready) return;
+    if (state_ == State::Failed) throw RuntimeError(failure_message_);
+
+    try {
+      OpenAndResolveLocked();
+      state_ = State::Ready;
+    } catch (const std::exception& error) {
+      failure_message_ = BoundText(
+          std::string("private NVIDIA CUDA Driver initialization failed: ") +
+          error.what());
+      CloseLibraryLocked();
+      state_ = State::Failed;
+      throw RuntimeError(failure_message_);
+    }
+  }
