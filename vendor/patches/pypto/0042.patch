+
+std::shared_ptr<NvidiaDriverApi> GetProductionNvidiaDriver() {
+  // Each executable receives fresh, CUDA-free process state. Initialize's
+  // lock-free process latch rejects a child only after parent Driver use.
+  return std::make_shared<DynamicNvidiaDriver>();
+}
+
+}  // namespace pypto::runtime::nvidia::detail
