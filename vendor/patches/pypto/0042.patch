+namespace pypto::runtime::nvidia {
+namespace {
+
+constexpr int kCudaComputeModeProhibited = 2;
+constexpr uintptr_t kCudaLegacyStreamAddress = 1;
+constexpr uintptr_t kCudaPerThreadStreamAddress = 2;
+
+[[nodiscard]] int64_t CurrentProcessId() noexcept {
+  return static_cast<int64_t>(::getpid());
+}
+
+[[nodiscard]] uint64_t CheckedMultiply(uint64_t left, uint64_t right,
+                                       const char* description) {
+  if (right != 0 && left > std::numeric_limits<uint64_t>::max() / right) {
+    throw ValueError(std::string(description) + " overflows uint64");
+  }
+  return left * right;
+}
+
+[[nodiscard]] uint64_t CheckedAdd(uint64_t left, uint64_t right,
+                                  const char* description) {
+  if (left > std::numeric_limits<uint64_t>::max() - right) {
+    throw ValueError(std::string(description) + " overflows uint64");
+  }
+  return left + right;
+}
+
+[[nodiscard]] uint64_t CheckedDenseStride(const std::vector<int64_t>& shape,
+                                          size_t dimension) {
+  uint64_t stride = 1;
+  for (size_t index = dimension + 1; index < shape.size(); ++index) {
+    stride = CheckedMultiply(stride, static_cast<uint64_t>(shape[index]),
+                             "dense tensor stride");
+    if (stride > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+      throw ValueError("dense tensor stride exceeds int64");
+    }
+  }
+  return stride;
+}
+
+[[nodiscard]] uint32_t CheckedDimension(uint64_t value, uint32_t limit,
+                                        const char* description) {
+  if (value == 0 || value > limit ||
+      value > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError(std::string(description) + " is outside the live CUDA limit");
+  }
+  return static_cast<uint32_t>(value);
+}
+
+[[nodiscard]] uint64_t BlockThreadCount(
+    const std::array<uint32_t, 3>& dimensions) {
+  uint64_t threads = 1;
+  for (uint32_t dimension : dimensions) {
+    if (dimension == 0) throw ValueError("CUDA block dimensions must be positive");
+    threads = CheckedMultiply(threads, dimension, "CUDA block thread count");
+  }
+  return threads;
+}
+
+[[nodiscard]] std::vector<uint64_t> ExpectedParameterWidths(
+    const compiler::ArtifactArgumentLayout& layout) {
+  std::vector<uint64_t> widths;
+  widths.reserve(layout.GetTotalKernelArgumentCount());
+  for (const auto& descriptor : layout.GetOperandDescriptors()) {
+    if (descriptor.GetKind() == compiler::ArtifactOperandKind::Scalar) {
+      widths.push_back(descriptor.GetScalarSizeBytes());
+      continue;
+    }
+    widths.push_back(sizeof(uint64_t));
+    const uint32_t size_count = layout.HasUniformSignature()
+                                    ? descriptor.GetRank()
+                                    : descriptor.GetDynamicSizeCount();
+    const uint32_t stride_count = layout.HasUniformSignature()
+                                      ? static_cast<uint32_t>(descriptor.GetStrides().size())
+                                      : descriptor.GetDynamicStrideCount();
+    widths.insert(widths.end(), size_count + stride_count, sizeof(uint64_t));
+  }
+  if (widths.size() != layout.GetTotalKernelArgumentCount()) {
+    throw ValueError("Artifact flattened parameter widths do not match the argument count");
+  }
+  return widths;
+}
+
+void ValidateStaticExecutableInputs(const compiler::Artifact& artifact,
+                                    const compiler::CompileRequest& request) {
+  if (artifact.GetIdentities().GetCompileRequestByteIdentityDigest() !=
+      request.GetByteCompileIdentityDigest()) {
+    throw ValueError("NvidiaExecutable Artifact is not bound to the supplied CompileRequest");
+  }
+  if (artifact.GetBackendType() != backend::BackendType::Nvidia ||
+      artifact.GetActualArtifactKind() != compiler::ArtifactKind::Cubin ||
+      artifact.UsedFallback() ||
+      artifact.GetActualTarget().GetComputeCapability() !=
+          compiler::Artifact::kRequiredComputeCapability ||
+      artifact.GetActualTarget().GetName() != compiler::Artifact::kRequiredTargetName) {
+    throw ValueError("NvidiaExecutable requires a strict no-fallback SM120 Cubin Artifact");
+  }
+  const auto& target = request.GetTargetInfo();
+  if (target.GetTraits().GetComputeCapability() !=
+          artifact.GetActualTarget().GetComputeCapability() ||
+      target.GetArchConditionalArchitecture() != artifact.GetActualTarget().GetName()) {
+    throw ValueError("NvidiaExecutable request target differs from the Artifact target");
+  }
+  const auto& workspace = artifact.GetKernelAbi().GetWorkspaceAbi();
+  if (workspace.GetKind() != compiler::ArtifactWorkspaceKind::Static ||
+      workspace.GetSizeBytes() != 0 || workspace.GetAlignmentBytes() != 1) {
+    throw ValueError("NvidiaExecutable v1 accepts only zero-workspace Artifact ABI");
+  }
+  const auto& launch = artifact.GetKernelAbi().GetLaunchAbi();
+  if (launch.GetKernelArgumentSlotBytes() != sizeof(uint64_t) ||
+      launch.GetClusterSchedulingPolicy() !=
+          compiler::ArtifactClusterSchedulingPolicy::Spread) {
+    throw ValueError("NvidiaExecutable v1 received an unsupported launch ABI");
+  }
+  (void)BlockThreadCount(launch.GetBlockDimensions());
+  (void)ExpectedParameterWidths(artifact.GetKernelAbi().GetArgumentLayout());
+}
+
+void RequireSameField(bool same, const char* field) {
+  if (!same) {
+    throw RuntimeError(std::string("live NVIDIA device differs from CompileRequest field '") +
+                       field + "'");
+  }
+}
+
+[[nodiscard]] uint32_t ParseHexComponent(std::string_view text,
+                                         uint32_t maximum,
+                                         const char* description) {
+  if (text.empty() || text.size() > 8) {
+    throw RuntimeError(std::string("invalid NVIDIA ") + description);
+  }
+  uint32_t value = 0;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), value, 16);
+  if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size() ||
+      value > maximum) {
+    throw RuntimeError(std::string("invalid NVIDIA ") + description);
+  }
+  return value;
+}
+
+[[nodiscard]] std::array<uint32_t, 4> ParsePciIdentity(
+    std::string_view text) {
+  const size_t first_colon = text.find(':');
+  const size_t second_colon =
+      first_colon == std::string_view::npos
+          ? std::string_view::npos
+          : text.find(':', first_colon + 1);
+  const size_t dot = second_colon == std::string_view::npos
+                         ? std::string_view::npos
+                         : text.find('.', second_colon + 1);
+  if (first_colon == std::string_view::npos ||
+      second_colon == std::string_view::npos || dot == std::string_view::npos ||
+      text.find(':', second_colon + 1) != std::string_view::npos ||
+      text.find('.', dot + 1) != std::string_view::npos) {
+    throw RuntimeError("invalid NVIDIA PCI device identity");
+  }
+  return {
+      ParseHexComponent(text.substr(0, first_colon),
+                        std::numeric_limits<uint32_t>::max(), "PCI domain"),
+      ParseHexComponent(text.substr(first_colon + 1,
+                                    second_colon - first_colon - 1),
+                        0xff, "PCI bus"),
+      ParseHexComponent(text.substr(second_colon + 1, dot - second_colon - 1),
+                        0x1f, "PCI device"),
+      ParseHexComponent(text.substr(dot + 1), 0x7, "PCI function"),
+  };
+}
+
+[[nodiscard]] std::string NormalizeGpuUuid(std::string_view text) {
+  if (text.size() != 40 || text.substr(0, 4) != "GPU-" || text[12] != '-' ||
+      text[17] != '-' || text[22] != '-' || text[27] != '-') {
+    throw RuntimeError("invalid NVIDIA GPU UUID identity");
+  }
+  std::string normalized(text);
+  for (size_t index = 4; index < normalized.size(); ++index) {
+    if (normalized[index] == '-') continue;
+    const unsigned char value = static_cast<unsigned char>(normalized[index]);
+    if (!std::isxdigit(value)) {
+      throw RuntimeError("invalid NVIDIA GPU UUID identity");
+    }
+    normalized[index] = static_cast<char>(std::tolower(value));
+  }
+  return normalized;
+}
+
+void ValidateLiveDevice(const detail::NvidiaDeviceProperties& live,
+                        const compiler::NvidiaTargetInfo& expected) {
+  const auto& traits = expected.GetTraits();
+  RequireSameField(live.device_ordinal == expected.GetDeviceOrdinal(), "device_ordinal");
+  RequireSameField(live.name == expected.GetDeviceName(), "device_name");
+  RequireSameField(NormalizeGpuUuid(live.uuid) ==
+                       NormalizeGpuUuid(expected.GetDeviceUuid()),
+                   "device_uuid");
+  RequireSameField(ParsePciIdentity(live.pci_device_id) ==
+                       ParsePciIdentity(expected.GetPciDeviceId()),
+                   "pci_device_id");
+  RequireSameField(live.compute_capability == traits.GetComputeCapability(),
+                   "compute_capability");
+  RequireSameField(live.multiprocessor_count == traits.GetMultiprocessorCount(),
+                   "multiprocessor_count");
+  RequireSameField(live.warp_size == traits.GetWarpSize(), "warp_size");
+  RequireSameField(live.max_threads_per_block == traits.GetMaxThreadsPerBlock(),
+                   "max_threads_per_block");
+  RequireSameField(live.max_threads_per_multiprocessor ==
+                       traits.GetMaxThreadsPerMultiprocessor(),
+                   "max_threads_per_multiprocessor");
+  RequireSameField(live.max_blocks_per_multiprocessor ==
+                       traits.GetMaxBlocksPerMultiprocessor(),
+                   "max_blocks_per_multiprocessor");
+  RequireSameField(live.max_block_dim_x == traits.GetMaxBlockDimX(), "max_block_dim_x");
+  RequireSameField(live.max_block_dim_y == traits.GetMaxBlockDimY(), "max_block_dim_y");
+  RequireSameField(live.max_block_dim_z == traits.GetMaxBlockDimZ(), "max_block_dim_z");
+  RequireSameField(live.max_grid_dim_x == traits.GetMaxGridDimX(), "max_grid_dim_x");
+  RequireSameField(live.max_grid_dim_y == traits.GetMaxGridDimY(), "max_grid_dim_y");
+  RequireSameField(live.max_grid_dim_z == traits.GetMaxGridDimZ(), "max_grid_dim_z");
+  RequireSameField(live.l1_cache_line_bytes == traits.GetL1CacheLineBytes(),
+                   "l1_cache_line_bytes");
+  RequireSameField(live.default_shared_memory_per_cta_bytes ==
+                       traits.GetDefaultSharedMemoryPerCtaBytes(),
+                   "default_shared_memory_per_cta_bytes");
+  RequireSameField(live.max_shared_memory_per_cta_bytes ==
+                       traits.GetMaxSharedMemoryPerCtaBytes(),
+                   "max_shared_memory_per_cta_bytes");
+  RequireSameField(live.shared_memory_per_multiprocessor_bytes ==
+                       traits.GetSharedMemoryPerMultiprocessorBytes(),
+                   "shared_memory_per_multiprocessor_bytes");
+  RequireSameField(live.registers_per_cta == traits.GetRegistersPerCta(),
+                   "registers_per_cta");
+  RequireSameField(live.max_registers_per_thread == traits.GetMaxRegistersPerThread(),
+                   "max_registers_per_thread");
+  RequireSameField(live.registers_per_multiprocessor ==
+                       traits.GetRegistersPerMultiprocessor(),
+                   "registers_per_multiprocessor");
+  RequireSameField(live.l2_cache_size_bytes == traits.GetL2CacheSizeBytes(),
+                   "l2_cache_size_bytes");
+  RequireSameField(live.total_global_memory_bytes == traits.GetTotalGlobalMemoryBytes(),
+                   "total_global_memory_bytes");
+  if (live.compute_mode == kCudaComputeModeProhibited) {
+    throw RuntimeError("live NVIDIA device is in prohibited compute mode");
+  }
+}
+
+void ValidateFunction(const detail::NvidiaFunctionProperties& function,
+                      const compiler::ArtifactKernelAbi& kernel,
+                      const compiler::TargetTraits& target, int occupancy) {
+  const auto& launch = kernel.GetLaunchAbi();
+  const uint64_t block_threads = BlockThreadCount(launch.GetBlockDimensions());
+  if (function.binary_version != compiler::Artifact::kRequiredComputeCapability ||
+      function.max_threads_per_block <= 0 ||
+      block_threads > static_cast<uint64_t>(function.max_threads_per_block) ||
+      block_threads > static_cast<uint64_t>(target.GetMaxThreadsPerBlock())) {
+    throw RuntimeError("loaded CUDA function has incompatible binary or block limits");
+  }
+  if (function.static_shared_memory_bytes < 0 ||
+      function.max_dynamic_shared_memory_bytes < 0 || function.register_count < 0) {
+    throw RuntimeError("loaded CUDA function reports negative resource attributes");
+  }
+  const uint64_t dynamic_shared = launch.GetDynamicSharedMemoryBytes();
+  if (dynamic_shared > static_cast<uint64_t>(function.max_dynamic_shared_memory_bytes) ||
+      CheckedAdd(static_cast<uint64_t>(function.static_shared_memory_bytes),
+                 dynamic_shared, "total shared memory") >
+          target.GetMaxSharedMemoryPerCtaBytes()) {
+    throw RuntimeError("loaded CUDA function exceeds shared-memory limits");
+  }
+  const uint64_t registers = CheckedMultiply(
+      static_cast<uint64_t>(function.register_count), block_threads,
+      "CUDA register requirement");
+  if (static_cast<uint64_t>(function.register_count) >
+          target.GetMaxRegistersPerThread() ||
+      registers > target.GetRegistersPerCta()) {
+    throw RuntimeError("loaded CUDA function exceeds register limits");
+  }
+  if (function.cluster_size_must_be_set != 0 ||
+      function.required_cluster_width != 0 ||
+      function.required_cluster_height != 0 ||
+      function.required_cluster_depth != 0) {
+    throw RuntimeError("loaded CUDA function requires cluster dimensions absent from Artifact v1");
+  }
+  if (occupancy < 1 || occupancy > target.GetMaxBlocksPerMultiprocessor()) {
+    throw RuntimeError("loaded CUDA function has no legal resident block on the target");
+  }
+}
+
+[[nodiscard]] std::string BoundFailureMessage(const std::exception& error) {
+  std::string message = "NvidiaExecutable prewarm failed: ";
+  message += error.what();
+  constexpr size_t kMaximumFailureBytes = 4096;
+  if (message.size() > kMaximumFailureBytes) {
+    message.resize(kMaximumFailureBytes);
+    message += " [truncated]";
+  }
+  return message;
+}
