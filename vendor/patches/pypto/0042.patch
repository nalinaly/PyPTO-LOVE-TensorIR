+bool WaitForLifecycleWaiters(const NvidiaExecutable& executable,
+                             uint64_t minimum_waiters) {
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (std::chrono::steady_clock::now() < deadline) {
+    if (NvidiaExecutableTestAccess::GetLifecycleWaiterCount(executable) >=
+        minimum_waiters) {
+      return true;
+    }
+    std::this_thread::yield();
+  }
+  return false;
+}
