+template <typename Exception, typename Function>
+bool RejectsWith(Function&& function, std::string_view expected_fragment,
+                 std::string* message = nullptr) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const Exception& error) {
+    const std::string actual = error.what();
+    if (message != nullptr) *message = actual;
+    return actual.find(expected_fragment) != std::string::npos;
+  } catch (...) {
+    return false;
+  }
+  return false;
+}
