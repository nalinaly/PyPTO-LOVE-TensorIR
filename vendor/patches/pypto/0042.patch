+namespace detail {
+
+struct NvidiaPreparedLaunchData {
+  std::vector<uint64_t> argument_slots;
+  std::vector<void*> kernel_parameters;
+  std::vector<uint32_t> grid_dimensions;
+};
+
+struct NvidiaExecutableSharedState {
+  NvidiaExecutableSharedState(compiler::Artifact artifact_value,
+                              compiler::CompileRequest request_value,
+                              std::shared_ptr<NvidiaDriverApi> driver_value)
+      : artifact(std::move(artifact_value)),
+        request(std::move(request_value)),
+        driver(std::move(driver_value)),
+        creator_pid(CurrentProcessId()),
+        artifact_identity_digest(artifact.GetIdentityDigest()),
+        loader_compatibility_digest(artifact.GetLoaderCompatibilityDigest()) {}
+
+  ~NvidiaExecutableSharedState() {
+    if (CurrentProcessId() != creator_pid || module_address == 0 || !driver) return;
+    uintptr_t module = 0;
+    uintptr_t expected_context = 0;
+    uint64_t expected_context_id = 0;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (state != NvidiaExecutableState::Ready || active_launches != 0 ||
+          prepared_packets != 0 || graph_leases != 0) {
+        return;
+      }
+      module = module_address;
+      expected_context = context_address;
+      expected_context_id = context_id;
+      state = NvidiaExecutableState::Unloading;
+    }
+    try {
+      if (driver->GetCurrentContext() != expected_context ||
+          driver->GetContextId(expected_context) != expected_context_id) {
+        return;
+      }
+      driver->UnloadModule(module);
+    } catch (...) {
+      // Explicit Unload is the accepted path. Destruction never switches a
+      // framework context and leaks safely if that context is unavailable.
+    }
+  }
+
+  compiler::Artifact artifact;
+  compiler::CompileRequest request;
+  std::shared_ptr<NvidiaDriverApi> driver;
+  int64_t creator_pid;
+  std::string artifact_identity_digest;
+  std::string loader_compatibility_digest;
+
+  mutable std::mutex mutex;
+  std::condition_variable condition;
+  NvidiaExecutableState state = NvidiaExecutableState::Unloaded;
+  bool terminally_unloaded = false;
+  std::string failure_message;
+  uint32_t active_cuda_runtime_api_version = 0;
+  uintptr_t context_address = 0;
+  uint64_t context_id = 0;
+  int device_ordinal = -1;
+  uintptr_t module_address = 0;
+  uintptr_t function_address = 0;
+  uint64_t active_launches = 0;
+  uint64_t prepared_packets = 0;
+  uint64_t graph_leases = 0;
+  std::atomic<uint64_t> lifecycle_waiters{0};
+};
+
+uint64_t NvidiaExecutableTestAccess::GetLifecycleWaiterCount(
+    const NvidiaExecutable& executable) {
+  return executable.state_->lifecycle_waiters.load(std::memory_order_acquire);
+}
