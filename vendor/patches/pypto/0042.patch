+int ExpectLatchedPrewarmFailure(
+    const ArtifactSet& artifacts,
+    const std::function<void(FakeDriver&)>& configure,
+    std::string_view expected_fragment, size_t expected_unload_calls) {
+  auto driver = MakeFakeDriver(artifacts.request, {8, 8, 8});
+  configure(*driver);
+  auto executable =
+      MakeExecutable(artifacts.static_artifact, artifacts.request, driver);
+  std::string first_failure;
+  REQUIRE(RejectsWith<RuntimeError>(
+      [&]() { executable->Prewarm(kRuntimeApiVersion); }, expected_fragment,
+      &first_failure));
+  REQUIRE(executable->GetState() == NvidiaExecutableState::Failed);
+  REQUIRE(!executable->IsReady());
+  REQUIRE(executable->GetFailureMessage() == first_failure);
+  REQUIRE(driver->CountCalls("UnloadModule") == expected_unload_calls);
+  const std::vector<std::string> calls_after_failure = driver->GetCalls();
+
+  std::string repeated_failure;
+  REQUIRE(RejectsWith<RuntimeError>(
+      [&]() { executable->Prewarm(kRuntimeApiVersion); }, expected_fragment,
+      &repeated_failure));
+  REQUIRE(repeated_failure == first_failure);
+  REQUIRE(RejectsWith<RuntimeError>(
+      [&]() { (void)executable->PrepareLaunch(MakeStaticArguments()); },
+      expected_fragment, &repeated_failure));
+  REQUIRE(repeated_failure == first_failure);
+  REQUIRE(RejectsWith<RuntimeError>([&]() { executable->Unload(); },
+                                    expected_fragment, &repeated_failure));
+  REQUIRE(repeated_failure == first_failure);
+  REQUIRE(driver->GetCalls() == calls_after_failure);
+  return 0;
+}
