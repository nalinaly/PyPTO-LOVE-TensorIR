+# Keep process/context-owned NVIDIA runtime state in its own internal object
+# boundary. It is embedded in the single public pypto_core DSO today, but it
+# does not become compiler state and can move to a dedicated runtime product
+# without changing its public ABI. The backend-OFF product retains only the
+# fail-closed data/lifecycle surface and never compiles a CUDA driver resolver.
+set(PYPTO_NVIDIA_RUNTIME_SOURCES
+    src/runtime/nvidia/executable.cpp
+)
+if(PYPTO_ENABLE_NVIDIA_BACKEND)
+    list(APPEND PYPTO_NVIDIA_RUNTIME_SOURCES
+        src/runtime/nvidia/driver_api.cpp
+    )
+else()
+    list(APPEND PYPTO_NVIDIA_RUNTIME_SOURCES
+        src/runtime/nvidia/driver_api_stub.cpp
+    )
+endif()
+
+add_library(pypto_nvidia_runtime_objects OBJECT
+    ${PYPTO_NVIDIA_RUNTIME_SOURCES}
+)
+target_include_directories(pypto_nvidia_runtime_objects
+    PUBLIC
+        $<BUILD_INTERFACE:${CMAKE_SOURCE_DIR}/include>
+    PRIVATE
+        ${CMAKE_SOURCE_DIR}/src
+        ${CMAKE_SOURCE_DIR}
+        ${LIBBACKTRACE_INSTALL_DIR}/include
+)
+target_link_libraries(pypto_nvidia_runtime_objects PRIVATE
+    libbacktrace
+    ${CMAKE_DL_LIBS}
+)
+if(PYPTO_ENABLE_NVIDIA_BACKEND)
+    target_include_directories(pypto_nvidia_runtime_objects SYSTEM PRIVATE
+        ${CUDAToolkit_INCLUDE_DIRS}
+    )
+endif()
+if(TARGET pypto_nvidia_backend_identity)
+    target_link_libraries(pypto_nvidia_runtime_objects PRIVATE
+        pypto_nvidia_backend_identity
+    )
+endif()
+if(TARGET pypto_nvidia_provenance_guard)
+    add_dependencies(pypto_nvidia_runtime_objects
+        pypto_nvidia_provenance_guard)
+endif()
+set_target_properties(pypto_nvidia_runtime_objects PROPERTIES
+    POSITION_INDEPENDENT_CODE ON
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+)
+
