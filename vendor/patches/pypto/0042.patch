+void* operator new(size_t size) { return AllocateHost(size); }
+void* operator new[](size_t size) { return AllocateHost(size); }
+void* operator new(size_t size, std::align_val_t alignment) {
+  return AllocateAlignedHost(size, static_cast<size_t>(alignment));
+}
+void* operator new[](size_t size, std::align_val_t alignment) {
+  return AllocateAlignedHost(size, static_cast<size_t>(alignment));
