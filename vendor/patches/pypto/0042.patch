+      uint64_t dynamic_shared_memory_bytes) = 0;
+
+  [[nodiscard]] virtual NvidiaStreamBinding GetStreamBinding(
+      uintptr_t stream_address) = 0;
+  virtual void Launch(uintptr_t function_address,
+                      const NvidiaDriverLaunchConfig& config,
+                      const std::vector<void*>& kernel_parameters) = 0;
+  virtual void UnloadModule(uintptr_t module_address) = 0;
+};
+
+/** Lazy process-owned production driver; backend-OFF returns a fail-closed stub. */
+[[nodiscard]] std::shared_ptr<NvidiaDriverApi> GetProductionNvidiaDriver();
+
+/** Internal-only constructor access for deterministic CPU fake-driver tests. */
+class NvidiaExecutableTestAccess {
+ public:
+  [[nodiscard]] static std::unique_ptr<NvidiaExecutable> Create(
+      compiler::Artifact artifact, compiler::CompileRequest request,
+      std::shared_ptr<NvidiaDriverApi> driver) {
+    return std::unique_ptr<NvidiaExecutable>(
+        new NvidiaExecutable(std::move(artifact), std::move(request),
+                             std::move(driver)));
+  }
+
+  [[nodiscard]] static uint64_t GetLifecycleWaiterCount(
+      const NvidiaExecutable& executable);
+};
