+  [[nodiscard]] NvidiaDeviceProperties GetDeviceProperties(
+      int device_ordinal) override {
+    RequireCallable();
+    if (device_ordinal < 0) {
+      throw ValueError("CUDA device ordinal must be nonnegative");
+    }
+
+    CUdevice device = -1;
+    CheckCuda(device_get_(&device, device_ordinal), "cuDeviceGet");
+
+    std::array<char, kDeviceNameBytes> name{};
+    CheckCuda(device_get_name_(name.data(), static_cast<int>(name.size()),
+                               device),
+              "cuDeviceGetName");
+
+    CUuuid uuid{};
+    CheckCuda(device_get_uuid_(&uuid, device), "cuDeviceGetUuid");
+
+    std::array<char, kPciBusIdBytes> pci_bus_id{};
+    CheckCuda(device_get_pci_bus_id_(pci_bus_id.data(),
+                                     static_cast<int>(pci_bus_id.size()),
+                                     device),
+              "cuDeviceGetPCIBusId");
+
+    const int compute_major = DeviceAttribute(
+        device, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR);
+    const int compute_minor = DeviceAttribute(
+        device, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR);
+    if (compute_major < 0 || compute_minor < 0 || compute_major > 9999 ||
+        compute_minor > 9) {
+      throw RuntimeError(
+          "CUDA Driver returned an invalid compute capability");
+    }
+
+    size_t total_global_memory = 0;
+    CheckCuda(device_total_memory_(&total_global_memory, device),
+              "cuDeviceTotalMem");
+
+    NvidiaDeviceProperties properties;
+    properties.device_ordinal = device_ordinal;
+    properties.name = StringFromFixedBuffer(name, "CUDA device name");
+    properties.uuid = FormatUuid(uuid);
+    properties.pci_device_id =
+        StringFromFixedBuffer(pci_bus_id, "CUDA PCI bus ID");
+    properties.compute_capability = compute_major * 10 + compute_minor;
+    properties.multiprocessor_count =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MULTIPROCESSOR_COUNT);
+    properties.warp_size =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_WARP_SIZE);
+    properties.max_threads_per_block =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_THREADS_PER_BLOCK);
+    properties.max_threads_per_multiprocessor = DeviceAttribute(
+        device, CU_DEVICE_ATTRIBUTE_MAX_THREADS_PER_MULTIPROCESSOR);
+    properties.max_blocks_per_multiprocessor = DeviceAttribute(
+        device, CU_DEVICE_ATTRIBUTE_MAX_BLOCKS_PER_MULTIPROCESSOR);
+    properties.max_block_dim_x =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_BLOCK_DIM_X);
+    properties.max_block_dim_y =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_BLOCK_DIM_Y);
+    properties.max_block_dim_z =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_BLOCK_DIM_Z);
+    properties.max_grid_dim_x =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_GRID_DIM_X);
+    properties.max_grid_dim_y =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_GRID_DIM_Y);
+    properties.max_grid_dim_z =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_GRID_DIM_Z);
+    // CUDA exposes neither quantity as a device attribute. These are the
+    // architecture constants accepted by the immutable SM120 TargetTraits.
+    properties.l1_cache_line_bytes = kSm120L1CacheLineBytes;
+    properties.default_shared_memory_per_cta_bytes = NonnegativeAttribute(
+        DeviceAttribute(device,
+                        CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_BLOCK),
+        "default shared-memory-per-CTA attribute");
+    properties.max_shared_memory_per_cta_bytes = NonnegativeAttribute(
+        DeviceAttribute(
+            device, CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_BLOCK_OPTIN),
+        "maximum shared-memory-per-CTA attribute");
+    properties.shared_memory_per_multiprocessor_bytes = NonnegativeAttribute(
+        DeviceAttribute(
+            device,
+            CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_MULTIPROCESSOR),
+        "shared-memory-per-multiprocessor attribute");
+    properties.registers_per_cta = NonnegativeAttribute(
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_MAX_REGISTERS_PER_BLOCK),
+        "registers-per-CTA attribute");
+    properties.max_registers_per_thread =
+        kSm120MaximumRegistersPerThread;
+    properties.registers_per_multiprocessor = NonnegativeAttribute(
+        DeviceAttribute(
+            device, CU_DEVICE_ATTRIBUTE_MAX_REGISTERS_PER_MULTIPROCESSOR),
+        "registers-per-multiprocessor attribute");
+    properties.l2_cache_size_bytes = NonnegativeAttribute(
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_L2_CACHE_SIZE),
+        "L2 cache size attribute");
+    properties.total_global_memory_bytes =
+        static_cast<uint64_t>(total_global_memory);
+    properties.compute_mode =
+        DeviceAttribute(device, CU_DEVICE_ATTRIBUTE_COMPUTE_MODE);
+    return properties;
+  }
+
+  [[nodiscard]] uintptr_t LoadModule(
+      const std::vector<uint8_t>& cubin) override {
+    RequireCallable();
+    if (cubin.empty()) throw ValueError("CUDA Cubin must not be empty");
+    CUmodule module = nullptr;
+    CheckCuda(module_load_data_(&module, cubin.data()), "cuModuleLoadData");
+    if (module == nullptr) {
+      throw RuntimeError(
+          "cuModuleLoadData returned a null module after success");
+    }
+    return HandleAddress(module);
+  }
+
+  [[nodiscard]] uintptr_t GetFunction(uintptr_t module_address,
+                                      const std::string& entry_name) override {
+    RequireCallable();
+    if (module_address == 0) {
+      throw ValueError("cannot query a function from a null CUDA module");
+    }
+    if (entry_name.empty() || entry_name.find('\0') != std::string::npos) {
+      throw ValueError("CUDA entry name must be nonempty and contain no NUL");
+    }
+    CUfunction function = nullptr;
+    CheckCuda(module_get_function_(
+                  &function, AddressHandle<CUmodule>(module_address),
+                  entry_name.c_str()),
+              "cuModuleGetFunction");
+    if (function == nullptr) {
+      throw RuntimeError(
+          "cuModuleGetFunction returned a null function after success");
+    }
+    return HandleAddress(function);
+  }
+
+  void ForceFunctionLoad(uintptr_t function_address) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    CheckCuda(func_load_(AddressHandle<CUfunction>(function_address)),
+              "cuFuncLoad");
+  }
+
+  [[nodiscard]] bool IsFunctionLoaded(uintptr_t function_address) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    CUfunctionLoadingState state = CU_FUNCTION_LOADING_STATE_MAX;
+    CheckCuda(func_is_loaded_(&state,
+                              AddressHandle<CUfunction>(function_address)),
+              "cuFuncIsLoaded");
+    if (state != CU_FUNCTION_LOADING_STATE_UNLOADED &&
+        state != CU_FUNCTION_LOADING_STATE_LOADED) {
+      throw RuntimeError(
+          "cuFuncIsLoaded returned an unknown function loading state");
+    }
+    return state == CU_FUNCTION_LOADING_STATE_LOADED;
+  }
+
+  [[nodiscard]] std::optional<NvidiaFunctionParameterInfo>
+  GetFunctionParameterInfo(uintptr_t function_address,
+                           uint32_t index) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    size_t offset = 0;
+    size_t size = 0;
+    const CUresult result = func_get_param_info_(
+        AddressHandle<CUfunction>(function_address),
+        static_cast<size_t>(index), &offset, &size);
+    // cuFuncGetParamInfo deliberately has no count query in the loader's
+    // minimum API. INVALID_VALUE at the first absent index is the ABI sentinel.
+    if (result == CUDA_ERROR_INVALID_VALUE) return std::nullopt;
+    CheckCuda(result, "cuFuncGetParamInfo");
+    return NvidiaFunctionParameterInfo{static_cast<uint64_t>(offset),
+                                       static_cast<uint64_t>(size)};
+  }
+
+  [[nodiscard]] NvidiaFunctionProperties GetFunctionProperties(
+      uintptr_t function_address) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    const CUfunction function = AddressHandle<CUfunction>(function_address);
+
+    NvidiaFunctionProperties properties;
+    properties.binary_version =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_BINARY_VERSION);
+    properties.max_threads_per_block =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_MAX_THREADS_PER_BLOCK);
+    properties.static_shared_memory_bytes =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_SHARED_SIZE_BYTES);
+    properties.max_dynamic_shared_memory_bytes = FunctionAttribute(
+        function, CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES);
+    properties.register_count =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_NUM_REGS);
+    properties.required_cluster_width =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_REQUIRED_CLUSTER_WIDTH);
+    properties.required_cluster_height =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_REQUIRED_CLUSTER_HEIGHT);
+    properties.required_cluster_depth =
+        FunctionAttribute(function, CU_FUNC_ATTRIBUTE_REQUIRED_CLUSTER_DEPTH);
+    properties.cluster_size_must_be_set = FunctionAttribute(
+        function, CU_FUNC_ATTRIBUTE_CLUSTER_SIZE_MUST_BE_SET);
+    return properties;
+  }
+
+  [[nodiscard]] int GetActiveBlocksPerMultiprocessor(
+      uintptr_t function_address, uint32_t block_threads,
+      uint64_t dynamic_shared_memory_bytes) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    if (block_threads == 0 ||
+        block_threads > static_cast<uint32_t>(std::numeric_limits<int>::max())) {
+      throw ValueError("CUDA occupancy block size is outside the int range");
+    }
+    if (dynamic_shared_memory_bytes >
+        static_cast<uint64_t>(std::numeric_limits<size_t>::max())) {
+      throw ValueError(
+          "CUDA occupancy dynamic shared memory exceeds size_t");
+    }
+    int active_blocks = -1;
+    CheckCuda(occupancy_max_active_blocks_(
+                  &active_blocks, AddressHandle<CUfunction>(function_address),
+                  static_cast<int>(block_threads),
+                  static_cast<size_t>(dynamic_shared_memory_bytes)),
+              "cuOccupancyMaxActiveBlocksPerMultiprocessor");
+    if (active_blocks < 0) {
+      throw RuntimeError("CUDA Driver returned a negative occupancy");
+    }
+    return active_blocks;
+  }
+
+  [[nodiscard]] NvidiaStreamBinding GetStreamBinding(
+      uintptr_t stream_address) override {
+    RequireCallable();
+    if (stream_address == 0 || stream_address == kCudaLegacyStreamAddress ||
+        stream_address == kCudaPerThreadStreamAddress) {
+      throw ValueError(
+          "cannot query a CUDA null, legacy or per-thread default stream");
+    }
+    CUcontext context = nullptr;
+    CUgreenCtx green_context = nullptr;
+    CheckCuda(stream_get_ctx_(AddressHandle<CUstream>(stream_address), &context,
+                              &green_context),
+              "cuStreamGetCtx");
+    return NvidiaStreamBinding{HandleAddress(context),
+                               HandleAddress(green_context)};
+  }
+
+  void Launch(uintptr_t function_address,
+              const NvidiaDriverLaunchConfig& config,
+              const std::vector<void*>& kernel_parameters) override {
+    RequireCallable();
+    CheckFunctionAddress(function_address);
+    if (config.stream_address == 0 ||
+        config.stream_address == kCudaLegacyStreamAddress ||
+        config.stream_address == kCudaPerThreadStreamAddress) {
+      throw ValueError("CUDA launch requires a non-default caller-owned stream");
+    }
+    for (uint32_t dimension : config.grid_dimensions) {
+      if (dimension == 0) {
+        throw ValueError("CUDA launch grid dimensions must be positive");
+      }
+    }
+    for (uint32_t dimension : config.block_dimensions) {
+      if (dimension == 0) {
+        throw ValueError("CUDA launch block dimensions must be positive");
+      }
+    }
+    if (config.dynamic_shared_memory_bytes >
+        std::numeric_limits<unsigned int>::max()) {
+      throw ValueError(
+          "CUDA launch dynamic shared memory exceeds unsigned int");
+    }
+    if (config.cluster_scheduling_policy !=
+        compiler::ArtifactClusterSchedulingPolicy::Spread) {
+      throw ValueError(
+          "CUDA launch requires the Artifact spread cluster policy");
+    }
+    if (std::any_of(kernel_parameters.begin(), kernel_parameters.end(),
+                    [](const void* parameter) { return parameter == nullptr; })) {
+      throw ValueError("CUDA kernel parameter storage must be non-null");
+    }
+
+    CUlaunchAttribute attribute{};
+    attribute.id =
+        CU_LAUNCH_ATTRIBUTE_CLUSTER_SCHEDULING_POLICY_PREFERENCE;
+    attribute.value.clusterSchedulingPolicyPreference =
+        CU_CLUSTER_SCHEDULING_POLICY_SPREAD;
+
+    CUlaunchConfig cuda_config{};
+    cuda_config.gridDimX = config.grid_dimensions[0];
+    cuda_config.gridDimY = config.grid_dimensions[1];
+    cuda_config.gridDimZ = config.grid_dimensions[2];
+    cuda_config.blockDimX = config.block_dimensions[0];
+    cuda_config.blockDimY = config.block_dimensions[1];
+    cuda_config.blockDimZ = config.block_dimensions[2];
+    cuda_config.sharedMemBytes =
+        static_cast<unsigned int>(config.dynamic_shared_memory_bytes);
+    cuda_config.hStream = AddressHandle<CUstream>(config.stream_address);
+    cuda_config.attrs = &attribute;
+    cuda_config.numAttrs = 1;
+
+    void** parameters =
+        kernel_parameters.empty()
+            ? nullptr
+            : const_cast<void**>(kernel_parameters.data());
+    CheckCuda(launch_kernel_ex_(&cuda_config,
+                                AddressHandle<CUfunction>(function_address),
+                                parameters, nullptr),
+              "cuLaunchKernelEx");
+  }
+
+  void UnloadModule(uintptr_t module_address) override {
+    RequireCallable();
+    if (module_address == 0) {
+      throw ValueError("cannot unload a null CUDA module");
+    }
+    CheckCuda(module_unload_(AddressHandle<CUmodule>(module_address)),
+              "cuModuleUnload");
+  }
