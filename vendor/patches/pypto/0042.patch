+NvidiaLaunchArgument NvidiaLaunchArgument::Scalar(
+    std::vector<uint8_t> value_bytes) {
+  if (value_bytes.empty() || value_bytes.size() > sizeof(uint64_t)) {
+    throw ValueError("NVIDIA scalar value must contain 1 through 8 bytes");
+  }
+  return NvidiaLaunchArgument(NvidiaLaunchArgumentKind::Scalar, 0, {}, {},
+                              std::move(value_bytes));
+}
