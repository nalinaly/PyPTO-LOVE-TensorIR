+std::string EmitNativeTileGdnReadSource(
+    const NativeTileGdnReadGraph& graph) {
+  StaticTensor query_batched = graph.query;
+  query_batched.shape = {graph.query.shape[0], 1, graph.query.shape[1]};
+  query_batched.dense_strides =
+      MakeDenseStridesForMetadata(query_batched.shape);
+  StaticTensor read_batched = graph.result;
+  read_batched.shape = {graph.result.shape[0], 1, graph.result.shape[1]};
+  read_batched.dtype = DataType::FP32;
+  read_batched.dense_strides = MakeDenseStridesForMetadata(read_batched.shape);
+  StaticTensor wide_query = graph.query;
+  wide_query.dtype = DataType::FP32;
+  StaticTensor wide_value = graph.value;
+  wide_value.dtype = DataType::FP32;
+  StaticTensor dot = wide_query;
+  dot.shape[1] = 1;
+  dot.dense_strides = {1, 1};
+
+  const std::string query_type = TensorTypeText(graph.query);
+  const std::string query_batched_type = TensorTypeText(query_batched);
+  const std::string value_type = TensorTypeText(graph.value);
+  const std::string state_type = TensorTypeText(graph.state);
+  const std::string read_batched_type = TensorTypeText(read_batched);
+  const std::string result_type = TensorTypeText(graph.result);
+  const std::string wide_query_type = TensorTypeText(wide_query);
+  const std::string wide_value_type = TensorTypeText(wide_value);
+  const std::string dot_type = TensorTypeText(dot);
+
+  std::string source;
+  source.reserve(4096);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg3: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg4: ";
+  source += TensorWithStrideText(graph.value);
+  source += ",\n    %arg5: ";
+  source += TensorWithStrideText(graph.state);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %qdecay = mul %arg0, %arg1 : ";
+  source += query_type;
+  source += "\n    %qbatch = reshape %qdecay : ";
+  source += query_type;
+  source += " -> ";
+  source += query_batched_type;
+  source += "\n    %read_batch = matmul(%qbatch, %arg5)\n      : (";
+  source += query_batched_type;
+  source += ", ";
+  source += state_type;
+  source += ") -> ";
+  source += read_batched_type;
+  source += "\n    %read = reshape %read_batch : ";
+  source += read_batched_type;
+  source += " -> ";
+  source += wide_value_type;
+  source += "\n    %qwide = convert %arg0 : ";
+  source += query_type;
+  source += " -> ";
+  source += wide_query_type;
+  source += "\n    %gwide = convert %arg2 : ";
+  source += query_type;
+  source += " -> ";
+  source += wide_query_type;
+  source += "\n    %kwide = convert %arg3 : ";
+  source += query_type;
+  source += " -> ";
+  source += wide_query_type;
+  source += "\n    %vwide = convert %arg4 : ";
+  source += value_type;
+  source += " -> ";
+  source += wide_value_type;
+  source += "\n    %gexp = exp %gwide : ";
+  source += wide_query_type;
+  source += "\n    %one = constant 1.0 : f32\n    %ones = splat %one : ";
+  source += wide_query_type;
+  source += "\n    %gshift = add %gexp, %ones : ";
+  source += wide_query_type;
+  source += "\n    %softplus = log %gshift : ";
+  source += wide_query_type;
+  source += "\n    %gated_key = mul %softplus, %kwide : ";
+  source += wide_query_type;
+  source += "\n    %composed = mul %qwide, %gated_key : ";
+  source += wide_query_type;
+  source += "\n    %dot = reduce(%composed) <dimensions = [1], reduction_mode = <add>> : ";
+  source += wide_query_type;
+  source += " -> ";
+  source += dot_type;
+  source += "\n    %dot_broadcast = broadcast %dot : ";
+  source += dot_type;
+  source += " -> ";
+  source += wide_value_type;
+  source += "\n    %delta = mul %vwide, %dot_broadcast : ";
+  source += wide_value_type;
+  source += "\n    %combined = add %read, %delta : ";
+  source += wide_value_type;
+  source += "\n    %result0 = convert %combined : ";
+  source += wide_value_type;
+  source += " -> ";
+  source += result_type;
+  source += "\n    results %result0 : ";
+  source += result_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
+
 bool IsLegacyStaticAddV1Candidate(const ir::ProgramPtr& program) {
   if (!program || program->functions_.size() != 1) return false;
   const ir::FunctionPtr& function = program->functions_.begin()->second;
@@ -3207,6 +3450,29 @@ TensorIrModule EmitLegacyStaticAddV1(const ir::ProgramPtr& program) {
 }  // namespace detail
 
 TensorIrModule EmitTensorIr(const ir::ProgramPtr& program) {
+  if (IsNativeTileGdnReadCandidate(program)) {
+    const NativeTileGdnReadGraph graph = AnalyzeNativeTileGdnRead(program);
+    std::vector<TensorIrValueMetadata> metadata;
+    metadata.reserve(7);
+    for (uint32_t index = 0; index < 4; ++index) {
+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Input, index, graph.query.dtype,
+          graph.query.shape, graph.query.dense_strides,
+          /*has_explicit_strides=*/true));
+    }
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 4, graph.value.dtype, graph.value.shape,
+        graph.value.dense_strides, /*has_explicit_strides=*/true));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 5, graph.state.dtype, graph.state.shape,
+        graph.state.dense_strides, /*has_explicit_strides=*/true));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype, graph.result.shape,
+        graph.result.dense_strides, /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::FusedPointwiseV2,
+                          EmitNativeTileGdnReadSource(graph),
+                          std::move(metadata), /*input_count=*/6);
+  }
   if (IsNativeTileAttentionCandidate(program)) {
     const NativeTileAttentionGraph graph = AnalyzeNativeTileAttention(program);
     std::vector<TensorIrValueMetadata> metadata;
