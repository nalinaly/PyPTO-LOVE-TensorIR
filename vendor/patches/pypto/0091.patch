+struct NativeTileGdnReadGraph {
+  StaticTensor query;
+  StaticTensor value;
+  StaticTensor state;
+  StaticTensor result;
+};
+
+bool IsNativeTileGdnReadCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 7) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  const ir::SeqStmtsPtr& leaf = loop_nest.leaf;
+  if (!leaf || leaf->stmts_.size() != 24) return false;
+  const auto matmul_assignment = ir::As<ir::AssignStmt>(leaf->stmts_[8]);
+  const auto matmul_call =
+      matmul_assignment ? ir::As<ir::Call>(matmul_assignment->value_) : nullptr;
+  return matmul_call && ir::IsOp(matmul_call, "tile.matmul");
+}
+
+NativeTileGdnReadGraph AnalyzeNativeTileGdnRead(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native GDN read must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 7 ||
+      function->param_directions_.size() != 7 ||
+      function->return_types_.size() != 1) {
+    Reject("native GDN read requires six inputs and one output",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 6; ++index) {
+    if (function->param_directions_[index] != ir::ParamDirection::In) {
+      Reject("native GDN read inputs must have direction In",
+             &function->span_);
+    }
+  }
+  if (function->param_directions_[6] != ir::ParamDirection::Out) {
+    Reject("native GDN read output must have direction Out", &function->span_);
+  }
+  const StaticTensor query = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native GDN query");
+  for (size_t index = 1; index <= 3; ++index) {
+    const StaticTensor tensor = ReadStaticTensor(
+        function->params_[index]->GetType(), function->params_[index]->span_,
+        "native GDN key-like input");
+    if (!SameTensor(query, tensor)) {
+      Reject("native GDN query/decay/gate/key shapes must match",
+             &function->params_[index]->span_);
+    }
+  }
+  const StaticTensor value = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native GDN value");
+  const StaticTensor state = ReadStaticTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native GDN state");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[6]->GetType(), function->params_[6]->span_,
+      "native GDN result");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_, "native GDN return");
+  if (query.dtype != DataType::BF16 || value.dtype != DataType::BF16 ||
+      state.dtype != DataType::BF16 || result.dtype != DataType::BF16 ||
+      query.shape.size() != 2 || value.shape.size() != 2 ||
+      state.shape.size() != 3 || result.shape.size() != 2 ||
+      query.shape[0] != value.shape[0] || query.shape[0] != state.shape[0] ||
+      query.shape[0] != result.shape[0] || query.shape[1] != state.shape[1] ||
+      value.shape[1] != state.shape[2] || value.shape[1] != result.shape[1] ||
+      !SameTensor(value, result) || !SameTensor(result, declared) ||
+      query.shape[1] % 128 != 0 || value.shape[1] % 16 != 0) {
+    Reject("native GDN query/value/state/result shapes are incompatible",
+           &function->span_);
+  }
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None || !scope->attrs_.empty() ||
+      !returned_var || returned_var.get() != function->params_[6].get()) {
+    Reject("native GDN read scope or return is invalid", &function->span_);
+  }
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  const ir::SeqStmtsPtr& leaf = loop_nest.leaf;
+  if (loop_nest.repetitions != static_cast<uint64_t>(query.shape[0]) ||
+      !leaf || leaf->stmts_.size() != 24) {
+    Reject("native GDN head loop is invalid", &scope->span_);
+  }
+  constexpr std::array<std::string_view, 23> kExpectedOps = {
+      "tile.load", "tile.load", "tile.load", "tile.load", "tile.load",
+      "tile.load", "tile.reshape", "tile.mul", "tile.matmul", "tile.cast",
+      "tile.cast", "tile.cast", "tile.cast", "tile.exp", "tile.adds",
+      "tile.log", "tile.mul", "tile.mul", "tile.create", "tile.row_sum",
+      "tile.row_expand_mul", "tile.add", "tile.cast"};
+  for (size_t index = 0; index < kExpectedOps.size(); ++index) {
+    const auto assignment = ir::As<ir::AssignStmt>(leaf->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, std::string(kExpectedOps[index]))) {
+      Reject("native GDN tile operation sequence is invalid",
+             &leaf->stmts_[index]->span_);
+    }
+  }
+  const auto store_statement = ir::As<ir::EvalStmt>(leaf->stmts_.back());
+  const auto store =
+      store_statement ? ir::As<ir::Call>(store_statement->expr_) : nullptr;
+  if (!store || !ir::IsOp(store, "tile.store")) {
+    Reject("native GDN read must end in tile.store", &leaf->stmts_.back()->span_);
+  }
+  return NativeTileGdnReadGraph{query, value, state, result};
+}
+
 bool IsNativeTileAttentionCandidate(const ir::ProgramPtr& program) {
   if (!IsNativeTilePointwiseCandidate(program)) return false;
   const ir::FunctionPtr& function = program->functions_.begin()->second;
@@ -2839,6 +2967,121 @@ std::string EmitNativeTileAttentionSource(
