   return StaticTensor{tensor_type->dtype_, shape, MakeDenseStrides(shape, span)};
 }
 
+StaticTensor ReadStaticNdStridedTensor(const ir::TypePtr& type,
+                                       const ir::Span& span,
+                                       std::string_view location) {
+  const auto tensor_type = ir::As<ir::TensorType>(type);
+  if (!tensor_type || tensor_type->memref_.has_value()) {
+    Reject(std::string(location) + " must have plain TensorType", &span);
+  }
+  if (!tensor_type->tensor_view_.has_value()) {
+    return ReadStaticTensor(type, span, location);
+  }
+  if (tensor_type->dtype_ != DataType::BF16 &&
+      tensor_type->dtype_ != DataType::FP32) {
+    Reject(std::string(location) + " dtype must be BF16 or FP32, got " +
+               tensor_type->dtype_.ToString(),
+           &span);
+  }
+  if (tensor_type->shape_.empty() ||
+      tensor_type->shape_.size() > kMaximumRank) {
+    Reject(std::string(location) + " rank must be between 1 and 32", &span);
+  }
+  const ir::TensorView& view = *tensor_type->tensor_view_;
+  if (view.layout != ir::TensorLayout::ND || !view.valid_shape.empty() ||
+      view.pad != ir::PadValue::null ||
+      view.stride.size() != tensor_type->shape_.size()) {
+    Reject(std::string(location) +
+               " supports only a complete unpadded ND TensorView stride",
+           &span);
+  }
+
+  std::vector<int64_t> shape;
+  std::vector<int64_t> strides;
+  shape.reserve(tensor_type->shape_.size());
+  strides.reserve(view.stride.size());
+  for (const ir::ExprPtr& dimension : tensor_type->shape_) {
+    const auto constant = ir::As<ir::ConstInt>(dimension);
+    if (!constant || constant->dtype() != DataType::INDEX ||
+        constant->value_ <= 0) {
+      Reject(std::string(location) +
+                 " shape must be fully static and positive",
+             &span);
+    }
+    shape.push_back(constant->value_);
+  }
+  for (const ir::ExprPtr& stride : view.stride) {
+    const auto constant = ir::As<ir::ConstInt>(stride);
+    if (!constant || constant->dtype() != DataType::INDEX ||
+        constant->value_ < 0) {
+      Reject(std::string(location) +
+                 " strides must be non-negative static INDEX values",
+             &span);
+    }
+    strides.push_back(constant->value_);
+  }
+  return StaticTensor{tensor_type->dtype_, shape, strides};
+}
+
