   return false;
 }
 
+std::string MaterializedProducerSource(
+    const PreparedStructuredTensorIrCompilation& prepared) {
+  const auto& input = prepared.GetProducerInput();
+  if (!input.typed_module_spec.has_value()) {
+    return std::string(prepared.GetCanonicalSource().begin(),
+                       prepared.GetCanonicalSource().end());
+  }
+  std::string diagnostic;
+  const auto built = BuildTypedTensorIrModule(*input.typed_module_spec,
+                                              diagnostic);
+  return built.has_value()
+             ? std::string(built->canonical_source.begin(),
+                           built->canonical_source.end())
+             : std::string{};
+}
+
+std::string MaterializedProducerDigest(
+    const PreparedStructuredTensorIrCompilation& prepared) {
+  const std::string source = MaterializedProducerSource(prepared);
+  const std::vector<uint8_t> bytes(source.begin(), source.end());
+  return Artifact::ComputeSourceIrDigest(bytes);
+}
+
+KernelBuildSpec FinalizeForTest(
+    const PreparedStructuredTensorIrCompilation& prepared,
+    const ArtifactKernelAbi& kernel) {
+  if (prepared.GetProducerInput().typed_module_spec.has_value()) {
+    return FinalizeStructuredTensorIrBuildSpec(
+        prepared, kernel, MaterializedProducerDigest(prepared));
+  }
+  return FinalizeStructuredTensorIrBuildSpec(prepared, kernel);
+}
