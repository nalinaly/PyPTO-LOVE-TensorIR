---
 tests/ut/cpp/tensor_ir_codegen_test.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/ut/cpp/tensor_ir_codegen_test.cpp b/tests/ut/cpp/tensor_ir_codegen_test.cpp
index 0aa0758828b18bd0d4c2045da7077522fede8011..1164dc31371b83d7c14dc6e7aac975c1aa1274e6 100644
--- a/tests/ut/cpp/tensor_ir_codegen_test.cpp
+++ b/tests/ut/cpp/tensor_ir_codegen_test.cpp
@@ -1184,7 +1184,7 @@ int TestFusedPointwiseV2Rejections() {
       [&] {
         (void)EmitTensorIr(program_with(
             {std::make_shared<ir::AssignStmt>(
-                 unsupported_result, OpCall("tensor.div", {x, y}, type), TestSpan()),
+                 unsupported_result, OpCall("tensor.fmod", {x, y}, type), TestSpan()),
              std::make_shared<ir::ReturnStmt>(
                  std::vector<ir::ExprPtr>{unsupported_result}, TestSpan())}));
       },
