+std::string EmitNativeTileGdnProjectionSource(
+    const NativeTileGdnProjectionGraph& graph) {
+  StaticTensor z_flat = graph.z;
+  z_flat.shape = {graph.z.shape[0], graph.z.shape[1] * graph.z.shape[2]};
+  z_flat.dense_strides = MakeDenseStridesForMetadata(z_flat.shape);
+  const std::string qkvz_type = TensorTypeText(graph.projected_qkvz);
+  const std::string ba_type = TensorTypeText(graph.projected_ba);
+  const std::string mixed_type = TensorTypeText(graph.mixed_qkv);
+  const std::string z_flat_type = TensorTypeText(z_flat);
+  const std::string z_type = TensorTypeText(graph.z);
+  const std::string gate_type = TensorTypeText(graph.b);
+  const int64_t rows = graph.projected_qkvz.shape[0];
+  const int64_t mixed_width = graph.mixed_qkv.shape[1];
+  const int64_t z_width = z_flat.shape[1];
+  const int64_t gate_width = graph.b.shape[1];
+
+  std::string source;
+  source.reserve(2048);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.projected_qkvz);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.projected_ba);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.mixed_qkv);
+  source += ", ";
+  source += TensorWithStrideText(graph.z);
+  source += ", ";
+  source += TensorWithStrideText(graph.b);
+  source += ", ";
+  source += TensorWithStrideText(graph.a);
+  source += ") {\n    %mixed = slice %arg0 starts = [0, 0] limits = [";
+  source += std::to_string(rows);
+  source += ", ";
+  source += std::to_string(mixed_width);
+  source += "] strides = [1, 1] : ";
+  source += qkvz_type;
+  source += " -> ";
+  source += mixed_type;
+  source += "\n    %z_flat = slice %arg0 starts = [0, ";
+  source += std::to_string(mixed_width);
+  source += "] limits = [";
+  source += std::to_string(rows);
+  source += ", ";
+  source += std::to_string(mixed_width + z_width);
+  source += "] strides = [1, 1] : ";
+  source += qkvz_type;
+  source += " -> ";
+  source += z_flat_type;
+  source += "\n    %z = reshape %z_flat : ";
+  source += z_flat_type;
+  source += " -> ";
+  source += z_type;
+  source += "\n    %b = slice %arg1 starts = [0, 0] limits = [";
+  source += std::to_string(rows);
+  source += ", ";
+  source += std::to_string(gate_width);
+  source += "] strides = [1, 1] : ";
+  source += ba_type;
+  source += " -> ";
+  source += gate_type;
+  source += "\n    %a = slice %arg1 starts = [0, ";
+  source += std::to_string(gate_width);
+  source += "] limits = [";
+  source += std::to_string(rows);
+  source += ", ";
+  source += std::to_string(2 * gate_width);
+  source += "] strides = [1, 1] : ";
+  source += ba_type;
+  source += " -> ";
+  source += gate_type;
+  source += "\n    results %mixed, %z, %b, %a : ";
+  source += mixed_type;
+  source += ", ";
+  source += z_type;
+  source += ", ";
+  source += gate_type;
+  source += ", ";
+  source += gate_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
+
 std::string EmitNativeTileGdnRecurrentSource(
     const NativeTileGdnRecurrentGraph& graph) {
   const int64_t state_width = graph.value_heads * graph.value_dim * graph.key_dim;
@@ -9374,6 +9603,31 @@ TensorIrModule EmitTensorIr(const ir::ProgramPtr& program) {
                           /*input_count=*/2,
                           /*contraction_extent=*/static_cast<uint64_t>(graph.k));
   }
+  if (IsNativeTileGdnProjectionCandidate(program)) {
+    const NativeTileGdnProjectionGraph graph =
+        AnalyzeNativeTileGdnProjection(program);
+    std::vector<TensorIrValueMetadata> metadata;
+    metadata.reserve(6);
+    const std::array<StaticTensor, 2> inputs = {
+        graph.projected_qkvz, graph.projected_ba};
+    for (uint32_t index = 0; index < inputs.size(); ++index) {
+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Input, index, inputs[index].dtype,
+          inputs[index].shape, inputs[index].dense_strides,
+          /*has_explicit_strides=*/true));
+    }
+    const std::array<StaticTensor, 4> results = {
+        graph.mixed_qkv, graph.z, graph.b, graph.a};
+    for (uint32_t index = 0; index < results.size(); ++index) {
+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Result, index, results[index].dtype,
+          results[index].shape, results[index].dense_strides,
+          /*has_explicit_strides=*/true));
+    }
+    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
+                          EmitNativeTileGdnProjectionSource(graph),
+                          std::move(metadata), /*input_count=*/2);
+  }
   if (IsNativeTileGdnRecurrentCandidate(program)) {
     const NativeTileGdnRecurrentGraph graph =
         AnalyzeNativeTileGdnRecurrent(program);
