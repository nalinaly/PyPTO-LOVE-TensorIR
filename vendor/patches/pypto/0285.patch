From 04679730316662c68c731be845f4ed9b209ab3f9 Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Sun, 30 Aug 2026 14:41:17 +0800
Subject: [PATCH 285/298] codegen: remove legacy string TensorIR emitters

---
 src/codegen/nvidia/tensor_ir_codegen.cpp | 2401 ----------------------
 1 file changed, 2401 deletions(-)

diff --git a/src/codegen/nvidia/tensor_ir_codegen.cpp b/src/codegen/nvidia/tensor_ir_codegen.cpp
index a35a1282ce9e01169b05af4b061fd94036111ef7..52d8fe38649530728d266f122babc0875ce896b0 100644
--- a/src/codegen/nvidia/tensor_ir_codegen.cpp
+++ b/src/codegen/nvidia/tensor_ir_codegen.cpp
@@ -436,14 +436,6 @@ bool SameTensor(const StaticTensor& left, const StaticTensor& right) {
          left.dense_strides == right.dense_strides;
 }
 
-const char* TensorIrDtype(DataType dtype) {
-  if (dtype == DataType::BF16) return "bf16";
-  if (dtype == DataType::FP32) return "f32";
-  if (dtype == DataType::INT32) return "si32";
-  if (dtype == DataType::INT64) return "si64";
-  InternalReject("unsupported dtype reached source emission");
-}
-
 double MaximumFiniteScalar(DataType dtype) {
   if (dtype == DataType::FP32) {
     return static_cast<double>(std::numeric_limits<float>::max());
@@ -462,25 +454,6 @@ void AppendInteger(std::string& output, int64_t value) {
   output.append(buffer, result.ptr);
 }
 
-void AppendIndex(std::string& output, size_t value) {
-  char buffer[32];
-  const auto result = std::to_chars(buffer, buffer + sizeof(buffer), value);
-  if (result.ec != std::errc{}) InternalReject("index formatting failed");
-  output.append(buffer, result.ptr);
-}
-
-void AppendFloat(std::string& output, double value) {
-  std::ostringstream stream;
-  stream.imbue(std::locale::classic());
-  stream << std::setprecision(std::numeric_limits<double>::max_digits10) << value;
-  std::string formatted = stream.str();
-  if (formatted.empty() || formatted.size() > 32) {
-    InternalReject("floating-point formatting produced an invalid bounded token");
-  }
-  if (formatted.find_first_of(".eE") == std::string::npos) formatted += ".0";
-  output += formatted;
-}
-
 std::string JoinIntegers(const std::vector<int64_t>& values, char separator) {
   std::string output;
   output.reserve(values.size() * 4);
@@ -491,53 +464,6 @@ std::string JoinIntegers(const std::vector<int64_t>& values, char separator) {
   return output;
 }
 
-std::string TensorTypeText(const StaticTensor& tensor) {
-  return "tensor<" + JoinIntegers(tensor.shape, 'x') + "x" +
-         TensorIrDtype(tensor.dtype) + ">";
-}
-
-std::string TensorWithStrideText(const StaticTensor& tensor) {
-  const std::string type = TensorTypeText(tensor);
-  if (tensor.shape.size() == 1) return type;
-  return type + " {nv_tensor_ir.stride = \"(" + JoinIntegers(tensor.dense_strides, ',') +
-         ")\"}";
-}
-
-std::string EmitLegacyStaticAddSource(const StaticTensor& tensor, size_t lhs_index,
-                                      size_t rhs_index) {
-  const std::string type = TensorTypeText(tensor);
-  const std::string type_with_stride = TensorWithStrideText(tensor);
-  std::string source;
-  source.reserve(256 + type_with_stride.size() * 3 + type.size() * 2);
-  source += "module {\n  nv_tensor_ir.graph @";
-  source += kLegacyStaticAddEntryName;
-  source += "(\n    %arg0: ";
-  source += type_with_stride;
-  source += ",\n    %arg1: ";
-  source += type_with_stride;
-  source += "\n  ) -> ";
-  if (tensor.shape.size() == 1) {
-    source += type;
-  } else {
-    source += "(";
-    source += type_with_stride;
-    source += ")";
-  }
-  source += " {\n    %result0 = add %arg";
-  AppendIndex(source, lhs_index);
-  source += ", %arg";
-  AppendIndex(source, rhs_index);
-  source += " : ";
-  source += type;
-  source += "\n    results %result0 : ";
-  source += type;
-  source += "\n  }\n}\n";
-  if (source.size() > kMaximumCanonicalSourceBytes) {
-    Reject("canonical TensorIR source exceeds 16 MiB");
-  }
-  return source;
-}
-
 std::vector<ir::StmtPtr> LegacyBodyStatements(const ir::StmtPtr& body,
                                               const ir::Span& function_span) {
   if (!body) Reject("function body must not be null", &function_span);
@@ -832,1725 +758,6 @@ bool AnalyzeRowReductionV4(const ir::ProgramPtr& program,
   return true;
 }
 
-std::string EmitRowReductionEpilogueSource(
-    const StaticTensor& input, bool square_input,
-    const std::vector<RowReductionEpilogueStep>& steps) {
-  const bool widen = input.dtype == DataType::BF16;
-  StaticTensor compute = input;
-  if (widen) compute.dtype = DataType::FP32;
-  StaticTensor row = compute;
-  row.shape[1] = 1;
-  row.dense_strides = {1, 1};
-  const std::string input_type = TensorTypeText(input);
-  const std::string input_with_stride = TensorWithStrideText(input);
-  const std::string compute_type = TensorTypeText(compute);
-  const std::string row_type = TensorTypeText(row);
-  std::string source;
-  source += "module {\n  nv_tensor_ir.graph @";
-  source += kFusedPointwiseEntryName;
-  source += "(\n    %arg0: ";
-  source += input_with_stride;
-  source += "\n  ) -> (";
-  source += input_with_stride;
-  source += ") {\n";
-  std::string full_value = "%arg0";
-  if (widen) {
-    source += "    %wide0 = convert %arg0 : ";
-    source += input_type;
-    source += " -> ";
-    source += compute_type;
-    source += "\n";
-    full_value = "%wide0";
-  }
-  std::string reduction_value = full_value;
-  if (square_input) {
-    source += "    %square0 = mul ";
-    source += full_value;
-    source += ", ";
-    source += full_value;
-    source += " : ";
-    source += compute_type;
-    source += "\n";
-    reduction_value = "%square0";
-  }
-  source += "    %reduce0 = reduce(";
-  source += reduction_value;
-  source += ") <dimensions = [1], reduction_mode = <add>> : ";
-  source += compute_type;
-  source += " -> ";
-  source += row_type;
-  source += "\n";
-  source += "    %sumzero = constant 0.0 : f32\n";
-  source += "    %sumsplat = splat %sumzero : ";
-  source += row_type;
-  source += "\n    %sum0 = add %reduce0, %sumsplat : ";
-  source += row_type;
-  source += "\n";
-  std::string current = "%sum0";
-  size_t constant_index = 0;
-  for (const RowReductionEpilogueStep& step : steps) {
-    if (step.op == "rsqrt" || step.op == "reciprocal") {
-      source += "    %ep";
-      AppendIndex(source, constant_index);
-      source += step.op == "rsqrt" ? " = rsqrt " : " = reciprocal ";
-      source += current;
-      source += " : ";
-      source += row_type;
-      source += "\n";
-      current = "%ep" + std::to_string(constant_index);
-      ++constant_index;
-      continue;
-    }
-    source += "    %c";
-    AppendIndex(source, constant_index);
-    source += " = constant ";
-    AppendFloat(source, step.scalar);
-    source += " : f32\n    %cs";
-    AppendIndex(source, constant_index);
-    source += " = splat %c";
-    AppendIndex(source, constant_index);
-    source += " : ";
-    source += row_type;
-    source += "\n    %ep";
-    AppendIndex(source, constant_index);
-    source += " = ";
-    source += step.op == "muls" ? "mul" : "add";
-    source += " ";
-    source += current;
-    source += ", %cs";
-    AppendIndex(source, constant_index);
-    source += " : ";
-    source += row_type;
-    source += "\n";
-    current = "%ep" + std::to_string(constant_index);
-    ++constant_index;
-  }
-  source += "    %bcast0 = broadcast ";
-  source += current;
-  source += " : ";
-  source += row_type;
-  source += " -> ";
-  source += compute_type;
-  if (widen) {
-    source += "\n    %scaled0 = mul %wide0, %bcast0 : ";
-    source += compute_type;
-    source += "\n    %result0 = convert %scaled0 : ";
-    source += compute_type;
-    source += " -> ";
-    source += input_type;
-  } else {
-    source += "\n    %result0 = mul %arg0, %bcast0 : ";
-    source += input_type;
-  }
-  source += "\n    results %result0 : ";
-  source += input_type;
-  source += "\n  }\n}\n";
-  if (source.size() > kMaximumCanonicalSourceBytes) {
-    Reject("canonical TensorIR source exceeds 16 MiB");
-  }
-  return source;
-}
