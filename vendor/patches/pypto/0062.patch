+int TestFusedPointwiseV2RowBroadcast() {
+  auto type = PlainTensor({4, 6}, DataType::FP32);
+  auto row_type = PlainTensor({4, 1}, DataType::FP32);
+  auto x = std::make_shared<ir::Var>("x", type, TestSpan());
+  auto scale = std::make_shared<ir::Var>("scale", row_type, TestSpan());
+  auto value = std::make_shared<ir::Var>("ignored", type, TestSpan());
+  auto broadcast_call = OpCall("tensor.row_expand_mul", {x, scale}, type);
+  auto assignment = std::make_shared<ir::AssignStmt>(value, broadcast_call,
+                                                     TestSpan());
+  auto returned = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{value}, TestSpan());
+  const TensorIrModule module = EmitTensorIr(MakeProgram(
+      "ignored_fused_name", {x, scale},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+      {assignment, returned}));
+
+  REQUIRE(module.GetKind() == TensorIrModuleKind::FusedPointwiseV2);
+  const std::string source = module.GetCanonicalSource();
+  REQUIRE(source.find("%arg1: tensor<4x1xf32> {nv_tensor_ir.stride = \"(1,1)\"}") !=
+          std::string::npos);
+  REQUIRE(source.find("%bcarg1 = broadcast %arg1 : tensor<4x1xf32> -> tensor<4x6xf32>") !=
+          std::string::npos);
+  REQUIRE(source.find("%value0 = mul %arg0, %bcarg1 : tensor<4x6xf32>") !=
+          std::string::npos);
+  const auto& metadata = module.GetValueMetadata();
+  REQUIRE(metadata.size() == 3);
+  REQUIRE(metadata[1].GetShape() == std::vector<int64_t>({4, 1}));
+
+  // A broadcast input feeding a plain op is rejected fail-closed.
+  auto plain = std::make_shared<ir::Var>("plain", type, TestSpan());
+  auto misuse = std::make_shared<ir::Var>("misuse", type, TestSpan());
+  auto misuse_assignment = std::make_shared<ir::AssignStmt>(
+      misuse, OpCall("tensor.mul", {plain, scale}, type), TestSpan());
+  auto misuse_return = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{misuse}, TestSpan());
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeProgram(
+            "ignored_fused_name", {plain, scale},
+            {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+            {misuse_assignment, misuse_return}));
+      },
+      "row-broadcast inputs may feed only row-expand operands"));
+
+  // A row-expand operand that is not a broadcast-shaped input is rejected.
+  auto two_wide = PlainTensor({4, 2}, DataType::FP32);
+  auto wide = std::make_shared<ir::Var>("wide", two_wide, TestSpan());
+  auto wide_result = std::make_shared<ir::Var>("wide_result", type, TestSpan());
+  auto wide_assignment = std::make_shared<ir::AssignStmt>(
+      wide_result, OpCall("tensor.row_expand_mul", {x, wide}, type), TestSpan());
+  auto wide_return = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{wide_result}, TestSpan());
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeProgram(
+            "ignored_fused_name", {x, wide},
+            {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+            {wide_assignment, wide_return}));
+      },
+      "input types and shapes must be identical"));
+
+  // A row-expand operand referencing a full-shape input is rejected.
+  auto y = std::make_shared<ir::Var>("y", type, TestSpan());
+  auto swapped = std::make_shared<ir::Var>("swapped", type, TestSpan());
+  auto swapped_assignment = std::make_shared<ir::AssignStmt>(
+      swapped, OpCall("tensor.row_expand_mul", {x, y}, type), TestSpan());
+  auto swapped_return = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{swapped}, TestSpan());
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeProgram(
+            "ignored_fused_name", {x, y},
+            {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+            {swapped_assignment, swapped_return}));
+      },
+      "row-expand operands must reference a row-broadcast input"));
+  return 0;
+}
