+bool IsRowBroadcastOf(const StaticTensor& row, const StaticTensor& full) {
+  if (row.dtype != full.dtype || row.shape.size() != full.shape.size() ||
+      row.shape.empty()) {
+    return false;
+  }
+  for (size_t index = 0; index < row.shape.size(); ++index) {
+    if (row.shape[index] != (index == 0 ? full.shape[index] : 1)) {
+      return false;
+    }
+  }
+  return row.dense_strides == MakeDenseStridesForMetadata(row.shape);
+}
