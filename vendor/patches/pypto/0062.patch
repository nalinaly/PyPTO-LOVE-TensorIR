+  // Row-expand fused ops take [M,1,...] second operands broadcast over the
+  // trailing result extents; the arithmetic itself lowers to the base op.
+  if (ir::IsOp(call, "tensor.row_expand_mul")) {
+    return FusedOperationSpec{"mul", 2, false, true};
+  }
+  if (ir::IsOp(call, "tensor.row_expand_div")) {
+    return FusedOperationSpec{"div", 2, false, true};
+  }
+  if (ir::IsOp(call, "tensor.row_expand_add")) {
+    return FusedOperationSpec{"add", 2, false, true};
+  }
+  if (ir::IsOp(call, "tensor.row_expand_sub")) {
+    return FusedOperationSpec{"sub", 2, false, true};
+  }
+  if (ir::IsOp(call, "tensor.row_expand_max")) {
+    return FusedOperationSpec{"max", 2, false, true};
+  }
+  if (ir::IsOp(call, "tensor.row_expand_min")) {
+    return FusedOperationSpec{"min", 2, false, true};
+  }
   return std::nullopt;
