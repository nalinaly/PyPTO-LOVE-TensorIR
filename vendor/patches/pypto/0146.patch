+bool IsNativeTilePagedCacheWriteCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 6) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto body = scope ? ir::As<ir::SeqStmts>(scope->body_) : nullptr;
+  if (!body || body->stmts_.size() != 8) return false;
+  for (size_t index : {size_t{4}, size_t{5}, size_t{7}}) {
+    const auto eval = ir::As<ir::EvalStmt>(body->stmts_[index]);
+    const auto call = eval ? ir::As<ir::Call>(eval->expr_) : nullptr;
+    if (!call || !ir::IsOp(call, "tile.store")) return false;
+  }
+  return true;
+}
+
+NativeTilePagedCacheWriteGraph AnalyzeNativeTilePagedCacheWrite(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native paged cache write must be one canonical CHIP @pl.jit "
+           "function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 6 ||
+      function->param_directions_.size() != 6 ||
+      function->return_types_.size() != 1 ||
+      function->param_directions_[0] != ir::ParamDirection::InOut ||
+      function->param_directions_[1] != ir::ParamDirection::InOut ||
+      function->param_directions_[2] != ir::ParamDirection::In ||
+      function->param_directions_[3] != ir::ParamDirection::In ||
+      function->param_directions_[4] != ir::ParamDirection::In ||
+      function->param_directions_[5] != ir::ParamDirection::Out) {
+    Reject("native paged cache write parameter directions are invalid",
+           &function->span_);
+  }
+
+  const StaticTensor key_cache = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native paged cache write key cache");
+  const StaticTensor value_cache = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native paged cache write value cache");
+  StaticTensor physical_row = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native paged cache write physical row");
+  const StaticTensor key = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native paged cache write key update");
+  const StaticTensor value = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native paged cache write value update");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native paged cache write output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native paged cache write declared output");
+  if (key_cache.dtype != DataType::BF16 ||
+      !SameTensor(key_cache, value_cache) || key_cache.shape.size() != 2 ||
+      physical_row.dtype != DataType::INT64 ||
+      physical_row.shape.size() != 2 || key.dtype != DataType::BF16 ||
+      !SameTensor(key, value) || !SameTensor(key, result) ||
+      !SameTensor(result, declared) || key.shape.size() != 2 ||
+      key.shape[0] != 1 || key_cache.shape[0] <= 0 ||
+      key_cache.shape[1] != key.shape[1] || key.shape[1] % 128 != 0 ||
+      physical_row.shape != key.shape) {
+    Reject("native paged cache write tensor geometry is invalid",
+           &function->span_);
+  }
+  physical_row.dense_strides = {0, 0};
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  const auto body = scope ? ir::As<ir::SeqStmts>(scope->body_) : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[5].get() || !body ||
+      body->stmts_.size() != 8) {
+    Reject("native paged cache write scope or return is invalid",
+           &function->span_);
+  }
+
+  const auto physical_assignment =
+      ir::As<ir::AssignStmt>(body->stmts_[0]);
+  const auto cast_assignment = ir::As<ir::AssignStmt>(body->stmts_[1]);
+  const auto key_assignment = ir::As<ir::AssignStmt>(body->stmts_[2]);
+  const auto value_assignment = ir::As<ir::AssignStmt>(body->stmts_[3]);
+  const auto anchor_assignment = ir::As<ir::AssignStmt>(body->stmts_[6]);
+  const auto physical_call = physical_assignment
+                                 ? ir::As<ir::Call>(physical_assignment->value_)
+                                 : nullptr;
+  const auto physical_cast = cast_assignment
+                                 ? ir::As<ir::Cast>(cast_assignment->value_)
+                                 : nullptr;
+  const auto cast_type = physical_cast
+                             ? ir::As<ir::ScalarType>(physical_cast->GetType())
+                             : nullptr;
+  const auto key_call = key_assignment
+                            ? ir::As<ir::Call>(key_assignment->value_)
+                            : nullptr;
+  const auto value_call = value_assignment
+                              ? ir::As<ir::Call>(value_assignment->value_)
+                              : nullptr;
+  const auto anchor_call = anchor_assignment
+                               ? ir::As<ir::Call>(anchor_assignment->value_)
+                               : nullptr;
+  if (!physical_assignment || !physical_assignment->var_ || !physical_call ||
+      !ir::IsOp(physical_call, "tensor.read") ||
+      physical_call->args_.size() != 2 ||
+      physical_call->args_[0].get() != function->params_[2].get() ||
+      !cast_assignment || !cast_assignment->var_ || !physical_cast ||
+      physical_cast->operand_.get() != physical_assignment->var_.get() ||
+      !cast_type || cast_type->dtype_ != DataType::INT32 || !key_assignment ||
+      !key_assignment->var_ || !key_call || !ir::IsOp(key_call, "tile.load") ||
+      key_call->args_.empty() ||
+      key_call->args_[0].get() != function->params_[3].get() ||
+      !value_assignment || !value_assignment->var_ || !value_call ||
+      !ir::IsOp(value_call, "tile.load") || value_call->args_.empty() ||
+      value_call->args_[0].get() != function->params_[4].get() ||
+      !anchor_assignment || !anchor_assignment->var_ || !anchor_call ||
+      !ir::IsOp(anchor_call, "tile.add") || anchor_call->args_.size() != 2 ||
+      anchor_call->args_[0].get() != key_assignment->var_.get() ||
+      anchor_call->args_[1].get() != value_assignment->var_.get()) {
+    Reject("native paged cache write operation sequence is invalid",
+           &body->span_);
+  }
+
+  for (auto [index, expected_tile, expected_target] :
+       {std::tuple<size_t, ir::VarPtr, ir::VarPtr>{
+            4, key_assignment->var_, function->params_[0]},
+        std::tuple<size_t, ir::VarPtr, ir::VarPtr>{
+            5, value_assignment->var_, function->params_[1]},
+        std::tuple<size_t, ir::VarPtr, ir::VarPtr>{
+            7, anchor_assignment->var_, function->params_[5]}}) {
+    const auto eval = ir::As<ir::EvalStmt>(body->stmts_[index]);
+    const auto call = eval ? ir::As<ir::Call>(eval->expr_) : nullptr;
+    if (!call || !ir::IsOp(call, "tile.store") || call->args_.size() != 3 ||
+        call->args_[0].get() != expected_tile.get() ||
+        call->args_[2].get() != expected_target.get()) {
+      Reject("native paged cache write store targets are invalid",
+             &body->stmts_[index]->span_);
+    }
+  }
+
+  return NativeTilePagedCacheWriteGraph{
+      key_cache, value_cache, physical_row, key, value, result};
+}
+
 NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
     const ir::ProgramPtr& program) {
   const auto& [global, function] = *program->functions_.begin();
@@ -5906,6 +6081,63 @@ std::string EmitNativeTilePagedDecodeSource(
