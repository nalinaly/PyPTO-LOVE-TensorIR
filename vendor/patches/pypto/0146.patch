+std::string EmitNativeTilePagedCacheWriteSource(
+    const NativeTilePagedCacheWriteGraph& graph) {
+  StaticTensor physical_i32 = graph.physical_row;
+  physical_i32.dtype = DataType::INT32;
+  const std::string cache_type = TensorTypeText(graph.key_cache);
+  const std::string physical_type = TensorTypeText(graph.physical_row);
+  const std::string physical_i32_type = TensorTypeText(physical_i32);
+  const std::string update_type = TensorTypeText(graph.key);
+  const std::string result_type = TensorTypeText(graph.result);
+
+  std::string source;
+  source.reserve(2048);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.key_cache);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.value_cache);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.physical_row);
+  source += ",\n    %arg3: ";
+  source += TensorWithStrideText(graph.key);
+  source += ",\n    %arg4: ";
+  source += TensorWithStrideText(graph.value);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %physical32 = convert %arg2 : ";
+  source += physical_type;
+  source += " -> ";
+  source += physical_i32_type;
+  source += "\n    %stored_key = scatter_rows %arg0, %physical32, %arg3 : (";
+  source += cache_type;
+  source += ", ";
+  source += physical_i32_type;
+  source += ", ";
+  source += update_type;
+  source += ") -> ";
+  source += update_type;
+  source += "\n    %stored_value = scatter_rows %arg1, %physical32, %arg4 : (";
+  source += cache_type;
+  source += ", ";
+  source += physical_i32_type;
+  source += ", ";
+  source += update_type;
+  source += ") -> ";
+  source += update_type;
+  source += "\n    %result0 = add %stored_key, %stored_value : ";
+  source += result_type;
+  source += "\n    results %result0 : ";
+  source += result_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
