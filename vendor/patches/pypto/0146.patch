+  if (IsNativeTilePagedCacheWriteCandidate(program)) {
+    const NativeTilePagedCacheWriteGraph graph =
+        AnalyzeNativeTilePagedCacheWrite(program);
+    std::vector<TensorIrValueMetadata> metadata;
+    metadata.reserve(6);
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 0, graph.key_cache.dtype,
+        graph.key_cache.shape, graph.key_cache.dense_strides,
+        /*has_explicit_strides=*/true,
+        TensorIrArgumentEffect::ReadWrite));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 1, graph.value_cache.dtype,
+        graph.value_cache.shape, graph.value_cache.dense_strides,
+        /*has_explicit_strides=*/true,
+        TensorIrArgumentEffect::ReadWrite));
+    const std::array<StaticTensor, 3> read_only_inputs = {
+        graph.physical_row, graph.key, graph.value};
+    for (uint32_t index = 0; index < read_only_inputs.size(); ++index) {
+      const StaticTensor& input = read_only_inputs[index];
+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Input, index + 2, input.dtype, input.shape,
+          input.dense_strides, /*has_explicit_strides=*/true));
+    }
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype, graph.result.shape,
+        graph.result.dense_strides, /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
+                          EmitNativeTilePagedCacheWriteSource(graph),
+                          std::move(metadata), /*input_count=*/5);
+  }
   if (IsNativeTilePagedDecodeCandidate(program)) {
     const NativeTilePagedDecodeGraph graph =
         AnalyzeNativeTilePagedDecode(program);
