+#ifndef PYPTO_COMPILER_ARTIFACT_CACHE_H_
+#define PYPTO_COMPILER_ARTIFACT_CACHE_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "pypto/compiler/artifact.h"
+
+namespace pypto::compiler {
+
+enum class ArtifactCachePublishResult : uint8_t {
+  Published = 0,
+  AlreadyPresent = 1,
+};
+
+/**
+ * Compiler-owned persistent cache for immutable Artifact v1 payloads.
+ *
+ * The cache is runtime-free: it owns no CUDA device, context, module, function,
+ * stream, event or workspace state. Its root must already exist as an absolute,
+ * canonical, owner-only directory. Entries are immutable canonical Artifact
+ * bytes and are published atomically without replacing an existing key.
+ */
+class ArtifactCache {
+ public:
+  static constexpr std::string_view kContract = "pypto.nvidia.artifact_cache.v1";
+  static constexpr std::string_view kNamespaceDirectory = "pypto-nvidia-artifacts";
+  static constexpr std::string_view kSchemaDirectory = "v1";
+  static constexpr std::string_view kHashDirectory = "sha256";
+  static constexpr std::string_view kEntrySuffix = ".artifact";
+  static constexpr uint32_t kMaximumRootPathBytes = 4096;
+
+  explicit ArtifactCache(std::string root_directory);
+  ~ArtifactCache();
+
+  ArtifactCache(const ArtifactCache&) = delete;
+  ArtifactCache& operator=(const ArtifactCache&) = delete;
+  ArtifactCache(ArtifactCache&&) = delete;
+  ArtifactCache& operator=(ArtifactCache&&) = delete;
+
+  [[nodiscard]] const std::string& GetRootDirectory() const noexcept;
+
+  /** Return a fully revalidated Artifact, or nullopt on an exact cache miss. */
+  [[nodiscard]] std::optional<Artifact> Lookup(
+      const CompileRequest& request, const KernelBuildSpec& build_spec) const;
+
+  /**
+   * Atomically publish an Artifact without replacement.
+   *
+   * Returns Published when this call creates the entry and AlreadyPresent when
+   * an identical, already-valid entry exists. A corrupt or different existing
+   * entry is a fail-closed conflict and is never removed or overwritten.
+   */
+  [[nodiscard]] ArtifactCachePublishResult Publish(
+      const Artifact& artifact, const CompileRequest& request,
+      const KernelBuildSpec& build_spec) const;
+
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_ARTIFACT_CACHE_H_
