diff --git a/src/compiler/artifact_cache.cpp b/src/compiler/artifact_cache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7b0eacad4ab1ce56916bd527a43364b984e4b1f8
--- /dev/null
+++ b/src/compiler/artifact_cache.cpp
@@ -0,0 +1,709 @@
+/*
+ * Copyright (c) PyPTO Contributors.
+ * This program is free software, you can redistribute it and/or modify it under the terms and conditions of
+ * CANN Open Software License Agreement Version 2.0 (the "License").
+ * Please refer to the License for details. You may not use this file except in compliance with the License.
+ * THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
+ * INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+ * See LICENSE in the root of the software repository for the full text of the License.
+ * -----------------------------------------------------------------------------------------------------------
+ */
+
+#include "pypto/compiler/artifact_cache.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+#if defined(__linux__)
+#include <fcntl.h>
+#include <linux/fs.h>
+#include <linux/openat2.h>
+#include <sys/random.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+#include "pypto/core/error.h"
+
+namespace pypto::compiler {
+namespace {
+
+constexpr unsigned int kRequiredDirectoryMode = 0700;
+constexpr unsigned int kRequiredEntryMode = 0400;
+constexpr unsigned int kMaximumTemporaryNameAttempts = 32;
+
+[[noreturn]] void ThrowSystemError(const std::string& action, int error_number) {
+  throw RuntimeError(action + ": " +
+                     std::error_code(error_number, std::generic_category())
+                         .message());
+}
+
+void RequireCanonicalRootPath(const std::string& root_directory) {
+  if (root_directory.empty() ||
+      root_directory.size() > ArtifactCache::kMaximumRootPathBytes ||
+      root_directory.find('\0') != std::string::npos) {
+    throw ValueError("ArtifactCache root must contain 1 to 4096 non-NUL bytes");
+  }
+  const std::filesystem::path path(root_directory);
+  if (!path.is_absolute() || root_directory == "/" ||
+      root_directory.back() == '/' ||
+      path.lexically_normal().string() != root_directory) {
+    throw ValueError(
+        "ArtifactCache root must be an absolute canonical non-root path without a trailing separator");
+  }
+}
+
+bool IsLowercaseSha256(const std::string& digest) {
+  if (digest.size() != 64) return false;
+  for (char value : digest) {
+    if (!((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+struct EntryAddress {
+  std::string digest;
+  std::string shard;
+  std::string name;
+};
+
+EntryAddress ResolveEntryAddress(const CompileRequest& request,
+                                 const KernelBuildSpec& build_spec) {
+  const std::string digest = Artifact::GetCacheKeyDigest(request, build_spec);
+  if (!IsLowercaseSha256(digest)) {
+    throw InternalError("Artifact cache-key digest is not canonical SHA-256");
+  }
+  return {digest, digest.substr(0, 2),
+          digest + std::string(ArtifactCache::kEntrySuffix)};
+}
+
+#if defined(__linux__)
+
+int OpenAndValidateRootComponents(const std::string& root_directory) {
+  int current = ::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (current < 0) ThrowSystemError("failed to open filesystem root", errno);
+  size_t begin = 1;
+  while (begin < root_directory.size()) {
+    const size_t separator = root_directory.find('/', begin);
+    const bool final_component = separator == std::string::npos;
+    const std::string component = root_directory.substr(
+        begin, final_component ? std::string::npos : separator - begin);
+    int next = ::openat(current, component.c_str(),
+                        O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    const int saved_error = errno;
+    (void)::close(current);
+    if (next < 0) {
+      ThrowSystemError("failed to open ArtifactCache root path component",
+                       saved_error);
+    }
+    struct stat status {};
+    if (::fstat(next, &status) != 0) {
+      const int stat_error = errno;
+      (void)::close(next);
+      ThrowSystemError("failed to inspect ArtifactCache root path component",
+                       stat_error);
+    }
+    if (!S_ISDIR(status.st_mode)) {
+      (void)::close(next);
+      throw ValueError("ArtifactCache root path contains a non-directory component");
+    }
+    if (!final_component && (status.st_mode & 0022) != 0 &&
+        (status.st_mode & S_ISVTX) == 0) {
+      (void)::close(next);
+      throw ValueError(
+          "ArtifactCache root ancestor is group/world-writable without sticky protection");
+    }
+    current = next;
+    if (final_component) return current;
+    begin = separator + 1;
+  }
+  (void)::close(current);
+  throw InternalError("ArtifactCache canonical path contained no components");
+}
+
+int OpenRootNoSymlinks(const std::string& root_directory) {
+#if defined(SYS_openat2)
+  int slash = ::open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (slash < 0) ThrowSystemError("failed to open filesystem root", errno);
+  struct open_how how {};
+  how.flags = O_RDONLY | O_DIRECTORY | O_CLOEXEC;
+  how.resolve = RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS |
+                RESOLVE_NO_MAGICLINKS;
+  const std::string relative = root_directory.substr(1);
+  int descriptor = static_cast<int>(
+      ::syscall(SYS_openat2, slash, relative.c_str(), &how, sizeof(how)));
+  const int saved_error = errno;
+  (void)::close(slash);
+  if (descriptor < 0) {
+    ThrowSystemError("failed to open canonical ArtifactCache root", saved_error);
+  }
+  int component_descriptor = -1;
+  try {
+    component_descriptor = OpenAndValidateRootComponents(root_directory);
+    struct stat direct_status {};
+    struct stat component_status {};
+    if (::fstat(descriptor, &direct_status) != 0 ||
+        ::fstat(component_descriptor, &component_status) != 0) {
+      ThrowSystemError("failed to compare ArtifactCache root identity", errno);
+    }
+    if (direct_status.st_dev != component_status.st_dev ||
+        direct_status.st_ino != component_status.st_ino) {
+      throw RuntimeError("ArtifactCache root changed while it was opened");
+    }
+    (void)::close(component_descriptor);
+  } catch (...) {
+    if (component_descriptor >= 0) (void)::close(component_descriptor);
+    (void)::close(descriptor);
+    throw;
+  }
+  return descriptor;
+#else
+  (void)root_directory;
+  throw NotImplementedError("ArtifactCache requires Linux openat2");
+#endif
+}
+
+void ValidatePrivateDirectoryDescriptor(int descriptor,
+                                        const std::string& description) {
+  struct stat status {};
+  if (::fstat(descriptor, &status) != 0) {
+    ThrowSystemError("failed to inspect " + description, errno);
+  }
+  if (!S_ISDIR(status.st_mode) || status.st_uid != ::geteuid() ||
+      (status.st_mode & 07777) != kRequiredDirectoryMode) {
+    throw ValueError(description +
+                     " must be an owner-owned directory with exact mode 0700");
+  }
+}
+
+void ValidateCacheProcess(pid_t owner_process) {
+  if (::getpid() != owner_process) {
+    throw RuntimeError(
+        "ArtifactCache handle cannot be reused after fork; construct a child-local cache handle");
+  }
+}
+
+int OpenPrivateDirectoryAt(int parent_descriptor, const std::string& name,
+                           bool* missing) {
+  *missing = false;
+  int descriptor =
+      ::openat(parent_descriptor, name.c_str(),
+               O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+  if (descriptor < 0) {
+    if (errno == ENOENT) {
+      *missing = true;
+      return -1;
+    }
+    ThrowSystemError("failed to open ArtifactCache directory component", errno);
+  }
+  try {
+    ValidatePrivateDirectoryDescriptor(
+        descriptor, "ArtifactCache directory component");
+  } catch (...) {
+    (void)::close(descriptor);
+    throw;
+  }
+  return descriptor;
+}
+
+class ScopedDescriptor {
+ public:
+  explicit ScopedDescriptor(int descriptor = -1) : descriptor_(descriptor) {}
+  ~ScopedDescriptor() {
+    if (descriptor_ >= 0) (void)::close(descriptor_);
+  }
+
+  ScopedDescriptor(const ScopedDescriptor&) = delete;
+  ScopedDescriptor& operator=(const ScopedDescriptor&) = delete;
+  ScopedDescriptor(ScopedDescriptor&& other) noexcept
+      : descriptor_(other.descriptor_) {
+    other.descriptor_ = -1;
+  }
+
+  [[nodiscard]] int Get() const noexcept { return descriptor_; }
+
+ private:
+  int descriptor_;
+};
+
+int EnsurePrivateDirectoryAt(int parent_descriptor, const std::string& name) {
+  bool created = false;
+  if (::mkdirat(parent_descriptor, name.c_str(), kRequiredDirectoryMode) == 0) {
+    created = true;
+  } else if (errno != EEXIST) {
+    ThrowSystemError("failed to create ArtifactCache directory component", errno);
+  }
+  struct stat created_identity {};
+  if (created) {
+    int path_descriptor =
+        ::openat(parent_descriptor, name.c_str(),
+                 O_PATH | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (path_descriptor < 0) {
+      ThrowSystemError("failed to open new ArtifactCache directory component",
+                       errno);
+    }
+    ScopedDescriptor path_closer(path_descriptor);
+#if defined(SYS_fchmodat2)
+    if (::syscall(SYS_fchmodat2, path_descriptor, "", kRequiredDirectoryMode,
+                  AT_EMPTY_PATH) != 0) {
+      ThrowSystemError(
+          "failed to set new ArtifactCache directory permissions", errno);
+    }
+#else
+    throw NotImplementedError(
+        "ArtifactCache directory creation requires Linux fchmodat2");
+#endif
+    if (::fstat(path_descriptor, &created_identity) != 0) {
+      ThrowSystemError("failed to inspect new ArtifactCache directory", errno);
+    }
+  }
+  bool missing = false;
+  int descriptor = OpenPrivateDirectoryAt(parent_descriptor, name, &missing);
+  if (missing) {
+    throw RuntimeError(
+        "ArtifactCache directory component disappeared during creation");
+  }
+  if (created) {
+    struct stat opened_identity {};
+    if (::fstat(descriptor, &opened_identity) != 0) {
+      const int saved_error = errno;
+      (void)::close(descriptor);
+      ThrowSystemError("failed to inspect opened ArtifactCache directory",
+                       saved_error);
+    }
+    if (created_identity.st_dev != opened_identity.st_dev ||
+        created_identity.st_ino != opened_identity.st_ino) {
+      (void)::close(descriptor);
+      throw RuntimeError(
+          "ArtifactCache directory changed while permissions were finalized");
+    }
+    if (::fchmod(descriptor, kRequiredDirectoryMode) != 0) {
+      const int saved_error = errno;
+      (void)::close(descriptor);
+      ThrowSystemError("failed to confirm ArtifactCache directory permissions",
+                       saved_error);
+    }
+    if (::fsync(descriptor) != 0) {
+      const int saved_error = errno;
+      (void)::close(descriptor);
+      ThrowSystemError("failed to sync new ArtifactCache directory",
+                       saved_error);
+    }
+    if (::fsync(parent_descriptor) != 0) {
+      const int saved_error = errno;
+      (void)::close(descriptor);
+      ThrowSystemError("failed to sync ArtifactCache parent directory",
+                       saved_error);
+    }
+  }
+  return descriptor;
+}
+
+std::array<uint8_t, 16> RandomBytes() {
+  std::array<uint8_t, 16> bytes{};
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const ssize_t result =
+        ::getrandom(bytes.data() + offset, bytes.size() - offset, 0);
+    if (result < 0) {
+      if (errno == EINTR) continue;
+      ThrowSystemError("failed to obtain ArtifactCache temporary-name entropy",
+                       errno);
+    }
+    if (result == 0) {
+      throw RuntimeError(
+          "failed to obtain ArtifactCache temporary-name entropy: zero-byte result");
+    }
+    offset += static_cast<size_t>(result);
+  }
+  return bytes;
+}
+
+std::string HexBytes(const std::array<uint8_t, 16>& bytes) {
+  constexpr char kHex[] = "0123456789abcdef";
+  std::string result(bytes.size() * 2, '0');
+  for (size_t index = 0; index < bytes.size(); ++index) {
+    result[index * 2] = kHex[bytes[index] >> 4U];
+    result[index * 2 + 1] = kHex[bytes[index] & 0x0fU];
+  }
+  return result;
+}
+
+class PendingEntry {
+ public:
+  PendingEntry(int root_descriptor, std::string name, int descriptor)
+      : root_descriptor_(root_descriptor),
+        name_(std::move(name)),
+        descriptor_(descriptor) {}
+
+  ~PendingEntry() {
+    if (descriptor_ >= 0) (void)::close(descriptor_);
+    if (!name_.empty()) {
+      (void)::unlinkat(root_descriptor_, name_.c_str(), 0);
+    }
+  }
+
+  PendingEntry(const PendingEntry&) = delete;
+  PendingEntry& operator=(const PendingEntry&) = delete;
+
+  [[nodiscard]] int GetDescriptor() const noexcept { return descriptor_; }
+  [[nodiscard]] const std::string& GetName() const noexcept { return name_; }
+  void Published() noexcept { name_.clear(); }
+
+ private:
+  int root_descriptor_;
+  std::string name_;
+  int descriptor_;
+};
+
+std::unique_ptr<PendingEntry> CreatePendingEntry(int root_descriptor) {
+  for (unsigned int attempt = 0; attempt < kMaximumTemporaryNameAttempts;
+       ++attempt) {
+    const std::string name = ".artifact-cache-v1-tmp-" +
+                             HexBytes(RandomBytes());
+    int descriptor =
+        ::openat(root_descriptor, name.c_str(),
+                 O_RDWR | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW,
+                 0600);
+    if (descriptor >= 0) {
+      return std::make_unique<PendingEntry>(root_descriptor, name,
+                                            descriptor);
+    }
+    if (errno != EEXIST) {
+      ThrowSystemError("failed to create ArtifactCache temporary entry", errno);
+    }
+  }
+  throw RuntimeError(
+      "failed to create ArtifactCache temporary entry after bounded retries");
+}
+
+void WriteComplete(int descriptor, const std::vector<uint8_t>& bytes) {
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const ssize_t result =
+        ::write(descriptor, bytes.data() + offset, bytes.size() - offset);
+    if (result < 0) {
+      if (errno == EINTR) continue;
+      ThrowSystemError("failed to write ArtifactCache entry", errno);
+    }
+    if (result == 0) {
+      throw RuntimeError("failed to write ArtifactCache entry: zero-byte write");
+    }
+    offset += static_cast<size_t>(result);
+  }
+}
+
+void VerifyStagedBytes(int descriptor, const std::vector<uint8_t>& expected) {
+  struct stat status {};
+  if (::fstat(descriptor, &status) != 0) {
+    ThrowSystemError("failed to inspect staged ArtifactCache entry", errno);
+  }
+  if (!S_ISREG(status.st_mode) || status.st_size < 0 ||
+      static_cast<uint64_t>(status.st_size) != expected.size()) {
+    throw RuntimeError("staged ArtifactCache entry size differs after sync");
+  }
+  std::array<uint8_t, 64 * 1024> buffer{};
+  size_t offset = 0;
+  while (offset < expected.size()) {
+    const size_t count = std::min(buffer.size(), expected.size() - offset);
+    const ssize_t result =
+        ::pread(descriptor, buffer.data(), count, static_cast<off_t>(offset));
+    if (result < 0) {
+      if (errno == EINTR) continue;
+      ThrowSystemError("failed to read back staged ArtifactCache entry", errno);
+    }
+    if (result == 0) {
+      throw RuntimeError("staged ArtifactCache entry was truncated during readback");
+    }
+    if (!std::equal(buffer.begin(), buffer.begin() + result,
+                    expected.begin() + static_cast<ptrdiff_t>(offset))) {
+      throw RuntimeError("staged ArtifactCache entry differs during readback");
+    }
+    offset += static_cast<size_t>(result);
+  }
+  uint8_t extra = 0;
+  while (true) {
+    const ssize_t result = ::pread(descriptor, &extra, 1,
+                                   static_cast<off_t>(expected.size()));
+    if (result < 0 && errno == EINTR) continue;
+    if (result < 0) {
+      ThrowSystemError("failed to finish staged ArtifactCache readback", errno);
+    }
+    if (result != 0) {
+      throw RuntimeError("staged ArtifactCache entry grew during readback");
+    }
+    break;
+  }
+}
+
+void ValidateImmutableStagedEntry(int descriptor, size_t expected_size) {
+  struct stat status {};
+  if (::fstat(descriptor, &status) != 0) {
+    ThrowSystemError("failed to inspect immutable staged ArtifactCache entry",
+                     errno);
+  }
+  if (!S_ISREG(status.st_mode) || status.st_uid != ::geteuid() ||
+      status.st_nlink != 1 ||
+      (status.st_mode & 07777) != kRequiredEntryMode || status.st_size < 0 ||
+      static_cast<uint64_t>(status.st_size) != expected_size) {
+    throw RuntimeError(
+        "immutable staged ArtifactCache entry metadata is inconsistent");
+  }
+}
+
+std::vector<uint8_t> ReadCompleteEntry(int root_descriptor,
+                                       const std::string& name,
+                                       bool* missing) {
+  *missing = false;
+  int descriptor = ::openat(root_descriptor, name.c_str(),
+                            O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+  if (descriptor < 0) {
+    if (errno == ENOENT) {
+      *missing = true;
+      return {};
+    }
+    ThrowSystemError("failed to open ArtifactCache entry", errno);
+  }
+  ScopedDescriptor closer(descriptor);
+
+  struct stat before {};
+  if (::fstat(descriptor, &before) != 0) {
+    ThrowSystemError("failed to inspect ArtifactCache entry", errno);
+  }
+  if (!S_ISREG(before.st_mode) || before.st_uid != ::geteuid() ||
+      before.st_nlink != 1 ||
+      (before.st_mode & 07777) != kRequiredEntryMode || before.st_size <= 0 ||
+      static_cast<uint64_t>(before.st_size) >
+          Artifact::kMaximumSerializedArtifactBytes) {
+    throw RuntimeError(
+        "ArtifactCache entry is not an immutable owner-only bounded regular file");
+  }
+
+  std::vector<uint8_t> bytes(static_cast<size_t>(before.st_size));
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    const ssize_t result =
+        ::pread(descriptor, bytes.data() + offset, bytes.size() - offset,
+                static_cast<off_t>(offset));
+    if (result < 0) {
+      if (errno == EINTR) continue;
+      ThrowSystemError("failed to read ArtifactCache entry", errno);
+    }
+    if (result == 0) {
+      throw RuntimeError("ArtifactCache entry was truncated while reading");
+    }
+    offset += static_cast<size_t>(result);
+  }
+  uint8_t extra = 0;
+  while (true) {
+    const ssize_t result =
+        ::pread(descriptor, &extra, 1, static_cast<off_t>(bytes.size()));
+    if (result < 0 && errno == EINTR) continue;
+    if (result < 0) ThrowSystemError("failed to finish reading ArtifactCache entry", errno);
+    if (result != 0) {
+      throw RuntimeError("ArtifactCache entry grew while reading");
+    }
+    break;
+  }
+  struct stat after {};
+  if (::fstat(descriptor, &after) != 0) {
+    ThrowSystemError("failed to re-inspect ArtifactCache entry", errno);
+  }
+  if (before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+      before.st_size != after.st_size || before.st_mode != after.st_mode ||
+      before.st_uid != after.st_uid || before.st_nlink != after.st_nlink) {
+    throw RuntimeError("ArtifactCache entry metadata changed while reading");
+  }
+  return bytes;
+}
+
+#endif
+
+}  // namespace
+
+struct ArtifactCache::Impl {
+  std::string root_directory;
+#if defined(__linux__)
+  int root_descriptor = -1;
+  int entries_descriptor = -1;
+  pid_t owner_process = 0;
+
+  ~Impl() {
+    if (entries_descriptor >= 0) (void)::close(entries_descriptor);
+    if (root_descriptor >= 0) (void)::close(root_descriptor);
+  }
+#endif
+};
+
+ArtifactCache::ArtifactCache(std::string root_directory)
+    : impl_(std::make_unique<Impl>()) {
+  RequireCanonicalRootPath(root_directory);
+#if defined(__linux__)
+  impl_->root_directory = std::move(root_directory);
+  impl_->root_descriptor = OpenRootNoSymlinks(impl_->root_directory);
+  impl_->owner_process = ::getpid();
+  try {
+    ValidateCacheProcess(impl_->owner_process);
+    ValidatePrivateDirectoryDescriptor(impl_->root_descriptor,
+                                       "ArtifactCache root");
+    int namespace_descriptor = EnsurePrivateDirectoryAt(
+        impl_->root_descriptor,
+        std::string(ArtifactCache::kNamespaceDirectory));
+    int schema_descriptor = -1;
+    try {
+      schema_descriptor = EnsurePrivateDirectoryAt(
+          namespace_descriptor,
+          std::string(ArtifactCache::kSchemaDirectory));
+      impl_->entries_descriptor = EnsurePrivateDirectoryAt(
+          schema_descriptor, std::string(ArtifactCache::kHashDirectory));
+    } catch (...) {
+      if (schema_descriptor >= 0) (void)::close(schema_descriptor);
+      (void)::close(namespace_descriptor);
+      throw;
+    }
+    (void)::close(schema_descriptor);
+    (void)::close(namespace_descriptor);
+  } catch (...) {
+    impl_.reset();
+    throw;
+  }
+#else
+  (void)root_directory;
+  throw NotImplementedError("ArtifactCache requires Linux");
+#endif
+}
+
+ArtifactCache::~ArtifactCache() = default;
+
+const std::string& ArtifactCache::GetRootDirectory() const noexcept {
+  return impl_->root_directory;
+}
+
+std::optional<Artifact> ArtifactCache::Lookup(
+    const CompileRequest& request, const KernelBuildSpec& build_spec) const {
+#if defined(__linux__)
+  ValidateCacheProcess(impl_->owner_process);
+  ValidatePrivateDirectoryDescriptor(impl_->root_descriptor,
+                                     "ArtifactCache root");
+  ValidatePrivateDirectoryDescriptor(impl_->entries_descriptor,
+                                     "ArtifactCache hash directory");
+  const EntryAddress address = ResolveEntryAddress(request, build_spec);
+  const std::vector<uint8_t> expected_cache_identity =
+      Artifact::SerializeCacheKeyIdentity(request, build_spec);
+  bool shard_missing = false;
+  ScopedDescriptor shard(OpenPrivateDirectoryAt(
+      impl_->entries_descriptor, address.shard, &shard_missing));
+  if (shard_missing) return std::nullopt;
+  bool missing = false;
+  std::vector<uint8_t> bytes =
+      ReadCompleteEntry(shard.Get(), address.name, &missing);
+  if (missing) return std::nullopt;
+  Artifact artifact =
+      Artifact::DeserializeCanonical(bytes, request, build_spec);
+  if (artifact.SerializeCacheKeyIdentity() != expected_cache_identity ||
+      artifact.GetCacheKeyDigest() != address.digest) {
+    throw RuntimeError("ArtifactCache entry differs from its filename cache key");
+  }
+  return std::optional<Artifact>(std::move(artifact));
+#else
+  (void)request;
+  (void)build_spec;
+  throw NotImplementedError("ArtifactCache requires Linux");
+#endif
+}
+
+ArtifactCachePublishResult ArtifactCache::Publish(
+    const Artifact& artifact, const CompileRequest& request,
+    const KernelBuildSpec& build_spec) const {
+#if defined(__linux__)
+  ValidateCacheProcess(impl_->owner_process);
+  ValidatePrivateDirectoryDescriptor(impl_->root_descriptor,
+                                     "ArtifactCache root");
+  ValidatePrivateDirectoryDescriptor(impl_->entries_descriptor,
+                                     "ArtifactCache hash directory");
+  const EntryAddress address = ResolveEntryAddress(request, build_spec);
+  const std::vector<uint8_t> expected_cache_identity =
+      Artifact::SerializeCacheKeyIdentity(request, build_spec);
+  if (artifact.SerializeCacheKeyIdentity() != expected_cache_identity ||
+      artifact.GetCacheKeyDigest() != address.digest) {
+    throw ValueError(
+        "ArtifactCache publication does not match the expected request/build cache key");
+  }
+  const std::vector<uint8_t> bytes = artifact.SerializeCanonical();
+  const Artifact reconstructed =
+      Artifact::DeserializeCanonical(bytes, request, build_spec);
+  if (reconstructed.SerializeCanonical() != bytes) {
+    throw InternalError(
+        "ArtifactCache publication changed identity during canonical validation");
+  }
+
+  ScopedDescriptor shard(
+      EnsurePrivateDirectoryAt(impl_->entries_descriptor, address.shard));
+  std::unique_ptr<PendingEntry> pending =
+      CreatePendingEntry(shard.Get());
+  WriteComplete(pending->GetDescriptor(), bytes);
+  if (::fsync(pending->GetDescriptor()) != 0) {
+    ThrowSystemError("failed to sync ArtifactCache entry", errno);
+  }
+  VerifyStagedBytes(pending->GetDescriptor(), bytes);
+  if (::fchmod(pending->GetDescriptor(), kRequiredEntryMode) != 0) {
+    ThrowSystemError("failed to make ArtifactCache entry immutable", errno);
+  }
+  if (::fsync(pending->GetDescriptor()) != 0) {
+    ThrowSystemError("failed to sync immutable ArtifactCache entry", errno);
+  }
+  ValidateImmutableStagedEntry(pending->GetDescriptor(), bytes.size());
+
+#if defined(SYS_renameat2)
+  int result = static_cast<int>(::syscall(
+      SYS_renameat2, shard.Get(), pending->GetName().c_str(), shard.Get(),
+      address.name.c_str(), RENAME_NOREPLACE));
+  if (result == 0) {
+    pending->Published();
+    if (::fsync(shard.Get()) != 0) {
+      ThrowSystemError("failed to sync ArtifactCache directory", errno);
+    }
+    return ArtifactCachePublishResult::Published;
+  }
+  const int rename_error = errno;
+  if (rename_error != EEXIST) {
+    ThrowSystemError("failed to atomically publish ArtifactCache entry",
+                     rename_error);
+  }
+#else
+  throw NotImplementedError("ArtifactCache publication requires Linux renameat2");
+#endif
+
+  pending.reset();
+  std::optional<Artifact> existing = Lookup(request, build_spec);
+  if (!existing) {
+    throw RuntimeError(
+        "ArtifactCache publication lost a concurrent no-replace winner");
+  }
+  if (existing->SerializeCanonical() != bytes) {
+    throw RuntimeError(
+        "ArtifactCache key was concurrently populated with a different Artifact");
+  }
+  if (::fsync(shard.Get()) != 0) {
+    ThrowSystemError("failed to sync concurrent ArtifactCache directory", errno);
+  }
+  return ArtifactCachePublishResult::AlreadyPresent;
+#else
+  (void)artifact;
+  (void)request;
+  (void)build_spec;
+  throw NotImplementedError("ArtifactCache requires Linux");
+#endif
+}
+
+}  // namespace pypto::compiler
