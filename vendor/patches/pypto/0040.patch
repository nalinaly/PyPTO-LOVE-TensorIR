+struct TemporaryCacheDirectory {
+  explicit TemporaryCacheDirectory(std::string prefix) {
+#if defined(__linux__)
+    std::string model = "/tmp/" + std::move(prefix) + "-XXXXXX";
+    std::vector<char> bytes(model.begin(), model.end());
+    bytes.push_back('\0');
+    char* created = ::mkdtemp(bytes.data());
+    if (created != nullptr) path = created;
+#else
+    (void)prefix;
+#endif
+  }
+
+  ~TemporaryCacheDirectory() {
+    if (!path.empty()) {
+      std::error_code error;
+      (void)std::filesystem::remove_all(path, error);
+    }
+  }
+
+  TemporaryCacheDirectory(const TemporaryCacheDirectory&) = delete;
+  TemporaryCacheDirectory& operator=(const TemporaryCacheDirectory&) = delete;
+
+  std::string path;
+};
+
+#if defined(__linux__)
+bool WaitForOwnedChild(pid_t child, int* exit_code) {
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  int status = 0;
+  while (std::chrono::steady_clock::now() < deadline) {
+    const pid_t waited = ::waitpid(child, &status, WNOHANG);
+    if (waited == child) {
+      if (!WIFEXITED(status)) return false;
+      *exit_code = WEXITSTATUS(status);
+      return true;
+    }
+    if (waited == -1) {
+      if (errno == EINTR) continue;
+      return false;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  (void)::kill(child, SIGKILL);
+  while (::waitpid(child, &status, 0) == -1 && errno == EINTR) {
+  }
+  return false;
+}
+#endif
+
+int TestArtifactCache(const Artifact& artifact, const CompileRequest& request,
+                      const KernelBuildSpec& build_spec) {
+#if defined(__linux__)
+  TemporaryCacheDirectory directory("pypto-artifact-cache");
+  REQUIRE(!directory.path.empty());
+  ArtifactCache cache(directory.path);
+  REQUIRE(cache.GetRootDirectory() == directory.path);
+  REQUIRE(!cache.Lookup(request, build_spec).has_value());
+  REQUIRE(cache.Publish(artifact, request, build_spec) ==
+          ArtifactCachePublishResult::Published);
+  auto cached = cache.Lookup(request, build_spec);
+  REQUIRE(cached.has_value());
+  REQUIRE(cached->SerializeCanonical() == artifact.SerializeCanonical());
+  REQUIRE(cache.Publish(artifact, request, build_spec) ==
+          ArtifactCachePublishResult::AlreadyPresent);
+
+  REQUIRE(::chmod(directory.path.c_str(), 0755) == 0);
+  REQUIRE(Rejects([&]() {
+    (void)cache.Lookup(request, build_spec);
+  }));
+  REQUIRE(::chmod(directory.path.c_str(), 0700) == 0);
+
+  const pid_t inherited_child = ::fork();
+  REQUIRE(inherited_child >= 0);
+  if (inherited_child == 0) {
+    bool rejected = false;
+    try {
+      (void)cache.Lookup(request, build_spec);
+    } catch (const RuntimeError& error) {
+      rejected = std::string(error.what()).find("after fork") !=
+                 std::string::npos;
+    }
+    _exit(rejected ? 0 : 1);
+  }
+  int inherited_exit_code = -1;
+  REQUIRE(WaitForOwnedChild(inherited_child, &inherited_exit_code));
+  REQUIRE(inherited_exit_code == 0);
+
+  TemporaryCacheDirectory concurrent_directory(
+      "pypto-artifact-cache-concurrent");
+  REQUIRE(!concurrent_directory.path.empty());
+  std::array<pid_t, 2> children{};
+  for (pid_t& child : children) {
+    child = ::fork();
+    REQUIRE(child >= 0);
+    if (child == 0) {
+      try {
+        ArtifactCache child_cache(concurrent_directory.path);
+        const ArtifactCachePublishResult result =
+            child_cache.Publish(artifact, request, build_spec);
+        _exit(result == ArtifactCachePublishResult::Published ? 10 : 11);
+      } catch (...) {
+        _exit(1);
+      }
+    }
+  }
+  std::array<int, 2> exit_codes{};
+  for (size_t index = 0; index < children.size(); ++index) {
+    REQUIRE(WaitForOwnedChild(children[index], &exit_codes[index]));
+  }
+  std::sort(exit_codes.begin(), exit_codes.end());
+  REQUIRE((exit_codes == std::array<int, 2>{10, 11}));
+  ArtifactCache concurrent_cache(concurrent_directory.path);
+  auto concurrent_artifact = concurrent_cache.Lookup(request, build_spec);
+  REQUIRE(concurrent_artifact.has_value());
+  REQUIRE(concurrent_artifact->SerializeCanonical() ==
+          artifact.SerializeCanonical());
+#else
+  (void)artifact;
+  (void)request;
+  (void)build_spec;
+#endif
+  return 0;
+}
