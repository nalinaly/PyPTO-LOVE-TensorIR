+def test_artifact_cache_fixed_directories_ignore_hostile_umask(
+    tmp_path: Path,
+) -> None:
+    root = _private_cache_root(tmp_path, "hostile-umask")
+    previous_umask = os.umask(0o777)
+    try:
+        cache = ArtifactCache(str(root))
+    finally:
+        os.umask(previous_umask)
+    assert cache.root_directory == str(root)
+    directory = root
+    for component in ("pypto-nvidia-artifacts", "v1", "sha256"):
+        directory /= component
+        assert stat.S_IMODE(directory.stat().st_mode) == 0o700
+
