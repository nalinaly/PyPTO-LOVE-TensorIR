+    insecure_root = _private_cache_root(tmp_path, "insecure")
+    insecure_root.chmod(0o755)
+    with pytest.raises(ValueError, match="mode 0700"):
+        ArtifactCache(str(insecure_root))
+
+    unsafe_parent = tmp_path / "unsafe-parent"
+    unsafe_parent.mkdir(mode=0o700)
+    unsafe_parent.chmod(0o777)
+    unsafe_child = unsafe_parent / "cache"
+    unsafe_child.mkdir(mode=0o700)
+    unsafe_child.chmod(0o700)
+    with pytest.raises(ValueError, match="ancestor"):
+        ArtifactCache(str(unsafe_child))
+
+    real_root = _private_cache_root(tmp_path, "real")
+    symlink_root = tmp_path / "symlink-root"
+    symlink_root.symlink_to(real_root, target_is_directory=True)
+    with pytest.raises(RuntimeError, match="failed to open canonical"):
+        ArtifactCache(str(symlink_root))
+
+    fixed_component_root = _private_cache_root(tmp_path, "fixed-component")
+    fixed_target = _private_cache_root(tmp_path, "fixed-target")
+    (fixed_component_root / "pypto-nvidia-artifacts").symlink_to(
+        fixed_target,
+        target_is_directory=True,
+    )
+    with pytest.raises(RuntimeError, match="directory component"):
+        ArtifactCache(str(fixed_component_root))
+
+    root = _private_cache_root(tmp_path, "entry-security")
+    cache = ArtifactCache(str(root))
+    assert cache.publish(artifact, request, build_spec) == ArtifactCachePublishResult.Published
+    entry = _cache_entry_path(root, artifact)
+    canonical = artifact.serialize()
+
+    entry.chmod(0o600)
+    with pytest.raises(RuntimeError, match="immutable owner-only"):
+        cache.lookup(request, build_spec)
+    entry.chmod(0o400)
+
+    hardlink = tmp_path / "entry-hardlink"
+    os.link(entry, hardlink)
+    with pytest.raises(RuntimeError, match="immutable owner-only"):
+        cache.lookup(request, build_spec)
+    hardlink.unlink()
+
+    entry.chmod(0o600)
+    entry.write_bytes(b"\xc1")
+    entry.chmod(0o400)
+    with pytest.raises(ValueError, match="malformed Artifact"):
+        cache.lookup(request, build_spec)
+    with pytest.raises(ValueError, match="malformed Artifact"):
+        cache.publish(artifact, request, build_spec)
+    assert entry.read_bytes() == b"\xc1"
+
+    entry.chmod(0o600)
+    entry.write_bytes(canonical)
+    with entry.open("r+b") as stream:
+        stream.truncate(ARTIFACT_PAYLOAD_LIMIT + 1)
+    entry.chmod(0o400)
+    with pytest.raises(RuntimeError, match="bounded regular file"):
+        cache.lookup(request, build_spec)
+
+    entry.chmod(0o600)
+    entry.write_bytes(canonical)
+    entry.unlink()
+    outside = tmp_path / "outside-artifact"
+    outside.write_bytes(canonical)
+    outside.chmod(0o400)
+    entry.symlink_to(outside)
+    with pytest.raises(RuntimeError, match="failed to open ArtifactCache entry"):
+        cache.lookup(request, build_spec)
+    with pytest.raises(RuntimeError, match="failed to open ArtifactCache entry"):
+        cache.publish(artifact, request, build_spec)
+    entry.unlink()
+
+    os.mkfifo(entry, mode=0o400)
+    with pytest.raises(RuntimeError, match="immutable owner-only"):
+        cache.lookup(request, build_spec)
+    entry.unlink()
+
+    shard = entry.parent
+    outside_shard = _private_cache_root(tmp_path, "outside-shard")
+    shard.rmdir()
+    shard.symlink_to(outside_shard, target_is_directory=True)
+    with pytest.raises(RuntimeError, match="directory component"):
+        cache.lookup(request, build_spec)
+
+
+def test_artifact_cache_rejects_inherited_handle_and_wrong_build_identity(
+    tmp_path: Path,
+    artifact_case: tuple[bytes, CompileRequest, KernelBuildSpec, ArtifactKernelAbi, Artifact],
+) -> None:
+    canonical_source, request, build_spec, expected_kernel_abi, artifact = artifact_case
+    root = _private_cache_root(tmp_path, "fork-and-identity")
+    cache = ArtifactCache(str(root))
+    wrong_spec = _build_spec(
+        request,
+        canonical_source + b"\n",
+        expected_kernel_abi,
+    )
+    with pytest.raises(ValueError, match="request/build cache key"):
+        cache.publish(artifact, request, wrong_spec)
+
+    if not hasattr(os, "fork"):
+        pytest.skip("fork inheritance contract requires POSIX")
+    child = os.fork()
+    if child == 0:
+        try:
+            cache.lookup(request, build_spec)
+        except RuntimeError as error:
+            os._exit(0 if "after fork" in str(error) else 1)
+        os._exit(1)
+    deadline = time.monotonic() + 10
+    status = None
+    while time.monotonic() < deadline:
+        waited, candidate_status = os.waitpid(child, os.WNOHANG)
+        if waited == child:
+            status = candidate_status
+            break
+        time.sleep(0.01)
+    if status is None:
+        os.kill(child, 9)
+        os.waitpid(child, 0)
+        pytest.fail("inherited ArtifactCache child did not exit within 10 seconds")
+    assert os.waitstatus_to_exitcode(status) == 0
+
+
 if __name__ == "__main__":
     pytest.main([__file__, "-v"])
