+def _cache_entry_path(root: Path, artifact: Artifact) -> Path:
+    digest = artifact.cache_key_digest
+    return root / "pypto-nvidia-artifacts" / "v1" / "sha256" / digest[:2] / f"{digest}.artifact"
+
