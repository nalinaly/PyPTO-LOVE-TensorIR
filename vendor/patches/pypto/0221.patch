+def test_compile_structured_strict_cached_cold_then_warm(
+    tmp_path: Path,
+) -> None:
+    info = get_nvidia_backend_build_info()
+    root = tmp_path / "structured-artifact-cache"
+    root.mkdir(mode=0o700)
+    root.chmod(0o700)
+    cache = ArtifactCache(str(root))
+    request = _request(info)
+    program = _program()
+    schedule = _schedule()
+
+    if not info.compiled:
+        with pytest.raises(
+            ValueError, match="requires the compiled private NVIDIA backend"
+        ):
+            compile_structured_strict_cached(
+                program, request, schedule, cache
+            )
+        return
+
+    cold = compile_structured_strict_cached(program, request, schedule, cache)
+    assert cold.disposition == StructuredCompileDisposition.CompiledAndPublished
+    warm = compile_structured_strict_cached(program, request, schedule, cache)
+    assert warm.disposition == StructuredCompileDisposition.CacheHit
+    assert warm.build_spec.serialize() == cold.build_spec.serialize()
+    assert warm.artifact.serialize() == cold.artifact.serialize()
+
+    paged_root = tmp_path / "structured-paged-decode-cache"
+    paged_root.mkdir(mode=0o700)
+    paged_root.chmod(0o700)
+    paged_cache = ArtifactCache(str(paged_root))
+    paged_program = _native_tile_paged_decode.specialize(scale=0.0625)
+    paged_schedule = _schedule([1, 64])
+    paged_cold = compile_structured_strict_cached(
+        paged_program, request, paged_schedule, paged_cache
+    )
+    assert (
+        paged_cold.disposition
+        == StructuredCompileDisposition.CompiledAndPublished
+    )
+    paged_warm = compile_structured_strict_cached(
+        paged_program, request, paged_schedule, paged_cache
+    )
+    assert paged_warm.disposition == StructuredCompileDisposition.CacheHit
+    assert paged_warm.build_spec.serialize() == paged_cold.build_spec.serialize()
+    assert paged_warm.artifact.serialize() == paged_cold.artifact.serialize()
+
+
