+  }
+  if (prepared.getTileIRBytecodeVersion().getMajor() != 13 ||
+      prepared.getTileIRBytecodeVersion().getMinor() != 3 ||
+      prepared.getTileIRBytecodeVersion().getTag() != 0) {
+    return "TensorIR prepared bytecode version differs from 13.3.0";
+  }
+  if (prepared.getTileIRBytecode().empty() ||
+      prepared.getTileIRBytecode().size() > kMaximumDeviceCodeBytes) {
+    return "TensorIR prepared TileIR must contain at most 64 MiB";
+  }
+  if (prepared.getRuntimeKernelName().empty() ||
+      prepared.getRuntimeKernelName().size() > kMaximumNameBytes ||
+      prepared.getEntryFunctionName().empty() ||
