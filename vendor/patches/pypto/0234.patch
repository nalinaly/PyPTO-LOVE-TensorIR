+mlir::Value BuildNativeAttention(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const NativeAttentionTensorIrSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                           entry.getArguments().end());
+  const auto& query_spec = spec.inputs[0];
+  const auto& key_spec = spec.inputs[1];
+  const auto& value_spec = spec.inputs[2];
+  const int64_t rows = query_spec.shape[0];
+  const int64_t tokens = key_spec.shape[0];
+  const int64_t head_dim = query_spec.shape[1];
+  const int64_t value_dim = value_spec.shape[1];
+  const auto score_type = TensorType(
+      builder, TypedTensorIrElementType::FP32, {rows, tokens});
+  const auto row_type =
+      TensorType(builder, TypedTensorIrElementType::FP32, {rows, 1});
+  const auto key_transposed_type = Tensor(
+      builder, TypedTensorIrElementType::BF16, {head_dim, tokens});
+  const auto probability_type =
+      Tensor(builder, TypedTensorIrElementType::BF16, {rows, tokens});
+  const auto accumulation_type = Tensor(
+      builder, TypedTensorIrElementType::FP32, {rows, value_dim});
+  const auto result_type =
