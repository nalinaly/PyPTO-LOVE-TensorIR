+bool ValidateNativeAttentionSpec(const NativeAttentionTensorIrSpec& spec,
+                                 std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR attention specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (size_t index = 0; index < 3; ++index) {
+    const auto& input = spec.inputs[index];
+    if (!HasValidStaticMetadata(input) || input.shape.size() != 2 ||
+        input.element_type != TypedTensorIrElementType::BF16 ||
+        input.strides[1] != 1 || input.strides[0] < input.shape[1]) {
+      return reject("Q/K/V must be row-pitched rank-2 BF16 tensors");
+    }
+  }
+  const auto& query = spec.inputs[0];
+  const auto& key = spec.inputs[1];
+  const auto& value = spec.inputs[2];
+  if (!HasValidStaticMetadata(spec.result) ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      spec.result.shape.size() != 2 || spec.result.strides[1] != 1 ||
+      spec.result.strides[0] < spec.result.shape[1] ||
+      query.shape[1] != key.shape[1] || key.shape[0] != value.shape[0] ||
+      query.shape[0] != spec.result.shape[0] ||
+      value.shape[1] != spec.result.shape[1] || query.shape[1] % 128 != 0 ||
+      key.shape[0] % 16 != 0 || value.shape[1] % 16 != 0 ||
+      !std::isfinite(spec.scale)) {
+    return reject("Q/K/V/result geometry or dtype is invalid");
+  }
+  if (spec.has_additive_mask) {
+    const auto& mask = spec.inputs[3];
+    if (!HasValidStaticMetadata(mask) || mask.element_type !=
+                                             TypedTensorIrElementType::FP32 ||
+        mask.shape != std::vector<int64_t>{query.shape[0], key.shape[0]} ||
+        mask.strides[1] != 1 || mask.strides[0] < mask.shape[1]) {
+      return reject("additive mask must be row-pitched FP32 [rows,tokens]");
+    }
+  }
+  const double expected_scale =
+      1.0 / std::sqrt(static_cast<double>(query.shape[1]));
+  if (std::fabs(spec.scale - expected_scale) >
+      std::numeric_limits<double>::epsilon()) {
+    return reject("scale does not equal 1/sqrt(head_dim)");
+  }
+  return true;
+}
+
+bool ValidateNativePagedGatherSpec(
+    const NativePagedGatherTensorIrSpec& spec, std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR paged gather specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (const auto& input : spec.inputs) {
+    if (!HasValidStaticMetadata(input)) {
+      return reject("inputs must have fully static explicit metadata");
+    }
+  }
+  if (!HasValidStaticMetadata(spec.result)) {
+    return reject("result must have fully static explicit metadata");
+  }
+  const auto& cache = spec.inputs[0];
+  const auto& request_table = spec.inputs[1];
+  const auto& request_index = spec.inputs[2];
+  const auto& mapping = spec.inputs[3];
+  if (cache.element_type != TypedTensorIrElementType::BF16 ||
+      cache.shape.size() != 2 || cache.strides[1] != 1 ||
+      cache.strides[0] < cache.shape[1] ||
+      request_table.element_type != TypedTensorIrElementType::INT32 ||
+      request_table.shape.size() != 2 || !IsDense(request_table) ||
+      request_index.element_type != TypedTensorIrElementType::INT64 ||
+      request_index.shape != std::vector<int64_t>{1, spec.tokens} ||
+      request_index.strides.size() != 2 || request_index.strides[0] != 0 ||
+      request_index.strides[1] != 0 ||
+      mapping.element_type != TypedTensorIrElementType::INT64 ||
+      mapping.shape.size() != 2 || mapping.shape[1] != 1 ||
+      mapping.strides[1] != 1 || mapping.strides[0] < 1 ||
+      spec.tokens <= 0 || spec.tokens % 16 != 0 || spec.row_width <= 0 ||
+      spec.row_width % 128 != 0 || cache.shape[1] != spec.row_width ||
+      request_table.shape[1] < spec.tokens ||
+      !IsDenseOrRowPitchedRank2(spec.result) ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      spec.result.shape != std::vector<int64_t>{spec.tokens, spec.row_width} ||
+      cache.shape[0] <= 0 || request_table.shape[0] <= 0 ||
+      mapping.shape[0] <= 0) {
+    return reject("cache, request metadata, mapping, or result geometry is invalid");
+  }
+  return true;
+}
