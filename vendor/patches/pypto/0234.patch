@@ -4828,6 +4828,47 @@ TypedTensorIrModuleSpec MakeNativeSigmoidAndMulTensorIrSpec(
   return module_spec;
 }
 
+TypedTensorIrModuleSpec MakeNativeAttentionTensorIrSpec(
+    const NativeTileAttentionGraph& graph) {
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativeAttention;
+  auto& spec = module_spec.native_attention;
+  spec.inputs[0] = MakeTypedTensorIrTensorSpec(
+      graph.query, /*has_explicit_strides=*/true);
+  spec.inputs[1] = MakeTypedTensorIrTensorSpec(
+      graph.key, /*has_explicit_strides=*/true);
+  spec.inputs[2] = MakeTypedTensorIrTensorSpec(
+      graph.value, /*has_explicit_strides=*/true);
+  if (graph.additive_mask.has_value()) {
+    spec.inputs[3] = MakeTypedTensorIrTensorSpec(
+        *graph.additive_mask, /*has_explicit_strides=*/true);
+    spec.has_additive_mask = true;
+  }
+  spec.result = MakeTypedTensorIrTensorSpec(
+      graph.result, /*has_explicit_strides=*/true);
+  spec.scale = graph.scale;
+  return module_spec;
+}
+
+TypedTensorIrModuleSpec MakeNativePagedGatherTensorIrSpec(
+    const NativeTilePagedGatherGraph& graph) {
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativePagedGather;
+  auto& spec = module_spec.native_paged_gather;
+  const std::array<StaticTensor, NativePagedGatherTensorIrSpec::kInputCount>
+      inputs = {graph.cache, graph.req_to_token, graph.request_index,
+                graph.virtual_to_physical};
+  for (size_t index = 0; index < inputs.size(); ++index) {
+    spec.inputs[index] = MakeTypedTensorIrTensorSpec(
+        inputs[index], /*has_explicit_strides=*/true);
+  }
+  spec.result = MakeTypedTensorIrTensorSpec(
+      graph.result, /*has_explicit_strides=*/true);
+  spec.tokens = graph.tokens;
+  spec.row_width = graph.row_width;
+  return module_spec;
+}
