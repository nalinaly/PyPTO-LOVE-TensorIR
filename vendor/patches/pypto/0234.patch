+mlir::Value BuildNativePagedGather(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const NativePagedGatherTensorIrSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                           entry.getArguments().end());
+  const int64_t request_rows = spec.inputs[1].shape[0];
+  const int64_t tokens = spec.tokens;
+  const int64_t row_width = spec.row_width;
+  const auto index_type =
+      Tensor(builder, TypedTensorIrElementType::INT32, {1, tokens});
+  const auto request_prefix_type =
+      Tensor(builder, TypedTensorIrElementType::INT32, {request_rows, tokens});
+  const auto virtual_column_type =
+      Tensor(builder, TypedTensorIrElementType::INT32, {tokens, 1});
+  const auto physical_column_type =
+      Tensor(builder, TypedTensorIrElementType::INT64, {tokens, 1});
+  const auto physical_column_i32_type =
+      Tensor(builder, TypedTensorIrElementType::INT32, {tokens, 1});
+  const auto physical_indices_type = Tensor(
+      builder, TypedTensorIrElementType::INT32, {tokens, row_width});
+  const auto result_type =
+      Tensor(builder, TypedTensorIrElementType::BF16, spec.result.shape);
+
+  const mlir::Value request_index = tir::ConvertOp::create(
+      builder, location, index_type, arguments[2])
+                                         .getOutput();
+  const mlir::Value request_prefix = tir::SliceOp::create(
+      builder, location, request_prefix_type, arguments[1],
+      llvm::ArrayRef<int64_t>{0, 0},
+      llvm::ArrayRef<int64_t>{request_rows, tokens},
+      llvm::ArrayRef<int64_t>{1, 1})
+                                         .getOutput();
+  const mlir::Value request_row = tir::GatherRowsOp::create(
+      builder, location, index_type, request_prefix, request_index)
+                                      .getOutput();
+  const mlir::Value virtual_column = tir::TransposeOp::create(
+      builder, location, virtual_column_type, request_row,
+      llvm::ArrayRef<int64_t>{1, 0})
+      .getOutput();
+  const mlir::Value physical_column = tir::GatherRowsOp::create(
+      builder, location, physical_column_type, arguments[3], virtual_column)
+                                          .getOutput();
+  const mlir::Value physical_column_i32 = tir::ConvertOp::create(
+      builder, location, physical_column_i32_type, physical_column)
+                                                .getOutput();
+  const mlir::Value physical_indices = tir::BroadcastOp::create(
+      builder, location, physical_indices_type, physical_column_i32,
+      mlir::ValueRange{})
+      .getOutput();
+  return tir::GatherRowsOp::create(builder, location, result_type, arguments[0],
+                                   physical_indices)
+      .getOutput();
+}
