+      tir::ReciprocalOp::create(builder, location, row_type, row_sum)
+          .getOutput();
+  const mlir::Value inverse_broadcast =
+      tir::BroadcastOp::create(builder, location, score_type, inverse,
+                               mlir::ValueRange{})
+          .getOutput();
