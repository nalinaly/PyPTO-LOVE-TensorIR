@@ -6259,6 +6259,10 @@ NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
       req_to_token.shape.size() != 2 || request_index.shape.size() != 2 ||
       valid_tokens.shape.size() != 2 || result.dtype != query.dtype ||
       result.shape != query.shape ||
+      query.dense_strides.size() != 3 || query.dense_strides[2] != 1 ||
+      query.dense_strides[1] != query.shape[2] ||
+      result.dense_strides.size() != 3 || result.dense_strides[2] != 1 ||
+      result.dense_strides[1] != result.shape[2] ||
       !SameTensor(result, declared)) {
     Reject("native paged decode tensor types or ranks are invalid",
            &function->span_);
@@ -6270,6 +6274,9 @@ NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
   const int64_t tokens = request_index.shape[1];
   if (batch_size <= 0 || q_heads <= 0 || head_dim <= 0 || cache_rows <= 0 ||
       tokens <= 0 ||
+      q_heads > std::numeric_limits<int64_t>::max() / head_dim ||
+      query.dense_strides[0] < q_heads * head_dim ||
+      result.dense_strides[0] < q_heads * head_dim ||
       head_dim % 128 != 0 || tokens % 16 != 0 ||
       key_cache.shape[1] % head_dim != 0 ||
       req_to_token.shape[0] <= 0 || req_to_token.shape[1] < tokens ||
