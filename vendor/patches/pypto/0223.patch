+    dense_decode = compile_structured_strict(
+        _paged_decode_program(result_strides=None),
+        request,
+        _schedule([1, 64]),
+    )
+    dense_result = dense_decode.artifact.kernel_abi.argument_layout.operand_descriptors[7]
+    assert dense_result.strides == [1024, 256, 1]
+    assert dense_decode.build_spec.result_abi_digest != paged_decode.build_spec.result_abi_digest
+    assert dense_decode.artifact.cache_key_digest != paged_decode.artifact.cache_key_digest
+    assert not dense_decode.artifact.fallback_used
+
+
+def test_native_paged_decode_rejects_invalid_output_strides() -> None:
+    request = _request(get_nvidia_backend_build_info())
+    for strides in (
+        (1023, 256, 1),
+        (2048, 255, 1),
+        (2048, 256, 2),
+        (0, 256, 1),
+    ):
+        with pytest.raises(
+            ValueError,
+            match="native paged decode (tensor types or ranks|static geometry)",
+        ):
+            compile_structured_strict(
+                _paged_decode_program(result_strides=strides),
+                request,
+                _schedule([1, 64]),
+            )
+
 
