+def _paged_decode_program(
+    *, result_strides: tuple[int, int, int] | None = (2048, 256, 1)
+):
+    query = torch.empty_strided(
+        (1, 4, 256), (2048, 256, 1), dtype=torch.bfloat16, device="meta"
+    )
+    key_cache = torch.empty_strided(
+        (1024, 256), (512, 1), dtype=torch.bfloat16, device="meta"
+    )
+    value_cache = torch.empty_strided(
+        (1024, 256), (512, 1), dtype=torch.bfloat16, device="meta"
+    )
+    req_to_token = torch.empty((65, 4096), dtype=torch.int32, device="meta")
+    request_index = torch.empty_strided(
+        (1, 16), (1, 0), dtype=torch.int64, device="meta"
+    )
+    valid_tokens = torch.empty_strided(
+        (1, 16), (1, 0), dtype=torch.int64, device="meta"
+    )
+    virtual_to_physical = torch.empty(
+        (1024, 1), dtype=torch.int64, device="meta"
+    )
+    out = (
+        torch.empty((1, 4, 256), dtype=torch.bfloat16, device="meta")
+        if result_strides is None
+        else torch.empty_strided(
+            (1, 4, 256), result_strides, dtype=torch.bfloat16, device="meta"
+        )
+    )
+    return _native_tile_paged_decode.specialize(
+        query,
+        key_cache,
+        value_cache,
+        req_to_token,
+        request_index,
+        valid_tokens,
+        virtual_to_physical,
+        0.0625,
+        out,
+    )
+
+
