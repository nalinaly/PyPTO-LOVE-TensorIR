+class GenericTensorIrSpecBuilder {
+ public:
+  explicit GenericTensorIrSpecBuilder(const std::vector<StaticTensor>& inputs) {
+    module_spec_.kind = TypedTensorIrModuleKind::Generic;
+    module_spec_.generic.inputs.reserve(inputs.size());
+    for (const StaticTensor& input : inputs) {
+      module_spec_.generic.inputs.push_back(MakeTypedTensorIrTensorSpec(
+          input, /*has_explicit_strides=*/input.shape.size() >= 2));
+    }
+    input_count_ = inputs.size();
+  }
+
+  uint32_t Input(size_t index) const {
+    if (index >= input_count_) InternalReject("generic TensorIR input index is invalid");
+    return static_cast<uint32_t>(index);
+  }
+
+  uint32_t Append(TypedTensorIrOperationSpec operation) {
+    module_spec_.generic.operations.push_back(std::move(operation));
+    return static_cast<uint32_t>(input_count_ +
+                                 module_spec_.generic.operations.size() - 1);
+  }
+
+  uint32_t TensorOp(TypedTensorIrOpKind kind, std::vector<uint32_t> operands,
+                    const StaticTensor& result) {
+    return Append(MakeGenericOperation(kind, std::move(operands), result));
+  }
+
+  uint32_t TypedTensorOp(TypedTensorIrOpKind kind,
+                         std::vector<uint32_t> operands,
+                         TypedTensorIrTensorSpec result) {
+    TypedTensorIrOperationSpec operation;
+    operation.kind = kind;
+    operation.operands = std::move(operands);
+    operation.result = std::move(result);
+    return Append(std::move(operation));
+  }
+
+  uint32_t Constant(DataType dtype, double value) {
+    return Append(MakeGenericConstant(dtype, value));
+  }
+
+  uint32_t Splat(uint32_t scalar, const StaticTensor& result) {
+    return TensorOp(TypedTensorIrOpKind::Splat, {scalar}, result);
+  }
+
+  void AddResult(const StaticTensor& result) {
+    module_spec_.generic.results.push_back(MakeTypedTensorIrTensorSpec(
+        result, /*has_explicit_strides=*/result.shape.size() >= 2));
+  }
+
+  TypedTensorIrModuleSpec Finish(std::vector<uint32_t> result_values) && {
+    if (module_spec_.generic.results.size() != result_values.size()) {
+      InternalReject("generic TensorIR result count does not match result values");
+    }
+    module_spec_.generic.result_values = std::move(result_values);
+    return std::move(module_spec_);
+  }
+
+ private:
+  TypedTensorIrModuleSpec module_spec_;
+  size_t input_count_ = 0;
+};
