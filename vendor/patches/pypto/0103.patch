+std::string EmitNativeTileCausalConvSource(
+    const NativeTileCausalConvGraph& graph) {
+  StaticTensor compute = graph.input;
+  compute.dtype = DataType::FP32;
+  StaticTensor weightCompute = graph.weight;
+  weightCompute.dtype = DataType::FP32;
+  StaticTensor weightColumn{DataType::FP32, {graph.input.shape[0], 1}, {1, 1}};
+  const std::string inputType = TensorTypeText(graph.input);
+  const std::string computeType = TensorTypeText(compute);
+  const std::string weightType = TensorTypeText(graph.weight);
+  const std::string weightComputeType = TensorTypeText(weightCompute);
+  const std::string weightColumnType = TensorTypeText(weightColumn);
+
+  std::string source;
+  source.reserve(8192);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.input);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.weight);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %x_wide = convert %arg0 : ";
+  source += inputType;
+  source += " -> ";
+  source += computeType;
+  source += "\n    %weight_wide = convert %arg1 : ";
+  source += weightType;
+  source += " -> ";
+  source += weightComputeType;
+  source += "\n    %zero = constant 0.0 : f32\n";
+
+  for (size_t tap = 0; tap < 3; ++tap) {
+    const int64_t prefix = 3 - static_cast<int64_t>(tap);
+    StaticTensor prefixTensor{DataType::FP32,
+                              {graph.input.shape[0], prefix}, {prefix, 1}};
+    StaticTensor bodyTensor{
+        DataType::FP32,
+        {graph.input.shape[0], graph.input.shape[1] - prefix},
+        {graph.input.shape[1] - prefix, 1}};
+    const std::string prefixType = TensorTypeText(prefixTensor);
+    const std::string bodyType = TensorTypeText(bodyTensor);
+    source += "    %zero";
+    AppendIndex(source, tap);
+    source += " = splat %zero : ";
+    source += prefixType;
+    source += "\n    %body";
+    AppendIndex(source, tap);
+    source += " = slice %x_wide starts = [0, 0] limits = [";
+    AppendInteger(source, graph.input.shape[0]);
+    source += ", ";
+    AppendInteger(source, graph.input.shape[1] - prefix);
+    source += "] strides = [1, 1] : ";
+    source += computeType;
+    source += " -> ";
+    source += bodyType;
+    source += "\n    %shifted";
+    AppendIndex(source, tap);
+    source += " = concatenate %zero";
+    AppendIndex(source, tap);
+    source += ", %body";
+    AppendIndex(source, tap);
+    source += " dimension = 1 : (";
+    source += prefixType;
+    source += ", ";
+    source += bodyType;
+    source += ") -> ";
+    source += computeType;
+    source += "\n    %weight";
+    AppendIndex(source, tap);
+    source += " = slice %weight_wide starts = [0, ";
+    AppendIndex(source, tap);
+    source += "] limits = [";
+    AppendInteger(source, graph.input.shape[0]);
+    source += ", ";
+    AppendIndex(source, tap + 1);
+    source += "] strides = [1, 1] : ";
+    source += weightComputeType;
+    source += " -> ";
+    source += weightColumnType;
+    source += "\n    %weight_broadcast";
+    AppendIndex(source, tap);
+    source += " = broadcast %weight";
+    AppendIndex(source, tap);
+    source += " : ";
+    source += weightColumnType;
+    source += " -> ";
+    source += computeType;
+    source += "\n    %term";
+    AppendIndex(source, tap);
+    source += " = mul %shifted";
+    AppendIndex(source, tap);
+    source += ", %weight_broadcast";
+    AppendIndex(source, tap);
+    source += " : ";
+    source += computeType;
+    source += "\n";
+  }
+  source += "    %weight3 = slice %weight_wide starts = [0, 3] limits = [";
+  AppendInteger(source, graph.input.shape[0]);
+  source += ", 4] strides = [1, 1] : ";
+  source += weightComputeType;
+  source += " -> ";
+  source += weightColumnType;
+  source += "\n    %weight_broadcast3 = broadcast %weight3 : ";
+  source += weightColumnType;
+  source += " -> ";
+  source += computeType;
+  source += "\n    %term3 = mul %x_wide, %weight_broadcast3 : ";
+  source += computeType;
+  source += "\n    %sum01 = add %term0, %term1 : ";
+  source += computeType;
+  source += "\n    %sum23 = add %term2, %term3 : ";
+  source += computeType;
+  source += "\n    %convolution = add %sum01, %sum23 : ";
+  source += computeType;
+  source += "\n    %negative = neg %convolution : ";
+  source += computeType;
+  source += "\n    %exponent = exp %negative : ";
+  source += computeType;
+  source += "\n    %one = constant 1.0 : f32\n    %one_splat = splat %one : ";
+  source += computeType;
+  source += "\n    %denominator = add %exponent, %one_splat : ";
+  source += computeType;
+  source += "\n    %sigmoid = reciprocal %denominator : ";
+  source += computeType;
+  source += "\n    %activated = mul %convolution, %sigmoid : ";
+  source += computeType;
+  source += "\n    %result0 = convert %activated : ";
+  source += computeType;
+  source += " -> ";
+  source += inputType;
+  source += "\n    results %result0 : ";
+  source += inputType;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
