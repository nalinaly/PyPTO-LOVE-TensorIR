+bool IsNativeTileCausalConvCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 3) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const TileLoopNest loopNest = UnwrapStaticTileLoops(scope->body_);
+  if (!loopNest.leaf || loopNest.leaf->stmts_.size() != 31) return false;
+  for (const ir::StmtPtr& statement : loopNest.leaf->stmts_) {
+    const auto assignment = ir::As<ir::AssignStmt>(statement);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (call && call->op_ && ir::IsOp(call, "tile.concat")) return true;
+  }
+  return false;
+}
+
+NativeTileCausalConvGraph AnalyzeNativeTileCausalConv(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native causal conv must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 3 ||
+      function->param_directions_.size() != 3 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native causal conv requires input, weight and output",
+           &function->span_);
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native causal conv input");
+  const StaticTensor weight = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native causal conv weight");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native causal conv output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native causal conv return");
+  if (input.dtype != DataType::BF16 || input.shape.size() != 2 ||
+      input.shape[0] % 128 != 0 || input.shape[1] < 4 ||
+      weight.dtype != DataType::BF16 ||
+      weight.shape != std::vector<int64_t>({input.shape[0], 4}) ||
+      !SameTensor(input, result) || !SameTensor(result, declared)) {
+    Reject("native causal conv tensors have incompatible types or shapes",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returnedVar =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returnedVar ||
+      returnedVar.get() != function->params_[2].get()) {
+    Reject("native causal conv scope or return is invalid", &function->span_);
+  }
+  const TileLoopNest loopNest = UnwrapStaticTileLoops(scope->body_);
+  if (loopNest.repetitions != static_cast<uint64_t>(input.shape[0] / 128) ||
+      !loopNest.leaf || loopNest.leaf->stmts_.size() != 31) {
+    Reject("native causal conv channel loop coverage is invalid", &scope->span_);
+  }
+  constexpr std::array<std::string_view, 30> kOps = {
+      "tile.load", "tile.load", "tile.cast", "tile.cast", "tile.full",
+      "tile.slice", "tile.concat", "tile.slice", "tile.row_expand_mul",
+      "tile.full", "tile.slice", "tile.concat", "tile.slice",
+      "tile.row_expand_mul", "tile.full", "tile.slice", "tile.concat",
+      "tile.slice", "tile.row_expand_mul", "tile.slice",
+      "tile.row_expand_mul", "tile.add", "tile.add", "tile.add",
+      "tile.muls", "tile.exp", "tile.adds", "tile.recip", "tile.mul",
+      "tile.cast"};
+  std::array<ir::AssignStmtPtr, 30> assignments;
+  std::array<ir::CallPtr, 30> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loopNest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native causal conv tile sequence is invalid",
+             &loopNest.leaf->stmts_[index]->span_);
+    }
+  }
+  const auto inputSource = calls[0]->args_.empty()
+                               ? nullptr
+                               : ir::As<ir::Var>(calls[0]->args_[0]);
+  const auto weightSource = calls[1]->args_.empty()
+                                ? nullptr
+                                : ir::As<ir::Var>(calls[1]->args_[0]);
+  const auto negativeOne = calls[24]->args_.size() == 2
+                               ? ir::As<ir::ConstFloat>(calls[24]->args_[1])
+                               : nullptr;
+  const auto positiveOne = calls[26]->args_.size() == 2
+                               ? ir::As<ir::ConstFloat>(calls[26]->args_[1])
+                               : nullptr;
+  if (!inputSource || inputSource.get() != function->params_[0].get() ||
+      !weightSource || weightSource.get() != function->params_[1].get() ||
+      !negativeOne || negativeOne->value_ != -1.0 || !positiveOne ||
+      positiveOne->value_ != 1.0) {
+    Reject("native causal conv input or activation constants are invalid",
+           &scope->span_);
+  }
+  const auto store = ir::As<ir::EvalStmt>(loopNest.leaf->stmts_.back());
+  const auto storeCall = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  const auto stored = storeCall && storeCall->args_.size() == 3
+                          ? ir::As<ir::Var>(storeCall->args_[0])
+                          : nullptr;
+  const auto target = storeCall && storeCall->args_.size() == 3
+                          ? ir::As<ir::Var>(storeCall->args_[2])
+                          : nullptr;
+  if (!storeCall || !ir::IsOp(storeCall, "tile.store") || !stored ||
+      stored.get() != assignments[29]->var_.get() || !target ||
+      target.get() != function->params_[2].get()) {
+    Reject("native causal conv store is invalid", &scope->span_);
+  }
+  return NativeTileCausalConvGraph{input, weight, result};
+}
