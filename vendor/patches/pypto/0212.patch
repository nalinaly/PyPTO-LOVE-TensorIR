+int TestTypedSigmoidAndMulModuleBuilder() {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  using pypto::codegen::nvidia::NativeSigmoidAndMulTensorIrSpec;
+  using pypto::codegen::nvidia::TypedTensorIrElementType;
+  using pypto::codegen::nvidia::TypedTensorIrModuleKind;
+  using pypto::codegen::nvidia::TypedTensorIrModuleSpec;
+  using pypto::codegen::nvidia::TypedTensorIrTensorSpec;
+  using pypto::compiler::detail::BuildTypedTensorIrModule;
+
+  const auto tensor = [](std::vector<int64_t> shape,
+                         std::vector<int64_t> strides) {
+    return TypedTensorIrTensorSpec{TypedTensorIrElementType::BF16,
+                                   std::move(shape), std::move(strides), true};
+  };
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativeSigmoidAndMul;
+  NativeSigmoidAndMulTensorIrSpec& spec =
+      module_spec.native_sigmoid_and_mul;
+  spec.inputs = {tensor({3, 256}, {512, 1}),
+                 tensor({3, 256}, {384, 1})};
+  spec.result = tensor({3, 256}, {256, 1});
+
+  std::string diagnostic;
+  auto built = BuildTypedTensorIrModule(module_spec, diagnostic);
+  REQUIRE(built.has_value());
+  REQUIRE(diagnostic.empty());
+  const std::string source(built->canonical_source.begin(),
+                           built->canonical_source.end());
+  REQUIRE(source.find("convert") != std::string::npos);
+  REQUIRE(source.find("exp") != std::string::npos);
+  REQUIRE(source.find("reciprocal") != std::string::npos);
+
+  module_spec.native_sigmoid_and_mul.inputs[1].element_type =
+      TypedTensorIrElementType::FP32;
+  std::string invalid_diagnostic;
+  REQUIRE(!BuildTypedTensorIrModule(module_spec, invalid_diagnostic).has_value());
+  REQUIRE(invalid_diagnostic.find("row-pitched rank-2 BF16") !=
+          std::string::npos);
+#endif
+  return 0;
+}
