+      metadata.push_back(TensorIrValueMetadata(
+          TensorIrValueRole::Input, index, inputs[index].dtype,
+          inputs[index].shape, inputs[index].dense_strides,
+          /*has_explicit_strides=*/true));
+    }
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype,
+        graph.result.shape, graph.result.dense_strides,
+        /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
+                          MakeNativeSigmoidAndMulTensorIrSpec(graph),
+                          std::move(metadata), /*input_count=*/2);
+  }
   if (IsNativeTileSiluAndMulCandidate(program)) {
     const NativeTileSiluAndMulGraph graph =
         AnalyzeNativeTileSiluAndMul(program);
