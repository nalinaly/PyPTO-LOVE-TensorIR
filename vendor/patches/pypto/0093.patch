@@ -1643,6 +1643,185 @@ struct NativeTileGdnUpdateGraph {
   StaticTensor result;
 };
 
+bool IsNativeTileMatmulCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 3) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  if (!loop_nest.leaf || loop_nest.leaf->stmts_.size() != 6) return false;
+  const auto assignment = ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[3]);
+  const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+  return call && call->op_ && ir::IsOp(call, "tile.matmul");
+}
+
+StructuredMatmulGraph AnalyzeNativeTileMatmul(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native matmul must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 3 ||
+      function->param_directions_.size() != 3 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native matmul requires two inputs and one output",
+           &function->span_);
+  }
+
+  const StaticTensor lhs = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native matmul activation");
+  const StaticTensor rhs = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native matmul weight");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native matmul output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_, "native matmul return");
+  if (lhs.dtype != DataType::BF16 || rhs.dtype != DataType::BF16 ||
+      result.dtype != DataType::BF16 || lhs.shape.size() != 2 ||
+      rhs.shape.size() != 2 || result.shape.size() != 2 ||
+      lhs.shape[1] != rhs.shape[1] || result.shape[0] != lhs.shape[0] ||
+      result.shape[1] != rhs.shape[0] || !SameTensor(result, declared) ||
+      lhs.shape[1] % 128 != 0 || rhs.shape[0] % 128 != 0) {
+    Reject("native matmul activation/weight/output shapes are incompatible",
+           &function->span_);
+  }
+  ValidateStructuredMatmulConceptualWork(
+      /*batch=*/1, lhs.shape[0], rhs.shape[0], lhs.shape[1], function->span_);
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2 || !top->stmts_[0] ||
+      !top->stmts_[1]) {
+    Reject("native matmul body must contain one pl.at scope and one return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[2].get()) {
+    Reject("native matmul scope or return is invalid", &function->span_);
+  }
+
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  const uint64_t expected_tiles =
+      static_cast<uint64_t>(lhs.shape[0]) *
+      static_cast<uint64_t>(rhs.shape[0] / 128);
+  if (loop_nest.repetitions != expected_tiles || !loop_nest.leaf ||
+      loop_nest.leaf->stmts_.size() != 6) {
+    Reject("native matmul loop nest must cover every [1,128] output tile once",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 5> kOps = {
+      "tile.load", "tile.load", "tile.transpose_view", "tile.matmul",
+      "tile.cast"};
+  std::array<ir::AssignStmtPtr, 5> assignments;
+  std::array<ir::CallPtr, 5> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native matmul tile operation sequence is invalid",
+             &loop_nest.leaf->stmts_[index]->span_);
+    }
+  }
+  const auto x_source = calls[0]->args_.empty()
+                            ? nullptr
+                            : ir::As<ir::Var>(calls[0]->args_[0]);
+  const auto weight_source = calls[1]->args_.empty()
+                                 ? nullptr
+                                 : ir::As<ir::Var>(calls[1]->args_[0]);
+  const auto transpose_source = calls[2]->args_.empty()
+                                    ? nullptr
+                                    : ir::As<ir::Var>(calls[2]->args_[0]);
+  const auto matmul_lhs = calls[3]->args_.size() == 2
+                              ? ir::As<ir::Var>(calls[3]->args_[0])
+                              : nullptr;
+  const auto matmul_rhs = calls[3]->args_.size() == 2
+                              ? ir::As<ir::Var>(calls[3]->args_[1])
+                              : nullptr;
+  const auto cast_source = calls[4]->args_.empty()
+                               ? nullptr
+                               : ir::As<ir::Var>(calls[4]->args_[0]);
+  if (!x_source || x_source.get() != function->params_[0].get() ||
+      !weight_source || weight_source.get() != function->params_[1].get() ||
+      !transpose_source ||
+      transpose_source.get() != assignments[1]->var_.get() || !matmul_lhs ||
+      matmul_lhs.get() != assignments[0]->var_.get() || !matmul_rhs ||
+      matmul_rhs.get() != assignments[2]->var_.get() || !cast_source ||
+      cast_source.get() != assignments[3]->var_.get()) {
+    Reject("native matmul tile SSA dataflow is invalid", &scope->span_);
+  }
+
+  const StaticTensor x_tile = ReadStaticTile(
+      assignments[0]->var_->GetType(), assignments[0]->span_,
+      "native matmul activation tile");
+  const StaticTensor weight_tile = ReadStaticTile(
+      assignments[1]->var_->GetType(), assignments[1]->span_,
+      "native matmul weight tile");
+  const StaticTensor weight_transposed = ReadStaticTile(
+      assignments[2]->var_->GetType(), assignments[2]->span_,
+      "native matmul transposed weight tile");
+  const StaticTensor accumulation = ReadStaticTile(
+      assignments[3]->var_->GetType(), assignments[3]->span_,
+      "native matmul accumulation tile");
+  const StaticTensor output_tile = ReadStaticTile(
+      assignments[4]->var_->GetType(), assignments[4]->span_,
+      "native matmul output tile");
+  if (x_tile.dtype != DataType::BF16 ||
+      x_tile.shape != std::vector<int64_t>({1, lhs.shape[1]}) ||
+      weight_tile.dtype != DataType::BF16 ||
+      weight_tile.shape != std::vector<int64_t>({128, lhs.shape[1]}) ||
+      weight_transposed.dtype != DataType::BF16 ||
+      weight_transposed.shape != std::vector<int64_t>({lhs.shape[1], 128}) ||
+      accumulation.dtype != DataType::FP32 ||
+      accumulation.shape != std::vector<int64_t>({1, 128}) ||
+      output_tile.dtype != DataType::BF16 ||
+      output_tile.shape != std::vector<int64_t>({1, 128})) {
+    Reject("native matmul tile shapes or dtypes are invalid", &scope->span_);
+  }
+
+  const auto store = ir::As<ir::EvalStmt>(loop_nest.leaf->stmts_.back());
+  const auto store_call = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  const auto stored_tile =
+      store_call && store_call->args_.size() == 3
+          ? ir::As<ir::Var>(store_call->args_[0])
+          : nullptr;
+  const auto store_target =
+      store_call && store_call->args_.size() == 3
+          ? ir::As<ir::Var>(store_call->args_[2])
+          : nullptr;
+  if (!store_call || !ir::IsOp(store_call, "tile.store") || !stored_tile ||
+      stored_tile.get() != assignments[4]->var_.get() || !store_target ||
+      store_target.get() != function->params_[2].get()) {
+    Reject("native matmul must end in tile.store to the output",
+           &loop_nest.leaf->stmts_.back()->span_);
+  }
+  return StructuredMatmulGraph{lhs, rhs, result, /*a_trans=*/false,
+                               /*b_trans=*/true, lhs.shape[1]};
+}
+
