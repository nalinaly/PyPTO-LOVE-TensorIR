+    metadata.reserve(3);
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 0, graph.lhs.dtype, graph.lhs.shape,
+        graph.lhs.dense_strides, /*has_explicit_strides=*/true));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 1, graph.rhs.dtype, graph.rhs.shape,
+        graph.rhs.dense_strides, /*has_explicit_strides=*/true));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype, graph.result.shape,
+        graph.result.dense_strides, /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::StructuredMatmulV4,
+                          EmitStructuredMatmulSource(graph), std::move(metadata),
+                          /*input_count=*/2,
+                          /*contraction_extent=*/static_cast<uint64_t>(graph.k));
+  }
   if (IsNativeTileGdnUpdateCandidate(program)) {
     const NativeTileGdnUpdateGraph graph = AnalyzeNativeTileGdnUpdate(program);
     std::vector<TensorIrValueMetadata> metadata;
