+int TestRankOneBf16ImplicitStrideGoldenAndFinalization() {
+  const CompileRequest request = ValidRequest();
+  const PreparedStructuredTensorIrCompilation prepared =
+      PrepareStructuredTensorIrCompilation(MakeProgram({128}, DataType::BF16), request,
+                                           ValidSchedule({16}));
+
+  REQUIRE(prepared.GetSourceIrDigest() ==
+          "c22f2459ad794e89f88de1bbd427f17876c6059b9fd222be706dd5ce300a0a7f");
+  REQUIRE(prepared.GetValueMetadata().size() == 3);
+  for (const auto& metadata : prepared.GetValueMetadata()) {
+    REQUIRE(metadata.GetDtypeCode() == DataType::BF16.Code());
+    REQUIRE(metadata.GetDtypeName() == "bfloat16");
+    REQUIRE(metadata.GetShape() == std::vector<int64_t>({128}));
+    REQUIRE(metadata.GetLogicalDenseStrides() == std::vector<int64_t>({1}));
+    REQUIRE(!metadata.HasExplicitStrides());
+  }
+
+  REQUIRE(prepared.GetStaticSpecialization().GetCanonicalBytes() ==
+          BytesFromHex(kRankOneStaticGoldenHex));
+  REQUIRE(prepared.GetStaticSpecialization().GetIdentityDigest() ==
+          "146fbdd823eb18c77190894a272a39d1298b557acf8d3156226d44d5ce7a6051");
+  REQUIRE(prepared.GetSymbolicSpecialization().GetCanonicalBytes() ==
+          BytesFromHex(kSymbolicGoldenHex));
+  REQUIRE(prepared.GetSymbolicSpecialization().GetIdentityDigest() ==
+          "1a2d6d32c956e86f41c0dc50dbafe53d33e3f63bd58bd683e78a06595b6ff58c");
+  REQUIRE(prepared.GetArgumentAbi().GetCanonicalBytes() ==
+          BytesFromHex(kRankOneArgumentGoldenHex));
+  REQUIRE(prepared.GetArgumentAbi().GetIdentityDigest() ==
+          "5408cc8d6adb1f52d11d850c745a33dbe6a43c470fa907a238b71371f4bf04c1");
+  REQUIRE(prepared.GetResultAbi().GetCanonicalBytes() ==
+          BytesFromHex(kRankOneResultGoldenHex));
+  REQUIRE(prepared.GetResultAbi().GetIdentityDigest() ==
+          "e8111628d00263e8f568dc8844a2e0fe5d08576bf77d81682b338dbeb977460a");
+  REQUIRE(prepared.GetMutationAbi().GetCanonicalBytes() == BytesFromHex(kMutationGoldenHex));
+  REQUIRE(prepared.GetMutationAbi().GetIdentityDigest() ==
+          "4adb7fa8fdbdee33582778c543686a6c63953852be40079649e4d2d6f07c766d");
+
+  const ArtifactKernelAbi kernel = MakeKernelAbi(ValidKernelOptions({128}, {16}, 8));
+  for (const auto& descriptor : kernel.GetArgumentLayout().GetOperandDescriptors()) {
+    REQUIRE(descriptor.GetShape() ==
+            std::vector<std::optional<int64_t>>({std::optional<int64_t>{128}}));
+    REQUIRE(descriptor.GetStrides().empty());
+    REQUIRE(!descriptor.HasExplicitStrides());
+  }
+  const KernelBuildSpec build_spec = FinalizeStructuredTensorIrBuildSpec(prepared, kernel);
+  REQUIRE(kernel.GetIdentityDigest() ==
+          "e3d31183b4ba5b2f09f01ef777043b9f51818e33d6bdbf18333257211d57c0e8");
+  REQUIRE(build_spec.GetIdentityDigest() ==
+          "062171a9db8cba61f522d99b464d5405732eecef2c72b0ef25b18c2f8d555a53");
+  REQUIRE(build_spec.GetSourceIrDigest() == prepared.GetSourceIrDigest());
+  REQUIRE(build_spec.GetCallableAbiDigest() == kernel.GetIdentityDigest());
+  REQUIRE(build_spec.GetStaticSpecializationDigest() ==
+          prepared.GetStaticSpecialization().GetIdentityDigest());
+  REQUIRE(build_spec.GetArgumentAbiDigest() == prepared.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(build_spec.GetResultAbiDigest() == prepared.GetResultAbi().GetIdentityDigest());
+
+  KernelOptions explicit_stride_drift = ValidKernelOptions({128}, {16}, 8);
+  explicit_stride_drift.descriptors = DescriptorVector(
+      TensorDescriptor({128}, {1}, 0, 0, true), TensorDescriptor({128}, {}, 0, 0, false),
+      TensorDescriptor({128}, {}, 0, 0, false));
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(explicit_stride_drift)),
+                              "static stride"));
