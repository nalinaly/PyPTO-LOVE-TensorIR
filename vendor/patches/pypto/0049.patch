+int TestFinalizationAndCallableBinding() {
+  const CompileRequest request = ValidRequest();
+  const auto prepared =
+      PrepareStructuredTensorIrCompilation(MakeProgram(), request, ValidSchedule());
+  KernelOptions kernel_options = ValidKernelOptions();
+  const ArtifactKernelAbi kernel = MakeKernelAbi(std::move(kernel_options));
+  const KernelBuildSpec build_spec = FinalizeStructuredTensorIrBuildSpec(prepared, kernel);
+  REQUIRE(kernel.GetIdentityDigest() ==
+          "4eee741cbe0c7322f938b83b01b34844c5f12fb1b01da52c2029e6687e24c640");
+  REQUIRE(build_spec.GetIdentityDigest() ==
+          "2151a869507e57a997732d928194509422c1e037ee7ef2fc91d87dd46a8a0afa");
+  REQUIRE(build_spec.GetSourceIrDigest() == prepared.GetSourceIrDigest());
+  REQUIRE(build_spec.GetCallableAbiDigest() == kernel.GetIdentityDigest());
+  REQUIRE(build_spec.GetSemanticRoute() == SemanticRoute::StructuredTensorIr);
+  REQUIRE(build_spec.GetPipelineRevision() == Artifact::kStructuredTensorIrPipelineRevision);
+  REQUIRE(build_spec.GetStaticSpecializationDigest() ==
+          prepared.GetStaticSpecialization().GetIdentityDigest());
+  REQUIRE(build_spec.GetSymbolicSpecializationDigest() ==
+          prepared.GetSymbolicSpecialization().GetIdentityDigest());
+  REQUIRE(build_spec.GetArgumentAbiDigest() == prepared.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(build_spec.GetResultAbiDigest() == prepared.GetResultAbi().GetIdentityDigest());
+  REQUIRE(build_spec.GetMutationAbiDigest() == prepared.GetMutationAbi().GetIdentityDigest());
+  REQUIRE(build_spec.GetCompileRequestByteIdentityDigest() == request.GetByteCompileIdentityDigest());
+  REQUIRE(!build_spec.GetCatalogProvenance().has_value());
+  const std::vector<uint8_t> canonical = build_spec.SerializeCanonical();
+  const KernelBuildSpec restored = KernelBuildSpec::DeserializeCanonical(canonical);
+  REQUIRE(restored.SerializeCanonical() == canonical);
+  REQUIRE(restored.GetResolvedSchedule().SerializeCanonical() ==
+          prepared.GetSchedule().SerializeCanonical());
+
+  const auto changed_request = PrepareStructuredTensorIrCompilation(
+      MakeProgram(), ValidRequest(96), ValidSchedule());
+  const KernelBuildSpec request_spec = FinalizeStructuredTensorIrBuildSpec(
+      changed_request, MakeKernelAbi(ValidKernelOptions()));
+  REQUIRE(request_spec.GetCompileRequestByteIdentityDigest() !=
+          build_spec.GetCompileRequestByteIdentityDigest());
+  REQUIRE(request_spec.GetIdentityDigest() != build_spec.GetIdentityDigest());
+
+  const auto changed_schedule = PrepareStructuredTensorIrCompilation(
+      MakeProgram(), request, ValidSchedule({8}));
+  const KernelBuildSpec schedule_spec = FinalizeStructuredTensorIrBuildSpec(
+      changed_schedule, MakeKernelAbi(ValidKernelOptions({8, 8}, {8}, 8)));
+  REQUIRE(schedule_spec.GetCallableAbiDigest() != build_spec.GetCallableAbiDigest());
+  REQUIRE(schedule_spec.GetIdentityDigest() != build_spec.GetIdentityDigest());
+  return 0;
+}
