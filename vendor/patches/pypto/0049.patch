+int TestFinalizationRejectsAbiDrift() {
+  const auto prepared = PrepareStructuredTensorIrCompilation(
+      MakeProgram(), ValidRequest(), ValidSchedule());
+
+  KernelOptions options = ValidKernelOptions();
+  options.runtime_kernel_name = "other_runtime";
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "runtime kernel name"));
+
+  options = ValidKernelOptions();
+  options.entry_function_name = "other_entry";
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "entry function name"));
+
+  options = ValidKernelOptions();
+  options.descriptors.pop_back();
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "descriptor count"));
+
+  options = ValidKernelOptions();
+  options.descriptors.push_back(TensorDescriptor({8, 8}, {8, 1}));
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "descriptor count"));
+
+  for (size_t changed_index = 0; changed_index < 3; ++changed_index) {
+    options = ValidKernelOptions();
+    std::vector<ArtifactArgumentDescriptor> descriptors;
+    for (size_t index = 0; index < 3; ++index) {
+      descriptors.push_back(index == changed_index ? ScalarDescriptor()
+                                                   : TensorDescriptor({8, 8}, {8, 1}));
+    }
+    options.descriptors = std::move(descriptors);
+    REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "not a tensor"));
+  }
+
+  for (size_t changed_index = 0; changed_index < 3; ++changed_index) {
+    options = ValidKernelOptions();
+    std::vector<ArtifactArgumentDescriptor> descriptors;
+    for (size_t index = 0; index < 3; ++index) {
+      descriptors.push_back(index == changed_index ? TensorDescriptor({4, 8}, {8, 1})
+                                                   : TensorDescriptor({8, 8}, {8, 1}));
+    }
+    options.descriptors = std::move(descriptors);
+    REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "static shape"));
+  }
+
+  for (size_t changed_index = 0; changed_index < 3; ++changed_index) {
+    options = ValidKernelOptions();
+    std::vector<ArtifactArgumentDescriptor> descriptors;
+    for (size_t index = 0; index < 3; ++index) {
+      descriptors.push_back(index == changed_index ? TensorDescriptor({8, 8}, {1, 8})
+                                                   : TensorDescriptor({8, 8}, {8, 1}));
+    }
+    options.descriptors = std::move(descriptors);
+    REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "static stride"));
+  }
+
+  options = ValidKernelOptions();
+  options.descriptors = DescriptorVector(TensorDescriptor({8, 8}, {}, 0, 0, false),
+                                         TensorDescriptor({8, 8}, {8, 1}),
+                                         TensorDescriptor({8, 8}, {8, 1}));
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "static stride"));
+
+  options = ValidKernelOptions();
+  options.descriptors = DescriptorVector(DynamicTensorDescriptor(),
+                                         TensorDescriptor({8, 8}, {8, 1}),
+                                         TensorDescriptor({8, 8}, {8, 1}));
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "static shape"));
+
+  options = ValidKernelOptions();
+  options.input_count = 1;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "two inputs"));
+
+  options = ValidKernelOptions();
+  options.descriptors = DescriptorVector(TensorDescriptor({8, 8}, {8, 1}, 2, 2),
+                                         TensorDescriptor({8, 8}, {8, 1}, 2, 2),
+                                         TensorDescriptor({8, 8}, {8, 1}, 2, 2));
+  options.uniform_signature = true;
+  options.packing_policy = ArtifactArgumentPackingPolicy::Flat;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "no uniform ABI"));
+
+  options = ValidKernelOptions();
+  options.packing_policy = ArtifactArgumentPackingPolicy::Flat;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "pointer-only"));
+
+  options = ValidKernelOptions();
+  options.grid_policy = ArtifactGridPolicy::TileBasedRuntime;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "grid ABI"));
+
+  options = ValidKernelOptions();
+  options.grid_shape_operand_index = 1;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "selected by Input0"));
+
+  options = ValidKernelOptions();
+  options.tile_sizes = {8};
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "tile sizes"));
+
+  options = ValidKernelOptions();
+  options.static_grid = {2147483648U, 1, 1};
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "request limits"));
+
+  options = ValidKernelOptions();
+  options.static_grid = {4, 2, 1};
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "y=z=1"));
+
+  options = ValidKernelOptions();
+  options.static_grid = {4, 1, 2};
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "y=z=1"));
+
+  options = ValidKernelOptions();
+  options.workspace_size = 8;
+  options.workspace_alignment = 8;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "zero-workspace"));
+
+  options = ValidKernelOptions();
+  options.workspace_alignment = 8;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "zero-workspace"));
+
+  options = ValidKernelOptions();
+  options.block_dimensions = {2, 1, 1};
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "launch ABI"));
+
+  options = ValidKernelOptions();
+  options.dynamic_shared_memory = 1;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "launch ABI"));
+
+  options = ValidKernelOptions();
+  options.kernel_argument_slot_bytes = 4;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "launch ABI"));
+
+  options = ValidKernelOptions();
+  options.minimum_driver = Artifact::kMinimumCudaDriverApiVersion + 1;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "loader ABI"));
+
+  options = ValidKernelOptions();
+  options.minimum_runtime = Artifact::kMinimumCudaRuntimeApiVersion + 1;
+  REQUIRE(RejectsFinalization(prepared, MakeKernelAbi(std::move(options)), "loader ABI"));
+  return 0;
+}
