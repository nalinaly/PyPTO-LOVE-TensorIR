+int TestStrictScheduleOverloadParity() {
+  const CompileRequest request = ValidRequest();
+  const CanonicalSchedule schedule = ValidSchedule();
+  const auto direct = ResolveStrictTensorIrProducerOptions(request, schedule);
+  const KernelBuildSpec build_spec(
+      std::string(64, '1'), std::string(64, '2'), SemanticRoute::StructuredTensorIr,
+      std::string(Artifact::kStructuredTensorIrPipelineRevision), schedule, std::string(64, '3'),
+      std::string(64, '4'), std::string(64, '5'), std::string(64, '6'), std::string(64, '7'),
+      request.GetByteCompileIdentityDigest());
+  const auto legacy = ResolveStrictTensorIrProducerOptions(request, build_spec);
+  REQUIRE(direct.tile_sizes == legacy.tile_sizes);
+  REQUIRE(direct.sm_count == legacy.sm_count);
+  REQUIRE(direct.uniform_signature == legacy.uniform_signature);
+
+  const CanonicalSchedule invalid({}, {}, {}, {}, {}, {}, {}, {});
+  REQUIRE(RejectsPreparation(
+      [&] { (void)ResolveStrictTensorIrProducerOptions(request, invalid); },
+      "CanonicalSchedule resolved schedule"));
+  return 0;
+}
