+int TestDeterminismAndIdentityChanges() {
+  const CompileRequest request = ValidRequest();
+  const CanonicalSchedule schedule = ValidSchedule();
+  const auto first = PrepareStructuredTensorIrCompilation(
+      MakeProgram({8, 8}, DataType::FP32, "first", "alpha", "beta"), request, schedule);
+  const auto cosmetic = PrepareStructuredTensorIrCompilation(
+      MakeProgram({8, 8}, DataType::FP32, "second", "x", "y"), request, schedule);
+  REQUIRE(first.GetCanonicalSource() == cosmetic.GetCanonicalSource());
+  REQUIRE(first.GetStaticSpecialization().GetIdentityDigest() ==
+          cosmetic.GetStaticSpecialization().GetIdentityDigest());
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() == cosmetic.GetArgumentAbi().GetIdentityDigest());
+
+  const auto reversed = PrepareStructuredTensorIrCompilation(
+      MakeProgram({8, 8}, DataType::FP32, "first", "alpha", "beta", true), request, schedule);
+  REQUIRE(first.GetSourceIrDigest() != reversed.GetSourceIrDigest());
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() == reversed.GetArgumentAbi().GetIdentityDigest());
+
+  const auto changed_shape = PrepareStructuredTensorIrCompilation(
+      MakeProgram({4, 8}), request, ValidSchedule());
+  REQUIRE(first.GetStaticSpecialization().GetIdentityDigest() !=
+          changed_shape.GetStaticSpecialization().GetIdentityDigest());
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() != changed_shape.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(first.GetResultAbi().GetIdentityDigest() != changed_shape.GetResultAbi().GetIdentityDigest());
+  REQUIRE(first.GetSymbolicSpecialization().GetIdentityDigest() ==
+          changed_shape.GetSymbolicSpecialization().GetIdentityDigest());
+  REQUIRE(first.GetMutationAbi().GetIdentityDigest() == changed_shape.GetMutationAbi().GetIdentityDigest());
+
+  const auto changed_dtype = PrepareStructuredTensorIrCompilation(
+      MakeProgram({8, 8}, DataType::BF16), request, schedule);
+  REQUIRE(first.GetSourceIrDigest() != changed_dtype.GetSourceIrDigest());
+  REQUIRE(first.GetStaticSpecialization().GetIdentityDigest() ==
+          changed_dtype.GetStaticSpecialization().GetIdentityDigest());
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() != changed_dtype.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(first.GetResultAbi().GetIdentityDigest() != changed_dtype.GetResultAbi().GetIdentityDigest());
+
+  const auto changed_request = PrepareStructuredTensorIrCompilation(
+      MakeProgram(), ValidRequest(96), schedule);
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() == changed_request.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(first.GetResolvedOptions().sm_count != changed_request.GetResolvedOptions().sm_count);
+
+  const auto changed_schedule = PrepareStructuredTensorIrCompilation(
+      MakeProgram(), request, ValidSchedule({8}));
+  REQUIRE(first.GetArgumentAbi().GetIdentityDigest() ==
+          changed_schedule.GetArgumentAbi().GetIdentityDigest());
+  REQUIRE(first.GetSchedule().GetIdentityDigest() != changed_schedule.GetSchedule().GetIdentityDigest());
+  return 0;
+}
