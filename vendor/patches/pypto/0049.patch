+/** One canonical, domain-separated identity projection and its SHA-256. */
+class StructuredTensorIrIdentityProjection {
+ public:
+  StructuredTensorIrIdentityProjection() = delete;
+  StructuredTensorIrIdentityProjection(const StructuredTensorIrIdentityProjection&) = default;
+  StructuredTensorIrIdentityProjection(StructuredTensorIrIdentityProjection&&) = default;
+  StructuredTensorIrIdentityProjection& operator=(const StructuredTensorIrIdentityProjection&) = delete;
+  StructuredTensorIrIdentityProjection& operator=(StructuredTensorIrIdentityProjection&&) = delete;
+
+  [[nodiscard]] const std::vector<uint8_t>& GetCanonicalBytes() const noexcept {
+    return canonical_bytes_;
+  }
+  [[nodiscard]] const std::string& GetIdentityDigest() const noexcept { return identity_digest_; }
+
+ private:
+  explicit StructuredTensorIrIdentityProjection(std::vector<uint8_t> canonical_bytes);
+  friend PreparedStructuredTensorIrCompilation PrepareStructuredTensorIrCompilation(
+      const ir::ProgramPtr& program, const CompileRequest& request,
+      const CanonicalSchedule& schedule);
+
+  std::vector<uint8_t> canonical_bytes_;
+  std::string identity_digest_;
+};
