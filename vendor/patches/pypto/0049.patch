+
+constexpr size_t kMaximumProjectionBytes = 1024 * 1024;
+constexpr std::string_view kStaticSpecializationContract =
+    "pypto.frontend.static_specialization.v1";
+constexpr std::string_view kSymbolicSpecializationContract =
+    "pypto.frontend.symbolic_specialization.v1";
+constexpr std::string_view kArgumentAbiContract = "pypto.frontend.argument_abi.v1";
+constexpr std::string_view kResultAbiContract = "pypto.frontend.result_abi.v1";
+constexpr std::string_view kMutationAbiContract = "pypto.frontend.mutation_abi.v1";
+constexpr std::string_view kRuntimeKernelName = "tensor_ir_rtk";
+
+[[noreturn]] void RejectFinalization(std::string message) {
+  throw InternalError("structured TensorIR finalization contract violation: " + std::move(message));
+}
+
+std::string_view RoleName(PreparedStructuredTensorIrValueRole role) {
+  if (role == PreparedStructuredTensorIrValueRole::Argument) return "argument";
+  if (role == PreparedStructuredTensorIrValueRole::Result) return "result";
+  throw InternalError("prepared structured TensorIR value role is invalid");
+}
+
+void PackInt64Array(CanonicalPacker& packer, const std::vector<int64_t>& values) {
+  packer.pack_array(static_cast<uint32_t>(values.size()));
+  for (int64_t value : values) packer.pack(value);
+}
+
+void PackStaticValue(CanonicalPacker& packer,
+                     const PreparedStructuredTensorIrValueMetadata& metadata) {
+  packer.pack_map(3);
+  PackKey(packer, "ordinal");
+  packer.pack(metadata.GetOrdinal());
+  PackKey(packer, "role");
+  PackText(packer, RoleName(metadata.GetRole()));
+  PackKey(packer, "shape");
+  PackInt64Array(packer, metadata.GetShape());
+}
+
+void PackAbiDescriptor(CanonicalPacker& packer,
+                       const PreparedStructuredTensorIrValueMetadata& metadata,
+                       bool include_direction) {
+  packer.pack_map(include_direction ? 9 : 8);
+  PackKey(packer, "contiguous");
+  packer.pack(true);
+  if (include_direction) {
+    PackKey(packer, "direction");
+    PackText(packer, "in");
+  }
+  PackKey(packer, "dtype_code");
+  packer.pack(metadata.GetDtypeCode());
+  PackKey(packer, "dtype_name");
+  PackText(packer, metadata.GetDtypeName());
+  PackKey(packer, "explicit_strides");
+  packer.pack(metadata.HasExplicitStrides());
+  PackKey(packer, "ordinal");
+  packer.pack(metadata.GetOrdinal());
+  PackKey(packer, "rank");
+  packer.pack(static_cast<uint32_t>(metadata.GetShape().size()));
+  PackKey(packer, "shape");
+  PackInt64Array(packer, metadata.GetShape());
+  PackKey(packer, "strides");
+  PackInt64Array(packer, metadata.GetLogicalDenseStrides());
+}
+
+std::vector<uint8_t> FinishProjection(const msgpack::sbuffer& buffer,
+                                      std::string_view projection_name) {
+  std::vector<uint8_t> bytes = FinishBuffer(buffer);
+  if (bytes.empty() || bytes.size() > kMaximumProjectionBytes) {
+    throw InternalError(std::string(projection_name) +
+                        " projection is empty or exceeds the 1 MiB v1 limit");
+  }
+  return bytes;
+}
+
+std::vector<uint8_t> SerializeStaticSpecialization(
+    const std::vector<PreparedStructuredTensorIrValueMetadata>& metadata) {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(3);
+  PackKey(packer, "contract");
+  PackText(packer, kStaticSpecializationContract);
+  PackKey(packer, "static_specialization_schema_version");
+  packer.pack(1);
+  PackKey(packer, "values");
+  packer.pack_array(static_cast<uint32_t>(metadata.size()));
+  for (const auto& value : metadata) PackStaticValue(packer, value);
+  return FinishProjection(buffer, "static specialization");
+}
+
+std::vector<uint8_t> SerializeSymbolicSpecialization() {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(4);
+  PackKey(packer, "constraints");
+  packer.pack_array(0);
+  PackKey(packer, "contract");
+  PackText(packer, kSymbolicSpecializationContract);
+  PackKey(packer, "symbolic_specialization_schema_version");
+  packer.pack(1);
+  PackKey(packer, "symbols");
+  packer.pack_array(0);
+  return FinishProjection(buffer, "symbolic specialization");
+}
+
+std::vector<uint8_t> SerializeArgumentAbi(
+    const std::vector<PreparedStructuredTensorIrValueMetadata>& metadata) {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(3);
+  PackKey(packer, "argument_abi_schema_version");
+  packer.pack(1);
+  PackKey(packer, "arguments");
+  packer.pack_array(2);
+  PackAbiDescriptor(packer, metadata[0], /*include_direction=*/true);
+  PackAbiDescriptor(packer, metadata[1], /*include_direction=*/true);
+  PackKey(packer, "contract");
+  PackText(packer, kArgumentAbiContract);
+  return FinishProjection(buffer, "argument ABI");
+}
+
+std::vector<uint8_t> SerializeResultAbi(
+    const std::vector<PreparedStructuredTensorIrValueMetadata>& metadata) {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(3);
+  PackKey(packer, "contract");
+  PackText(packer, kResultAbiContract);
+  PackKey(packer, "result_abi_schema_version");
+  packer.pack(1);
+  PackKey(packer, "results");
+  packer.pack_array(1);
+  PackAbiDescriptor(packer, metadata[2], /*include_direction=*/false);
+  return FinishProjection(buffer, "result ABI");
+}
+
+std::vector<uint8_t> SerializeMutationAbi() {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(4);
+  PackKey(packer, "argument_effects");
+  packer.pack_array(2);
+  for (uint32_t ordinal = 0; ordinal < 2; ++ordinal) {
+    packer.pack_map(2);
+    PackKey(packer, "effect");
+    PackText(packer, "read-only");
+    PackKey(packer, "ordinal");
+    packer.pack(ordinal);
+  }
+  PackKey(packer, "contract");
+  PackText(packer, kMutationAbiContract);
+  PackKey(packer, "mutation_abi_schema_version");
+  packer.pack(1);
+  PackKey(packer, "result_aliases");
+  packer.pack_array(1);
+  packer.pack_nil();
+  return FinishProjection(buffer, "mutation ABI");
+}
+
+std::vector<std::optional<int64_t>> StaticValues(const std::vector<int64_t>& values) {
+  std::vector<std::optional<int64_t>> output;
+  output.reserve(values.size());
+  for (int64_t value : values) output.emplace_back(value);
+  return output;
+}
+
+void ValidateDescriptor(const ArtifactArgumentDescriptor& descriptor,
+                        const PreparedStructuredTensorIrValueMetadata& metadata,
+                        size_t descriptor_index) {
+  if (descriptor.GetKind() != ArtifactOperandKind::Tensor) {
+    RejectFinalization("descriptor " + std::to_string(descriptor_index) +
+                       " is not a tensor");
+  }
+  if (descriptor.GetRank() != metadata.GetShape().size() ||
+      descriptor.GetShape() != StaticValues(metadata.GetShape())) {
+    RejectFinalization("descriptor " + std::to_string(descriptor_index) +
+                       " static shape differs from prepared metadata");
+  }
+  const std::vector<std::optional<int64_t>> expected_strides =
+      metadata.HasExplicitStrides() ? StaticValues(metadata.GetLogicalDenseStrides())
+                                    : std::vector<std::optional<int64_t>>{};
+  if (descriptor.GetStrides() != expected_strides ||
+      descriptor.HasExplicitStrides() != metadata.HasExplicitStrides()) {
+    RejectFinalization("descriptor " + std::to_string(descriptor_index) +
+                       " static stride layout differs from prepared metadata");
+  }
+  if (descriptor.GetDynamicSizeCount() != 0 || descriptor.GetDynamicStrideCount() != 0 ||
+      descriptor.GetScalarSizeBytes() != 0) {
+    RejectFinalization("descriptor " + std::to_string(descriptor_index) +
+                       " contains dynamic or scalar ABI metadata");
+  }
+}
+
+void ValidateKernelAbi(const PreparedStructuredTensorIrCompilation& prepared,
+                       const ArtifactKernelAbi& kernel_abi) {
+  if (kernel_abi.GetRuntimeKernelName() != kRuntimeKernelName) {
+    RejectFinalization("runtime kernel name differs from the fixed TensorIR v1 name");
+  }
+  if (kernel_abi.GetEntryFunctionName() != prepared.GetEntryName()) {
+    RejectFinalization("entry function name differs from prepared TensorIR metadata");
+  }
+
+  const ArtifactArgumentLayout& layout = kernel_abi.GetArgumentLayout();
+  const auto& descriptors = layout.GetOperandDescriptors();
+  const auto& metadata = prepared.GetValueMetadata();
+  if (metadata.size() != 3 || descriptors.size() != metadata.size()) {
+    RejectFinalization("descriptor count must be ordered Input0, Input1, Result0");
+  }
+  if (layout.GetInputOperandCount() != 2 || layout.HasUniformSignature()) {
+    RejectFinalization("argument layout must contain two inputs and no uniform ABI");
+  }
+  for (size_t index = 0; index < metadata.size(); ++index) {
+    ValidateDescriptor(descriptors[index], metadata[index], index);
+  }
+  if (layout.GetTotalKernelArgumentCount() != 3) {
+    RejectFinalization("argument layout must contain exactly three pointer arguments");
+  }
+  if (kernel_abi.GetArgumentPackingPolicy() != ArtifactArgumentPackingPolicy::PointerOnly) {
+    RejectFinalization("argument packing policy must be pointer-only");
+  }
+
+  const ArtifactGridAbi& grid = kernel_abi.GetGridAbi();
+  if (grid.GetPolicy() != ArtifactGridPolicy::Static || grid.GetShapeOperandIndex() != 0) {
+    RejectFinalization("grid ABI must be static and selected by Input0");
+  }
+  if (grid.GetTileSizes() != prepared.GetResolvedOptions().tile_sizes) {
+    RejectFinalization("grid tile sizes differ from the prepared strict schedule");
+  }
+  const auto& dimensions = grid.GetStaticDimensions();
+  const auto& traits = prepared.GetCompileRequest().GetTargetInfo().GetTraits();
+  const std::array<uint32_t, 3> limits = {
+      static_cast<uint32_t>(traits.GetMaxGridDimX()),
+      static_cast<uint32_t>(traits.GetMaxGridDimY()),
+      static_cast<uint32_t>(traits.GetMaxGridDimZ())};
+  for (size_t index = 0; index < dimensions.size(); ++index) {
+    if (dimensions[index] == 0 || dimensions[index] > limits[index]) {
+      RejectFinalization("static grid dimensions exceed the prepared request limits");
+    }
+  }
+  if (dimensions[1] != 1 || dimensions[2] != 1) {
+    RejectFinalization("static grid must use the producer-shaped one-dimensional y=z=1 layout");
+  }
+
+  const ArtifactWorkspaceAbi& workspace = kernel_abi.GetWorkspaceAbi();
+  if (workspace.GetKind() != ArtifactWorkspaceKind::Static || workspace.GetSizeBytes() != 0 ||
+      workspace.GetAlignmentBytes() != 1) {
+    RejectFinalization("workspace ABI must be the reviewed zero-workspace contract");
+  }
+
+  const ArtifactLaunchAbi& launch = kernel_abi.GetLaunchAbi();
+  if (launch.GetBlockDimensions() != std::array<uint32_t, 3>{1, 1, 1} ||
+      launch.GetClusterSchedulingPolicy() != ArtifactClusterSchedulingPolicy::Spread ||
+      launch.GetDynamicSharedMemoryBytes() != 0 || launch.GetKernelArgumentSlotBytes() != 8) {
+    RejectFinalization("launch ABI differs from the reviewed CUDA Tile v1 contract");
+  }
+
+  const ArtifactLoaderAbi& loader = kernel_abi.GetLoaderAbi();
+  if (loader.GetMinimumCudaDriverApiVersion() != Artifact::kMinimumCudaDriverApiVersion ||
+      loader.GetMinimumCudaRuntimeApiVersion() != Artifact::kMinimumCudaRuntimeApiVersion) {
+    RejectFinalization("loader ABI differs from the reviewed CUDA 13.0 minimum");
+  }
+}
+
+}  // namespace
+
+PreparedStructuredTensorIrValueMetadata::PreparedStructuredTensorIrValueMetadata(
+    PreparedStructuredTensorIrValueRole role, uint32_t ordinal, uint8_t dtype_code,
+    std::string dtype_name, std::vector<int64_t> shape,
+    std::vector<int64_t> logical_dense_strides, bool has_explicit_strides)
+    : role_(role),
+      ordinal_(ordinal),
+      dtype_code_(dtype_code),
+      dtype_name_(std::move(dtype_name)),
+      shape_(std::move(shape)),
+      logical_dense_strides_(std::move(logical_dense_strides)),
+      has_explicit_strides_(has_explicit_strides) {}
+
+StructuredTensorIrIdentityProjection::StructuredTensorIrIdentityProjection(
+    std::vector<uint8_t> canonical_bytes)
+    : canonical_bytes_(std::move(canonical_bytes)),
+      identity_digest_(Sha256Hex(canonical_bytes_.data(), canonical_bytes_.size())) {}
+
+PreparedStructuredTensorIrCompilation::PreparedStructuredTensorIrCompilation(
+    CompileRequest request, CanonicalSchedule schedule,
+    StrictTensorIrProducerOptions resolved_options, std::vector<uint8_t> canonical_source,
+    std::string source_ir_digest, std::string entry_name,
+    std::vector<PreparedStructuredTensorIrValueMetadata> value_metadata,
+    StructuredTensorIrIdentityProjection static_specialization,
+    StructuredTensorIrIdentityProjection symbolic_specialization,
+    StructuredTensorIrIdentityProjection argument_abi,
+    StructuredTensorIrIdentityProjection result_abi,
+    StructuredTensorIrIdentityProjection mutation_abi)
+    : request_(std::move(request)),
+      schedule_(std::move(schedule)),
+      resolved_options_(std::move(resolved_options)),
+      canonical_source_(std::move(canonical_source)),
+      source_ir_digest_(std::move(source_ir_digest)),
+      entry_name_(std::move(entry_name)),
+      value_metadata_(std::move(value_metadata)),
+      static_specialization_(std::move(static_specialization)),
+      symbolic_specialization_(std::move(symbolic_specialization)),
+      argument_abi_(std::move(argument_abi)),
+      result_abi_(std::move(result_abi)),
+      mutation_abi_(std::move(mutation_abi)) {}
+
+PreparedStructuredTensorIrCompilation PrepareStructuredTensorIrCompilation(
+    const ir::ProgramPtr& program, const CompileRequest& request,
+    const CanonicalSchedule& schedule) {
+  const codegen::nvidia::TensorIrModule module = codegen::nvidia::EmitTensorIr(program);
+  const StrictTensorIrProducerOptions resolved_options =
+      ResolveStrictTensorIrProducerOptions(request, schedule);
+  if (module.GetMetadataSchemaVersion() != 1 || module.GetInputCount() != 2 ||
+      module.GetResultCount() != 1 || module.GetValueMetadata().size() != 3) {
+    throw InternalError(
+        "prepared TensorIR module must use metadata schema 1 with two inputs and one result");
+  }
+
+  const std::string& source = module.GetCanonicalSource();
+  const auto* source_begin = reinterpret_cast<const uint8_t*>(source.data());
+  std::vector<uint8_t> canonical_source(source_begin, source_begin + source.size());
+
+  std::vector<PreparedStructuredTensorIrValueMetadata> metadata;
+  metadata.reserve(module.GetValueMetadata().size());
+  for (const auto& value : module.GetValueMetadata()) {
+    const PreparedStructuredTensorIrValueRole role =
+        value.GetRole() == codegen::nvidia::TensorIrValueRole::Input
+            ? PreparedStructuredTensorIrValueRole::Argument
+            : PreparedStructuredTensorIrValueRole::Result;
+    metadata.push_back(PreparedStructuredTensorIrValueMetadata(
+        role, value.GetOrdinal(), value.GetDtypeCode(), value.GetDtypeName(), value.GetShape(),
+        value.GetLogicalDenseStrides(), value.HasExplicitStrides()));
+  }
+  if (metadata.size() != 3 ||
+      metadata[0].GetRole() != PreparedStructuredTensorIrValueRole::Argument ||
+      metadata[0].GetOrdinal() != 0 ||
+      metadata[1].GetRole() != PreparedStructuredTensorIrValueRole::Argument ||
+      metadata[1].GetOrdinal() != 1 ||
+      metadata[2].GetRole() != PreparedStructuredTensorIrValueRole::Result ||
+      metadata[2].GetOrdinal() != 0) {
+    throw InternalError("prepared TensorIR metadata is not ordered Input0, Input1, Result0");
+  }
+
+  StructuredTensorIrIdentityProjection static_specialization(
+      SerializeStaticSpecialization(metadata));
+  StructuredTensorIrIdentityProjection symbolic_specialization(
+      SerializeSymbolicSpecialization());
+  StructuredTensorIrIdentityProjection argument_abi(SerializeArgumentAbi(metadata));
+  StructuredTensorIrIdentityProjection result_abi(SerializeResultAbi(metadata));
+  StructuredTensorIrIdentityProjection mutation_abi(SerializeMutationAbi());
+
+  const std::string source_ir_digest = Artifact::ComputeSourceIrDigest(canonical_source);
+  return PreparedStructuredTensorIrCompilation(
+      request, schedule, resolved_options, std::move(canonical_source), source_ir_digest,
+      module.GetEntryName(), std::move(metadata), std::move(static_specialization),
+      std::move(symbolic_specialization), std::move(argument_abi), std::move(result_abi),
+      std::move(mutation_abi));
+}
+
+KernelBuildSpec FinalizeStructuredTensorIrBuildSpec(
+    const PreparedStructuredTensorIrCompilation& prepared,
+    const ArtifactKernelAbi& real_kernel_abi) {
+  ValidateKernelAbi(prepared, real_kernel_abi);
+  return KernelBuildSpec(
+      prepared.GetSourceIrDigest(), real_kernel_abi.GetIdentityDigest(),
+      SemanticRoute::StructuredTensorIr, std::string(Artifact::kStructuredTensorIrPipelineRevision),
+      prepared.GetSchedule(), prepared.GetStaticSpecialization().GetIdentityDigest(),
+      prepared.GetSymbolicSpecialization().GetIdentityDigest(),
+      prepared.GetArgumentAbi().GetIdentityDigest(), prepared.GetResultAbi().GetIdentityDigest(),
+      prepared.GetMutationAbi().GetIdentityDigest(),
+      prepared.GetCompileRequest().GetByteCompileIdentityDigest());
+}
+
+}  // namespace pypto::compiler::detail
