+StrictTensorIrProducerOptions ResolveStrictTensorIrProducerOptions(
+    const CompileRequest& request, const KernelBuildSpec& build_spec) {
+  if (build_spec.GetPipelineRevision() != Artifact::kStructuredTensorIrPipelineRevision ||
