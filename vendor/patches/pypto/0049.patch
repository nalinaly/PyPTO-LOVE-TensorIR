+/**
+ * Immutable compile-free frontend result bound to one copied request and schedule.
+ *
+ * Construction is possible only through PrepareStructuredTensorIrCompilation,
+ * which emits canonical TensorIR from an ir::ProgramPtr. No TensorIrModule or
+ * producer state crosses this boundary.
+ */
+class PreparedStructuredTensorIrCompilation {
+ public:
+  PreparedStructuredTensorIrCompilation() = delete;
+  PreparedStructuredTensorIrCompilation(const PreparedStructuredTensorIrCompilation&) = default;
+  PreparedStructuredTensorIrCompilation(PreparedStructuredTensorIrCompilation&&) = default;
+  PreparedStructuredTensorIrCompilation& operator=(
+      const PreparedStructuredTensorIrCompilation&) = delete;
+  PreparedStructuredTensorIrCompilation& operator=(PreparedStructuredTensorIrCompilation&&) = delete;
+
+  [[nodiscard]] const CompileRequest& GetCompileRequest() const noexcept { return request_; }
+  [[nodiscard]] const CanonicalSchedule& GetSchedule() const noexcept { return schedule_; }
+  [[nodiscard]] const StrictTensorIrProducerOptions& GetResolvedOptions() const noexcept {
+    return resolved_options_;
+  }
+  [[nodiscard]] const std::vector<uint8_t>& GetCanonicalSource() const noexcept {
+    return canonical_source_;
+  }
+  [[nodiscard]] const std::string& GetSourceIrDigest() const noexcept { return source_ir_digest_; }
+  [[nodiscard]] const std::string& GetEntryName() const noexcept { return entry_name_; }
+  [[nodiscard]] const std::vector<PreparedStructuredTensorIrValueMetadata>& GetValueMetadata()
+      const noexcept {
+    return value_metadata_;
+  }
+
+  [[nodiscard]] const StructuredTensorIrIdentityProjection& GetStaticSpecialization() const noexcept {
+    return static_specialization_;
+  }
+  [[nodiscard]] const StructuredTensorIrIdentityProjection& GetSymbolicSpecialization() const noexcept {
+    return symbolic_specialization_;
+  }
+  [[nodiscard]] const StructuredTensorIrIdentityProjection& GetArgumentAbi() const noexcept {
+    return argument_abi_;
+  }
+  [[nodiscard]] const StructuredTensorIrIdentityProjection& GetResultAbi() const noexcept {
+    return result_abi_;
+  }
+  [[nodiscard]] const StructuredTensorIrIdentityProjection& GetMutationAbi() const noexcept {
+    return mutation_abi_;
+  }
+
+ private:
+  PreparedStructuredTensorIrCompilation(
+      CompileRequest request, CanonicalSchedule schedule,
+      StrictTensorIrProducerOptions resolved_options, std::vector<uint8_t> canonical_source,
+      std::string source_ir_digest, std::string entry_name,
+      std::vector<PreparedStructuredTensorIrValueMetadata> value_metadata,
+      StructuredTensorIrIdentityProjection static_specialization,
+      StructuredTensorIrIdentityProjection symbolic_specialization,
+      StructuredTensorIrIdentityProjection argument_abi,
+      StructuredTensorIrIdentityProjection result_abi,
+      StructuredTensorIrIdentityProjection mutation_abi);
+  friend PreparedStructuredTensorIrCompilation PrepareStructuredTensorIrCompilation(
+      const ir::ProgramPtr& program, const CompileRequest& request,
+      const CanonicalSchedule& schedule);
+
+  CompileRequest request_;
+  CanonicalSchedule schedule_;
+  StrictTensorIrProducerOptions resolved_options_;
+  std::vector<uint8_t> canonical_source_;
+  std::string source_ir_digest_;
+  std::string entry_name_;
+  std::vector<PreparedStructuredTensorIrValueMetadata> value_metadata_;
+  StructuredTensorIrIdentityProjection static_specialization_;
+  StructuredTensorIrIdentityProjection symbolic_specialization_;
+  StructuredTensorIrIdentityProjection argument_abi_;
+  StructuredTensorIrIdentityProjection result_abi_;
+  StructuredTensorIrIdentityProjection mutation_abi_;
+};
