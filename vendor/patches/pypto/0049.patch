+uint8_t HexNibble(char character) {
+  if (character >= '0' && character <= '9') return static_cast<uint8_t>(character - '0');
+  if (character >= 'a' && character <= 'f') return static_cast<uint8_t>(character - 'a' + 10);
+  return 0xff;
+}
+
+std::vector<uint8_t> BytesFromHex(std::string_view hex) {
+  if (hex.size() % 2 != 0) return {};
+  std::vector<uint8_t> bytes;
+  bytes.reserve(hex.size() / 2);
+  for (size_t index = 0; index < hex.size(); index += 2) {
+    const uint8_t high = HexNibble(hex[index]);
+    const uint8_t low = HexNibble(hex[index + 1]);
+    if (high == 0xff || low == 0xff) return {};
+    bytes.push_back(static_cast<uint8_t>((high << 4U) | low));
+  }
+  return bytes;
+}
