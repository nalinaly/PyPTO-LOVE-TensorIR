+};
+
+KernelOptions ValidKernelOptions(const std::vector<int64_t>& shape = {8, 8},
+                                 const std::vector<uint32_t>& tile_sizes = {16},
+                                 uint32_t grid_x = 4) {
+  std::vector<int64_t> strides(shape.size());
+  int64_t running = 1;
+  for (size_t reverse_index = shape.size(); reverse_index > 0; --reverse_index) {
+    const size_t index = reverse_index - 1;
+    strides[index] = running;
+    running *= shape[index];
+  }
+  const bool explicit_strides = shape.size() >= 2;
+  KernelOptions options;
+  options.tile_sizes = tile_sizes;
+  options.static_grid = {grid_x, 1, 1};
+  for (size_t index = 0; index < 3; ++index) {
+    options.descriptors.push_back(TensorDescriptor(shape, strides, 0, 0, explicit_strides));
+  }
+  return options;
+}
+
+uint32_t TotalArguments(const std::vector<ArtifactArgumentDescriptor>& descriptors) {
+  uint32_t total = 0;
+  for (const auto& descriptor : descriptors) {
+    total += descriptor.GetKind() == ArtifactOperandKind::Scalar
+                 ? 1
+                 : 1 + descriptor.GetDynamicSizeCount() + descriptor.GetDynamicStrideCount();
+  }
+  return total;
+}
+
+ArtifactKernelAbi MakeKernelAbi(KernelOptions options) {
+  const uint32_t total_arguments = TotalArguments(options.descriptors);
+  return ArtifactKernelAbi(
+      std::move(options.runtime_kernel_name), std::move(options.entry_function_name),
+      ArtifactArgumentLayout(std::move(options.descriptors), options.input_count, total_arguments,
+                             options.uniform_signature),
+      options.packing_policy,
+      ArtifactGridAbi(options.grid_policy, options.grid_shape_operand_index, options.static_grid,
+                      std::move(options.tile_sizes)),
+      ArtifactWorkspaceAbi(ArtifactWorkspaceKind::Static, options.workspace_size,
+                           options.workspace_alignment),
+      ArtifactLaunchAbi(options.block_dimensions, ArtifactClusterSchedulingPolicy::Spread,
+                        options.dynamic_shared_memory, options.kernel_argument_slot_bytes),
+      ArtifactLoaderAbi(options.minimum_driver, options.minimum_runtime));
+}
+
+bool RejectsFinalization(const PreparedStructuredTensorIrCompilation& prepared,
+                         const ArtifactKernelAbi& kernel, std::string_view expected) {
+  try {
+    (void)FinalizeStructuredTensorIrBuildSpec(prepared, kernel);
+  } catch (const InternalError& error) {
+    return std::string_view(error.what()).find(expected) != std::string_view::npos;
+  }
+  return false;
+}
+
+bool RejectsPreparation(const std::function<void()>& action, std::string_view expected) {
+  try {
+    action();
+  } catch (const ValueError& error) {
+    return std::string_view(error.what()).find(expected) != std::string_view::npos;
+  }
+  return false;
+}
