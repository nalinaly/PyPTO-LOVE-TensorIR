+/** Role of one value in the prepared compile-free TensorIR frontend contract. */
+enum class PreparedStructuredTensorIrValueRole : uint8_t {
+  Argument = 0,
+  Result = 1,
+};
+
+/** Owned metadata copied out of TensorIR source emission. */
+class PreparedStructuredTensorIrValueMetadata {
+ public:
+  PreparedStructuredTensorIrValueMetadata() = delete;
+  PreparedStructuredTensorIrValueMetadata(const PreparedStructuredTensorIrValueMetadata&) = default;
+  PreparedStructuredTensorIrValueMetadata(PreparedStructuredTensorIrValueMetadata&&) = default;
+  PreparedStructuredTensorIrValueMetadata& operator=(
+      const PreparedStructuredTensorIrValueMetadata&) = delete;
+  PreparedStructuredTensorIrValueMetadata& operator=(PreparedStructuredTensorIrValueMetadata&&) = delete;
+
+  [[nodiscard]] PreparedStructuredTensorIrValueRole GetRole() const noexcept { return role_; }
+  [[nodiscard]] uint32_t GetOrdinal() const noexcept { return ordinal_; }
+  [[nodiscard]] uint8_t GetDtypeCode() const noexcept { return dtype_code_; }
+  [[nodiscard]] const std::string& GetDtypeName() const noexcept { return dtype_name_; }
+  [[nodiscard]] const std::vector<int64_t>& GetShape() const noexcept { return shape_; }
+  [[nodiscard]] const std::vector<int64_t>& GetLogicalDenseStrides() const noexcept {
+    return logical_dense_strides_;
+  }
+  [[nodiscard]] bool HasExplicitStrides() const noexcept { return has_explicit_strides_; }
+  [[nodiscard]] constexpr bool IsContiguous() const noexcept { return true; }
+
+ private:
+  PreparedStructuredTensorIrValueMetadata(PreparedStructuredTensorIrValueRole role, uint32_t ordinal,
+                                          uint8_t dtype_code, std::string dtype_name,
+                                          std::vector<int64_t> shape,
+                                          std::vector<int64_t> logical_dense_strides,
+                                          bool has_explicit_strides);
+  friend PreparedStructuredTensorIrCompilation PrepareStructuredTensorIrCompilation(
+      const ir::ProgramPtr& program, const CompileRequest& request,
+      const CanonicalSchedule& schedule);
+
+  PreparedStructuredTensorIrValueRole role_;
+  uint32_t ordinal_;
+  uint8_t dtype_code_;
+  std::string dtype_name_;
+  std::vector<int64_t> shape_;
+  std::vector<int64_t> logical_dense_strides_;
+  bool has_explicit_strides_;
+};
