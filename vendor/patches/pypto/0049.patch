+int main() {
+  static_assert(!std::is_default_constructible_v<PreparedStructuredTensorIrValueMetadata>);
+  static_assert(!std::is_default_constructible_v<PreparedStructuredTensorIrCompilation>);
+  static_assert(!std::is_copy_assignable_v<PreparedStructuredTensorIrCompilation>);
+  static_assert(!std::is_move_assignable_v<PreparedStructuredTensorIrCompilation>);
+  static_assert(!std::is_constructible_v<PreparedStructuredTensorIrCompilation, CompileRequest,
+                                         CanonicalSchedule>);
+
+  if (const int result = TestPreparationGoldenAndOwnership()) return result;
+  if (const int result = TestRankOneBf16ImplicitStrideGoldenAndFinalization()) return result;
+  if (const int result = TestStrictScheduleOverloadParity()) return result;
+  if (const int result = TestDeterminismAndIdentityChanges()) return result;
+  if (const int result = TestFinalizationAndCallableBinding()) return result;
+  if (const int result = TestFinalizationRejectsAbiDrift()) return result;
+  if (const int result = TestPreparationRejectsInvalidInputs()) return result;
+  return 0;
+}
