+ir::ProgramPtr MakeProgram(const std::vector<int64_t>& shape = {8, 8},
+                           DataType dtype = DataType::FP32,
+                           const std::string& function_name = "add_main",
+                           const std::string& lhs_name = "lhs",
+                           const std::string& rhs_name = "rhs",
+                           bool reverse_operands = false) {
+  auto type = PlainTensor(shape, dtype);
+  auto lhs = std::make_shared<ir::Var>(lhs_name, type, TestSpan());
+  auto rhs = std::make_shared<ir::Var>(rhs_name, type, TestSpan());
+  auto result = std::make_shared<ir::Var>("sum", type, TestSpan());
+  const ir::OpPtr& add = ir::OpRegistry::GetInstance().GetOp("tensor.add");
+  auto call = std::make_shared<ir::Call>(
+      add, reverse_operands ? std::vector<ir::ExprPtr>{rhs, lhs}
+                            : std::vector<ir::ExprPtr>{lhs, rhs},
+      std::vector<std::pair<std::string, std::any>>{},
+      std::vector<std::pair<std::string, std::any>>{}, type, TestSpan());
+  auto assignment = std::make_shared<ir::AssignStmt>(result, call, TestSpan());
+  auto returned =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  auto body = std::make_shared<ir::SeqStmts>(
+      std::vector<ir::StmtPtr>{assignment, returned}, TestSpan());
+  auto function = std::make_shared<ir::Function>(
+      function_name, std::vector<ir::VarPtr>{lhs, rhs},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In, ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{type}, body, TestSpan());
+  return std::make_shared<ir::Program>(std::vector<ir::FunctionPtr>{function}, "test", TestSpan());
+}
