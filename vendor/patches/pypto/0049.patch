+struct KernelOptions {
+  std::string runtime_kernel_name = "tensor_ir_rtk";
+  std::string entry_function_name = "pypto_vector_add";
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  uint32_t input_count = 2;
