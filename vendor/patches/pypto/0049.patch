+int TestPreparationGoldenAndOwnership() {
+  const CompileRequest request = ValidRequest();
+  const CanonicalSchedule schedule = ValidSchedule();
+  const PreparedStructuredTensorIrCompilation prepared =
+      PrepareStructuredTensorIrCompilation(MakeProgram(), request, schedule);
+
+  REQUIRE(&prepared.GetCompileRequest() != &request);
+  REQUIRE(&prepared.GetSchedule() != &schedule);
+  REQUIRE(prepared.GetCompileRequest().SerializeCanonical() == request.SerializeCanonical());
+  REQUIRE(prepared.GetSchedule().SerializeCanonical() == schedule.SerializeCanonical());
+  REQUIRE(prepared.GetResolvedOptions().tile_sizes == std::vector<uint32_t>({16}));
+  REQUIRE(prepared.GetResolvedOptions().sm_count == 82);
+  REQUIRE(prepared.GetEntryName() == "pypto_vector_add");
+  REQUIRE(prepared.GetSourceIrDigest() ==
+          "0e5fbaf1cd70dffa0c81d43a1d2cad454f97cbf9a57ae5247da1cb27f6a049d3");
+  REQUIRE(Artifact::ComputeSourceIrDigest(prepared.GetCanonicalSource()) ==
+          prepared.GetSourceIrDigest());
+
+  const auto& metadata = prepared.GetValueMetadata();
+  REQUIRE(metadata.size() == 3);
+  REQUIRE(metadata[0].GetRole() == PreparedStructuredTensorIrValueRole::Argument);
+  REQUIRE(metadata[0].GetOrdinal() == 0);
+  REQUIRE(metadata[1].GetRole() == PreparedStructuredTensorIrValueRole::Argument);
+  REQUIRE(metadata[1].GetOrdinal() == 1);
+  REQUIRE(metadata[2].GetRole() == PreparedStructuredTensorIrValueRole::Result);
+  REQUIRE(metadata[2].GetOrdinal() == 0);
+  REQUIRE(metadata[0].GetDtypeCode() == DataType::FP32.Code());
+  REQUIRE(metadata[0].GetDtypeName() == "fp32");
+  REQUIRE(metadata[0].GetShape() == std::vector<int64_t>({8, 8}));
+  REQUIRE(metadata[0].GetLogicalDenseStrides() == std::vector<int64_t>({8, 1}));
+  REQUIRE(metadata[0].HasExplicitStrides());
+  REQUIRE(metadata[0].IsContiguous());
+
+  REQUIRE(prepared.GetStaticSpecialization().GetCanonicalBytes() ==
+          BytesFromHex(kStaticGoldenHex));
+  REQUIRE(prepared.GetStaticSpecialization().GetIdentityDigest() ==
+          "0bad0b86c36c86808f12b908692925e6493b4c78027da334d612b57bac5459aa");
+  REQUIRE(prepared.GetSymbolicSpecialization().GetCanonicalBytes() ==
+          BytesFromHex(kSymbolicGoldenHex));
+  REQUIRE(prepared.GetSymbolicSpecialization().GetIdentityDigest() ==
+          "1a2d6d32c956e86f41c0dc50dbafe53d33e3f63bd58bd683e78a06595b6ff58c");
+  REQUIRE(prepared.GetArgumentAbi().GetCanonicalBytes() == BytesFromHex(kArgumentGoldenHex));
+  REQUIRE(prepared.GetArgumentAbi().GetIdentityDigest() ==
+          "2bf59cefa95a2e95ac4e4647a654118b6d8c6fbfaa91a294621a9160d68dbd9b");
+  REQUIRE(prepared.GetResultAbi().GetCanonicalBytes() == BytesFromHex(kResultGoldenHex));
+  REQUIRE(prepared.GetResultAbi().GetIdentityDigest() ==
