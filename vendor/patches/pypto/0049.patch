+int TestPreparationRejectsInvalidInputs() {
+  const CompileRequest request = ValidRequest();
+  REQUIRE(RejectsPreparation(
+      [&] { (void)PrepareStructuredTensorIrCompilation(ir::ProgramPtr{}, request, ValidSchedule()); },
+      "program must not be null"));
+  REQUIRE(RejectsPreparation(
+      [&] {
+        (void)PrepareStructuredTensorIrCompilation(MakeProgram(), request,
+                                                   CanonicalSchedule({}, {}, {}, {}, {}, {}, {}, {}));
+      },
+      "CanonicalSchedule resolved schedule"));
+  return 0;
+}
