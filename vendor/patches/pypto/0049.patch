+  ArtifactArgumentPackingPolicy packing_policy = ArtifactArgumentPackingPolicy::PointerOnly;
+  ArtifactGridPolicy grid_policy = ArtifactGridPolicy::Static;
+  uint32_t grid_shape_operand_index = 0;
+  std::array<uint32_t, 3> static_grid = {4, 1, 1};
+  std::vector<uint32_t> tile_sizes = {16};
+  uint64_t workspace_size = 0;
+  uint64_t workspace_alignment = 1;
+  std::array<uint32_t, 3> block_dimensions = {1, 1, 1};
+  uint64_t dynamic_shared_memory = 0;
+  uint32_t kernel_argument_slot_bytes = 8;
