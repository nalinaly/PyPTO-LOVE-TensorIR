+int TestRankOneExactCanonicalSources() {
+  const ValidProgram valid = MakeValid({7}, DataType::BF16, "bf16_add");
+  const TensorIrModule module = EmitTensorIr(valid.program);
+  const std::string expected =
+      "module {\n"
+      "  nv_tensor_ir.graph @pypto_vector_add(\n"
+      "    %arg0: tensor<7xbf16>,\n"
+      "    %arg1: tensor<7xbf16>\n"
+      "  ) -> tensor<7xbf16> {\n"
+      "    %result0 = add %arg0, %arg1 : tensor<7xbf16>\n"
+      "    results %result0 : tensor<7xbf16>\n"
+      "  }\n"
+      "}\n";
+  REQUIRE(module.GetCanonicalSource() == expected);
+  REQUIRE(module.GetCanonicalSource().find("nv_tensor_ir.stride") == std::string::npos);
+  REQUIRE(module.GetValueMetadata()[0].GetDtypeCode() == DataType::BF16.Code());
+  REQUIRE(module.GetValueMetadata()[0].GetDtypeName() == "bfloat16");
+  REQUIRE(module.GetValueMetadata()[0].GetLogicalDenseStrides() ==
+          std::vector<int64_t>({1}));
+  REQUIRE(!module.GetValueMetadata()[0].HasExplicitStrides());
+
+  const ValidProgram fp32_valid =
+      MakeValid({128}, DataType::FP32, "fp32_vector_add");
+  const TensorIrModule fp32_module = EmitTensorIr(fp32_valid.program);
+  const std::string fp32_expected =
+      "module {\n"
+      "  nv_tensor_ir.graph @pypto_vector_add(\n"
+      "    %arg0: tensor<128xf32>,\n"
+      "    %arg1: tensor<128xf32>\n"
+      "  ) -> tensor<128xf32> {\n"
+      "    %result0 = add %arg0, %arg1 : tensor<128xf32>\n"
+      "    results %result0 : tensor<128xf32>\n"
+      "  }\n"
+      "}\n";
+  REQUIRE(fp32_module.GetCanonicalSource() == fp32_expected);
+  REQUIRE(!fp32_module.GetValueMetadata()[2].HasExplicitStrides());
+  return 0;
+}
