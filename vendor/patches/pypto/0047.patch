+int TestDeterministicGeneratedNamesAndOperandIdentity() {
+  const ValidProgram first =
+      MakeValid({4, 5}, DataType::FP32, "first_hir_name", "alpha", "beta", "gamma");
+  const ValidProgram second =
+      MakeValid({4, 5}, DataType::FP32, "second_hir_name", "x", "y", "z");
+  const TensorIrModule first_module = EmitTensorIr(first.program);
+  const TensorIrModule second_module = EmitTensorIr(second.program);
+  REQUIRE(first_module.GetCanonicalSource() == second_module.GetCanonicalSource());
+  REQUIRE(first_module.GetEntryName() == second_module.GetEntryName());
+
+  auto reversed_assignment = std::make_shared<ir::AssignStmt>(
+      first.result, AddCall(first.rhs, first.lhs, first.tensor_type), TestSpan());
+  auto return_statement =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{first.result}, TestSpan());
+  auto reversed = MakeProgram("first_hir_name", {first.lhs, first.rhs},
+                              {ir::ParamDirection::In, ir::ParamDirection::In},
+                              {first.tensor_type}, {reversed_assignment, return_statement});
+  REQUIRE(EmitTensorIr(reversed).GetCanonicalSource().find(
+              "%result0 = add %arg1, %arg0") != std::string::npos);
+  return 0;
+}
+
+int TestCanonicalSourceIgnoresGlobalLocale() {
+  const ValidProgram valid = MakeValid({1234, 5678}, DataType::FP32, "locale_test");
+  const std::string baseline = EmitTensorIr(valid.program).GetCanonicalSource();
+  const std::locale previous = std::locale();
+  std::locale::global(std::locale(std::locale::classic(), new GroupedNumpunct));
+  const std::string under_hostile_locale =
+      EmitTensorIr(valid.program).GetCanonicalSource();
+  std::locale::global(previous);
+  REQUIRE(under_hostile_locale == baseline);
+  REQUIRE(under_hostile_locale.find("1_234") == std::string::npos);
+  REQUIRE(under_hostile_locale.find("5_678") == std::string::npos);
+  REQUIRE(under_hostile_locale.find("tensor<1234x5678xf32>") != std::string::npos);
+  return 0;
+}
