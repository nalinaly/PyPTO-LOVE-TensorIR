+int main() {
+  static_assert(!std::is_default_constructible_v<TensorIrValueMetadata>);
+  static_assert(!std::is_default_constructible_v<TensorIrModule>);
+  static_assert(!std::is_copy_assignable_v<TensorIrValueMetadata>);
+  static_assert(!std::is_move_assignable_v<TensorIrValueMetadata>);
+  static_assert(!std::is_copy_assignable_v<TensorIrModule>);
+  static_assert(!std::is_move_assignable_v<TensorIrModule>);
+  static_assert(!std::is_constructible_v<
+                TensorIrValueMetadata, TensorIrValueRole, uint32_t, DataType,
+                std::vector<int64_t>, std::vector<int64_t>, bool>);
+  static_assert(!std::is_constructible_v<TensorIrModule, std::string,
+                                         std::vector<TensorIrValueMetadata>, uint32_t>);
+
+  if (const int result = TestFp32CanonicalSourceAndMetadata()) return result;
+  if (const int result = TestRankOneExactCanonicalSources()) return result;
+  if (const int result = TestDeterministicGeneratedNamesAndOperandIdentity()) return result;
+  if (const int result = TestCanonicalSourceIgnoresGlobalLocale()) return result;
+  if (const int result = TestStructuralRejections()) return result;
+  if (const int result = TestTypeAndExpressionRejections()) return result;
+  if (const int result = TestStaticShapeRejections()) return result;
+  if (const int result = TestCosmeticNamesAndDiagnosticBounds()) return result;
+  return 0;
+}
