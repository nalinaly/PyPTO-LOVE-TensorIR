+#ifndef PYPTO_SRC_CODEGEN_NVIDIA_TENSOR_IR_CODEGEN_H_
+#define PYPTO_SRC_CODEGEN_NVIDIA_TENSOR_IR_CODEGEN_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "pypto/core/dtype.h"
+#include "pypto/ir/program.h"
+
+namespace pypto::codegen::nvidia {
+
+class TensorIrModule;
+[[nodiscard]] TensorIrModule EmitTensorIr(const ir::ProgramPtr& program);
+
+/** Position of a value in the compile-free TensorIR graph ABI. */
+enum class TensorIrValueRole : uint8_t {
+  Input = 0,
+  Result = 1,
+};
+
+/**
+ * Compiler-neutral metadata for one statically shaped contiguous graph value.
+ *
+ * The dtype code is the stable PyPTO DataType code and dtype_name is its
+ * canonical PyPTO spelling.  No TensorIR or Artifact type crosses this seam.
+ */
+class TensorIrValueMetadata {
+ public:
+  TensorIrValueMetadata() = delete;
+  TensorIrValueMetadata(const TensorIrValueMetadata&) = default;
+  TensorIrValueMetadata(TensorIrValueMetadata&&) = default;
+  TensorIrValueMetadata& operator=(const TensorIrValueMetadata&) = delete;
+  TensorIrValueMetadata& operator=(TensorIrValueMetadata&&) = delete;
+
+  [[nodiscard]] TensorIrValueRole GetRole() const noexcept { return role_; }
+  [[nodiscard]] uint32_t GetOrdinal() const noexcept { return ordinal_; }
+  [[nodiscard]] uint8_t GetDtypeCode() const noexcept { return dtype_code_; }
+  [[nodiscard]] const std::string& GetDtypeName() const noexcept { return dtype_name_; }
+  [[nodiscard]] const std::vector<int64_t>& GetShape() const noexcept { return shape_; }
+  [[nodiscard]] const std::vector<int64_t>& GetLogicalDenseStrides() const noexcept {
+    return logical_dense_strides_;
+  }
+  [[nodiscard]] constexpr bool IsContiguous() const noexcept { return true; }
+  [[nodiscard]] bool HasExplicitStrides() const noexcept { return has_explicit_strides_; }
+
+ private:
+  TensorIrValueMetadata(TensorIrValueRole role, uint32_t ordinal, DataType dtype,
+                        std::vector<int64_t> shape,
+                        std::vector<int64_t> logical_dense_strides,
+                        bool has_explicit_strides);
+  friend TensorIrModule EmitTensorIr(const ir::ProgramPtr& program);
+
+  TensorIrValueRole role_;
+  uint32_t ordinal_;
+  uint8_t dtype_code_;
+  std::string dtype_name_;
+  std::vector<int64_t> shape_;
+  std::vector<int64_t> logical_dense_strides_;
+  bool has_explicit_strides_;
+};
+
+/** Exact TensorIR source bytes and the metadata used to construct them. */
+class TensorIrModule {
+ public:
+  static constexpr uint32_t kMetadataSchemaVersion = 1;
+
+  TensorIrModule() = delete;
+  TensorIrModule(const TensorIrModule&) = default;
+  TensorIrModule(TensorIrModule&&) = default;
+  TensorIrModule& operator=(const TensorIrModule&) = delete;
+  TensorIrModule& operator=(TensorIrModule&&) = delete;
+
+  [[nodiscard]] constexpr uint32_t GetMetadataSchemaVersion() const noexcept {
+    return kMetadataSchemaVersion;
+  }
+  [[nodiscard]] const std::string& GetCanonicalSource() const noexcept {
+    return canonical_source_;
+  }
+  [[nodiscard]] const std::string& GetEntryName() const noexcept { return entry_name_; }
+  [[nodiscard]] const std::vector<TensorIrValueMetadata>& GetValueMetadata() const noexcept {
+    return value_metadata_;
+  }
+  [[nodiscard]] uint32_t GetInputCount() const noexcept { return input_count_; }
+  [[nodiscard]] uint32_t GetResultCount() const noexcept {
+    return static_cast<uint32_t>(value_metadata_.size()) - input_count_;
+  }
+
+ private:
+  TensorIrModule(std::string canonical_source,
+                 std::vector<TensorIrValueMetadata> value_metadata, uint32_t input_count);
+  friend TensorIrModule EmitTensorIr(const ir::ProgramPtr& program);
+
+  std::string canonical_source_;
+  std::string entry_name_;
+  std::vector<TensorIrValueMetadata> value_metadata_;
+  uint32_t input_count_;
+};
+
+/**
+ * Emit the first strict PyPTO HIR subset as deterministic TensorIR text.
+ *
+ * V1 accepts exactly one Opaque function whose body is exactly a SeqStmts with
+ * two children: AssignStmt(result, Call(tensor.add, {param0, param1})) followed
+ * by ReturnStmt({result}). Inputs and the result must be plain, static,
+ * contiguous BF16 or FP32 tensors with identical types and shapes. Rejected HIR
+ * raises ValueError; this function never invokes TensorIR or any device compiler.
+ */
+[[nodiscard]] TensorIrModule EmitTensorIr(const ir::ProgramPtr& program);
+
+}  // namespace pypto::codegen::nvidia
+
+#endif  // PYPTO_SRC_CODEGEN_NVIDIA_TENSOR_IR_CODEGEN_H_
