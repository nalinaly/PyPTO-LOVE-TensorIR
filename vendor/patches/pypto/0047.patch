+int TestFp32CanonicalSourceAndMetadata() {
+  const ValidProgram valid = MakeValid();
+  const TensorIrModule module = EmitTensorIr(valid.program);
+  const std::string expected =
+      "module {\n"
+      "  nv_tensor_ir.graph @pypto_vector_add(\n"
+      "    %arg0: tensor<2x3xf32> {nv_tensor_ir.stride = \"(3,1)\"},\n"
+      "    %arg1: tensor<2x3xf32> {nv_tensor_ir.stride = \"(3,1)\"}\n"
+      "  ) -> (tensor<2x3xf32> {nv_tensor_ir.stride = \"(3,1)\"}) {\n"
+      "    %result0 = add %arg0, %arg1 : tensor<2x3xf32>\n"
+      "    results %result0 : tensor<2x3xf32>\n"
+      "  }\n"
+      "}\n";
+  REQUIRE(module.GetCanonicalSource() == expected);
+  REQUIRE(module.GetMetadataSchemaVersion() == 1);
+  REQUIRE(module.GetEntryName() == "pypto_vector_add");
+  REQUIRE(module.GetInputCount() == 2);
+  REQUIRE(module.GetResultCount() == 1);
+  REQUIRE(module.GetValueMetadata().size() == 3);
+
+  const auto& input0 = module.GetValueMetadata()[0];
+  REQUIRE(input0.GetRole() == TensorIrValueRole::Input);
+  REQUIRE(input0.GetOrdinal() == 0);
+  REQUIRE(input0.GetDtypeCode() == DataType::FP32.Code());
+  REQUIRE(input0.GetDtypeName() == "fp32");
+  REQUIRE(input0.GetShape() == std::vector<int64_t>({2, 3}));
+  REQUIRE(input0.GetLogicalDenseStrides() == std::vector<int64_t>({3, 1}));
+  REQUIRE(input0.IsContiguous());
+  REQUIRE(input0.HasExplicitStrides());
+
+  const auto& result = module.GetValueMetadata()[2];
+  REQUIRE(result.GetRole() == TensorIrValueRole::Result);
+  REQUIRE(result.GetOrdinal() == 0);
+  REQUIRE(result.GetDtypeCode() == DataType::FP32.Code());
+  REQUIRE(result.GetDtypeName() == "fp32");
+  REQUIRE(result.GetShape() == input0.GetShape());
+  REQUIRE(result.GetLogicalDenseStrides() == input0.GetLogicalDenseStrides());
+  REQUIRE(result.HasExplicitStrides());
+  return 0;
+}
