+int TestTypeAndExpressionRejections() {
+  const ValidProgram valid = MakeValid();
+  auto fp32 = PlainTensor({2, 3}, DataType::FP32);
+  auto bf16 = PlainTensor({2, 3}, DataType::BF16);
+  auto rank_one = PlainTensor({3}, DataType::FP32);
+  const ir::OpPtr& add = ir::OpRegistry::GetInstance().GetOp("tensor.add");
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp32, rank_one, fp32, fp32, fp32, add));
+      },
+      "input types and shapes must be identical"));
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp32, bf16, fp32, fp32, fp32, add));
+      },
+      "input types and shapes must be identical"));
+
+  auto fp16 = PlainTensor({2, 3}, DataType::FP16);
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp16, fp16, fp16, fp16, fp16, add));
+      },
+      "dtype must be BF16 or FP32"));
+
+  auto dynamic_extent = std::make_shared<ir::Var>(
+      "extent", std::make_shared<ir::ScalarType>(DataType::INDEX), TestSpan());
+  auto dynamic = std::make_shared<ir::TensorType>(
+      std::vector<ir::ExprPtr>{dynamic_extent}, DataType::FP32);
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(
+            MakeCustomProgram(dynamic, dynamic, dynamic, dynamic, dynamic, add));
+      },
+      "shape must be fully static"));
+
+  auto non_index_shape = std::make_shared<ir::TensorType>(
+      std::vector<ir::ExprPtr>{
+          std::make_shared<ir::ConstInt>(7, DataType::INT64, TestSpan())},
+      DataType::FP32);
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(
+            non_index_shape, non_index_shape, non_index_shape, non_index_shape,
+            non_index_shape, add));
+      },
+      "dimensions must have INDEX dtype"));
+
+  auto view = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{2, 3}, DataType::FP32, std::optional<ir::MemRefPtr>{},
+      std::optional<ir::TensorView>{
+          ir::TensorView(std::vector<int64_t>{1, 2}, ir::TensorLayout::DN)});
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(view, view, view, view, view, add));
+      },
+      "must not carry a TensorView"));
+
+  auto base = std::make_shared<ir::Var>("base", ir::GetPtrType(), TestSpan());
+  auto memref = std::make_shared<ir::MemRef>(base, 0, 24, TestSpan());
+  auto with_memref = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{2, 3}, DataType::FP32,
+      std::optional<ir::MemRefPtr>{memref});
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(with_memref, with_memref, with_memref,
+                                             with_memref, with_memref, add));
+      },
+      "must not carry a MemRef"));
+
+  auto lhs = std::make_shared<ir::Var>("lhs", fp32, TestSpan());
+  auto rhs = std::make_shared<ir::Var>("rhs", fp32, TestSpan());
+  auto nested = AddCall(lhs, rhs, fp32);
+  auto nested_result = std::make_shared<ir::Var>("sum", fp32, TestSpan());
+  auto nested_assignment = std::make_shared<ir::AssignStmt>(
+      nested_result, AddCall(nested, rhs, fp32), TestSpan());
+  auto nested_return = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{nested_result}, TestSpan());
+  auto nested_program = MakeProgram(
+      "add_main", {lhs, rhs}, {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {nested_assignment, nested_return});
+  REQUIRE(Rejects(
+      [&] { (void)EmitTensorIr(nested_program); },
+      "nested expressions are unsupported"));
+
+  auto sub = std::make_shared<ir::Op>("tensor.sub");
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp32, fp32, fp32, fp32, fp32, sub));
+      },
+      "only tensor.add"));
+
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp32, fp32, fp32, fp32, fp32, add, {},
+                                             {{"effect", true}}));
+      },
+      "attributes and keyword arguments are not supported"));
+
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(MakeCustomProgram(fp32, fp32, fp32, fp32, fp32, add,
+                                             {{"ignored", true}}, {}));
+      },
+      "attributes and keyword arguments are not supported"));
+
+  auto different = PlainTensor({2, 4}, DataType::FP32);
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(
+            MakeCustomProgram(fp32, fp32, fp32, fp32, different, add));
+      },
+      "result type and shape must match its inputs"));
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(
+            MakeCustomProgram(fp32, fp32, fp32, different, fp32, add));
+      },
+      "call, assignment, and declared result types must match"));
+  REQUIRE(Rejects(
+      [&] {
+        (void)EmitTensorIr(
+            MakeCustomProgram(fp32, fp32, different, fp32, fp32, add));
+      },
+      "call, assignment, and declared result types must match"));
+
+  auto identity_lhs = std::make_shared<ir::Var>("lhs", fp32, TestSpan());
+  auto identity_rhs = std::make_shared<ir::Var>("rhs", fp32, TestSpan());
+  auto external = std::make_shared<ir::Var>("external", fp32, TestSpan());
+  auto identity_result = std::make_shared<ir::Var>("sum", fp32, TestSpan());
+  auto identity_return = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{identity_result}, TestSpan());
+
+  auto iter_result =
+      std::make_shared<ir::IterArg>("iter_result", fp32, identity_lhs, TestSpan());
+  auto subclass_result = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(
+           iter_result, AddCall(identity_lhs, identity_rhs, fp32), TestSpan()),
+       std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{iter_result}, TestSpan())});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(subclass_result); },
+                  "assignment result must be an exact Var node"));
+
+  auto iter_operand =
+      std::make_shared<ir::IterArg>("iter_operand", fp32, identity_lhs, TestSpan());
+  auto subclass_operand = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(
+           identity_result, AddCall(iter_operand, identity_rhs, fp32), TestSpan()),
+       identity_return});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(subclass_operand); },
+                  "operands must be"));
+
+  auto returned_iter =
+      std::make_shared<ir::IterArg>("returned_iter", fp32, identity_result, TestSpan());
+  auto subclass_return = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(
+           identity_result, AddCall(identity_lhs, identity_rhs, fp32), TestSpan()),
+       std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{returned_iter}, TestSpan())});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(subclass_return); },
+                  "return must directly reference"));
+
+  auto external_operand = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(
+           identity_result, AddCall(external, identity_rhs, fp32), TestSpan()),
+       identity_return});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(external_operand); },
+                  "operand is not a function parameter"));
+
+  auto reused_result = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(
+           identity_lhs, AddCall(identity_lhs, identity_rhs, fp32), TestSpan()),
+       std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{identity_lhs}, TestSpan())});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(reused_result); },
+                  "result must not reuse a parameter"));
+
+  for (const ir::VarPtr& repeated : std::vector<ir::VarPtr>{identity_lhs, identity_rhs}) {
+    auto same_operand = MakeProgram(
+        "add_main", {identity_lhs, identity_rhs},
+        {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+        {std::make_shared<ir::AssignStmt>(
+             identity_result, AddCall(repeated, repeated, fp32), TestSpan()),
+         identity_return});
+    REQUIRE(Rejects([&] { (void)EmitTensorIr(same_operand); },
+                    "cover both distinct function parameters"));
+  }
+
+  auto short_call = CallWith(add, {identity_lhs}, fp32);
+  auto wrong_arity = MakeProgram(
+      "add_main", {identity_lhs, identity_rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {fp32},
+      {std::make_shared<ir::AssignStmt>(identity_result, short_call, TestSpan()),
+       identity_return});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(wrong_arity); },
+                  "must have exactly two operands"));
+  return 0;
+}
+
+int TestStaticShapeRejections() {
+  const ir::OpPtr& add = ir::OpRegistry::GetInstance().GetOp("tensor.add");
+  const auto reject_shape = [&](const std::vector<int64_t>& shape,
+                                std::string_view expected) {
+    auto type = PlainTensor(shape, DataType::FP32);
+    return Rejects(
+        [&] {
+          (void)EmitTensorIr(MakeCustomProgram(type, type, type, type, type, add));
+        },
+        expected);
+  };
+
+  REQUIRE(reject_shape({}, "rank must be between 1 and 32"));
+  REQUIRE(reject_shape(std::vector<int64_t>(33, 1), "rank must be between 1 and 32"));
+  REQUIRE(reject_shape({0}, "non-positive dimension"));
+  REQUIRE(reject_shape({-1}, "non-positive dimension"));
+  REQUIRE(reject_shape({2, std::numeric_limits<int64_t>::max()},
+                       "element count exceeds the signed 64-bit"));
+  return 0;
+}
+
+int TestCosmeticNamesAndDiagnosticBounds() {
+  const ValidProgram valid = MakeValid();
+  const std::string oversized_function(5000, 'x');
+  const ValidProgram cosmetic = MakeValid({2, 3}, DataType::FP32, oversized_function,
+                                          "same\nname", "same\nname", "same\nname");
+  const TensorIrModule cosmetic_module = EmitTensorIr(cosmetic.program);
+  REQUIRE(cosmetic_module.GetCanonicalSource() ==
+          EmitTensorIr(valid.program).GetCanonicalSource());
+  REQUIRE(cosmetic_module.GetCanonicalSource().find("xxxxxxxx") == std::string::npos);
+  REQUIRE(cosmetic_module.GetCanonicalSource().find("same") == std::string::npos);
+
+  const ir::Span oversized_span(std::string(10000, 'p'), 1, 1);
+  auto fp16 = PlainTensor({2, 3}, DataType::FP16);
+  auto lhs = std::make_shared<ir::Var>("lhs", fp16, oversized_span);
+  auto rhs = std::make_shared<ir::Var>("rhs", fp16, oversized_span);
+  auto result = std::make_shared<ir::Var>("result", fp16, oversized_span);
+  auto assignment = std::make_shared<ir::AssignStmt>(
+      result, AddCall(lhs, rhs, fp16), oversized_span);
+  auto returned = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{result}, oversized_span);
+  auto diagnostic_program = MakeProgram(
+      "ignored", {lhs, rhs}, {ir::ParamDirection::In, ir::ParamDirection::In}, {fp16},
+      {assignment, returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(diagnostic_program); },
+                  "dtype must be BF16 or FP32"));
+  return 0;
+}
