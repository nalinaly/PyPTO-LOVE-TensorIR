+constexpr size_t kMaximumDiagnosticBytes = 4096;
+constexpr size_t kMaximumDiagnosticNameBytes = 96;
+constexpr size_t kMaximumCanonicalSourceBytes = 16ULL * 1024ULL * 1024ULL;
+constexpr size_t kMaximumRank = 32;
+constexpr std::string_view kCanonicalEntryName = "pypto_vector_add";
+
+struct StaticTensor {
+  DataType dtype;
+  std::vector<int64_t> shape;
+  std::vector<int64_t> dense_strides;
+};
+
+std::string BoundedDisplay(std::string_view value) {
+  std::string output;
+  const size_t count = std::min(value.size(), kMaximumDiagnosticNameBytes);
+  output.reserve(count + 3);
+  for (size_t index = 0; index < count; ++index) {
+    const unsigned char character = static_cast<unsigned char>(value[index]);
+    output.push_back(character >= 0x20 && character <= 0x7e ? static_cast<char>(character) : '?');
+  }
+  if (value.size() > count) output += "...";
+  return output;
+}
+
+[[noreturn]] void Reject(std::string message, const ir::Span* span = nullptr) {
+  std::string diagnostic = "TensorIR emission rejected: " + std::move(message);
+  if (span != nullptr && span->is_valid()) {
+    diagnostic += " at " + BoundedDisplay(span->filename_) + ":" +
+                  std::to_string(span->begin_line_) + ":" +
+                  std::to_string(span->begin_column_);
+  }
+  if (diagnostic.size() > kMaximumDiagnosticBytes) {
+    diagnostic.resize(kMaximumDiagnosticBytes - 3);
+    diagnostic += "...";
+  }
+  throw ValueError(diagnostic);
+}
+
+[[noreturn]] void InternalReject(std::string_view message) {
+  throw InternalError("TensorIR emission internal error: " + std::string(message));
+}
+
+std::vector<int64_t> MakeDenseStrides(const std::vector<int64_t>& shape,
+                                      const ir::Span& span) {
+  std::vector<int64_t> strides(shape.size());
+  int64_t running = 1;
+  for (size_t reverse_index = shape.size(); reverse_index > 0; --reverse_index) {
+    const size_t index = reverse_index - 1;
+    strides[index] = running;
+    if (shape[index] > std::numeric_limits<int64_t>::max() / running) {
+      Reject("static tensor element count exceeds the signed 64-bit metadata bound", &span);
+    }
+    running *= shape[index];
+  }
+  return strides;
+}
+
+std::vector<int64_t> MakeDenseStridesForMetadata(const std::vector<int64_t>& shape) {
+  std::vector<int64_t> strides(shape.size());
+  int64_t running = 1;
+  for (size_t reverse_index = shape.size(); reverse_index > 0; --reverse_index) {
+    const size_t index = reverse_index - 1;
+    strides[index] = running;
+    if (shape[index] > std::numeric_limits<int64_t>::max() / running) {
+      InternalReject("value metadata element count exceeds the signed 64-bit bound");
+    }
+    running *= shape[index];
+  }
+  return strides;
+}
+
+StaticTensor ReadStaticTensor(const ir::TypePtr& type, const ir::Span& span,
+                              std::string_view location) {
+  const auto tensor_type = ir::As<ir::TensorType>(type);
+  if (!tensor_type) {
+    Reject(std::string(location) + " must have plain TensorType", &span);
+  }
+  if (tensor_type->memref_.has_value()) {
+    Reject(std::string(location) + " must not carry a MemRef", &span);
+  }
+  if (tensor_type->tensor_view_.has_value()) {
+    Reject(std::string(location) + " must not carry a TensorView", &span);
+  }
+  if (tensor_type->dtype_ != DataType::BF16 && tensor_type->dtype_ != DataType::FP32) {
+    Reject(std::string(location) + " dtype must be BF16 or FP32, got " +
+               tensor_type->dtype_.ToString(),
+           &span);
+  }
+  if (tensor_type->shape_.empty() || tensor_type->shape_.size() > kMaximumRank) {
+    Reject(std::string(location) + " rank must be between 1 and 32", &span);
+  }
+
+  std::vector<int64_t> shape;
+  shape.reserve(tensor_type->shape_.size());
+  for (const ir::ExprPtr& dimension : tensor_type->shape_) {
+    const auto constant = ir::As<ir::ConstInt>(dimension);
+    if (!constant) {
+      Reject(std::string(location) + " shape must be fully static", &span);
+    }
+    if (constant->dtype() != DataType::INDEX) {
+      Reject(std::string(location) + " static shape dimensions must have INDEX dtype", &span);
+    }
+    if (constant->value_ <= 0) {
+      Reject(std::string(location) + " contains a non-positive dimension", &span);
+    }
+    shape.push_back(constant->value_);
+  }
+  return StaticTensor{tensor_type->dtype_, shape, MakeDenseStrides(shape, span)};
+}
+
+bool SameTensor(const StaticTensor& left, const StaticTensor& right) {
+  return left.dtype == right.dtype && left.shape == right.shape &&
+         left.dense_strides == right.dense_strides;
+}
+
+const char* TensorIrDtype(DataType dtype) {
+  if (dtype == DataType::BF16) return "bf16";
+  if (dtype == DataType::FP32) return "f32";
+  InternalReject("unsupported dtype reached source emission");
+}
+
+void AppendInteger(std::string& output, int64_t value) {
+  char buffer[32];
+  const auto result = std::to_chars(buffer, buffer + sizeof(buffer), value);
+  if (result.ec != std::errc{}) InternalReject("integer formatting failed");
+  output.append(buffer, result.ptr);
+}
+
+void AppendIndex(std::string& output, size_t value) {
+  char buffer[32];
+  const auto result = std::to_chars(buffer, buffer + sizeof(buffer), value);
+  if (result.ec != std::errc{}) InternalReject("index formatting failed");
+  output.append(buffer, result.ptr);
+}
+
+std::string JoinIntegers(const std::vector<int64_t>& values, char separator) {
+  std::string output;
+  output.reserve(values.size() * 4);
+  for (size_t index = 0; index < values.size(); ++index) {
+    if (index != 0) output.push_back(separator);
+    AppendInteger(output, values[index]);
+  }
+  return output;
+}
+
+std::string TensorTypeText(const StaticTensor& tensor) {
+  return "tensor<" + JoinIntegers(tensor.shape, 'x') + "x" +
+         TensorIrDtype(tensor.dtype) + ">";
+}
+
+std::string TensorWithStrideText(const StaticTensor& tensor) {
+  const std::string type = TensorTypeText(tensor);
+  if (tensor.shape.size() == 1) return type;
+  return type + " {nv_tensor_ir.stride = \"(" + JoinIntegers(tensor.dense_strides, ',') +
+         ")\"}";
+}
+
+std::string EmitSource(const StaticTensor& tensor, size_t lhs_index, size_t rhs_index) {
+  const std::string type = TensorTypeText(tensor);
+  const std::string type_with_stride = TensorWithStrideText(tensor);
+  std::string source;
+  source.reserve(256 + type_with_stride.size() * 3 + type.size() * 2);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kCanonicalEntryName;
+  source += "(\n    %arg0: ";
+  source += type_with_stride;
+  source += ",\n    %arg1: ";
+  source += type_with_stride;
+  source += "\n  ) -> ";
+  if (tensor.shape.size() == 1) {
+    source += type;
+  } else {
+    source += "(";
+    source += type_with_stride;
+    source += ")";
+  }
+  source += " {\n    %result0 = add %arg";
+  AppendIndex(source, lhs_index);
+  source += ", %arg";
+  AppendIndex(source, rhs_index);
+  source += " : ";
+  source += type;
+  source += "\n    results %result0 : ";
+  source += type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
+
+std::vector<ir::StmtPtr> BodyStatements(const ir::StmtPtr& body,
+                                        const ir::Span& function_span) {
+  if (!body) Reject("function body must not be null", &function_span);
+  const auto sequence = ir::As<ir::SeqStmts>(body);
+  if (!sequence) {
+    Reject("function body must be a top-level sequence containing one add and one return",
+           &body->span_);
+  }
+  if (sequence->stmts_.size() != 2) {
+    Reject("function body must contain exactly one assignment and one return",
+           &sequence->span_);
+  }
+  if (!sequence->stmts_[0] || !sequence->stmts_[1]) {
+    Reject("function body must not contain null statements", &sequence->span_);
+  }
+  return sequence->stmts_;
+}
+
+}  // namespace
+
+TensorIrValueMetadata::TensorIrValueMetadata(TensorIrValueRole role, uint32_t ordinal,
+                                             DataType dtype, std::vector<int64_t> shape,
+                                             std::vector<int64_t> logical_dense_strides,
+                                             bool has_explicit_strides)
+    : role_(role),
+      ordinal_(ordinal),
+      dtype_code_(dtype.Code()),
+      dtype_name_(dtype.ToString()),
+      shape_(std::move(shape)),
+      logical_dense_strides_(std::move(logical_dense_strides)),
+      has_explicit_strides_(has_explicit_strides) {
+  if (role_ != TensorIrValueRole::Input && role_ != TensorIrValueRole::Result) {
+    InternalReject("value metadata role is invalid");
+  }
+  if ((role_ == TensorIrValueRole::Input && ordinal_ > 1) ||
+      (role_ == TensorIrValueRole::Result && ordinal_ != 0)) {
+    InternalReject("value metadata ordinal is invalid for its role");
+  }
+  if (dtype != DataType::BF16 && dtype != DataType::FP32) {
+    InternalReject("value metadata dtype must be BF16 or FP32");
+  }
+  if (dtype_name_.empty() || shape_.empty() || shape_.size() > kMaximumRank ||
+      shape_.size() != logical_dense_strides_.size() ||
+      std::any_of(shape_.begin(), shape_.end(), [](int64_t dimension) {
+        return dimension <= 0;
+      })) {
+    InternalReject("value metadata is incomplete");
+  }
+  if (has_explicit_strides_ != (shape_.size() >= 2)) {
+    InternalReject("value metadata explicit-stride state does not match canonical rank policy");
+  }
+  if (logical_dense_strides_ != MakeDenseStridesForMetadata(shape_)) {
+    InternalReject("value metadata logical dense strides do not match its shape");
+  }
+}
+
+TensorIrModule::TensorIrModule(std::string canonical_source,
+                               std::vector<TensorIrValueMetadata> value_metadata,
+                               uint32_t input_count)
+    : canonical_source_(std::move(canonical_source)),
+      entry_name_(kCanonicalEntryName),
+      value_metadata_(std::move(value_metadata)),
+      input_count_(input_count) {
+  if (canonical_source_.empty() || canonical_source_.size() > kMaximumCanonicalSourceBytes) {
+    InternalReject("canonical source metadata is empty or exceeds 16 MiB");
+  }
+  if (input_count_ != 2 || value_metadata_.size() != 3) {
+    InternalReject("tensor.add module metadata must contain Input0, Input1, and Result0");
+  }
+  if (value_metadata_[0].GetRole() != TensorIrValueRole::Input ||
+      value_metadata_[0].GetOrdinal() != 0 ||
+      value_metadata_[1].GetRole() != TensorIrValueRole::Input ||
+      value_metadata_[1].GetOrdinal() != 1 ||
+      value_metadata_[2].GetRole() != TensorIrValueRole::Result ||
+      value_metadata_[2].GetOrdinal() != 0) {
+    InternalReject("tensor.add module metadata roles and ordinals are invalid");
+  }
+  const auto same_value_type = [](const TensorIrValueMetadata& left,
+                                  const TensorIrValueMetadata& right) {
+    return left.GetDtypeCode() == right.GetDtypeCode() &&
+           left.GetDtypeName() == right.GetDtypeName() && left.GetShape() == right.GetShape() &&
+           left.GetLogicalDenseStrides() == right.GetLogicalDenseStrides() &&
+           left.HasExplicitStrides() == right.HasExplicitStrides();
+  };
+  if (!same_value_type(value_metadata_[0], value_metadata_[1]) ||
+      !same_value_type(value_metadata_[0], value_metadata_[2])) {
+    InternalReject("tensor.add module value metadata must have identical types and layouts");
+  }
+}
+
+TensorIrModule EmitTensorIr(const ir::ProgramPtr& program) {
+  if (!program) Reject("program must not be null");
+  if (program->functions_.size() != 1) {
+    Reject("program must contain exactly one function", &program->span_);
+  }
+
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function) Reject("program contains a null function binding", &program->span_);
+  if (global->name_ != function->name_) {
+    Reject("global function name does not match the bound function name", &function->span_);
+  }
+  if (function->requires_runtime_binding_) {
+    Reject("runtime-bound functions are not supported", &function->span_);
+  }
+  if (function->func_type_ != ir::FunctionType::Opaque || function->level_.has_value() ||
+      function->role_.has_value()) {
+    Reject("function must be Opaque with no hierarchy level or role", &function->span_);
+  }
+  if (!function->attrs_.empty()) {
+    Reject("function attributes are not supported", &function->span_);
+  }
+  if (function->params_.size() != 2 || function->param_directions_.size() != 2) {
+    Reject("tensor.add v1 requires exactly two function parameters", &function->span_);
+  }
+  if (!std::all_of(function->param_directions_.begin(), function->param_directions_.end(),
+                   [](ir::ParamDirection direction) {
+                     return direction == ir::ParamDirection::In;
+                   })) {
+    Reject("all tensor.add parameters must have direction In", &function->span_);
+  }
+  if (function->return_types_.size() != 1) {
+    Reject("tensor.add v1 requires exactly one declared return", &function->span_);
+  }
+
+  std::vector<StaticTensor> inputs;
+  inputs.reserve(function->params_.size());
+  std::unordered_map<const ir::Var*, size_t> parameter_indices;
+  for (size_t index = 0; index < function->params_.size(); ++index) {
+    const ir::VarPtr& parameter = function->params_[index];
+    if (!parameter) Reject("function contains a null parameter", &function->span_);
+    if (parameter->GetKind() != ir::ObjectKind::Var) {
+      Reject("function parameters must be exact Var nodes", &parameter->span_);
+    }
+    if (!parameter_indices.emplace(parameter.get(), index).second) {
+      Reject("function parameters must have distinct IR identities", &parameter->span_);
+    }
+    inputs.push_back(ReadStaticTensor(parameter->GetType(), parameter->span_,
+                                      "function parameter"));
+  }
+  if (!SameTensor(inputs[0], inputs[1])) {
+    Reject("tensor.add input types and shapes must be identical", &function->span_);
+  }
+
+  const StaticTensor declared_result =
+      ReadStaticTensor(function->return_types_[0], function->span_, "declared result");
+  if (!SameTensor(inputs[0], declared_result)) {
+    Reject("tensor.add result type and shape must match its inputs", &function->span_);
+  }
+
+  const std::vector<ir::StmtPtr> statements = BodyStatements(function->body_, function->span_);
+  const auto assignment = ir::As<ir::AssignStmt>(statements[0]);
+  if (!assignment) {
+    Reject("first function statement must assign tensor.add", &statements[0]->span_);
+  }
+  if (!assignment->var_ || !assignment->value_) {
+    Reject("tensor.add assignment must have a non-null target and value", &assignment->span_);
+  }
+  if (assignment->var_->GetKind() != ir::ObjectKind::Var) {
+    Reject("tensor.add assignment result must be an exact Var node", &assignment->var_->span_);
+  }
+  if (parameter_indices.count(assignment->var_.get()) != 0) {
+    Reject("tensor.add result must not reuse a parameter IR identity", &assignment->span_);
+  }
+
+  const auto call = ir::As<ir::Call>(assignment->value_);
+  if (!call || !call->op_) {
+    Reject("assigned value must be a tensor.add call", &assignment->value_->span_);
+  }
+  if (!ir::IsOp(call, "tensor.add")) {
+    Reject("only tensor.add is supported", &call->span_);
+  }
+  if (!call->attrs_.empty() || !call->kwargs_.empty()) {
+    Reject("tensor.add attributes and keyword arguments are not supported", &call->span_);
+  }
+  if (call->args_.size() != 2) {
+    Reject("tensor.add must have exactly two operands", &call->span_);
+  }
+
+  std::vector<size_t> operand_indices;
+  operand_indices.reserve(call->args_.size());
+  for (const ir::ExprPtr& argument : call->args_) {
+    const auto variable = ir::As<ir::Var>(argument);
+    if (!variable) {
+      Reject("tensor.add operands must be direct function parameters; nested expressions are unsupported",
+             argument ? &argument->span_ : &call->span_);
+    }
+    if (variable->GetKind() != ir::ObjectKind::Var) {
+      Reject("tensor.add operands must be exact Var nodes", &variable->span_);
+    }
+    const auto found = parameter_indices.find(variable.get());
+    if (found == parameter_indices.end()) {
+      Reject("tensor.add operand is not a function parameter", &variable->span_);
+    }
+    const StaticTensor operand =
+        ReadStaticTensor(variable->GetType(), variable->span_, "tensor.add operand");
+    if (!SameTensor(inputs[0], operand)) {
+      Reject("tensor.add operand types and shapes must be identical", &variable->span_);
+    }
+    operand_indices.push_back(found->second);
+  }
+  if (operand_indices[0] == operand_indices[1]) {
+    Reject("tensor.add operands must cover both distinct function parameters", &call->span_);
+  }
+
+  const StaticTensor call_result =
+      ReadStaticTensor(call->GetType(), call->span_, "tensor.add call result");
+  const StaticTensor assigned_result = ReadStaticTensor(
+      assignment->var_->GetType(), assignment->var_->span_, "tensor.add assignment result");
+  if (!SameTensor(declared_result, call_result) ||
+      !SameTensor(declared_result, assigned_result)) {
+    Reject("tensor.add call, assignment, and declared result types must match", &call->span_);
+  }
+
+  const auto return_statement = ir::As<ir::ReturnStmt>(statements[1]);
+  if (!return_statement || return_statement->value_.size() != 1) {
+    Reject("second function statement must be exactly one return", &statements[1]->span_);
+  }
+  const auto returned_variable = ir::As<ir::Var>(return_statement->value_[0]);
+  if (!returned_variable || returned_variable->GetKind() != ir::ObjectKind::Var ||
+      returned_variable.get() != assignment->var_.get()) {
+    Reject("return must directly reference the tensor.add assignment result",
+           &return_statement->span_);
+  }
+
+  std::vector<TensorIrValueMetadata> metadata;
+  metadata.reserve(3);
+  for (size_t index = 0; index < inputs.size(); ++index) {
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, static_cast<uint32_t>(index), inputs[index].dtype,
+        inputs[index].shape, inputs[index].dense_strides, inputs[index].shape.size() >= 2));
+  }
+  metadata.push_back(TensorIrValueMetadata(
+      TensorIrValueRole::Result, 0, declared_result.dtype, declared_result.shape,
+      declared_result.dense_strides, declared_result.shape.size() >= 2));
+
+  return TensorIrModule(EmitSource(declared_result, operand_indices[0], operand_indices[1]),
+                        std::move(metadata), /*input_count=*/2);
+}
+
