+int TestStructuralRejections() {
+  const ValidProgram valid = MakeValid();
+  const ir::FunctionPtr valid_function = valid.program->functions_.begin()->second;
+  const std::vector<ir::StmtPtr> valid_statements = ValidStatements(valid);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(nullptr); }, "program must not be null"));
+
+  auto empty = std::make_shared<ir::Program>(std::vector<ir::FunctionPtr>{}, "empty", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(empty); }, "exactly one function"));
+
+  std::map<ir::GlobalVarPtr, ir::FunctionPtr, ir::GlobalVarPtrLess> null_binding;
+  null_binding.emplace(std::make_shared<ir::GlobalVar>("add_main"), ir::FunctionPtr{});
+  auto null_function_program =
+      std::make_shared<ir::Program>(std::move(null_binding), "null", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_function_program); },
+                  "null function binding"));
+
+  std::map<ir::GlobalVarPtr, ir::FunctionPtr, ir::GlobalVarPtrLess> mismatched_binding;
+  mismatched_binding.emplace(std::make_shared<ir::GlobalVar>("different"), valid_function);
+  auto mismatched_global =
+      std::make_shared<ir::Program>(std::move(mismatched_binding), "mismatch", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(mismatched_global); },
+                  "global function name does not match"));
+
+  auto second = MakeValid({2, 3}, DataType::FP32, "second");
+  std::vector<ir::FunctionPtr> functions;
+  functions.push_back(valid.program->functions_.begin()->second);
+  functions.push_back(second.program->functions_.begin()->second);
+  auto multi = std::make_shared<ir::Program>(functions, "multi", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(multi); }, "exactly one function"));
+
+  auto out_direction = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::Out}, {valid.tensor_type},
+      ValidStatements(valid));
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(out_direction); }, "direction In"));
+
+  auto wrong_parameter_count = MakeRawProgram(
+      {valid.lhs}, {ir::ParamDirection::In}, {valid.tensor_type}, valid_function->body_);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(wrong_parameter_count); },
+                  "exactly two function parameters"));
+
+  auto wrong_return_count = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In}, {},
+      valid_function->body_);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(wrong_return_count); },
+                  "exactly one declared return"));
+
+  auto null_parameter = MakeRawProgram(
+      {ir::VarPtr{}, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_function->body_);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_parameter); },
+                  "null parameter"));
+
+  auto iter_parameter = std::make_shared<ir::IterArg>(
+      "iter", valid.tensor_type, valid.lhs, TestSpan());
+  auto subclass_parameter = MakeRawProgram(
+      {iter_parameter, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_function->body_);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(subclass_parameter); },
+                  "parameters must be exact Var nodes"));
+
+  auto duplicate_parameter = MakeRawProgram(
+      {valid.lhs, valid.lhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_function->body_);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(duplicate_parameter); },
+                  "distinct IR identities"));
+
+  auto runtime_bound = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_function->body_, {}, true);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(runtime_bound); },
+                  "runtime-bound functions"));
+
+  auto attributed_function = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_function->body_, {{"ignored", true}});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(attributed_function); },
+                  "function attributes"));
+
+  auto assignment = std::make_shared<ir::AssignStmt>(
+      valid.result, AddCall(valid.lhs, valid.rhs, valid.tensor_type), TestSpan());
+  auto returned = std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{valid.result}, TestSpan());
+  auto multiple_returns = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {assignment, returned, returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(multiple_returns); },
+                  "exactly one assignment and one return"));
+
+  auto incore_function = std::make_shared<ir::Function>(
+      "add_main", std::vector<ir::VarPtr>{valid.lhs, valid.rhs},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In, ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{valid.tensor_type},
+      valid.program->functions_.begin()->second->body_, TestSpan(), ir::FunctionType::InCore);
+  auto incore_program = std::make_shared<ir::Program>(
+      std::vector<ir::FunctionPtr>{incore_function}, "incore", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(incore_program); },
+                  "must be Opaque with no hierarchy"));
+
+  auto null_statement_body = std::make_shared<ir::SeqStmts>(
+      std::vector<ir::StmtPtr>{ir::StmtPtr{}, ir::StmtPtr{}}, TestSpan());
+  auto null_function = std::make_shared<ir::Function>(
+      "add_main", std::vector<ir::VarPtr>{valid.lhs, valid.rhs},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In, ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{valid.tensor_type}, null_statement_body, TestSpan());
+  auto null_program = std::make_shared<ir::Program>(
+      std::vector<ir::FunctionPtr>{null_function}, "null_body", TestSpan());
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_program); },
+                  "must not contain null statements"));
+
+  auto null_body_program = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, ir::StmtPtr{});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_body_program); },
+                  "body must not be null"));
+
+  auto non_sequence = MakeRawProgram(
+      {valid.lhs, valid.rhs}, {ir::ParamDirection::In, ir::ParamDirection::In},
+      {valid.tensor_type}, valid_statements[0]);
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(non_sequence); },
+                  "top-level sequence"));
+
+  auto eval_body = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {std::make_shared<ir::EvalStmt>(AddCall(valid.lhs, valid.rhs, valid.tensor_type), TestSpan()),
+       returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(eval_body); },
+                  "first function statement must assign"));
+
+  auto return_call = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {assignment,
+       std::make_shared<ir::ReturnStmt>(
+           std::vector<ir::ExprPtr>{AddCall(valid.lhs, valid.rhs, valid.tensor_type)},
+           TestSpan())});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(return_call); },
+                  "return must directly reference"));
+
+  auto null_target_assignment = std::make_shared<ir::AssignStmt>(
+      ir::VarPtr{}, AddCall(valid.lhs, valid.rhs, valid.tensor_type), TestSpan());
+  auto null_target = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {null_target_assignment, returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_target); },
+                  "non-null target and value"));
+
+  auto null_value_assignment =
+      std::make_shared<ir::AssignStmt>(valid.result, ir::ExprPtr{}, TestSpan());
+  auto null_value = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {null_value_assignment, returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(null_value); },
+                  "non-null target and value"));
+
+  auto non_call_assignment =
+      std::make_shared<ir::AssignStmt>(valid.result, valid.lhs, TestSpan());
+  auto non_call = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {non_call_assignment, returned});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(non_call); },
+                  "assigned value must be a tensor.add call"));
+
+  auto eval_second = MakeProgram(
+      "add_main", {valid.lhs, valid.rhs},
+      {ir::ParamDirection::In, ir::ParamDirection::In}, {valid.tensor_type},
+      {assignment, std::make_shared<ir::EvalStmt>(valid.lhs, TestSpan())});
+  REQUIRE(Rejects([&] { (void)EmitTensorIr(eval_second); },
+                  "second function statement must be exactly one return"));
+  return 0;
+}
