+const ir::Span& TestSpan() {
+  static const ir::Span span("tensor_ir_codegen_test.py", 7, 3);
+  return span;
+}
+
+ir::TensorTypePtr PlainTensor(const std::vector<int64_t>& shape, DataType dtype) {
+  return std::make_shared<ir::TensorType>(shape, dtype, std::optional<ir::MemRefPtr>{});
+}
+
+ir::CallPtr CallWith(const ir::OpPtr& op, const std::vector<ir::ExprPtr>& arguments,
+                     const ir::TypePtr& type,
+                     std::vector<std::pair<std::string, std::any>> kwargs = {},
+                     std::vector<std::pair<std::string, std::any>> attrs = {}) {
+  return std::make_shared<ir::Call>(op, arguments, std::move(kwargs), std::move(attrs), type,
+                                    TestSpan());
+}
+
+ir::CallPtr AddCall(const ir::ExprPtr& lhs, const ir::ExprPtr& rhs,
+                    const ir::TypePtr& type) {
+  return CallWith(ir::OpRegistry::GetInstance().GetOp("tensor.add"), {lhs, rhs}, type);
+}
+
+ir::ProgramPtr MakeProgram(const std::string& function_name,
+                           const std::vector<ir::VarPtr>& parameters,
+                           const std::vector<ir::ParamDirection>& directions,
+                           const std::vector<ir::TypePtr>& return_types,
+                           const std::vector<ir::StmtPtr>& statements,
+                           std::vector<std::pair<std::string, std::any>> function_attrs = {}) {
+  auto body = std::make_shared<ir::SeqStmts>(statements, TestSpan());
+  auto function = std::make_shared<ir::Function>(
+      function_name, parameters, directions, return_types, body, TestSpan(),
+      ir::FunctionType::Opaque, std::nullopt, std::nullopt, std::move(function_attrs));
+  return std::make_shared<ir::Program>(std::vector<ir::FunctionPtr>{function}, "test",
+                                      TestSpan());
+}
+
+ir::ProgramPtr MakeRawProgram(
+    const std::vector<ir::VarPtr>& parameters,
+    const std::vector<ir::ParamDirection>& directions,
+    const std::vector<ir::TypePtr>& return_types, const ir::StmtPtr& body,
+    std::vector<std::pair<std::string, std::any>> function_attrs = {},
+    bool requires_runtime_binding = false,
+    ir::FunctionType function_type = ir::FunctionType::Opaque,
+    const std::string& function_name = "add_main") {
+  auto function = std::make_shared<ir::Function>(
+      function_name, parameters, directions, return_types, body, TestSpan(), function_type,
+      std::nullopt, std::nullopt, std::move(function_attrs), requires_runtime_binding);
+  return std::make_shared<ir::Program>(std::vector<ir::FunctionPtr>{function}, "test",
+                                      TestSpan());
+}
+
+struct ValidProgram {
+  ir::ProgramPtr program;
+  ir::VarPtr lhs;
+  ir::VarPtr rhs;
+  ir::VarPtr result;
+  ir::TensorTypePtr tensor_type;
+};
+
+ValidProgram MakeValid(const std::vector<int64_t>& shape = {2, 3},
+                       DataType dtype = DataType::FP32,
+                       const std::string& function_name = "add_main",
+                       const std::string& lhs_name = "lhs",
+                       const std::string& rhs_name = "rhs",
+                       const std::string& result_name = "sum") {
+  auto type = PlainTensor(shape, dtype);
+  auto lhs = std::make_shared<ir::Var>(lhs_name, type, TestSpan());
+  auto rhs = std::make_shared<ir::Var>(rhs_name, type, TestSpan());
+  auto result = std::make_shared<ir::Var>(result_name, type, TestSpan());
+  auto assignment = std::make_shared<ir::AssignStmt>(result, AddCall(lhs, rhs, type), TestSpan());
+  auto return_statement =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  return {MakeProgram(function_name, {lhs, rhs},
+                      {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+                      {assignment, return_statement}),
+          lhs, rhs, result, type};
+}
+
+std::vector<ir::StmtPtr> ValidStatements(const ValidProgram& valid) {
+  return std::static_pointer_cast<const ir::SeqStmts>(
+             valid.program->functions_.begin()->second->body_)
+      ->stmts_;
+}
+
+ir::ProgramPtr MakeCustomProgram(
+    const ir::TensorTypePtr& lhs_type, const ir::TensorTypePtr& rhs_type,
+    const ir::TensorTypePtr& assignment_type, const ir::TypePtr& call_type,
+    const ir::TypePtr& declared_type, const ir::OpPtr& op,
+    std::vector<std::pair<std::string, std::any>> kwargs = {},
+    std::vector<std::pair<std::string, std::any>> attrs = {}) {
+  auto lhs = std::make_shared<ir::Var>("lhs", lhs_type, TestSpan());
+  auto rhs = std::make_shared<ir::Var>("rhs", rhs_type, TestSpan());
+  auto result = std::make_shared<ir::Var>("sum", assignment_type, TestSpan());
+  auto call = CallWith(op, {lhs, rhs}, call_type, std::move(kwargs), std::move(attrs));
+  auto assignment = std::make_shared<ir::AssignStmt>(result, call, TestSpan());
+  auto returned =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  return MakeProgram("add_main", {lhs, rhs},
+                     {ir::ParamDirection::In, ir::ParamDirection::In}, {declared_type},
+                     {assignment, returned});
+}
+
+class GroupedNumpunct : public std::numpunct<char> {
+ protected:
+  [[nodiscard]] char do_thousands_sep() const override { return '_'; }
+  [[nodiscard]] std::string do_grouping() const override { return "\3"; }
+};
+
+bool Rejects(const std::function<void()>& action, std::string_view expected) {
+  try {
+    action();
+  } catch (const ValueError& error) {
+    const std::string_view diagnostic(error.what());
+    return diagnostic.find(expected) != std::string_view::npos && diagnostic.size() <= 4096;
+  }
+  return false;
+}
