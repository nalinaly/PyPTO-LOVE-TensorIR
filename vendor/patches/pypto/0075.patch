+ir::ProgramPtr MakeBroadcastIntoPointwiseProgram(DataType dtype) {
+  auto full_type = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{8, 16}, dtype, std::optional<ir::MemRefPtr>{});
+  auto row_type = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{8, 1}, dtype, std::optional<ir::MemRefPtr>{});
+  auto full = std::make_shared<ir::Var>("full", full_type, TestSpan());
+  auto row = std::make_shared<ir::Var>("row", row_type, TestSpan());
+  auto result = std::make_shared<ir::Var>("result", full_type, TestSpan());
+  auto call = std::make_shared<ir::Call>(
+      ir::OpRegistry::GetInstance().GetOp("tensor.row_expand_mul"),
+      std::vector<ir::ExprPtr>{full, row},
+      std::vector<std::pair<std::string, std::any>>{},
+      std::vector<std::pair<std::string, std::any>>{}, full_type, TestSpan());
+  auto body = std::make_shared<ir::SeqStmts>(
+      std::vector<ir::StmtPtr>{
+          std::make_shared<ir::AssignStmt>(result, call, TestSpan()),
+          std::make_shared<ir::ReturnStmt>(
+              std::vector<ir::ExprPtr>{result}, TestSpan())},
+      TestSpan());
+  auto function = std::make_shared<ir::Function>(
+      "ignored", std::vector<ir::VarPtr>{full, row},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In,
+                                      ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{full_type}, body, TestSpan());
+  return std::make_shared<ir::Program>(
+      std::vector<ir::FunctionPtr>{function}, "test", TestSpan());
+}
