+From d540d54760de9ed5e112088d27cc0eded9ccbb14 Mon Sep 17 00:00:00 2001
+From: zhaosiying12138 <neucszhaopeng2016@163.com>
+Date: Thu, 27 Aug 2026 18:36:34 +0800
+Subject: [PATCH] Lower zero-stride broadcast views into pointwise
+
+---
+ include/tensor_ir/Dialect/TensorOps.td        |  8 ++--
+ lib/Dialect/TensorDialect.cpp                 | 40 ++++++-------------
+ .../TensorToCudaTile/broadcast_layout.mlir    | 25 ++++++++++++
+ test/Dialect/invalid.mlir                     | 10 -----
+ test/Dialect/ops.mlir                         | 17 ++++++++
+ 5 files changed, 59 insertions(+), 41 deletions(-)
+
+diff --git a/include/tensor_ir/Dialect/TensorOps.td b/include/tensor_ir/Dialect/TensorOps.td
+index 681f2e2..7549281 100644
+--- a/include/tensor_ir/Dialect/TensorOps.td
++++ b/include/tensor_ir/Dialect/TensorOps.td
+@@ -750,9 +750,11 @@ def TensorIR_BroadcastOp : TensorIR_PointWiseOpBase<"broadcast", [
+ 
+     Every broadcast dim must change from a literal `1` in the input to either a
+     dynamic `?` or a literal `>1` in the output (the "shape=1 + dynamic stride"
+-    convention). The legacy "shape=? + stride=0" convention is no longer
+-    accepted. Non-broadcast dims must be either identical or both dynamic; a
+-    no-op broadcast (no dim changes) is also rejected — remove the op instead.
++    convention). A `broadcast` op does not use a full-extent, stride-zero input;
++    graph signature attributes may represent such broadcast views directly and
++    layout-propagation lowers them at the load. Non-broadcast dims must be either
++    identical or both dynamic; a no-op broadcast (no dim changes) is also
++    rejected — remove the op instead.
+ 
+     `dynamic_dims` may supply one index scalar for every dynamic result
+     dimension, in dimension order. It may be omitted during migration from
+diff --git a/lib/Dialect/TensorDialect.cpp b/lib/Dialect/TensorDialect.cpp
+index 7a39a20..adac4aa 100644
+--- a/lib/Dialect/TensorDialect.cpp
++++ b/lib/Dialect/TensorDialect.cpp
+@@ -44,8 +44,7 @@ tcutegen::Shape getShapeRef(TensorType tensorType) {
+ } // namespace mlir::nv_tensor_ir
+ 
+ static LogicalResult verifyTensorSignatureAttribute(Operation *op, Type type,
+-                                                    NamedAttribute attr,
+-                                                    bool isInput) {
++                                                    NamedAttribute attr) {
+   StringRef attrName = attr.getName().strref();
+   StringRef displayName = attrName.rsplit('.').second;
+   auto tensorType = dyn_cast<nv_tensor_ir::TensorType>(type);
+@@ -99,27 +98,13 @@ static LogicalResult verifyTensorSignatureAttribute(Operation *op, Type type,
+              << tcg::to_string(*stride) << "\"";
+     }
+ 
+-    // Reject stride=0 on input dimensions with shape != 1. Outputs are
+-    // unrestricted because their storage may intentionally represent a
+-    // broadcasted destination.
+-    if (isInput) {
+-      for (size_t i = 0; i < tcg::rank(*stride); ++i) {
+-        const auto &strideDim = (*stride)[i];
+-        if (!tcg::is_static(strideDim) || strideDim != 0) {
+-          continue;
+-        }
+-        const auto &shapeDim = shape[i];
+-        if (!tcg::is_static(shapeDim) || shapeDim != 1) {
+-          return op->emitError()
+-                 << "stride=0 is not allowed in graph input stride attribute "
+-                    "on a non-shape-1 dim (legacy broadcast convention is "
+-                    "deprecated; use shape=1 + an explicit broadcast op "
+-                    "instead), but got \""
+-                 << tcg::to_string(*stride) << "\" with shape \""
+-                 << tcg::to_string(shape) << "\"";
+-        }
+-      }
+-    }
++    // A zero stride is a valid graph-signature broadcast view, including when
++    // the corresponding logical extent is greater than one. The
++    // layout-propagation conversion lowers such an input to a unit-extent load
++    // followed by cuda_tile.broadcast, so it neither advances the source
++    // pointer nor reads outside the physical view. Keep explicit BroadcastOp's
++    // shape-changing contract separate: that op still requires a literal unit
++    // input extent and is verified in BroadcastOp::verify().
+     return success();
+   }
+ 
+@@ -221,8 +206,8 @@ TensorIRDialect::verifyRegionArgAttribute(Operation *op, unsigned regionIndex,
+                                           NamedAttribute argAttr) {
+   auto function = cast<FunctionOpInterface>(op);
+   assert(regionIndex == 0 && "function arguments must belong to region zero");
+-  return verifyTensorSignatureAttribute(
+-      op, function.getArgumentTypes()[argIndex], argAttr, /*isInput=*/true);
++  return verifyTensorSignatureAttribute(op, function.getArgumentTypes()[argIndex],
++                                        argAttr);
+ }
+ 
+ LogicalResult TensorIRDialect::verifyRegionResultAttribute(
+@@ -230,9 +215,8 @@ LogicalResult TensorIRDialect::verifyRegionResultAttribute(
+     NamedAttribute resultAttr) {
+   auto function = cast<FunctionOpInterface>(op);
+   assert(regionIndex == 0 && "function results must belong to region zero");
+-  return verifyTensorSignatureAttribute(op,
+-                                        function.getResultTypes()[resultIndex],
+-                                        resultAttr, /*isInput=*/false);
++  return verifyTensorSignatureAttribute(
++      op, function.getResultTypes()[resultIndex], resultAttr);
+ }
