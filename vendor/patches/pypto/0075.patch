+ // -----
+ 
++// A producer may encode an already-expanded logical input with a zero stride.
++// The conversion must load one physical value along that dimension, then
++// broadcast the loaded tile before the pointwise operation.
++// CHECK-LABEL: entry @broadcast_view_into_pointwise
++// CHECK: %[[ZERO:.*]] = constant <i32: 0> : tile<i32>
++// CHECK: %[[ROW_VIEW:.*]] = make_tensor_view {{.*}}, shape = [32, 32], strides = [1, 0] : tensor_view<32x32xf32, strides=[1,0]>
++// CHECK: %[[ROW_PART:.*]] = make_partition_view %[[ROW_VIEW]] : partition_view<tile=(1x1), tensor_view<32x32xf32, strides=[1,0]>>
++// CHECK: %[[ROW_LOAD:.*]], {{.*}} = load_view_tko weak %[[ROW_PART]][{{.*}}, %[[ZERO]]]
++// CHECK: %[[ROW_TILE:.*]] = broadcast %[[ROW_LOAD]] : tile<1x1xf32> -> tile<1x32xf32>
++// CHECK: %[[FULL_TILE:.*]], {{.*}} = load_view_tko weak
++// CHECK: %[[MUL:.*]] = mulf %[[ROW_TILE]], %[[FULL_TILE]] : tile<1x32xf32>
++// CHECK: store_view_tko weak %[[MUL]]
++module {
++  nv_tensor_ir.graph @broadcast_view_into_pointwise(
++      %row: tensor<32x32xf32> {nv_tensor_ir.stride = "(1,0)"},
++      %full: tensor<32x32xf32>)
++      -> (tensor<32x32xf32>)
++      attributes {tile_size = array<i32: 1, 32>} {
++    %mul = mul %row, %full : tensor<32x32xf32>
++    results %mul : tensor<32x32xf32>
++  }
++}
++
++// -----
++
+ // CHECK-LABEL: entry @broadcast_two_dimensions
+ // CHECK: %[[ZERO:.*]] = constant <i32: 0> : tile<i32>
+ // CHECK: %[[TVIEW1:.*]] = make_tensor_view {{.*}}, shape = [1, 1], strides = [1, 1] : tensor_view<1x1xf32, strides=[1,1]>
+diff --git a/test/Dialect/invalid.mlir b/test/Dialect/invalid.mlir
+index 7e5b5ff..13e5da9 100644
+--- a/test/Dialect/invalid.mlir
++++ b/test/Dialect/invalid.mlir
+@@ -246,16 +246,6 @@ nv_tensor_ir.graph @graphOpVerifyGraphStride(
+   results %res: tensor<?x?x?xf32>
+ }
+ 
+-// -----
+-// expected-error @below {{stride=0 is not allowed in graph input stride attribute}}
+-nv_tensor_ir.graph @graphOpVerifyStrideZeroRejected(
+-  %lhs: tensor<?x?x?xf32> {nv_tensor_ir.stride = "(0,?,1)"},
+-  %rhs: tensor<?x?x?xf32>
+-) -> tensor<?x?x?xf32> {
+-  %res = add %lhs, %rhs : tensor<?x?x?xf32>
+-  results %res: tensor<?x?x?xf32>
+-}
+-
+ // -----
+ // Broadcast verifier: no-op broadcast (no dim changes from 1 to non-1).
+ nv_tensor_ir.graph @broadcastNoOp(
+diff --git a/test/Dialect/ops.mlir b/test/Dialect/ops.mlir
+index cc69210..95eda48 100644
+--- a/test/Dialect/ops.mlir
++++ b/test/Dialect/ops.mlir
+@@ -11,6 +11,23 @@ nv_tensor_ir.graph @someGraph() {
+   results
+ }
+ 
++// -----
++
++// A full-logical-extent graph input may describe a broadcast view with a zero
++// stride. This is distinct from the shape-changing broadcast op below.
++// CHECK-LABEL: nv_tensor_ir.graph @zeroStrideBroadcastView
++// CHECK-SAME: %[[ROW:.*]]: tensor<4x8xf32> {nv_tensor_ir.stride = "(1,0)"}
++// CHECK-SAME: %[[FULL:.*]]: tensor<4x8xf32> {nv_tensor_ir.stride = "(8,1)"}
++// CHECK: %[[MUL:.*]] = mul %[[ROW]], %[[FULL]] : tensor<4x8xf32>
++// CHECK: results %[[MUL]] : tensor<4x8xf32>
++nv_tensor_ir.graph @zeroStrideBroadcastView(
++  %row: tensor<4x8xf32> {nv_tensor_ir.stride = "(1,0)"},
++  %full: tensor<4x8xf32> {nv_tensor_ir.stride = "(8,1)"}
++) -> (tensor<4x8xf32> {nv_tensor_ir.stride = "(8,1)"}) {
++  %mul = mul %row, %full : tensor<4x8xf32>
++  results %mul : tensor<4x8xf32>
++}
++
+ // Pointwise binary operations
+ // CHECK-LABEL: nv_tensor_ir.graph @pointwiseBinaryFloatTestGraph
+ // CHECK-SAME: %[[arg0:.*]]: tensor<10xf32>, %[[arg1:.*]]: tensor<10xf32>, %[[arg2:.*]]: tensor<10xf32>
