+bool ValidateStructuredMatmulSpec(const StructuredMatmulTensorIrSpec& spec,
+                                  std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR structured matmul specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  if (!HasValidStaticMetadata(spec.inputs[0]) ||
+      !HasValidStaticMetadata(spec.inputs[1]) ||
+      !HasValidStaticMetadata(spec.result) || !IsDense(spec.inputs[0]) ||
+      !IsDense(spec.inputs[1]) || !IsDense(spec.result)) {
+    return reject("tensor metadata must be fully static and dense");
+  }
+  const auto& lhs = spec.inputs[0];
+  const auto& rhs = spec.inputs[1];
+  const size_t rank = lhs.shape.size();
+  if (lhs.element_type != TypedTensorIrElementType::BF16 ||
+      rhs.element_type != TypedTensorIrElementType::BF16 ||
+      (spec.result.element_type != TypedTensorIrElementType::BF16 &&
+       spec.result.element_type != TypedTensorIrElementType::FP32) ||
+      (rank != 2 && rank != 3) || rhs.shape.size() != rank ||
+      spec.result.shape.size() != rank ||
+      (spec.result.element_type == TypedTensorIrElementType::FP32) !=
+          spec.round_bf16_before_result) {
+    return reject("tensor dtype, rank, or rounding contract is invalid");
+  }
+  const int64_t batch = rank == 3 ? lhs.shape[0] : 1;
+  if (rank == 3 && rhs.shape[0] != batch) {
+    return reject("rank-3 batch extents must match");
+  }
+  const int64_t m = spec.a_transpose ? lhs.shape.back()
+                                     : lhs.shape[rank - 2];
+  const int64_t lhs_k = spec.a_transpose ? lhs.shape[rank - 2]
+                                         : lhs.shape.back();
+  const int64_t rhs_k = spec.b_transpose ? rhs.shape.back()
+                                         : rhs.shape[rank - 2];
+  const int64_t n = spec.b_transpose ? rhs.shape[rank - 2]
+                                     : rhs.shape.back();
+  const std::vector<int64_t> expected =
+      rank == 2 ? std::vector<int64_t>{m, n}
+                : std::vector<int64_t>{batch, m, n};
+  if (lhs_k != rhs_k || lhs_k % 128 != 0 || n % 16 != 0 ||
+      spec.result.shape != expected) {
+    return reject("contraction or result geometry is invalid");
+  }
+  return true;
+}
+
+mlir::Type ElementType(mlir::OpBuilder& builder,
+                       TypedTensorIrElementType element_type) {
+  if (element_type == TypedTensorIrElementType::BF16) {
+    return builder.getBF16Type();
+  }
+  if (element_type == TypedTensorIrElementType::FP32) {
+    return builder.getF32Type();
+  }
+  if (element_type == TypedTensorIrElementType::INT32) {
+    return builder.getIntegerType(32, mlir::IntegerType::Signed);
+  }
+  return builder.getIntegerType(64, mlir::IntegerType::Signed);
+}
+
+mlir::RankedTensorType TensorType(
+    mlir::OpBuilder& builder, TypedTensorIrElementType element_type,
+    llvm::ArrayRef<int64_t> shape) {
+  return mlir::RankedTensorType::get(shape,
+                                     ElementType(builder, element_type));
+}
+
+mlir::Value BuildStructuredMatmul(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const StructuredMatmulTensorIrSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                           entry.getArguments().end());
+  mlir::Value lhs = arguments[0];
+  mlir::Value rhs = arguments[1];
+  const size_t rank = spec.inputs[0].shape.size();
+  const llvm::SmallVector<int64_t> permutation =
+      rank == 2 ? llvm::SmallVector<int64_t>{1, 0}
+                : llvm::SmallVector<int64_t>{0, 2, 1};
+  if (spec.a_transpose) {
+    std::vector<int64_t> shape = spec.inputs[0].shape;
+    std::swap(shape[rank - 2], shape[rank - 1]);
+    lhs = tir::TransposeOp::create(
+              builder, location,
+              TensorType(builder, spec.inputs[0].element_type, shape), lhs,
+              permutation)
+              .getOutput();
+  }
+  if (spec.b_transpose) {
+    std::vector<int64_t> shape = spec.inputs[1].shape;
+    std::swap(shape[rank - 2], shape[rank - 1]);
+    rhs = tir::TransposeOp::create(
+              builder, location,
+              TensorType(builder, spec.inputs[1].element_type, shape), rhs,
+              permutation)
+              .getOutput();
+  }
+  const auto accumulation_type = TensorType(
+      builder, TypedTensorIrElementType::FP32, spec.result.shape);
+  mlir::Value result =
+      tir::MatmulOp::create(builder, location, accumulation_type, lhs, rhs)
+          .getC();
+  const auto rounded_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, spec.result.shape);
+  result =
+      tir::ConvertOp::create(builder, location, rounded_type, result).getOutput();
+  if (spec.result.element_type == TypedTensorIrElementType::FP32) {
+    result = tir::ConvertOp::create(
+                 builder, location,
+                 TensorType(builder, spec.result.element_type,
+                            spec.result.shape),
+                 result)
+                 .getOutput();
+  }
+  return result;
+}
