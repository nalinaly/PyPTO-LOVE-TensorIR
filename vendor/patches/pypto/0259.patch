+TypedTensorIrModuleSpec MakeNativePagedDecodeTensorIrSpec(
+    const NativeTilePagedDecodeGraph& graph) {
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativePagedDecode;
+  auto& spec = module_spec.native_paged_decode;
+  const std::array<StaticTensor, NativePagedDecodeTensorIrSpec::kInputCount>
+      inputs = {graph.query,          graph.key_cache, graph.value_cache,
+                graph.req_to_token,   graph.request_index,
+                graph.valid_tokens,  graph.virtual_to_physical};
+  for (size_t index = 0; index < inputs.size(); ++index) {
+    spec.inputs[index] = MakeTypedTensorIrTensorSpec(
+        inputs[index], /*has_explicit_strides=*/true);
+  }
+  spec.result = MakeTypedTensorIrTensorSpec(
+      graph.result, /*has_explicit_strides=*/true);
+  spec.batch_size = graph.batch_size;
+  spec.query_heads = graph.q_heads;
+  spec.kv_heads = graph.kv_heads;
+  spec.tokens = graph.tokens;
+  spec.head_dim = graph.head_dim;
+  spec.cache_rows = graph.cache_rows;
+  spec.scale = graph.scale;
+  return module_spec;
+}
