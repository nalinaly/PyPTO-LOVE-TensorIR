+  const StaticTensor k3 = tensor(DataType::BF16, {tokens, kvHeads, headDim});
+  const StaticTensor qf = tensor(DataType::FP32, q3.shape);
+  const StaticTensor kf = tensor(DataType::FP32, k3.shape);
+  const StaticTensor qRow = tensor(DataType::FP32, {tokens, qHeads, 1});
+  const StaticTensor kRow = tensor(DataType::FP32, {tokens, kvHeads, 1});
+  const StaticTensor weight3 = tensor(DataType::FP32, {1, 1, headDim});
+  const StaticTensor qWeightFull = tensor(DataType::FP32, q3.shape);
+  const StaticTensor kWeightFull = tensor(DataType::FP32, k3.shape);
+  const StaticTensor cacheRows = tensor(DataType::BF16, {tokens, rotaryDim});
+  const StaticTensor cacheRowsF = tensor(DataType::FP32, cacheRows.shape);
+  const StaticTensor cacheHalf = tensor(DataType::FP32, {tokens, half});
+  const StaticTensor cacheHalf3 = tensor(DataType::FP32, {tokens, 1, half});
+  const StaticTensor qHalf = tensor(DataType::FP32, {tokens, qHeads, half});
+  const StaticTensor kHalf = tensor(DataType::FP32, {tokens, kvHeads, half});
+  const StaticTensor qTail =
+      tensor(DataType::FP32, {tokens, qHeads, headDim - rotaryDim});
+  const StaticTensor kTail =
+      tensor(DataType::FP32, {tokens, kvHeads, headDim - rotaryDim});
+  const StaticTensor qRotary =
+      tensor(DataType::FP32, {tokens, qHeads, rotaryDim});
+  const StaticTensor kRotary =
+      tensor(DataType::FP32, {tokens, kvHeads, rotaryDim});
+  const StaticTensor qFlat =
+      tensor(DataType::BF16, {tokens * qHeads * headDim});
+  const StaticTensor kFlat =
+      tensor(DataType::BF16, {tokens * kvHeads * headDim});
+  StaticTensor positions32 = graph.positions;
