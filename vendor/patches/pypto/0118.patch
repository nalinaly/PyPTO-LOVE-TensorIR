+    source += ", ";
+    AppendInteger(source, prefix == "q" ? qHeads : kvHeads);
+    source += ", ";
+    AppendInteger(source, half);
+    source += "] strides = [1, 1, 1] : " + readyType + " -> " + halfType;
+    source += "\n    %" + std::string(prefix) +
+              "_high = slice %" + std::string(prefix) +
+              "_ready starts = [0, 0, ";
+    AppendInteger(source, half);
+    source += "] limits = [";
+    AppendInteger(source, tokens);
+    source += ", ";
+    AppendInteger(source, prefix == "q" ? qHeads : kvHeads);
+    source += ", ";
+    AppendInteger(source, rotaryDim);
+    source += "] strides = [1, 1, 1] : " + readyType + " -> " + halfType;
+    source += "\n    %" + std::string(prefix) +
+              "_tail = slice %" + std::string(prefix) +
+              "_ready starts = [0, 0, ";
+    AppendInteger(source, rotaryDim);
+    source += "] limits = [";
+    AppendInteger(source, tokens);
+    source += ", ";
+    AppendInteger(source, prefix == "q" ? qHeads : kvHeads);
+    source += ", ";
+    AppendInteger(source, headDim);
+    source += "] strides = [1, 1, 1] : " + readyType + " -> " + tailType;
+    source += "\n    %" + std::string(prefix) + "_low_cos = mul %" +
+              std::string(prefix) + "_low, %" + std::string(prefix) +
+              "_cos : " + halfType;
+    source += "\n    %" + std::string(prefix) + "_high_sin = mul %" +
+              std::string(prefix) + "_high, %" + std::string(prefix) +
+              "_sin : " + halfType;
+    source += "\n    %" + std::string(prefix) + "_rot_low = sub %" +
+              std::string(prefix) + "_low_cos, %" + std::string(prefix) +
+              "_high_sin : " + halfType;
+    source += "\n    %" + std::string(prefix) + "_high_cos = mul %" +
+              std::string(prefix) + "_high, %" + std::string(prefix) +
+              "_cos : " + halfType;
+    source += "\n    %" + std::string(prefix) + "_low_sin = mul %" +
+              std::string(prefix) + "_low, %" + std::string(prefix) +
+              "_sin : " + halfType;
+    source += "\n    %" + std::string(prefix) + "_rot_high = add %" +
+              std::string(prefix) + "_high_cos, %" + std::string(prefix) +
+              "_low_sin : " + halfType;
+    source += "\n    %" + std::string(prefix) +
+              "_rotary = concatenate %" + std::string(prefix) +
+              "_rot_low, %" + std::string(prefix) +
+              "_rot_high dimension = 2 : (" + halfType + ", " + halfType +
+              ") -> " + rotaryType;
+    source += "\n    %" + std::string(prefix) +
+              "_complete = concatenate %" + std::string(prefix) +
+              "_rotary, %" + std::string(prefix) +
+              "_tail dimension = 2 : (" + rotaryType + ", " + tailType +
