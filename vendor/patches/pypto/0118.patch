+    source += "\n    %" + std::string(prefix) + "_mean_c = constant ";
+    AppendFloat(source, 1.0 / static_cast<double>(headDim));
+    source += " : f32\n    %" + std::string(prefix) +
+              "_mean_s = splat %" + std::string(prefix) + "_mean_c : " +
