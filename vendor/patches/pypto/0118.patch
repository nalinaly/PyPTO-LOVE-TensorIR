+  const std::string k3Type = TensorTypeText(k3);
+  const std::string qfType = TensorTypeText(qf);
+  const std::string kfType = TensorTypeText(kf);
+  const std::string qRowType = TensorTypeText(qRow);
+  const std::string kRowType = TensorTypeText(kRow);
+  const std::string weightType = TensorTypeText(graph.weight);
+  const std::string weightFType = TensorTypeText(weightF);
+  const std::string weight3Type = TensorTypeText(weight3);
+  const std::string qWeightFullType = TensorTypeText(qWeightFull);
