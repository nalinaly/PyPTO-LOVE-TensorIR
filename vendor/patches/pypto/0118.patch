+bool IsNativeTileQkRmsNormRopeCandidate(const ir::ProgramPtr& program) {
+  if (!program || program->functions_.size() != 1) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (!function || function->params_.size() != 7) return false;
+  const auto positionsType =
+      ir::As<ir::TensorType>(function->params_[5]->GetType());
+  return positionsType &&
+         (positionsType->dtype_ == DataType::INT64 ||
+          positionsType->dtype_ == DataType::INT32);
+}
+
+NativeTileQkRmsNormRopeGraph AnalyzeNativeTileQkRmsNormRope(
+    const ir::ProgramPtr& program) {
+  if (!IsNativeTileQkRmsNormRopeCandidate(program)) {
+    Reject("native QK RMSNorm/RoPE candidate is malformed",
+           program ? &program->span_ : nullptr);
+  }
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native QK RMSNorm/RoPE must be one canonical CHIP @pl.jit function",
+           &function->span_);
+  }
+  if (function->param_directions_.size() != 7 ||
+      function->return_types_.size() != 1) {
+    Reject("native QK RMSNorm/RoPE parameter directions are invalid",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 6; ++index) {
+    if (function->param_directions_[index] != ir::ParamDirection::In) {
+      Reject("native QK RMSNorm/RoPE inputs must have direction In",
+             &function->params_[index]->span_);
+    }
+  }
+  if (function->param_directions_[6] != ir::ParamDirection::Out) {
+    Reject("native QK RMSNorm/RoPE output must have direction Out",
+           &function->params_[6]->span_);
+  }
+
+  const StaticTensor qGate = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native QK packed query/gate");
+  const StaticTensor key = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native QK key");
+  const StaticTensor qWeight = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native Q weight");
+  const StaticTensor kWeight = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native K weight");
+  const StaticTensor cache = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native RoPE cache");
+  StaticTensor positions = ReadStaticIntegerTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native RoPE positions");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[6]->GetType(), function->params_[6]->span_,
+      "native QK packed output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native QK declared output");
+  if (qGate.shape.size() != 2 || key.shape.size() != 2 ||
+      qWeight.shape.size() != 2 || kWeight.shape.size() != 2 ||
+      cache.shape.size() != 2 || positions.shape.size() != 2 ||
+      result.shape.size() != 1 || !SameTensor(qWeight, kWeight) ||
+      !SameTensor(result, declared) || qWeight.shape[0] != 1 ||
+      qGate.shape[0] != key.shape[0] ||
+      positions.shape !=
+          std::vector<int64_t>({qGate.shape[0], cache.shape[1]})) {
+    Reject("native QK RMSNorm/RoPE tensor ranks or shared shapes are invalid",
+           &function->span_);
+  }
+  const int64_t headDim = qWeight.shape[1];
+  const int64_t rotaryDim = cache.shape[1];
+  if (headDim <= 0 || rotaryDim <= 0 || rotaryDim >= headDim ||
+      rotaryDim % 2 != 0 || qGate.shape[1] % (2 * headDim) != 0 ||
+      key.shape[1] % headDim != 0) {
+    Reject("native QK RMSNorm/RoPE head geometry is invalid",
+           &function->span_);
+  }
+  const int64_t qHeads = qGate.shape[1] / (2 * headDim);
+  const int64_t kvHeads = key.shape[1] / headDim;
+  const int64_t expectedElements =
+      qGate.shape[0] * (2 * qHeads * headDim + kvHeads * headDim);
+  if (qHeads <= 0 || kvHeads <= 0 || result.shape[0] != expectedElements) {
+    Reject("native QK RMSNorm/RoPE packed output extent is invalid",
+           &function->span_);
+  }
+  positions.dense_strides = {1, 0};
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returnedVar =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returnedVar ||
+      returnedVar.get() != function->params_[6].get()) {
+    Reject("native QK RMSNorm/RoPE scope or return is invalid",
+           &function->span_);
+  }
