+  // Runtime-free Cubin validation already binds each KPARAM ordinal to its
+  // signature width. The Driver may enumerate metadata records in another
+  // order, so this live check validates the complete width multiset instead of
+  // imposing a second, undocumented enumeration-order contract.
+  std::vector<uint64_t> sorted_expected_widths = expected_widths;
+  std::sort(sorted_expected_widths.begin(), sorted_expected_widths.end());
+  std::sort(actual_widths.begin(), actual_widths.end());
+  if (actual_widths != sorted_expected_widths) {
+    throw RuntimeError(
+        "loaded CUDA function parameter width multiset differs from Artifact ABI");
+  }
   std::sort(ranges.begin(), ranges.end(),
