From fcae95f5eb805e00f66b3150e7b1874a1712cf7c Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Sat, 29 Aug 2026 17:04:19 +0800
Subject: [PATCH 243/263] Use canonical batched GDN output transpose

---
 .../nvidia_typed_tensor_ir_builder.cpp        | 96 ++++---------------
 1 file changed, 21 insertions(+), 75 deletions(-)

diff --git a/src/compiler/nvidia_typed_tensor_ir_builder.cpp b/src/compiler/nvidia_typed_tensor_ir_builder.cpp
index 0239a6de40659f5e5173a1c3fe311e82ad0cfbc0..6ffefe69f3ba71164286fc2d35ba4eab9dea01e1 100644
--- a/src/compiler/nvidia_typed_tensor_ir_builder.cpp
+++ b/src/compiler/nvidia_typed_tensor_ir_builder.cpp
@@ -824,33 +824,16 @@ class NativeGdnRecurrentBuilder {
         {1, 1, spec_.value_heads, spec_.value_dim});
     const auto parameter_group_type = wide_value_group_type;
     const auto dt_parameter_group_type = value_group_type;
-    const auto head_state_box_type = Tensor(
+    const auto state_transposed_type = Tensor(
         TypedTensorIrElementType::FP32,
-        {1, 1, spec_.value_dim, spec_.key_dim});
-    const auto head_state_type = Tensor(
+        {spec_.query_heads, heads_per_query, spec_.key_dim,
+         spec_.value_dim});
+    const auto output_group_type = Tensor(
         TypedTensorIrElementType::FP32,
-        {spec_.value_dim, spec_.key_dim});
-    const auto head_query_box_type = Tensor(
-        TypedTensorIrElementType::FP32,
-        {1, 1, 1, spec_.key_dim});
-    const auto head_query_type = Tensor(
-        TypedTensorIrElementType::FP32,
-        {1, spec_.key_dim});
-    const auto head_query_column_type = Tensor(
-        TypedTensorIrElementType::FP32,
-        {spec_.key_dim, 1});
-    const auto head_output_type = Tensor(
-        TypedTensorIrElementType::FP32,
-        {spec_.value_dim, 1});
-    const auto head_output_bf16_type = Tensor(
+        {spec_.query_heads, heads_per_query, 1, spec_.value_dim});
+    const auto output_group_bf16_type = Tensor(
         TypedTensorIrElementType::BF16,
-        {spec_.value_dim, 1});
-    const auto head_row_type = Tensor(
-        TypedTensorIrElementType::BF16,
-        {1, spec_.value_dim});
-    const auto all_heads_type = Tensor(
-        TypedTensorIrElementType::BF16,
-        {spec_.value_heads, spec_.value_dim});
+        {spec_.query_heads, heads_per_query, 1, spec_.value_dim});
     const auto output_box_type = Tensor(
         TypedTensorIrElementType::BF16,
         {1, 1, spec_.value_heads, spec_.value_dim});
@@ -994,11 +977,8 @@ class NativeGdnRecurrentBuilder {
 
         if (token + 1 != spec_.tokens_per_request) {
           token_outputs.push_back(BuildOutput(
-              scaled_query, current_state, head_state_box_type,
-              head_state_type, head_query_box_type, head_query_type,
-              head_query_column_type, head_output_type,
-              head_output_bf16_type, head_row_type, all_heads_type,
-              output_box_type));
+              scaled_query, current_state, state_transposed_type,
+              output_group_type, output_group_bf16_type, output_box_type));
         }
       }
 
@@ -1009,11 +989,8 @@ class NativeGdnRecurrentBuilder {
               .getOutput();
       const mlir::Value stored_group = Reshape(stored_state, state_group_type);
       const mlir::Value final_output = BuildOutput(
-          final_scaled_query, stored_group, head_state_box_type,
-          head_state_type, head_query_box_type, head_query_type,
-          head_query_column_type, head_output_type,
-          head_output_bf16_type, head_row_type, all_heads_type,
-          output_box_type);
+          final_scaled_query, stored_group, state_transposed_type,
+          output_group_type, output_group_bf16_type, output_box_type);
       token_outputs.push_back(final_output);
 
       if (token_outputs.size() == 1) {
@@ -1129,48 +1106,17 @@ class NativeGdnRecurrentBuilder {
 
   mlir::Value BuildOutput(
       mlir::Value scaled_query, mlir::Value state,
-      mlir::RankedTensorType head_state_box_type,
-      mlir::RankedTensorType head_state_type,
-      mlir::RankedTensorType head_query_box_type,
-      mlir::RankedTensorType head_query_type,
-      mlir::RankedTensorType head_query_column_type,
-      mlir::RankedTensorType head_output_type,
-      mlir::RankedTensorType head_output_bf16_type,
-      mlir::RankedTensorType head_row_type,
-      mlir::RankedTensorType all_heads_type,
+      mlir::RankedTensorType state_transposed_type,
+      mlir::RankedTensorType output_group_type,
+      mlir::RankedTensorType output_group_bf16_type,
       mlir::RankedTensorType output_box_type) {
-    llvm::SmallVector<mlir::Value> rows;
-    rows.reserve(static_cast<size_t>(spec_.value_heads));
-    for (int64_t value_head = 0; value_head < spec_.value_heads;
-         ++value_head) {
-      const int64_t query_head = value_head /
-                                 (spec_.value_heads / spec_.query_heads);
-      const int64_t group = value_head %
-                            (spec_.value_heads / spec_.query_heads);
-      const mlir::Value state_box = Slice(
-          state, head_state_box_type,
-          {query_head, group, 0, 0},
-          {query_head + 1, group + 1, spec_.value_dim, spec_.key_dim},
-          {1, 1, 1, 1});
-      const mlir::Value state_head = Reshape(state_box, head_state_type);
-      const mlir::Value query_box = Slice(
-          scaled_query, head_query_box_type,
-          {query_head, group, 0, 0},
-          {query_head + 1, group + 1, 1, spec_.key_dim},
-          {1, 1, 1, 1});
-      const mlir::Value query_head_value =
-          Reshape(query_box, head_query_type);
-      const mlir::Value query_column =
-          Reshape(query_head_value, head_query_column_type);
-      const mlir::Value output_column =
-          Matmul(state_head, query_column, head_output_type);
-      const mlir::Value output_bf16 =
-          Convert(output_column, head_output_bf16_type);
-      rows.push_back(Reshape(output_bf16, head_row_type));
-    }
-    const mlir::Value all_heads =
-        Concatenate(rows, all_heads_type, /*dimension=*/0);
-    return Reshape(all_heads, output_box_type);
+    const mlir::Value state_transposed =
+        Transpose(state, state_transposed_type, {0, 1, 3, 2});
+    const mlir::Value output_wide =
+        Matmul(scaled_query, state_transposed, output_group_type);
+    const mlir::Value output =
+        Convert(output_wide, output_group_bf16_type);
+    return Reshape(output, output_box_type);
   }
 
   mlir::OpBuilder& builder_;
