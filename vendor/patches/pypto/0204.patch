diff --git a/tests/ut/jit/test_specializer.py b/tests/ut/jit/test_specializer.py
index cd820dad6b9c747d97da29b2ff6d32d1acb056b2..37b294390b42afa5fa881ca78a14dafb83fc9c75 100644
--- a/tests/ut/jit/test_specializer.py
+++ b/tests/ut/jit/test_specializer.py
@@ -511,6 +511,26 @@ class TestBodyTransformer:
         # Substitution happens in the body; parameter name stays in the signature
         assert "pl.load(a, [0], [64])" in out
 
+    def test_static_tensor_shape_condition_selects_only_reachable_branch(self):
+        src = """
+            def f(a: pl.Tensor):
+                if a.shape[0] % 128 == 0:
+                    tile = 128
+                elif a.shape[0] % 32 == 0:
+                    tile = 32
+                else:
+                    tile = 16
+                result = tile
+        """
+        out = self._transform(
+            src,
+            tensor_meta={"a": TensorMeta((32, 1024), DataType.FP32)},
+        )
+        assert "if " not in out
+        assert "tile = 32" in out
+        assert "tile = 128" not in out
+        assert "tile = 16" not in out
+
     def _transform_with_globals(self, src: str, tensor_meta: dict, py_globals: dict):
         src = textwrap.dedent(src)
         tree = ast.parse(src)
