diff --git a/python/pypto/jit/specializer.py b/python/pypto/jit/specializer.py
index 7a1fc01724b3fe2a23ffb7d76d42fb00910140df..5b5bc7bada95f993fc536719a6cfd21e6defa8c7 100644
--- a/python/pypto/jit/specializer.py
+++ b/python/pypto/jit/specializer.py
@@ -38,6 +38,7 @@ import ast
 import copy
 import functools
 import inspect
+import operator
 import textwrap
 import warnings
 from dataclasses import dataclass, field
@@ -501,6 +502,88 @@ def _build_tensor_annotation(
 # ---------------------------------------------------------------------------
 
 
+_NOT_STATIC = object()
+_STATIC_UNARY_OPERATORS = {
+    ast.Not: operator.not_,
+    ast.UAdd: operator.pos,
+    ast.USub: operator.neg,
+}
+_STATIC_BINARY_OPERATORS = {
+    ast.Add: operator.add,
+    ast.Sub: operator.sub,
+    ast.Mult: operator.mul,
+    ast.FloorDiv: operator.floordiv,
+    ast.Mod: operator.mod,
+}
+_STATIC_BOOLEAN_OPERATORS = {
+    ast.And: all,
+    ast.Or: any,
+}
+_STATIC_COMPARISON_OPERATORS = {
+    ast.Eq: operator.eq,
+    ast.NotEq: operator.ne,
+    ast.Lt: operator.lt,
+    ast.LtE: operator.le,
+    ast.Gt: operator.gt,
+    ast.GtE: operator.ge,
+}
+
+
+def _evaluate_static_expression(node: ast.expr) -> object:
+    """Evaluate the safe literal subset used by shape-specialized branches."""
+
+    if isinstance(node, ast.Constant) and type(node.value) in (bool, int, float):
+        return node.value
+    if isinstance(node, ast.UnaryOp):
+        operand = _evaluate_static_expression(node.operand)
+        if operand is _NOT_STATIC:
+            return _NOT_STATIC
+        operation = _STATIC_UNARY_OPERATORS.get(type(node.op))
+        try:
+            return _NOT_STATIC if operation is None else operation(operand)
+        except TypeError:
+            return _NOT_STATIC
+    if isinstance(node, ast.BinOp):
+        left = _evaluate_static_expression(node.left)
+        right = _evaluate_static_expression(node.right)
+        if left is _NOT_STATIC or right is _NOT_STATIC:
+            return _NOT_STATIC
+        operation = _STATIC_BINARY_OPERATORS.get(type(node.op))
+        try:
+            return _NOT_STATIC if operation is None else operation(left, right)
+        except (TypeError, ZeroDivisionError):
+            return _NOT_STATIC
+    if isinstance(node, ast.BoolOp):
+        values = [_evaluate_static_expression(value) for value in node.values]
+        if any(value is _NOT_STATIC for value in values):
+            return _NOT_STATIC
+        operation = _STATIC_BOOLEAN_OPERATORS.get(type(node.op))
+        return (
+            _NOT_STATIC
+            if operation is None
+            else operation(bool(value) for value in values)
+        )
+    if isinstance(node, ast.Compare):
+        values = [
+            _evaluate_static_expression(node.left),
+            *(_evaluate_static_expression(value) for value in node.comparators),
+        ]
+        if any(value is _NOT_STATIC for value in values):
+            return _NOT_STATIC
+        for left, op, right in zip(values[:-1], node.ops, values[1:], strict=True):
+            operation = _STATIC_COMPARISON_OPERATORS.get(type(op))
+            if operation is None:
+                return _NOT_STATIC
+            try:
+                result = operation(left, right)
+            except TypeError:
+                return _NOT_STATIC
+            if not bool(result):
+                return False
+        return True
+    return _NOT_STATIC
+
+
 class _BodyTransformer(ast.NodeTransformer):
     """Rewrites a JIT function body for use inside @pl.program.
 
@@ -1119,7 +1202,7 @@ class _BodyTransformer(ast.NodeTransformer):
             return bridges + [node]
         return node
 
-    def visit_If(self, node: ast.If) -> ast.stmt:
+    def visit_If(self, node: ast.If) -> ast.stmt | list[ast.stmt] | None:
         """Visit If; treat the two branches as mutually-exclusive sibling scopes.
 
         A name first-assigned inside the then-branch is branch-local: the
@@ -1135,6 +1218,11 @@ class _BodyTransformer(ast.NodeTransformer):
         (``exit_scope(leak_vars=True)``) and ConvertToSSA, as for ``@pl.program``.
         """
         node.test = self.visit(node.test)
+        static_test = _evaluate_static_expression(node.test)
+        if type(static_test) is bool:
+            selected = node.body if static_test else node.orelse
+            visited = self._visit_scoped_body(selected)
+            return visited or None
         self._scope_depth += 1
         before = set(self._assign_count)
         node.body = self._visit_scoped_body(node.body)
