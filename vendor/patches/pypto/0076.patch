+ir::ProgramPtr MakeFusedRmsNormProgram() {
+  auto full_type = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{8, 16}, DataType::BF16,
+      std::optional<ir::MemRefPtr>{});
+  auto row_type = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{8, 1}, DataType::BF16,
+      std::optional<ir::MemRefPtr>{});
+  auto x = std::make_shared<ir::Var>("x", full_type, TestSpan());
+  auto square = std::make_shared<ir::Var>("square", full_type, TestSpan());
+  auto sum = std::make_shared<ir::Var>("sum", row_type, TestSpan());
+  auto mean = std::make_shared<ir::Var>("mean", row_type, TestSpan());
+  auto shifted = std::make_shared<ir::Var>("shifted", row_type, TestSpan());
+  auto inverse = std::make_shared<ir::Var>("inverse", row_type, TestSpan());
+  auto result = std::make_shared<ir::Var>("result", full_type, TestSpan());
+  const auto call = [](const std::string& name,
+                       const std::vector<ir::ExprPtr>& arguments,
+                       const ir::TypePtr& type) {
+    return std::make_shared<ir::Call>(
+        ir::OpRegistry::GetInstance().GetOp(name), arguments,
+        std::vector<std::pair<std::string, std::any>>{},
+        std::vector<std::pair<std::string, std::any>>{}, type, TestSpan());
+  };
+  auto body = std::make_shared<ir::SeqStmts>(
+      std::vector<ir::StmtPtr>{
+          std::make_shared<ir::AssignStmt>(
+              square, call("tensor.mul", {x, x}, full_type), TestSpan()),
+          std::make_shared<ir::AssignStmt>(
+              sum, call("tensor.row_sum", {square}, row_type), TestSpan()),
+          std::make_shared<ir::AssignStmt>(
+              mean,
+              call("tensor.muls",
+                   {sum, std::make_shared<ir::ConstFloat>(
+                             1.0 / 16.0, DataType::BF16, TestSpan())},
+                   row_type),
+              TestSpan()),
+          std::make_shared<ir::AssignStmt>(
+              shifted,
+              call("tensor.adds",
+                   {mean, std::make_shared<ir::ConstFloat>(
+                              1.0e-6, DataType::BF16, TestSpan())},
+                   row_type),
+              TestSpan()),
+          std::make_shared<ir::AssignStmt>(
+              inverse, call("tensor.rsqrt", {shifted}, row_type), TestSpan()),
+          std::make_shared<ir::AssignStmt>(
+              result, call("tensor.row_expand_mul", {x, inverse}, full_type),
+              TestSpan()),
+          std::make_shared<ir::ReturnStmt>(
+              std::vector<ir::ExprPtr>{result}, TestSpan())},
+      TestSpan());
+  auto function = std::make_shared<ir::Function>(
+      "ignored", std::vector<ir::VarPtr>{x},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{full_type}, body, TestSpan());
+  return std::make_shared<ir::Program>(
+      std::vector<ir::FunctionPtr>{function}, "test", TestSpan());
+}
