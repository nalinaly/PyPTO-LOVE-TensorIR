+int TestFusedRmsNormBf16Source() {
+  auto full_type = PlainTensor({4, 8}, DataType::BF16);
+  auto row_type = PlainTensor({4, 1}, DataType::BF16);
+  auto x = std::make_shared<ir::Var>("x", full_type, TestSpan());
+  auto square = std::make_shared<ir::Var>("square", full_type, TestSpan());
+  auto sum = std::make_shared<ir::Var>("sum", row_type, TestSpan());
+  auto mean = std::make_shared<ir::Var>("mean", row_type, TestSpan());
+  auto shifted = std::make_shared<ir::Var>("shifted", row_type, TestSpan());
+  auto inverse = std::make_shared<ir::Var>("inverse", row_type, TestSpan());
+  auto result = std::make_shared<ir::Var>("result", full_type, TestSpan());
+  auto scale = std::make_shared<ir::ConstFloat>(1.0 / 8.0, DataType::BF16,
+                                                TestSpan());
+  auto epsilon =
+      std::make_shared<ir::ConstFloat>(1.0e-6, DataType::BF16, TestSpan());
+  auto program = MakeProgram(
+      "ignored_rmsnorm", {x}, {ir::ParamDirection::In}, {full_type},
+      {std::make_shared<ir::AssignStmt>(
+           square, OpCall("tensor.mul", {x, x}, full_type), TestSpan()),
+       std::make_shared<ir::AssignStmt>(
+           sum, OpCall("tensor.row_sum", {square}, row_type), TestSpan()),
+       std::make_shared<ir::AssignStmt>(
+           mean, OpCall("tensor.muls", {sum, scale}, row_type), TestSpan()),
+       std::make_shared<ir::AssignStmt>(
+           shifted, OpCall("tensor.adds", {mean, epsilon}, row_type),
+           TestSpan()),
+       std::make_shared<ir::AssignStmt>(
+           inverse, OpCall("tensor.rsqrt", {shifted}, row_type), TestSpan()),
+       std::make_shared<ir::AssignStmt>(
+           result, OpCall("tensor.row_expand_mul", {x, inverse}, full_type),
+           TestSpan()),
+       std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result},
+                                        TestSpan())});
+  const TensorIrModule module = EmitTensorIr(program);
+  REQUIRE(module.GetKind() == TensorIrModuleKind::FusedPointwiseV2);
+  REQUIRE(module.GetValueMetadata().size() == 2);
+  REQUIRE(module.GetValueMetadata()[0].GetDtypeCode() == DataType::BF16.Code());
+  REQUIRE(module.GetValueMetadata()[0].GetShape() ==
+          std::vector<int64_t>({4, 8}));
+  const std::string& source = module.GetCanonicalSource();
+  REQUIRE(source.find("%wide0 = convert %arg0 : tensor<4x8xbf16> -> "
+                      "tensor<4x8xf32>") != std::string::npos);
+  REQUIRE(source.find("%square0 = mul %wide0, %wide0 : tensor<4x8xf32>") !=
+          std::string::npos);
+  REQUIRE(source.find("%reduce0 = reduce(%square0)") != std::string::npos);
+  REQUIRE(source.find("%bcast0 = broadcast") != std::string::npos);
+  REQUIRE(source.find("%result0 = convert %scaled0 : tensor<4x8xf32> -> "
+                      "tensor<4x8xbf16>") != std::string::npos);
+  return 0;
+}
