+#include <cstdlib>
+#include <cstdint>
+#include <string>
+
+#include "tensor_ir/Compiler/CudaTile/CudaTileArtifact.h"
+#include "tensor_ir/Compiler/CudaTile/CudaTileCompiler.h"
+#include "tensor_ir/Runtime/CudaTile/CudaTileRuntimeKernel.h"
+#include "tensor_ir/Utils/ComputeCapability.h"
+
+using mlir::nv_tensor_ir::ArchPortability;
+using mlir::nv_tensor_ir::ICompiler;
+using mlir::nv_tensor_ir::SmTarget;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileArgumentPackingPolicy;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileArtifactKind;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileCompileOptions;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileCompiledArtifact;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileCompiler;
+using mlir::nv_tensor_ir::backend::cuda_tile::CudaTileGridPolicy;
+using mlir::nv_tensor_ir::backend::cuda_tile::detectCudaTileArtifactKind;
+using tensor_ir::rt::CudaTileRuntimeKernel;
+
+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+namespace {
+
+constexpr char kAddSource[] = R"mlir(
+module {
+  nv_tensor_ir.graph @add_op_simple(
+    %a: tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"},
+    %b: tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"}
+  ) -> (tensor<8x8xf32> {nv_tensor_ir.stride = "(8,1)"}) {
+    %add = add %a, %b : tensor<8x8xf32>
+    results %add : tensor<8x8xf32>
+  }
+}
+)mlir";
+
+constexpr char kDynamicAddSource[] = R"mlir(
+module {
+  nv_tensor_ir.graph @add_dynamic_shape(
+    %a: tensor<?x?xf32> {nv_tensor_ir.stride = "(?,1)"},
+    %b: tensor<?x?xf32> {nv_tensor_ir.stride = "(?,1)"}
+  ) -> (tensor<?x?xf32> {nv_tensor_ir.stride = "(?,1)"}) {
+    %add = add %a, %b : tensor<?x?xf32>
+    results %add : tensor<?x?xf32>
+  }
+}
+)mlir";
+
+CudaTileCompileOptions StrictOptions(const SmTarget &target,
+                                     CudaTileArtifactKind kind) {
+  CudaTileCompileOptions options(target);
+  options.tileSize = {64};
+  options.maxTileCandidates = 0;
+  options.allowEnvironmentOverrides = false;
+  options.allowArtifactFallback = false;
+  options.artifactKind = kind;
+  if (kind == CudaTileArtifactKind::Cubin) {
+    options.tileIRAssemblerPath = PYPTO_TILEIRAS_REAL_PATH;
+  }
+  return options;
+}
+
+int TestStrictOptionValidation(const SmTarget &target) {
+  CudaTileCompileOptions options =
+      StrictOptions(target, CudaTileArtifactKind::Cubin);
+  REQUIRE(options.validate().ok());
+  REQUIRE(options.toUniqueString().find(PYPTO_TILEIRAS_REAL_PATH) !=
+          std::string::npos);
+
+  options.tileIRAssemblerPath.clear();
+  REQUIRE(!options.validate().ok());
+  options.tileIRAssemblerPath = "relative/tileiras";
+  REQUIRE(!options.validate().ok());
+
+  options = StrictOptions(target, CudaTileArtifactKind::TileIR);
+  options.irDebug.loadTileIRBCPath = "/tmp/untrusted.tileir";
+  REQUIRE(!options.validate().ok());
+  options.irDebug.loadTileIRBCPath.clear();
+  options.tileSize.clear();
+  REQUIRE(!options.validate().ok());
+  return 0;
+}
+
+int TestTileIRArtifact(const SmTarget &target) {
+  CudaTileCompiler compiler;
+  CudaTileCompileOptions options =
+      StrictOptions(target, CudaTileArtifactKind::TileIR);
+  auto artifact = compiler.compileToArtifact(kAddSource, options);
+  REQUIRE(artifact.ok());
+  REQUIRE(artifact->validate().ok());
+  REQUIRE(artifact->schemaVersion == CudaTileCompiledArtifact::kSchemaVersion);
+  REQUIRE(artifact->requestedArtifactKind == CudaTileArtifactKind::TileIR);
+  REQUIRE(artifact->actualArtifactKind == CudaTileArtifactKind::TileIR);
+  REQUIRE(!artifact->usedArtifactFallback());
+  REQUIRE(artifact->requestedTarget.toString() == "sm_120a");
+  REQUIRE(artifact->actualTarget.toString() == "sm_120a");
+  REQUIRE(!artifact->runtimeKernelName.empty());
+  REQUIRE(!artifact->entryFunctionName.empty());
+  REQUIRE(artifact->argumentPackingPolicy ==
+          CudaTileArgumentPackingPolicy::PointerOnly);
+  REQUIRE(artifact->gridPolicy == CudaTileGridPolicy::Static);
+  REQUIRE(artifact->staticGrid[0] == 1);
+  REQUIRE(artifact->staticGrid[1] == 1);
+  REQUIRE(artifact->staticGrid[2] == 1);
+  REQUIRE(artifact->argLayout.tensorDescs.size() == 3);
+  REQUIRE(artifact->argLayout.numInputs == 2);
+  REQUIRE(artifact->argLayout.totalKernelArgs == 3);
+  REQUIRE(!artifact->environmentOverridesEnabled);
+  REQUIRE(!artifact->artifactFallbackAllowed);
+  REQUIRE(artifact->tileIRAssemblerPath.empty());
+
+  auto detected = detectCudaTileArtifactKind(artifact->deviceCode);
+  REQUIRE(detected.ok());
+  REQUIRE(*detected == CudaTileArtifactKind::TileIR);
+
+  CudaTileCompiledArtifact invalid = *artifact;
+  invalid.actualArtifactKind = CudaTileArtifactKind::Cubin;
+  REQUIRE(!invalid.validate().ok());
+  invalid = *artifact;
+  invalid.workspaceAlignmentBytes = 3;
+  REQUIRE(!invalid.validate().ok());
+
+  auto runtimeKernel =
+      static_cast<ICompiler &>(compiler).compile(kAddSource, options);
+  REQUIRE(runtimeKernel.ok());
+  auto *cudaTileRuntime =
+      static_cast<CudaTileRuntimeKernel *>(runtimeKernel->get());
+  REQUIRE(cudaTileRuntime->name() == artifact->runtimeKernelName);
+  REQUIRE(cudaTileRuntime->funcName() == artifact->entryFunctionName);
+  REQUIRE(cudaTileRuntime->deviceCode() ==
+          llvm::ArrayRef<char>(artifact->deviceCode));
+  return 0;
+}
+
+int TestDeterministicCubinArtifact(const SmTarget &target) {
+  CudaTileCompiler compiler;
+  CudaTileCompileOptions options =
+      StrictOptions(target, CudaTileArtifactKind::Cubin);
+  auto first = compiler.compileToArtifact(kAddSource, options);
+  REQUIRE(first.ok());
+  REQUIRE(first->validate().ok());
+  REQUIRE(first->requestedArtifactKind == CudaTileArtifactKind::Cubin);
+  REQUIRE(first->actualArtifactKind == CudaTileArtifactKind::Cubin);
+  REQUIRE(!first->usedArtifactFallback());
+  REQUIRE(first->tileIRAssemblerPath == PYPTO_TILEIRAS_REAL_PATH);
+
+  auto detected = detectCudaTileArtifactKind(first->deviceCode);
+  REQUIRE(detected.ok());
+  REQUIRE(*detected == CudaTileArtifactKind::Cubin);
+
+  REQUIRE(setenv("TENSOR_IR_CODEGEN_STRATEGY", "affine-map", 1) == 0);
+  REQUIRE(setenv("TENSOR_IR_MAX_TILE_CANDIDATES", "99", 1) == 0);
+  REQUIRE(setenv("TENSOR_IR_LOAD_TILEIR_BC", "/does/not/exist", 1) == 0);
+  auto second = compiler.compileToArtifact(kAddSource, options);
+  REQUIRE(unsetenv("TENSOR_IR_CODEGEN_STRATEGY") == 0);
+  REQUIRE(unsetenv("TENSOR_IR_MAX_TILE_CANDIDATES") == 0);
+  REQUIRE(unsetenv("TENSOR_IR_LOAD_TILEIR_BC") == 0);
+  REQUIRE(second.ok());
+  REQUIRE(second->validate().ok());
+  REQUIRE(first->deviceCode == second->deviceCode);
+  REQUIRE(first->compileOptionsIdentity == second->compileOptionsIdentity);
+  REQUIRE(first->runtimeKernelName == second->runtimeKernelName);
+  REQUIRE(first->entryFunctionName == second->entryFunctionName);
+  REQUIRE(first->staticGrid == second->staticGrid);
+
+  options.tileIRAssemblerPath = "/does/not/exist/tileiras";
+  auto noFallback = compiler.compileToArtifact(kAddSource, options);
+  REQUIRE(!noFallback.ok());
+
+  options.allowArtifactFallback = true;
+  auto fallback = compiler.compileToArtifact(kAddSource, options);
+  REQUIRE(fallback.ok());
+  REQUIRE(fallback->validate().ok());
+  REQUIRE(fallback->requestedArtifactKind == CudaTileArtifactKind::Cubin);
+  REQUIRE(fallback->actualArtifactKind == CudaTileArtifactKind::TileIR);
+  REQUIRE(fallback->usedArtifactFallback());
+  return 0;
+}
+
+int TestDynamicArtifactMetadata(const SmTarget &target) {
+  CudaTileCompiler compiler;
+  CudaTileCompileOptions options =
+      StrictOptions(target, CudaTileArtifactKind::TileIR);
+  options.tileSize = {8, 8};
+  auto artifact = compiler.compileToArtifact(kDynamicAddSource, options);
+  REQUIRE(artifact.ok());
+  REQUIRE(artifact->validate().ok());
+  REQUIRE(artifact->argumentPackingPolicy ==
+          CudaTileArgumentPackingPolicy::Flat);
+  REQUIRE(artifact->gridPolicy == CudaTileGridPolicy::TileBasedRuntime);
+  REQUIRE(artifact->argLayout.tensorDescs.size() == 3);
+  REQUIRE(artifact->argLayout.numInputs == 2);
+  REQUIRE(artifact->argLayout.totalKernelArgs == 12);
+  REQUIRE(artifact->argLayout.gridShapeTensorIdx == 0);
+  REQUIRE(artifact->argLayout.tileSizes.size() == 2);
+  for (const auto &desc : artifact->argLayout.tensorDescs) {
+    REQUIRE(desc.rank == 2);
+    REQUIRE(desc.numDynSizes == 2);
+    REQUIRE(desc.numDynStrides == 1);
+    REQUIRE(desc.hasExplicitStrides);
+  }
+  return 0;
+}
+
+}  // namespace
+
+int main() {
+  auto target = SmTarget::fromCc(120, ArchPortability::arch_conditional);
+  REQUIRE(mlir::succeeded(target));
+
+  int result = TestStrictOptionValidation(*target);
+  if (result != 0) return result;
+  result = TestTileIRArtifact(*target);
+  if (result != 0) return result;
+  result = TestDynamicArtifactMetadata(*target);
+  if (result != 0) return result;
+  return TestDeterministicCubinArtifact(*target);
+}
