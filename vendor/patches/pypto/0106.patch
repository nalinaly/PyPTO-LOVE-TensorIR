+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype, graph.result.shape,
+        graph.result.dense_strides, graph.result.shape.size() >= 2));
+    return TensorIrModule(TensorIrModuleKind::RowReductionV3,
+                          EmitRowReductionSource(graph), std::move(metadata),
+                          /*input_count=*/1);
+  }
   if (IsNativeTileCausalConvCandidate(program)) {
     const NativeTileCausalConvGraph graph = AnalyzeNativeTileCausalConv(program);
     std::vector<TensorIrValueMetadata> metadata;
