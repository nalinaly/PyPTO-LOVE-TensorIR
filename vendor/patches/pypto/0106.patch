+@pl.jit
+def _native_tile_row_sum(
+    x: pl.Tensor[[256, 128], pl.FP32],
+    out: pl.Out[pl.Tensor[[256, 1], pl.FP32]],
+):
+    with pl.at(level=pl.Level.CORE_GROUP):
+        for row in pl.range(256):
+            x_tile = pl.load(x, [row, 0], [1, 128])
+            scratch = pl.create_tile(
+                [1, 128], dtype=pl.FP32, target_memory=pl.MemorySpace.Vec
+            )
+            result = pl.row_sum(x_tile, scratch)
+            pl.store(result, [row, 0], out)
+    return out
+
