     const ir::ProgramPtr& program, StaticTensor& input_out,
     std::vector<RowReductionEpilogueStep>& steps_out) {
@@ -5189,6 +5306,20 @@ TensorIrModule EmitLegacyStaticAddV1(const ir::ProgramPtr& program) {
