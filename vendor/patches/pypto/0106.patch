+bool IsNativeTileRowReductionCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 2) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const TileLoopNest loopNest = UnwrapStaticTileLoops(scope->body_);
+  if (!loopNest.leaf || loopNest.leaf->stmts_.size() != 4) return false;
+  const auto assignment = ir::As<ir::AssignStmt>(loopNest.leaf->stmts_[2]);
+  const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+  return call && call->op_ &&
+         (ir::IsOp(call, "tile.row_sum") || ir::IsOp(call, "tile.row_max"));
+}
+
+RowReductionGraph AnalyzeNativeTileRowReduction(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native row reduction must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 2 ||
+      function->param_directions_.size() != 2 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native row reduction requires one input and one output",
+           &function->span_);
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native row reduction input");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native row reduction output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native row reduction return");
+  StaticTensor expected = input;
+  expected.shape.back() = 1;
+  expected.dense_strides = MakeDenseStridesForMetadata(expected.shape);
+  if (!SameTensor(result, expected) || !SameTensor(declared, expected)) {
+    Reject("native row reduction output must keep rank and set the last extent to one",
+           &function->span_);
+  }
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returnedVar =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returnedVar ||
+      returnedVar.get() != function->params_[1].get()) {
+    Reject("native row reduction scope or return is invalid", &function->span_);
+  }
+  int64_t rows = 1;
+  for (size_t index = 0; index + 1 < input.shape.size(); ++index) {
+    rows *= input.shape[index];
+  }
+  const TileLoopNest loopNest = UnwrapStaticTileLoops(scope->body_);
+  if (loopNest.repetitions != static_cast<uint64_t>(rows) ||
+      !loopNest.leaf || loopNest.leaf->stmts_.size() != 4) {
+    Reject("native row reduction loops must cover every outer row once",
+           &scope->span_);
+  }
+  std::array<ir::AssignStmtPtr, 3> assignments;
+  std::array<ir::CallPtr, 3> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loopNest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+  }
+  if (!calls[0] || !ir::IsOp(calls[0], "tile.load") || !calls[1] ||
+      !ir::IsOp(calls[1], "tile.create") || !calls[2] ||
+      !(ir::IsOp(calls[2], "tile.row_sum") ||
+        ir::IsOp(calls[2], "tile.row_max"))) {
+    Reject("native row reduction tile sequence is invalid", &scope->span_);
+  }
+  const auto requireVar = [&](const ir::CallPtr& call, size_t index,
+                              const ir::VarPtr& expectedVar) {
+    const auto value = index < call->args_.size()
+                           ? ir::As<ir::Var>(call->args_[index])
+                           : nullptr;
+    return value && value.get() == expectedVar.get();
+  };
+  if (!requireVar(calls[0], 0, function->params_[0]) ||
+      !requireVar(calls[2], 0, assignments[0]->var_) ||
+      !requireVar(calls[2], 1, assignments[1]->var_)) {
+    Reject("native row reduction dataflow is invalid", &scope->span_);
+  }
+  const auto store = ir::As<ir::EvalStmt>(loopNest.leaf->stmts_.back());
+  const auto storeCall = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  if (!storeCall || !ir::IsOp(storeCall, "tile.store") ||
+      !requireVar(storeCall, 0, assignments[2]->var_) ||
+      !requireVar(storeCall, 2, function->params_[1])) {
+    Reject("native row reduction store is invalid", &scope->span_);
+  }
+  return RowReductionGraph{
+      input, result,
+      ir::IsOp(calls[2], "tile.row_sum") ? RowReductionMode::Sum
+                                          : RowReductionMode::Max,
+      rows};
+}
