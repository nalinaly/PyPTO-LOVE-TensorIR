+int TestStructuredMatmulV4ConceptualWorkBounds() {
+  constexpr int64_t kExtent = int64_t{1} << 16;
+  constexpr int64_t kOutputElements = kExtent * kExtent;
+  constexpr int64_t kLargestAlignedK =
+      (std::numeric_limits<int64_t>::max() / kOutputElements / 128) * 128;
+  constexpr int64_t kOverflowK = kLargestAlignedK + 128;
+  static_assert(kLargestAlignedK == 2147483520LL);
+  static_assert(kOverflowK == 2147483648LL);
+
+  const CompileRequest request = ValidRequest();
+  const auto boundary = PrepareStructuredTensorIrCompilation(
+      MakeStructuredMatmulProgram({kExtent, kLargestAlignedK},
+                                  {kLargestAlignedK, kExtent},
+                                  {kExtent, kExtent}),
+      request, ValidSchedule({512, 256}));
+  const KernelBuildSpec boundary_spec = FinalizeStructuredTensorIrBuildSpec(
+      boundary,
+      MakeKernelAbi(StructuredMatmulKernelOptions(
+          {kExtent, kLargestAlignedK}, {kLargestAlignedK, kExtent},
+          {kExtent, kExtent}, {512, 256}, 32768)));
+  REQUIRE(!boundary_spec.GetIdentityDigest().empty());
+
+  REQUIRE(RejectsPreparation(
+      [&] {
+        (void)PrepareStructuredTensorIrCompilation(
+            MakeStructuredMatmulProgram({kExtent, kOverflowK},
+                                        {kOverflowK, kExtent},
+                                        {kExtent, kExtent}),
+            request, ValidSchedule({512, 256}));
+      },
+      "conceptual work B*M*N*K exceeds the signed 64-bit bound for B=1, M=65536, N=65536, "
+      "K=2147483648"));
+  REQUIRE(RejectsPreparation(
+      [&] {
+        (void)PrepareStructuredTensorIrCompilation(
+            MakeStructuredMatmulProgram({2, kExtent, kOverflowK / 2},
+                                        {2, kOverflowK / 2, kExtent},
+                                        {2, kExtent, kExtent}),
+            request, ValidSchedule({1, 512, 256}));
+      },
+      "conceptual work B*M*N*K exceeds the signed 64-bit bound for B=2, M=65536, N=65536, "
+      "K=1073741824"));
+  return 0;
+}
