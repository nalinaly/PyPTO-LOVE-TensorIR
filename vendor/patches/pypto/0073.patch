+void ValidateStructuredMatmulConceptualWork(int64_t batch, int64_t m, int64_t n,
+                                            int64_t k, const ir::Span& span) {
+  const std::array<int64_t, 4> extents = {batch, m, n, k};
+  uint64_t product = 1;
+  constexpr uint64_t kMaximumConceptualWork =
+      static_cast<uint64_t>(std::numeric_limits<int64_t>::max());
+  for (int64_t extent : extents) {
+    if (extent <= 0) {
+      InternalReject("structured matmul conceptual-work extent is non-positive");
+    }
+    if (static_cast<uint64_t>(extent) > kMaximumConceptualWork / product) {
+      Reject("structured matmul conceptual work B*M*N*K exceeds the signed 64-bit bound for B=" +
+                 std::to_string(batch) + ", M=" + std::to_string(m) +
+                 ", N=" + std::to_string(n) + ", K=" + std::to_string(k),
+             &span);
+    }
+    product *= static_cast<uint64_t>(extent);
+  }
+}
