+std::string EmitNativeTileAttentionSource(
+    const NativeTileAttentionGraph& graph) {
+  StaticTensor key_transposed = graph.key;
+  std::swap(key_transposed.shape[0], key_transposed.shape[1]);
+  key_transposed.dense_strides =
+      MakeDenseStridesForMetadata(key_transposed.shape);
+  StaticTensor score{DataType::FP32,
+                     {graph.query.shape[0], graph.key.shape[0]}, {}};
+  score.dense_strides = MakeDenseStridesForMetadata(score.shape);
+  StaticTensor row = score;
+  row.shape[1] = 1;
+  row.dense_strides = {1, 1};
+  StaticTensor probability = score;
+  probability.dtype = DataType::BF16;
+  StaticTensor accumulation = graph.result;
+  accumulation.dtype = DataType::FP32;
+
+  const std::string query_type = TensorTypeText(graph.query);
+  const std::string key_type = TensorTypeText(graph.key);
+  const std::string key_transposed_type = TensorTypeText(key_transposed);
+  const std::string value_type = TensorTypeText(graph.value);
+  const std::string score_type = TensorTypeText(score);
+  const std::string row_type = TensorTypeText(row);
+  const std::string probability_type = TensorTypeText(probability);
+  const std::string accumulation_type = TensorTypeText(accumulation);
+  const std::string result_type = TensorTypeText(graph.result);
+
+  std::string source;
+  source.reserve(4096);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.key);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.value);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %kt = transpose %arg1 permutation = [1, 0] : ";
+  source += key_type;
+  source += " -> ";
+  source += key_transposed_type;
+  source += "\n    %scores = matmul(%arg0, %kt)\n      : (";
+  source += query_type;
+  source += ", ";
+  source += key_transposed_type;
+  source += ") -> ";
+  source += score_type;
+  source += "\n    %scale = constant ";
+  AppendFloat(source, graph.scale);
+  source += " : f32\n    %scale_splat = splat %scale : ";
+  source += score_type;
+  source += "\n    %scaled = mul %scores, %scale_splat : ";
+  source += score_type;
+  source += "\n    %rowmax = reduce(%scaled) <dimensions = [1], reduction_mode = <max>> : ";
+  source += score_type;
+  source += " -> ";
+  source += row_type;
+  source += "\n    %max_broadcast = broadcast %rowmax : ";
+  source += row_type;
+  source += " -> ";
+  source += score_type;
+  source += "\n    %centered = sub %scaled, %max_broadcast : ";
+  source += score_type;
+  source += "\n    %exponent = exp %centered : ";
+  source += score_type;
+  source += "\n    %rowsum = reduce(%exponent) <dimensions = [1], reduction_mode = <add>> : ";
+  source += score_type;
+  source += " -> ";
+  source += row_type;
+  source += "\n    %inverse = reciprocal %rowsum : ";
+  source += row_type;
+  source += "\n    %inverse_broadcast = broadcast %inverse : ";
+  source += row_type;
+  source += " -> ";
+  source += score_type;
+  source += "\n    %probability_f32 = mul %exponent, %inverse_broadcast : ";
+  source += score_type;
+  source += "\n    %probability = convert %probability_f32 : ";
+  source += score_type;
+  source += " -> ";
+  source += probability_type;
+  source += "\n    %mixed = matmul(%probability, %arg2)\n      : (";
+  source += probability_type;
+  source += ", ";
+  source += value_type;
+  source += ") -> ";
+  source += accumulation_type;
+  source += "\n    %result0 = convert %mixed : ";
+  source += accumulation_type;
+  source += " -> ";
+  source += result_type;
+  source += "\n    results %result0 : ";
+  source += result_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
