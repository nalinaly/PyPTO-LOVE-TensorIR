+struct NativeTileAttentionGraph {
+  StaticTensor query;
+  StaticTensor key;
+  StaticTensor value;
+  StaticTensor result;
+  double scale;
+};
+
+bool IsNativeTileAttentionCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 5) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto body = ir::As<ir::SeqStmts>(scope->body_);
+  if (!body || body->stmts_.size() != 4) return false;
+  const auto transpose_assignment = ir::As<ir::AssignStmt>(body->stmts_[2]);
+  const auto transpose_call =
+      transpose_assignment
+          ? ir::As<ir::Call>(transpose_assignment->value_)
+          : nullptr;
+  return transpose_call && ir::IsOp(transpose_call, "tile.transpose_view") &&
+         ir::As<ir::ForStmt>(body->stmts_[3]) != nullptr;
+}
+
+NativeTileAttentionGraph AnalyzeNativeTileAttention(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native attention must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 5 ||
+      function->param_directions_.size() != 5 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::In ||
+      function->param_directions_[3] != ir::ParamDirection::In ||
+      function->param_directions_[4] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native attention requires Q, K, V, scale and one output",
+           &function->span_);
+  }
+  const StaticTensor query = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native attention query");
+  const StaticTensor key = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native attention key");
+  const StaticTensor value = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native attention value");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[4]->GetType(), function->params_[4]->span_,
+      "native attention output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_, "native attention return");
+  if (query.dtype != DataType::BF16 || key.dtype != DataType::BF16 ||
+      value.dtype != DataType::BF16 || result.dtype != DataType::BF16 ||
+      query.shape.size() != 2 || key.shape.size() != 2 ||
+      value.shape.size() != 2 || result.shape.size() != 2 ||
+      query.shape[1] != key.shape[1] || key.shape[0] != value.shape[0] ||
+      query.shape[0] != result.shape[0] ||
+      value.shape[1] != result.shape[1] || !SameTensor(result, declared) ||
+      query.shape[1] % 128 != 0 || key.shape[0] % 16 != 0 ||
+      value.shape[1] % 16 != 0) {
+    Reject("native attention Q/K/V/output shapes are incompatible",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2 || !top->stmts_[0] || !top->stmts_[1]) {
+    Reject("native attention body must contain one pl.at scope and one return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None || !scope->attrs_.empty() ||
+      !returned_var || returned_var.get() != function->params_[4].get()) {
+    Reject("native attention scope or return is invalid", &function->span_);
+  }
+  const auto body = ir::As<ir::SeqStmts>(scope->body_);
+  if (!body || body->stmts_.size() != 4) {
+    Reject("native attention scope must load K/V then run one row loop",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 3> kOuterOps = {
+      "tile.load", "tile.load", "tile.transpose_view"};
+  std::array<ir::AssignStmtPtr, 3> outer_assignments;
+  for (size_t index = 0; index < outer_assignments.size(); ++index) {
+    outer_assignments[index] = ir::As<ir::AssignStmt>(body->stmts_[index]);
+    const auto call = outer_assignments[index]
+                          ? ir::As<ir::Call>(outer_assignments[index]->value_)
+                          : nullptr;
+    if (!call || !ir::IsOp(call, std::string(kOuterOps[index]))) {
+      Reject("native attention K/V load sequence is invalid",
+             &body->stmts_[index]->span_);
+    }
+  }
+  const auto loop = ir::As<ir::ForStmt>(body->stmts_[3]);
+  const auto stop = loop ? ir::As<ir::ConstInt>(loop->stop_) : nullptr;
+  const auto leaf = loop ? ir::As<ir::SeqStmts>(loop->body_) : nullptr;
+  if (!loop || !stop || stop->value_ != query.shape[0] ||
+      loop->kind_ != ir::ForKind::Sequential || !loop->iter_args_.empty() ||
+      !loop->return_vars_.empty() || !leaf || leaf->stmts_.size() != 14) {
+    Reject("native attention query-row loop is invalid", &body->stmts_[3]->span_);
+  }
+  constexpr std::array<std::string_view, 13> kInnerOps = {
+      "tile.load",        "tile.matmul",       "tile.muls",
+      "tile.create",      "tile.row_max",      "tile.row_expand_sub",
+      "tile.exp",         "tile.create",       "tile.row_sum",
+      "tile.row_expand_div", "tile.cast",      "tile.matmul",
+      "tile.cast"};
+  std::array<ir::AssignStmtPtr, 13> inner_assignments;
+  std::array<ir::CallPtr, 13> inner_calls;
+  for (size_t index = 0; index < inner_assignments.size(); ++index) {
+    inner_assignments[index] = ir::As<ir::AssignStmt>(leaf->stmts_[index]);
+    inner_calls[index] = inner_assignments[index]
+                             ? ir::As<ir::Call>(inner_assignments[index]->value_)
+                             : nullptr;
+    if (!inner_calls[index] ||
+        !ir::IsOp(inner_calls[index], std::string(kInnerOps[index]))) {
+      Reject("native attention tile operation sequence is invalid",
+             &leaf->stmts_[index]->span_);
+    }
+  }
+  const auto store_statement = ir::As<ir::EvalStmt>(leaf->stmts_.back());
+  const auto store_call =
+      store_statement ? ir::As<ir::Call>(store_statement->expr_) : nullptr;
+  if (!store_call || !ir::IsOp(store_call, "tile.store") ||
+      store_call->args_.size() != 3) {
+    Reject("native attention row must end in one tile.store",
+           &leaf->stmts_.back()->span_);
+  }
+  const auto scale = inner_calls[2]->args_.size() == 2
+                         ? ir::As<ir::ConstFloat>(inner_calls[2]->args_[1])
+                         : nullptr;
+  const double expected_scale =
+      1.0 / std::sqrt(static_cast<double>(query.shape[1]));
+  if (!scale || !std::isfinite(scale->value_) ||
+      std::fabs(scale->value_ - expected_scale) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native attention scale must equal 1/sqrt(head_dim)",
+           &inner_calls[2]->span_);
+  }
+  return NativeTileAttentionGraph{query, key, value, result, scale->value_};
+}
