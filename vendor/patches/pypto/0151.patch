+def _canonical_dense_strides(extents: Sequence[int]) -> tuple[int, ...]:
+    """Return canonical row-major element strides for positive extents."""
+
+    running = 1
+    result = [0] * len(extents)
+    for index in range(len(extents) - 1, -1, -1):
+        result[index] = running
+        running *= int(extents[index])
+    return tuple(result)
 
 
