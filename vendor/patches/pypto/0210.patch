+bool ValidateNativeGdnProjectionSpec(
+    const NativeGdnProjectionTensorIrSpec& spec, std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR GDN projection specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  for (const auto& input : spec.inputs) {
+    if (!HasValidStaticMetadata(input) || input.shape.size() != 2 ||
+        input.element_type != TypedTensorIrElementType::BF16 ||
+        input.strides[1] != 1 || input.strides[0] < input.shape[1]) {
+      return reject("inputs must be row-pitched rank-2 BF16 tensors");
+    }
+  }
+  if (!HasValidStaticMetadata(spec.result) || !IsDense(spec.result) ||
+      spec.result.element_type != TypedTensorIrElementType::BF16 ||
+      spec.result.shape.size() != 2 || spec.result.shape[0] != 1 ||
+      spec.mixed_width <= 0 || spec.z_width <= 0 || spec.gate_width <= 0) {
+    return reject("result dtype, shape, or static widths are invalid");
+  }
+  const int64_t rows = spec.inputs[0].shape[0];
+  int64_t qkvz_width = 0;
+  int64_t ba_width = 0;
+  int64_t packed_row_width = 0;
+  int64_t packed_width = 0;
+  if (rows <= 0 || rows > kMaximumBatchTokenProduct ||
+      spec.inputs[1].shape[0] != rows ||
+      !CheckedMultiply(spec.gate_width, 2, ba_width) ||
+      spec.mixed_width >
+          std::numeric_limits<int64_t>::max() - spec.z_width) {
+    return reject("row count or static widths overflow the bounded builder");
+  }
+  qkvz_width = spec.mixed_width + spec.z_width;
+  if (qkvz_width > std::numeric_limits<int64_t>::max() - ba_width) {
+    return reject("packed row width overflows signed 64-bit metadata");
+  }
+  packed_row_width = qkvz_width + ba_width;
+  if (!CheckedMultiply(rows, packed_row_width, packed_width) ||
+      spec.inputs[0].shape[1] != qkvz_width ||
+      spec.inputs[1].shape[1] != ba_width ||
+      spec.result.shape != std::vector<int64_t>({1, packed_width})) {
+    return reject("input and packed-result geometry is inconsistent");
+  }
+  return true;
+}
+
 mlir::Type ElementType(mlir::OpBuilder& builder,
                        TypedTensorIrElementType element_type) {
   if (element_type == TypedTensorIrElementType::BF16) {
@@ -379,6 +426,46 @@ mlir::Value BuildNativeSiluAndMul(
