 }
 
+mlir::Value BuildNativeGdnProjection(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const NativeGdnProjectionTensorIrSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> arguments(entry.getArguments().begin(),
+                                           entry.getArguments().end());
+  const int64_t rows = spec.inputs[0].shape[0];
+  const auto mixed_row_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, {1, spec.mixed_width});
+  const auto z_row_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, {1, spec.z_width});
+  const auto gate_row_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, {1, spec.gate_width});
+  const auto result_type = TensorType(
+      builder, TypedTensorIrElementType::BF16, spec.result.shape);
+
+  llvm::SmallVector<mlir::Value> pieces;
+  pieces.reserve(static_cast<size_t>(rows) * 4);
+  const auto append_rows = [&](mlir::Value input,
+                               mlir::RankedTensorType row_type,
+                               int64_t start, int64_t width) {
+    for (int64_t row = 0; row < rows; ++row) {
+      pieces.push_back(
+          tir::SliceOp::create(builder, location, row_type, input,
+                               llvm::ArrayRef<int64_t>{row, start},
+                               llvm::ArrayRef<int64_t>{row + 1, start + width},
+                               llvm::ArrayRef<int64_t>{1, 1})
+              .getOutput());
+    }
+  };
+  append_rows(arguments[0], mixed_row_type, /*start=*/0, spec.mixed_width);
+  append_rows(arguments[0], z_row_type, /*start=*/spec.mixed_width,
+              spec.z_width);
+  append_rows(arguments[1], gate_row_type, /*start=*/0, spec.gate_width);
+  append_rows(arguments[1], gate_row_type, /*start=*/spec.gate_width,
+              spec.gate_width);
+  return tir::ConcatenateOp::create(builder, location, result_type, pieces,
+                                    /*dimension=*/1)
+      .getOutput();
+}
