+int TestTypedGdnProjectionModuleBuilder() {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  using pypto::codegen::nvidia::NativeGdnProjectionTensorIrSpec;
+  using pypto::codegen::nvidia::TypedTensorIrElementType;
+  using pypto::codegen::nvidia::TypedTensorIrModuleKind;
+  using pypto::codegen::nvidia::TypedTensorIrModuleSpec;
+  using pypto::codegen::nvidia::TypedTensorIrTensorSpec;
+  using pypto::compiler::detail::BuildTypedTensorIrModule;
+
+  const auto tensor = [](std::vector<int64_t> shape,
+                         std::vector<int64_t> strides) {
+    return TypedTensorIrTensorSpec{TypedTensorIrElementType::BF16,
+                                   std::move(shape), std::move(strides), true};
+  };
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativeGdnProjection;
+  NativeGdnProjectionTensorIrSpec& spec =
+      module_spec.native_gdn_projection;
+  spec.inputs = {tensor({2, 512}, {640, 1}),
+                 tensor({2, 256}, {384, 1})};
+  spec.result = tensor({1, 1536}, {1536, 1});
+  spec.mixed_width = 384;
+  spec.z_width = 128;
+  spec.gate_width = 128;
+
+  std::string first_diagnostic;
+  auto first = BuildTypedTensorIrModule(module_spec, first_diagnostic);
+  REQUIRE(first.has_value());
+  REQUIRE(first_diagnostic.empty());
+  const std::string first_source(first->canonical_source.begin(),
+                                 first->canonical_source.end());
+  REQUIRE(first_source.find("nv_tensor_ir.graph @pypto_fused_pointwise") !=
+          std::string::npos);
+  REQUIRE(first_source.find("slice") != std::string::npos);
+  REQUIRE(first_source.find("concatenate") != std::string::npos);
+
+  std::string second_diagnostic;
+  auto second = BuildTypedTensorIrModule(module_spec, second_diagnostic);
+  REQUIRE(second.has_value());
+  REQUIRE(second_diagnostic.empty());
+  REQUIRE(first->canonical_source == second->canonical_source);
+
+  module_spec.native_gdn_projection.result.shape[1] = 1535;
+  module_spec.native_gdn_projection.result.strides[0] = 1535;
+  std::string invalid_diagnostic;
+  REQUIRE(!BuildTypedTensorIrModule(module_spec, invalid_diagnostic).has_value());
+  REQUIRE(invalid_diagnostic.find("geometry is inconsistent") !=
+          std::string::npos);
+#endif
+  return 0;
+}
