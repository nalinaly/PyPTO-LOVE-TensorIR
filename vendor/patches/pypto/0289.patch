 bool MatchesSourceAndSha256(const TensorIrModule& module,
-                           const std::string& expected_source,
-                           std::string_view expected_sha256) {
+                            const std::string& expected_source,
+                            std::string_view expected_sha256) {
   const std::vector<uint8_t> bytes(expected_source.begin(), expected_source.end());
   const std::string actual_sha256 = Artifact::ComputeSourceIrDigest(bytes);
-  return module.GetCanonicalSource() == expected_source &&
+  const std::string actual_source =
+      module.HasTypedModuleSpec()
+          ? [&]() {
+              std::string diagnostic;
+              const auto built = BuildTypedTensorIrModule(
+                  *module.GetTypedModuleSpec(), diagnostic);
+              return built.has_value()
+                         ? std::string(built->canonical_source.begin(),
+                                       built->canonical_source.end())
+                         : std::string{};
+            }()
+          : module.GetCanonicalSource();
+  return actual_source == expected_source &&
          std::string_view(actual_sha256) == expected_sha256;
 }
 
+std::string MaterializedCanonicalSource(const TensorIrModule& module) {
+  if (!module.HasTypedModuleSpec()) return module.GetCanonicalSource();
+  std::string diagnostic;
+  const auto built =
+      BuildTypedTensorIrModule(*module.GetTypedModuleSpec(), diagnostic);
+  return built.has_value()
+             ? std::string(built->canonical_source.begin(),
+                           built->canonical_source.end())
+             : std::string{};
+}
