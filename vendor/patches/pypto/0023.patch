+    OUTPUT_VARIABLE PYPTO_NVIDIA_PYPTO_REVISION
+    ERROR_VARIABLE _pypto_revision_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+string(LENGTH "${PYPTO_NVIDIA_PYPTO_REVISION}" _pypto_revision_length)
