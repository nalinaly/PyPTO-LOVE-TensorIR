+uint8_t ReadUint8(const msgpack::object& object, const std::string& context) {
+  const uint64_t value = detail::ReadUint64(object, context);
+  if (value > std::numeric_limits<uint8_t>::max()) {
+    throw ValueError(context + " exceeds uint8 range");
+  }
+  return static_cast<uint8_t>(value);
+}
+
+uint16_t ReadUint16(const msgpack::object& object, const std::string& context) {
+  const uint64_t value = detail::ReadUint64(object, context);
+  if (value > std::numeric_limits<uint16_t>::max()) {
+    throw ValueError(context + " exceeds uint16 range");
+  }
+  return static_cast<uint16_t>(value);
+}
+
+const msgpack::object_array& ReadArray(const msgpack::object& object,
+                                      const std::string& context) {
+  if (object.type != msgpack::type::ARRAY) throw ValueError(context + " must be an array");
+  return object.via.array;
+}
+
+std::array<uint32_t, 3> ParseUint32Triple(const msgpack::object& object,
+                                         const std::string& context) {
+  const auto& array = ReadArray(object, context);
+  if (array.size != 3) throw ValueError(context + " must contain exactly three integers");
+  return {detail::ReadUint32(array.ptr[0], context + "[0]"),
+          detail::ReadUint32(array.ptr[1], context + "[1]"),
+          detail::ReadUint32(array.ptr[2], context + "[2]")};
+}
+
+std::vector<uint32_t> ParseUint32Vector(const msgpack::object& object,
+                                        const std::string& context) {
+  const auto& array = ReadArray(object, context);
+  std::vector<uint32_t> values;
+  values.reserve(array.size);
+  for (uint32_t index = 0; index < array.size; ++index) {
+    values.push_back(detail::ReadUint32(array.ptr[index],
+                                        context + "[" + std::to_string(index) + "]"));
+  }
+  return values;
+}
+
+std::vector<std::optional<int64_t>> ParseOptionalIntegers(
+    const msgpack::object& object, const std::string& context) {
+  const auto& array = ReadArray(object, context);
+  std::vector<std::optional<int64_t>> values;
+  values.reserve(array.size);
+  for (uint32_t index = 0; index < array.size; ++index) {
+    const auto& value = array.ptr[index];
+    if (value.type == msgpack::type::NIL) {
+      values.emplace_back(std::nullopt);
+    } else {
+      values.emplace_back(detail::ReadInt64(
+          value, context + "[" + std::to_string(index) + "]"));
+    }
+  }
+  return values;
+}
+
+ArtifactTarget ParseTarget(const msgpack::object& object, const std::string& context) {
+  detail::StrictMap fields(object, context, {"compute_capability", "name", "portability"});
+  const uint32_t compute_capability =
+      detail::ReadUint32(fields.Get("compute_capability"), context + ".compute_capability");
+  if (compute_capability > static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) {
+    throw ValueError(context + ".compute_capability exceeds int32 range");
+  }
+  return ArtifactTarget(
+      static_cast<int32_t>(compute_capability),
+      detail::ReadText(fields.Get("name"), context + ".name"),
+      ParseTargetPortability(fields.Get("portability"), context + ".portability"));
+}
+
+ArtifactBytecodeVersion ParseBytecodeVersion(const msgpack::object& object,
+                                             const std::string& context) {
+  detail::StrictMap fields(object, context, {"major", "minor", "tag"});
+  return ArtifactBytecodeVersion(ReadUint8(fields.Get("major"), context + ".major"),
+                                 ReadUint8(fields.Get("minor"), context + ".minor"),
+                                 ReadUint16(fields.Get("tag"), context + ".tag"));
+}
+
+ArtifactArgumentDescriptor ParseArgumentDescriptor(const msgpack::object& object,
+                                                    const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"dynamic_size_count",
+                            "dynamic_stride_count",
+                            "explicit_strides",
+                            "kind",
+                            "rank",
+                            "scalar_size_bytes",
+                            "shape",
+                            "strides"});
+  return ArtifactArgumentDescriptor(
+      ParseOperandKind(fields.Get("kind"), context + ".kind"),
+      detail::ReadUint32(fields.Get("rank"), context + ".rank"),
+      ParseOptionalIntegers(fields.Get("shape"), context + ".shape"),
+      ParseOptionalIntegers(fields.Get("strides"), context + ".strides"),
+      detail::ReadUint32(fields.Get("dynamic_size_count"),
+                         context + ".dynamic_size_count"),
+      detail::ReadUint32(fields.Get("dynamic_stride_count"),
+                         context + ".dynamic_stride_count"),
+      detail::ReadBool(fields.Get("explicit_strides"), context + ".explicit_strides"),
+      detail::ReadUint32(fields.Get("scalar_size_bytes"),
+                         context + ".scalar_size_bytes"));
+}
+
+ArtifactArgumentLayout ParseArgumentLayout(const msgpack::object& object,
+                                           const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"input_operand_count",
+                            "operand_descriptors",
+                            "total_kernel_argument_count",
+                            "uniform_signature"});
+  const auto& descriptors_object = fields.Get("operand_descriptors");
+  const auto& descriptors_array = ReadArray(descriptors_object, context + ".operand_descriptors");
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  descriptors.reserve(descriptors_array.size);
+  for (uint32_t index = 0; index < descriptors_array.size; ++index) {
+    descriptors.push_back(ParseArgumentDescriptor(
+        descriptors_array.ptr[index],
+        context + ".operand_descriptors[" + std::to_string(index) + "]"));
+  }
+  return ArtifactArgumentLayout(
+      std::move(descriptors),
+      detail::ReadUint32(fields.Get("input_operand_count"),
+                         context + ".input_operand_count"),
+      detail::ReadUint32(fields.Get("total_kernel_argument_count"),
+                         context + ".total_kernel_argument_count"),
+      detail::ReadBool(fields.Get("uniform_signature"), context + ".uniform_signature"));
+}
+
+ArtifactGridAbi ParseGridAbi(const msgpack::object& object, const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"policy", "shape_operand_index", "static_dimensions", "tile_sizes"});
+  return ArtifactGridAbi(
+      ParseGridPolicy(fields.Get("policy"), context + ".policy"),
+      detail::ReadUint32(fields.Get("shape_operand_index"),
+                         context + ".shape_operand_index"),
+      ParseUint32Triple(fields.Get("static_dimensions"), context + ".static_dimensions"),
+      ParseUint32Vector(fields.Get("tile_sizes"), context + ".tile_sizes"));
+}
+
+ArtifactWorkspaceAbi ParseWorkspaceAbi(const msgpack::object& object,
+                                       const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"alignment_bytes", "kind", "size_bytes", "workspace_abi_version"});
+  if (detail::ReadUint32(fields.Get("workspace_abi_version"),
+                         context + ".workspace_abi_version") !=
+      ArtifactWorkspaceAbi::kWorkspaceAbiVersion) {
+    throw ValueError(context + " contains an unsupported workspace ABI version");
+  }
+  return ArtifactWorkspaceAbi(
+      ParseWorkspaceKind(fields.Get("kind"), context + ".kind"),
+      detail::ReadUint64(fields.Get("size_bytes"), context + ".size_bytes"),
+      detail::ReadUint64(fields.Get("alignment_bytes"), context + ".alignment_bytes"));
+}
+
+ArtifactLaunchAbi ParseLaunchAbi(const msgpack::object& object, const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"block_dimensions",
+                            "cluster_scheduling_policy",
+                            "dynamic_shared_memory_bytes",
+                            "kernel_argument_slot_bytes",
+                            "launch_abi_version"});
+  if (detail::ReadUint32(fields.Get("launch_abi_version"),
+                         context + ".launch_abi_version") !=
+      ArtifactLaunchAbi::kLaunchAbiVersion) {
+    throw ValueError(context + " contains an unsupported launch ABI version");
+  }
+  return ArtifactLaunchAbi(
+      ParseUint32Triple(fields.Get("block_dimensions"), context + ".block_dimensions"),
+      ParseClusterPolicy(fields.Get("cluster_scheduling_policy"),
+                         context + ".cluster_scheduling_policy"),
+      detail::ReadUint64(fields.Get("dynamic_shared_memory_bytes"),
+                         context + ".dynamic_shared_memory_bytes"),
+      detail::ReadUint32(fields.Get("kernel_argument_slot_bytes"),
+                         context + ".kernel_argument_slot_bytes"));
+}
+
+ArtifactLoaderAbi ParseLoaderAbi(const msgpack::object& object, const std::string& context) {
