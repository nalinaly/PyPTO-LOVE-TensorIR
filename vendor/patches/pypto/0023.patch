+size_t CountDynamic(const std::vector<std::optional<int64_t>>& values) {
+  return static_cast<size_t>(std::count_if(values.begin(), values.end(),
+                                           [](const auto& value) { return !value.has_value(); }));
+}
+
+std::vector<uint32_t> KernelArgumentSizes(const ArtifactArgumentLayout& layout) {
+  std::vector<uint32_t> sizes;
+  sizes.reserve(layout.GetTotalKernelArgumentCount());
+  for (const auto& descriptor : layout.GetOperandDescriptors()) {
+    if (descriptor.GetKind() == ArtifactOperandKind::Scalar) {
+      sizes.push_back(descriptor.GetScalarSizeBytes());
+      continue;
+    }
+    sizes.push_back(sizeof(uint64_t));
+    sizes.insert(sizes.end(), descriptor.GetDynamicSizeCount(), sizeof(int32_t));
+    sizes.insert(sizes.end(), descriptor.GetDynamicStrideCount(), sizeof(int32_t));
+  }
+  if (sizes.size() != layout.GetTotalKernelArgumentCount()) {
+    throw InternalError("Artifact argument layout produced an inconsistent flat ABI");
+  }
+  return sizes;
+}
+
+bool HasDynamicShapeMetadata(const ArtifactArgumentLayout& layout) {
+  for (const auto& descriptor : layout.GetOperandDescriptors()) {
+    if (descriptor.GetKind() == ArtifactOperandKind::Tensor &&
+        CountDynamic(descriptor.GetShape()) != 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool RequiresFlatPacking(const ArtifactArgumentLayout& layout) {
+  if (layout.HasUniformSignature()) return true;
+  for (const auto& descriptor : layout.GetOperandDescriptors()) {
+    if (descriptor.GetKind() == ArtifactOperandKind::Tensor &&
+        (CountDynamic(descriptor.GetShape()) != 0 ||
+         CountDynamic(descriptor.GetStrides()) != 0)) {
+      return true;
+    }
+  }
+  return false;
+}
