+
+/**
+ * Immutable, pointer-free and runtime-free PyPTO NVIDIA Artifact v1.
+ *
+ * V1 is deliberately strict: Cubin only, requested and actual exact target sm_120a,
+ * structured TensorIR route, deterministic producer options, no environment
+ * overrides and no fallback. Construction and deserialization validate every
+ * field against the supplied CompileRequest, KernelBuildSpec and compiled-in
+ * NVIDIA backend identity.
+ */
+class Artifact {
+ public:
+  static constexpr std::string_view kContract = "pypto.nvidia.artifact.v1";
+  static constexpr std::string_view kCacheKeyContract =
+      "pypto.nvidia.artifact.cache_key.v1";
+  static constexpr std::string_view kLoaderCompatibilityContract =
+      "pypto.nvidia.artifact.loader_compatibility.v1";
+  static constexpr std::string_view kProducerResultContract =
+      "tensorir.cuda_tile_compiled_artifact.v1";
+  static constexpr std::string_view kProducerOptionsContract =
+      "pypto.nvidia.tensorir_options.v1";
+  static constexpr std::string_view kStructuredTensorIrPipelineRevision =
+      "a5398054a515c632506c3f1ffa3a0b5d9e819e83";
+  static constexpr uint32_t kArtifactSchemaVersion = 1;
+  static constexpr uint32_t kCompilerAbiVersion = CompileRequest::kCompilerAbiVersion;
+  static constexpr int32_t kRequiredComputeCapability = 120;
+  static constexpr std::string_view kRequiredTargetName = "sm_120a";
+  static constexpr uint64_t kMinimumDeviceCodeBytes = 64;
+  static constexpr uint64_t kMaximumDeviceCodeBytes = 64ULL * 1024ULL * 1024ULL;
+  static constexpr uint64_t kMaximumSerializedArtifactBytes = 68ULL * 1024ULL * 1024ULL;
+  static constexpr uint32_t kMaximumOperandDescriptors = 1024;
+  static constexpr uint32_t kMaximumRank = 32;
+  static constexpr uint32_t kMaximumTileDimensions = 32;
+  static constexpr uint32_t kMaximumKernelArguments = 4096;
+  static constexpr uint64_t kMaximumWorkspaceSizeBytes = 1ULL << 40;
+  static constexpr uint64_t kMaximumWorkspaceAlignmentBytes = 2ULL * 1024ULL * 1024ULL;
+  static constexpr uint32_t kMinimumCudaDriverApiVersion = 13000;
+  static constexpr uint32_t kMinimumCudaRuntimeApiVersion = 13000;
+
+  Artifact() = delete;
+  Artifact(const Artifact&) = default;
+  Artifact(Artifact&&) = default;
+  Artifact& operator=(const Artifact&) = delete;
+  Artifact& operator=(Artifact&&) = delete;
+
+  /** Validate and normalize one private producer result into strict Artifact v1. */
+  [[nodiscard]] static Artifact CreateStrict(const CompileRequest& request,
+                                             const KernelBuildSpec& build_spec,
+                                             ArtifactProducerResult producer_result);
+
+  /**
+   * Deserialize canonical MessagePack and validate it against the expected
+   * request, build specification and compiled-in producer identity.
+   */
+  [[nodiscard]] static Artifact DeserializeCanonical(
+      const std::vector<uint8_t>& data, const CompileRequest& expected_request,
+      const KernelBuildSpec& expected_build_spec);
+
+  /** Serialize the complete Artifact, including Cubin bytes, as canonical MessagePack. */
+  [[nodiscard]] std::vector<uint8_t> SerializeCanonical() const;
+
+  /** SHA-256 of the complete canonical Artifact payload. */
+  [[nodiscard]] std::string GetIdentityDigest() const;
+
+  /** Canonical precompile cache-key projection and its SHA-256 digest. */
+  [[nodiscard]] std::vector<uint8_t> SerializeCacheKeyIdentity() const;
+  [[nodiscard]] std::string GetCacheKeyDigest() const;
+  [[nodiscard]] static std::vector<uint8_t> SerializeCacheKeyIdentity(
+      const CompileRequest& request, const KernelBuildSpec& build_spec,
+      const ArtifactProducerIdentity& producer_identity);
+  [[nodiscard]] static std::string GetCacheKeyDigest(
+      const CompileRequest& request, const KernelBuildSpec& build_spec,
+      const ArtifactProducerIdentity& producer_identity);
+
+  /** Canonical identity of the exact strict TensorIR producer options. */
+  [[nodiscard]] static std::vector<uint8_t> SerializeProducerOptionsIdentity(
+      const CompileRequest& request, const KernelBuildSpec& build_spec);
+  [[nodiscard]] static std::string GetProducerOptionsIdentityDigest(
+      const CompileRequest& request, const KernelBuildSpec& build_spec);
+
+  /** Canonical actual-artifact loader requirements and their SHA-256 digest. */
+  [[nodiscard]] std::vector<uint8_t> SerializeLoaderCompatibility() const;
+  [[nodiscard]] std::string GetLoaderCompatibilityDigest() const;
+
+  [[nodiscard]] constexpr uint32_t GetArtifactSchemaVersion() const noexcept {
+    return kArtifactSchemaVersion;
+  }
+  [[nodiscard]] constexpr uint32_t GetCompilerAbiVersion() const noexcept {
+    return kCompilerAbiVersion;
+  }
+  [[nodiscard]] backend::BackendType GetBackendType() const noexcept {
+    return backend::BackendType::Nvidia;
+  }
+  [[nodiscard]] RequestedArtifactPolicy GetRequestedArtifactPolicy() const noexcept {
+    return requested_artifact_policy_;
+  }
+  [[nodiscard]] ArtifactKind GetActualArtifactKind() const noexcept {
+    return actual_artifact_kind_;
+  }
+  [[nodiscard]] const ArtifactTarget& GetRequestedTarget() const noexcept {
+    return requested_target_;
+  }
+  [[nodiscard]] const ArtifactTarget& GetActualTarget() const noexcept { return actual_target_; }
+  [[nodiscard]] const ArtifactBytecodeVersion& GetTileIrBytecodeVersion() const noexcept {
+    return tile_ir_bytecode_version_;
+  }
+  [[nodiscard]] const ArtifactKernelAbi& GetKernelAbi() const noexcept { return kernel_abi_; }
+  [[nodiscard]] const ArtifactIdentities& GetIdentities() const noexcept { return identities_; }
+  [[nodiscard]] const ArtifactProducerIdentity& GetProducerIdentity() const noexcept {
+    return producer_identity_;
+  }
+  [[nodiscard]] SemanticRoute GetSemanticRoute() const noexcept { return semantic_route_; }
+  [[nodiscard]] bool UsedFallback() const noexcept { return fallback_used_; }
+  [[nodiscard]] const std::vector<uint8_t>& GetDeviceCode() const noexcept { return device_code_; }
+  [[nodiscard]] const std::string& GetDeviceCodeSha256() const noexcept {
+    return device_code_sha256_;
+  }
+
+ private:
+  Artifact(RequestedArtifactPolicy requested_artifact_policy, ArtifactKind actual_artifact_kind,
+           ArtifactTarget requested_target, ArtifactTarget actual_target,
+           ArtifactBytecodeVersion tile_ir_bytecode_version, ArtifactKernelAbi kernel_abi,
+           ArtifactIdentities identities, ArtifactProducerIdentity producer_identity,
+           SemanticRoute semantic_route, bool fallback_used, std::vector<uint8_t> device_code,
+           std::string device_code_sha256);
+
+  RequestedArtifactPolicy requested_artifact_policy_;
+  ArtifactKind actual_artifact_kind_;
+  ArtifactTarget requested_target_;
+  ArtifactTarget actual_target_;
+  ArtifactBytecodeVersion tile_ir_bytecode_version_;
+  ArtifactKernelAbi kernel_abi_;
+  ArtifactIdentities identities_;
+  ArtifactProducerIdentity producer_identity_;
+  SemanticRoute semantic_route_;
+  bool fallback_used_;
+  std::vector<uint8_t> device_code_;
+  std::string device_code_sha256_;
+};
+
+}  // namespace pypto::compiler
