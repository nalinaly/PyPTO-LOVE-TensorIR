+nb::bytes ToPythonArtifactBytes(const std::vector<uint8_t>& data) {
+  if (data.size() > compiler::Artifact::kMaximumSerializedArtifactBytes) {
+    throw nb::value_error("Artifact payload exceeds the 68 MiB v1 limit");
+  }
+  return ToPythonBytes(data);
+}
