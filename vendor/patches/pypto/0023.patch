+
+file(GLOB_RECURSE _pypto_nvidia_source_identity_inputs
+     CONFIGURE_DEPENDS LIST_DIRECTORIES false
+     "${CMAKE_SOURCE_DIR}/include/*"
+     "${CMAKE_SOURCE_DIR}/src/*"
+     "${CMAKE_SOURCE_DIR}/python/bindings/*")
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    ${_pypto_nvidia_source_identity_inputs})
+
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}"
+            status --porcelain=v1 --untracked-files=normal
+            --ignore-submodules=dirty
+    RESULT_VARIABLE _pypto_source_status
+    OUTPUT_VARIABLE _pypto_source_changes
+    ERROR_VARIABLE _pypto_source_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+if(NOT _pypto_source_status EQUAL 0 OR NOT _pypto_source_changes STREQUAL "")
+    message(FATAL_ERROR
