+        "Commit or remove these changes before configuring:\n"
+        "${_pypto_source_changes}${_pypto_source_error}")
+endif()
+
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}" rev-parse HEAD
