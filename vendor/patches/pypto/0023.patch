+ArtifactProducerResult MakeProducerResult(
+    const CompileRequest& request, const KernelBuildSpec& build_spec,
+    ArtifactKernelAbi kernel, const ToolchainIdentity& toolchain,
+    bool fallback_used = false, bool environment_overrides_enabled = false,
+    bool artifact_fallback_allowed = false, int32_t cubin_compute_capability = 120,
+    std::string cubin_entry_function_name = {}) {
+  if (cubin_entry_function_name.empty()) {
+    cubin_entry_function_name = kernel.GetEntryFunctionName();
+  }
+  std::vector<uint8_t> device_code =
+      MakeCudaCubin(cubin_entry_function_name,
+                    KernelArgumentSizesForTest(kernel),
+                    cubin_compute_capability);
+  return ArtifactProducerResult(
+      ArtifactTarget(120, "sm_120a", ArtifactTargetPortability::ArchConditional),
+      ArtifactTarget(120, "sm_120a", ArtifactTargetPortability::ArchConditional),
+      ArtifactKind::Cubin, ArtifactBytecodeVersion(13, 3, 0),
+      std::move(kernel),
+      MakeProducerIdentity(request, build_spec, toolchain, environment_overrides_enabled,
+                           artifact_fallback_allowed),
+      fallback_used, std::move(device_code));
+}
