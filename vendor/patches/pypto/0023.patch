+template <typename Sink>
+void PackProducerOptionsIdentity(ArtifactPacker<Sink>& packer,
+                                 const CompileRequest& request,
+                                 const StrictProducerOptions& options) {
+  const auto& target = request.GetTargetInfo();
+  const auto& traits = target.GetTraits();
+  const auto& toolchain = request.GetToolchainIdentity();
+  packer.pack_map(24);
+  PackKey(packer, "artifact_fallback_allowed");
+  packer.pack(false);
+  PackKey(packer, "artifact_kind");
+  PackText(packer, "cubin");
+  PackKey(packer, "assembler_gpu_name");
+  PackText(packer, target.GetArchitecture());
+  PackKey(packer, "bytecode_major");
+  packer.pack(13);
+  PackKey(packer, "bytecode_minor");
+  packer.pack(3);
+  PackKey(packer, "bytecode_tag");
+  packer.pack(0);
+  PackKey(packer, "codegen_strategy");
+  PackText(packer, "layout-propagation");
+  PackKey(packer, "compute_capability");
+  packer.pack(traits.GetComputeCapability());
+  PackKey(packer, "contract");
+  PackText(packer, Artifact::kProducerOptionsContract);
+  PackKey(packer, "cta_count");
+  packer.pack(1);
+  PackKey(packer, "cuda_toolkit_version");
+  PackText(packer, toolchain.GetCudaToolkitVersion());
+  PackKey(packer, "environment_overrides_enabled");
+  packer.pack(false);
+  PackKey(packer, "max_shared_memory_per_cta_bytes");
+  packer.pack(traits.GetMaxSharedMemoryPerCtaBytes());
+  PackKey(packer, "max_tile_candidates");
+  packer.pack(0);
+  PackKey(packer, "multiprocessor_count");
+  packer.pack(traits.GetMultiprocessorCount());
+  PackKey(packer, "shared_memory_per_multiprocessor_bytes");
+  packer.pack(traits.GetSharedMemoryPerMultiprocessorBytes());
+  PackKey(packer, "tensor_ir_portability");
+  PackText(packer, "arch-conditional");
+  PackKey(packer, "tensor_ir_target");
+  PackText(packer, target.GetArchConditionalArchitecture());
+  PackKey(packer, "tile_sizes");
+  packer.pack_array(static_cast<uint32_t>(options.tile_sizes.size()));
+  for (uint32_t tile_size : options.tile_sizes) packer.pack(tile_size);
+  PackKey(packer, "tileiras_real_path");
+  PackText(packer, toolchain.GetTileirasRealPath());
+  PackKey(packer, "tileiras_sha256");
+  PackText(packer, toolchain.GetTileirasSha256());
+  PackKey(packer, "tileiras_version");
+  PackText(packer, toolchain.GetTileirasVersion());
+  PackKey(packer, "uniform_signature");
+  packer.pack(options.uniform_signature);
+  PackKey(packer, "warp_count");
+  packer.pack(4);
+}
