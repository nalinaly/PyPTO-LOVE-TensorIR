+ArtifactProducerIdentity ParseProducer(const msgpack::object& object,
+                                       const std::string& context) {
+  detail::StrictMap fields(object, context,
+                           {"artifact_fallback_allowed",
+                            "cuda_tile_revision",
+                            "cuda_toolkit_root",
+                            "cuda_toolkit_version",
+                            "environment_overrides_enabled",
+                            "kind",
+                            "llvm_revision",
+                            "options_identity_digest",
+                            "pipeline_revision",
+                            "producer_result_contract",
+                            "pypto_revision",
+                            "tensor_ir_revision",
+                            "tileiras_real_path",
+                            "tileiras_sha256",
+                            "tileiras_version"});
+  ToolchainIdentity toolchain(
+      detail::ReadText(fields.Get("pypto_revision"), context + ".pypto_revision"),
+      detail::ReadText(fields.Get("tensor_ir_revision"), context + ".tensor_ir_revision"),
+      detail::ReadText(fields.Get("cuda_tile_revision"), context + ".cuda_tile_revision"),
+      detail::ReadText(fields.Get("llvm_revision"), context + ".llvm_revision"),
+      detail::ReadText(fields.Get("cuda_toolkit_root"), context + ".cuda_toolkit_root"),
+      detail::ReadText(fields.Get("cuda_toolkit_version"),
+                       context + ".cuda_toolkit_version"),
+      detail::ReadText(fields.Get("tileiras_real_path"), context + ".tileiras_real_path"),
+      detail::ReadText(fields.Get("tileiras_version"), context + ".tileiras_version"),
+      detail::ReadText(fields.Get("tileiras_sha256"), context + ".tileiras_sha256"));
+  return ArtifactProducerIdentity(
+      ParseProducerKind(fields.Get("kind"), context + ".kind"), std::move(toolchain),
+      detail::ReadText(fields.Get("pipeline_revision"), context + ".pipeline_revision"),
+      detail::ReadText(fields.Get("producer_result_contract"),
+                       context + ".producer_result_contract"),
+      detail::ReadText(fields.Get("options_identity_digest"),
+                       context + ".options_identity_digest"),
+      detail::ReadBool(fields.Get("environment_overrides_enabled"),
+                       context + ".environment_overrides_enabled"),
+      detail::ReadBool(fields.Get("artifact_fallback_allowed"),
+                       context + ".artifact_fallback_allowed"));
+}
+
+bool SameIdentities(const ArtifactIdentities& lhs, const ArtifactIdentities& rhs) {
+  return lhs.GetCompileRequestByteIdentityDigest() ==
+             rhs.GetCompileRequestByteIdentityDigest() &&
+         lhs.GetKernelBuildSpecDigest() == rhs.GetKernelBuildSpecDigest() &&
+         lhs.GetSourceIrDigest() == rhs.GetSourceIrDigest() &&
+         lhs.GetCallableAbiDigest() == rhs.GetCallableAbiDigest() &&
+         lhs.GetArgumentAbiDigest() == rhs.GetArgumentAbiDigest() &&
+         lhs.GetResultAbiDigest() == rhs.GetResultAbiDigest() &&
+         lhs.GetMutationAbiDigest() == rhs.GetMutationAbiDigest() &&
+         lhs.GetStaticSpecializationDigest() == rhs.GetStaticSpecializationDigest() &&
+         lhs.GetSymbolicSpecializationDigest() == rhs.GetSymbolicSpecializationDigest();
+}
