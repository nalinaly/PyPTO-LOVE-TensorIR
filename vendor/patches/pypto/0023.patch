+class VectorSink {
+ public:
+  VectorSink(size_t maximum_size, size_t reserve_size) : maximum_size_(maximum_size) {
+    bytes_.reserve(std::min(maximum_size, reserve_size));
+  }
+
+  void write(const char* data, size_t size) {
+    if (size > maximum_size_ - bytes_.size()) {
+      throw ValueError("canonical MessagePack payload exceeds its serialized-size limit");
+    }
+    if (size == 0) return;
+    const auto* begin = reinterpret_cast<const uint8_t*>(data);
+    bytes_.insert(bytes_.end(), begin, begin + size);
+  }
+
+  [[nodiscard]] std::vector<uint8_t> TakeBytes() && { return std::move(bytes_); }
+
+ private:
+  size_t maximum_size_;
+  std::vector<uint8_t> bytes_;
+};
+
+class CompareSink {
+ public:
+  explicit CompareSink(const std::vector<uint8_t>& expected) : expected_(expected) {}
+
+  void write(const char* data, size_t size) {
+    if (!matches_) return;
+    if (offset_ > expected_.size() || size > expected_.size() - offset_) {
+      matches_ = false;
+      return;
+    }
+    if (size != 0 &&
+        std::memcmp(expected_.data() + offset_, data, size) != 0) {
+      matches_ = false;
+      return;
+    }
+    offset_ += size;
+  }
+
+  [[nodiscard]] bool MatchesCompletePayload() const noexcept {
+    return matches_ && offset_ == expected_.size();
+  }
+
+ private:
+  const std::vector<uint8_t>& expected_;
+  size_t offset_ = 0;
+  bool matches_ = true;
+};
