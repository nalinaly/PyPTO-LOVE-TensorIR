+    OUTPUT_VARIABLE _pypto_git_dir
+    ERROR_VARIABLE _pypto_git_dir_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}"
+            rev-parse --path-format=absolute --git-common-dir
