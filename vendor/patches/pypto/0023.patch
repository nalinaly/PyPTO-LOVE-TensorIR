+
+ArtifactArgumentDescriptor::ArtifactArgumentDescriptor(
+    ArtifactOperandKind kind, uint32_t rank, std::vector<std::optional<int64_t>> shape,
+    std::vector<std::optional<int64_t>> strides, uint32_t dynamic_size_count,
+    uint32_t dynamic_stride_count, bool explicit_strides, uint32_t scalar_size_bytes)
+    : kind_(kind),
+      rank_(rank),
+      shape_(std::move(shape)),
+      strides_(std::move(strides)),
+      dynamic_size_count_(dynamic_size_count),
+      dynamic_stride_count_(dynamic_stride_count),
+      explicit_strides_(explicit_strides),
+      scalar_size_bytes_(scalar_size_bytes) {
+  (void)OperandKindName(kind_);
+  if (rank_ > Artifact::kMaximumRank) throw ValueError("Artifact operand rank exceeds 32");
+  if (kind_ == ArtifactOperandKind::Scalar) {
+    if (rank_ != 0 || !shape_.empty() || !strides_.empty() || dynamic_size_count_ != 0 ||
+        dynamic_stride_count_ != 0 || explicit_strides_ || scalar_size_bytes_ == 0 ||
+        scalar_size_bytes_ > 8) {
+      throw ValueError("invalid scalar Artifact argument descriptor");
+    }
+    return;
+  }
+  if (shape_.size() != rank_ || (!strides_.empty() && strides_.size() != rank_) ||
+      explicit_strides_ != !strides_.empty() || scalar_size_bytes_ != 0 ||
+      dynamic_size_count_ > rank_ || dynamic_stride_count_ > rank_) {
+    throw ValueError("invalid tensor Artifact argument descriptor");
+  }
+  for (const auto& dimension : shape_) {
+    if (dimension.has_value() && *dimension <= 0) {
+      throw ValueError("static Artifact tensor dimensions must be positive");
+    }
+  }
+  for (const auto& stride : strides_) {
+    if (stride.has_value() && *stride < 0) {
+      throw ValueError("static Artifact tensor strides must not be negative");
+    }
+  }
+}
+
+ArtifactArgumentLayout::ArtifactArgumentLayout(
+    std::vector<ArtifactArgumentDescriptor> operand_descriptors, uint32_t input_operand_count,
+    uint32_t total_kernel_argument_count, bool uniform_signature)
+    : operand_descriptors_(std::move(operand_descriptors)),
+      input_operand_count_(input_operand_count),
+      total_kernel_argument_count_(total_kernel_argument_count),
+      uniform_signature_(uniform_signature) {
+  if (operand_descriptors_.empty() ||
+      operand_descriptors_.size() > Artifact::kMaximumOperandDescriptors ||
+      input_operand_count_ > operand_descriptors_.size() ||
+      total_kernel_argument_count_ > Artifact::kMaximumKernelArguments) {
+    throw ValueError("invalid Artifact argument layout bounds");
+  }
+  uint64_t expected_arguments = 0;
+  for (const auto& descriptor : operand_descriptors_) {
+    if (descriptor.GetKind() == ArtifactOperandKind::Scalar) {
+      ++expected_arguments;
+    } else {
+      const size_t expected_sizes =
+          uniform_signature_ ? descriptor.GetRank() : CountDynamic(descriptor.GetShape());
+      const size_t expected_strides = uniform_signature_ ? descriptor.GetStrides().size()
+                                                         : CountDynamic(descriptor.GetStrides());
+      if (descriptor.GetDynamicSizeCount() != expected_sizes ||
+          descriptor.GetDynamicStrideCount() != expected_strides) {
+        throw ValueError("Artifact dynamic argument counts differ from tensor metadata");
+      }
+      expected_arguments += 1 + expected_sizes + expected_strides;
+    }
+    if (expected_arguments > Artifact::kMaximumKernelArguments) {
+      throw ValueError("Artifact kernel argument count exceeds 4096");
+    }
+  }
+  if (expected_arguments != total_kernel_argument_count_) {
+    throw ValueError("Artifact total kernel argument count does not match its descriptors");
+  }
+}
