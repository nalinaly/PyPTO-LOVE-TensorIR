+template <typename Sink>
+void PackGridAbi(ArtifactPacker<Sink>& packer, const ArtifactGridAbi& grid) {
+  packer.pack_map(4);
+  PackKey(packer, "policy");
+  PackText(packer, GridPolicyName(grid.GetPolicy()));
+  PackKey(packer, "shape_operand_index");
+  packer.pack(grid.GetShapeOperandIndex());
+  PackKey(packer, "static_dimensions");
+  packer.pack_array(3);
+  for (uint32_t dimension : grid.GetStaticDimensions()) packer.pack(dimension);
+  PackKey(packer, "tile_sizes");
+  packer.pack_array(static_cast<uint32_t>(grid.GetTileSizes().size()));
+  for (uint32_t tile_size : grid.GetTileSizes()) packer.pack(tile_size);
