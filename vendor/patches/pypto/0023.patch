+template <typename Sink>
+void PackProducer(ArtifactPacker<Sink>& packer,
+                  const ArtifactProducerIdentity& producer) {
+  const auto& toolchain = producer.GetToolchainIdentity();
+  packer.pack_map(15);
+  PackKey(packer, "artifact_fallback_allowed");
+  packer.pack(producer.ArtifactFallbackAllowed());
+  PackKey(packer, "cuda_tile_revision");
+  PackText(packer, toolchain.GetCudaTileRevision());
+  PackKey(packer, "cuda_toolkit_root");
+  PackText(packer, toolchain.GetCudaToolkitRoot());
+  PackKey(packer, "cuda_toolkit_version");
+  PackText(packer, toolchain.GetCudaToolkitVersion());
+  PackKey(packer, "environment_overrides_enabled");
+  packer.pack(producer.EnvironmentOverridesEnabled());
+  PackKey(packer, "kind");
+  PackText(packer, ProducerKindName(producer.GetKind()));
+  PackKey(packer, "llvm_revision");
+  PackText(packer, toolchain.GetLlvmRevision());
+  PackKey(packer, "options_identity_digest");
+  PackText(packer, producer.GetOptionsIdentityDigest());
+  PackKey(packer, "pipeline_revision");
+  PackText(packer, producer.GetPipelineRevision());
+  PackKey(packer, "producer_result_contract");
+  PackText(packer, producer.GetProducerResultContract());
+  PackKey(packer, "pypto_revision");
+  PackText(packer, toolchain.GetPyptoRevision());
+  PackKey(packer, "tensor_ir_revision");
+  PackText(packer, toolchain.GetTensorIrRevision());
+  PackKey(packer, "tileiras_real_path");
+  PackText(packer, toolchain.GetTileirasRealPath());
+  PackKey(packer, "tileiras_sha256");
+  PackText(packer, toolchain.GetTileirasSha256());
+  PackKey(packer, "tileiras_version");
+  PackText(packer, toolchain.GetTileirasVersion());
