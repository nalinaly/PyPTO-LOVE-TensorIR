+bool IsSha256(std::string_view value) {
+  return value.size() == 64 &&
+         std::all_of(value.begin(), value.end(), [](unsigned char character) {
+           return (character >= '0' && character <= '9') ||
+                  (character >= 'a' && character <= 'f');
+         });
+}
+
+template <typename Function>
+bool Rejects(Function&& function) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+void PackText(msgpack::packer<msgpack::sbuffer>& packer, std::string_view value) {
+  packer.pack_str(static_cast<uint32_t>(value.size()));
+  packer.pack_str_body(value.data(), static_cast<uint32_t>(value.size()));
+}
+
+std::string ObjectKey(const msgpack::object& object) {
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+std::vector<uint8_t> BufferBytes(const msgpack::sbuffer& buffer) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+std::vector<uint8_t> AddUnknownRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    packer.pack(root.get().via.map.ptr[index].key);
+    packer.pack(root.get().via.map.ptr[index].val);
+  }
+  PackText(packer, "unknown_field");
+  packer.pack(1);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddDuplicateRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    packer.pack(root.get().via.map.ptr[index].key);
+    packer.pack(root.get().via.map.ptr[index].val);
+  }
+  PackText(packer, "contract");
+  PackText(packer, Artifact::kContract);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReverseRootOrder(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = root.get().via.map.size; index > 0; --index) {
+    packer.pack(root.get().via.map.ptr[index - 1].key);
+    packer.pack(root.get().via.map.ptr[index - 1].val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceRootText(const std::vector<uint8_t>& canonical,
+                                     std::string_view field_name,
+                                     std::string_view replacement) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == field_name) {
+      PackText(packer, replacement);
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> TamperDeviceCode(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t index = 0; index < root.get().via.map.size; ++index) {
+    const auto& entry = root.get().via.map.ptr[index];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "device_code") {
+      packer.pack(entry.val);
+      continue;
+    }
+    std::vector<uint8_t> bytes(
+        reinterpret_cast<const uint8_t*>(entry.val.via.bin.ptr),
+        reinterpret_cast<const uint8_t*>(entry.val.via.bin.ptr) + entry.val.via.bin.size);
+    bytes.back() ^= 1U;
+    packer.pack_bin(static_cast<uint32_t>(bytes.size()));
+    packer.pack_bin_body(reinterpret_cast<const char*>(bytes.data()),
+                         static_cast<uint32_t>(bytes.size()));
+  }
+  return BufferBytes(buffer);
+}
