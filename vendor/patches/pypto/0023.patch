+template <typename Sink>
+void PackArgumentDescriptor(ArtifactPacker<Sink>& packer,
+                            const ArtifactArgumentDescriptor& descriptor) {
+  packer.pack_map(8);
+  PackKey(packer, "dynamic_size_count");
+  packer.pack(descriptor.GetDynamicSizeCount());
+  PackKey(packer, "dynamic_stride_count");
+  packer.pack(descriptor.GetDynamicStrideCount());
+  PackKey(packer, "explicit_strides");
+  packer.pack(descriptor.HasExplicitStrides());
+  PackKey(packer, "kind");
+  PackText(packer, OperandKindName(descriptor.GetKind()));
+  PackKey(packer, "rank");
+  packer.pack(descriptor.GetRank());
+  PackKey(packer, "scalar_size_bytes");
+  packer.pack(descriptor.GetScalarSizeBytes());
+  PackKey(packer, "shape");
+  PackOptionalIntegers(packer, descriptor.GetShape());
+  PackKey(packer, "strides");
+  PackOptionalIntegers(packer, descriptor.GetStrides());
+}
+
+template <typename Sink>
+void PackArgumentLayout(ArtifactPacker<Sink>& packer,
+                        const ArtifactArgumentLayout& layout) {
+  packer.pack_map(4);
+  PackKey(packer, "input_operand_count");
+  packer.pack(layout.GetInputOperandCount());
+  PackKey(packer, "operand_descriptors");
+  packer.pack_array(static_cast<uint32_t>(layout.GetOperandDescriptors().size()));
+  for (const auto& descriptor : layout.GetOperandDescriptors()) {
+    PackArgumentDescriptor(packer, descriptor);
+  }
+  PackKey(packer, "total_kernel_argument_count");
+  packer.pack(layout.GetTotalKernelArgumentCount());
+  PackKey(packer, "uniform_signature");
+  packer.pack(layout.HasUniformSignature());
+}
