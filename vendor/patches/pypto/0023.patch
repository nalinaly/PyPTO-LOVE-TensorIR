+    OUTPUT_VARIABLE _pypto_git_common_dir
+    ERROR_VARIABLE _pypto_git_common_dir_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+if(NOT _pypto_git_dir_status EQUAL 0 OR
+   NOT _pypto_git_common_dir_status EQUAL 0)
+    message(FATAL_ERROR
+        "Unable to resolve PyPTO Git metadata: "
+        "${_pypto_git_dir_error}${_pypto_git_common_dir_error}")
+endif()
+set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+    "${_pypto_git_dir}/HEAD")
+if(EXISTS "${_pypto_git_common_dir}/packed-refs")
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
+        "${_pypto_git_common_dir}/packed-refs")
+endif()
