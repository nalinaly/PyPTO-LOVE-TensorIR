+template <typename Sink>
+void PackTarget(ArtifactPacker<Sink>& packer, const ArtifactTarget& target) {
+  packer.pack_map(3);
+  PackKey(packer, "compute_capability");
+  packer.pack(target.GetComputeCapability());
+  PackKey(packer, "name");
+  PackText(packer, target.GetName());
+  PackKey(packer, "portability");
+  PackText(packer, TargetPortabilityName(target.GetPortability()));
+}
