+bool IsLowercaseHex(std::string_view value, size_t expected_size) {
+  return value.size() == expected_size &&
+         std::all_of(value.begin(), value.end(), [](unsigned char character) {
+           return (character >= '0' && character <= '9') ||
+                  (character >= 'a' && character <= 'f');
+         });
+}
+
+void RequireSha256(const std::string& value, const std::string& field_name) {
+  if (!IsLowercaseHex(value, 64)) {
+    throw ValueError(field_name + " must be a 64-character lowercase hexadecimal SHA-256");
+  }
+}
+
+void RequireRevision(const std::string& value, const std::string& field_name) {
+  if (!IsLowercaseHex(value, 40)) {
+    throw ValueError(field_name + " must be a full 40-character lowercase hexadecimal revision");
+  }
+}
+
+void RequireText(const std::string& value, const std::string& field_name,
+                 size_t maximum_size = kMaximumStringBytes) {
+  const auto is_ascii_whitespace = [](unsigned char character) {
+    return character == ' ' || character == '\t' || character == '\n' ||
+           character == '\r' || character == '\f' || character == '\v';
+  };
+  if (value.empty() || value.size() > maximum_size || value.find('\0') != std::string::npos ||
+      is_ascii_whitespace(static_cast<unsigned char>(value.front())) ||
+      is_ascii_whitespace(static_cast<unsigned char>(value.back()))) {
+    throw ValueError(field_name + " must be non-empty, bounded, trimmed, and contain no NUL bytes");
+  }
+}
+
+void RequireKernelName(const std::string& value, const std::string& field_name) {
+  if (value.empty() || value.size() > kMaximumKernelNameBytes ||
+      !std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return character >= 0x21 && character <= 0x7e;
+      })) {
+    throw ValueError(field_name + " must contain 1..1024 printable non-whitespace ASCII bytes");
+  }
+}
+
+bool IsPowerOfTwo(uint64_t value) { return value != 0 && (value & (value - 1)) == 0; }
