+    COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}"
+            symbolic-ref --quiet HEAD
+    RESULT_VARIABLE _pypto_symbolic_ref_status
+    OUTPUT_VARIABLE _pypto_symbolic_ref
