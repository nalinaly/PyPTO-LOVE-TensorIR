+/**
+ * Runtime-free producer result accepted by Artifact::CreateStrict.
+ *
+ * This value is the only public input expected from a private lowering bridge.
+ * It contains no compiler IR object, CUDA handle, module, context, stream,
+ * workspace allocation or tensor pointer.
+ */
+class ArtifactProducerResult {
+ public:
+  ArtifactProducerResult() = delete;
+  ArtifactProducerResult(ArtifactTarget requested_target, ArtifactTarget actual_target,
+                         ArtifactKind actual_artifact_kind,
+                         ArtifactBytecodeVersion tile_ir_bytecode_version,
+                         ArtifactKernelAbi kernel_abi,
+                         ArtifactProducerIdentity producer_identity, bool fallback_used,
+                         std::vector<uint8_t> device_code);
+  ArtifactProducerResult(const ArtifactProducerResult&) = default;
+  ArtifactProducerResult(ArtifactProducerResult&&) = default;
+  ArtifactProducerResult& operator=(const ArtifactProducerResult&) = delete;
+  ArtifactProducerResult& operator=(ArtifactProducerResult&&) = delete;
+
+  [[nodiscard]] const ArtifactTarget& GetRequestedTarget() const noexcept {
+    return requested_target_;
+  }
+  [[nodiscard]] const ArtifactTarget& GetActualTarget() const noexcept { return actual_target_; }
+  [[nodiscard]] ArtifactKind GetActualArtifactKind() const noexcept {
+    return actual_artifact_kind_;
