+int TestSerializedPayloadRejections() {
+  const CompileRequest request = MakeRequest();
+  const ArtifactKernelAbi kernel_abi = MakeKernelAbi(false);
+  const KernelBuildSpec build_spec = MakeBuildSpec(request, kernel_abi);
+  const Artifact artifact = Artifact::CreateStrict(
+      request, build_spec,
+      MakeProducerResult(request, build_spec, kernel_abi,
+                         request.GetToolchainIdentity()));
+  const std::vector<uint8_t> canonical = artifact.SerializeCanonical();
+  const auto rejects = [&](const std::vector<uint8_t>& payload) {
+    return Rejects([&]() {
+      (void)Artifact::DeserializeCanonical(payload, request, build_spec);
+    });
+  };
+
+  REQUIRE(rejects({0xc1}));
+  auto trailing = canonical;
+  trailing.push_back(0);
+  REQUIRE(rejects(trailing));
+  auto truncated = canonical;
+  truncated.pop_back();
