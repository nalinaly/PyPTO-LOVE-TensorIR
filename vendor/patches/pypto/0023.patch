+  PackKey(packer, "argument_packing_policy");
+  PackText(packer, PackingPolicyName(kernel.GetArgumentPackingPolicy()));
+  PackKey(packer, "artifact_schema_version");
+  packer.pack(artifact.GetArtifactSchemaVersion());
+  PackKey(packer, "backend");
+  PackText(packer, "nvidia");
+  PackKey(packer, "compiler_abi_version");
+  packer.pack(artifact.GetCompilerAbiVersion());
+  PackKey(packer, "contract");
+  PackText(packer, Artifact::kContract);
+  PackKey(packer, "device_code");
+  PackBinary(packer, artifact.GetDeviceCode());
+  PackKey(packer, "device_code_sha256");
+  PackText(packer, artifact.GetDeviceCodeSha256());
+  PackKey(packer, "entry_function_name");
+  PackText(packer, kernel.GetEntryFunctionName());
+  PackKey(packer, "fallback_used");
