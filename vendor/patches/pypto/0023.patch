+    KernelBuildSpec,
+    NvidiaBackendBuildInfo,
+    NvidiaTargetInfo,
+    RequestedArtifactPolicy,
+    ScheduleParameter,
+    ScheduleValueKind,
+    SemanticRoute,
+    TargetTraits,
+    ToolchainIdentity,
+    get_nvidia_backend_build_info,
+)
+
+PIPELINE_REVISION = "a5398054a515c632506c3f1ffa3a0b5d9e819e83"
+PRODUCER_RESULT_CONTRACT = "tensorir.cuda_tile_compiled_artifact.v1"
+DEVICE_CODE_LIMIT = 64 * 1024 * 1024
+ARTIFACT_PAYLOAD_LIMIT = 68 * 1024 * 1024
+
+
+@pytest.fixture(scope="module")
+def build_info() -> NvidiaBackendBuildInfo:
+    info = get_nvidia_backend_build_info()
+    if not info.compiled:
+        pytest.skip("Artifact v1 requires the compiled private NVIDIA backend")
+    assert info.compiler_factory_available
+    assert info.sm120_target == "sm_120a"
+    assert len(info.pypto_revision) == 40
+    return info
+
+
+def _digest(label: str) -> str:
+    return hashlib.sha256(label.encode("ascii")).hexdigest()
+
+
+def _traits() -> TargetTraits:
+    return TargetTraits(
+        compute_capability=120,
+        multiprocessor_count=82,
+        warp_size=32,
+        max_threads_per_block=1024,
+        max_threads_per_multiprocessor=1536,
+        max_blocks_per_multiprocessor=24,
+        max_block_dim_x=1024,
+        max_block_dim_y=1024,
+        max_block_dim_z=64,
+        max_grid_dim_x=(1 << 31) - 1,
+        max_grid_dim_y=65535,
+        max_grid_dim_z=65535,
+        l1_cache_line_bytes=128,
+        default_shared_memory_per_cta_bytes=48 * 1024,
+        max_shared_memory_per_cta_bytes=101376,
+        shared_memory_per_multiprocessor_bytes=131072,
+        registers_per_cta=65536,
+        max_registers_per_thread=255,
+        registers_per_multiprocessor=65536,
+        l2_cache_size_bytes=96 * 1024 * 1024,
+        total_global_memory_bytes=24 * 1024 * 1024 * 1024,
+    )
+
+
+def _toolchain(info: NvidiaBackendBuildInfo) -> ToolchainIdentity:
+    return ToolchainIdentity(
+        pypto_revision=info.pypto_revision,
+        tensor_ir_revision=info.tensor_ir_revision,
+        cuda_tile_revision=info.cuda_tile_revision,
+        llvm_revision=info.llvm_revision,
+        cuda_toolkit_root=info.cuda_toolkit_root,
+        cuda_toolkit_version=info.cuda_toolkit_version,
+        tileiras_real_path=info.tileiras_real_path,
+        tileiras_version=info.tileiras_version,
+        tileiras_sha256=info.tileiras_sha256,
+    )
+
+
+def _request(info: NvidiaBackendBuildInfo) -> CompileRequest:
+    target = NvidiaTargetInfo(
+        device_ordinal=0,
+        device_name="NVIDIA Artifact test device",
+        device_uuid="GPU-artifact-test",
+        pci_device_id="0000:01:00.0",
+        traits=_traits(),
+        cuda_toolkit_version=info.cuda_toolkit_version,
+        cuda_driver_version="610.74",
+        tensor_ir_revision=info.tensor_ir_revision,
+        cuda_tile_revision=info.cuda_tile_revision,
+        supported_compute_dtypes=[pypto.DataType.BF16, pypto.DataType.FP32],
+    )
+    return CompileRequest(target, _toolchain(info))
+
+
+def _parameter(
+    name: str,
+    kind: ScheduleValueKind,
+    value: str,
+) -> ScheduleParameter:
+    return ScheduleParameter(name, kind, value)
+
+
+def _strict_schedule(tile_sizes: tuple[int, ...] = (16, 16)) -> CanonicalSchedule:
+    return CanonicalSchedule(
+        schedule=[_parameter("codegen_strategy", ScheduleValueKind.Text, "layout-propagation")],
+        tile=[
+            _parameter(f"dim_{index:03d}", ScheduleValueKind.UnsignedInteger, str(tile_size))
+            for index, tile_size in enumerate(tile_sizes)
+        ],
+        layout=[],
+        persistence=[],
+        cta=[_parameter("count", ScheduleValueKind.UnsignedInteger, "1")],
+        warp=[_parameter("count", ScheduleValueKind.UnsignedInteger, "4")],
+        stage=[],
+        options=[
+            _parameter("bytecode_major", ScheduleValueKind.UnsignedInteger, "13"),
+            _parameter("bytecode_minor", ScheduleValueKind.UnsignedInteger, "3"),
+            _parameter("bytecode_tag", ScheduleValueKind.UnsignedInteger, "0"),
+            _parameter("max_candidates", ScheduleValueKind.UnsignedInteger, "0"),
+            _parameter("uniform_signature", ScheduleValueKind.Boolean, "false"),
+        ],
+    )
+
+
+def _tensor_descriptor(dynamic: bool) -> ArtifactArgumentDescriptor:
+    if dynamic:
+        return ArtifactArgumentDescriptor(
+            kind=ArtifactOperandKind.Tensor,
+            rank=2,
+            shape=[None, None],
+            strides=[None, 1],
+            dynamic_size_count=2,
+            dynamic_stride_count=1,
+            explicit_strides=True,
+            scalar_size_bytes=0,
+        )
+    return ArtifactArgumentDescriptor(
+        kind=ArtifactOperandKind.Tensor,
+        rank=2,
+        shape=[8, 8],
+        strides=[8, 1],
+        dynamic_size_count=0,
+        dynamic_stride_count=0,
+        explicit_strides=True,
+        scalar_size_bytes=0,
+    )
+
+
+def _kernel_abi(dynamic: bool, tile_sizes: tuple[int, ...] = (16, 16)) -> ArtifactKernelAbi:
+    descriptors = [_tensor_descriptor(dynamic) for _ in range(3)]
+    layout = ArtifactArgumentLayout(
+        operand_descriptors=descriptors,
+        input_operand_count=2,
+        total_kernel_argument_count=12 if dynamic else 3,
+        uniform_signature=False,
+    )
+    grid = ArtifactGridAbi(
+        policy=(ArtifactGridPolicy.TileBasedRuntime if dynamic else ArtifactGridPolicy.Static),
+        shape_operand_index=0,
+        static_dimensions=[1, 1, 1],
+        tile_sizes=list(tile_sizes),
+    )
+    return ArtifactKernelAbi(
+        runtime_kernel_name="tensor_ir_dynamic" if dynamic else "tensor_ir_static",
+        entry_function_name="kernel_dynamic" if dynamic else "kernel_static",
+        argument_layout=layout,
+        argument_packing_policy=(
+            ArtifactArgumentPackingPolicy.Flat if dynamic else ArtifactArgumentPackingPolicy.PointerOnly
+        ),
+        grid_abi=grid,
+        workspace_abi=ArtifactWorkspaceAbi(ArtifactWorkspaceKind.Static, 0, 1),
+        launch_abi=ArtifactLaunchAbi(
+            block_dimensions=[1, 1, 1],
+            cluster_scheduling_policy=ArtifactClusterSchedulingPolicy.Spread,
+            dynamic_shared_memory_bytes=0,
+            kernel_argument_slot_bytes=8,
+        ),
+        loader_abi=ArtifactLoaderAbi(
+            minimum_cuda_driver_api_version=13000,
+            minimum_cuda_runtime_api_version=13000,
+        ),
+    )
+
+
+def _build_spec(
+    request: CompileRequest,
+    kernel_abi: ArtifactKernelAbi,
+    *,
+    callable_abi_digest: str | None = None,
+    schedule: CanonicalSchedule | None = None,
+) -> KernelBuildSpec:
+    return KernelBuildSpec(
+        source_ir_digest=_digest("artifact-source"),
+        callable_abi_digest=callable_abi_digest or kernel_abi.identity_digest,
+        semantic_route=SemanticRoute.StructuredTensorIr,
+        pipeline_revision=PIPELINE_REVISION,
+        resolved_schedule=schedule or _strict_schedule(),
+        static_specialization_digest=_digest("artifact-static-specialization"),
+        symbolic_specialization_digest=_digest("artifact-symbolic-specialization"),
+        argument_abi_digest=_digest("artifact-argument-abi"),
+        result_abi_digest=_digest("artifact-result-abi"),
+        mutation_abi_digest=_digest("artifact-mutation-abi"),
+        compile_request_byte_identity_digest=request.byte_compile_identity_digest,
+        catalog_provenance=None,
+    )
+
+
+def _artifact_target(name: str = "sm_120a", compute_capability: int = 120) -> ArtifactTarget:
+    return ArtifactTarget(
+        compute_capability=compute_capability,
+        name=name,
+        portability=ArtifactTargetPortability.ArchConditional,
+    )
+
+
+def _kernel_argument_sizes(kernel_abi: ArtifactKernelAbi) -> list[int]:
+    sizes: list[int] = []
+    for descriptor in kernel_abi.argument_layout.operand_descriptors:
+        if descriptor.kind == ArtifactOperandKind.Scalar:
+            sizes.append(descriptor.scalar_size_bytes)
+            continue
+        sizes.append(8)
+        sizes.extend([4] * descriptor.dynamic_size_count)
+        sizes.extend([4] * descriptor.dynamic_stride_count)
+    return sizes
+
+
+def _write_elf_section(
+    image: bytearray,
+    header_offset: int,
+    *,
+    name_offset: int,
+    section_type: int,
+    file_offset: int = 0,
+    size: int = 0,
+    link: int = 0,
+    info: int = 0,
+    alignment: int = 1,
+    entry_size: int = 0,
+) -> None:
+    struct.pack_into("<I", image, header_offset, name_offset)
+    struct.pack_into("<I", image, header_offset + 4, section_type)
+    struct.pack_into("<Q", image, header_offset + 8, 0)
+    struct.pack_into("<Q", image, header_offset + 24, file_offset)
+    struct.pack_into("<Q", image, header_offset + 32, size)
+    struct.pack_into("<I", image, header_offset + 40, link)
+    struct.pack_into("<I", image, header_offset + 44, info)
+    struct.pack_into("<Q", image, header_offset + 48, alignment)
+    struct.pack_into("<Q", image, header_offset + 56, entry_size)
+
+
+def _sm120_cubin(
+    entry_function_name: str,
+    kernel_argument_sizes: list[int],
+    compute_capability: int = 120,
+) -> bytes:
+    """Return a bounded structural CUDA ELF64 ABI test image."""
+    elf_header_size = 64
+    section_header_size = 64
+    section_count = 7
+    section_headers_offset = elf_header_size
+
+    section_names = bytearray(b"\x00")
+
+    def add_section_name(name: str) -> int:
+        offset = len(section_names)
+        section_names.extend(name.encode("ascii"))
+        section_names.append(0)
+        return offset
+
+    text_name_offset = add_section_name(f".text.{entry_function_name}")
+    symbol_name_offset = add_section_name(".symtab")
+    string_name_offset = add_section_name(".strtab")
+    metadata_name_offset = add_section_name(f".nv.info.{entry_function_name}")
+    constant_name_offset = add_section_name(f".nv.constant0.{entry_function_name}")
+    section_string_name_offset = add_section_name(".shstrtab")
+    symbol_names = b"\x00" + entry_function_name.encode("ascii") + b"\x00"
+
+    parameter_offsets: list[int] = []
+    parameter_bytes = 0
+    for argument_size in kernel_argument_sizes:
+        alignment = min(argument_size, 8)
+        parameter_bytes = (parameter_bytes + alignment - 1) & ~(alignment - 1)
+        parameter_offsets.append(parameter_bytes)
+        parameter_bytes += argument_size
+
+    section_name_table_offset = section_headers_offset + section_header_size * section_count
+    symbol_name_table_offset = section_name_table_offset + len(section_names)
+    symbol_table_offset = (symbol_name_table_offset + len(symbol_names) + 7) & ~7
+    symbol_table_size = 72
+    metadata_offset = symbol_table_offset + symbol_table_size
+    metadata_size = len(kernel_argument_sizes) * 16 + 16
+    constant_offset = (metadata_offset + metadata_size + 3) & ~3
+    text_offset = (constant_offset + parameter_bytes + 15) & ~15
+    text_size = 16
+    program_header_offset = text_offset + text_size
+    program_header_size = 56
+    image = bytearray(program_header_offset + program_header_size)
+
+    image[:4] = b"\x7fELF"
+    image[4] = 2  # ELFCLASS64
+    image[5] = 1  # ELFDATA2LSB
+    image[6] = 1  # EV_CURRENT
+    image[7] = 0x41  # CUDA Tile OSABI
+    image[8] = 8  # CUDA ELF ABI v2
+    struct.pack_into("<H", image, 16, 2)  # ET_EXEC
+    struct.pack_into("<H", image, 18, 190)  # EM_CUDA
+    struct.pack_into("<I", image, 20, 1)  # e_version
+    struct.pack_into("<Q", image, 32, program_header_offset)
+    struct.pack_into("<Q", image, 40, section_headers_offset)
+    struct.pack_into("<I", image, 48, compute_capability << 8)
+    struct.pack_into("<H", image, 52, elf_header_size)
+    struct.pack_into("<H", image, 54, program_header_size)
+    struct.pack_into("<H", image, 56, 1)
+    struct.pack_into("<H", image, 58, section_header_size)
+    struct.pack_into("<H", image, 60, section_count)
+    struct.pack_into("<H", image, 62, 6)  # .shstrtab section index
+
+    text_section = section_headers_offset + section_header_size
+    _write_elf_section(
+        image,
+        text_section,
+        name_offset=text_name_offset,
+        section_type=1,
+        file_offset=text_offset,
+        size=text_size,
+        link=2,
+        info=2,
+        alignment=16,
+    )
+    struct.pack_into("<Q", image, text_section + 8, 6)  # ALLOC | EXECINSTR
+
+    symbol_section = text_section + section_header_size
+    _write_elf_section(
+        image,
+        symbol_section,
+        name_offset=symbol_name_offset,
+        section_type=2,
+        file_offset=symbol_table_offset,
+        size=symbol_table_size,
+        link=3,
+        info=2,
+        alignment=8,
+        entry_size=24,
+    )
+
+    symbol_string_section = symbol_section + section_header_size
+    _write_elf_section(
+        image,
+        symbol_string_section,
+        name_offset=string_name_offset,
+        section_type=3,
+        file_offset=symbol_name_table_offset,
+        size=len(symbol_names),
+    )
+
+    metadata_section = symbol_string_section + section_header_size
+    _write_elf_section(
+        image,
+        metadata_section,
+        name_offset=metadata_name_offset,
+        section_type=0x70000000,
+        file_offset=metadata_offset,
+        size=metadata_size,
+        link=2,
+        info=1,
+        alignment=4,
+    )
+
+    constant_section = metadata_section + section_header_size
+    _write_elf_section(
+        image,
+        constant_section,
+        name_offset=constant_name_offset,
+        section_type=1,
+        file_offset=constant_offset,
+        size=parameter_bytes,
+        info=1,
+        alignment=4,
+    )
+
+    section_string_section = constant_section + section_header_size
+    _write_elf_section(
+        image,
+        section_string_section,
+        name_offset=section_string_name_offset,
+        section_type=3,
+        file_offset=section_name_table_offset,
+        size=len(section_names),
+    )
+
+    image[section_name_table_offset : section_name_table_offset + len(section_names)] = section_names
+    image[symbol_name_table_offset : symbol_name_table_offset + len(symbol_names)] = symbol_names
+    constant_symbol = symbol_table_offset + 24
+    image[constant_symbol + 4] = 0x03  # STB_LOCAL | STT_SECTION
+    struct.pack_into("<H", image, constant_symbol + 6, 5)
+    entry_symbol = symbol_table_offset + 48
+    struct.pack_into("<I", image, entry_symbol, 1)
+    image[entry_symbol + 4] = 0x12  # STB_GLOBAL | STT_FUNC
+    image[entry_symbol + 5] = 0x10  # STO_CUDA_ENTRY
+    struct.pack_into("<H", image, entry_symbol + 6, 1)  # .text
+    struct.pack_into("<Q", image, entry_symbol + 16, text_size)
+
+    for ordinal, (argument_size, parameter_offset) in enumerate(
+        zip(kernel_argument_sizes, parameter_offsets, strict=True)
+    ):
+        record = metadata_offset + ordinal * 16
+        image[record] = 4
+        image[record + 1] = 0x17
+        struct.pack_into("<H", image, record + 2, 12)
+        struct.pack_into("<H", image, record + 8, ordinal)
+        struct.pack_into("<H", image, record + 10, parameter_offset)
+        struct.pack_into("<I", image, record + 12, (argument_size << 18) | 0x1F400)
+    parameter_bank_record = metadata_offset + len(kernel_argument_sizes) * 16
+    image[parameter_bank_record] = 4
+    image[parameter_bank_record + 1] = 0x0A
+    struct.pack_into("<H", image, parameter_bank_record + 2, 8)
+    struct.pack_into("<I", image, parameter_bank_record + 4, 1)
+    struct.pack_into("<I", image, parameter_bank_record + 8, parameter_bytes << 16)
+    constant_bank_record = parameter_bank_record + 12
+    image[constant_bank_record] = 3
+    image[constant_bank_record + 1] = 0x19
+    struct.pack_into("<H", image, constant_bank_record + 2, parameter_bytes)
+    image[text_offset : text_offset + 4] = b"\xde\xad\xbe\xef"
+    struct.pack_into("<I", image, program_header_offset, 1)  # PT_LOAD
+    struct.pack_into("<Q", image, program_header_offset + 32, len(image))
+    struct.pack_into("<Q", image, program_header_offset + 40, len(image))
+    struct.pack_into("<Q", image, program_header_offset + 48, 8)
+    return bytes(image)
+
+
+def _producer_identity(
+    request: CompileRequest,
+    build_spec: KernelBuildSpec,
+    *,
+    options_identity_digest: str | None = None,
+) -> ArtifactProducerIdentity:
+    return ArtifactProducerIdentity(
+        kind=ArtifactProducerKind.TensorIrCudaTile,
+        toolchain_identity=request.toolchain_identity,
+        pipeline_revision=PIPELINE_REVISION,
+        producer_result_contract=PRODUCER_RESULT_CONTRACT,
+        options_identity_digest=(
+            options_identity_digest or Artifact.get_producer_options_identity_digest(request, build_spec)
+        ),
+        environment_overrides_enabled=False,
+        artifact_fallback_allowed=False,
+    )
+
+
+def _producer_result(
+    request: CompileRequest,
+    build_spec: KernelBuildSpec,
+    kernel_abi: ArtifactKernelAbi,
+    *,
+    fallback_used: bool = False,
+    device_code: bytes | None = None,
+    actual_target: ArtifactTarget | None = None,
+    options_identity_digest: str | None = None,
+) -> ArtifactProducerResult:
+    return ArtifactProducerResult(
+        requested_target=_artifact_target(),
+        actual_target=actual_target or _artifact_target(),
+        actual_artifact_kind=ArtifactKind.Cubin,
+        tile_ir_bytecode_version=ArtifactBytecodeVersion(13, 3, 0),
+        kernel_abi=kernel_abi,
+        producer_identity=_producer_identity(
+            request,
+            build_spec,
+            options_identity_digest=options_identity_digest,
+        ),
+        fallback_used=fallback_used,
+        device_code=(
+            device_code
+            if device_code is not None
+            else _sm120_cubin(
+                kernel_abi.entry_function_name,
+                _kernel_argument_sizes(kernel_abi),
+            )
+        ),
+    )
+
+
+def _case(
+    info: NvidiaBackendBuildInfo,
+    *,
+    dynamic: bool,
+) -> tuple[CompileRequest, KernelBuildSpec, ArtifactKernelAbi, ArtifactProducerResult, Artifact]:
+    request = _request(info)
+    kernel_abi = _kernel_abi(dynamic)
+    build_spec = _build_spec(request, kernel_abi)
+    producer_result = _producer_result(request, build_spec, kernel_abi)
+    artifact = Artifact.create_strict(request, build_spec, producer_result)
+    return request, build_spec, kernel_abi, producer_result, artifact
+
+
+def test_static_artifact_round_trip_and_all_identity_projections(
+    build_info: NvidiaBackendBuildInfo,
+) -> None:
+    request, build_spec, kernel_abi, producer_result, artifact = _case(build_info, dynamic=False)
+    canonical = artifact.serialize()
+    restored = Artifact.deserialize(canonical, request, build_spec)
+
+    assert restored.serialize() == canonical
+    assert artifact.artifact_schema_version == 1
+    assert artifact.compiler_abi_version == 1
+    assert artifact.backend_type == backend.BackendType.Nvidia
+    assert artifact.requested_artifact_policy == RequestedArtifactPolicy.CubinOnly
+    assert artifact.actual_artifact_kind == ArtifactKind.Cubin
+    assert artifact.requested_target.name == "sm_120a"
+    assert artifact.actual_target.compute_capability == 120
+    assert artifact.semantic_route == SemanticRoute.StructuredTensorIr
+    assert not artifact.fallback_used
+
+    assert isinstance(artifact.device_code, bytes)
+    assert artifact.device_code == _sm120_cubin(
+        kernel_abi.entry_function_name, _kernel_argument_sizes(kernel_abi)
+    )
+    assert producer_result.device_code == artifact.device_code
+    assert artifact.device_code_sha256 == hashlib.sha256(artifact.device_code).hexdigest()
+    assert artifact.identity_digest == hashlib.sha256(canonical).hexdigest()
+
+    kernel_identity = kernel_abi.serialize_identity()
+    assert isinstance(kernel_identity, bytes)
+    assert kernel_abi.identity_digest == hashlib.sha256(kernel_identity).hexdigest()
+    assert artifact.identities.callable_abi_digest == kernel_abi.identity_digest
+    assert artifact.identities.kernel_build_spec_digest == build_spec.identity_digest
+
+    options_identity = Artifact.serialize_producer_options_identity(request, build_spec)
+    options_digest = Artifact.get_producer_options_identity_digest(request, build_spec)
+    assert isinstance(options_identity, bytes)
+    assert options_digest == hashlib.sha256(options_identity).hexdigest()
+    assert artifact.producer_identity.options_identity_digest == options_digest
+    assert not artifact.producer_identity.environment_overrides_enabled
+    assert not artifact.producer_identity.artifact_fallback_allowed
+
+    cache_identity = artifact.serialize_cache_key_identity()
+    assert artifact.cache_key_digest == hashlib.sha256(cache_identity).hexdigest()
+    assert cache_identity == Artifact.serialize_cache_key_identity_for(
+        request, build_spec, artifact.producer_identity
+    )
+    assert artifact.cache_key_digest == Artifact.get_cache_key_digest_for(
+        request, build_spec, artifact.producer_identity
+    )
+
+    loader_identity = artifact.serialize_loader_compatibility()
+    assert artifact.loader_compatibility_digest == hashlib.sha256(loader_identity).hexdigest()
+    assert artifact.kernel_abi.loader_abi.minimum_cuda_driver_api_version == 13000
+    assert artifact.kernel_abi.loader_abi.minimum_cuda_runtime_api_version == 13000
+
+    with pytest.raises(AttributeError):
+        artifact.device_code = b"changed"  # type: ignore[misc]
+    with pytest.raises(AttributeError):
+        artifact.producer_identity.options_identity_digest = "0" * 64  # type: ignore[misc]
+    mutable_copy = bytearray(artifact.device_code)
+    mutable_copy[0] = 0
+    assert artifact.device_code == _sm120_cubin(
+        kernel_abi.entry_function_name, _kernel_argument_sizes(kernel_abi)
+    )
+
+
+def test_dynamic_artifact_round_trip_preserves_flat_abi(
+    build_info: NvidiaBackendBuildInfo,
+) -> None:
+    request, build_spec, kernel_abi, _, artifact = _case(build_info, dynamic=True)
+    restored = Artifact.deserialize(artifact.serialize(), request, build_spec)
+    layout = restored.kernel_abi.argument_layout
+
+    assert restored.kernel_abi.argument_packing_policy == ArtifactArgumentPackingPolicy.Flat
+    assert restored.kernel_abi.grid_abi.policy == ArtifactGridPolicy.TileBasedRuntime
+    assert layout.total_kernel_argument_count == 12
+    assert layout.operand_descriptors[0].shape == [None, None]
+    assert layout.operand_descriptors[0].strides == [None, 1]
+    assert layout.operand_descriptors[0].dynamic_size_count == 2
+    assert layout.operand_descriptors[0].dynamic_stride_count == 1
+    assert kernel_abi.identity_digest == build_spec.callable_abi_digest
+
