+template <typename Sink>
+using ArtifactPacker = msgpack::packer<Sink>;
+
+template <typename Sink>
+void PackText(ArtifactPacker<Sink>& packer, std::string_view value) {
+  if (value.size() > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError("canonical MessagePack string exceeds uint32 range");
+  }
+  const auto size = static_cast<uint32_t>(value.size());
+  packer.pack_str(size);
+  if (size != 0) packer.pack_str_body(value.data(), size);
+}
+
+template <typename Sink>
+void PackKey(ArtifactPacker<Sink>& packer, std::string_view value) {
+  PackText(packer, value);
+}
+
+template <typename Sink>
+void PackBinary(ArtifactPacker<Sink>& packer, const std::vector<uint8_t>& value) {
+  if (value.size() > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError("canonical MessagePack binary data exceeds uint32 range");
+  }
+  const auto size = static_cast<uint32_t>(value.size());
+  packer.pack_bin(size);
+  if (size != 0) {
+    packer.pack_bin_body(reinterpret_cast<const char*>(value.data()), size);
+  }
+}
+
+template <typename Sink>
+void PackOptionalIntegers(ArtifactPacker<Sink>& packer,
+                          const std::vector<std::optional<int64_t>>& values) {
+  packer.pack_array(static_cast<uint32_t>(values.size()));
+  for (const auto& value : values) {
+    if (value.has_value()) {
+      packer.pack(*value);
+    } else {
+      packer.pack_nil();
+    }
+  }
+}
