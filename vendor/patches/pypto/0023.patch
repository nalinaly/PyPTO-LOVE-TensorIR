+/**
+ * Immutable description of one source-level operand in the flat kernel ABI.
+ *
+ * A std::nullopt shape or stride element represents a runtime-dynamic value.
+ * Scalar operands have rank zero, empty shape/stride vectors and a byte width
+ * from one through eight. Tensor operands have scalar_size_bytes equal to zero.
+ * The dynamic counts name flat size/stride argument slots; with a uniform
+ * signature they equal the full rank even when every metadata value is static.
+ */
+class ArtifactArgumentDescriptor {
+ public:
+  ArtifactArgumentDescriptor() = delete;
+  ArtifactArgumentDescriptor(ArtifactOperandKind kind, uint32_t rank,
+                             std::vector<std::optional<int64_t>> shape,
+                             std::vector<std::optional<int64_t>> strides,
+                             uint32_t dynamic_size_count, uint32_t dynamic_stride_count,
+                             bool explicit_strides, uint32_t scalar_size_bytes);
+  ArtifactArgumentDescriptor(const ArtifactArgumentDescriptor&) = default;
+  ArtifactArgumentDescriptor(ArtifactArgumentDescriptor&&) = default;
+  ArtifactArgumentDescriptor& operator=(const ArtifactArgumentDescriptor&) = delete;
+  ArtifactArgumentDescriptor& operator=(ArtifactArgumentDescriptor&&) = delete;
+
+  [[nodiscard]] ArtifactOperandKind GetKind() const noexcept { return kind_; }
+  [[nodiscard]] uint32_t GetRank() const noexcept { return rank_; }
+  [[nodiscard]] const std::vector<std::optional<int64_t>>& GetShape() const noexcept {
+    return shape_;
+  }
+  [[nodiscard]] const std::vector<std::optional<int64_t>>& GetStrides() const noexcept {
+    return strides_;
+  }
+  [[nodiscard]] uint32_t GetDynamicSizeCount() const noexcept { return dynamic_size_count_; }
+  [[nodiscard]] uint32_t GetDynamicStrideCount() const noexcept { return dynamic_stride_count_; }
+  [[nodiscard]] bool HasExplicitStrides() const noexcept { return explicit_strides_; }
+  [[nodiscard]] uint32_t GetScalarSizeBytes() const noexcept { return scalar_size_bytes_; }
+
+ private:
+  ArtifactOperandKind kind_;
+  uint32_t rank_;
+  std::vector<std::optional<int64_t>> shape_;
+  std::vector<std::optional<int64_t>> strides_;
+  uint32_t dynamic_size_count_;
+  uint32_t dynamic_stride_count_;
+  bool explicit_strides_;
+  uint32_t scalar_size_bytes_;
+};
