+int TestStaticArtifact() {
+  const CompileRequest request = MakeRequest();
+  const ArtifactKernelAbi kernel_abi = MakeKernelAbi(false);
+  const KernelBuildSpec build_spec = MakeBuildSpec(request, kernel_abi);
+  const ArtifactProducerResult producer =
+      MakeProducerResult(request, build_spec, kernel_abi, request.GetToolchainIdentity());
+  const std::string precompile_cache_digest = Artifact::GetCacheKeyDigest(
+      request, build_spec, producer.GetProducerIdentity());
+
+  const Artifact artifact = Artifact::CreateStrict(request, build_spec, producer);
+  REQUIRE(artifact.GetArtifactSchemaVersion() == 1);
+  REQUIRE(artifact.GetCompilerAbiVersion() == 1);
+  REQUIRE(artifact.GetRequestedArtifactPolicy() ==
+          pypto::compiler::RequestedArtifactPolicy::CubinOnly);
+  REQUIRE(artifact.GetActualArtifactKind() == ArtifactKind::Cubin);
+  REQUIRE(artifact.GetRequestedTarget().GetName() == "sm_120a");
+  REQUIRE(artifact.GetActualTarget().GetComputeCapability() == 120);
+  REQUIRE(artifact.GetTileIrBytecodeVersion().GetMajor() == 13);
+  REQUIRE(artifact.GetSemanticRoute() == SemanticRoute::StructuredTensorIr);
+  REQUIRE(!artifact.UsedFallback());
+  REQUIRE(artifact.GetDeviceCode() == producer.GetDeviceCode());
+  REQUIRE(IsSha256(artifact.GetDeviceCodeSha256()));
+
+  const auto& kernel = artifact.GetKernelAbi();
+  REQUIRE(kernel.GetArgumentPackingPolicy() ==
+          ArtifactArgumentPackingPolicy::PointerOnly);
+  REQUIRE(kernel.GetGridAbi().GetPolicy() == ArtifactGridPolicy::Static);
+  REQUIRE((kernel.GetGridAbi().GetStaticDimensions() ==
+           std::array<uint32_t, 3>{4, 1, 1}));
+  REQUIRE(kernel.GetArgumentLayout().GetTotalKernelArgumentCount() == 3);
+  REQUIRE(kernel.GetArgumentLayout().GetOperandDescriptors()[1].GetKind() ==
+          ArtifactOperandKind::Scalar);
+  REQUIRE(kernel.GetArgumentLayout().GetOperandDescriptors()[1].GetScalarSizeBytes() == 4);
+
+  REQUIRE(artifact.GetIdentities().GetCompileRequestByteIdentityDigest() ==
+          request.GetByteCompileIdentityDigest());
+  REQUIRE(artifact.GetIdentities().GetKernelBuildSpecDigest() ==
+          build_spec.GetIdentityDigest());
+  REQUIRE(artifact.GetCacheKeyDigest() == precompile_cache_digest);
+  REQUIRE(artifact.SerializeCacheKeyIdentity() == Artifact::SerializeCacheKeyIdentity(
+              request, build_spec, producer.GetProducerIdentity()));
+
+  const std::vector<uint8_t> canonical = artifact.SerializeCanonical();
+  REQUIRE(canonical == artifact.SerializeCanonical());
+  const Artifact restored =
+      Artifact::DeserializeCanonical(canonical, request, build_spec);
+  REQUIRE(restored.SerializeCanonical() == canonical);
+  REQUIRE(restored.GetDeviceCodeSha256() == artifact.GetDeviceCodeSha256());
+  REQUIRE(restored.GetIdentityDigest() == artifact.GetIdentityDigest());
+  REQUIRE(restored.GetCacheKeyDigest() == artifact.GetCacheKeyDigest());
+  REQUIRE(restored.GetLoaderCompatibilityDigest() ==
+          artifact.GetLoaderCompatibilityDigest());
+  REQUIRE(restored.SerializeLoaderCompatibility() ==
+          artifact.SerializeLoaderCompatibility());
+  REQUIRE(IsSha256(artifact.GetIdentityDigest()));
+  REQUIRE(IsSha256(artifact.GetCacheKeyDigest()));
+  REQUIRE(IsSha256(artifact.GetLoaderCompatibilityDigest()));
+  REQUIRE(artifact.GetIdentityDigest() != artifact.GetCacheKeyDigest());
+  REQUIRE(artifact.GetCacheKeyDigest() != artifact.GetLoaderCompatibilityDigest());
+  return 0;
+}
