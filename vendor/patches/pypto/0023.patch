+struct StrictProducerOptions {
+  std::vector<uint32_t> tile_sizes;
+  bool uniform_signature;
+};
+
+void RequireScheduleParameter(const std::vector<ScheduleParameter>& parameters, size_t index,
+                              std::string_view name, ScheduleValueKind kind,
+                              std::string_view value, std::string_view category) {
+  if (index >= parameters.size() || parameters[index].GetName() != name ||
+      parameters[index].GetValueKind() != kind ||
+      parameters[index].GetCanonicalValue() != value) {
+    throw ValueError("KernelBuildSpec " + std::string(category) +
+                     " category differs from structured-tensorir-explicit-v1");
+  }
+}
+
+uint32_t ParseStrictTileSize(const ScheduleParameter& parameter, size_t index) {
+  std::string expected_name = "dim_";
+  expected_name.push_back(static_cast<char>('0' + (index / 100U) % 10U));
+  expected_name.push_back(static_cast<char>('0' + (index / 10U) % 10U));
+  expected_name.push_back(static_cast<char>('0' + index % 10U));
+  if (parameter.GetName() != expected_name ||
+      parameter.GetValueKind() != ScheduleValueKind::UnsignedInteger) {
+    throw ValueError("KernelBuildSpec tile category must use contiguous dim_NNN unsigned values");
+  }
+  uint64_t value = 0;
+  const std::string& text = parameter.GetCanonicalValue();
+  const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size() || value == 0 ||
+      value > static_cast<uint64_t>(std::numeric_limits<int32_t>::max())) {
+    throw ValueError("KernelBuildSpec tile size is outside the strict int32 range");
+  }
+  return static_cast<uint32_t>(value);
+}
+
+StrictProducerOptions ResolveStrictProducerOptions(const CompileRequest& request,
+                                                   const KernelBuildSpec& build_spec) {
+  if (build_spec.GetPipelineRevision() != Artifact::kStructuredTensorIrPipelineRevision ||
+      build_spec.GetSemanticRoute() != SemanticRoute::StructuredTensorIr ||
+      build_spec.GetCompileRequestByteIdentityDigest() !=
+          request.GetByteCompileIdentityDigest()) {
+    throw ValueError("KernelBuildSpec does not select structured-tensorir-explicit-v1");
+  }
+  const auto& schedule = build_spec.GetResolvedSchedule();
+  if (schedule.GetSchedule().size() != 1 || schedule.GetCta().size() != 1 ||
+      schedule.GetWarp().size() != 1 || schedule.GetOptions().size() != 5 ||
+      !schedule.GetLayout().empty() || !schedule.GetPersistence().empty() ||
+      !schedule.GetStage().empty() || schedule.GetTile().empty() ||
+      schedule.GetTile().size() > Artifact::kMaximumTileDimensions) {
+    throw ValueError("KernelBuildSpec resolved schedule has unsupported strict category cardinality");
+  }
+  RequireScheduleParameter(schedule.GetSchedule(), 0, "codegen_strategy",
+                           ScheduleValueKind::Text, "layout-propagation", "schedule");
+  RequireScheduleParameter(schedule.GetCta(), 0, "count",
+                           ScheduleValueKind::UnsignedInteger, "1", "cta");
+  RequireScheduleParameter(schedule.GetWarp(), 0, "count",
+                           ScheduleValueKind::UnsignedInteger, "4", "warp");
+  RequireScheduleParameter(schedule.GetOptions(), 0, "bytecode_major",
+                           ScheduleValueKind::UnsignedInteger, "13", "options");
+  RequireScheduleParameter(schedule.GetOptions(), 1, "bytecode_minor",
+                           ScheduleValueKind::UnsignedInteger, "3", "options");
+  RequireScheduleParameter(schedule.GetOptions(), 2, "bytecode_tag",
+                           ScheduleValueKind::UnsignedInteger, "0", "options");
+  RequireScheduleParameter(schedule.GetOptions(), 3, "max_candidates",
+                           ScheduleValueKind::UnsignedInteger, "0", "options");
+  RequireScheduleParameter(schedule.GetOptions(), 4, "uniform_signature",
+                           ScheduleValueKind::Boolean, "false", "options");
+
+  StrictProducerOptions options;
+  options.uniform_signature = false;
+  options.tile_sizes.reserve(schedule.GetTile().size());
+  for (size_t index = 0; index < schedule.GetTile().size(); ++index) {
+    options.tile_sizes.push_back(ParseStrictTileSize(schedule.GetTile()[index], index));
+  }
+  return options;
+}
