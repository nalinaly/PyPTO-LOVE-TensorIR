+NvidiaCubinValidationResult ValidatePrivateNvidiaCubin(
+    const std::vector<uint8_t>& device_code, int32_t compute_capability,
+    const std::string& entry_function_name,
+    const std::vector<uint32_t>& kernel_argument_sizes) {
+  auto target = mlir::nv_tensor_ir::SmTarget::fromCc(
+      compute_capability,
+      mlir::nv_tensor_ir::ArchPortability::arch_conditional);
+  if (mlir::failed(target)) return {false, "unsupported NVIDIA Cubin target"};
+  auto bytecode_version = mlir::cuda_tile::BytecodeVersion::fromVersion(13, 3, 0);
+  if (!bytecode_version) return {false, "unsupported CUDA Tile bytecode version"};
+  const auto* begin = reinterpret_cast<const char*>(device_code.data());
+  auto status = mlir::nv_tensor_ir::backend::cuda_tile::validateCudaTileDeviceCode(
+      llvm::ArrayRef<char>(begin, device_code.size()),
+      mlir::nv_tensor_ir::backend::cuda_tile::CudaTileArtifactKind::Cubin,
+      *target, *bytecode_version, entry_function_name,
+      kernel_argument_sizes);
+  if (!status.ok()) return {false, status.message()};
+  return {true, {}};
+}
+
 }  // namespace pypto::compiler::detail
