+def test_strict_creation_rejects_fallback_target_options_callable_and_cubin_drift(
+    build_info: NvidiaBackendBuildInfo,
+) -> None:
+    request = _request(build_info)
+    kernel_abi = _kernel_abi(False)
+    build_spec = _build_spec(request, kernel_abi)
+
+    with pytest.raises(ValueError, match="no fallback"):
+        Artifact.create_strict(
+            request,
+            build_spec,
+            _producer_result(request, build_spec, kernel_abi, fallback_used=True),
+        )
+
+    with pytest.raises(ValueError, match="options identity"):
+        Artifact.create_strict(
+            request,
+            build_spec,
+            _producer_result(
+                request,
+                build_spec,
+                kernel_abi,
+                options_identity_digest="0" * 64,
+            ),
+        )
+
+    with pytest.raises(ValueError, match="sm_120a"):
+        Artifact.create_strict(
+            request,
+            build_spec,
+            _producer_result(
+                request,
+                build_spec,
+                kernel_abi,
+                actual_target=_artifact_target("sm_121a", 121),
+            ),
+        )
+
+    wrong_callable = _build_spec(
+        request,
+        kernel_abi,
+        callable_abi_digest=_digest("wrong-callable-abi"),
+    )
+    with pytest.raises(ValueError, match="callable_abi_digest"):
+        Artifact.create_strict(
+            request,
+            wrong_callable,
+            _producer_result(request, wrong_callable, kernel_abi),
+        )
+
+    wrong_tile_abi = _kernel_abi(False, (32, 16))
+    wrong_tile_spec = _build_spec(request, wrong_tile_abi)
+    with pytest.raises(ValueError, match="tile sizes"):
+        Artifact.create_strict(
+            request,
+            wrong_tile_spec,
+            _producer_result(request, wrong_tile_spec, wrong_tile_abi),
+        )
+
+    with pytest.raises(ValueError, match="entry function"):
+        Artifact.create_strict(
+            request,
+            build_spec,
+            _producer_result(
+                request,
+                build_spec,
+                kernel_abi,
+                device_code=_sm120_cubin("another_entry", _kernel_argument_sizes(kernel_abi)),
+            ),
+        )
+
+    wrong_cubin = bytearray(_sm120_cubin(kernel_abi.entry_function_name, _kernel_argument_sizes(kernel_abi)))
+    struct.pack_into("<I", wrong_cubin, 48, 121 << 8)
+    with pytest.raises(ValueError, match="Cubin validation"):
+        Artifact.create_strict(
+            request,
+            build_spec,
+            _producer_result(request, build_spec, kernel_abi, device_code=bytes(wrong_cubin)),
+        )
+
+
+def test_invalid_strict_schedule_and_malformed_payloads_are_rejected(
+    build_info: NvidiaBackendBuildInfo,
+) -> None:
+    request, build_spec, kernel_abi, _, artifact = _case(build_info, dynamic=False)
+    bad_schedule = _strict_schedule()
+    bad_schedule = CanonicalSchedule(
+        schedule=bad_schedule.schedule,
+        tile=bad_schedule.tile,
+        layout=bad_schedule.layout,
+        persistence=bad_schedule.persistence,
+        cta=bad_schedule.cta,
+        warp=bad_schedule.warp,
+        stage=bad_schedule.stage,
+        options=[
+            _parameter("bytecode_major", ScheduleValueKind.UnsignedInteger, "13"),
+            _parameter("bytecode_minor", ScheduleValueKind.UnsignedInteger, "3"),
+            _parameter("bytecode_tag", ScheduleValueKind.UnsignedInteger, "0"),
+            _parameter("max_candidates", ScheduleValueKind.UnsignedInteger, "1"),
+            _parameter("uniform_signature", ScheduleValueKind.Boolean, "false"),
+        ],
+    )
+    bad_spec = _build_spec(request, kernel_abi, schedule=bad_schedule)
+    with pytest.raises(ValueError, match="options category"):
+        Artifact.get_producer_options_identity_digest(request, bad_spec)
+
+    canonical = artifact.serialize()
+    malformed_payloads = [
+        b"",
+        b"\xc1",
+        b"\x81\xadunknown_field\x01",
+        canonical + b"\x00",
+        canonical[:-1],
+    ]
+    for payload in malformed_payloads:
+        with pytest.raises(ValueError):
+            Artifact.deserialize(payload, request, build_spec)
+
+    _, dynamic_spec, _, _, _ = _case(build_info, dynamic=True)
+    with pytest.raises(ValueError, match="identities differ"):
+        Artifact.deserialize(canonical, request, dynamic_spec)
+
+
+def test_python_bytes_bounds_reject_before_cpp_copy(
+    build_info: NvidiaBackendBuildInfo,
+) -> None:
+    request = _request(build_info)
+    kernel_abi = _kernel_abi(False)
+    build_spec = _build_spec(request, kernel_abi)
+    producer_identity = _producer_identity(request, build_spec)
+
+    with pytest.raises(ValueError, match="64 MiB"):
+        ArtifactProducerResult(
+            requested_target=_artifact_target(),
+            actual_target=_artifact_target(),
+            actual_artifact_kind=ArtifactKind.Cubin,
+            tile_ir_bytecode_version=ArtifactBytecodeVersion(13, 3, 0),
+            kernel_abi=kernel_abi,
+            producer_identity=producer_identity,
+            fallback_used=False,
+            device_code=b"\x00" * (DEVICE_CODE_LIMIT + 1),
+        )
+
+    with pytest.raises(ValueError, match="68 MiB"):
+        Artifact.deserialize(
+            b"\x00" * (ARTIFACT_PAYLOAD_LIMIT + 1),
+            request,
+            build_spec,
+        )
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
