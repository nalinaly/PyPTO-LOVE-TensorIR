+  PackLaunchAbi(packer, kernel.GetLaunchAbi());
+  PackKey(packer, "loader_abi");
+  PackLoaderAbi(packer, kernel.GetLoaderAbi());
+  PackKey(packer, "producer");
+  PackProducer(packer, artifact.GetProducerIdentity());
+  PackKey(packer, "requested_artifact_policy");
+  PackText(packer, RequestedPolicyName(artifact.GetRequestedArtifactPolicy()));
+  PackKey(packer, "requested_target");
+  PackTarget(packer, artifact.GetRequestedTarget());
+  PackKey(packer, "runtime_kernel_name");
+  PackText(packer, kernel.GetRuntimeKernelName());
+  PackKey(packer, "semantic_route");
+  PackText(packer, SemanticRouteName(artifact.GetSemanticRoute()));
+  PackKey(packer, "tile_ir_bytecode_version");
+  PackBytecodeVersion(packer, artifact.GetTileIrBytecodeVersion());
+  PackKey(packer, "workspace_abi");
+  PackWorkspaceAbi(packer, kernel.GetWorkspaceAbi());
+}
+
+void ValidateBuildInfo(const NvidiaBackendBuildInfo& build_info,
+                       const NvidiaTargetInfo& target_info,
+                       const ToolchainIdentity& toolchain) {
+  if (!build_info.IsCompiled() || !build_info.IsCompilerFactoryAvailable()) {
+    throw ValueError("strict Artifact creation requires the compiled private NVIDIA backend");
+  }
+  if (build_info.GetPyptoRevision() != toolchain.GetPyptoRevision() ||
+      build_info.GetTensorIrRevision() != toolchain.GetTensorIrRevision() ||
+      build_info.GetCudaTileRevision() != toolchain.GetCudaTileRevision() ||
+      build_info.GetLlvmRevision() != toolchain.GetLlvmRevision() ||
+      build_info.GetCudaToolkitRoot() != toolchain.GetCudaToolkitRoot() ||
+      build_info.GetCudaToolkitVersion() != toolchain.GetCudaToolkitVersion() ||
+      build_info.GetTileirasRealPath() != toolchain.GetTileirasRealPath() ||
+      build_info.GetTileirasVersion() != toolchain.GetTileirasVersion() ||
+      build_info.GetTileirasSha256() != toolchain.GetTileirasSha256() ||
+      build_info.GetSm120Target() != target_info.GetArchConditionalArchitecture()) {
+    throw ValueError("Artifact producer identity differs from the compiled private NVIDIA backend");
+  }
+}
+
+void ValidateGridAgainstRequest(const ArtifactKernelAbi& kernel,
+                                const NvidiaTargetInfo& target_info) {
+  const auto& grid = kernel.GetGridAbi();
+  const auto& layout = kernel.GetArgumentLayout();
+  if (grid.GetShapeOperandIndex() >= layout.GetOperandDescriptors().size() ||
+      layout.GetOperandDescriptors()[grid.GetShapeOperandIndex()].GetKind() !=
+          ArtifactOperandKind::Tensor) {
+    throw ValueError("grid shape operand index must name a tensor descriptor");
+  }
+  const bool has_dynamic_metadata = HasDynamicShapeMetadata(layout);
+  if ((grid.GetPolicy() == ArtifactGridPolicy::TileBasedRuntime) != has_dynamic_metadata) {
+    throw ValueError("grid policy differs from the kernel argument metadata");
+  }
+  const auto& dimensions = grid.GetStaticDimensions();
+  const auto& traits = target_info.GetTraits();
+  if (dimensions[0] > static_cast<uint32_t>(traits.GetMaxGridDimX()) ||
+      dimensions[1] > static_cast<uint32_t>(traits.GetMaxGridDimY()) ||
+      dimensions[2] > static_cast<uint32_t>(traits.GetMaxGridDimZ())) {
+    throw ValueError("static grid dimensions exceed the requested target limits");
+  }
+}
+
+void ValidateStrictProducerResult(const CompileRequest& request,
+                                  const KernelBuildSpec& build_spec,
+                                  const ArtifactProducerResult& result) {
+  if (request.GetRequestedArtifactPolicy() != RequestedArtifactPolicy::CubinOnly ||
+      request.GetCompilerPolicy() != CompilerPolicy::DeterministicStrict ||
+      request.GetVerificationPolicy() != VerificationPolicy::Strict) {
+    throw ValueError("Artifact v1 requires strict deterministic Cubin request policies");
+  }
+  if (build_spec.GetSemanticRoute() != SemanticRoute::StructuredTensorIr) {
+    throw ValueError("Artifact v1 requires SemanticRoute::StructuredTensorIr");
+  }
+  const std::string request_digest = request.GetByteCompileIdentityDigest();
+  if (build_spec.GetCompileRequestByteIdentityDigest() != request_digest) {
+    throw ValueError("KernelBuildSpec is not bound to the supplied CompileRequest");
+  }
+
+  const auto& requested_target = result.GetRequestedTarget();
+  const auto& actual_target = result.GetActualTarget();
+  const auto& request_target = request.GetTargetInfo();
+  if (requested_target.GetComputeCapability() != Artifact::kRequiredComputeCapability ||
+      actual_target.GetComputeCapability() != Artifact::kRequiredComputeCapability ||
+      requested_target.GetName() != Artifact::kRequiredTargetName ||
+      actual_target.GetName() != Artifact::kRequiredTargetName ||
+      requested_target.GetPortability() != ArtifactTargetPortability::ArchConditional ||
+      actual_target.GetPortability() != ArtifactTargetPortability::ArchConditional ||
+      request_target.GetTraits().GetComputeCapability() != Artifact::kRequiredComputeCapability ||
+      request_target.GetArchConditionalArchitecture() != Artifact::kRequiredTargetName) {
+    throw ValueError("Artifact v1 requires exact requested and actual sm_120a targets");
+  }
+  if (result.GetActualArtifactKind() != ArtifactKind::Cubin || result.UsedFallback()) {
+    throw ValueError("Artifact v1 requires Cubin output with no fallback");
+  }
+  const auto& bytecode = result.GetTileIrBytecodeVersion();
+  if (bytecode.GetMajor() != 13 || bytecode.GetMinor() != 3 || bytecode.GetTag() != 0) {
+    throw ValueError("Artifact v1 requires CUDA Tile bytecode version 13.3.0");
+  }
+
+  const auto& producer = result.GetProducerIdentity();
+  if (producer.GetKind() != ArtifactProducerKind::TensorIrCudaTile ||
+      producer.GetPipelineRevision() != build_spec.GetPipelineRevision() ||
+      producer.GetProducerResultContract() != Artifact::kProducerResultContract ||
+      producer.EnvironmentOverridesEnabled() || producer.ArtifactFallbackAllowed() ||
+      !SameToolchain(producer.GetToolchainIdentity(), request.GetToolchainIdentity())) {
+    throw ValueError("Artifact producer provenance differs from the strict request/build specification");
+  }
+  const StrictProducerOptions resolved_options =
+      ResolveStrictProducerOptions(request, build_spec);
+  if (producer.GetOptionsIdentityDigest() !=
+      Artifact::GetProducerOptionsIdentityDigest(request, build_spec)) {
+    throw ValueError("Artifact producer options identity differs from the resolved strict schedule");
+  }
+  ValidateBuildInfo(GetNvidiaBackendBuildInfo(), request_target,
+                    producer.GetToolchainIdentity());
+
+  const auto& kernel = result.GetKernelAbi();
+  if (kernel.GetIdentityDigest() != build_spec.GetCallableAbiDigest()) {
+    throw ValueError("Artifact kernel ABI metadata differs from KernelBuildSpec.callable_abi_digest");
+  }
+  if (kernel.GetGridAbi().GetTileSizes() != resolved_options.tile_sizes) {
+    throw ValueError("Artifact grid tile sizes differ from the resolved strict schedule");
+  }
+  if (kernel.GetArgumentLayout().HasUniformSignature() !=
+      resolved_options.uniform_signature) {
+    throw ValueError("Artifact uniform-signature ABI differs from the resolved strict schedule");
+  }
+  const bool requires_flat = RequiresFlatPacking(kernel.GetArgumentLayout());
+  if ((kernel.GetArgumentPackingPolicy() == ArtifactArgumentPackingPolicy::Flat) !=
+      requires_flat) {
+    throw ValueError("argument packing policy differs from the kernel argument metadata");
+  }
+  ValidateGridAgainstRequest(kernel, request_target);
+  if (kernel.GetLaunchAbi().GetBlockDimensions() != std::array<uint32_t, 3>{1, 1, 1} ||
+      kernel.GetLaunchAbi().GetClusterSchedulingPolicy() !=
+          ArtifactClusterSchedulingPolicy::Spread ||
+      kernel.GetLaunchAbi().GetDynamicSharedMemoryBytes() != 0 ||
+      kernel.GetLaunchAbi().GetKernelArgumentSlotBytes() != 8) {
+    throw ValueError("Artifact v1 launch ABI differs from the reviewed CUDA Tile runtime ABI");
+  }
+  if (kernel.GetLoaderAbi().GetMinimumCudaDriverApiVersion() !=
+          Artifact::kMinimumCudaDriverApiVersion ||
+      kernel.GetLoaderAbi().GetMinimumCudaRuntimeApiVersion() !=
+          Artifact::kMinimumCudaRuntimeApiVersion) {
+    throw ValueError("Artifact v1 loader ABI differs from the reviewed CUDA 13.0 minimum");
+  }
+  ValidateCudaCubin(result.GetDeviceCode(), actual_target.GetComputeCapability(),
+                    kernel.GetEntryFunctionName(),
+                    KernelArgumentSizes(kernel.GetArgumentLayout()));
+}
