+Artifact Artifact::CreateStrict(const CompileRequest& request,
+                                const KernelBuildSpec& build_spec,
+                                ArtifactProducerResult producer_result) {
+  ValidateStrictProducerResult(request, build_spec, producer_result);
+  const std::string device_code_sha256 =
+      detail::Sha256Hex(producer_result.device_code_.data(), producer_result.device_code_.size());
+  Artifact artifact(
+      request.GetRequestedArtifactPolicy(), producer_result.actual_artifact_kind_,
+      std::move(producer_result.requested_target_), std::move(producer_result.actual_target_),
+      std::move(producer_result.tile_ir_bytecode_version_),
+      std::move(producer_result.kernel_abi_), IdentitiesFrom(request, build_spec),
+      std::move(producer_result.producer_identity_), build_spec.GetSemanticRoute(),
+      producer_result.fallback_used_, std::move(producer_result.device_code_),
+      device_code_sha256);
+  if (artifact.SerializeCanonical().size() > kMaximumSerializedArtifactBytes) {
+    throw ValueError("canonical Artifact v1 payload exceeds 68 MiB");
+  }
+  return artifact;
+}
+
+Artifact Artifact::DeserializeCanonical(const std::vector<uint8_t>& data,
+                                        const CompileRequest& expected_request,
+                                        const KernelBuildSpec& expected_build_spec) {
+  auto handle = detail::UnpackOne(
+      data, "Artifact", kMaximumSerializedArtifactBytes,
+      {kMaximumArrayItems,
+       kMaximumMapItems,
+       kMaximumStringBytes,
+       kMaximumDeviceCodeBytes,
+       kMaximumNestingDepth,
+       kMaximumTotalObjects,
+       kMaximumAggregateContainerItems,
+       kMaximumNonbinaryBytes,
+       /*maximum_binary_fields=*/1},
+      /*reference_binary_data=*/true);
+  detail::StrictMap fields(
+      handle.get(), "Artifact",
+      {"actual_artifact_kind",
+       "actual_target",
+       "argument_layout",
+       "argument_packing_policy",
+       "artifact_schema_version",
+       "backend",
+       "compiler_abi_version",
+       "contract",
+       "device_code",
+       "device_code_sha256",
+       "entry_function_name",
+       "fallback_used",
+       "grid_abi",
+       "identities",
+       "launch_abi",
+       "loader_abi",
+       "producer",
+       "requested_artifact_policy",
+       "requested_target",
+       "runtime_kernel_name",
+       "semantic_route",
+       "tile_ir_bytecode_version",
+       "workspace_abi"});
+
+  if (detail::ReadUint32(fields.Get("artifact_schema_version"),
+                         "Artifact.artifact_schema_version") !=
+          kArtifactSchemaVersion ||
+      detail::ReadUint32(fields.Get("compiler_abi_version"),
+                         "Artifact.compiler_abi_version") != kCompilerAbiVersion ||
+      detail::ReadText(fields.Get("backend"), "Artifact.backend") != "nvidia" ||
+      detail::ReadText(fields.Get("contract"), "Artifact.contract") != kContract ||
+      detail::ReadText(fields.Get("requested_artifact_policy"),
+                       "Artifact.requested_artifact_policy") != "cubin-only" ||
+      detail::ReadText(fields.Get("semantic_route"), "Artifact.semantic_route") !=
+          "structured-tensorir") {
+    throw ValueError("Artifact contains an unsupported v1 schema or policy value");
+  }
+
+  const ArtifactIdentities serialized_identities =
+      ParseIdentities(fields.Get("identities"), "Artifact.identities");
+  const ArtifactIdentities expected_identities =
+      IdentitiesFrom(expected_request, expected_build_spec);
+  if (!SameIdentities(serialized_identities, expected_identities)) {
+    throw ValueError("Artifact identities differ from the expected request/build specification");
+  }
+
+  const std::string serialized_device_code_sha256 = detail::ReadText(
+      fields.Get("device_code_sha256"), "Artifact.device_code_sha256");
+  RequireSha256(serialized_device_code_sha256, "Artifact.device_code_sha256");
+  ArtifactProducerResult result(
+      ParseTarget(fields.Get("requested_target"), "Artifact.requested_target"),
+      ParseTarget(fields.Get("actual_target"), "Artifact.actual_target"),
+      ParseArtifactKind(fields.Get("actual_artifact_kind"),
+                        "Artifact.actual_artifact_kind"),
+      ParseBytecodeVersion(fields.Get("tile_ir_bytecode_version"),
+                           "Artifact.tile_ir_bytecode_version"),
+      ArtifactKernelAbi(
+          detail::ReadText(fields.Get("runtime_kernel_name"),
+                           "Artifact.runtime_kernel_name"),
+          detail::ReadText(fields.Get("entry_function_name"),
+                           "Artifact.entry_function_name"),
+          ParseArgumentLayout(fields.Get("argument_layout"),
+                              "Artifact.argument_layout"),
+          ParsePackingPolicy(fields.Get("argument_packing_policy"),
+                             "Artifact.argument_packing_policy"),
+          ParseGridAbi(fields.Get("grid_abi"), "Artifact.grid_abi"),
+          ParseWorkspaceAbi(fields.Get("workspace_abi"), "Artifact.workspace_abi"),
+          ParseLaunchAbi(fields.Get("launch_abi"), "Artifact.launch_abi"),
+          ParseLoaderAbi(fields.Get("loader_abi"), "Artifact.loader_abi")),
+      ParseProducer(fields.Get("producer"), "Artifact.producer"),
+      detail::ReadBool(fields.Get("fallback_used"), "Artifact.fallback_used"),
+      detail::ReadBinary(fields.Get("device_code"), "Artifact.device_code"));
+
+  Artifact artifact =
+      CreateStrict(expected_request, expected_build_spec, std::move(result));
+  if (artifact.GetDeviceCodeSha256() != serialized_device_code_sha256) {
+    throw ValueError("Artifact device code SHA-256 differs from its serialized metadata");
+  }
+  CompareSink sink(data);
+  ArtifactPacker<CompareSink> packer(sink);
+  PackCompleteArtifact(packer, artifact);
+  if (!sink.MatchesCompletePayload()) {
+    throw ValueError("Artifact payload is valid MessagePack but is not in canonical form");
+  }
+  return artifact;
+}
+
+std::vector<uint8_t> Artifact::SerializeCanonical() const {
+  VectorSink sink(kMaximumSerializedArtifactBytes, device_code_.size() + 4096);
+  ArtifactPacker<VectorSink> packer(sink);
+  PackCompleteArtifact(packer, *this);
+  return std::move(sink).TakeBytes();
+}
+
+std::string Artifact::GetIdentityDigest() const {
+  const std::vector<uint8_t> bytes = SerializeCanonical();
+  return detail::Sha256Hex(bytes.data(), bytes.size());
+}
+
+std::vector<uint8_t> Artifact::SerializeProducerOptionsIdentity(
+    const CompileRequest& request, const KernelBuildSpec& build_spec) {
+  if (request.GetRequestedArtifactPolicy() != RequestedArtifactPolicy::CubinOnly ||
+      request.GetCompilerPolicy() != CompilerPolicy::DeterministicStrict ||
+      request.GetVerificationPolicy() != VerificationPolicy::Strict ||
+      request.GetTargetInfo().GetTraits().GetComputeCapability() !=
+          kRequiredComputeCapability ||
+      request.GetTargetInfo().GetArchConditionalArchitecture() != kRequiredTargetName) {
+    throw ValueError("producer options identity requires the strict sm_120a CompileRequest");
+  }
+  const StrictProducerOptions options = ResolveStrictProducerOptions(request, build_spec);
+  VectorSink sink(kMaximumSmallIdentityBytes, 1024);
+  ArtifactPacker<VectorSink> packer(sink);
+  PackProducerOptionsIdentity(packer, request, options);
+  return std::move(sink).TakeBytes();
+}
+
+std::string Artifact::GetProducerOptionsIdentityDigest(
+    const CompileRequest& request, const KernelBuildSpec& build_spec) {
+  const std::vector<uint8_t> bytes = SerializeProducerOptionsIdentity(request, build_spec);
+  return detail::Sha256Hex(bytes.data(), bytes.size());
+}
+
+std::vector<uint8_t> Artifact::SerializeCacheKeyIdentity(
+    const CompileRequest& request, const KernelBuildSpec& build_spec,
+    const ArtifactProducerIdentity& producer_identity) {
+  const std::string request_digest = request.GetByteCompileIdentityDigest();
+  if (request.GetRequestedArtifactPolicy() != RequestedArtifactPolicy::CubinOnly ||
+      request.GetCompilerPolicy() != CompilerPolicy::DeterministicStrict ||
+      request.GetVerificationPolicy() != VerificationPolicy::Strict ||
+      build_spec.GetSemanticRoute() != SemanticRoute::StructuredTensorIr ||
+      producer_identity.GetKind() != ArtifactProducerKind::TensorIrCudaTile ||
+      producer_identity.GetProducerResultContract() != kProducerResultContract ||
+      build_spec.GetCompileRequestByteIdentityDigest() != request_digest ||
+      build_spec.GetPipelineRevision() != producer_identity.GetPipelineRevision() ||
+      !SameToolchain(request.GetToolchainIdentity(), producer_identity.GetToolchainIdentity()) ||
+      producer_identity.EnvironmentOverridesEnabled() ||
+      producer_identity.ArtifactFallbackAllowed() ||
+      producer_identity.GetOptionsIdentityDigest() !=
+          GetProducerOptionsIdentityDigest(request, build_spec)) {
+    throw ValueError("Artifact cache-key inputs do not describe one strict producer request");
+  }
+  VectorSink sink(kMaximumSmallIdentityBytes, 512);
+  ArtifactPacker<VectorSink> packer(sink);
+  packer.pack_map(4);
+  PackKey(packer, "compile_request_byte_identity_digest");
+  PackText(packer, request_digest);
+  PackKey(packer, "contract");
+  PackText(packer, kCacheKeyContract);
+  PackKey(packer, "kernel_build_spec_digest");
+  PackText(packer, build_spec.GetIdentityDigest());
+  PackKey(packer, "producer_options_identity_digest");
+  PackText(packer, producer_identity.GetOptionsIdentityDigest());
+  return std::move(sink).TakeBytes();
+}
+
+std::string Artifact::GetCacheKeyDigest(
+    const CompileRequest& request, const KernelBuildSpec& build_spec,
+    const ArtifactProducerIdentity& producer_identity) {
+  const std::vector<uint8_t> bytes =
+      SerializeCacheKeyIdentity(request, build_spec, producer_identity);
+  return detail::Sha256Hex(bytes.data(), bytes.size());
+}
+
+std::vector<uint8_t> Artifact::SerializeCacheKeyIdentity() const {
+  VectorSink sink(kMaximumSmallIdentityBytes, 512);
+  ArtifactPacker<VectorSink> packer(sink);
+  packer.pack_map(4);
+  PackKey(packer, "compile_request_byte_identity_digest");
+  PackText(packer, identities_.GetCompileRequestByteIdentityDigest());
+  PackKey(packer, "contract");
+  PackText(packer, kCacheKeyContract);
+  PackKey(packer, "kernel_build_spec_digest");
+  PackText(packer, identities_.GetKernelBuildSpecDigest());
+  PackKey(packer, "producer_options_identity_digest");
+  PackText(packer, producer_identity_.GetOptionsIdentityDigest());
+  return std::move(sink).TakeBytes();
+}
+
+std::string Artifact::GetCacheKeyDigest() const {
+  const std::vector<uint8_t> bytes = SerializeCacheKeyIdentity();
+  return detail::Sha256Hex(bytes.data(), bytes.size());
+}
+
+std::vector<uint8_t> Artifact::SerializeLoaderCompatibility() const {
+  VectorSink sink(kMaximumSmallIdentityBytes, 512);
+  ArtifactPacker<VectorSink> packer(sink);
+  packer.pack_map(6);
+  PackKey(packer, "actual_artifact_kind");
+  PackText(packer, ArtifactKindName(actual_artifact_kind_));
+  PackKey(packer, "actual_target");
+  PackTarget(packer, actual_target_);
+  PackKey(packer, "backend");
+  PackText(packer, "nvidia");
+  PackKey(packer, "compiler_abi_version");
+  packer.pack(kCompilerAbiVersion);
+  PackKey(packer, "contract");
+  PackText(packer, kLoaderCompatibilityContract);
+  PackKey(packer, "loader_abi");
+  PackLoaderAbi(packer, kernel_abi_.GetLoaderAbi());
+  return std::move(sink).TakeBytes();
+}
+
+std::string Artifact::GetLoaderCompatibilityDigest() const {
+  const std::vector<uint8_t> bytes = SerializeLoaderCompatibility();
+  return detail::Sha256Hex(bytes.data(), bytes.size());
+}
+
+}  // namespace pypto::compiler
