+void ValidateCudaCubin(const std::vector<uint8_t>& bytes, int32_t expected_compute_capability,
+                       const std::string& entry_function_name,
+                       const std::vector<uint32_t>& kernel_argument_sizes) {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
