+
+function(_pypto_verify_locked_source source_dir expected_revision label)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" rev-parse HEAD
+        RESULT_VARIABLE revision_status
+        OUTPUT_VARIABLE actual_revision
+        ERROR_VARIABLE revision_error
+        OUTPUT_STRIP_TRAILING_WHITESPACE)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" diff --quiet
+        RESULT_VARIABLE worktree_status)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" diff --cached --quiet
+        RESULT_VARIABLE index_status)
+    if(NOT revision_status EQUAL 0 OR
+       NOT actual_revision STREQUAL expected_revision OR
+       NOT worktree_status EQUAL 0 OR
+       NOT index_status EQUAL 0)
+        message(FATAL_ERROR
+            "${label} source provenance changed after configuration: "
+            "actual revision '${actual_revision}', expected revision "
+            "'${expected_revision}', worktree status ${worktree_status}, "
+            "index status ${index_status}: ${revision_error}")
+    endif()
+endfunction()
+
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" -C "${PYPTO_SOURCE_DIR}"
+            status --porcelain=v1 --untracked-files=normal
+            --ignore-submodules=dirty
+    RESULT_VARIABLE pypto_status
+    OUTPUT_VARIABLE pypto_changes
+    ERROR_VARIABLE pypto_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+execute_process(
+    COMMAND "${GIT_EXECUTABLE}" -C "${PYPTO_SOURCE_DIR}" rev-parse HEAD
+    RESULT_VARIABLE pypto_revision_status
+    OUTPUT_VARIABLE pypto_revision
+    ERROR_VARIABLE pypto_revision_error
+    OUTPUT_STRIP_TRAILING_WHITESPACE)
+if(NOT pypto_status EQUAL 0 OR
+   NOT pypto_revision_status EQUAL 0 OR
+   NOT pypto_changes STREQUAL "" OR
+   NOT pypto_revision STREQUAL PYPTO_EXPECTED_REVISION)
+    message(FATAL_ERROR
+        "PyPTO source provenance changed after configuration: "
+        "actual revision '${pypto_revision}', expected revision "
+        "'${PYPTO_EXPECTED_REVISION}', changes '${pypto_changes}': "
+        "${pypto_error}${pypto_revision_error}")
+endif()
+
+_pypto_verify_locked_source(
+    "${TENSOR_IR_SOURCE_DIR}" "${TENSOR_IR_EXPECTED_REVISION}" "TensorIR")
+_pypto_verify_locked_source(
+    "${CUDA_TILE_SOURCE_DIR}" "${CUDA_TILE_EXPECTED_REVISION}" "CUDA Tile")
+_pypto_verify_locked_source(
+    "${LLVM_SOURCE_DIR}" "${LLVM_EXPECTED_REVISION}" "LLVM")
diff --git a/docs/en/dev/backend/01-nvidia-target-info.md b/docs/en/dev/backend/01-nvidia-target-info.md
index 2fa5889d3b811de7894ef0d2329de120321a9ce4..09b285209f5787ee40f01b30cde5a5881cbfe825 100644
--- a/docs/en/dev/backend/01-nvidia-target-info.md
