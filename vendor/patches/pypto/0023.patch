+   NOT _pypto_revision_length EQUAL 40 OR
+   NOT PYPTO_NVIDIA_PYPTO_REVISION MATCHES "^[0-9a-f]+$")
+    message(FATAL_ERROR
+        "Unable to resolve the PyPTO source revision: ${_pypto_revision_error}")
+endif()
