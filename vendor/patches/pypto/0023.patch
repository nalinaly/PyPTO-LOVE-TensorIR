+void WriteU16Le(std::vector<uint8_t>& bytes, size_t offset, uint16_t value) {
+  bytes[offset] = static_cast<uint8_t>(value);
+  bytes[offset + 1] = static_cast<uint8_t>(value >> 8U);
+}
+
+void WriteU32Le(std::vector<uint8_t>& bytes, size_t offset, uint32_t value) {
+  for (size_t index = 0; index < sizeof(value); ++index) {
+    bytes[offset + index] = static_cast<uint8_t>(value >> (index * 8U));
+  }
+}
+
+void WriteU64Le(std::vector<uint8_t>& bytes, size_t offset, uint64_t value) {
+  for (size_t index = 0; index < sizeof(value); ++index) {
+    bytes[offset + index] = static_cast<uint8_t>(value >> (index * 8U));
+  }
+}
+
+size_t AlignTo(size_t value, size_t alignment) {
+  return (value + alignment - 1) & ~(alignment - 1);
+}
+
+std::vector<uint8_t> MakeCudaCubin(
+    std::string_view entry_function_name,
+    const std::vector<uint32_t>& kernel_argument_sizes,
+    int32_t compute_capability = 120) {
+  constexpr size_t kElfHeaderSize = 64;
+  constexpr size_t kSectionHeaderSize = 64;
+  constexpr size_t kSectionCount = 7;
+  constexpr size_t kSectionHeadersOffset = kElfHeaderSize;
+  const std::string text_section_name =
+      ".text." + std::string(entry_function_name);
+  const std::string metadata_section_name =
+      ".nv.info." + std::string(entry_function_name);
+  const std::string constant_section_name =
+      ".nv.constant0." + std::string(entry_function_name);
+  std::string section_names(1, '\0');
+  const auto add_section_name = [&](const std::string& name) {
+    const uint32_t offset = static_cast<uint32_t>(section_names.size());
+    section_names += name;
+    section_names.push_back('\0');
+    return offset;
+  };
+  const uint32_t text_name_offset = add_section_name(text_section_name);
+  const uint32_t symbol_name_offset = add_section_name(".symtab");
+  const uint32_t string_name_offset = add_section_name(".strtab");
+  const uint32_t metadata_name_offset = add_section_name(metadata_section_name);
+  const uint32_t constant_name_offset = add_section_name(constant_section_name);
+  const uint32_t section_string_name_offset = add_section_name(".shstrtab");
+  std::string symbol_names(1, '\0');
+  symbol_names += entry_function_name;
+  symbol_names.push_back('\0');
+  const size_t section_name_table_offset =
+      kSectionHeadersOffset + kSectionHeaderSize * kSectionCount;
+  const size_t symbol_name_table_offset =
+      section_name_table_offset + section_names.size();
+  const size_t symbol_table_offset =
+      AlignTo(symbol_name_table_offset + symbol_names.size(), 8);
+  constexpr size_t kSymbolTableSize = 72;
+  const size_t metadata_offset = symbol_table_offset + kSymbolTableSize;
+  const size_t metadata_size = kernel_argument_sizes.size() * 16 + 16;
+  std::vector<uint16_t> parameter_offsets;
+  parameter_offsets.reserve(kernel_argument_sizes.size());
+  size_t parameter_bytes = 0;
+  for (uint32_t argument_size : kernel_argument_sizes) {
+    parameter_bytes = AlignTo(parameter_bytes, std::min<uint32_t>(argument_size, 8));
+    parameter_offsets.push_back(static_cast<uint16_t>(parameter_bytes));
+    parameter_bytes += argument_size;
+  }
+  const size_t constant_offset = AlignTo(metadata_offset + metadata_size, 4);
+  const size_t constant_size = parameter_bytes;
+  const size_t text_offset = AlignTo(constant_offset + constant_size, 16);
+  constexpr size_t kTextSize = 16;
+  const size_t program_header_offset = text_offset + kTextSize;
+  constexpr size_t kProgramHeaderSize = 56;
+  std::vector<uint8_t> bytes(program_header_offset + kProgramHeaderSize, 0);
+
+  bytes[0] = 0x7f;
+  bytes[1] = 'E';
+  bytes[2] = 'L';
+  bytes[3] = 'F';
+  bytes[4] = 2;     // ELFCLASS64
+  bytes[5] = 1;     // ELFDATA2LSB
+  bytes[6] = 1;     // EV_CURRENT
+  bytes[7] = 0x41;  // CUDA Tile OSABI
+  bytes[8] = 8;     // CUDA ELF ABI v2
+  WriteU16Le(bytes, 16, 2);    // ET_EXEC
+  WriteU16Le(bytes, 18, 190);  // EM_CUDA
+  WriteU32Le(bytes, 20, 1);    // EV_CURRENT
+  WriteU64Le(bytes, 32, program_header_offset);
+  WriteU64Le(bytes, 40, kSectionHeadersOffset);
+  WriteU32Le(bytes, 48, static_cast<uint32_t>(compute_capability) << 8U);
+  WriteU16Le(bytes, 52, kElfHeaderSize);
+  WriteU16Le(bytes, 54, kProgramHeaderSize);
+  WriteU16Le(bytes, 56, 1);
+  WriteU16Le(bytes, 58, kSectionHeaderSize);
+  WriteU16Le(bytes, 60, kSectionCount);
+  WriteU16Le(bytes, 62, 6);  // .shstrtab section index.
+
+  const size_t text_section = kSectionHeadersOffset + kSectionHeaderSize;
+  WriteU32Le(bytes, text_section, text_name_offset);
+  WriteU32Le(bytes, text_section + 4, 1);  // SHT_PROGBITS
+  WriteU64Le(bytes, text_section + 8, 6);  // SHF_ALLOC | SHF_EXECINSTR
+  WriteU64Le(bytes, text_section + 24, text_offset);
+  WriteU64Le(bytes, text_section + 32, kTextSize);
+  WriteU32Le(bytes, text_section + 40, 2);
+  WriteU32Le(bytes, text_section + 44, 2);
+  WriteU64Le(bytes, text_section + 48, 16);
+
+  const size_t symbol_section = text_section + kSectionHeaderSize;
+  WriteU32Le(bytes, symbol_section, symbol_name_offset);
+  WriteU32Le(bytes, symbol_section + 4, 2);   // SHT_SYMTAB
+  WriteU64Le(bytes, symbol_section + 24, symbol_table_offset);
+  WriteU64Le(bytes, symbol_section + 32, kSymbolTableSize);
+  WriteU32Le(bytes, symbol_section + 40, 3);  // Linked .strtab.
+  WriteU32Le(bytes, symbol_section + 44, 2);  // First global symbol.
+  WriteU64Le(bytes, symbol_section + 48, 8);
+  WriteU64Le(bytes, symbol_section + 56, 24);
+
+  const size_t symbol_string_section = symbol_section + kSectionHeaderSize;
+  WriteU32Le(bytes, symbol_string_section, string_name_offset);
+  WriteU32Le(bytes, symbol_string_section + 4, 3);  // SHT_STRTAB
+  WriteU64Le(bytes, symbol_string_section + 24, symbol_name_table_offset);
+  WriteU64Le(bytes, symbol_string_section + 32, symbol_names.size());
+  WriteU64Le(bytes, symbol_string_section + 48, 1);
+
+  const size_t metadata_section =
+      symbol_string_section + kSectionHeaderSize;
+  WriteU32Le(bytes, metadata_section, metadata_name_offset);
+  WriteU32Le(bytes, metadata_section + 4, 0x70000000);
+  WriteU64Le(bytes, metadata_section + 24, metadata_offset);
+  WriteU64Le(bytes, metadata_section + 32, metadata_size);
+  WriteU32Le(bytes, metadata_section + 40, 2);
+  WriteU32Le(bytes, metadata_section + 44, 1);
+  WriteU64Le(bytes, metadata_section + 48, 4);
+
+  const size_t constant_section = metadata_section + kSectionHeaderSize;
+  WriteU32Le(bytes, constant_section, constant_name_offset);
+  WriteU32Le(bytes, constant_section + 4, 1);
+  WriteU64Le(bytes, constant_section + 24, constant_offset);
+  WriteU64Le(bytes, constant_section + 32, constant_size);
+  WriteU32Le(bytes, constant_section + 44, 1);
+  WriteU64Le(bytes, constant_section + 48, 4);
+
+  const size_t section_string_section =
+      constant_section + kSectionHeaderSize;
+  WriteU32Le(bytes, section_string_section, section_string_name_offset);
+  WriteU32Le(bytes, section_string_section + 4, 3);   // SHT_STRTAB
+  WriteU64Le(bytes, section_string_section + 24, section_name_table_offset);
+  WriteU64Le(bytes, section_string_section + 32, section_names.size());
+  WriteU64Le(bytes, section_string_section + 48, 1);
+
+  std::copy(section_names.begin(), section_names.end(),
+            bytes.begin() + section_name_table_offset);
+  std::copy(symbol_names.begin(), symbol_names.end(),
+            bytes.begin() + symbol_name_table_offset);
+  const size_t constant_symbol = symbol_table_offset + 24;
+  bytes[constant_symbol + 4] = 0x03;           // STB_LOCAL | STT_SECTION.
+  WriteU16Le(bytes, constant_symbol + 6, 5);   // .nv.constant0.<entry>.
+  const size_t entry_symbol = symbol_table_offset + 48;
+  WriteU32Le(bytes, entry_symbol, 1);       // Entry name in .strtab.
+  bytes[entry_symbol + 4] = 0x12;           // STB_GLOBAL | STT_FUNC.
+  bytes[entry_symbol + 5] = 0x10;           // STO_CUDA_ENTRY.
+  WriteU16Le(bytes, entry_symbol + 6, 1);   // Defined by .text.
+  WriteU64Le(bytes, entry_symbol + 16, kTextSize);
+  for (size_t index = 0; index < kernel_argument_sizes.size(); ++index) {
+    const size_t record = metadata_offset + index * 16;
+    bytes[record] = 4;
+    bytes[record + 1] = 0x17;
+    WriteU16Le(bytes, record + 2, 12);
+    WriteU16Le(bytes, record + 8, static_cast<uint16_t>(index));
+    WriteU16Le(bytes, record + 10, parameter_offsets[index]);
+    WriteU32Le(bytes, record + 12,
+               (kernel_argument_sizes[index] << 18U) | 0x1f400U);
+  }
+  const size_t parameter_bank_record =
+      metadata_offset + kernel_argument_sizes.size() * 16;
+  bytes[parameter_bank_record] = 4;
+  bytes[parameter_bank_record + 1] = 0x0a;
+  WriteU16Le(bytes, parameter_bank_record + 2, 8);
+  WriteU32Le(bytes, parameter_bank_record + 4, 1);
+  WriteU32Le(bytes, parameter_bank_record + 8,
+             static_cast<uint32_t>(parameter_bytes) << 16U);
+  const size_t constant_bank_record = parameter_bank_record + 12;
+  bytes[constant_bank_record] = 3;
+  bytes[constant_bank_record + 1] = 0x19;
+  WriteU16Le(bytes, constant_bank_record + 2,
+             static_cast<uint16_t>(parameter_bytes));
+  bytes[text_offset] = 0xde;
+  bytes[text_offset + 1] = 0xad;
+  bytes[text_offset + 2] = 0xbe;
+  bytes[text_offset + 3] = 0xef;
+  WriteU32Le(bytes, program_header_offset, 1);  // PT_LOAD
+  WriteU64Le(bytes, program_header_offset + 32, bytes.size());
+  WriteU64Le(bytes, program_header_offset + 40, bytes.size());
+  WriteU64Le(bytes, program_header_offset + 48, 8);
+  return bytes;
+}
+
+ToolchainIdentity MakeToolchain(
+    std::string tensor_ir_revision = {}, std::string cuda_toolkit_root = {}) {
+  const NvidiaBackendBuildInfo build_info = GetNvidiaBackendBuildInfo();
+  if (tensor_ir_revision.empty()) {
+    tensor_ir_revision = build_info.GetTensorIrRevision();
+  }
+  if (cuda_toolkit_root.empty()) {
+    cuda_toolkit_root = build_info.GetCudaToolkitRoot();
+  }
+  return ToolchainIdentity(
+      build_info.GetPyptoRevision(), std::move(tensor_ir_revision),
+      build_info.GetCudaTileRevision(), build_info.GetLlvmRevision(),
+      std::move(cuda_toolkit_root), build_info.GetCudaToolkitVersion(),
+      build_info.GetTileirasRealPath(), build_info.GetTileirasVersion(),
+      build_info.GetTileirasSha256());
+}
+
+TargetTraits MakeTargetTraits() {
+  return TargetTraits(120, 82, 32, 1024, 1536, 24, 1024, 1024, 64,
+                      (1 << 30), 65535, 65535, 128, 48 * 1024, 101376,
+                      131072, 65536, 255, 65536, 96ULL * 1024 * 1024,
+                      24ULL * 1024 * 1024 * 1024);
+}
+
+CompileRequest MakeRequest(std::string tensor_ir_revision = {}) {
+  const NvidiaBackendBuildInfo build_info = GetNvidiaBackendBuildInfo();
+  if (tensor_ir_revision.empty()) {
+    tensor_ir_revision = build_info.GetTensorIrRevision();
+  }
+  NvidiaTargetInfo target(
+      0, "Synthetic SM120", "GPU-synthetic", "0000:01:00.0", MakeTargetTraits(),
+      build_info.GetCudaToolkitVersion(), "610.74", tensor_ir_revision,
+      build_info.GetCudaTileRevision(),
+      {pypto::DataType::BF16, pypto::DataType::FP32});
+  return CompileRequest(std::move(target), MakeToolchain(tensor_ir_revision));
+}
+
+CanonicalSchedule MakeSchedule() {
+  return CanonicalSchedule(
+      {ScheduleParameter("codegen_strategy", ScheduleValueKind::Text,
+                         "layout-propagation")},
+      {ScheduleParameter("dim_000", ScheduleValueKind::UnsignedInteger, "16"),
+       ScheduleParameter("dim_001", ScheduleValueKind::UnsignedInteger, "16")},
+      {}, {},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "1")},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "4")},
+      {},
+      {ScheduleParameter("bytecode_major", ScheduleValueKind::UnsignedInteger, "13"),
+       ScheduleParameter("bytecode_minor", ScheduleValueKind::UnsignedInteger, "3"),
+       ScheduleParameter("bytecode_tag", ScheduleValueKind::UnsignedInteger, "0"),
+       ScheduleParameter("max_candidates", ScheduleValueKind::UnsignedInteger, "0"),
+       ScheduleParameter("uniform_signature", ScheduleValueKind::Boolean, "false")});
+}
+
+KernelBuildSpec MakeBuildSpec(const CompileRequest& request, const ArtifactKernelAbi& kernel,
+                              std::string request_digest = {},
+                              std::string callable_abi_digest = {}) {
+  if (request_digest.empty()) request_digest = request.GetByteCompileIdentityDigest();
+  if (callable_abi_digest.empty()) callable_abi_digest = kernel.GetIdentityDigest();
+  return KernelBuildSpec(
+      std::string(kSourceIrDigest), std::move(callable_abi_digest),
+      SemanticRoute::StructuredTensorIr,
+      std::string(Artifact::kStructuredTensorIrPipelineRevision), MakeSchedule(),
