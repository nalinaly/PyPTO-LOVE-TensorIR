+ArtifactKernelAbi MakeKernelAbi(
+    bool runtime_grid,
+    uint32_t minimum_driver_api = Artifact::kMinimumCudaDriverApiVersion,
+    uint32_t minimum_runtime_api = Artifact::kMinimumCudaRuntimeApiVersion,
+    std::vector<uint32_t> tile_sizes = {16, 16}) {
+  std::vector<ArtifactArgumentDescriptor> descriptors;
+  if (runtime_grid) {
+    descriptors.push_back(MakeDynamicTensorDescriptor());
+    descriptors.push_back(MakeScalarDescriptor());
+    descriptors.push_back(MakeDynamicTensorDescriptor());
+  } else {
+    descriptors.push_back(MakeStaticTensorDescriptor());
+    descriptors.push_back(MakeScalarDescriptor());
+    descriptors.push_back(MakeStaticTensorDescriptor());
+  }
+  const uint32_t total_arguments = runtime_grid ? 7 : 3;
+  ArtifactArgumentLayout layout(std::move(descriptors), 2, total_arguments, false);
+  ArtifactGridAbi grid(
+      runtime_grid ? ArtifactGridPolicy::TileBasedRuntime : ArtifactGridPolicy::Static,
+      0, runtime_grid ? std::array<uint32_t, 3>{1, 1, 1}
+                      : std::array<uint32_t, 3>{4, 1, 1},
+      std::move(tile_sizes));
+  return ArtifactKernelAbi(
+      runtime_grid ? "dynamic_kernel" : "static_kernel",
+      runtime_grid ? "dynamic_entry" : "static_entry", std::move(layout),
+      runtime_grid ? ArtifactArgumentPackingPolicy::Flat
+                   : ArtifactArgumentPackingPolicy::PointerOnly,
+      std::move(grid), ArtifactWorkspaceAbi(ArtifactWorkspaceKind::Static, 0, 1),
+      ArtifactLaunchAbi({1, 1, 1}, ArtifactClusterSchedulingPolicy::Spread, 0, 8),
+      ArtifactLoaderAbi(minimum_driver_api, minimum_runtime_api));
+}
