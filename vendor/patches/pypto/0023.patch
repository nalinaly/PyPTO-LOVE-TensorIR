+
+"""Canonical, immutable and runtime-free NVIDIA Artifact v1 contract."""
+
+import hashlib
+import struct
+
+import pypto
+import pytest
+from pypto import backend
+from pypto.compiler import (
+    Artifact,
+    ArtifactArgumentDescriptor,
+    ArtifactArgumentLayout,
+    ArtifactArgumentPackingPolicy,
+    ArtifactBytecodeVersion,
+    ArtifactClusterSchedulingPolicy,
