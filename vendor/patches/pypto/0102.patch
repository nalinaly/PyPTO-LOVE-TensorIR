+@pl.jit
+def _native_tile_gated_rmsnorm(
+    x: pl.Tensor[[2, 128], pl.BF16],
+    gate: pl.Tensor[[2, 128], pl.BF16],
+    weight: pl.Tensor[[1, 128], pl.BF16],
+    out: pl.Out[pl.Tensor[[2, 128], pl.BF16]],
+):
+    with pl.at(level=pl.Level.CORE_GROUP):
+        for row in pl.range(2):
+            x_part = pl.load(x, [row, 0], [1, 128])
+            gate_part = pl.load(gate, [row, 0], [1, 128])
+            weight_part = pl.load(weight, [0, 0], [1, 128])
+            x_wide = pl.cast(x_part, target_type=pl.FP32)
+            square = pl.mul(x_wide, x_wide)
+            scratch = pl.create_tile(
+                [1, 128], dtype=pl.FP32, target_memory=pl.MemorySpace.Vec
+            )
+            square_sum = pl.row_sum(square, scratch)
+            mean_square = pl.mul(square_sum, 1.0 / 128)
+            shifted = pl.add(mean_square, 1.0e-6)
+            inv_rms = pl.rsqrt(shifted)
+            normalized = pl.row_expand_mul(x_wide, inv_rms)
+            weight_wide = pl.cast(weight_part, target_type=pl.FP32)
+            weighted = pl.mul(normalized, weight_wide)
+            gate_wide = pl.cast(gate_part, target_type=pl.FP32)
+            gate_neg = pl.mul(gate_wide, -1.0)
+            gate_exp = pl.exp(gate_neg)
+            denominator = pl.add(gate_exp, 1.0)
+            sigmoid = pl.recip(denominator)
+            silu_gate = pl.mul(gate_wide, sigmoid)
+            gated = pl.mul(weighted, silu_gate)
+            result = pl.cast(gated, target_type=pl.BF16)
+            pl.store(result, [row, 0], out)
+    return out
+
+
