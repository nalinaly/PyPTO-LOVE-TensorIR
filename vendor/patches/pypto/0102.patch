+bool IsNativeTileGatedRmsNormCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTileRmsNormCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  return function->params_.size() == 4;
+}
+
+NativeTileGatedRmsNormGraph AnalyzeNativeTileGatedRmsNorm(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native gated RMSNorm must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 4 ||
+      function->param_directions_.size() != 4 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::In ||
+      function->param_directions_[3] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native gated RMSNorm requires x, gate, weight and output",
+           &function->span_);
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native gated RMSNorm input");
+  const StaticTensor gate = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native gated RMSNorm gate");
+  const StaticTensor weight = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native gated RMSNorm weight");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native gated RMSNorm output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native gated RMSNorm return");
+  if (input.dtype != DataType::BF16 || input.shape.size() != 2 ||
+      !SameTensor(input, gate) || !SameTensor(input, result) ||
+      !SameTensor(result, declared) || weight.dtype != DataType::BF16 ||
+      weight.shape != std::vector<int64_t>({1, input.shape[1]})) {
+    Reject("native gated RMSNorm tensors have incompatible types or shapes",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!top || top->stmts_.size() != 2 || !scope ||
+      scope->split_ != ir::SplitMode::None || !scope->attrs_.empty() ||
+      !returned_var || returned_var.get() != function->params_[3].get()) {
+    Reject("native gated RMSNorm scope or return is invalid",
+           &function->span_);
+  }
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  if (loop_nest.repetitions != static_cast<uint64_t>(input.shape[0]) ||
+      !loop_nest.leaf || loop_nest.leaf->stmts_.size() != 22) {
+    Reject("native gated RMSNorm must cover each row with one tile body",
+           &scope->span_);
+  }
+  constexpr std::array<std::string_view, 21> kOps = {
+      "tile.load", "tile.load", "tile.load", "tile.cast", "tile.mul",
+      "tile.create", "tile.row_sum", "tile.muls", "tile.adds", "tile.rsqrt",
+      "tile.row_expand_mul", "tile.cast", "tile.mul", "tile.cast",
+      "tile.muls", "tile.exp", "tile.adds", "tile.recip", "tile.mul",
+      "tile.mul", "tile.cast"};
+  std::array<ir::AssignStmtPtr, 21> assignments;
+  std::array<ir::CallPtr, 21> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] =
+        ir::As<ir::AssignStmt>(loop_nest.leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kOps[index]))) {
+      Reject("native gated RMSNorm tile sequence is invalid",
+             &loop_nest.leaf->stmts_[index]->span_);
+    }
+  }
+  auto require_var = [&](const ir::CallPtr& call, size_t index,
+                         const ir::VarPtr& expected,
+                         std::string_view diagnostic) {
+    const auto value = index < call->args_.size()
+                           ? ir::As<ir::Var>(call->args_[index])
+                           : nullptr;
+    if (!value || value.get() != expected.get()) {
+      Reject(std::string(diagnostic), &call->span_);
+    }
+  };
+  for (size_t index = 0; index < 3; ++index) {
+    require_var(calls[index], 0, function->params_[index],
+                "gated RMSNorm input load is invalid");
+  }
+  require_var(calls[3], 0, assignments[0]->var_,
+              "gated RMSNorm input cast is invalid");
+  require_var(calls[4], 0, assignments[3]->var_,
+              "gated RMSNorm square lhs is invalid");
+  require_var(calls[4], 1, assignments[3]->var_,
+              "gated RMSNorm square rhs is invalid");
+  require_var(calls[6], 0, assignments[4]->var_,
+              "gated RMSNorm row sum input is invalid");
+  require_var(calls[6], 1, assignments[5]->var_,
+              "gated RMSNorm row sum scratch is invalid");
+  for (size_t index = 7; index <= 9; ++index) {
+    require_var(calls[index], 0, assignments[index - 1]->var_,
+                "gated RMSNorm reduction epilogue is not linear");
+  }
+  require_var(calls[10], 0, assignments[3]->var_,
+              "gated RMSNorm normalized input is invalid");
+  require_var(calls[10], 1, assignments[9]->var_,
+              "gated RMSNorm inverse RMS is invalid");
+  require_var(calls[11], 0, assignments[2]->var_,
+              "gated RMSNorm weight cast is invalid");
+  require_var(calls[12], 0, assignments[10]->var_,
+              "gated RMSNorm normalized value is invalid");
+  require_var(calls[12], 1, assignments[11]->var_,
+              "gated RMSNorm weight value is invalid");
+  require_var(calls[13], 0, assignments[1]->var_,
+              "gated RMSNorm gate cast is invalid");
+  for (size_t index = 14; index <= 17; ++index) {
+    require_var(calls[index], 0, assignments[index - 1]->var_,
+                "gated RMSNorm sigmoid chain is invalid");
+  }
+  require_var(calls[18], 0, assignments[13]->var_,
+              "gated RMSNorm SiLU gate input is invalid");
+  require_var(calls[18], 1, assignments[17]->var_,
+              "gated RMSNorm sigmoid input is invalid");
+  require_var(calls[19], 0, assignments[12]->var_,
+              "gated RMSNorm weighted value is invalid");
+  require_var(calls[19], 1, assignments[18]->var_,
+              "gated RMSNorm SiLU value is invalid");
+  require_var(calls[20], 0, assignments[19]->var_,
+              "gated RMSNorm result cast is invalid");
+  const auto store = ir::As<ir::EvalStmt>(loop_nest.leaf->stmts_.back());
+  const auto storeCall = store ? ir::As<ir::Call>(store->expr_) : nullptr;
+  if (!storeCall || !ir::IsOp(storeCall, "tile.store")) {
+    Reject("native gated RMSNorm must end in tile.store", &scope->span_);
+  }
+  require_var(storeCall, 0, assignments[20]->var_,
+              "gated RMSNorm stored value is invalid");
+  require_var(storeCall, 2, function->params_[3],
+              "gated RMSNorm store target is invalid");
+
+  const auto meanScale = calls[7]->args_.size() == 2
+                             ? ir::As<ir::ConstFloat>(calls[7]->args_[1])
+                             : nullptr;
+  const auto epsilon = calls[8]->args_.size() == 2
+                           ? ir::As<ir::ConstFloat>(calls[8]->args_[1])
+                           : nullptr;
+  const auto negativeOne = calls[14]->args_.size() == 2
+                               ? ir::As<ir::ConstFloat>(calls[14]->args_[1])
+                               : nullptr;
+  const auto positiveOne = calls[16]->args_.size() == 2
+                               ? ir::As<ir::ConstFloat>(calls[16]->args_[1])
+                               : nullptr;
+  const double expectedMean = 1.0 / static_cast<double>(input.shape[1]);
+  if (!meanScale || !epsilon || !negativeOne || !positiveOne ||
+      !std::isfinite(meanScale->value_) || !std::isfinite(epsilon->value_) ||
+      epsilon->value_ <= 0.0 || negativeOne->value_ != -1.0 ||
+      positiveOne->value_ != 1.0 ||
+      std::fabs(meanScale->value_ - expectedMean) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native gated RMSNorm scalar constants are invalid", &scope->span_);
+  }
+  return NativeTileGatedRmsNormGraph{
+      input, gate, weight, result, meanScale->value_, epsilon->value_};
+}
