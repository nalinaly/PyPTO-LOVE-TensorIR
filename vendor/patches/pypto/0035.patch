@@ -420,6 +425,53 @@ int TestScalarArtifactMetadata(const SmTarget &target) {
   return 0;
 }
 
+int TestClosedStdioStrictProducer(const SmTarget &target) {
+#if defined(__linux__)
+  const pid_t child = ::fork();
+  REQUIRE(child >= 0);
+  if (child == 0) {
+    (void)::close(STDIN_FILENO);
+    (void)::close(STDOUT_FILENO);
+    (void)::close(STDERR_FILENO);
+    CudaTileCompiler compiler;
+    CudaTileCompileOptions options =
+        StrictOptions(target, CudaTileArtifactKind::Cubin);
+    auto artifact = compiler.compileToArtifact(kAddSource, options);
+    _exit(artifact.ok() && artifact->validate().ok() ? 0 : 1);
+  }
+
+  int status = 0;
+  bool finished = false;
+  bool childUnavailable = false;
+  const auto deadline =
+      std::chrono::steady_clock::now() + std::chrono::seconds(30);
+  while (std::chrono::steady_clock::now() < deadline) {
+    const pid_t waited = ::waitpid(child, &status, WNOHANG);
+    if (waited == child) {
+      finished = true;
+      break;
+    }
+    if (waited == -1) {
+      if (errno == EINTR) continue;
+      childUnavailable = errno == ECHILD;
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  if (!finished && !childUnavailable) {
+    (void)::kill(child, SIGKILL);
+    while (::waitpid(child, &status, 0) == -1 && errno == EINTR) {
+    }
+  }
+  REQUIRE(finished);
+  REQUIRE(WIFEXITED(status));
+  REQUIRE(WEXITSTATUS(status) == 0);
+#else
+  (void)target;
+#endif
+  return 0;
+}
+
 }  // namespace
 
 int main() {
