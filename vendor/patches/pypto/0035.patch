   result = TestScalarArtifactMetadata(*target);
   if (result != 0) return result;
-  return TestDeterministicCubinArtifact(*target);
+  result = TestDeterministicCubinArtifact(*target);
+  if (result != 0) return result;
+  return TestClosedStdioStrictProducer(*target);
 }
