+int TestScratchQuotaMonitor() {
+  const ScratchScanResult transient{
+      ScratchScanStatus::ScanError,
+      std::make_error_code(std::errc::no_such_file_or_directory)};
+  const ScratchScanResult within{ScratchScanStatus::WithinLimit, {}};
+  const ScratchScanResult fatal{
+      ScratchScanStatus::ScanError,
+      std::make_error_code(std::errc::permission_denied)};
+  const ScratchScanResult ioError{
+      ScratchScanStatus::ScanError,
+      std::make_error_code(std::errc::io_error)};
+  const ScratchScanResult exceeded{ScratchScanStatus::Exceeded, {}};
+
+  ScratchQuotaMonitor recoveringMonitor;
+  REQUIRE(recoveringMonitor.observe(transient, /*childExited=*/false) ==
+          ScratchQuotaDecision::Continue);
+  REQUIRE(recoveringMonitor.observe(within, /*childExited=*/false) ==
+          ScratchQuotaDecision::Continue);
+  REQUIRE(recoveringMonitor.observe(transient, /*childExited=*/false) ==
+          ScratchQuotaDecision::Continue);
+
+  ScratchQuotaMonitor finalMonitor;
+  REQUIRE(finalMonitor.observe(transient, /*childExited=*/true) ==
+          ScratchQuotaDecision::RejectScanError);
+  ScratchQuotaMonitor fatalMonitor;
+  REQUIRE(fatalMonitor.observe(fatal, /*childExited=*/false) ==
+          ScratchQuotaDecision::RejectScanError);
+  ScratchQuotaMonitor ioErrorMonitor;
+  REQUIRE(ioErrorMonitor.observe(ioError, /*childExited=*/false) ==
+          ScratchQuotaDecision::RejectScanError);
+  ScratchQuotaMonitor exceededMonitor;
+  REQUIRE(exceededMonitor.observe(exceeded, /*childExited=*/false) ==
+          ScratchQuotaDecision::RejectExceeded);
+
+  ScratchQuotaMonitor boundedMonitor;
+  for (unsigned attempt = 0;
+       attempt < ScratchQuotaMonitor::kMaximumConsecutiveTransientScans;
+       ++attempt) {
+    REQUIRE(boundedMonitor.observe(transient, /*childExited=*/false) ==
+            ScratchQuotaDecision::Continue);
+  }
+  REQUIRE(boundedMonitor.observe(transient, /*childExited=*/false) ==
+          ScratchQuotaDecision::RejectScanError);
+
+  llvm::SmallString<128> directory;
+  REQUIRE(!llvm::sys::fs::createUniqueDirectory("pypto-scratch-quota",
+                                                 directory));
+  struct DirectoryRemover {
+    llvm::SmallString<128> path;
+    ~DirectoryRemover() { (void)llvm::sys::fs::remove_directories(path); }
+  } remover{directory};
+
+  llvm::SmallString<128> file(directory);
+  llvm::sys::path::append(file, "payload");
+  std::error_code writeError;
+  llvm::raw_fd_ostream output(file, writeError);
+  REQUIRE(!writeError);
+  output << "1234";
+  output.close();
+  REQUIRE(!output.has_error());
+
+  REQUIRE(scanScratchDirectory(directory, 4).status ==
+          ScratchScanStatus::WithinLimit);
+  REQUIRE(scanScratchDirectory(directory, 3).status ==
+          ScratchScanStatus::Exceeded);
+  ScratchScanResult notDirectory = scanScratchDirectory(file, 4);
+  REQUIRE(notDirectory.status == ScratchScanStatus::ScanError);
+  REQUIRE(notDirectory.error == std::errc::not_a_directory);
+
+  REQUIRE(!llvm::sys::fs::remove(file));
+  REQUIRE(!llvm::sys::fs::remove(directory));
+  ScratchScanResult removed = scanScratchDirectory(directory, 4);
+  REQUIRE(removed.status == ScratchScanStatus::ScanError);
+  REQUIRE(removed.error == std::errc::no_such_file_or_directory);
+  ScratchQuotaMonitor churnMonitor;
+  REQUIRE(churnMonitor.observe(removed, /*childExited=*/false) ==
+          ScratchQuotaDecision::Continue);
+  REQUIRE(!llvm::sys::fs::create_directory(directory));
+  ScratchScanResult recreated = scanScratchDirectory(directory, 4);
+  REQUIRE(recreated.status == ScratchScanStatus::WithinLimit);
+  REQUIRE(churnMonitor.observe(recreated, /*childExited=*/true) ==
+          ScratchQuotaDecision::Continue);
+#if defined(__linux__)
+  if (::geteuid() != 0) {
+    llvm::SmallString<128> unreadableDirectory(directory);
+    llvm::sys::path::append(unreadableDirectory, "unreadable");
+    REQUIRE(!llvm::sys::fs::create_directory(unreadableDirectory));
+    REQUIRE(!llvm::sys::fs::setPermissions(
+        unreadableDirectory, llvm::sys::fs::no_perms));
+    ScratchScanResult unreadable = scanScratchDirectory(directory, 4);
+    REQUIRE(!llvm::sys::fs::setPermissions(
+        unreadableDirectory, llvm::sys::fs::owner_all));
+    REQUIRE(unreadable.status == ScratchScanStatus::ScanError);
+    REQUIRE(unreadable.error == std::errc::permission_denied);
+  }
+#endif
+  return 0;
+}
