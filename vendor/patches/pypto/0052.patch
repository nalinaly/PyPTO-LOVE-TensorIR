+KernelOptions RowReductionKernelOptions(
+    const std::vector<int64_t>& input_shape = {8, 8},
+    const std::vector<uint32_t>& tile_sizes = {4}, uint32_t grid_x = 2) {
+  std::vector<int64_t> result_shape = input_shape;
+  result_shape.back() = 1;
+  const auto dense_strides = [](const std::vector<int64_t>& shape) {
+    std::vector<int64_t> strides(shape.size());
+    int64_t running = 1;
+    for (size_t reverse_index = shape.size(); reverse_index > 0; --reverse_index) {
+      const size_t index = reverse_index - 1;
+      strides[index] = running;
+      running *= shape[index];
+    }
+    return strides;
+  };
+  KernelOptions options;
+  options.entry_function_name = "pypto_row_reduction_v3";
+  options.input_count = 1;
+  options.static_grid = {grid_x, 1, 1};
+  options.tile_sizes = tile_sizes;
+  options.descriptors = DescriptorVector(
+      TensorDescriptor(input_shape, dense_strides(input_shape), 0, 0,
+                       input_shape.size() >= 2),
+      TensorDescriptor(result_shape, dense_strides(result_shape), 0, 0,
+                       result_shape.size() >= 2));
+  return options;
+}
