+RowReductionGraph AnalyzeRowReductionV3(const ir::ProgramPtr& program) {
+  if (!program) Reject("program must not be null");
+  if (program->functions_.size() != 1) {
+    Reject("program must contain exactly one function", &program->span_);
+  }
+
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function) Reject("program contains a null function binding", &program->span_);
+  if (global->name_ != function->name_) {
+    Reject("global function name does not match the bound function name", &function->span_);
+  }
+  if (function->requires_runtime_binding_) {
+    Reject("runtime-bound functions are not supported", &function->span_);
+  }
+  if (function->func_type_ != ir::FunctionType::Opaque || function->level_.has_value() ||
+      function->role_.has_value()) {
+    Reject("function must be Opaque with no hierarchy level or role", &function->span_);
+  }
+  if (!function->attrs_.empty()) {
+    Reject("function attributes are not supported", &function->span_);
+  }
+  if (function->params_.size() != 1 || function->param_directions_.size() != 1) {
+    Reject("row reduction v3 requires exactly one function parameter", &function->span_);
+  }
+  if (function->param_directions_[0] != ir::ParamDirection::In) {
+    Reject("the row reduction parameter must have direction In", &function->span_);
+  }
+  if (function->return_types_.size() != 1) {
+    Reject("row reduction v3 requires exactly one declared return", &function->span_);
+  }
+
+  const ir::VarPtr& parameter = function->params_[0];
+  if (!parameter) Reject("function contains a null parameter", &function->span_);
+  if (parameter->GetKind() != ir::ObjectKind::Var) {
+    Reject("row reduction parameter must be an exact Var node", &parameter->span_);
+  }
+  const StaticTensor input =
+      ReadStaticTensor(parameter->GetType(), parameter->span_, "row reduction parameter");
+  int64_t rows = 1;
+  for (size_t index = 0; index + 1 < input.shape.size(); ++index) {
+    rows *= input.shape[index];
+  }
+  StaticTensor expected_result = input;
+  expected_result.shape.back() = 1;
+  expected_result.dense_strides = MakeDenseStrides(expected_result.shape, function->span_);
+
+  const StaticTensor declared_result =
+      ReadStaticTensor(function->return_types_[0], function->span_, "declared row reduction result");
+  if (!SameTensor(expected_result, declared_result)) {
+    Reject("row reduction result must preserve input rank and dtype and set only the last extent to one",
+           &function->span_);
+  }
+
+  if (!function->body_) Reject("function body must not be null", &function->span_);
+  const auto sequence = ir::As<ir::SeqStmts>(function->body_);
+  if (!sequence || sequence->stmts_.size() != 2 || !sequence->stmts_[0] ||
+      !sequence->stmts_[1]) {
+    Reject("row reduction body must contain exactly one assignment and one return",
+           &function->body_->span_);
+  }
+  const auto assignment = ir::As<ir::AssignStmt>(sequence->stmts_[0]);
+  if (!assignment || !assignment->var_ || !assignment->value_) {
+    Reject("first row reduction statement must be one complete assignment",
+           &sequence->stmts_[0]->span_);
+  }
+  if (assignment->var_->GetKind() != ir::ObjectKind::Var) {
+    Reject("row reduction assignment result must be an exact Var node",
+           &assignment->var_->span_);
+  }
+  if (assignment->var_.get() == parameter.get()) {
+    Reject("row reduction result must not reuse the parameter IR identity", &assignment->span_);
+  }
+
+  const auto call = ir::As<ir::Call>(assignment->value_);
+  if (!call || !call->op_) {
+    Reject("row reduction assignment value must be a direct registered tensor call",
+           &assignment->value_->span_);
+  }
+  if (!call->attrs_.empty() || !call->kwargs_.empty()) {
+    Reject("row reduction attributes and keyword arguments are not supported", &call->span_);
+  }
+  RowReductionMode mode;
+  if (ir::IsOp(call, "tensor.row_sum")) {
+    mode = RowReductionMode::Sum;
+  } else if (ir::IsOp(call, "tensor.row_max")) {
+    mode = RowReductionMode::Max;
+  } else {
+    Reject("row reduction v3 supports only tensor.row_sum and tensor.row_max", &call->span_);
+  }
+  if (call->args_.size() != 1) {
+    Reject("row reduction operator expects exactly one operand, got " +
+               std::to_string(call->args_.size()),
+           &call->span_);
+  }
+  const ir::ExprPtr& argument = call->args_[0];
+  const auto argument_variable = ir::As<ir::Var>(argument);
+  if (!argument_variable || argument_variable->GetKind() != ir::ObjectKind::Var ||
+      argument_variable.get() != parameter.get()) {
+    Reject("row reduction operand must directly reference the exact function parameter",
+           argument ? &argument->span_ : &call->span_);
+  }
+  const StaticTensor operand =
+      ReadStaticTensor(argument_variable->GetType(), argument_variable->span_, "row reduction operand");
+  if (!SameTensor(input, operand)) {
+    Reject("row reduction operand type and shape must match the function parameter",
+           &argument_variable->span_);
+  }
+
+  const StaticTensor call_result =
+      ReadStaticTensor(call->GetType(), call->span_, "row reduction call result");
+  const StaticTensor assigned_result = ReadStaticTensor(
+      assignment->var_->GetType(), assignment->var_->span_, "row reduction assignment result");
+  if (!SameTensor(expected_result, call_result) ||
+      !SameTensor(expected_result, assigned_result)) {
+    Reject("row reduction call, assignment, and declared result types must match",
+           &call->span_);
+  }
+
+  const auto returned = ir::As<ir::ReturnStmt>(sequence->stmts_[1]);
+  if (!returned || returned->value_.size() != 1) {
+    Reject("second row reduction statement must be exactly one return",
+           &sequence->stmts_[1]->span_);
+  }
+  const auto returned_variable = ir::As<ir::Var>(returned->value_[0]);
+  if (!returned_variable || returned_variable->GetKind() != ir::ObjectKind::Var ||
+      returned_variable.get() != assignment->var_.get()) {
+    Reject("return must directly reference the row reduction assignment result",
+           &returned->span_);
+  }
+  return RowReductionGraph{input, expected_result, mode, rows};
+}
+
+const char* TensorIrReductionMode(RowReductionMode mode) {
+  if (mode == RowReductionMode::Sum) return "add";
+  if (mode == RowReductionMode::Max) return "max";
+  InternalReject("unsupported row reduction mode reached source emission");
+}
+
+std::string EmitRowReductionSource(const RowReductionGraph& graph) {
+  const std::string input_type = TensorTypeText(graph.input);
+  const std::string input_with_stride = TensorWithStrideText(graph.input);
+  const std::string result_type = TensorTypeText(graph.result);
+  const std::string result_with_stride = TensorWithStrideText(graph.result);
+  const bool flatten = graph.input.shape.size() > 2;
+  StaticTensor reduction_input = graph.input;
+  StaticTensor reduction_result = graph.result;
+  if (flatten) {
+    reduction_input.shape = {graph.rows, graph.input.shape.back()};
+    reduction_input.dense_strides = {graph.input.shape.back(), 1};
+    reduction_result.shape = {graph.rows, 1};
+    reduction_result.dense_strides = {1, 1};
+  }
+  const size_t reduction_axis = flatten ? 1 : graph.input.shape.size() - 1;
+  std::string source;
+  source.reserve(1024 + input_with_stride.size() + result_with_stride.size() +
+                 input_type.size() * 3 + result_type.size() * 3);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kRowReductionEntryName;
+  source += "(\n    %arg0: ";
+  source += input_with_stride;
+  source += "\n  ) -> ";
+  if (graph.result.shape.size() == 1) {
+    source += result_type;
+  } else {
+    source += "(";
+    source += result_with_stride;
+    source += ")";
+  }
+  source += " {\n";
+
+  const bool widen = graph.input.dtype == DataType::BF16;
+  StaticTensor compute_input = graph.input;
+  StaticTensor compute_result = graph.result;
+  StaticTensor compute_reduction_input = reduction_input;
+  StaticTensor compute_reduction_result = reduction_result;
+  if (widen) {
