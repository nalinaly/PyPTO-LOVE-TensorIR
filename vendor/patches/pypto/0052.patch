+struct RowReductionProgram {
+  ir::ProgramPtr program;
+  ir::VarPtr input;
+  ir::VarPtr result;
+  ir::TensorTypePtr input_type;
+  ir::TensorTypePtr result_type;
+};
+
+RowReductionProgram MakeRowReduction(
+    const std::vector<int64_t>& shape, DataType dtype,
+    const std::string& op_name = "tensor.row_sum",
+    std::vector<std::pair<std::string, std::any>> kwargs = {},
+    std::vector<std::pair<std::string, std::any>> attrs = {},
+    const std::string& function_name = "row_reduction",
+    const std::string& input_name = "input",
+    const std::string& result_name = "result") {
+  auto input_type = PlainTensor(shape, dtype);
+  std::vector<int64_t> result_shape = shape;
+  if (!result_shape.empty()) result_shape.back() = 1;
+  auto result_type = PlainTensor(result_shape, dtype);
+  auto input = std::make_shared<ir::Var>(input_name, input_type, TestSpan());
+  auto result = std::make_shared<ir::Var>(result_name, result_type, TestSpan());
+  auto call = OpCall(op_name, {input}, result_type, std::move(kwargs), std::move(attrs));
+  auto assignment = std::make_shared<ir::AssignStmt>(result, call, TestSpan());
+  auto returned =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  return {MakeProgram(function_name, {input}, {ir::ParamDirection::In}, {result_type},
+                      {assignment, returned}),
+          input, result, input_type, result_type};
+}
