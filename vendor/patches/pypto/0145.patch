++LogicalResult ScatterRowsOp::verify() {
++  auto dataType = getData().getType();
++  auto indicesType = getIndices().getType();
++  auto updatesType = getUpdates().getType();
++  auto outputType = getOutput().getType();
++  if (dataType.getRank() != 2 || indicesType.getRank() != 2 ||
++      updatesType.getRank() != 2 || outputType.getRank() != 2) {
++    return emitOpError(
++        "requires rank-2 data, indices, updates and output tensors");
++  }
++  if (!indicesType.getElementType().isInteger(32)) {
++    return emitOpError("requires i32 indices");
++  }
++  if (dataType.getElementType() != updatesType.getElementType() ||
++      updatesType != outputType) {
++    return emitOpError(
++        "requires matching data/update element types and identical updates/output");
++  }
++  if (dataType.getDimSize(1) != updatesType.getDimSize(1)) {
++    return emitOpError("requires data and update column extents to match");
++  }
++  if (indicesType.getShape() != updatesType.getShape()) {
++    return emitOpError("requires indices and updates shapes to match");
++  }
++  if (!dataType.hasStaticShape() || !indicesType.hasStaticShape() ||
++      !updatesType.hasStaticShape() || !outputType.hasStaticShape()) {
++    return emitOpError("currently requires static shapes");
++  }
++  return success();
++}
++
++LayoutSourceAttrInterface ScatterRowsOp::inferResultLayout(
++    ArrayRef<LayoutSourceAttrInterface> inputLayouts) {
++  assert(inputLayouts.size() == 3 &&
++         "expects data, indices and updates layouts");
++  auto dataSource = dyn_cast<TensorSourceAttr>(inputLayouts[0]);
++  if (!dataSource || !getOutput().getType().hasStaticShape()) {
++    return nullptr;
++  }
++  tcg::Layout projectedLayout(getShapeRef(getOutput().getType()));
++  auto projectedData = TensorSourceAttr::get(
++      getContext(), dataSource.getTensorId(), dataSource.getOffset(),
++      projectedLayout.toString(), /*dynamicValueMapping=*/{});
++  return CompositeSourceAttr::get(
++      getContext(), {projectedData, inputLayouts[1], inputLayouts[2]});
++}
