++def TensorIR_ScatterRowsOp : TensorIR_Op<"scatter_rows", [
++    OpAsmOpInterface,
++    IterationSpaceInfoInterface,
++    PointwiseOpInterface,
++    DeclareOpInterfaceMethods<LayoutPropInterface, ["inferResultLayout"]>
++  ]> {
++  let summary = "Scatter update rows into a matrix and pass updates through";
++  let description = [{
++    Stores every logical update row into the selected row of a rank-2 graph
++    argument. The indices tensor has the same shape as the updates and repeats
++    one i32 destination row index across every update row. The result is the
++    unchanged updates tensor, which gives the side-effecting store an SSA
++    dependency that can be rooted in graph results.
++
++    ```mlir
++    %stored = nv_tensor_ir.scatter_rows %table, %indices, %updates
++        : (tensor<1024x128xbf16>, tensor<1x128xsi32>, tensor<1x128xbf16>)
++       -> tensor<1x128xbf16>
++    ```
++  }];
++
++  let arguments = (ins
++    Arg<TensorIR_TensorType, "Rank-2 destination matrix">:$data,
++    Arg<TensorIR_TensorType, "Repeated i32 destination row indices">:$indices,
++    Arg<TensorIR_TensorType, "Rank-2 update rows">:$updates
++  );
++  let results = (outs
++    Arg<TensorIR_TensorType, "Unchanged update rows">:$output
++  );
++
++  let assemblyFormat = "$data `,` $indices `,` $updates attr-dict `:` functional-type(operands, results)";
++  let hasVerifier = 1;
++}
