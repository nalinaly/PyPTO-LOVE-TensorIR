+int TestTypedPagedPrefillHeadMajorModuleBuilder() {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  using pypto::codegen::nvidia::NativePagedPrefillTensorIrSpec;
+  using pypto::codegen::nvidia::TypedTensorIrElementType;
+  using pypto::codegen::nvidia::TypedTensorIrModuleKind;
+  using pypto::codegen::nvidia::TypedTensorIrModuleSpec;
+  using pypto::codegen::nvidia::TypedTensorIrTensorSpec;
+  using pypto::compiler::detail::BuildTypedTensorIrModule;
+
+  const auto tensor = [](TypedTensorIrElementType element_type,
+                         std::vector<int64_t> shape,
+                         std::vector<int64_t> strides) {
+    return TypedTensorIrTensorSpec{element_type, std::move(shape),
+                                   std::move(strides), true};
+  };
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::NativePagedPrefill;
+  NativePagedPrefillTensorIrSpec& spec = module_spec.native_paged_prefill;
+  spec.query_rows = 19;
+  spec.query_heads = 8;
+  spec.kv_heads = 2;
+  spec.tokens = 32;
+  spec.head_dim = 256;
+  spec.cache_rows = 257;
+  spec.scale = 1.0 / std::sqrt(256.0);
+  spec.inputs = {
+      tensor(TypedTensorIrElementType::BF16, {8, 19, 256}, {256, 2048, 1}),
+      tensor(TypedTensorIrElementType::BF16, {257, 512}, {512, 1}),
+      tensor(TypedTensorIrElementType::BF16, {257, 512}, {512, 1}),
+      tensor(TypedTensorIrElementType::INT32, {2, 260}, {260, 1}),
+      tensor(TypedTensorIrElementType::INT64, {1, 32}, {0, 0}),
+      tensor(TypedTensorIrElementType::INT32, {1, 32}, {0, 0}),
+      tensor(TypedTensorIrElementType::INT64, {257, 1}, {1, 1}),
+  };
+  spec.result = tensor(TypedTensorIrElementType::BF16, {8, 19, 256},
+                       {256, 2048, 1});
+
+  std::string diagnostic;
+  auto built = BuildTypedTensorIrModule(module_spec, diagnostic);
+  REQUIRE(built.has_value());
+  REQUIRE(diagnostic.empty());
+  REQUIRE(built->module);
+  const std::string source(built->canonical_source.begin(),
+                           built->canonical_source.end());
+  REQUIRE(source.find("tensor<8x19x256xbf16>") != std::string::npos);
+  REQUIRE(source.find("permutation = [1, 0, 2]") == std::string::npos);
+  REQUIRE(source.find("concatenate") != std::string::npos);
+
+  const CompileRequest request = MakeRequest();
+  const CanonicalSchedule schedule =
+      MakeSchedule(std::vector<uint32_t>{1, 1, 1, 128});
+  const auto options =
+      pypto::compiler::detail::ResolveStrictTensorIrProducerOptions(request,
+                                                                    schedule);
+  pypto::compiler::detail::NvidiaTensorIrCompilationInput producer_input;
+  producer_input.typed_module_spec = module_spec;
+  const uint64_t before = GetStrictNvidiaProducerInvocationCountForTesting();
+  auto compiled = CompileNvidiaProducerOnce(producer_input, request, options);
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before + 1);
+  REQUIRE(compiled.GetKernelAbi().GetEntryFunctionName() ==
+          "pypto_fused_pointwise");
+  REQUIRE(compiled.GetKernelAbi().GetArgumentLayout().GetInputOperandCount() ==
+          NativePagedPrefillTensorIrSpec::kInputCount);
+  REQUIRE(compiled.GetSourceIrDigest().size() == 64);
+#endif
+  return 0;
+}
