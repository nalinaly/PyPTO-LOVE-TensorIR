 #define PYPTO_SRC_COMPILER_DIGEST_H_
 
+#include <cstddef>
 #include <cstdint>
 #include <string>
 #include <vector>
 
 namespace pypto::compiler::detail {
 
+/**
+ * Return the lowercase SHA-256 digest of a non-owning byte range.
+ *
+ * A null pointer is accepted exactly when size is zero. Inputs whose bit
+ * length cannot be represented by SHA-256's 64-bit length field are rejected.
+ */
+[[nodiscard]] std::string Sha256Hex(const uint8_t* data, size_t size);
+
 /** Return the lowercase SHA-256 digest of the supplied bytes. */
 [[nodiscard]] std::string Sha256Hex(const std::vector<uint8_t>& data);
 
