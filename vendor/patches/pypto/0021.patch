-    }
-    for (size_t i = 16; i < words.size(); ++i) {
-      const uint32_t sigma0 =
-          RotateRight(words[i - 15U], 7U) ^ RotateRight(words[i - 15U], 18U) ^ (words[i - 15U] >> 3U);
-      const uint32_t sigma1 =
