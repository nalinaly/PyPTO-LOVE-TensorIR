+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <vector>
+
+#include "digest.h"
+#include "pypto/core/error.h"
+
+using pypto::ValueError;
+using pypto::compiler::detail::Sha256Hex;
+
+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+namespace {
+
+bool RejectsNullNonemptyInput() {
+  try {
+    (void)Sha256Hex(nullptr, 1);
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+bool RejectsOversizedInputWhenRepresentable() {
+  constexpr uint64_t kMaximumBytes = std::numeric_limits<uint64_t>::max() / 8U;
+  if (std::numeric_limits<size_t>::max() <= kMaximumBytes) return true;
+  const uint8_t byte = 0;
+  try {
+    (void)Sha256Hex(&byte, static_cast<size_t>(kMaximumBytes + 1U));
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+int main() {
+  REQUIRE(Sha256Hex(nullptr, 0) ==
+          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+  REQUIRE(Sha256Hex(std::vector<uint8_t>{}) ==
+          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+
+  const uint8_t abc[] = {'a', 'b', 'c'};
+  REQUIRE(Sha256Hex(abc, sizeof(abc)) ==
+          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+
+  const uint8_t embedded_nul[] = {'a', 0, 'b'};
+  const std::vector<uint8_t> embedded_nul_vector(embedded_nul,
+                                                  embedded_nul + sizeof(embedded_nul));
+  REQUIRE(Sha256Hex(embedded_nul, sizeof(embedded_nul)) ==
+          "59b271ae1bbcb1d31d41929817f4b16fb439eb4f31520b5ad1d5ce98920a7138");
+  REQUIRE(Sha256Hex(embedded_nul_vector) ==
+          Sha256Hex(embedded_nul_vector.data(), embedded_nul_vector.size()));
+
+  const std::vector<uint8_t> fifty_six_a(56, static_cast<uint8_t>('a'));
+  REQUIRE(Sha256Hex(fifty_six_a) ==
+          "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");
+
+  REQUIRE(Sha256Hex(std::vector<uint8_t>(55, static_cast<uint8_t>('a'))) ==
+          "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");
+  REQUIRE(Sha256Hex(std::vector<uint8_t>(63, static_cast<uint8_t>('a'))) ==
+          "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");
+  REQUIRE(Sha256Hex(std::vector<uint8_t>(64, static_cast<uint8_t>('a'))) ==
+          "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");
+  REQUIRE(Sha256Hex(std::vector<uint8_t>(65, static_cast<uint8_t>('a'))) ==
+          "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
+
+  const std::vector<uint8_t> million_a(1'000'000, static_cast<uint8_t>('a'));
+  REQUIRE(Sha256Hex(million_a.data(), million_a.size()) ==
+          "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
+  REQUIRE(Sha256Hex(million_a) == Sha256Hex(million_a.data(), million_a.size()));
+
+  REQUIRE(RejectsNullNonemptyInput());
+  REQUIRE(RejectsOversizedInputWhenRepresentable());
+  return 0;
+}
