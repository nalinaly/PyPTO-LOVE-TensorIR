-      words[i] = words[i - 16U] + sigma0 + words[i - 7U] + sigma1;
-    }
 
-    uint32_t a = state[0];
-    uint32_t b = state[1];
-    uint32_t c = state[2];
-    uint32_t d = state[3];
-    uint32_t e = state[4];
-    uint32_t f = state[5];
-    uint32_t g = state[6];
-    uint32_t h = state[7];
-    for (size_t i = 0; i < words.size(); ++i) {
-      const uint32_t sum1 = RotateRight(e, 6U) ^ RotateRight(e, 11U) ^ RotateRight(e, 25U);
-      const uint32_t choose = (e & f) ^ ((~e) & g);
-      const uint32_t temporary1 = h + sum1 + choose + kSha256RoundConstants[i] + words[i];
-      const uint32_t sum0 = RotateRight(a, 2U) ^ RotateRight(a, 13U) ^ RotateRight(a, 22U);
-      const uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
-      const uint32_t temporary2 = sum0 + majority;
-      h = g;
-      g = f;
-      f = e;
-      e = d + temporary1;
-      d = c;
-      c = b;
-      b = a;
-      a = temporary1 + temporary2;
-    }
-    state[0] += a;
-    state[1] += b;
-    state[2] += c;
-    state[3] += d;
-    state[4] += e;
-    state[5] += f;
-    state[6] += g;
-    state[7] += h;
+  constexpr size_t kBlockBytes = 64;
+  const size_t complete_block_bytes = size - (size % kBlockBytes);
+  for (size_t offset = 0; offset < complete_block_bytes; offset += kBlockBytes) {
+    ProcessBlock(data + offset, state);
+  }
+
+  std::array<uint8_t, kBlockBytes * 2> final_blocks{};
+  const size_t tail_bytes = size - complete_block_bytes;
+  if (tail_bytes != 0) {
+    std::memcpy(final_blocks.data(), data + complete_block_bytes, tail_bytes);
+  }
+  final_blocks[tail_bytes] = 0x80U;
+  const size_t final_size = tail_bytes < 56U ? kBlockBytes : kBlockBytes * 2U;
+  const uint64_t bit_length = static_cast<uint64_t>(size) * 8U;
+  for (size_t index = 0; index < sizeof(bit_length); ++index) {
+    final_blocks[final_size - 1U - index] = static_cast<uint8_t>(bit_length >> (index * 8U));
+  }
+  for (size_t offset = 0; offset < final_size; offset += kBlockBytes) {
+    ProcessBlock(final_blocks.data() + offset, state);
   }
 
   constexpr char kHexDigits[] = "0123456789abcdef";
@@ -109,4 +138,8 @@ std::string Sha256Hex(const std::vector<uint8_t>& data) {
   return result;
 }
 
+std::string Sha256Hex(const std::vector<uint8_t>& data) {
+  return Sha256Hex(data.data(), data.size());
+}
