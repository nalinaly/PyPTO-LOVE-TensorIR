                                  has_explicit_strides};
 }
 
+TypedTensorIrOpKind GenericOpKind(std::string_view tensor_ir_op) {
+  if (tensor_ir_op == "add") return TypedTensorIrOpKind::Add;
+  if (tensor_ir_op == "sub") return TypedTensorIrOpKind::Sub;
+  if (tensor_ir_op == "mul") return TypedTensorIrOpKind::Mul;
+  if (tensor_ir_op == "div") return TypedTensorIrOpKind::Div;
+  if (tensor_ir_op == "neg") return TypedTensorIrOpKind::Neg;
+  if (tensor_ir_op == "exp") return TypedTensorIrOpKind::Exp;
+  if (tensor_ir_op == "rsqrt") return TypedTensorIrOpKind::Rsqrt;
+  if (tensor_ir_op == "reciprocal") return TypedTensorIrOpKind::Reciprocal;
+  if (tensor_ir_op == "sin") return TypedTensorIrOpKind::Sin;
+  if (tensor_ir_op == "cos") return TypedTensorIrOpKind::Cos;
+  if (tensor_ir_op == "abs") return TypedTensorIrOpKind::Abs;
+  if (tensor_ir_op == "sqrt") return TypedTensorIrOpKind::Sqrt;
+  if (tensor_ir_op == "log") return TypedTensorIrOpKind::Log;
+  if (tensor_ir_op == "max") return TypedTensorIrOpKind::Max;
+  if (tensor_ir_op == "min") return TypedTensorIrOpKind::Min;
+  InternalReject("unsupported generic TensorIR operation");
+}
+
+TypedTensorIrOperationSpec MakeGenericOperation(
+    TypedTensorIrOpKind kind, std::vector<uint32_t> operands,
+    const StaticTensor& result) {
+  TypedTensorIrOperationSpec operation;
+  operation.kind = kind;
+  operation.operands = std::move(operands);
+  operation.result = MakeTypedTensorIrTensorSpec(
+      result, /*has_explicit_strides=*/true);
+  return operation;
+}
+
+TypedTensorIrOperationSpec MakeGenericConstant(DataType dtype, double value) {
+  TypedTensorIrOperationSpec operation;
+  operation.kind = TypedTensorIrOpKind::Constant;
+  operation.result.element_type = ToTypedTensorIrElementType(dtype);
+  operation.scalar_type = operation.result.element_type;
+  operation.scalar = value;
+  return operation;
+}
+
+TypedTensorIrModuleSpec MakeGenericFusedPointwiseTensorIrSpec(
+    const FusedPointwiseGraph& graph) {
+  TypedTensorIrModuleSpec module_spec;
+  module_spec.kind = TypedTensorIrModuleKind::Generic;
+  GenericTensorIrModuleSpec& spec = module_spec.generic;
+  spec.inputs.reserve(graph.input_tensors.size());
+  for (const StaticTensor& input : graph.input_tensors) {
+    spec.inputs.push_back(MakeTypedTensorIrTensorSpec(
+        input, /*has_explicit_strides=*/true));
+  }
+  spec.results.push_back(MakeTypedTensorIrTensorSpec(
+      graph.tensor, /*has_explicit_strides=*/true));
+
+  const auto append_operation = [&](TypedTensorIrOperationSpec operation) {
+    spec.operations.push_back(std::move(operation));
+    return static_cast<uint32_t>(graph.input_count + spec.operations.size() - 1);
+  };
+  std::vector<uint32_t> broadcast_values(graph.input_count,
+                                         std::numeric_limits<uint32_t>::max());
+  for (size_t input_index = 0; input_index < graph.input_count; ++input_index) {
+    if (!graph.broadcast_inputs[input_index]) continue;
+    broadcast_values[input_index] = append_operation(MakeGenericOperation(
+        TypedTensorIrOpKind::Broadcast, {static_cast<uint32_t>(input_index)},
+        graph.tensor));
+  }
+
+  uint32_t last_value = std::numeric_limits<uint32_t>::max();
+  for (const FusedPointwiseInstruction& instruction : graph.instructions) {
+    std::vector<uint32_t> operands;
+    operands.reserve(instruction.tensor_operands.size() +
+                     (instruction.scalar.has_value() ? 1 : 0));
+    for (const FusedTensorOperand& operand : instruction.tensor_operands) {
+      if (operand.kind == FusedTensorOperandKind::Input) {
+        operands.push_back(static_cast<uint32_t>(operand.input_index));
+      } else if (operand.kind == FusedTensorOperandKind::BroadcastInput) {
+        const uint32_t value = broadcast_values[operand.input_index];
+        if (value == std::numeric_limits<uint32_t>::max()) {
+          InternalReject("generic TensorIR broadcast operand is unresolved");
+        }
+        operands.push_back(value);
+      } else if (operand.kind == FusedTensorOperandKind::PreviousResult) {
+        operands.push_back(static_cast<uint32_t>(
+            graph.input_count + operand.input_index));
+      } else {
+        InternalReject("generic TensorIR operand kind is invalid");
+      }
+    }
+    if (instruction.tensor_ir_op == "__broadcast__") {
+      if (operands.size() != 2) {
+        InternalReject("generic TensorIR broadcast materialization arity is invalid");
+      }
+      const uint32_t constant = append_operation(
+          MakeGenericConstant(graph.tensor.dtype, 1.0));
+      StaticTensor scalar_splat = graph.tensor;
+      const uint32_t splat = append_operation(MakeGenericOperation(
+          TypedTensorIrOpKind::Splat, {constant}, scalar_splat));
+      last_value = append_operation(MakeGenericOperation(
+          TypedTensorIrOpKind::Mul, {operands[1], splat}, graph.tensor));
+      continue;
+    }
+    if (instruction.scalar.has_value()) {
+      const uint32_t constant = append_operation(
+          MakeGenericConstant(graph.tensor.dtype, *instruction.scalar));
+      const uint32_t splat = append_operation(MakeGenericOperation(
+          TypedTensorIrOpKind::Splat, {constant}, graph.tensor));
+      operands.push_back(splat);
+    }
+    last_value = append_operation(
+        MakeGenericOperation(GenericOpKind(instruction.tensor_ir_op),
+                             std::move(operands), graph.tensor));
+  }
+  if (last_value == std::numeric_limits<uint32_t>::max()) {
+    InternalReject("generic TensorIR fused pointwise graph has no result");
+  }
+  spec.result_values = {last_value};
+  return module_spec;
+}
+
 TypedTensorIrModuleSpec MakeNativeGdnRecurrentTensorIrSpec(
     const NativeTileGdnRecurrentGraph& graph) {
   TypedTensorIrModuleSpec module_spec;
@@ -8986,7 +9103,8 @@ void TensorIrModule::Validate() const {
       typed_module_spec_->kind != TypedTensorIrModuleKind::NativeAttention &&
       typed_module_spec_->kind != TypedTensorIrModuleKind::NativePagedGather &&
       typed_module_spec_->kind != TypedTensorIrModuleKind::NativePagedPrefill &&
-      typed_module_spec_->kind != TypedTensorIrModuleKind::NativePagedDecode) {
+      typed_module_spec_->kind != TypedTensorIrModuleKind::NativePagedDecode &&
+      typed_module_spec_->kind != TypedTensorIrModuleKind::Generic) {
     InternalReject("typed TensorIR module kind is invalid");
   }
   if (typed_module_spec_.has_value() &&
@@ -9736,9 +9854,10 @@ TensorIrModule EmitTensorIr(const ir::ProgramPtr& program) {
     metadata.push_back(TensorIrValueMetadata(
         TensorIrValueRole::Result, 0, graph.tensor.dtype, graph.tensor.shape,
         graph.tensor.dense_strides, graph.tensor.shape.size() >= 2));
-    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
-                          EmitFusedPointwiseSource(graph), std::move(metadata),
-                          static_cast<uint32_t>(graph.input_count));
+    return TensorIrModule(
+        TensorIrModuleKind::FusedPointwise,
+        MakeGenericFusedPointwiseTensorIrSpec(graph), std::move(metadata),
+        static_cast<uint32_t>(graph.input_count));
   }
   if (IsLegacyStaticAddV1Candidate(program)) {
     return detail::EmitLegacyStaticAddV1(program);
@@ -9810,8 +9929,10 @@ TensorIrModule EmitTensorIr(const ir::ProgramPtr& program) {
       TensorIrValueRole::Result, 0, graph.tensor.dtype, graph.tensor.shape,
       graph.tensor.dense_strides, graph.tensor.shape.size() >= 2));
   const uint32_t input_count = static_cast<uint32_t>(graph.input_count);
-  return TensorIrModule(TensorIrModuleKind::FusedPointwise,
-                        EmitFusedPointwiseSource(graph), std::move(metadata), input_count);
+  return TensorIrModule(
+      TensorIrModuleKind::FusedPointwise,
+      MakeGenericFusedPointwiseTensorIrSpec(graph), std::move(metadata),
+      input_count);
 }
 
 }  // namespace pypto::codegen::nvidia
