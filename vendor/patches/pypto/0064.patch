From 68ae16eaa3a29133c1e7e18241e152a55380460b Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Thu, 27 Aug 2026 12:39:33 +0800
Subject: [PATCH 064/263] codegen: DAG operand chains and broadcast
 materialization

Fused pointwise assignments may now consume any earlier SSA result, not
just the immediately preceding one, so branching norm/activation chains
compile. tensor.row_expand materializes the broadcast row as an SSA
value for base ops whose broadcast operand sits left of a
non-commutative operator (Inductor rewrites t*rsqrt(v) into t/sqrt(v)).
---
 src/codegen/nvidia/tensor_ir_codegen.cpp | 39 +++++++++-----
 tests/ut/cpp/tensor_ir_codegen_test.cpp  | 65 ++++++++++++++----------
 2 files changed, 66 insertions(+), 38 deletions(-)

diff --git a/src/codegen/nvidia/tensor_ir_codegen.cpp b/src/codegen/nvidia/tensor_ir_codegen.cpp
index a4196dd08d70f32698a62b25a288959b4ab217a2..1097797f3470a4384fffafaeeea9c957e1f364e0 100644
--- a/src/codegen/nvidia/tensor_ir_codegen.cpp
+++ b/src/codegen/nvidia/tensor_ir_codegen.cpp
@@ -633,6 +633,11 @@ std::optional<FusedOperationSpec> GetFusedOperationSpec(const ir::CallPtr& call)
   if (ir::IsOp(call, "tensor.row_expand_min")) {
     return FusedOperationSpec{"min", 2, false, true};
   }
+  // Materializes the broadcast row as an SSA value for arithmetic whose
+  // broadcast operand sits on the left of a non-commutative base op.
+  if (ir::IsOp(call, "tensor.row_expand")) {
+    return FusedOperationSpec{"__broadcast__", 2, false, true};
+  }
   return std::nullopt;
 }
 
@@ -815,7 +820,6 @@ FusedPointwiseGraph AnalyzeFusedPointwiseV2(const ir::ProgramPtr& program) {
 
     FusedPointwiseInstruction instruction{spec->tensor_ir_op, {}, std::nullopt};
     instruction.tensor_operands.reserve(spec->tensor_operand_count);
-    bool consumes_previous = false;
     for (size_t operand_index = 0; operand_index < spec->tensor_operand_count;
          ++operand_index) {
       const ir::ExprPtr& argument = call->args_[operand_index];
@@ -863,18 +867,14 @@ FusedPointwiseGraph AnalyzeFusedPointwiseV2(const ir::ProgramPtr& program) {
         Reject("fused pointwise tensor operand is not a function parameter or SSA result",
                &variable->span_);
       }
-      if (index == 0 || assigned->second != index - 1) {
-        Reject("fused pointwise tensor operands may reference only the immediately "
-               "preceding assignment result",
+      if (assigned->second >= index) {
+        Reject("fused pointwise tensor operands may reference only earlier "
+               "assignment results",
                &variable->span_);
       }
-      consumes_previous = true;
       instruction.tensor_operands.push_back(
-          FusedTensorOperand{FusedTensorOperandKind::PreviousResult, 0});
-    }
-    if (index != 0 && !consumes_previous) {
-      Reject("each fused pointwise assignment after the first must consume the immediately preceding result",
-             &call->span_);
+          FusedTensorOperand{FusedTensorOperandKind::PreviousResult,
+                             assigned->second});
     }
 
     if (spec->has_scalar) {
@@ -930,9 +930,9 @@ void AppendFusedOperand(std::string& source, const FusedTensorOperand& operand,
     AppendIndex(source, operand.input_index);
     return;
   }
-  if (operand.kind == FusedTensorOperandKind::PreviousResult && instruction_index != 0) {
+  if (operand.kind == FusedTensorOperandKind::PreviousResult) {
     source += "%value";
-    AppendIndex(source, instruction_index - 1);
+    AppendIndex(source, operand.input_index);
     return;
   }
   InternalReject("fused pointwise source operand is invalid");
@@ -999,6 +999,21 @@ std::string EmitFusedPointwiseSource(const FusedPointwiseGraph& graph) {
       source += type;
       source += "\n";
     }
+    if (instruction.tensor_ir_op == "__broadcast__") {
+      // Materialize the row-broadcast input as an SSA value: the first
+      // operand only fixes the target shape and the broadcast input expands.
+      source += "    %value";
+      AppendIndex(source, instruction_index);
+      source += " = broadcast ";
+      AppendFusedOperand(source, instruction.tensor_operands[1], instruction_index);
+      source += " : ";
+      source += TensorTypeText(graph.input_tensors[
+          instruction.tensor_operands[1].input_index]);
+      source += " -> ";
+      source += type;
+      source += "\n";
+      continue;
+    }
     source += "    %value";
     AppendIndex(source, instruction_index);
     source += " = ";
