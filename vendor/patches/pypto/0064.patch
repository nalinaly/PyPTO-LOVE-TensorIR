   REQUIRE(Rejects(
       [&] {
@@ -1116,7 +1106,7 @@ int TestFusedPointwiseV2Rejections() {
                                               TestSpan())},
             {x}));
       },
-      "only the immediately preceding"));
+      "may reference only earlier"));
 
   REQUIRE(Rejects(
       [&] {
@@ -1127,7 +1117,7 @@ int TestFusedPointwiseV2Rejections() {
                                               TestSpan())},
             {x}));
       },
-      "only the immediately preceding"));
