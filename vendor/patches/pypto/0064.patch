   REQUIRE(Rejects(
       [&] {
@@ -1670,6 +1660,29 @@ int TestFusedPointwiseV2RowBroadcast() {
   REQUIRE(metadata.size() == 3);
   REQUIRE(metadata[1].GetShape() == std::vector<int64_t>({4, 1}));
 
+  // Materializing the broadcast row then dividing covers the left-broadcast
+  // shapes norm chains produce after Inductor's algebraic rewrites.
+  {
+    auto expanded = std::make_shared<ir::Var>("expanded", type, TestSpan());
+    auto quotient = std::make_shared<ir::Var>("quotient", type, TestSpan());
+    auto expand_assignment = std::make_shared<ir::AssignStmt>(
+        expanded, OpCall("tensor.row_expand", {x, scale}, type), TestSpan());
+    auto div_assignment = std::make_shared<ir::AssignStmt>(
+        quotient, OpCall("tensor.div", {expanded, x}, type), TestSpan());
+    auto div_return = std::make_shared<ir::ReturnStmt>(
+        std::vector<ir::ExprPtr>{quotient}, TestSpan());
+    const TensorIrModule materialized = EmitTensorIr(MakeProgram(
+        "ignored_fused_name", {x, scale},
+        {ir::ParamDirection::In, ir::ParamDirection::In}, {type},
+        {expand_assignment, div_assignment, div_return}));
+    const std::string materialized_source = materialized.GetCanonicalSource();
+    REQUIRE(materialized_source.find(
+                "%value0 = broadcast %bcarg1 : tensor<4x1xf32> -> tensor<4x6xf32>") !=
+            std::string::npos);
+    REQUIRE(materialized_source.find("%value1 = div %value0, %arg0 : tensor<4x6xf32>") !=
+            std::string::npos);
+  }
+
   // A broadcast input feeding a plain op is rejected fail-closed.
   auto plain = std::make_shared<ir::Var>("plain", type, TestSpan());
   auto misuse = std::make_shared<ir::Var>("misuse", type, TestSpan());
