+ * THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED,
+ * INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
+ * See LICENSE in the root of the software repository for the full text of the License.
+ * -----------------------------------------------------------------------------------------------------------
+ */
+
+#include <type_traits>
+#include <vector>
+
+#include "pypto/backend/common/backend_type.h"
+#include "pypto/compiler/target_info.h"
+#include "pypto/core/dtype.h"
+#include "pypto/core/error.h"
+
+using pypto::DataType;
+using pypto::ValueError;
+using pypto::backend::BackendType;
+using pypto::compiler::IsSupportedNvidiaComputeCapability;
+using pypto::compiler::NvidiaTargetInfo;
+using pypto::compiler::TargetTraits;
+
+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+namespace {
+
+TargetTraits ValidTraits() {
+  return TargetTraits(120, 82, 32, 1024, 1536, 24, 1024, 1024, 64, 2147483647,
+                      65535, 65535, 128, 48 * 1024, 101376, 131072, 65536, 255,
+                      65536, 96ULL * 1024 * 1024, 24463ULL * 1024 * 1024);
+}
+
+}  // namespace
+
+int main() {
+  static_assert(!std::is_default_constructible_v<TargetTraits>);
+  static_assert(!std::is_default_constructible_v<NvidiaTargetInfo>);
+  static_assert(!std::is_copy_assignable_v<TargetTraits>);
+  static_assert(!std::is_move_assignable_v<TargetTraits>);
+  static_assert(!std::is_copy_assignable_v<NvidiaTargetInfo>);
+  static_assert(!std::is_move_assignable_v<NvidiaTargetInfo>);
+  static_assert(static_cast<int>(BackendType::Ascend910B) == 0);
+  static_assert(static_cast<int>(BackendType::Ascend950) == 1);
+  static_assert(static_cast<int>(BackendType::Nvidia) == 2);
+  static_assert(pypto::backend::HasBackendInstance(BackendType::Ascend910B));
+  static_assert(!pypto::backend::HasBackendInstance(BackendType::Nvidia));
+  static_assert(IsSupportedNvidiaComputeCapability(120));
+  static_assert(!IsSupportedNvidiaComputeCapability(100));
+
+  auto traits = ValidTraits();
+  REQUIRE(traits.GetComputeCapabilityMajor() == 12);
+  REQUIRE(traits.GetComputeCapabilityMinor() == 0);
+  REQUIRE(traits.GetMaxWarpsPerMultiprocessor() == 48);
+  NvidiaTargetInfo target(0, "NVIDIA GeForce RTX 5090 Laptop GPU", "GPU-test", "0000:01:00.0",
+                          traits, "13.3", "610.74", "tensor-ir-test", "cuda-tile-test",
+                          std::vector<DataType>{DataType::FP32, DataType::BF16});
+  REQUIRE(target.GetBackendType() == BackendType::Nvidia);
+  REQUIRE(target.GetTargetName() == "nvidia:sm_120");
+  REQUIRE(target.GetArchitecture() == "sm_120");
+  REQUIRE(target.GetArchConditionalArchitecture() == "sm_120a");
+  REQUIRE(target.SupportsComputeDtype(DataType::BF16));
+  REQUIRE(!target.SupportsComputeDtype(DataType::INT32));
+
+  bool rejected = false;
+  try {
+    TargetTraits invalid(100, 82, 32, 1024, 1536, 24, 1024, 1024, 64, 2147483647,
+                         65535, 65535, 128, 48 * 1024, 101376, 131072, 65536, 255,
+                         65536, 96ULL * 1024 * 1024, 24463ULL * 1024 * 1024);
+    (void)invalid;
+  } catch (const ValueError&) {
+    rejected = true;
+  }
+  REQUIRE(rejected);
+  return 0;
+}
