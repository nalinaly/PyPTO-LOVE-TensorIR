+ * -----------------------------------------------------------------------------------------------------------
+ */
+
+#include "pypto/compiler/target_info.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "pypto/core/error.h"
+
+namespace pypto::compiler {
+namespace {
+
+void RequirePositive(int value, const std::string& name) {
+  if (value <= 0) throw ValueError(name + " must be positive");
+}
+
+void RequirePositive(uint64_t value, const std::string& name) {
+  if (value == 0) throw ValueError(name + " must be positive");
+}
+
+void RequireText(const std::string& value, const std::string& name) {
+  if (value.empty() || std::isspace(static_cast<unsigned char>(value.front())) ||
+      std::isspace(static_cast<unsigned char>(value.back()))) {
+    throw ValueError(name + " must be non-empty and trimmed");
+  }
+}
+
+bool IsPowerOfTwo(uint64_t value) { return value != 0 && (value & (value - 1)) == 0; }
+
+}  // namespace
+
+TargetTraits::TargetTraits(int compute_capability, int multiprocessor_count, int warp_size,
+                           int max_threads_per_block, int max_threads_per_multiprocessor,
+                           int max_blocks_per_multiprocessor, int max_block_dim_x,
+                           int max_block_dim_y, int max_block_dim_z, int max_grid_dim_x,
+                           int max_grid_dim_y, int max_grid_dim_z, uint64_t l1_cache_line_bytes,
+                           uint64_t default_shared_memory_per_cta_bytes,
+                           uint64_t max_shared_memory_per_cta_bytes,
+                           uint64_t shared_memory_per_multiprocessor_bytes,
+                           uint64_t registers_per_cta, uint64_t max_registers_per_thread,
+                           uint64_t registers_per_multiprocessor,
+                           uint64_t l2_cache_size_bytes, uint64_t total_global_memory_bytes)
+    : compute_capability_(compute_capability),
+      multiprocessor_count_(multiprocessor_count),
+      warp_size_(warp_size),
+      max_threads_per_block_(max_threads_per_block),
+      max_threads_per_multiprocessor_(max_threads_per_multiprocessor),
+      max_blocks_per_multiprocessor_(max_blocks_per_multiprocessor),
+      max_block_dim_x_(max_block_dim_x),
+      max_block_dim_y_(max_block_dim_y),
+      max_block_dim_z_(max_block_dim_z),
+      max_grid_dim_x_(max_grid_dim_x),
+      max_grid_dim_y_(max_grid_dim_y),
+      max_grid_dim_z_(max_grid_dim_z),
+      l1_cache_line_bytes_(l1_cache_line_bytes),
+      default_shared_memory_per_cta_bytes_(default_shared_memory_per_cta_bytes),
+      max_shared_memory_per_cta_bytes_(max_shared_memory_per_cta_bytes),
+      shared_memory_per_multiprocessor_bytes_(shared_memory_per_multiprocessor_bytes),
+      registers_per_cta_(registers_per_cta),
+      max_registers_per_thread_(max_registers_per_thread),
+      registers_per_multiprocessor_(registers_per_multiprocessor),
+      l2_cache_size_bytes_(l2_cache_size_bytes),
+      total_global_memory_bytes_(total_global_memory_bytes) {
+  if (!IsSupportedNvidiaComputeCapability(compute_capability_)) {
+    throw ValueError("unsupported NVIDIA compute capability " + std::to_string(compute_capability_) +
+                     "; Phase 1 supports only SM120");
+  }
+  RequirePositive(multiprocessor_count_, "multiprocessor_count");
+  RequirePositive(warp_size_, "warp_size");
+  if (warp_size_ != 32) throw ValueError("SM120 warp_size must be 32");
+  RequirePositive(max_threads_per_block_, "max_threads_per_block");
+  RequirePositive(max_threads_per_multiprocessor_, "max_threads_per_multiprocessor");
+  RequirePositive(max_blocks_per_multiprocessor_, "max_blocks_per_multiprocessor");
+  RequirePositive(max_block_dim_x_, "max_block_dim_x");
+  RequirePositive(max_block_dim_y_, "max_block_dim_y");
+  RequirePositive(max_block_dim_z_, "max_block_dim_z");
+  RequirePositive(max_grid_dim_x_, "max_grid_dim_x");
+  RequirePositive(max_grid_dim_y_, "max_grid_dim_y");
+  RequirePositive(max_grid_dim_z_, "max_grid_dim_z");
+  if (max_threads_per_block_ > max_threads_per_multiprocessor_) {
+    throw ValueError("max_threads_per_block cannot exceed max_threads_per_multiprocessor");
+  }
+  if (max_threads_per_block_ % warp_size_ != 0 || max_threads_per_multiprocessor_ % warp_size_ != 0) {
+    throw ValueError("thread limits must be divisible by warp_size");
+  }
+  RequirePositive(l1_cache_line_bytes_, "l1_cache_line_bytes");
+  if (!IsPowerOfTwo(l1_cache_line_bytes_)) {
+    throw ValueError("l1_cache_line_bytes must be a power of two");
+  }
+  RequirePositive(default_shared_memory_per_cta_bytes_,
+                  "default_shared_memory_per_cta_bytes");
+  RequirePositive(max_shared_memory_per_cta_bytes_, "max_shared_memory_per_cta_bytes");
+  RequirePositive(shared_memory_per_multiprocessor_bytes_,
+                  "shared_memory_per_multiprocessor_bytes");
+  if (default_shared_memory_per_cta_bytes_ > max_shared_memory_per_cta_bytes_) {
+    throw ValueError(
+        "default_shared_memory_per_cta_bytes cannot exceed the opt-in CTA maximum");
+  }
+  if (max_shared_memory_per_cta_bytes_ > shared_memory_per_multiprocessor_bytes_) {
+    throw ValueError("max_shared_memory_per_cta_bytes cannot exceed shared memory per multiprocessor");
+  }
+  RequirePositive(registers_per_cta_, "registers_per_cta");
+  RequirePositive(max_registers_per_thread_, "max_registers_per_thread");
+  RequirePositive(registers_per_multiprocessor_, "registers_per_multiprocessor");
+  if (max_registers_per_thread_ > registers_per_cta_) {
+    throw ValueError("max_registers_per_thread cannot exceed registers_per_cta");
+  }
+  if (registers_per_cta_ > registers_per_multiprocessor_) {
+    throw ValueError("registers_per_cta cannot exceed registers_per_multiprocessor");
+  }
+  RequirePositive(l2_cache_size_bytes_, "l2_cache_size_bytes");
+  RequirePositive(total_global_memory_bytes_, "total_global_memory_bytes");
+  if (l2_cache_size_bytes_ > total_global_memory_bytes_) {
+    throw ValueError("l2_cache_size_bytes cannot exceed total_global_memory_bytes");
+  }
+}
+
+NvidiaTargetInfo::NvidiaTargetInfo(int device_ordinal, std::string device_name,
+                                   std::string device_uuid, std::string pci_device_id,
+                                   TargetTraits traits, std::string cuda_toolkit_version,
+                                   std::string cuda_driver_version,
+                                   std::string tensor_ir_revision,
+                                   std::string cuda_tile_revision,
+                                   std::vector<DataType> supported_compute_dtypes)
+    : device_ordinal_(device_ordinal),
+      device_name_(std::move(device_name)),
+      device_uuid_(std::move(device_uuid)),
+      pci_device_id_(std::move(pci_device_id)),
+      traits_(std::move(traits)),
+      cuda_toolkit_version_(std::move(cuda_toolkit_version)),
+      cuda_driver_version_(std::move(cuda_driver_version)),
+      tensor_ir_revision_(std::move(tensor_ir_revision)),
+      cuda_tile_revision_(std::move(cuda_tile_revision)),
+      supported_compute_dtypes_(std::move(supported_compute_dtypes)) {
+  if (device_ordinal_ < 0) throw ValueError("device_ordinal must be non-negative");
+  RequireText(device_name_, "device_name");
+  RequireText(device_uuid_, "device_uuid");
+  RequireText(pci_device_id_, "pci_device_id");
+  RequireText(cuda_toolkit_version_, "cuda_toolkit_version");
+  RequireText(cuda_driver_version_, "cuda_driver_version");
+  RequireText(tensor_ir_revision_, "tensor_ir_revision");
+  RequireText(cuda_tile_revision_, "cuda_tile_revision");
+  if (supported_compute_dtypes_.empty()) {
+    throw ValueError("supported_compute_dtypes must be non-empty");
+  }
+  if (std::any_of(supported_compute_dtypes_.begin(), supported_compute_dtypes_.end(),
+                  [](DataType dtype) { return dtype.GetBit() == 0; })) {
+    throw ValueError("supported_compute_dtypes contains an unknown DataType code");
+  }
+  std::sort(supported_compute_dtypes_.begin(), supported_compute_dtypes_.end(),
+            [](DataType first, DataType second) { return first.Code() < second.Code(); });
+  const auto duplicate =
+      std::adjacent_find(supported_compute_dtypes_.begin(), supported_compute_dtypes_.end());
+  if (duplicate != supported_compute_dtypes_.end()) {
+    throw ValueError("supported_compute_dtypes must not contain duplicates");
+  }
+  if (supported_compute_dtypes_.size() != 2 ||
+      !SupportsComputeDtype(DataType::BF16) || !SupportsComputeDtype(DataType::FP32)) {
+    throw ValueError("NVIDIA target v1 compute dtypes must be exactly BF16 and FP32");
+  }
+}
+
+bool NvidiaTargetInfo::SupportsComputeDtype(DataType dtype) const noexcept {
+  return std::binary_search(supported_compute_dtypes_.begin(), supported_compute_dtypes_.end(), dtype,
+                            [](DataType first, DataType second) { return first.Code() < second.Code(); });
+}
+
+std::string NvidiaTargetInfo::GetArchitecture() const {
+  return "sm_" + std::to_string(traits_.GetComputeCapability());
+}
+
+std::string NvidiaTargetInfo::GetArchConditionalArchitecture() const {
+  return GetArchitecture() + "a";
+}
+
+std::string NvidiaTargetInfo::GetTargetName() const { return "nvidia:" + GetArchitecture(); }
+
+}  // namespace pypto::compiler
