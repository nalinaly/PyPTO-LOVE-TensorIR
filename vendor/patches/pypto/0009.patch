+        ("max_blocks_per_multiprocessor", 0, "max_blocks"),
+        ("max_block_dim_z", 0, "max_block_dim_z"),
+        ("max_grid_dim_y", 0, "max_grid_dim_y"),
+        ("l1_cache_line_bytes", 96, "power of two"),
+        ("max_shared_memory_per_cta_bytes", 262144, "cannot exceed"),
+        ("default_shared_memory_per_cta_bytes", 120000, "opt-in"),
+        ("registers_per_cta", 131072, "cannot exceed"),
+        ("max_registers_per_thread", 70000, "cannot exceed"),
+        ("l2_cache_size_bytes", 0, "l2_cache"),
+        ("total_global_memory_bytes", 0, "total_global"),
