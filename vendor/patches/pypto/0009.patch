+# -----------------------------------------------------------------------------------------------------------
+
+"""One fail-closed guard for Ascend-era Backend singleton consumers."""
+
+from pypto.pypto_core import backend as _backend_core
+
+
+def require_legacy_backend_instance(backend_type, *, operation: str):
+    """Reject target-only identities before a legacy API changes any state."""
+
+    if not _backend_core.has_backend_instance(backend_type):
+        raise ValueError(
+            f"{operation} does not support target-only backend {backend_type.name}; "
+            "use the NVIDIA compiler/runtime pipeline"
+        )
+    return backend_type
+
+
+__all__ = ["require_legacy_backend_instance"]
