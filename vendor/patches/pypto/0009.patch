+        ("pci_device_id", ""),
+        ("cuda_toolkit_version", ""),
+        ("cuda_driver_version", ""),
+        ("tensor_ir_revision", ""),
+        ("cuda_tile_revision", ""),
+    ],
+)
+def test_target_identity_fields_fail_closed(field: str, value: object) -> None:
+    with pytest.raises(ValueError):
+        target(**{field: value})
+
+
+def test_dtype_capabilities_require_unique_bf16_and_fp32() -> None:
+    with pytest.raises(ValueError, match="non-empty"):
+        target(supported_compute_dtypes=[])
+    with pytest.raises(ValueError, match="duplicates"):
+        target(
+            supported_compute_dtypes=[
+                pypto.DataType.BF16,
+                pypto.DataType.BF16,
+                pypto.DataType.FP32,
+            ]
+        )
+    with pytest.raises(ValueError, match="exactly BF16 and FP32"):
+        target(supported_compute_dtypes=[pypto.DataType.BF16])
+    with pytest.raises(ValueError, match="exactly BF16 and FP32"):
+        target(
+            supported_compute_dtypes=[
+                pypto.DataType.BF16,
+                pypto.DataType.FP32,
+                pypto.DataType.INT32,
+            ]
+        )
