@@ -0,0 +1,227 @@
+"""Immutable NVIDIA SM120 target identity contract."""
+
+from __future__ import annotations
+
+import pytest
+
+import pypto
+from pypto import backend
+from pypto.compiler import (
+    NvidiaTargetInfo,
+    TargetTraits,
+    is_supported_nvidia_compute_capability,
+)
+from pypto.ir.compile import _select_backend
+from pypto.ir.compiled_program import CompiledProgram
+from pypto.ir.distributed_compiled_program import DistributedCompiledProgram
+from pypto.runtime.runner import RunConfig
+
+
+def traits(**overrides) -> TargetTraits:
+    values = dict(
+        compute_capability=120,
+        multiprocessor_count=82,
+        warp_size=32,
+        max_threads_per_block=1024,
+        max_threads_per_multiprocessor=1536,
+        max_blocks_per_multiprocessor=24,
+        max_block_dim_x=1024,
+        max_block_dim_y=1024,
+        max_block_dim_z=64,
+        max_grid_dim_x=(1 << 31) - 1,
+        max_grid_dim_y=65535,
+        max_grid_dim_z=65535,
+        l1_cache_line_bytes=128,
+        default_shared_memory_per_cta_bytes=48 * 1024,
+        max_shared_memory_per_cta_bytes=101376,
+        shared_memory_per_multiprocessor_bytes=131072,
+        registers_per_cta=65536,
+        max_registers_per_thread=255,
+        registers_per_multiprocessor=65536,
+        l2_cache_size_bytes=96 * 1024 * 1024,
+        total_global_memory_bytes=24_463 * 1024 * 1024,
+    )
+    values.update(overrides)
+    return TargetTraits(**values)
+
+
+def target(**overrides) -> NvidiaTargetInfo:
+    values = dict(
+        device_ordinal=0,
+        device_name="NVIDIA GeForce RTX 5090 Laptop GPU",
+        device_uuid="GPU-test",
+        pci_device_id="0000:01:00.0",
+        traits=traits(),
+        cuda_toolkit_version="13.3",
+        cuda_driver_version="610.74",
+        tensor_ir_revision="3b5a8bebc00510b46a1e8b97229d06dd0d006215",
+        cuda_tile_revision="af2417041cc939b87ef56d92cfdcf61737c5457e",
+        supported_compute_dtypes=[pypto.DataType.FP32, pypto.DataType.BF16],
+    )
+    values.update(overrides)
+    return NvidiaTargetInfo(**values)
+
+
+def test_backend_enum_appends_nvidia_without_renumbering_ascend() -> None:
+    assert backend.BackendType.Ascend910B.value == 0
+    assert backend.BackendType.Ascend950.value == 1
+    assert backend.BackendType.Nvidia.value == 2
+    assert backend.has_backend_instance(backend.BackendType.Ascend910B)
+    assert backend.has_backend_instance(backend.BackendType.Ascend950)
+    assert not backend.has_backend_instance(backend.BackendType.Nvidia)
+
+
+def test_nvidia_cannot_poison_legacy_global_backend_state() -> None:
+    backend.reset_for_testing()
+    with pytest.raises(ValueError, match="no legacy Backend instance"):
+        backend.set_backend_type(backend.BackendType.Nvidia)
+    assert not backend.is_backend_configured()
+    with pytest.raises(ValueError, match="without a legacy Backend singleton"):
+        backend.get_backend_instance(backend.BackendType.Nvidia)
+
+
+def test_legacy_compile_rejects_before_platform_override_or_global_write() -> None:
+    backend.reset_for_testing()
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        _select_backend(
+            backend_type=backend.BackendType.Nvidia,
+            platform="a2a3",
+        )
+    assert not backend.is_backend_configured()
+    backend.set_backend_type(backend.BackendType.Ascend950)
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        _select_backend(
+            backend_type=backend.BackendType.Nvidia,
+            platform="a2a3",
+        )
+    assert backend.get_backend_type() == backend.BackendType.Ascend950
+    backend.reset_for_testing()
+
+
+def test_all_legacy_object_entrypoints_reject_target_only_backend(tmp_path) -> None:
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        RunConfig(platform="a2a3", backend_type=backend.BackendType.Nvidia)
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        CompiledProgram(
+            None,
+            str(tmp_path / "single"),
+            backend_type=backend.BackendType.Nvidia,
+            platform="a2a3",
+        )
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        DistributedCompiledProgram(
+            None,
+            str(tmp_path / "distributed"),
+            backend_type=backend.BackendType.Nvidia,
+            platform="a2a3",
+        )
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        CompiledProgram.from_dir(
+            tmp_path / "missing-single",
+            backend_type=backend.BackendType.Nvidia,
+        )
+    with pytest.raises(ValueError, match="target-only backend Nvidia"):
+        DistributedCompiledProgram.from_dir(
+            tmp_path / "missing-distributed",
+            backend_type=backend.BackendType.Nvidia,
+        )
+    assert not (tmp_path / "single").exists()
+    assert not (tmp_path / "distributed").exists()
+
+
+def test_target_identity_and_all_resource_fields_are_derived_or_read_only() -> None:
+    value = target()
+    assert value.backend_type == backend.BackendType.Nvidia
+    assert value.target_name == "nvidia:sm_120"
+    assert value.architecture == "sm_120"
+    assert value.arch_conditional_architecture == "sm_120a"
+    assert value.device_ordinal == 0
+    assert value.cuda_toolkit_version == "13.3"
+    assert value.cuda_driver_version == "610.74"
+    assert value.traits.compute_capability == 120
+    assert value.traits.compute_capability_major == 12
+    assert value.traits.compute_capability_minor == 0
+    assert value.traits.max_warps_per_multiprocessor == 48
+    assert value.traits.default_shared_memory_per_cta_bytes == 48 * 1024
+    assert value.traits.max_shared_memory_per_cta_bytes > 48 * 1024
+    assert value.traits.max_registers_per_thread == 255
+    assert value.supported_compute_dtypes == [pypto.DataType.FP32, pypto.DataType.BF16]
+    assert value.supports_compute_dtype(pypto.DataType.BF16)
+    assert not value.supports_compute_dtype(pypto.DataType.INT32)
+    with pytest.raises(AttributeError):
+        value.device_name = "changed"
+    with pytest.raises(AttributeError):
+        value.traits.warp_size = 64
+
+
+@pytest.mark.parametrize("compute_capability", [100, 103, 121])
+def test_only_sm120_is_supported_in_phase_one(compute_capability: int) -> None:
+    assert not is_supported_nvidia_compute_capability(compute_capability)
