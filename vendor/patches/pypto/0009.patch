+
+#ifndef PYPTO_COMPILER_TARGET_INFO_H_
+#define PYPTO_COMPILER_TARGET_INFO_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "pypto/backend/common/backend_type.h"
+#include "pypto/core/dtype.h"
+
+namespace pypto::compiler {
+
+[[nodiscard]] constexpr bool IsSupportedNvidiaComputeCapability(int compute_capability) noexcept {
+  return compute_capability == 120;
+}
+
+class TargetTraits {
+ public:
+  TargetTraits() = delete;
+  TargetTraits(int compute_capability, int multiprocessor_count, int warp_size,
+               int max_threads_per_block, int max_threads_per_multiprocessor,
+               int max_blocks_per_multiprocessor, int max_block_dim_x, int max_block_dim_y,
+               int max_block_dim_z, int max_grid_dim_x, int max_grid_dim_y, int max_grid_dim_z,
+               uint64_t l1_cache_line_bytes, uint64_t default_shared_memory_per_cta_bytes,
+               uint64_t max_shared_memory_per_cta_bytes,
+               uint64_t shared_memory_per_multiprocessor_bytes, uint64_t registers_per_cta,
+               uint64_t max_registers_per_thread, uint64_t registers_per_multiprocessor,
+               uint64_t l2_cache_size_bytes, uint64_t total_global_memory_bytes);
+  TargetTraits(const TargetTraits&) = default;
+  TargetTraits(TargetTraits&&) = default;
+  TargetTraits& operator=(const TargetTraits&) = delete;
+  TargetTraits& operator=(TargetTraits&&) = delete;
+
+  [[nodiscard]] int GetComputeCapability() const noexcept { return compute_capability_; }
+  [[nodiscard]] int GetComputeCapabilityMajor() const noexcept { return compute_capability_ / 10; }
+  [[nodiscard]] int GetComputeCapabilityMinor() const noexcept { return compute_capability_ % 10; }
+  [[nodiscard]] int GetMultiprocessorCount() const noexcept { return multiprocessor_count_; }
+  [[nodiscard]] int GetWarpSize() const noexcept { return warp_size_; }
+  [[nodiscard]] int GetMaxThreadsPerBlock() const noexcept { return max_threads_per_block_; }
+  [[nodiscard]] int GetMaxThreadsPerMultiprocessor() const noexcept {
+    return max_threads_per_multiprocessor_;
+  }
+  [[nodiscard]] int GetMaxBlocksPerMultiprocessor() const noexcept {
+    return max_blocks_per_multiprocessor_;
+  }
+  [[nodiscard]] int GetMaxBlockDimX() const noexcept { return max_block_dim_x_; }
+  [[nodiscard]] int GetMaxBlockDimY() const noexcept { return max_block_dim_y_; }
+  [[nodiscard]] int GetMaxBlockDimZ() const noexcept { return max_block_dim_z_; }
+  [[nodiscard]] int GetMaxGridDimX() const noexcept { return max_grid_dim_x_; }
+  [[nodiscard]] int GetMaxGridDimY() const noexcept { return max_grid_dim_y_; }
+  [[nodiscard]] int GetMaxGridDimZ() const noexcept { return max_grid_dim_z_; }
+  [[nodiscard]] int GetMaxWarpsPerMultiprocessor() const noexcept {
+    return max_threads_per_multiprocessor_ / warp_size_;
+  }
+  [[nodiscard]] uint64_t GetL1CacheLineBytes() const noexcept { return l1_cache_line_bytes_; }
+  [[nodiscard]] uint64_t GetDefaultSharedMemoryPerCtaBytes() const noexcept {
+    return default_shared_memory_per_cta_bytes_;
+  }
+  [[nodiscard]] uint64_t GetMaxSharedMemoryPerCtaBytes() const noexcept {
+    return max_shared_memory_per_cta_bytes_;
+  }
+  [[nodiscard]] uint64_t GetSharedMemoryPerMultiprocessorBytes() const noexcept {
+    return shared_memory_per_multiprocessor_bytes_;
+  }
+  [[nodiscard]] uint64_t GetRegistersPerCta() const noexcept { return registers_per_cta_; }
+  [[nodiscard]] uint64_t GetMaxRegistersPerThread() const noexcept {
+    return max_registers_per_thread_;
+  }
+  [[nodiscard]] uint64_t GetRegistersPerMultiprocessor() const noexcept {
+    return registers_per_multiprocessor_;
+  }
+  [[nodiscard]] uint64_t GetL2CacheSizeBytes() const noexcept { return l2_cache_size_bytes_; }
+  [[nodiscard]] uint64_t GetTotalGlobalMemoryBytes() const noexcept {
+    return total_global_memory_bytes_;
+  }
+
+ private:
+  int compute_capability_;
+  int multiprocessor_count_;
+  int warp_size_;
+  int max_threads_per_block_;
+  int max_threads_per_multiprocessor_;
+  int max_blocks_per_multiprocessor_;
+  int max_block_dim_x_;
+  int max_block_dim_y_;
+  int max_block_dim_z_;
+  int max_grid_dim_x_;
+  int max_grid_dim_y_;
+  int max_grid_dim_z_;
+  uint64_t l1_cache_line_bytes_;
+  uint64_t default_shared_memory_per_cta_bytes_;
+  uint64_t max_shared_memory_per_cta_bytes_;
+  uint64_t shared_memory_per_multiprocessor_bytes_;
+  uint64_t registers_per_cta_;
+  uint64_t max_registers_per_thread_;
+  uint64_t registers_per_multiprocessor_;
+  uint64_t l2_cache_size_bytes_;
+  uint64_t total_global_memory_bytes_;
+};
+
+class NvidiaTargetInfo {
+ public:
+  NvidiaTargetInfo() = delete;
+  NvidiaTargetInfo(int device_ordinal, std::string device_name, std::string device_uuid,
+                   std::string pci_device_id, TargetTraits traits,
+                   std::string cuda_toolkit_version, std::string cuda_driver_version,
+                   std::string tensor_ir_revision, std::string cuda_tile_revision,
+                   std::vector<DataType> supported_compute_dtypes);
+  NvidiaTargetInfo(const NvidiaTargetInfo&) = default;
+  NvidiaTargetInfo(NvidiaTargetInfo&&) = default;
+  NvidiaTargetInfo& operator=(const NvidiaTargetInfo&) = delete;
+  NvidiaTargetInfo& operator=(NvidiaTargetInfo&&) = delete;
+
+  [[nodiscard]] backend::BackendType GetBackendType() const noexcept {
+    return backend::BackendType::Nvidia;
+  }
+  [[nodiscard]] int GetDeviceOrdinal() const noexcept { return device_ordinal_; }
+  [[nodiscard]] const std::string& GetDeviceName() const noexcept { return device_name_; }
+  [[nodiscard]] const std::string& GetDeviceUuid() const noexcept { return device_uuid_; }
+  [[nodiscard]] const std::string& GetPciDeviceId() const noexcept { return pci_device_id_; }
+  [[nodiscard]] const TargetTraits& GetTraits() const noexcept { return traits_; }
+  [[nodiscard]] const std::string& GetCudaToolkitVersion() const noexcept {
+    return cuda_toolkit_version_;
+  }
+  [[nodiscard]] const std::string& GetCudaDriverVersion() const noexcept {
+    return cuda_driver_version_;
+  }
+  [[nodiscard]] const std::string& GetTensorIrRevision() const noexcept {
+    return tensor_ir_revision_;
+  }
+  [[nodiscard]] const std::string& GetCudaTileRevision() const noexcept {
+    return cuda_tile_revision_;
+  }
+  [[nodiscard]] const std::vector<DataType>& GetSupportedComputeDtypes() const noexcept {
+    return supported_compute_dtypes_;
+  }
+  [[nodiscard]] bool SupportsComputeDtype(DataType dtype) const noexcept;
+  [[nodiscard]] std::string GetTargetName() const;
+  [[nodiscard]] std::string GetArchitecture() const;
+  [[nodiscard]] std::string GetArchConditionalArchitecture() const;
+
+ private:
+  int device_ordinal_;
+  std::string device_name_;
+  std::string device_uuid_;
+  std::string pci_device_id_;
+  TargetTraits traits_;
+  std::string cuda_toolkit_version_;
+  std::string cuda_driver_version_;
+  std::string tensor_ir_revision_;
+  std::string cuda_tile_revision_;
+  std::vector<DataType> supported_compute_dtypes_;
+};
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_TARGET_INFO_H_
