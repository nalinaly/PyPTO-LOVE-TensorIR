+#include "nvidia_backend_bridge.h"
+
+#include "tensor_ir/Compiler/Compiler.h"
+#include "tensor_ir/Utils/ComputeCapability.h"
+
+#include "mlir/Support/LogicalResult.h"
+
+namespace pypto::compiler::detail {
+
+NvidiaBackendProbeResult ProbePrivateNvidiaCompiler() {
+  auto target = mlir::nv_tensor_ir::SmTarget::fromCc(120);
+  if (mlir::failed(target)) return {};
+
+  auto compiler = mlir::nv_tensor_ir::ICompiler::create(
+      mlir::nv_tensor_ir::CompilerBackend::CudaTile);
+  if (!compiler) return {};
+  return NvidiaBackendProbeResult{true, target->toString()};
+}
+
+}  // namespace pypto::compiler::detail
