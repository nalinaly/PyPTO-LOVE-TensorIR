+    target_link_libraries(${LIBRARY_NAME} PRIVATE
+        pypto_nvidia_bridge_objects
+    )
+endif()
+
+# Static TensorIR/LLVM archives are private implementation details. Their
+# default-visible symbols must not enter the process-wide dynamic symbol table
+# where another extension (for example Triton) may embed a different LLVM.
+if(UNIX AND NOT APPLE)
+    target_link_options(${LIBRARY_NAME} PRIVATE
+        "LINKER:--exclude-libs,ALL"
+        "LINKER:--version-script=${CMAKE_CURRENT_SOURCE_DIR}/pypto_core.map"
+    )
+    set_property(TARGET ${LIBRARY_NAME} APPEND PROPERTY LINK_DEPENDS
+        "${CMAKE_CURRENT_SOURCE_DIR}/pypto_core.map")
+endif()
 
 # Handle installation based on build mode
 if(SKBUILD_MODE)
@@ -74,8 +91,16 @@ if(SKBUILD_MODE)
     endif()
