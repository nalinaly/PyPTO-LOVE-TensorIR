-    CACHE STRING "Exact CUDA Toolkit package version")
+set(PYPTO_NVIDIA_CUDA_TOOLKIT_VERSION "13.3.73")
 set(PYPTO_NVIDIA_TILEIRAS_EXECUTABLE
-    "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}/bin/tileiras"
-    CACHE FILEPATH "Exact CUDA Tile IR assembler")
-set(PYPTO_NVIDIA_TILEIRAS_VERSION "13.3.36"
-    CACHE STRING "Exact tileiras executable version")
+    "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}/bin/tileiras")
+set(PYPTO_NVIDIA_TILEIRAS_VERSION "13.3.36")
 set(PYPTO_NVIDIA_TILEIRAS_SHA256
-    "88737a8be5c56bf73fb885a567a950f247a8cfa1d146dbc7a65eff77e7d62bf0"
-    CACHE STRING "Exact tileiras executable SHA-256")
+    "88737a8be5c56bf73fb885a567a950f247a8cfa1d146dbc7a65eff77e7d62bf0")
+
+find_package(Git REQUIRED)
+function(_pypto_require_git_revision source_dir expected_revision label)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" rev-parse HEAD
+        RESULT_VARIABLE _revision_status
+        OUTPUT_VARIABLE _actual_revision
+        ERROR_VARIABLE _revision_error
+        OUTPUT_STRIP_TRAILING_WHITESPACE)
+    if(NOT _revision_status EQUAL 0 OR
+       NOT _actual_revision STREQUAL expected_revision)
+        message(FATAL_ERROR
+            "${label} revision '${_actual_revision}' differs from locked "
+            "revision '${expected_revision}': ${_revision_error}")
+    endif()
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" diff --quiet
+        RESULT_VARIABLE _worktree_status)
+    execute_process(
+        COMMAND "${GIT_EXECUTABLE}" -C "${source_dir}" diff --cached --quiet
+        RESULT_VARIABLE _index_status)
+    if(NOT _worktree_status EQUAL 0 OR NOT _index_status EQUAL 0)
+        message(FATAL_ERROR "${label} has tracked source changes")
+    endif()
+endfunction()
+
+_pypto_require_git_revision(
+    "${_pypto_tensor_ir_source}" "${PYPTO_NVIDIA_TENSOR_IR_REVISION}"
+    "TensorIR")
+_pypto_require_git_revision(
+    "${_pypto_cuda_tile_source}" "${PYPTO_NVIDIA_CUDA_TILE_REVISION}"
+    "CUDA Tile")
+_pypto_require_git_revision(
+    "${_pypto_llvm_source}" "${PYPTO_NVIDIA_LLVM_REVISION}" "LLVM")
 
 file(REAL_PATH "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}"
      _pypto_cuda_toolkit_real EXPAND_TILDE)
@@ -114,10 +146,8 @@ foreach(_forbidden_target tensor_ir-compiler tensor_ir-opt cuda-tile-opt
                 "Standalone NVIDIA tool leaked into PyPTO: ${_forbidden_target}")
     endif()
 endforeach()
-add_library(pypto_nvidia_backend_dependencies INTERFACE)
-target_link_libraries(pypto_nvidia_backend_dependencies INTERFACE
-    NVTensorIR::Compiler)
-target_compile_definitions(pypto_nvidia_backend_dependencies INTERFACE
+add_library(pypto_nvidia_backend_identity INTERFACE)
+target_compile_definitions(pypto_nvidia_backend_identity INTERFACE
     PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND=1
     PYPTO_TENSOR_IR_REVISION="${PYPTO_NVIDIA_TENSOR_IR_REVISION}"
     PYPTO_CUDA_TILE_REVISION="${PYPTO_NVIDIA_CUDA_TILE_REVISION}"
@@ -127,3 +157,37 @@ target_compile_definitions(pypto_nvidia_backend_dependencies INTERFACE
     PYPTO_TILEIRAS_REAL_PATH="${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}"
     PYPTO_TILEIRAS_VERSION="${PYPTO_NVIDIA_TILEIRAS_VERSION}"
     PYPTO_TILEIRAS_SHA256="${PYPTO_NVIDIA_TILEIRAS_SHA256}")
+
+add_library(pypto_nvidia_backend_dependencies INTERFACE)
+target_link_libraries(pypto_nvidia_backend_dependencies INTERFACE
+    NVTensorIR::Compiler
+    pypto_nvidia_backend_identity)
+
+function(pypto_apply_nvidia_llvm_abi target)
+    if(MSVC)
+        target_compile_options("${target}" PRIVATE /GR- /EHs-c-)
+        target_compile_definitions("${target}" PRIVATE _HAS_EXCEPTIONS=0)
+    elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
+        target_compile_options("${target}" PRIVATE
+            -fno-rtti
+            -fno-exceptions)
+    else()
+        message(FATAL_ERROR
+            "Unsupported compiler for the private LLVM ABI bridge: "
+            "${CMAKE_CXX_COMPILER_ID}")
+    endif()
+endfunction()
+
+# Keep MLIR/LLVM's no-RTTI/no-exception ABI inside a narrow bridge instead of
+# propagating it through PyPTO's exception-enabled compiler object library.
+add_library(pypto_nvidia_bridge_objects OBJECT
+    "${CMAKE_SOURCE_DIR}/src/compiler/nvidia_backend_bridge.cpp")
+target_include_directories(pypto_nvidia_bridge_objects PRIVATE
+    "${CMAKE_SOURCE_DIR}/src/compiler")
+target_link_libraries(pypto_nvidia_bridge_objects PRIVATE
+    pypto_nvidia_backend_dependencies)
+pypto_apply_nvidia_llvm_abi(pypto_nvidia_bridge_objects)
+set_target_properties(pypto_nvidia_bridge_objects PROPERTIES
+    POSITION_INDEPENDENT_CODE ON
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON)
