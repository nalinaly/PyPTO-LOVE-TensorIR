+#define PYPTO_COMPILER_NVIDIA_BACKEND_BRIDGE_H_
+
+#include <string>
+
+namespace pypto::compiler::detail {
+
+/** TensorIR probe result crossing the private no-RTTI/no-EH bridge. */
+struct NvidiaBackendProbeResult {
+  bool compiler_factory_available = false;
+  std::string sm120_target;
+};
+
+[[nodiscard]] NvidiaBackendProbeResult ProbePrivateNvidiaCompiler();
+
+}  // namespace pypto::compiler::detail
