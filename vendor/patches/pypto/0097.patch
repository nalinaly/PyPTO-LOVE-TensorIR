+    assert info.tensor_ir_revision == "0449388f5499cd750dbfc0fb671a58a01271f163"
     assert info.cuda_tile_revision == "af2417041cc939b87ef56d92cfdcf61737c5457e"
     assert info.llvm_revision == "57109befac92811d2253109242ca6fa69c961fb2"
     assert info.cuda_toolkit_root == "/usr/local/cuda-13.3"
