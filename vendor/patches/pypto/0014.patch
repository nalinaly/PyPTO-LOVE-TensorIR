+#ifndef PYPTO_COMPILER_NVIDIA_BACKEND_BUILD_INFO_H_
+#define PYPTO_COMPILER_NVIDIA_BACKEND_BUILD_INFO_H_
+
+#include <string>
+
+namespace pypto::compiler {
+
+/** Immutable diagnostic identity of the compiled-in private NVIDIA backend. */
+class NvidiaBackendBuildInfo {
+ public:
+  NvidiaBackendBuildInfo() = delete;
+  NvidiaBackendBuildInfo(bool compiled, bool compiler_factory_available, std::string tensor_ir_revision,
+                         std::string cuda_tile_revision, std::string llvm_revision,
+                         std::string cuda_toolkit_root, std::string cuda_toolkit_version,
+                         std::string tileiras_real_path, std::string tileiras_version,
+                         std::string tileiras_sha256, std::string sm120_target);
+  NvidiaBackendBuildInfo(const NvidiaBackendBuildInfo&) = default;
+  NvidiaBackendBuildInfo(NvidiaBackendBuildInfo&&) = default;
+  NvidiaBackendBuildInfo& operator=(const NvidiaBackendBuildInfo&) = delete;
+  NvidiaBackendBuildInfo& operator=(NvidiaBackendBuildInfo&&) = delete;
+
+  [[nodiscard]] bool IsCompiled() const noexcept { return compiled_; }
+  [[nodiscard]] bool IsCompilerFactoryAvailable() const noexcept { return compiler_factory_available_; }
+  [[nodiscard]] const std::string& GetTensorIrRevision() const noexcept { return tensor_ir_revision_; }
+  [[nodiscard]] const std::string& GetCudaTileRevision() const noexcept { return cuda_tile_revision_; }
+  [[nodiscard]] const std::string& GetLlvmRevision() const noexcept { return llvm_revision_; }
+  [[nodiscard]] const std::string& GetCudaToolkitRoot() const noexcept { return cuda_toolkit_root_; }
+  [[nodiscard]] const std::string& GetCudaToolkitVersion() const noexcept { return cuda_toolkit_version_; }
+  [[nodiscard]] const std::string& GetTileirasRealPath() const noexcept { return tileiras_real_path_; }
+  [[nodiscard]] const std::string& GetTileirasVersion() const noexcept { return tileiras_version_; }
+  [[nodiscard]] const std::string& GetTileirasSha256() const noexcept { return tileiras_sha256_; }
+  [[nodiscard]] const std::string& GetSm120Target() const noexcept { return sm120_target_; }
+
+ private:
+  bool compiled_;
+  bool compiler_factory_available_;
+  std::string tensor_ir_revision_;
+  std::string cuda_tile_revision_;
+  std::string llvm_revision_;
+  std::string cuda_toolkit_root_;
+  std::string cuda_toolkit_version_;
+  std::string tileiras_real_path_;
+  std::string tileiras_version_;
+  std::string tileiras_sha256_;
+  std::string sm120_target_;
+};
+
+/** Return compiled backend identity without querying a device or CUDA context. */
+[[nodiscard]] NvidiaBackendBuildInfo GetNvidiaBackendBuildInfo();
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_NVIDIA_BACKEND_BUILD_INFO_H_
