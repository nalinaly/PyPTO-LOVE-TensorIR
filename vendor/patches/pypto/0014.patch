diff --git a/cmake/nvidia_backend.cmake b/cmake/nvidia_backend.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..a92a874aabdb964e9cbc1e489b45c5524b83ca7d
--- /dev/null
+++ b/cmake/nvidia_backend.cmake
@@ -0,0 +1,129 @@
+# Private NVIDIA compiler composition for the single public PyPTO product.
+
+include_guard(GLOBAL)
+
+set(_pypto_nvidia_root "${CMAKE_SOURCE_DIR}/3rdparty/nvidia")
+set(_pypto_tensor_ir_source "${_pypto_nvidia_root}/tensor-ir")
+set(_pypto_cuda_tile_source "${_pypto_nvidia_root}/cuda-tile")
+set(_pypto_llvm_source "${_pypto_nvidia_root}/llvm-project")
+
+foreach(_required_source
+        "${_pypto_tensor_ir_source}/CMakeLists.txt"
+        "${_pypto_cuda_tile_source}/CMakeLists.txt"
+        "${_pypto_llvm_source}/llvm/CMakeLists.txt"
+        "${_pypto_llvm_source}/mlir/CMakeLists.txt")
+    if(NOT EXISTS "${_required_source}")
+        message(FATAL_ERROR
+                "PyPTO NVIDIA backend source is incomplete: ${_required_source}")
+    endif()
+endforeach()
+
+set(PYPTO_NVIDIA_TENSOR_IR_REVISION
+    "ca8640e71cd5a95a041f60d8e18672c806f38e42"
+    CACHE STRING "Exact private TensorIR revision")
+set(PYPTO_NVIDIA_CUDA_TILE_REVISION
+    "af2417041cc939b87ef56d92cfdcf61737c5457e"
+    CACHE STRING "Exact private CUDA Tile revision")
+set(PYPTO_NVIDIA_LLVM_REVISION
+    "57109befac92811d2253109242ca6fa69c961fb2"
+    CACHE STRING "Exact private LLVM revision")
+set(PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT "/usr/local/cuda-13.3"
+    CACHE PATH "Canonical CUDA Toolkit root for the NVIDIA compiler")
+set(PYPTO_NVIDIA_CUDA_TOOLKIT_VERSION "13.3.73"
+    CACHE STRING "Exact CUDA Toolkit package version")
+set(PYPTO_NVIDIA_TILEIRAS_EXECUTABLE
+    "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}/bin/tileiras"
+    CACHE FILEPATH "Exact CUDA Tile IR assembler")
+set(PYPTO_NVIDIA_TILEIRAS_VERSION "13.3.36"
+    CACHE STRING "Exact tileiras executable version")
+set(PYPTO_NVIDIA_TILEIRAS_SHA256
+    "88737a8be5c56bf73fb885a567a950f247a8cfa1d146dbc7a65eff77e7d62bf0"
+    CACHE STRING "Exact tileiras executable SHA-256")
+
+file(REAL_PATH "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}"
+     _pypto_cuda_toolkit_real EXPAND_TILDE)
+if(NOT _pypto_cuda_toolkit_real STREQUAL PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT)
+    message(FATAL_ERROR "CUDA Toolkit root must be canonical")
+endif()
+file(REAL_PATH "${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}"
+     _pypto_tileiras_real EXPAND_TILDE)
+if(NOT _pypto_tileiras_real STREQUAL PYPTO_NVIDIA_TILEIRAS_EXECUTABLE)
+    message(FATAL_ERROR "tileiras path must be canonical")
+endif()
+if(NOT EXISTS "${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}")
+    message(FATAL_ERROR "tileiras executable is absent")
+endif()
+file(SHA256 "${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}" _pypto_tileiras_sha256)
+if(NOT _pypto_tileiras_sha256 STREQUAL PYPTO_NVIDIA_TILEIRAS_SHA256)
+    message(FATAL_ERROR "tileiras SHA-256 differs from the locked producer")
+endif()
+execute_process(
+    COMMAND "${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}" --version
+    RESULT_VARIABLE _pypto_tileiras_status
+    OUTPUT_VARIABLE _pypto_tileiras_stdout
+    ERROR_VARIABLE _pypto_tileiras_stderr
+    TIMEOUT 10)
+string(CONCAT _pypto_tileiras_output
+       "${_pypto_tileiras_stdout}" "${_pypto_tileiras_stderr}")
+set(_pypto_tileiras_expected_version
+    "Cuda compilation tools, release 13.3, V${PYPTO_NVIDIA_TILEIRAS_VERSION}")
+string(FIND "${_pypto_tileiras_output}"
+       "${_pypto_tileiras_expected_version}" _pypto_tileiras_version_offset)
+if(NOT _pypto_tileiras_status EQUAL 0 OR
+   _pypto_tileiras_version_offset EQUAL -1)
+    message(FATAL_ERROR "tileiras version differs from the locked producer")
+endif()
+
+set(CUDAToolkit_ROOT "${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}" CACHE PATH "" FORCE)
+find_package(CUDAToolkit REQUIRED)
+if(NOT "${CUDAToolkit_VERSION}" STREQUAL
+       "${PYPTO_NVIDIA_CUDA_TOOLKIT_VERSION}")
+    message(FATAL_ERROR
+            "CUDA Toolkit version ${CUDAToolkit_VERSION} differs from "
+            "${PYPTO_NVIDIA_CUDA_TOOLKIT_VERSION}")
+endif()
+set(TENSOR_IR_ENABLE_BINDINGS_PYTHON OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_INCLUDE_TESTS OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_INCLUDE_TOOLS OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_LLVM_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_ENABLE_CUDA_TILE_CAPI OFF CACHE BOOL "" FORCE)
+set(TENSOR_IR_DOWNLOAD_LLVM ON CACHE BOOL "" FORCE)
+set(TENSOR_IR_CUDART_LINKAGE DYNAMIC CACHE STRING "" FORCE)
+set(FETCHCONTENT_SOURCE_DIR_TENSOR_IR_LLVM_PROJECT
+    "${_pypto_llvm_source}" CACHE PATH "" FORCE)
+set(FETCHCONTENT_SOURCE_DIR_TENSOR_IR_CUDA_TILE
+    "${_pypto_cuda_tile_source}" CACHE PATH "" FORCE)
+
+add_subdirectory(
+    "${_pypto_tensor_ir_source}"
+    "${CMAKE_BINARY_DIR}/_pypto/nvidia/tensor-ir"
+    EXCLUDE_FROM_ALL)
+
+foreach(_required_target NVTensorIRCompiler CudaTileDialect
+                         CudaTileBytecodeWriter)
+    if(NOT TARGET "${_required_target}")
+        message(FATAL_ERROR
+                "PyPTO private NVIDIA target is absent: ${_required_target}")
+    endif()
+endforeach()
+foreach(_forbidden_target tensor_ir-compiler tensor_ir-opt cuda-tile-opt
+                          cuda-tile-translate cuda-tile-optimize)
+    if(TARGET "${_forbidden_target}")
+        message(FATAL_ERROR
+                "Standalone NVIDIA tool leaked into PyPTO: ${_forbidden_target}")
+    endif()
+endforeach()
+add_library(pypto_nvidia_backend_dependencies INTERFACE)
+target_link_libraries(pypto_nvidia_backend_dependencies INTERFACE
+    NVTensorIR::Compiler)
+target_compile_definitions(pypto_nvidia_backend_dependencies INTERFACE
+    PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND=1
+    PYPTO_TENSOR_IR_REVISION="${PYPTO_NVIDIA_TENSOR_IR_REVISION}"
+    PYPTO_CUDA_TILE_REVISION="${PYPTO_NVIDIA_CUDA_TILE_REVISION}"
+    PYPTO_LLVM_REVISION="${PYPTO_NVIDIA_LLVM_REVISION}"
+    PYPTO_CUDA_TOOLKIT_ROOT="${PYPTO_NVIDIA_CUDA_TOOLKIT_ROOT}"
+    PYPTO_CUDA_TOOLKIT_VERSION="${PYPTO_NVIDIA_CUDA_TOOLKIT_VERSION}"
+    PYPTO_TILEIRAS_REAL_PATH="${PYPTO_NVIDIA_TILEIRAS_EXECUTABLE}"
+    PYPTO_TILEIRAS_VERSION="${PYPTO_NVIDIA_TILEIRAS_VERSION}"
+    PYPTO_TILEIRAS_SHA256="${PYPTO_NVIDIA_TILEIRAS_SHA256}")
