+
+#include "pypto/compiler/nvidia_backend_build_info.h"
+
+#include <string>
+#include <utility>
+
+#include "pypto/core/error.h"
+
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+#include "tensor_ir/Compiler/Compiler.h"
+#include "tensor_ir/Utils/ComputeCapability.h"
+
+#include "mlir/Support/LogicalResult.h"
+#endif
+
+namespace pypto::compiler {
+
+NvidiaBackendBuildInfo::NvidiaBackendBuildInfo(
+    bool compiled, bool compiler_factory_available, std::string tensor_ir_revision,
+    std::string cuda_tile_revision, std::string llvm_revision, std::string cuda_toolkit_root,
+    std::string cuda_toolkit_version, std::string tileiras_real_path, std::string tileiras_version,
+    std::string tileiras_sha256, std::string sm120_target)
+    : compiled_(compiled),
+      compiler_factory_available_(compiler_factory_available),
+      tensor_ir_revision_(std::move(tensor_ir_revision)),
+      cuda_tile_revision_(std::move(cuda_tile_revision)),
+      llvm_revision_(std::move(llvm_revision)),
+      cuda_toolkit_root_(std::move(cuda_toolkit_root)),
+      cuda_toolkit_version_(std::move(cuda_toolkit_version)),
+      tileiras_real_path_(std::move(tileiras_real_path)),
+      tileiras_version_(std::move(tileiras_version)),
+      tileiras_sha256_(std::move(tileiras_sha256)),
+      sm120_target_(std::move(sm120_target)) {}
+
+NvidiaBackendBuildInfo GetNvidiaBackendBuildInfo() {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  auto target = mlir::nv_tensor_ir::SmTarget::fromCc(120);
+  if (mlir::failed(target)) {
+    throw InternalError("private TensorIR build does not recognize SM120");
+  }
+  auto compiler = mlir::nv_tensor_ir::ICompiler::create(mlir::nv_tensor_ir::CompilerBackend::CudaTile);
+  if (!compiler) {
+    throw InternalError("private TensorIR CUDA Tile compiler factory is unavailable");
+  }
+  return NvidiaBackendBuildInfo(true, true, PYPTO_TENSOR_IR_REVISION, PYPTO_CUDA_TILE_REVISION,
+                                PYPTO_LLVM_REVISION, PYPTO_CUDA_TOOLKIT_ROOT,
+                                PYPTO_CUDA_TOOLKIT_VERSION, PYPTO_TILEIRAS_REAL_PATH,
+                                PYPTO_TILEIRAS_VERSION, PYPTO_TILEIRAS_SHA256, target->toString());
+#else
+  return NvidiaBackendBuildInfo(false, false, "", "", "", "", "", "", "", "", "");
+#endif
+}
+
+}  // namespace pypto::compiler
diff --git a/tests/ut/compiler/test_nvidia_backend_build_info.py b/tests/ut/compiler/test_nvidia_backend_build_info.py
new file mode 100644
index 0000000000000000000000000000000000000000..5794f8356a8ee764b9b3ab239b432d20809dfd43
--- /dev/null
+++ b/tests/ut/compiler/test_nvidia_backend_build_info.py
@@ -0,0 +1,29 @@
+"""Private NVIDIA backend build identity without a device query."""
+
+import pytest
+from pypto.compiler import get_nvidia_backend_build_info
+
+
+def test_nvidia_backend_build_info_is_immutable_and_self_consistent() -> None:
+    info = get_nvidia_backend_build_info()
+    with pytest.raises(AttributeError):
+        setattr(info, "compiled", not info.compiled)
+
+    if not info.compiled:
+        assert not info.compiler_factory_available
+        assert info.tensor_ir_revision == ""
