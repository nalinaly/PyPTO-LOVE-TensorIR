 bool IsNativeTileGdnProjectionCandidate(const ir::ProgramPtr& program) {
   if (!IsNativeTilePointwiseCandidate(program)) return false;
   const ir::FunctionPtr& function = program->functions_.begin()->second;
-  if (function->params_.size() != 6) return false;
+  if (function->params_.size() != 4) return false;
   const auto top = ir::As<ir::SeqStmts>(function->body_);
   const auto scope = top && !top->stmts_.empty()
                          ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
                          : nullptr;
   const auto loop = scope ? ir::As<ir::ForStmt>(scope->body_) : nullptr;
   const auto body = loop ? ir::As<ir::SeqStmts>(loop->body_) : nullptr;
-  return body && body->stmts_.size() == 9;
+  if (!body) return false;
+  size_t loads = 0;
+  size_t stores = 0;
+  for (const ir::StmtPtr& statement : body->stmts_) {
+    const auto assignment = ir::As<ir::AssignStmt>(statement);
+    const auto assigned_call =
+        assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (assigned_call && ir::IsOp(assigned_call, "tile.load")) ++loads;
+    const auto evaluated = ir::As<ir::EvalStmt>(statement);
+    const auto evaluated_call =
+        evaluated ? ir::As<ir::Call>(evaluated->expr_) : nullptr;
+    if (evaluated_call && ir::IsOp(evaluated_call, "tile.store")) ++stores;
+  }
+  return loads == 4 && stores == 4;
 }
 
