+tir::Comparator ToTensorIrComparator(TypedTensorIrComparator comparator) {
+  switch (comparator) {
+    case TypedTensorIrComparator::Eq:
+      return tir::Comparator::eq;
+    case TypedTensorIrComparator::Ne:
+      return tir::Comparator::neq;
+    case TypedTensorIrComparator::Gt:
+      return tir::Comparator::gt;
+    case TypedTensorIrComparator::Ge:
+      return tir::Comparator::ge;
+    case TypedTensorIrComparator::Lt:
+      return tir::Comparator::lt;
+    case TypedTensorIrComparator::Le:
+      return tir::Comparator::le;
+  }
+  llvm_unreachable("unknown generic TensorIR comparator");
+}
+
+tir::ReductionMode ToTensorIrReductionMode(
+    TypedTensorIrReductionMode reduction_mode) {
+  switch (reduction_mode) {
+    case TypedTensorIrReductionMode::Add:
+      return tir::ReductionMode::add;
+    case TypedTensorIrReductionMode::Max:
+      return tir::ReductionMode::max;
+  }
+  llvm_unreachable("unknown generic TensorIR reduction mode");
+}
+
+mlir::Attribute GenericConstantAttribute(
+    mlir::OpBuilder& builder, const TypedTensorIrOperationSpec& operation) {
+  switch (operation.scalar_type) {
+    case TypedTensorIrElementType::FP32:
+    case TypedTensorIrElementType::BF16:
+      return builder.getF32FloatAttr(static_cast<float>(operation.scalar));
+    case TypedTensorIrElementType::INT32:
+      return builder.getIntegerAttr(
+          builder.getIntegerType(32, mlir::IntegerType::Signed),
+          static_cast<int64_t>(operation.scalar));
+    case TypedTensorIrElementType::INT64:
+      return builder.getIntegerAttr(
+          builder.getIntegerType(64, mlir::IntegerType::Signed),
+          static_cast<int64_t>(operation.scalar));
+    case TypedTensorIrElementType::BOOL:
+      return builder.getIntegerAttr(
+          builder.getIntegerType(1, mlir::IntegerType::Signless),
+          operation.scalar != 0.0 ? 1 : 0);
+  }
+  llvm_unreachable("unknown generic TensorIR constant type");
+}
+
+mlir::Value BuildGenericTensorIrOperation(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const TypedTensorIrOperationSpec& operation,
+    const llvm::SmallVector<mlir::Value>& values) {
+  const auto result_type = mlir::RankedTensorType::get(
+      operation.result.shape,
+      ElementType(builder, operation.result.element_type));
+  const auto value = [&](size_t index) -> mlir::Value {
+    return values[operation.operands[index]];
+  };
+  switch (operation.kind) {
+    case TypedTensorIrOpKind::Add:
+      return tir::AddOp::create(builder, location, result_type, value(0),
+                                value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::Sub:
+      return tir::SubOp::create(builder, location, result_type, value(0),
+                                value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::Mul:
+      return tir::MulOp::create(builder, location, result_type, value(0),
+                                value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::Div:
+      return tir::DivOp::create(builder, location, result_type, value(0),
+                                value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::Neg:
+      return tir::NegOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Exp:
+      return tir::ExpOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Rsqrt:
+      return tir::RsqrtOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Reciprocal:
+      return tir::ReciprocalOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Sin:
+      return tir::SinOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Cos:
+      return tir::CosOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Convert:
+      return tir::ConvertOp::create(builder, location, result_type, value(0))
+          .getOutput();
+    case TypedTensorIrOpKind::Reduce:
+      return tir::ReduceOp::create(
+                 builder, location, result_type, value(0), operation.dimensions,
+                 ToTensorIrReductionMode(operation.reduction_mode))
+          .getOutput();
+    case TypedTensorIrOpKind::Broadcast:
+      return tir::BroadcastOp::create(builder, location, result_type, value(0),
+                                      mlir::ValueRange{})
+          .getOutput();
+    case TypedTensorIrOpKind::Splat:
+      return tir::SplatOp::create(builder, location, result_type, value(0),
+                                  mlir::ValueRange{})
+          .getOutput();
+    case TypedTensorIrOpKind::Constant:
+      return tir::ConstantOp::create(builder, location,
+                                     GenericConstantAttribute(builder,
+                                                              operation))
+          .getResult();
+    case TypedTensorIrOpKind::Reshape:
+      return tir::ReshapeOp::create(builder, location, result_type, value(0),
+                                    mlir::ValueRange{})
+          .getOutput();
+    case TypedTensorIrOpKind::Transpose:
+      return tir::TransposeOp::create(builder, location, result_type, value(0),
+                                      operation.permutation)
+          .getOutput();
+    case TypedTensorIrOpKind::Slice:
+      return tir::SliceOp::create(builder, location, result_type, value(0),
+                                  operation.starts, operation.limits,
+                                  operation.strides)
+          .getOutput();
+    case TypedTensorIrOpKind::GatherRows:
+      return tir::GatherRowsOp::create(builder, location, result_type, value(0),
+                                       value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::ScatterRows:
+      return tir::ScatterRowsOp::create(builder, location, result_type, value(0),
+                                        value(1), value(2))
+          .getOutput();
+    case TypedTensorIrOpKind::Concatenate: {
+      llvm::SmallVector<mlir::Value> inputs;
+      inputs.reserve(operation.operands.size());
+      for (size_t index = 0; index < operation.operands.size(); ++index) {
+        inputs.push_back(value(index));
+      }
+      return tir::ConcatenateOp::create(builder, location, result_type, inputs,
+                                        operation.dimension)
+          .getOutput();
+    }
+    case TypedTensorIrOpKind::Iota:
+      return tir::IotaOp::create(builder, location, result_type,
+                                 operation.dimension, mlir::ValueRange{})
+          .getOutput();
+    case TypedTensorIrOpKind::Cmp:
+      return tir::CmpOp::create(builder, location, result_type,
+                                ToTensorIrComparator(operation.comparator),
+                                value(0), value(1))
+          .getOutput();
+    case TypedTensorIrOpKind::BinarySelect:
+      return tir::BinarySelectOp::create(builder, location, result_type, value(0),
+                                         value(1), value(2))
+          .getOutput();
+    case TypedTensorIrOpKind::Matmul:
+      return tir::MatmulOp::create(builder, location, result_type, value(0),
+                                   value(1))
+          .getC();
+  }
+  llvm_unreachable("unknown generic TensorIR operation");
+}
+
+llvm::SmallVector<mlir::Value> BuildGenericTensorIrGraph(
+    mlir::OpBuilder& builder, mlir::Location location,
+    const GenericTensorIrModuleSpec& spec, mlir::Block& entry) {
+  llvm::SmallVector<mlir::Value> values(entry.getArguments().begin(),
+                                        entry.getArguments().end());
+  values.reserve(spec.inputs.size() + spec.operations.size());
+  for (const auto& operation : spec.operations) {
+    values.push_back(
+        BuildGenericTensorIrOperation(builder, location, operation, values));
+  }
+  llvm::SmallVector<mlir::Value> results;
+  results.reserve(spec.result_values.size());
+  for (uint32_t result_value : spec.result_values) {
+    results.push_back(values[result_value]);
+  }
+  return results;
+}
