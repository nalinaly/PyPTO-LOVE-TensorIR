+/** Typed operation kinds for the bounded generic TensorIR graph builder. */
+enum class TypedTensorIrOpKind : uint8_t {
+  Add = 0,
+  Sub = 1,
+  Mul = 2,
+  Div = 3,
+  Neg = 4,
+  Exp = 5,
+  Rsqrt = 6,
+  Reciprocal = 7,
+  Sin = 8,
+  Cos = 9,
+  Convert = 10,
+  Reduce = 11,
+  Broadcast = 12,
+  Splat = 13,
+  Constant = 14,
+  Reshape = 15,
+  Transpose = 16,
+  Slice = 17,
+  GatherRows = 18,
+  ScatterRows = 19,
+  Concatenate = 20,
+  Iota = 21,
+  Cmp = 22,
+  BinarySelect = 23,
+  Matmul = 24,
+};
+
+/** Comparators accepted by a generic typed TensorIR comparison operation. */
+enum class TypedTensorIrComparator : uint8_t {
+  Eq = 0,
+  Ne = 1,
+  Gt = 2,
+  Ge = 3,
+  Lt = 4,
+  Le = 5,
+};
+
+/** Reduction modes accepted by a generic typed TensorIR reduction operation. */
+enum class TypedTensorIrReductionMode : uint8_t {
+  Add = 0,
+  Max = 1,
+};
+
+/** One SSA operation in a generic typed TensorIR graph. */
+struct TypedTensorIrOperationSpec {
+  TypedTensorIrOpKind kind = TypedTensorIrOpKind::Add;
+  std::vector<uint32_t> operands;
+  TypedTensorIrTensorSpec result;
+  std::vector<int64_t> starts;
+  std::vector<int64_t> limits;
+  std::vector<int64_t> strides;
+  std::vector<int64_t> permutation;
+  std::vector<int32_t> dimensions;
+  int64_t dimension = -1;
+  TypedTensorIrComparator comparator = TypedTensorIrComparator::Eq;
+  TypedTensorIrReductionMode reduction_mode = TypedTensorIrReductionMode::Add;
+  double scalar = 0.0;
+  TypedTensorIrElementType scalar_type = TypedTensorIrElementType::FP32;
+};
+
+/**
+ * Compiler-neutral graph for operations that do not need a bespoke semantic
+ * builder. Inputs/results carry ABI metadata; operation values are SSA-indexed
+ * in insertion order and are built only through TensorIR OpBuilder APIs.
+ */
+struct GenericTensorIrModuleSpec {
+  std::vector<TypedTensorIrTensorSpec> inputs;
+  std::vector<TypedTensorIrTensorSpec> results;
+  std::vector<TypedTensorIrOperationSpec> operations;
+  std::vector<uint32_t> result_values;
+};
+
 /** Typed TensorIR builders available through the private NVIDIA bridge. */
