+bool IsValidGenericTensorSpec(const TypedTensorIrTensorSpec& tensor,
+                              bool allow_scalar) {
+  if (tensor.shape.empty()) {
+    return allow_scalar && tensor.strides.empty() &&
+           !tensor.has_explicit_strides;
+  }
+  if (!tensor.has_explicit_strides || tensor.shape.size() > 32 ||
+      tensor.shape.size() != tensor.strides.size()) {
+    return false;
+  }
+  return std::all_of(tensor.shape.begin(), tensor.shape.end(),
+                     [](int64_t dimension) { return dimension > 0; }) &&
+         std::all_of(tensor.strides.begin(), tensor.strides.end(),
+                     [](int64_t stride) { return stride >= 0; });
+}
+
+bool ValidateGenericTensorIrSpec(const GenericTensorIrModuleSpec& spec,
+                                std::string& diagnostic) {
+  const auto reject = [&](std::string message) {
+    diagnostic = "typed TensorIR generic specification rejected: " +
+                 std::move(message);
+    return false;
+  };
+  if (spec.inputs.empty() || spec.inputs.size() > 64 || spec.results.empty() ||
+      spec.results.size() > 16 || spec.operations.empty() ||
+      spec.operations.size() > kMaximumGenericOperations ||
+      spec.result_values.size() != spec.results.size() ||
+      spec.inputs.size() + spec.operations.size() > kMaximumGenericValues) {
+    return reject("input, result, or operation count is outside the bounded range");
+  }
+  for (const auto& input : spec.inputs) {
+    if (!IsValidGenericTensorSpec(input, /*allow_scalar=*/false)) {
+      return reject("inputs must have non-scalar static metadata");
+    }
+  }
+  for (const auto& result : spec.results) {
+    if (!IsValidGenericTensorSpec(result, /*allow_scalar=*/false)) {
+      return reject("results must have non-scalar static metadata");
+    }
+  }
+  size_t value_count = spec.inputs.size();
+  for (const auto& operation : spec.operations) {
+    if (operation.kind == TypedTensorIrOpKind::Constant) {
+      if (!operation.operands.empty() ||
+          !IsValidGenericTensorSpec(operation.result, /*allow_scalar=*/true) ||
+          !operation.result.shape.empty()) {
+        return reject("constant must produce one scalar and take no operands");
+      }
+      if ((operation.scalar_type == TypedTensorIrElementType::FP32 ||
+           operation.scalar_type == TypedTensorIrElementType::BF16) &&
+          !std::isfinite(operation.scalar)) {
+        return reject("floating-point constant must be finite");
+      }
+    } else {
+      if (operation.operands.empty() ||
+          !IsValidGenericTensorSpec(operation.result, /*allow_scalar=*/false)) {
+        return reject("non-constant operation must have tensor result and operands");
+      }
+      for (uint32_t operand : operation.operands) {
+        if (operand >= value_count) {
+          return reject("operation operand is not an earlier SSA value");
+        }
+      }
+    }
+    const size_t rank = operation.result.shape.size();
+    switch (operation.kind) {
+      case TypedTensorIrOpKind::Add:
+      case TypedTensorIrOpKind::Sub:
+      case TypedTensorIrOpKind::Mul:
+      case TypedTensorIrOpKind::Div:
+      case TypedTensorIrOpKind::Cmp:
+        if (operation.operands.size() != 2) {
+          return reject("binary operation requires exactly two operands");
+        }
+        break;
+      case TypedTensorIrOpKind::Neg:
+      case TypedTensorIrOpKind::Exp:
+      case TypedTensorIrOpKind::Rsqrt:
+      case TypedTensorIrOpKind::Reciprocal:
+      case TypedTensorIrOpKind::Sin:
+      case TypedTensorIrOpKind::Cos:
+      case TypedTensorIrOpKind::Convert:
+      case TypedTensorIrOpKind::Broadcast:
+      case TypedTensorIrOpKind::Splat:
+      case TypedTensorIrOpKind::Reshape:
+      case TypedTensorIrOpKind::Transpose:
+      case TypedTensorIrOpKind::Iota:
+        if (operation.operands.size() != 1) {
+          return reject("unary/shape operation requires exactly one operand");
+        }
+        break;
+      case TypedTensorIrOpKind::Reduce:
+        if (operation.operands.size() != 1 || operation.dimensions.empty() ||
+            operation.dimensions.size() > rank) {
+          return reject("reduce has invalid operand or dimensions");
+        }
+        break;
+      case TypedTensorIrOpKind::Constant:
+        break;
+      case TypedTensorIrOpKind::Slice:
+        if (operation.operands.size() != 1 || operation.starts.size() != rank ||
+            operation.limits.size() != rank || operation.strides.size() != rank) {
+          return reject("slice metadata rank does not match its result");
+        }
+        break;
+      case TypedTensorIrOpKind::GatherRows:
+        if (operation.operands.size() != 2) {
+          return reject("gather_rows requires data and indices");
+        }
+        break;
+      case TypedTensorIrOpKind::ScatterRows:
+        if (operation.operands.size() != 3) {
+          return reject("scatter_rows requires data, indices, and updates");
+        }
+        break;
+      case TypedTensorIrOpKind::Concatenate:
+        if (operation.operands.size() < 1 || operation.dimension < 0 ||
+            operation.dimension >= static_cast<int64_t>(rank)) {
+          return reject("concatenate dimension or operands are invalid");
+        }
+        break;
+      case TypedTensorIrOpKind::BinarySelect:
+        if (operation.operands.size() != 3) {
+          return reject("binary_select requires selector and two values");
+        }
+        break;
+      case TypedTensorIrOpKind::Matmul:
+        if (operation.operands.size() != 2 || rank < 2) {
+          return reject("matmul requires two operands and rank at least two");
+        }
+        break;
+    }
+    ++value_count;
+  }
+  for (uint32_t result_value : spec.result_values) {
+    if (result_value >= value_count) {
+      return reject("graph result is not an SSA value in the graph");
+    }
+  }
+  return true;
+}
