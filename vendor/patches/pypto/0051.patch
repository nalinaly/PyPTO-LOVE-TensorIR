+  if (ir::IsOp(call, "tensor.add")) return FusedOperationSpec{"add", 2, false};
+  if (ir::IsOp(call, "tensor.adds")) return FusedOperationSpec{"add", 1, true};
+  if (ir::IsOp(call, "tensor.sub")) return FusedOperationSpec{"sub", 2, false};
+  if (ir::IsOp(call, "tensor.subs")) return FusedOperationSpec{"sub", 1, true};
+  if (ir::IsOp(call, "tensor.mul")) return FusedOperationSpec{"mul", 2, false};
+  if (ir::IsOp(call, "tensor.muls")) return FusedOperationSpec{"mul", 1, true};
+  if (ir::IsOp(call, "tensor.neg")) return FusedOperationSpec{"neg", 1, false};
+  if (ir::IsOp(call, "tensor.exp")) return FusedOperationSpec{"exp", 1, false};
+  if (ir::IsOp(call, "tensor.recip")) {
+    return FusedOperationSpec{"reciprocal", 1, false};
+  }
+  if (ir::IsOp(call, "tensor.rsqrt")) return FusedOperationSpec{"rsqrt", 1, false};
+  return std::nullopt;
+}
+
+FusedPointwiseGraph AnalyzeFusedPointwiseV2(const ir::ProgramPtr& program) {
+  if (!program) Reject("program must not be null");
+  if (program->functions_.size() != 1) {
+    Reject("program must contain exactly one function", &program->span_);
+  }
+
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function) Reject("program contains a null function binding", &program->span_);
+  if (global->name_ != function->name_) {
+    Reject("global function name does not match the bound function name", &function->span_);
+  }
+  if (function->requires_runtime_binding_) {
+    Reject("runtime-bound functions are not supported", &function->span_);
+  }
+  if (function->func_type_ != ir::FunctionType::Opaque || function->level_.has_value() ||
+      function->role_.has_value()) {
+    Reject("function must be Opaque with no hierarchy level or role", &function->span_);
+  }
+  if (!function->attrs_.empty()) {
+    Reject("function attributes are not supported", &function->span_);
+  }
+  if (function->params_.empty() ||
+      function->params_.size() > kMaximumFusedPointwiseInputs) {
+    Reject("fused pointwise v2 requires between 1 and 16 function parameters",
+           &function->span_);
+  }
+  if (function->param_directions_.size() != function->params_.size()) {
+    Reject("fused pointwise parameter direction count must equal parameter count: expected " +
+               std::to_string(function->params_.size()) + ", got " +
+               std::to_string(function->param_directions_.size()),
+           &function->span_);
+  }
+  if (!std::all_of(function->param_directions_.begin(), function->param_directions_.end(),
+                   [](ir::ParamDirection direction) {
+                     return direction == ir::ParamDirection::In;
+                   })) {
+    Reject("all fused pointwise parameters must have direction In", &function->span_);
+  }
+  if (function->return_types_.size() != 1) {
+    Reject("fused pointwise v2 requires exactly one declared return", &function->span_);
+  }
+
+  std::vector<StaticTensor> inputs;
+  inputs.reserve(function->params_.size());
+  std::unordered_map<const ir::Var*, size_t> parameter_indices;
+  for (size_t index = 0; index < function->params_.size(); ++index) {
+    const ir::VarPtr& parameter = function->params_[index];
+    if (!parameter) Reject("function contains a null parameter", &function->span_);
+    if (parameter->GetKind() != ir::ObjectKind::Var) {
+      Reject("function parameters must be exact Var nodes", &parameter->span_);
+    }
+    if (!parameter_indices.emplace(parameter.get(), index).second) {
+      Reject("function parameters must have distinct IR identities", &parameter->span_);
+    }
+    inputs.push_back(ReadStaticTensor(parameter->GetType(), parameter->span_,
+                                      "function parameter"));
+    if (index != 0 && !SameTensor(inputs[0], inputs[index])) {
+      Reject("fused pointwise input types and shapes must be identical",
+             &parameter->span_);
+    }
+  }
+
+  const StaticTensor declared_result =
+      ReadStaticTensor(function->return_types_[0], function->span_, "declared result");
+  if (!SameTensor(inputs[0], declared_result)) {
+    Reject("fused pointwise result type and shape must match its inputs",
+           &function->span_);
+  }
+
+  if (!function->body_) Reject("function body must not be null", &function->span_);
+  const auto sequence = ir::As<ir::SeqStmts>(function->body_);
+  if (!sequence) {
+    Reject("function body must be a top-level sequence of fused pointwise assignments and one return",
+           &function->body_->span_);
+  }
+  if (sequence->stmts_.size() < 2 ||
+      sequence->stmts_.size() > kMaximumFusedPointwiseAssignments + 1) {
+    Reject("fused pointwise body must contain between 1 and 64 assignments followed by one return",
+           &sequence->span_);
+  }
+
+  const size_t assignment_count = sequence->stmts_.size() - 1;
+  std::vector<ir::AssignStmtPtr> assignments;
+  assignments.reserve(assignment_count);
+  std::unordered_map<const ir::Var*, size_t> assignment_indices;
+  for (size_t index = 0; index < assignment_count; ++index) {
+    const ir::StmtPtr& statement = sequence->stmts_[index];
+    if (!statement) Reject("function body must not contain null statements", &sequence->span_);
+    const auto assignment = ir::As<ir::AssignStmt>(statement);
+    if (!assignment) {
+      Reject("every fused pointwise statement before the return must be an assignment",
+             &statement->span_);
+    }
+    if (!assignment->var_ || !assignment->value_) {
+      Reject("fused pointwise assignment must have a non-null target and value",
+             &assignment->span_);
+    }
+    if (assignment->var_->GetKind() != ir::ObjectKind::Var) {
+      Reject("fused pointwise assignment target must be an exact Var node",
+             &assignment->var_->span_);
+    }
+    if (parameter_indices.count(assignment->var_.get()) != 0) {
+      Reject("fused pointwise assignment target must not reuse a parameter IR identity",
+             &assignment->span_);
+    }
+    if (!assignment_indices.emplace(assignment->var_.get(), index).second) {
+      Reject("fused pointwise assignment targets must be fresh SSA Var identities",
+             &assignment->span_);
+    }
+    assignments.push_back(assignment);
+  }
+
+  const ir::StmtPtr& final_statement = sequence->stmts_.back();
+  if (!final_statement) Reject("function body must not contain null statements", &sequence->span_);
+  const auto return_statement = ir::As<ir::ReturnStmt>(final_statement);
+  if (!return_statement || return_statement->value_.size() != 1) {
+    Reject("fused pointwise body must end with exactly one return", &final_statement->span_);
+  }
+  const auto returned_variable = ir::As<ir::Var>(return_statement->value_[0]);
+  if (!returned_variable || returned_variable->GetKind() != ir::ObjectKind::Var ||
+      returned_variable.get() != assignments.back()->var_.get()) {
+    Reject("return must directly reference the final fused pointwise assignment result",
+           &return_statement->span_);
+  }
+
+  std::vector<bool> used_parameters(function->params_.size(), false);
+  std::vector<FusedPointwiseInstruction> instructions;
+  instructions.reserve(assignment_count);
+  for (size_t index = 0; index < assignment_count; ++index) {
+    const ir::AssignStmtPtr& assignment = assignments[index];
+    const auto call = ir::As<ir::Call>(assignment->value_);
+    if (!call || !call->op_) {
+      Reject("fused pointwise assignment value must be a direct registered tensor call",
+             &assignment->value_->span_);
+    }
+    if (!call->attrs_.empty() || !call->kwargs_.empty()) {
+      Reject("fused pointwise attributes and keyword arguments are not supported",
+             &call->span_);
+    }
+    const std::optional<FusedOperationSpec> spec = GetFusedOperationSpec(call);
+    if (!spec.has_value()) {
+      Reject("fused pointwise v2 supports only tensor add/adds/sub/subs/mul/muls/neg/exp/recip/rsqrt",
+             &call->span_);
+    }
+    const size_t expected_argument_count = spec->tensor_operand_count + (spec->has_scalar ? 1 : 0);
+    if (call->args_.size() != expected_argument_count) {
+      Reject("fused pointwise operator " + BoundedDisplay(call->op_->name_) + " expects " +
+                 std::to_string(expected_argument_count) + " operands, got " +
+                 std::to_string(call->args_.size()),
+             &call->span_);
+    }
+
+    FusedPointwiseInstruction instruction{spec->tensor_ir_op, {}, std::nullopt};
+    instruction.tensor_operands.reserve(spec->tensor_operand_count);
+    bool consumes_previous = false;
+    for (size_t operand_index = 0; operand_index < spec->tensor_operand_count;
+         ++operand_index) {
+      const ir::ExprPtr& argument = call->args_[operand_index];
+      const auto variable = ir::As<ir::Var>(argument);
+      if (!variable || variable->GetKind() != ir::ObjectKind::Var) {
+        Reject("fused pointwise tensor operands must be direct exact Var nodes",
+               argument ? &argument->span_ : &call->span_);
+      }
+      const StaticTensor operand =
+          ReadStaticTensor(variable->GetType(), variable->span_, "fused pointwise operand");
+      if (!SameTensor(inputs[0], operand)) {
+        Reject("fused pointwise operand types and shapes must match all inputs",
+               &variable->span_);
+      }
+      const auto parameter = parameter_indices.find(variable.get());
+      if (parameter != parameter_indices.end()) {
+        used_parameters[parameter->second] = true;
+        instruction.tensor_operands.push_back(
+            FusedTensorOperand{FusedTensorOperandKind::Input, parameter->second});
+        continue;
+      }
+      const auto assigned = assignment_indices.find(variable.get());
+      if (assigned == assignment_indices.end()) {
+        Reject("fused pointwise tensor operand is not a function parameter or SSA result",
+               &variable->span_);
+      }
+      if (index == 0 || assigned->second != index - 1) {
+        Reject("fused pointwise tensor operands may reference only the immediately "
+               "preceding assignment result",
+               &variable->span_);
+      }
+      consumes_previous = true;
+      instruction.tensor_operands.push_back(
+          FusedTensorOperand{FusedTensorOperandKind::PreviousResult, 0});
+    }
+    if (index != 0 && !consumes_previous) {
+      Reject("each fused pointwise assignment after the first must consume the immediately preceding result",
+             &call->span_);
+    }
+
+    if (spec->has_scalar) {
+      const ir::ExprPtr& scalar_argument = call->args_.back();
+      const auto scalar = ir::As<ir::ConstFloat>(scalar_argument);
+      if (!scalar || scalar->GetKind() != ir::ObjectKind::ConstFloat) {
+        Reject("fused pointwise scalar operand must be an exact ConstFloat node",
+               scalar_argument ? &scalar_argument->span_ : &call->span_);
+      }
+      if (scalar->dtype() != inputs[0].dtype) {
+        Reject("fused pointwise scalar dtype must exactly match the tensor dtype",
+               &scalar->span_);
+      }
+      if (!std::isfinite(scalar->value_) ||
+          std::fabs(scalar->value_) > MaximumFiniteScalar(inputs[0].dtype)) {
+        Reject("fused pointwise scalar constant must remain finite in the tensor dtype",
+               &scalar->span_);
+      }
+      instruction.scalar = scalar->value_;
+    }
+
+    const StaticTensor call_result =
+        ReadStaticTensor(call->GetType(), call->span_, "fused pointwise call result");
+    const StaticTensor assigned_result = ReadStaticTensor(
+        assignment->var_->GetType(), assignment->var_->span_,
+        "fused pointwise assignment result");
+    if (!SameTensor(declared_result, call_result) ||
+        !SameTensor(declared_result, assigned_result)) {
+      Reject("fused pointwise call, assignment, and declared result types must match",
+             &call->span_);
+    }
+    instructions.push_back(std::move(instruction));
+  }
+
+  if (std::any_of(used_parameters.begin(), used_parameters.end(), [](bool used) {
+        return !used;
+      })) {
+    Reject("every fused pointwise function parameter must be used", &function->span_);
+  }
+  return FusedPointwiseGraph{inputs[0], std::move(instructions), inputs.size()};
+}
+
+void AppendFusedOperand(std::string& source, const FusedTensorOperand& operand,
+                        size_t instruction_index) {
+  if (operand.kind == FusedTensorOperandKind::Input) {
+    source += "%arg";
+    AppendIndex(source, operand.input_index);
+    return;
+  }
+  if (operand.kind == FusedTensorOperandKind::PreviousResult && instruction_index != 0) {
+    source += "%value";
+    AppendIndex(source, instruction_index - 1);
+    return;
+  }
+  InternalReject("fused pointwise source operand is invalid");
+}
+
+std::string EmitFusedPointwiseSource(const FusedPointwiseGraph& graph) {
+  const std::string type = TensorTypeText(graph.tensor);
+  const std::string type_with_stride = TensorWithStrideText(graph.tensor);
+  std::string source;
+  source.reserve(512 + graph.input_count * type_with_stride.size() +
+                 graph.instructions.size() * (type.size() + 96));
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n";
+  for (size_t input_index = 0; input_index < graph.input_count; ++input_index) {
+    source += "    %arg";
+    AppendIndex(source, input_index);
+    source += ": ";
+    source += type_with_stride;
+    source += input_index + 1 == graph.input_count ? "\n" : ",\n";
+  }
+  source += "  ) -> ";
+  if (graph.tensor.shape.size() == 1) {
+    source += type;
+  } else {
+    source += "(";
+    source += type_with_stride;
+    source += ")";
+  }
+  source += " {\n";
+
+  size_t scalar_index = 0;
+  for (size_t instruction_index = 0; instruction_index < graph.instructions.size();
+       ++instruction_index) {
+    const FusedPointwiseInstruction& instruction = graph.instructions[instruction_index];
+    if (instruction.scalar.has_value()) {
+      source += "    %constant";
+      AppendIndex(source, scalar_index);
+      source += " = constant ";
+      AppendFloat(source, *instruction.scalar);
+      source += " : ";
+      source += TensorIrDtype(graph.tensor.dtype);
+      source += "\n    %splat";
+      AppendIndex(source, scalar_index);
+      source += " = splat %constant";
+      AppendIndex(source, scalar_index);
+      source += " : ";
+      source += type;
+      source += "\n";
+    }
+    source += "    %value";
+    AppendIndex(source, instruction_index);
+    source += " = ";
+    source += instruction.tensor_ir_op;
+    source += " ";
+    for (size_t operand_index = 0; operand_index < instruction.tensor_operands.size();
+         ++operand_index) {
+      if (operand_index != 0) source += ", ";
+      AppendFusedOperand(source, instruction.tensor_operands[operand_index], instruction_index);
+    }
+    if (instruction.scalar.has_value()) {
+      if (!instruction.tensor_operands.empty()) source += ", ";
+      source += "%splat";
+      AppendIndex(source, scalar_index);
+      ++scalar_index;
+    }
+    source += " : ";
+    source += type;
+    source += "\n";
+  }
+  source += "    results %value";
+  AppendIndex(source, graph.instructions.size() - 1);
+  source += " : ";
+  source += type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
+
+bool IsLegacyStaticAddV1Candidate(const ir::ProgramPtr& program) {
+  if (!program || program->functions_.size() != 1) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (!function || function->params_.size() != 2 || !function->body_) return false;
+  const auto sequence = ir::As<ir::SeqStmts>(function->body_);
+  if (!sequence || sequence->stmts_.size() != 2 || !sequence->stmts_[0] ||
+      !sequence->stmts_[1]) {
+    return false;
+  }
+  const auto assignment = ir::As<ir::AssignStmt>(sequence->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(sequence->stmts_[1]);
+  if (!assignment || !assignment->value_ || !returned) return false;
+  const auto call = ir::As<ir::Call>(assignment->value_);
+  return call && call->op_ && ir::IsOp(call, "tensor.add");
+}
