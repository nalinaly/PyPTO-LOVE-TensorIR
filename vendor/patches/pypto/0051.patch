+int TestFusedPointwiseV2BoundsAndScalarFormatting() {
+  auto type = PlainTensor({64}, DataType::FP32);
+  std::vector<ir::VarPtr> parameters;
+  std::vector<ir::ParamDirection> directions;
+  for (size_t index = 0; index < 16; ++index) {
+    parameters.push_back(
+        std::make_shared<ir::Var>("ignored", type, TestSpan()));
+    directions.push_back(ir::ParamDirection::In);
+  }
+  std::vector<ir::StmtPtr> statements;
+  auto previous = std::make_shared<ir::Var>("ignored", type, TestSpan());
+  statements.push_back(std::make_shared<ir::AssignStmt>(
+      previous, OpCall("tensor.add", {parameters[0], parameters[1]}, type), TestSpan()));
+  for (size_t input_index = 2; input_index < parameters.size(); ++input_index) {
+    auto next = std::make_shared<ir::Var>("ignored", type, TestSpan());
+    statements.push_back(std::make_shared<ir::AssignStmt>(
+        next, OpCall("tensor.add", {previous, parameters[input_index]}, type), TestSpan()));
+    previous = next;
+  }
+  while (statements.size() < 64) {
+    auto next = std::make_shared<ir::Var>("ignored", type, TestSpan());
+    statements.push_back(std::make_shared<ir::AssignStmt>(
+        next, OpCall("tensor.neg", {previous}, type), TestSpan()));
+    previous = next;
+  }
+  statements.push_back(std::make_shared<ir::ReturnStmt>(
+      std::vector<ir::ExprPtr>{previous}, TestSpan()));
+  const TensorIrModule maximum = EmitTensorIr(
+      MakeProgram("ignored", parameters, directions, {type}, statements));
+  REQUIRE(maximum.GetKind() == TensorIrModuleKind::FusedPointwiseV2);
+  REQUIRE(maximum.GetInputCount() == 16);
+  REQUIRE(maximum.GetValueMetadata().size() == 17);
+  REQUIRE(maximum.GetCanonicalSource().find("%arg15") != std::string::npos);
+  REQUIRE(maximum.GetCanonicalSource().find("%value63") != std::string::npos);
+
+  auto bf16_type = PlainTensor({7}, DataType::BF16);
+  auto input = std::make_shared<ir::Var>("input", bf16_type, TestSpan());
+  auto result = std::make_shared<ir::Var>("result", bf16_type, TestSpan());
+  auto negative_zero = std::make_shared<ir::ConstFloat>(-0.0, DataType::BF16, TestSpan());
+  const ir::ProgramPtr bf16_program = MakeProgram(
+      "ignored", {input}, {ir::ParamDirection::In}, {bf16_type},
+      {std::make_shared<ir::AssignStmt>(
+           result, OpCall("tensor.adds", {input, negative_zero}, bf16_type), TestSpan()),
+       std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan())});
+  const TensorIrModule minimum = EmitTensorIr(bf16_program);
+  REQUIRE(minimum.GetInputCount() == 1);
+  REQUIRE(minimum.GetCanonicalSource().find("constant -0.0 : bf16") !=
+          std::string::npos);
+  REQUIRE(minimum.GetCanonicalSource().find("splat %constant0 : tensor<7xbf16>") !=
+          std::string::npos);
+  const std::locale previous_locale = std::locale();
+  std::locale::global(std::locale(std::locale::classic(), new GroupedNumpunct));
+  const std::string hostile_locale_source = EmitTensorIr(bf16_program).GetCanonicalSource();
+  std::locale::global(previous_locale);
+  REQUIRE(hostile_locale_source == minimum.GetCanonicalSource());
+  return 0;
+}
