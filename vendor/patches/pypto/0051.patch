+    const codegen::nvidia::TensorIrModule& module,
+    const StrictTensorIrProducerOptions& resolved_options,
+    const CompileRequest& request) {
+  if (module.GetKind() != codegen::nvidia::TensorIrModuleKind::FusedPointwiseV2) return;
+  CHECK(resolved_options.tile_sizes.size() == 1)
+      << "fused pointwise v2 requires exactly one flattened tile size dim_000, got "
+      << resolved_options.tile_sizes.size();
+  const uint32_t tile_size = resolved_options.tile_sizes[0];
+  CHECK(tile_size != 0 && (tile_size & (tile_size - 1)) == 0)
+      << "fused pointwise v2 tile dim_000 must be a positive power of two, got "
+      << tile_size;
+
+  INTERNAL_CHECK(!module.GetValueMetadata().empty())
+      << "fused pointwise v2 module has no value metadata";
+  uint64_t element_count = 1;
+  for (int64_t dimension : module.GetValueMetadata()[0].GetShape()) {
+    INTERNAL_CHECK(dimension > 0)
+        << "fused pointwise v2 metadata contains a non-positive shape dimension";
+    INTERNAL_CHECK(static_cast<uint64_t>(dimension) <=
+                   std::numeric_limits<uint64_t>::max() / element_count)
+        << "fused pointwise v2 element count overflows uint64";
+    element_count *= static_cast<uint64_t>(dimension);
+  }
+  CHECK(static_cast<uint64_t>(tile_size) <= element_count)
+      << "fused pointwise v2 tile dim_000 must not exceed the flattened static element count "
+      << element_count << ", got " << tile_size;
+  const uint64_t expected_grid_x =
+      element_count / tile_size + (element_count % tile_size == 0 ? 0 : 1);
+  const int64_t max_grid_x = request.GetTargetInfo().GetTraits().GetMaxGridDimX();
+  CHECK(expected_grid_x <= static_cast<uint64_t>(std::numeric_limits<int32_t>::max()) &&
+        expected_grid_x <= static_cast<uint64_t>(max_grid_x))
+      << "fused pointwise v2 flattened grid x=" << expected_grid_x
+      << " exceeds the prepared target limit " << max_grid_x;
