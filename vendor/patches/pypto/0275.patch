+TypedTensorIrModuleSpec MakeGenericGdnUpdateTensorIrSpec(
+    const NativeTileGdnUpdateGraph& graph) {
+  GenericTensorIrSpecBuilder builder(
+      {graph.state, graph.decay, graph.decay, graph.value});
+  builder.AddResult(graph.result);
+  const uint32_t decay = builder.TensorOp(
+      TypedTensorIrOpKind::Broadcast, {builder.Input(1)}, graph.state);
+  const uint32_t beta = builder.TensorOp(
+      TypedTensorIrOpKind::Broadcast, {builder.Input(2)}, graph.state);
+  const uint32_t value = builder.TensorOp(
+      TypedTensorIrOpKind::Broadcast, {builder.Input(3)}, graph.state);
+  const uint32_t decayed = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {builder.Input(0), decay}, graph.state);
+  const uint32_t outer = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {beta, value}, graph.state);
+  const uint32_t output = builder.TensorOp(
+      TypedTensorIrOpKind::Add, {decayed, outer}, graph.result);
+  return std::move(builder).Finish({output});
+}
