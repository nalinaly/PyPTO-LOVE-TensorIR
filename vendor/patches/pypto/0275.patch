+TypedTensorIrModuleSpec MakeGenericGdnReadTensorIrSpec(
+    const NativeTileGdnReadGraph& graph) {
+  StaticTensor query_batched = graph.query;
+  query_batched.shape = {graph.query.shape[0], 1, graph.query.shape[1]};
+  query_batched.dense_strides =
+      MakeDenseStridesForMetadata(query_batched.shape);
+  StaticTensor read_batched = graph.result;
+  read_batched.shape = {graph.result.shape[0], 1, graph.result.shape[1]};
+  read_batched.dtype = DataType::FP32;
+  read_batched.dense_strides = MakeDenseStridesForMetadata(read_batched.shape);
+  StaticTensor wide_query = graph.query;
+  wide_query.dtype = DataType::FP32;
+  StaticTensor wide_value = graph.value;
+  wide_value.dtype = DataType::FP32;
+  StaticTensor dot = wide_query;
+  dot.shape[1] = 1;
+  dot.dense_strides = {1, 1};
+
+  GenericTensorIrSpecBuilder builder(
+      {graph.query, graph.query, graph.query, graph.query, graph.value,
+       graph.state});
+  builder.AddResult(graph.result);
+  const uint32_t qdecay = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {builder.Input(0), builder.Input(1)},
+      graph.query);
+  const uint32_t qbatch = builder.TensorOp(
+      TypedTensorIrOpKind::Reshape, {qdecay}, query_batched);
+  const uint32_t read_batch = builder.TensorOp(
+      TypedTensorIrOpKind::Matmul, {qbatch, builder.Input(5)}, read_batched);
+  const uint32_t read = builder.TensorOp(
+      TypedTensorIrOpKind::Reshape, {read_batch}, wide_value);
+  const uint32_t qwide = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {builder.Input(0)}, wide_query);
+  const uint32_t gwide = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {builder.Input(2)}, wide_query);
+  const uint32_t kwide = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {builder.Input(3)}, wide_query);
+  const uint32_t vwide = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {builder.Input(4)}, wide_value);
+  const uint32_t gexp =
+      builder.TensorOp(TypedTensorIrOpKind::Exp, {gwide}, wide_query);
+  const uint32_t one = builder.Constant(DataType::FP32, 1.0);
+  const uint32_t gshift = builder.TensorOp(
+      TypedTensorIrOpKind::Add, {gexp, builder.Splat(one, wide_query)},
+      wide_query);
+  const uint32_t softplus =
+      builder.TensorOp(TypedTensorIrOpKind::Log, {gshift}, wide_query);
+  const uint32_t gated_key = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {softplus, kwide}, wide_query);
+  const uint32_t composed = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {qwide, gated_key}, wide_query);
+  TypedTensorIrOperationSpec reduction = MakeGenericReduction(
+      {composed}, dot, TypedTensorIrReductionMode::Add);
+  const uint32_t dot_value = builder.Append(std::move(reduction));
+  const uint32_t dot_broadcast = builder.TensorOp(
+      TypedTensorIrOpKind::Broadcast, {dot_value}, wide_value);
+  const uint32_t delta = builder.TensorOp(
+      TypedTensorIrOpKind::Mul, {vwide, dot_broadcast}, wide_value);
+  const uint32_t combined = builder.TensorOp(
+      TypedTensorIrOpKind::Add, {read, delta}, wide_value);
+  const uint32_t output = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {combined}, graph.result);
+  return std::move(builder).Finish({output});
+}
+
+TypedTensorIrModuleSpec MakeGenericPagedCacheWriteTensorIrSpec(
+    const NativeTilePagedCacheWriteGraph& graph) {
+  const int64_t tokens = graph.key.shape[0];
+  StaticTensor virtual_column{DataType::INT64, {tokens, 1}, {1, 1}};
+  StaticTensor virtual_column_i32 = virtual_column;
+  virtual_column_i32.dtype = DataType::INT32;
+  StaticTensor physical_column = virtual_column;
+  StaticTensor physical_column_i32 = virtual_column_i32;
+  StaticTensor physical_i32 = graph.physical_row;
+  physical_i32.dtype = DataType::INT32;
+  GenericTensorIrSpecBuilder builder(
+      {graph.key_cache, graph.value_cache, graph.physical_row,
+       graph.virtual_to_physical, graph.key, graph.value});
+  builder.AddResult(graph.result);
+  const uint32_t virtual_value = builder.Append([&] {
+    TypedTensorIrOperationSpec operation = MakeGenericOperation(
+        TypedTensorIrOpKind::Slice, {builder.Input(2)}, virtual_column);
+    operation.starts = {0, 0};
+    operation.limits = {tokens, 1};
+    operation.strides = {1, 1};
+    return operation;
+  }());
+  const uint32_t virtual_i32 = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {virtual_value}, virtual_column_i32);
+  const uint32_t physical_value = builder.TensorOp(
+      TypedTensorIrOpKind::GatherRows,
+      {builder.Input(3), virtual_i32}, physical_column);
+  const uint32_t physical_i32_value = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {physical_value}, physical_column_i32);
+  const uint32_t physical_full = builder.TensorOp(
+      TypedTensorIrOpKind::Broadcast, {physical_i32_value}, physical_i32);
+  const uint32_t stored_key = builder.TensorOp(
+      TypedTensorIrOpKind::ScatterRows,
+      {builder.Input(0), physical_full, builder.Input(4)}, graph.key);
+  const uint32_t stored_value = builder.TensorOp(
+      TypedTensorIrOpKind::ScatterRows,
+      {builder.Input(1), physical_full, builder.Input(5)}, graph.value);
+  const uint32_t output = builder.TensorOp(
+      TypedTensorIrOpKind::Add, {stored_key, stored_value}, graph.result);
+  return std::move(builder).Finish({output});
+}
+
+TypedTensorIrModuleSpec MakeGenericGatherRowsTensorIrSpec(
+    const NativeTileGatherRowsGraph& graph) {
+  StaticTensor indices32 = graph.indices;
+  indices32.dtype = DataType::INT32;
+  GenericTensorIrSpecBuilder builder({graph.data, graph.indices});
+  builder.AddResult(graph.result);
+  const uint32_t converted = builder.TensorOp(
+      TypedTensorIrOpKind::Convert, {builder.Input(1)}, indices32);
+  const uint32_t output = builder.TensorOp(
+      TypedTensorIrOpKind::GatherRows, {builder.Input(0), converted},
+      graph.result);
+  return std::move(builder).Finish({output});
+}
