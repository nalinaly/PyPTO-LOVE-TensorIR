+  REQUIRE(!build_spec.GetIdentityDigest().empty());
   REQUIRE(build_spec.GetSourceIrDigest() == MaterializedProducerDigest(prepared));
   REQUIRE(build_spec.GetCallableAbiDigest() == kernel.GetIdentityDigest());
   REQUIRE(build_spec.GetStaticSpecializationDigest() ==
@@ -1754,8 +1753,7 @@ int TestFinalizationAndCallableBinding() {
   const KernelBuildSpec build_spec = FinalizeForTest(prepared, kernel);
   REQUIRE(kernel.GetIdentityDigest() ==
           "4eee741cbe0c7322f938b83b01b34844c5f12fb1b01da52c2029e6687e24c640");
