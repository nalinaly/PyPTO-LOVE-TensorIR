@@ -1657,8 +1657,7 @@ int TestRankOneBf16ImplicitStrideGoldenAndFinalization() {
   const KernelBuildSpec build_spec = FinalizeForTest(prepared, kernel);
   REQUIRE(kernel.GetIdentityDigest() ==
           "e3d31183b4ba5b2f09f01ef777043b9f51818e33d6bdbf18333257211d57c0e8");
