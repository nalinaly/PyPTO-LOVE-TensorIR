   const ir::FunctionPtr& function = program->functions_.begin()->second;
@@ -5340,6 +5537,197 @@ std::string EmitNativeTileRopeSource(const NativeTileRopeGraph& graph) {
   return source;
 }
 
+std::string EmitNativeTilePagedDecodeSource(
+    const NativeTilePagedDecodeGraph& graph) {
+  StaticTensor cache_head{DataType::BF16,
+                          {graph.cache_rows, graph.head_dim}, {}};
+  cache_head.dense_strides = MakeDenseStridesForMetadata(cache_head.shape);
+  StaticTensor gathered{DataType::BF16, {graph.tokens, graph.head_dim}, {}};
+  gathered.dense_strides = MakeDenseStridesForMetadata(gathered.shape);
+  StaticTensor gathered_transposed{DataType::BF16,
+                                   {graph.head_dim, graph.tokens}, {}};
+  gathered_transposed.dense_strides =
+      MakeDenseStridesForMetadata(gathered_transposed.shape);
+  StaticTensor query_head{DataType::BF16, {1, graph.head_dim}, {}};
+  query_head.dense_strides = MakeDenseStridesForMetadata(query_head.shape);
+  StaticTensor score{DataType::FP32, {1, graph.tokens}, {}};
+  score.dense_strides = MakeDenseStridesForMetadata(score.shape);
+  StaticTensor row{DataType::FP32, {1, 1}, {1, 1}};
+  StaticTensor probability = score;
+  probability.dtype = DataType::BF16;
+  StaticTensor accumulation{DataType::FP32, {1, graph.head_dim}, {}};
+  accumulation.dense_strides =
+      MakeDenseStridesForMetadata(accumulation.shape);
+  StaticTensor head_result{DataType::BF16, {1, graph.head_dim}, {}};
+  head_result.dense_strides = MakeDenseStridesForMetadata(head_result.shape);
+
+  const std::string query_type = TensorTypeText(graph.query);
+  const std::string cache_type = TensorTypeText(graph.key_cache);
+  const std::string cache_head_type = TensorTypeText(cache_head);
+  const std::string indices_type = TensorTypeText(graph.physical_indices);
+  const std::string gathered_type = TensorTypeText(gathered);
+  const std::string gathered_transposed_type =
+      TensorTypeText(gathered_transposed);
+  const std::string query_head_type = TensorTypeText(query_head);
+  const std::string score_type = TensorTypeText(score);
+  const std::string row_type = TensorTypeText(row);
+  const std::string probability_type = TensorTypeText(probability);
+  const std::string accumulation_type = TensorTypeText(accumulation);
+  const std::string head_result_type = TensorTypeText(head_result);
+  const std::string result_type = TensorTypeText(graph.result);
+
+  std::string source;
+  source.reserve(static_cast<size_t>(graph.q_heads) * 2048 + 2048);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(graph.query);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(graph.key_cache);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(graph.value_cache);
+  source += ",\n    %arg3: ";
+  source += TensorWithStrideText(graph.physical_indices);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(graph.result);
+  source += ") {\n    %scale = constant ";
+  AppendFloat(source, graph.scale);
+  source += " : f32\n    %scale_splat = splat %scale : ";
+  source += score_type;
+
+  const int64_t queries_per_kv = graph.q_heads / graph.kv_heads;
+  for (int64_t q_head = 0; q_head < graph.q_heads; ++q_head) {
+    const int64_t kv_head = q_head / queries_per_kv;
+    const int64_t column_start = kv_head * graph.head_dim;
+    const int64_t column_limit = column_start + graph.head_dim;
+    const std::string suffix = std::to_string(q_head);
+    source += "\n    %k_table_" + suffix + " = slice %arg1 starts = [0, " +
+              std::to_string(column_start) + "] limits = [" +
+              std::to_string(graph.cache_rows) + ", " +
+              std::to_string(column_limit) + "] strides = [1, 1] : ";
+    source += cache_type;
+    source += " -> ";
+    source += cache_head_type;
+    source += "\n    %k_" + suffix +
+              " = gather_rows %k_table_" + suffix + ", %arg3 : (";
+    source += cache_head_type;
+    source += ", ";
+    source += indices_type;
+    source += ") -> ";
+    source += gathered_type;
+    source += "\n    %kt_" + suffix + " = transpose %k_" + suffix +
+              " permutation = [1, 0] : ";
+    source += gathered_type;
+    source += " -> ";
+    source += gathered_transposed_type;
+    source += "\n    %q_" + suffix + " = slice %arg0 starts = [" +
+              std::to_string(q_head) + ", 0] limits = [" +
+              std::to_string(q_head + 1) + ", " +
+              std::to_string(graph.head_dim) + "] strides = [1, 1] : ";
+    source += query_type;
+    source += " -> ";
+    source += query_head_type;
+    source += "\n    %scores_" + suffix + " = matmul(%q_" + suffix +
+              ", %kt_" + suffix + ") : (";
+    source += query_head_type;
+    source += ", ";
+    source += gathered_transposed_type;
+    source += ") -> ";
+    source += score_type;
+    source += "\n    %scaled_" + suffix + " = mul %scores_" + suffix +
+              ", %scale_splat : ";
+    source += score_type;
+    source += "\n    %rowmax_" + suffix +
+              " = reduce(%scaled_" + suffix +
+              ") <dimensions = [1], reduction_mode = <max>> : ";
+    source += score_type;
+    source += " -> ";
+    source += row_type;
+    source += "\n    %max_broadcast_" + suffix + " = broadcast %rowmax_" +
+              suffix + " : ";
+    source += row_type;
+    source += " -> ";
+    source += score_type;
+    source += "\n    %centered_" + suffix + " = sub %scaled_" + suffix +
+              ", %max_broadcast_" + suffix + " : ";
+    source += score_type;
+    source += "\n    %exponent_" + suffix + " = exp %centered_" + suffix +
+              " : ";
+    source += score_type;
+    source += "\n    %rowsum_" + suffix + " = reduce(%exponent_" + suffix +
+              ") <dimensions = [1], reduction_mode = <add>> : ";
+    source += score_type;
+    source += " -> ";
+    source += row_type;
+    source += "\n    %inverse_" + suffix + " = reciprocal %rowsum_" + suffix +
+              " : ";
+    source += row_type;
+    source += "\n    %inverse_broadcast_" + suffix +
+              " = broadcast %inverse_" + suffix + " : ";
+    source += row_type;
+    source += " -> ";
+    source += score_type;
+    source += "\n    %probability_f32_" + suffix + " = mul %exponent_" +
+              suffix + ", %inverse_broadcast_" + suffix + " : ";
+    source += score_type;
+    source += "\n    %probability_" + suffix +
+              " = convert %probability_f32_" + suffix + " : ";
+    source += score_type;
+    source += " -> ";
+    source += probability_type;
+    source += "\n    %v_table_" + suffix + " = slice %arg2 starts = [0, " +
+              std::to_string(column_start) + "] limits = [" +
+              std::to_string(graph.cache_rows) + ", " +
+              std::to_string(column_limit) + "] strides = [1, 1] : ";
+    source += cache_type;
+    source += " -> ";
+    source += cache_head_type;
+    source += "\n    %v_" + suffix +
+              " = gather_rows %v_table_" + suffix + ", %arg3 : (";
+    source += cache_head_type;
+    source += ", ";
+    source += indices_type;
+    source += ") -> ";
+    source += gathered_type;
+    source += "\n    %mixed_" + suffix + " = matmul(%probability_" + suffix +
+              ", %v_" + suffix + ") : (";
+    source += probability_type;
+    source += ", ";
+    source += gathered_type;
+    source += ") -> ";
+    source += accumulation_type;
+    source += "\n    %head_" + suffix + " = convert %mixed_" + suffix + " : ";
+    source += accumulation_type;
+    source += " -> ";
+    source += head_result_type;
+  }
+
+  if (graph.q_heads == 1) {
+    source += "\n    results %head_0 : ";
+    source += head_result_type;
+  } else {
+    source += "\n    %result0 = concatenate ";
+    for (int64_t head = 0; head < graph.q_heads; ++head) {
+      if (head != 0) source += ", ";
+      source += "%head_" + std::to_string(head);
+    }
+    source += " dimension = 0 : (";
+    for (int64_t head = 0; head < graph.q_heads; ++head) {
+      if (head != 0) source += ", ";
+      source += head_result_type;
+    }
+    source += ") -> ";
+    source += result_type;
+    source += "\n    results %result0 : ";
+    source += result_type;
+  }
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
