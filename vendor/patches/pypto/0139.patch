+bool IsNativeTilePagedDecodeCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 6) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && !top->stmts_.empty()
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto body = scope ? ir::As<ir::SeqStmts>(scope->body_) : nullptr;
+  const auto q_loop = body && body->stmts_.size() == 1
+                          ? ir::As<ir::ForStmt>(body->stmts_[0])
+                          : nullptr;
+  const auto q_body = q_loop ? ir::As<ir::SeqStmts>(q_loop->body_) : nullptr;
+  if (!q_body || q_body->stmts_.size() != 20) return false;
+  const auto slot_loop = ir::As<ir::ForStmt>(q_body->stmts_[5]);
+  const auto slot_body = slot_loop ? ir::As<ir::SeqStmts>(slot_loop->body_) : nullptr;
+  if (!slot_body || slot_body->stmts_.size() != 4) return false;
+  for (size_t index : {size_t{2}, size_t{3}}) {
+    const auto assignment = ir::As<ir::AssignStmt>(slot_body->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, "tile.gather_row")) return false;
+  }
+  return true;
+}
+
+NativeTilePagedDecodeGraph AnalyzeNativeTilePagedDecode(
+    const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native paged decode must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 6 ||
+      function->param_directions_.size() != 6 ||
+      function->return_types_.size() != 1) {
+    Reject("native paged decode requires Q, K/V cache, indices, scale and output",
+           &function->span_);
+  }
+  for (size_t index = 0; index < 5; ++index) {
+    if (function->param_directions_[index] != ir::ParamDirection::In) {
+      Reject("native paged decode inputs must have direction In",
+             &function->span_);
+    }
+  }
+  if (function->param_directions_[5] != ir::ParamDirection::Out) {
+    Reject("native paged decode output must have direction Out",
+           &function->span_);
+  }
+
+  const StaticTensor query = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native paged decode query");
+  const StaticTensor key_cache = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native paged decode key cache");
+  const StaticTensor value_cache = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native paged decode value cache");
+  StaticTensor physical_indices = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native paged decode physical indices");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[5]->GetType(), function->params_[5]->span_,
+      "native paged decode output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native paged decode declared output");
+  if (query.dtype != DataType::BF16 || key_cache.dtype != DataType::BF16 ||
+      value_cache.dtype != DataType::BF16 ||
+      physical_indices.dtype != DataType::INT32 ||
+      result.dtype != DataType::BF16 || query.shape.size() != 2 ||
+      key_cache.shape.size() != 2 || !SameTensor(key_cache, value_cache) ||
+      physical_indices.shape.size() != 2 || !SameTensor(query, result) ||
+      !SameTensor(result, declared)) {
+    Reject("native paged decode tensor types or ranks are invalid",
+           &function->span_);
+  }
+  const int64_t q_heads = query.shape[0];
+  const int64_t head_dim = query.shape[1];
+  const int64_t cache_rows = key_cache.shape[0];
+  const int64_t tokens = physical_indices.shape[0];
+  if (q_heads <= 0 || head_dim <= 0 || cache_rows <= 0 || tokens <= 0 ||
+      head_dim % 128 != 0 || tokens % 16 != 0 ||
+      key_cache.shape[1] % head_dim != 0 ||
+      physical_indices.shape[1] != head_dim) {
+    Reject("native paged decode static geometry is invalid", &function->span_);
+  }
+  const int64_t kv_heads = key_cache.shape[1] / head_dim;
+  if (kv_heads <= 0 || q_heads % kv_heads != 0) {
+    Reject("native paged decode GQA head mapping is invalid", &function->span_);
+  }
+  physical_indices.dense_strides = {1, 0};
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = top && top->stmts_.size() == 2
+                         ? ir::As<ir::InCoreScopeStmt>(top->stmts_[0])
+                         : nullptr;
+  const auto returned = top && top->stmts_.size() == 2
+                            ? ir::As<ir::ReturnStmt>(top->stmts_[1])
+                            : nullptr;
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returned_var ||
+      returned_var.get() != function->params_[5].get()) {
+    Reject("native paged decode scope or return is invalid", &function->span_);
+  }
+  const auto body = ir::As<ir::SeqStmts>(scope->body_);
+  const auto q_loop = body && body->stmts_.size() == 1
+                          ? ir::As<ir::ForStmt>(body->stmts_[0])
+                          : nullptr;
+  const auto q_stop = q_loop ? ir::As<ir::ConstInt>(q_loop->stop_) : nullptr;
+  const auto q_body = q_loop ? ir::As<ir::SeqStmts>(q_loop->body_) : nullptr;
+  if (!q_loop || !q_stop || q_stop->value_ != q_heads ||
+      q_loop->kind_ != ir::ForKind::Sequential || !q_loop->iter_args_.empty() ||
+      !q_loop->return_vars_.empty() || !q_body ||
+      q_body->stmts_.size() != 20) {
+    Reject("native paged decode query-head loop is invalid", &scope->span_);
+  }
+  const auto slot_loop = ir::As<ir::ForStmt>(q_body->stmts_[5]);
+  const auto slot_stop = slot_loop ? ir::As<ir::ConstInt>(slot_loop->stop_) : nullptr;
+  const auto slot_body =
+      slot_loop ? ir::As<ir::SeqStmts>(slot_loop->body_) : nullptr;
+  if (!slot_loop || !slot_stop || slot_stop->value_ != tokens ||
+      slot_loop->kind_ != ir::ForKind::Sequential || !slot_body ||
+      slot_body->stmts_.size() != 4) {
+    Reject("native paged decode physical-index loop is invalid",
+           &q_body->stmts_[5]->span_);
+  }
+  for (size_t index : {size_t{2}, size_t{3}}) {
+    const auto assignment = ir::As<ir::AssignStmt>(slot_body->stmts_[index]);
+    const auto call = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!call || !ir::IsOp(call, "tile.gather_row")) {
+      Reject("native paged decode must gather K/V rows directly into L1",
+             &slot_body->stmts_[index]->span_);
+    }
+  }
+  constexpr std::array<std::string_view, 13> kExpectedOps = {
+      "tile.load",        "tile.matmul",       "tile.muls",
+      "tile.create",      "tile.row_max",      "tile.row_expand_sub",
+      "tile.exp",         "tile.create",       "tile.row_sum",
+      "tile.row_expand_div", "tile.cast",      "tile.matmul",
+      "tile.cast"};
+  std::array<ir::CallPtr, 13> calls;
+  for (size_t index = 0; index < calls.size(); ++index) {
+    const auto assignment = ir::As<ir::AssignStmt>(q_body->stmts_[6 + index]);
+    calls[index] = assignment ? ir::As<ir::Call>(assignment->value_) : nullptr;
+    if (!calls[index] ||
+        !ir::IsOp(calls[index], std::string(kExpectedOps[index]))) {
+      Reject("native paged decode attention operation sequence is invalid",
+             &q_body->stmts_[6 + index]->span_);
+    }
+  }
+  const auto store_statement = ir::As<ir::EvalStmt>(q_body->stmts_[19]);
+  const auto store =
+      store_statement ? ir::As<ir::Call>(store_statement->expr_) : nullptr;
+  if (!store || !ir::IsOp(store, "tile.store")) {
+    Reject("native paged decode must end in one output store",
+           &q_body->stmts_[19]->span_);
+  }
+  const auto scale = calls[2]->args_.size() == 2
+                         ? ir::As<ir::ConstFloat>(calls[2]->args_[1])
+                         : nullptr;
+  const double expected_scale =
+      1.0 / std::sqrt(static_cast<double>(head_dim));
+  if (!scale || !std::isfinite(scale->value_) ||
+      std::fabs(scale->value_ - expected_scale) >
+          std::numeric_limits<double>::epsilon()) {
+    Reject("native paged decode scale must equal 1/sqrt(head_dim)",
+           &calls[2]->span_);
+  }
+  return NativeTilePagedDecodeGraph{
+      query, key_cache, value_cache, physical_indices, result,
+      q_heads, kv_heads, tokens, head_dim, cache_rows, scale->value_};
+}
