+@pl.jit
+def _native_tile_paged_decode(
+    query: pl.Tensor[[8, 256], pl.BF16],
+    key_cache: pl.Tensor[[1024, 512], pl.BF16],
+    value_cache: pl.Tensor[[1024, 512], pl.BF16],
+    physical_indices: pl.Tensor[[16, 256], pl.INT32],
+    scale: pl.FP32,
+    out: pl.Out[pl.Tensor[[8, 256], pl.BF16]],
+):
+    with pl.at(level=pl.Level.CORE_GROUP):
+        for q_head in pl.range(8):
+            kv_heads = key_cache.shape[1] // query.shape[1]
+            queries_per_kv = query.shape[0] // kv_heads
+            kv_head = q_head // queries_per_kv
+            keys = pl.tile.create(
+                [256, 16],
+                dtype=pl.BF16,
+                target_memory=pl.MemorySpace.Mat,
+                transpose=True,
+            )
+            values = pl.tile.create(
+                [16, 256], dtype=pl.BF16, target_memory=pl.MemorySpace.Mat
+            )
+            for slot in pl.range(16):
+                physical = pl.read(physical_indices, [slot, 0])
+                cache_column = kv_head * 256
+                keys = pl.tile.gather_row(
+                    keys,
+                    key_cache,
+                    [0, slot],
+                    [physical, cache_column],
+                    [1, 256],
+                    transpose=True,
+                )
+                values = pl.tile.gather_row(
+                    values,
+                    value_cache,
+                    [slot, 0],
+                    [physical, cache_column],
+                    [1, 256],
+                )
+            query_tile = pl.load(
+                query, [q_head, 0], [1, 256], target_memory=pl.MemorySpace.Mat
+            )
+            score = pl.matmul(query_tile, keys, out_dtype=pl.FP32)
+            scaled = pl.mul(score, scale)
+            max_scratch = pl.create_tile(
