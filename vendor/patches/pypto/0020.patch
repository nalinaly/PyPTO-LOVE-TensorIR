+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <msgpack.hpp>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "canonical_msgpack.h"
+#include "pypto/core/error.h"
+
+using pypto::ValueError;
+using pypto::compiler::detail::CanonicalPacker;
+using pypto::compiler::detail::FinishBuffer;
+using pypto::compiler::detail::PackBinary;
+using pypto::compiler::detail::PackText;
+using pypto::compiler::detail::ReadBinary;
+using pypto::compiler::detail::ReadBool;
+using pypto::compiler::detail::ReadInt;
+using pypto::compiler::detail::ReadInt64;
+using pypto::compiler::detail::ReadText;
+using pypto::compiler::detail::ReadUint32;
+using pypto::compiler::detail::ReadUint64;
+using pypto::compiler::detail::StrictMap;
+using pypto::compiler::detail::UnpackLimits;
+using pypto::compiler::detail::UnpackOne;
+
+#define REQUIRE(condition) \
+  do {                     \
+    if (!(condition)) {    \
+      return __LINE__;     \
+    }                      \
+  } while (false)
+
+namespace {
+
+constexpr size_t kPayloadLimit = 1024;
+constexpr UnpackLimits kLimits{/*maximum_array_items=*/2,
+                               /*maximum_map_items=*/2,
+                               /*maximum_string_bytes=*/2,
+                               /*maximum_binary_bytes=*/2,
+                               /*maximum_nesting_depth=*/2,
+                               /*maximum_total_objects=*/16,
+                               /*maximum_aggregate_container_items=*/8,
+                               /*maximum_nonbinary_bytes=*/kPayloadLimit,
+                               /*maximum_binary_fields=*/1};
+
+template <typename Function>
+bool Rejects(Function&& function) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+template <typename PackFunction>
+std::vector<uint8_t> Pack(PackFunction&& function) {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  std::forward<PackFunction>(function)(packer);
+  return FinishBuffer(buffer);
+}
+
+bool UnpackRejects(const std::vector<uint8_t>& data, size_t payload_limit = kPayloadLimit,
+                   UnpackLimits limits = kLimits) {
+  return Rejects([&]() { (void)UnpackOne(data, "test contract", payload_limit, limits); });
+}
+
+int TestPackingAndTypedReaders() {
+  msgpack::sbuffer empty_buffer;
+  REQUIRE(FinishBuffer(empty_buffer).empty());
+
+  const auto text =
+      Pack([](CanonicalPacker& packer) { PackText(packer, std::string_view("a\0", 2)); });
+  auto text_object = UnpackOne(text, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadText(text_object.get(), "text") == std::string("a\0", 2));
+  REQUIRE(Rejects([&]() { (void)ReadBinary(text_object.get(), "text"); }));
+
+  const std::vector<uint8_t> binary = {0x00, 0xff};
+  const auto binary_bytes = Pack([&](CanonicalPacker& packer) { PackBinary(packer, binary); });
+  auto binary_object = UnpackOne(binary_bytes, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadBinary(binary_object.get(), "binary") == binary);
+  REQUIRE(Rejects([&]() { (void)ReadText(binary_object.get(), "binary"); }));
+
+  const auto empty_binary = Pack([](CanonicalPacker& packer) { PackBinary(packer, {}); });
+  auto empty_binary_object = UnpackOne(empty_binary, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadBinary(empty_binary_object.get(), "binary").empty());
+
+  const auto boolean = Pack([](CanonicalPacker& packer) { packer.pack(true); });
+  auto boolean_object = UnpackOne(boolean, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadBool(boolean_object.get(), "boolean"));
+  REQUIRE(Rejects([&]() { (void)ReadUint64(boolean_object.get(), "boolean"); }));
+  return 0;
+}
+
+int TestIntegerReaders() {
+  const auto maximum_unsigned =
+      Pack([](CanonicalPacker& packer) { packer.pack(std::numeric_limits<uint64_t>::max()); });
+  auto maximum_unsigned_object =
+      UnpackOne(maximum_unsigned, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadUint64(maximum_unsigned_object.get(), "uint64") ==
+          std::numeric_limits<uint64_t>::max());
+  REQUIRE(Rejects([&]() { (void)ReadUint32(maximum_unsigned_object.get(), "uint32"); }));
+  REQUIRE(Rejects([&]() { (void)ReadInt64(maximum_unsigned_object.get(), "int64"); }));
+
+  const auto maximum_signed =
+      Pack([](CanonicalPacker& packer) { packer.pack(std::numeric_limits<int64_t>::max()); });
+  auto maximum_signed_object = UnpackOne(maximum_signed, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadInt64(maximum_signed_object.get(), "int64") == std::numeric_limits<int64_t>::max());
+  REQUIRE(Rejects([&]() { (void)ReadInt(maximum_signed_object.get(), "int"); }));
+
+  const auto minimum_signed =
+      Pack([](CanonicalPacker& packer) { packer.pack(std::numeric_limits<int64_t>::min()); });
+  auto minimum_signed_object = UnpackOne(minimum_signed, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(ReadInt64(minimum_signed_object.get(), "int64") == std::numeric_limits<int64_t>::min());
+  REQUIRE(Rejects([&]() { (void)ReadUint64(minimum_signed_object.get(), "uint64"); }));
+  REQUIRE(Rejects([&]() { (void)ReadInt(minimum_signed_object.get(), "int"); }));
+  return 0;
+}
+
+int TestStrictMap() {
+  const auto valid = Pack([](CanonicalPacker& packer) {
+    packer.pack_map(2);
+    PackText(packer, "a");
+    packer.pack(1);
+    PackText(packer, "b");
+    packer.pack(2);
+  });
+  auto valid_object = UnpackOne(valid, "test contract", kPayloadLimit, kLimits);
+  StrictMap fields(valid_object.get(), "root", {"a", "b"});
+  REQUIRE(ReadUint64(fields.Get("a"), "root.a") == 1);
+  REQUIRE(Rejects([&]() { (void)fields.Get("missing"); }));
+
+  const auto duplicate = Pack([](CanonicalPacker& packer) {
+    packer.pack_map(2);
+    PackText(packer, "a");
+    packer.pack(1);
+    PackText(packer, "a");
+    packer.pack(2);
+  });
+  auto duplicate_object = UnpackOne(duplicate, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(Rejects([&]() { (void)StrictMap(duplicate_object.get(), "root", {"a"}); }));
+
+  const auto unknown = Pack([](CanonicalPacker& packer) {
+    packer.pack_map(1);
+    PackText(packer, "x");
+    packer.pack(1);
+  });
+  auto unknown_object = UnpackOne(unknown, "test contract", kPayloadLimit, kLimits);
+  REQUIRE(Rejects([&]() { (void)StrictMap(unknown_object.get(), "root", {"a"}); }));
+  return 0;
+}
+
+int TestUnpackBounds() {
+  const auto nil = Pack([](CanonicalPacker& packer) { packer.pack_nil(); });
+  REQUIRE(!UnpackRejects(nil, nil.size()));
+  REQUIRE(UnpackRejects(nil, nil.size() - 1));
+  REQUIRE(UnpackRejects({}));
+
+  for (uint32_t count = 1; count <= 3; ++count) {
+    const auto array = Pack([&](CanonicalPacker& packer) {
+      packer.pack_array(count);
+      for (uint32_t index = 0; index < count; ++index) packer.pack(index);
+    });
+    REQUIRE(UnpackRejects(array) == (count > kLimits.maximum_array_items));
+
+    const auto map = Pack([&](CanonicalPacker& packer) {
+      packer.pack_map(count);
+      for (uint32_t index = 0; index < count; ++index) {
+        PackText(packer, std::to_string(index));
+        packer.pack(index);
+      }
+    });
+    REQUIRE(UnpackRejects(map) == (count > kLimits.maximum_map_items));
+
+    const auto string = Pack([&](CanonicalPacker& packer) { PackText(packer, std::string(count, 'x')); });
+    REQUIRE(UnpackRejects(string) == (count > kLimits.maximum_string_bytes));
+
+    const auto binary = Pack([&](CanonicalPacker& packer) {
+      PackBinary(packer, std::vector<uint8_t>(count, 0xab));
+    });
+    REQUIRE(UnpackRejects(binary) == (count > kLimits.maximum_binary_bytes));
+  }
+
+  const auto depth_two = Pack([](CanonicalPacker& packer) {
+    packer.pack_array(1);
+    packer.pack_array(1);
+    packer.pack(0);
+  });
+  REQUIRE(!UnpackRejects(depth_two));
+  const auto depth_three = Pack([](CanonicalPacker& packer) {
+    packer.pack_array(1);
+    packer.pack_array(1);
+    packer.pack_array(1);
+    packer.pack(0);
+  });
+  REQUIRE(UnpackRejects(depth_three));
+
+  auto trailing = nil;
+  trailing.push_back(0);
+  REQUIRE(UnpackRejects(trailing));
+  auto truncated = Pack([](CanonicalPacker& packer) { PackText(packer, "xy"); });
+  truncated.pop_back();
+  REQUIRE(UnpackRejects(truncated));
+
+  const std::vector<uint8_t> oversized_string_header = {0xdb, 0x7f, 0xff, 0xff, 0xff};
+  REQUIRE(UnpackRejects(oversized_string_header));
+  const std::vector<uint8_t> oversized_binary_header = {0xc6, 0x7f, 0xff, 0xff, 0xff};
+  REQUIRE(UnpackRejects(oversized_binary_header));
+
+  const auto extension = Pack([](CanonicalPacker& packer) {
+    const char value = 'x';
+    packer.pack_ext(1, 1);
+    packer.pack_ext_body(&value, 1);
+  });
+  REQUIRE(UnpackRejects(extension));
+  const std::vector<uint8_t> oversized_extension_header = {0xc9, 0xff, 0xff, 0xff, 0xff};
+  REQUIRE(UnpackRejects(oversized_extension_header));
+
+  const auto float32 = Pack([](CanonicalPacker& packer) { packer.pack(1.0F); });
+  REQUIRE(UnpackRejects(float32));
+  const auto float64 = Pack([](CanonicalPacker& packer) { packer.pack(1.0); });
+  REQUIRE(UnpackRejects(float64));
+
+  auto object_limited = kLimits;
+  object_limited.maximum_total_objects = 2;
+  const auto three_objects = Pack([](CanonicalPacker& packer) {
+    packer.pack_array(2);
+    packer.pack(0);
+    packer.pack(1);
+  });
+  REQUIRE(UnpackRejects(three_objects, kPayloadLimit, object_limited));
+  object_limited.maximum_total_objects = 3;
+  REQUIRE(!UnpackRejects(three_objects, kPayloadLimit, object_limited));
+
+  auto aggregate_limited = kLimits;
+  aggregate_limited.maximum_aggregate_container_items = 1;
+  REQUIRE(UnpackRejects(three_objects, kPayloadLimit, aggregate_limited));
+  aggregate_limited.maximum_aggregate_container_items = 2;
+  REQUIRE(!UnpackRejects(three_objects, kPayloadLimit, aggregate_limited));
+
+  const auto one_pair_map = Pack([](CanonicalPacker& packer) {
+    packer.pack_map(1);
+    PackText(packer, "a");
+    packer.pack(1);
+  });
+  aggregate_limited.maximum_aggregate_container_items = 1;
+  REQUIRE(UnpackRejects(one_pair_map, kPayloadLimit, aggregate_limited));
+  aggregate_limited.maximum_aggregate_container_items = 2;
+  REQUIRE(!UnpackRejects(one_pair_map, kPayloadLimit, aggregate_limited));
+
+  auto nonbinary_limited = kLimits;
+  nonbinary_limited.maximum_nonbinary_bytes = nil.size() - 1;
+  REQUIRE(UnpackRejects(nil, kPayloadLimit, nonbinary_limited));
+  nonbinary_limited.maximum_nonbinary_bytes = nil.size();
+  REQUIRE(!UnpackRejects(nil, kPayloadLimit, nonbinary_limited));
+
+  const auto one_byte_binary = Pack([](CanonicalPacker& packer) { PackBinary(packer, {0xab}); });
+  nonbinary_limited.maximum_nonbinary_bytes = one_byte_binary.size() - 1;
+  REQUIRE(!UnpackRejects(one_byte_binary, kPayloadLimit, nonbinary_limited));
+  --nonbinary_limited.maximum_nonbinary_bytes;
+  REQUIRE(UnpackRejects(one_byte_binary, kPayloadLimit, nonbinary_limited));
+
+  auto binary_with_trailing = one_byte_binary;
+  binary_with_trailing.push_back(0xc0);
+  REQUIRE(UnpackRejects(binary_with_trailing));
+
+  const auto two_binary_fields = Pack([](CanonicalPacker& packer) {
+    packer.pack_array(2);
+    PackBinary(packer, {});
+    PackBinary(packer, {});
+  });
+  REQUIRE(UnpackRejects(two_binary_fields));
+
+  auto zero_limited = kLimits;
+  zero_limited.maximum_total_objects = 0;
+  REQUIRE(UnpackRejects(nil, kPayloadLimit, zero_limited));
+  zero_limited = kLimits;
+  zero_limited.maximum_nesting_depth = 0;
+  REQUIRE(UnpackRejects(three_objects, kPayloadLimit, zero_limited));
+  zero_limited = kLimits;
+  zero_limited.maximum_binary_fields = 0;
+  REQUIRE(UnpackRejects(one_byte_binary, kPayloadLimit, zero_limited));
+
+  auto unbounded = kLimits;
+  unbounded.maximum_total_objects = std::numeric_limits<size_t>::max();
+  REQUIRE(UnpackRejects(nil, kPayloadLimit, unbounded));
+  unbounded = kLimits;
+  unbounded.maximum_aggregate_container_items = std::numeric_limits<size_t>::max();
+  REQUIRE(UnpackRejects(nil, kPayloadLimit, unbounded));
+  unbounded = kLimits;
+  unbounded.maximum_nonbinary_bytes = std::numeric_limits<size_t>::max();
+  REQUIRE(UnpackRejects(nil, kPayloadLimit, unbounded));
+  unbounded = kLimits;
