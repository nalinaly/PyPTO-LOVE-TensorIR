+
+namespace pypto::compiler::detail {
+namespace {
+
+class BoundedPreflightVisitor final : public msgpack::v2::null_visitor {
+ public:
+  explicit BoundedPreflightVisitor(const UnpackLimits& limits) : limits_(limits) {}
+
+  bool visit_nil() { return CountObject(); }
+  bool visit_boolean(bool) { return CountObject(); }
+  bool visit_positive_integer(uint64_t) { return CountObject(); }
+  bool visit_negative_integer(int64_t) { return CountObject(); }
+
+  bool visit_float32(float) { return Reject("floating-point values are not permitted"); }
+  bool visit_float64(double) { return Reject("floating-point values are not permitted"); }
+
+  bool visit_str(const char*, uint32_t size) {
+    if (size > limits_.maximum_string_bytes) {
+      return Reject("string exceeds its size limit");
+    }
+    return CountObject();
+  }
+
+  bool visit_bin(const char*, uint32_t size) {
+    if (size > limits_.maximum_binary_bytes) {
+      return Reject("binary data exceeds its size limit");
+    }
+    if (binary_fields_ == limits_.maximum_binary_fields) {
+      return Reject("binary field count exceeds its limit");
+    }
+    ++binary_fields_;
+    if (size > std::numeric_limits<size_t>::max() - binary_payload_bytes_) {
+      return Reject("binary payload byte count overflows size_t");
+    }
+    binary_payload_bytes_ += size;
+    return CountObject();
+  }
+
+  bool visit_ext(const char*, uint32_t) { return Reject("extension values are not permitted"); }
+
+  bool start_array(uint32_t item_count) {
+    if (item_count > limits_.maximum_array_items) {
+      return Reject("array item count exceeds its limit");
+    }
+    return CountObject() && CountContainerItems(item_count) && EnterContainer();
+  }
+
+  bool end_array() {
+    return LeaveContainer();
+  }
+
+  bool start_map(uint32_t pair_count) {
+    if (pair_count > limits_.maximum_map_items) {
+      return Reject("map item count exceeds its limit");
+    }
+    if (pair_count > std::numeric_limits<size_t>::max() / 2) {
+      return Reject("map item count overflows size_t");
+    }
+    return CountObject() && CountContainerItems(static_cast<size_t>(pair_count) * 2) &&
+           EnterContainer();
+  }
+
+  bool end_map() {
+    return LeaveContainer();
+  }
+
+  void parse_error(size_t, size_t) { SetParserError("contains malformed MessagePack"); }
+  void insufficient_bytes(size_t, size_t) {
+    SetParserError("contains malformed MessagePack (truncated input)");
+  }
+
+  [[nodiscard]] const std::string& GetError() const noexcept { return error_; }
+  [[nodiscard]] size_t GetBinaryPayloadBytes() const noexcept { return binary_payload_bytes_; }
+  [[nodiscard]] size_t GetNestingDepth() const noexcept { return nesting_depth_; }
+
+ private:
+  bool CountObject() {
+    if (total_objects_ == limits_.maximum_total_objects) {
+      return Reject("decoded object count exceeds its limit");
+    }
+    ++total_objects_;
+    return true;
+  }
+
+  bool CountContainerItems(size_t item_count) {
+    if (aggregate_container_items_ > limits_.maximum_aggregate_container_items) {
+      return Reject("aggregate container item count exceeds its limit");
+    }
+    if (item_count > limits_.maximum_aggregate_container_items - aggregate_container_items_) {
+      return Reject("aggregate container item count exceeds its limit");
+    }
+    aggregate_container_items_ += item_count;
+    return true;
+  }
+
+  bool EnterContainer() {
+    if (nesting_depth_ == limits_.maximum_nesting_depth) {
+      return Reject("nesting depth exceeds its limit");
+    }
+    ++nesting_depth_;
+    return true;
+  }
+
+  bool LeaveContainer() {
+    if (nesting_depth_ == 0) return Reject("container nesting depth underflow");
+    --nesting_depth_;
+    return true;
+  }
+
+  bool Reject(std::string message) {
+    if (error_.empty()) error_ = std::move(message);
+    return false;
+  }
+
+  void SetParserError(std::string message) {
+    if (error_.empty()) error_ = std::move(message);
+  }
+
+  const UnpackLimits& limits_;
+  size_t total_objects_ = 0;
+  size_t aggregate_container_items_ = 0;
+  size_t binary_payload_bytes_ = 0;
+  size_t binary_fields_ = 0;
+  size_t nesting_depth_ = 0;
+  std::string error_;
+};
+
+void PreflightMessagePack(const std::vector<uint8_t>& data, const std::string& contract_name,
+                          const UnpackLimits& limits) {
+  BoundedPreflightVisitor visitor(limits);
+  size_t offset = 0;
+  const bool parsed = [&]() {
+    try {
+      return msgpack::v2::parse(reinterpret_cast<const char*>(data.data()), data.size(), offset,
+                                visitor);
+    } catch (const msgpack::unpack_error& error) {
+      throw ValueError("malformed " + contract_name + " MessagePack: " +
+                       std::string(error.what()));
+    }
+  }();
+  if (!visitor.GetError().empty()) {
+    throw ValueError(contract_name + " " + visitor.GetError());
+  }
+  if (!parsed) throw ValueError("malformed " + contract_name + " MessagePack");
+  if (offset != data.size()) throw ValueError(contract_name + " payload contains trailing bytes");
+  if (visitor.GetNestingDepth() != 0) {
+    throw ValueError(contract_name + " contains malformed MessagePack container nesting");
+  }
+  if (visitor.GetBinaryPayloadBytes() > data.size()) {
+    throw ValueError(contract_name + " binary payload bytes exceed the encoded payload size");
+  }
+  const size_t nonbinary_bytes = data.size() - visitor.GetBinaryPayloadBytes();
+  if (nonbinary_bytes > limits.maximum_nonbinary_bytes) {
+    throw ValueError(contract_name + " non-binary encoding exceeds its size limit");
+  }
+}
+
+}  // namespace
+
+void PackText(CanonicalPacker& packer, std::string_view value) {
+  if (value.size() > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError("canonical MessagePack string exceeds uint32 range");
+  }
+  const auto size = static_cast<uint32_t>(value.size());
+  packer.pack_str(size);
+  if (size != 0) packer.pack_str_body(value.data(), size);
+}
+
+void PackKey(CanonicalPacker& packer, std::string_view key) { PackText(packer, key); }
+
+void PackBinary(CanonicalPacker& packer, const std::vector<uint8_t>& value) {
+  if (value.size() > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError("canonical MessagePack binary data exceeds uint32 range");
+  }
+  const auto size = static_cast<uint32_t>(value.size());
+  packer.pack_bin(size);
+  if (size != 0) {
+    packer.pack_bin_body(reinterpret_cast<const char*>(value.data()), size);
+  }
+}
+
+std::vector<uint8_t> FinishBuffer(const msgpack::sbuffer& buffer) {
+  if (buffer.size() == 0) return {};
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+StrictMap::StrictMap(const msgpack::object& object, std::string context,
+                     std::initializer_list<std::string_view> allowed_fields)
+    : context_(std::move(context)) {
+  if (object.type != msgpack::type::MAP) throw ValueError(context_ + " must be a map");
+  std::map<std::string, bool> allowed;
+  for (std::string_view field : allowed_fields) allowed.emplace(field, true);
+  for (uint32_t index = 0; index < object.via.map.size; ++index) {
+    const auto& entry = object.via.map.ptr[index];
+    if (entry.key.type != msgpack::type::STR) {
+      throw ValueError(context_ + " field names must be strings");
+    }
+    std::string key(entry.key.via.str.ptr, entry.key.via.str.size);
+    if (allowed.find(key) == allowed.end()) {
+      throw ValueError(context_ + " contains unknown field '" + key + "'");
+    }
+    if (!fields_.emplace(std::move(key), &entry.val).second) {
+      throw ValueError(context_ + " contains a duplicate field");
+    }
+  }
+}
+
+const msgpack::object& StrictMap::Get(const std::string& field) const {
+  const auto iterator = fields_.find(field);
+  if (iterator == fields_.end()) {
+    throw ValueError(context_ + " is missing required field '" + field + "'");
+  }
+  return *iterator->second;
+}
+
+std::string ReadText(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::STR) throw ValueError(context + " must be a string");
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+std::vector<uint8_t> ReadBinary(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::BIN) throw ValueError(context + " must be binary data");
+  if (object.via.bin.size == 0) return {};
+  const auto* begin = reinterpret_cast<const uint8_t*>(object.via.bin.ptr);
+  return std::vector<uint8_t>(begin, begin + object.via.bin.size);
+}
+
+bool ReadBool(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::BOOLEAN) throw ValueError(context + " must be a boolean");
+  return object.via.boolean;
+}
+
+uint64_t ReadUint64(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::POSITIVE_INTEGER) {
+    throw ValueError(context + " must be an unsigned integer");
+  }
+  return object.via.u64;
+}
+
+uint32_t ReadUint32(const msgpack::object& object, const std::string& context) {
+  const uint64_t value = ReadUint64(object, context);
+  if (value > std::numeric_limits<uint32_t>::max()) {
+    throw ValueError(context + " exceeds uint32 range");
+  }
+  return static_cast<uint32_t>(value);
+}
+
+int64_t ReadInt64(const msgpack::object& object, const std::string& context) {
+  if (object.type == msgpack::type::POSITIVE_INTEGER) {
+    if (object.via.u64 > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+      throw ValueError(context + " exceeds int64 range");
+    }
+    return static_cast<int64_t>(object.via.u64);
+  }
+  if (object.type == msgpack::type::NEGATIVE_INTEGER) return object.via.i64;
+  throw ValueError(context + " must be an integer");
+}
+
+int ReadInt(const msgpack::object& object, const std::string& context) {
+  if (object.type == msgpack::type::POSITIVE_INTEGER) {
+    if (object.via.u64 > static_cast<uint64_t>(std::numeric_limits<int>::max())) {
+      throw ValueError(context + " exceeds int range");
+    }
+    return static_cast<int>(object.via.u64);
+  }
+  if (object.type == msgpack::type::NEGATIVE_INTEGER) {
+    if (object.via.i64 < std::numeric_limits<int>::min()) {
+      throw ValueError(context + " exceeds int range");
+    }
+    return static_cast<int>(object.via.i64);
+  }
+  throw ValueError(context + " must be an integer");
+}
+
+msgpack::object_handle UnpackOne(const std::vector<uint8_t>& data, std::string_view contract_name,
+                                 size_t maximum_payload_bytes, const UnpackLimits& limits) {
+  const std::string name(contract_name);
+  if (data.empty()) throw ValueError(name + " payload must not be empty");
+  if (data.size() > maximum_payload_bytes) {
+    throw ValueError(name + " payload exceeds its serialized-size limit");
+  }
+  if (limits.maximum_nesting_depth == std::numeric_limits<size_t>::max() ||
+      limits.maximum_total_objects == std::numeric_limits<size_t>::max() ||
+      limits.maximum_aggregate_container_items == std::numeric_limits<size_t>::max() ||
+      limits.maximum_nonbinary_bytes == std::numeric_limits<size_t>::max() ||
+      limits.maximum_binary_fields == std::numeric_limits<size_t>::max()) {
+    throw ValueError(name + " structural preflight limits must be finite");
+  }
+  PreflightMessagePack(data, name, limits);
+  size_t offset = 0;
+  const msgpack::unpack_limit unpack_limits(
+      limits.maximum_array_items, limits.maximum_map_items, limits.maximum_string_bytes,
+      limits.maximum_binary_bytes, 0, limits.maximum_nesting_depth);
+  msgpack::object_handle handle = [&]() {
+    try {
+      return msgpack::unpack(reinterpret_cast<const char*>(data.data()), data.size(), offset, nullptr,
+                             nullptr, unpack_limits);
+    } catch (const msgpack::unpack_error& error) {
+      throw ValueError("malformed " + name + " MessagePack: " + std::string(error.what()));
+    }
+  }();
+  if (offset != data.size()) throw ValueError(name + " payload contains trailing bytes");
+  return handle;
+}
+
+}  // namespace pypto::compiler::detail
