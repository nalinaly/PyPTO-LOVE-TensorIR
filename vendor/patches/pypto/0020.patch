+#ifndef PYPTO_SRC_COMPILER_CANONICAL_MSGPACK_H_
+#define PYPTO_SRC_COMPILER_CANONICAL_MSGPACK_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <map>
+#include <msgpack.hpp>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace pypto::compiler::detail {
+
+using CanonicalPacker = msgpack::packer<msgpack::sbuffer>;
+
+/** Allocation and structural budgets checked before MessagePack builds an object tree. */
+struct UnpackLimits {
+  size_t maximum_array_items;
+  size_t maximum_map_items;
+  size_t maximum_string_bytes;
+  size_t maximum_binary_bytes;
+  size_t maximum_nesting_depth;
+  size_t maximum_total_objects;
+  size_t maximum_aggregate_container_items;
+  size_t maximum_nonbinary_bytes;
+  size_t maximum_binary_fields;
+};
+
+void PackText(CanonicalPacker& packer, std::string_view value);
+void PackKey(CanonicalPacker& packer, std::string_view key);
+void PackBinary(CanonicalPacker& packer, const std::vector<uint8_t>& value);
+[[nodiscard]] std::vector<uint8_t> FinishBuffer(const msgpack::sbuffer& buffer);
+
+class StrictMap {
+ public:
+  StrictMap(const msgpack::object& object, std::string context,
+            std::initializer_list<std::string_view> allowed_fields);
+
+  [[nodiscard]] const msgpack::object& Get(const std::string& field) const;
+
+ private:
+  std::string context_;
+  std::map<std::string, const msgpack::object*> fields_;
+};
+
+[[nodiscard]] std::string ReadText(const msgpack::object& object, const std::string& context);
+[[nodiscard]] std::vector<uint8_t> ReadBinary(const msgpack::object& object,
+                                              const std::string& context);
+[[nodiscard]] bool ReadBool(const msgpack::object& object, const std::string& context);
+[[nodiscard]] uint64_t ReadUint64(const msgpack::object& object, const std::string& context);
+[[nodiscard]] uint32_t ReadUint32(const msgpack::object& object, const std::string& context);
+[[nodiscard]] int64_t ReadInt64(const msgpack::object& object, const std::string& context);
+[[nodiscard]] int ReadInt(const msgpack::object& object, const std::string& context);
+
+[[nodiscard]] msgpack::object_handle UnpackOne(const std::vector<uint8_t>& data,
+                                               std::string_view contract_name,
+                                               size_t maximum_payload_bytes,
+                                               const UnpackLimits& limits);
+
+}  // namespace pypto::compiler::detail
+
+#endif  // PYPTO_SRC_COMPILER_CANONICAL_MSGPACK_H_
