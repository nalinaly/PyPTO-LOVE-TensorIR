 src/compiler/nvidia_typed_tensor_ir_builder.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/compiler/nvidia_typed_tensor_ir_builder.cpp b/src/compiler/nvidia_typed_tensor_ir_builder.cpp
index 6ffefe69f3ba71164286fc2d35ba4eab9dea01e1..84aede201a77a10da0e3d458294677bbc470e11e 100644
