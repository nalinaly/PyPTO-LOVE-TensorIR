+++ b/src/compiler/nvidia_typed_tensor_ir_builder.cpp
@@ -55,6 +55,8 @@ using codegen::nvidia::TypedTensorIrTensorSpec;
 constexpr std::string_view kEntryName = "pypto_fused_pointwise";
 constexpr std::string_view kStructuredMatmulEntryName =
     "pypto_structured_matmul";
+constexpr std::string_view kAlignedAddAttribute =
+    "_pypto_align_rhs_trailing_transpose";
 constexpr size_t kMaximumCanonicalSourceBytes = 16ULL * 1024ULL * 1024ULL;
 constexpr size_t kMaximumCapturedDiagnosticBytes = 64ULL * 1024ULL;
 constexpr int64_t kMaximumBatchTokenProduct = 4096;
@@ -973,6 +975,8 @@ class NativeGdnRecurrentBuilder {
         const mlir::Value outer_flat = Reshape(outer, state_row_type);
         auto updated_flat = tir::AddOp::create(
             builder_, location_, state_row_type, decayed_flat, outer_flat);
+        updated_flat->setAttr(kAlignedAddAttribute,
+                              builder_.getBoolAttr(true));
         current_state = Reshape(updated_flat.getOutput(), state_group_type);
 
         if (token + 1 != spec_.tokens_per_request) {
