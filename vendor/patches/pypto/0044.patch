+
+namespace pypto::runtime::nvidia {
+namespace {
+
+constexpr int kCudaComputeModeProhibited = 2;
+
+}  // namespace
+
+NvidiaRuntimeObservation::NvidiaRuntimeObservation(
+    compiler::NvidiaTargetInfo target_info, uint32_t cuda_driver_api_version,
+    uint32_t cuda_runtime_api_version,
+    std::string cuda_runtime_library_path, uintptr_t context_address,
+    uint64_t context_id)
+    : target_info_(std::move(target_info)),
+      cuda_driver_api_version_(cuda_driver_api_version),
+      cuda_runtime_api_version_(cuda_runtime_api_version),
+      cuda_runtime_library_path_(std::move(cuda_runtime_library_path)),
+      context_address_(context_address),
+      context_id_(context_id) {
+  if (cuda_driver_api_version_ == 0) {
+    throw ValueError("observed CUDA Driver API version must be positive");
+  }
+  if (cuda_runtime_api_version_ == 0) {
+    throw ValueError("observed CUDA Runtime API version must be positive");
+  }
+  if (context_address_ == 0) {
+    throw ValueError("observed CUDA context address must be non-null");
+  }
+  if (cuda_runtime_library_path_.empty() ||
+      !std::filesystem::path(cuda_runtime_library_path_).is_absolute()) {
+    throw ValueError(
+        "observed CUDA Runtime library path must be absolute");
+  }
+}
+
+namespace detail {
+
+NvidiaRuntimeObservation ObserveCurrentNvidiaRuntimeWithDriver(
+    std::string cuda_driver_version,
+    std::string expected_cuda_runtime_library_path,
+    const std::shared_ptr<NvidiaDriverApi>& driver) {
+  if (!driver) {
+    throw ValueError("NVIDIA runtime observation driver boundary must not be null");
+  }
+  if (cuda_driver_version.empty() ||
+      std::isspace(static_cast<unsigned char>(cuda_driver_version.front())) ||
+      std::isspace(static_cast<unsigned char>(cuda_driver_version.back()))) {
+    throw ValueError("cuda_driver_version must be non-empty and trimmed");
+  }
+  if (expected_cuda_runtime_library_path.empty() ||
+      !std::filesystem::path(expected_cuda_runtime_library_path)
+           .is_absolute()) {
+    throw ValueError(
+        "expected CUDA Runtime library path must be absolute");
+  }
+  driver->Initialize();
+  const uint32_t driver_api_version = driver->GetDriverApiVersion();
+  const NvidiaCudaRuntimeProperties runtime =
+      driver->GetLoadedCudaRuntimeProperties(
+          expected_cuda_runtime_library_path);
+  const uintptr_t context_address = driver->GetCurrentContext();
+  if (context_address == 0) {
+    throw RuntimeError(
+        "NVIDIA runtime observation requires a non-null current CUDA context");
+  }
+  const NvidiaStreamBinding binding = driver->GetCurrentContextBinding();
+  if (binding.green_context_address != 0 ||
+      binding.context_address != context_address) {
+    throw RuntimeError(
+        "NVIDIA runtime observation requires a regular current CUDA context");
+  }
+  const uint64_t context_id = driver->GetContextId(context_address);
+  const int device_ordinal =
+      driver->GetContextDeviceOrdinal(context_address);
+  const NvidiaDeviceProperties properties =
+      driver->GetDeviceProperties(device_ordinal);
+  if (properties.device_ordinal != device_ordinal) {
+    throw RuntimeError(
+        "CUDA device properties ordinal differs from the current context");
+  }
+  if (properties.compute_mode == kCudaComputeModeProhibited) {
+    throw RuntimeError("current NVIDIA device is in prohibited compute mode");
+  }
+  if (properties.compute_mode < 0 || properties.compute_mode > 3) {
+    throw RuntimeError("CUDA Driver returned an invalid compute mode");
+  }
+
+  const compiler::NvidiaBackendBuildInfo build_info =
+      compiler::GetNvidiaBackendBuildInfo();
+  if (!build_info.IsCompiled()) {
+    throw RuntimeError(
+        "NVIDIA runtime observation requires a backend-ON PyPTO product");
+  }
+  compiler::TargetTraits traits(
+      properties.compute_capability, properties.multiprocessor_count,
+      properties.warp_size, properties.max_threads_per_block,
+      properties.max_threads_per_multiprocessor,
+      properties.max_blocks_per_multiprocessor, properties.max_block_dim_x,
+      properties.max_block_dim_y, properties.max_block_dim_z,
+      properties.max_grid_dim_x, properties.max_grid_dim_y,
+      properties.max_grid_dim_z, properties.l1_cache_line_bytes,
+      properties.default_shared_memory_per_cta_bytes,
+      properties.max_shared_memory_per_cta_bytes,
+      properties.shared_memory_per_multiprocessor_bytes,
+      properties.registers_per_cta, properties.max_registers_per_thread,
+      properties.registers_per_multiprocessor,
+      properties.l2_cache_size_bytes, properties.total_global_memory_bytes);
+  compiler::NvidiaTargetInfo target_info(
+      device_ordinal, properties.name, properties.uuid,
+      properties.pci_device_id, std::move(traits),
+      build_info.GetCudaToolkitVersion(), std::move(cuda_driver_version),
+      build_info.GetTensorIrRevision(), build_info.GetCudaTileRevision(),
+      {DataType::BF16, DataType::FP32});
+  return NvidiaRuntimeObservation(
+      std::move(target_info), driver_api_version, runtime.api_version,
+      runtime.library_path, context_address, context_id);
+}
+
+}  // namespace detail
+
+NvidiaRuntimeObservation ObserveCurrentNvidiaRuntime(
+    std::string cuda_driver_version,
+    std::string expected_cuda_runtime_library_path) {
+  return detail::ObserveCurrentNvidiaRuntimeWithDriver(
+      std::move(cuda_driver_version),
+      std::move(expected_cuda_runtime_library_path),
+      detail::GetProductionNvidiaDriver());
+}
+
+}  // namespace pypto::runtime::nvidia
