+#ifndef PYPTO_RUNTIME_NVIDIA_OBSERVATION_H_
+#define PYPTO_RUNTIME_NVIDIA_OBSERVATION_H_
+
+#include <cstdint>
+#include <string>
+
+#include "pypto/compiler/target_info.h"
+
+namespace pypto::runtime::nvidia {
+
+/**
+ * Immutable parent-process observation of one regular current NVIDIA context.
+ *
+ * This value contains no CUDA handle ownership.  The context address and ID
+ * are diagnostic identity only; NvidiaExecutable independently re-observes and
+ * binds the current context during prewarm.
+ */
+class NvidiaRuntimeObservation {
+ public:
+  NvidiaRuntimeObservation(compiler::NvidiaTargetInfo target_info,
+                           uint32_t cuda_driver_api_version,
+                           uint32_t cuda_runtime_api_version,
+                           std::string cuda_runtime_library_path,
+                           uintptr_t context_address, uint64_t context_id);
+  NvidiaRuntimeObservation(const NvidiaRuntimeObservation&) = default;
+  NvidiaRuntimeObservation(NvidiaRuntimeObservation&&) = default;
+  NvidiaRuntimeObservation& operator=(const NvidiaRuntimeObservation&) = delete;
+  NvidiaRuntimeObservation& operator=(NvidiaRuntimeObservation&&) = delete;
+
+  [[nodiscard]] const compiler::NvidiaTargetInfo& GetTargetInfo() const noexcept {
+    return target_info_;
+  }
+  [[nodiscard]] uint32_t GetCudaDriverApiVersion() const noexcept {
+    return cuda_driver_api_version_;
+  }
+  [[nodiscard]] uint32_t GetCudaRuntimeApiVersion() const noexcept {
+    return cuda_runtime_api_version_;
+  }
+  [[nodiscard]] const std::string& GetCudaRuntimeLibraryPath() const noexcept {
+    return cuda_runtime_library_path_;
+  }
+  [[nodiscard]] uintptr_t GetContextAddress() const noexcept {
+    return context_address_;
+  }
+  [[nodiscard]] uint64_t GetContextId() const noexcept { return context_id_; }
+
+ private:
+  compiler::NvidiaTargetInfo target_info_;
+  uint32_t cuda_driver_api_version_;
+  uint32_t cuda_runtime_api_version_;
+  std::string cuda_runtime_library_path_;
+  uintptr_t context_address_;
+  uint64_t context_id_;
+};
+
+/**
+ * Observe the caller's current regular CUDA context without retaining it.
+ *
+ * The CUDA Runtime must already be loaded by the parent framework.  PyPTO
+ * resolves cudaRuntimeGetVersion only from the process-global symbol table,
+ * verifies its dladdr provider against expected_cuda_runtime_library_path, and
+ * never opens a libcudart soname.  cuda_driver_version is a caller-provided
+ * release/provenance label; the numeric Driver API version is observed
+ * independently and returned in NvidiaRuntimeObservation.  A fork child must
+ * use spawn/exec before calling this function.
+ */
+[[nodiscard]] NvidiaRuntimeObservation ObserveCurrentNvidiaRuntime(
+    std::string cuda_driver_version,
+    std::string expected_cuda_runtime_library_path);
+
+}  // namespace pypto::runtime::nvidia
+
+#endif  // PYPTO_RUNTIME_NVIDIA_OBSERVATION_H_
