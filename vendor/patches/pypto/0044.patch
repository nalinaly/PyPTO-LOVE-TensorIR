+  [[nodiscard]] NvidiaCudaRuntimeProperties GetLoadedCudaRuntimeProperties(
+      const std::string& expected_library_path) override {
+    RequireCallable();
+    (void)::dlerror();
+    void* address = ::dlsym(RTLD_DEFAULT, "cudaRuntimeGetVersion");
+    const char* lookup_error = ::dlerror();
+    if (lookup_error != nullptr || address == nullptr) {
+      throw RuntimeError(BoundText(
+          std::string("cudaRuntimeGetVersion is not present in the process-global symbol table: ") +
+          CopyBoundedCString(lookup_error)));
+    }
+    Dl_info provider{};
+    if (::dladdr(address, &provider) == 0 || provider.dli_fname == nullptr) {
+      throw RuntimeError(
+          "dladdr could not identify the cudaRuntimeGetVersion provider");
+    }
+    return ValidateLoadedCudaRuntime(
+        FunctionFromAddress<CudaRuntimeGetVersionFunction>(address),
+        provider.dli_fname, expected_library_path);
+  }
+
   [[nodiscard]] uintptr_t GetCurrentContext() override {
     RequireCallable();
     CUcontext context = nullptr;
@@ -747,6 +791,36 @@ class DynamicNvidiaDriver final : public NvidiaDriverApi {
 
 }  // namespace
 
+NvidiaCudaRuntimeProperties ValidateLoadedCudaRuntime(
+    CudaRuntimeGetVersionFunction get_version,
+    const std::string& provider_library_path,
+    const std::string& expected_library_path) {
+  if (get_version == nullptr) {
+    throw RuntimeError("cudaRuntimeGetVersion function pointer is null");
+  }
+  const std::string provider = CanonicalRuntimeLibraryPath(
+      provider_library_path, "cudaRuntimeGetVersion provider");
+  const std::string expected = CanonicalRuntimeLibraryPath(
+      expected_library_path, "expected CUDA Runtime library");
+  if (provider != expected) {
+    throw RuntimeError(
+        "cudaRuntimeGetVersion provider differs from the expected CUDA Runtime library");
+  }
+  int version = 0;
+  const int status = get_version(&version);
+  if (status != 0) {
+    throw RuntimeError("cudaRuntimeGetVersion failed with CUDA Runtime status " +
+                       std::to_string(status));
+  }
+  if (version <= 0) {
+    throw RuntimeError(
+        "cudaRuntimeGetVersion returned a non-positive API version");
+  }
+  return NvidiaCudaRuntimeProperties{static_cast<uint32_t>(version), provider};
+}
