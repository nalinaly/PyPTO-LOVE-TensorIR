+[[nodiscard]] std::string CanonicalRuntimeLibraryPath(
+    const std::string& path, const char* description) {
+  constexpr size_t kMaximumPathBytes = 4096;
+  if (path.empty() || path.size() > kMaximumPathBytes ||
+      !std::filesystem::path(path).is_absolute()) {
+    throw RuntimeError(std::string(description) +
+                       " must be a bounded absolute path");
+  }
+  try {
+    const std::filesystem::path canonical =
+        std::filesystem::canonical(path);
+    if (!std::filesystem::is_regular_file(canonical)) {
+      throw RuntimeError(std::string(description) +
+                         " is not a regular file");
+    }
+    return canonical.string();
+  } catch (const std::filesystem::filesystem_error& error) {
+    throw RuntimeError(BoundText(std::string("cannot resolve ") + description +
+                                 ": " + error.what()));
+  }
+}
