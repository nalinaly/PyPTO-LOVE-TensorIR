+bool IsNativeTileGatherRowsCandidate(const ir::ProgramPtr& program) {
+  if (!program || program->functions_.size() != 1) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (!function || function->params_.size() != 3) return false;
+  const auto indicesType =
+      ir::As<ir::TensorType>(function->params_[1]->GetType());
+  return indicesType && (indicesType->dtype_ == DataType::INT64 ||
+                         indicesType->dtype_ == DataType::INT32);
+}
+
+NativeTileGatherRowsGraph AnalyzeNativeTileGatherRows(
+    const ir::ProgramPtr& program) {
+  if (!IsNativeTileGatherRowsCandidate(program)) {
+    Reject("native gather_rows candidate is malformed",
+           program ? &program->span_ : nullptr);
+  }
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() ||
+      *function->role_ != ir::Role::Orchestrator || !function->attrs_.empty()) {
+    Reject("native gather_rows must be one canonical CHIP @pl.jit function",
+           &function->span_);
+  }
+  if (function->param_directions_.size() != 3 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native gather_rows requires two inputs, one output and one return",
+           &function->span_);
+  }
+
+  const StaticTensor data = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native gather_rows data");
+  StaticTensor indices = ReadStaticIntegerTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native gather_rows indices");
+  const StaticTensor result = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native gather_rows output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_,
+      "native gather_rows declared result");
+  if (data.shape.size() != 2 || indices.shape.size() != 2 ||
+      result.shape.size() != 2 || !SameTensor(result, declared) ||
+      indices.shape != result.shape || data.shape[1] != result.shape[1]) {
+    Reject("native gather_rows data, indices and output shapes are incompatible",
+           &function->span_);
+  }
+  indices.dense_strides = {1, 0};
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2) {
+    Reject("native gather_rows body must contain one scope and one return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  const auto returnedVar =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!scope || scope->split_ != ir::SplitMode::None ||
+      !scope->attrs_.empty() || !returnedVar ||
+      returnedVar.get() != function->params_[2].get()) {
+    Reject("native gather_rows scope or return is invalid", &function->span_);
+  }
+
+  const TileLoopNest loopNest = UnwrapStaticTileLoops(scope->body_);
+  if (!loopNest.leaf || loopNest.leaf->stmts_.size() != 3) {
+    Reject("native gather_rows tile body must be read, load and store",
+           &scope->span_);
+  }
+  const auto readAssignment =
+      ir::As<ir::AssignStmt>(loopNest.leaf->stmts_[0]);
+  const auto readCall =
+      readAssignment ? ir::As<ir::Call>(readAssignment->value_) : nullptr;
+  const auto readSource =
+      readCall && !readCall->args_.empty()
+          ? ir::As<ir::Var>(readCall->args_[0])
+          : nullptr;
+  const auto loadAssignment =
+      ir::As<ir::AssignStmt>(loopNest.leaf->stmts_[1]);
+  const auto loadCall =
+      loadAssignment ? ir::As<ir::Call>(loadAssignment->value_) : nullptr;
+  const auto loadSource =
+      loadCall && !loadCall->args_.empty()
+          ? ir::As<ir::Var>(loadCall->args_[0])
+          : nullptr;
+  const auto storeStatement =
+      ir::As<ir::EvalStmt>(loopNest.leaf->stmts_[2]);
+  const auto storeCall =
+      storeStatement ? ir::As<ir::Call>(storeStatement->expr_) : nullptr;
+  const auto storeTarget =
+      storeCall && storeCall->args_.size() == 3
+          ? ir::As<ir::Var>(storeCall->args_[2])
+          : nullptr;
+  if (!readCall || !ir::IsOp(readCall, "tensor.read") || !readSource ||
+      readSource.get() != function->params_[1].get() || !loadCall ||
+      !ir::IsOp(loadCall, "tile.load") || !loadSource ||
+      loadSource.get() != function->params_[0].get() || !storeCall ||
+      !ir::IsOp(storeCall, "tile.store") || !storeTarget ||
+      storeTarget.get() != function->params_[2].get()) {
+    Reject("native gather_rows operation sequence is invalid",
+           &loopNest.leaf->span_);
+  }
+  const StaticTensor loaded = ReadStaticTile(
+      loadAssignment->var_->GetType(), loadAssignment->span_,
+      "native gather_rows loaded tile");
+  if (loaded.dtype != result.dtype || loaded.shape.size() != 2 ||
+      loaded.shape[0] != 1 || loaded.shape[1] <= 0 ||
+      result.shape[1] % loaded.shape[1] != 0 ||
+      StaticElementCount(loaded, loadAssignment->span_,
+                         "native gather_rows tile") *
+              loopNest.repetitions !=
+          StaticElementCount(result, function->span_,
+                             "native gather_rows result")) {
+    Reject("native gather_rows loops must cover the result exactly once",
+           &scope->span_);
+  }
+  return NativeTileGatherRowsGraph{data, indices, result};
+}
