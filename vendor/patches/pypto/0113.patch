+std::string EmitNativeTileGatherRowsSource(
+    const NativeTileGatherRowsGraph& graph) {
+  StaticTensor indices32 = graph.indices;
+  indices32.dtype = DataType::INT32;
+  const std::string dataType = TensorTypeText(graph.data);
+  const std::string dataWithStride = TensorWithStrideText(graph.data);
+  const std::string indicesType = TensorTypeText(graph.indices);
+  const std::string indicesWithStride = TensorWithStrideText(graph.indices);
+  const std::string indices32Type = TensorTypeText(indices32);
+  const std::string resultType = TensorTypeText(graph.result);
+  const std::string resultWithStride = TensorWithStrideText(graph.result);
+  std::string source;
+  source.reserve(768 + dataWithStride.size() + indicesWithStride.size() +
+                 resultWithStride.size());
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += dataWithStride;
+  source += ",\n    %arg1: ";
+  source += indicesWithStride;
+  source += "\n  ) -> (";
+  source += resultWithStride;
+  source += ") {\n    %indices32 = convert %arg1 : ";
+  source += indicesType;
+  source += " -> ";
+  source += indices32Type;
+  source += "\n    %result0 = gather_rows %arg0, %indices32 : (";
+  source += dataType;
+  source += ", ";
+  source += indices32Type;
+  source += ") -> ";
+  source += resultType;
+  source += "\n    results %result0 : ";
+  source += resultType;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
