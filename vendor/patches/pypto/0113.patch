+@pl.jit
+def _native_tile_embedding(
+    weight: pl.Tensor[[1024, 256], pl.BF16],
+    repeated_token_ids: pl.Tensor[[8, 256], pl.INT64],
+    out: pl.Out[pl.Tensor[[8, 256], pl.BF16]],
