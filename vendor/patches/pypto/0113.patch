+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Input, 1, graph.indices.dtype,
+        graph.indices.shape, graph.indices.dense_strides,
+        /*has_explicit_strides=*/true));
+    metadata.push_back(TensorIrValueMetadata(
+        TensorIrValueRole::Result, 0, graph.result.dtype,
+        graph.result.shape, graph.result.dense_strides,
+        /*has_explicit_strides=*/true));
+    return TensorIrModule(TensorIrModuleKind::FusedPointwise,
+                          EmitNativeTileGatherRowsSource(graph),
+                          std::move(metadata), /*input_count=*/2);
+  }
   if (IsNativeTileRowReductionCandidate(program)) {
     const RowReductionGraph graph = AnalyzeNativeTileRowReduction(program);
     std::vector<TensorIrValueMetadata> metadata;
