+
+#ifndef PYPTO_COMPILER_KERNEL_BUILD_SPEC_H_
+#define PYPTO_COMPILER_KERNEL_BUILD_SPEC_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace pypto::compiler {
+
+/** Semantic lowering route selected independently for each compiled region. */
+enum class SemanticRoute : uint8_t {
+  GenericDirect = 0,
+  StructuredTensorIr = 1,
+  ServingDirect = 2,
+};
+
+/** Scalar type used by a canonical resolved-schedule parameter. */
+enum class ScheduleValueKind : uint8_t {
+  Boolean = 0,
+  SignedInteger = 1,
+  UnsignedInteger = 2,
+  Text = 3,
+};
+
+/**
+ * One immutable scalar in a resolved schedule category.
+ *
+ * Names are canonical lowercase dotted identifiers. Values use a type-specific
+ * canonical spelling so the same semantic value has exactly one representation.
+ */
+class ScheduleParameter {
+ public:
+  ScheduleParameter() = delete;
+  ScheduleParameter(std::string name, ScheduleValueKind value_kind, std::string canonical_value);
+  ScheduleParameter(const ScheduleParameter&) = default;
+  ScheduleParameter(ScheduleParameter&&) = default;
+  ScheduleParameter& operator=(const ScheduleParameter&) = delete;
+  ScheduleParameter& operator=(ScheduleParameter&&) = delete;
+
+  [[nodiscard]] const std::string& GetName() const noexcept { return name_; }
+  [[nodiscard]] ScheduleValueKind GetValueKind() const noexcept { return value_kind_; }
+  [[nodiscard]] const std::string& GetCanonicalValue() const noexcept { return canonical_value_; }
+
+ private:
+  std::string name_;
+  ScheduleValueKind value_kind_;
+  std::string canonical_value_;
+};
+
+/**
+ * Complete generic resolved schedule representation.
+ *
+ * Every category is explicit. Each vector must be strictly ordered by parameter
+ * name; an empty vector means that category is explicitly inapplicable, never
+ * that a producer may consult an ambient default.
+ */
+class CanonicalSchedule {
+ public:
+  CanonicalSchedule() = delete;
+  CanonicalSchedule(std::vector<ScheduleParameter> schedule, std::vector<ScheduleParameter> tile,
+                    std::vector<ScheduleParameter> layout, std::vector<ScheduleParameter> persistence,
+                    std::vector<ScheduleParameter> cta, std::vector<ScheduleParameter> warp,
+                    std::vector<ScheduleParameter> stage, std::vector<ScheduleParameter> options);
+  CanonicalSchedule(const CanonicalSchedule&) = default;
+  CanonicalSchedule(CanonicalSchedule&&) = default;
+  CanonicalSchedule& operator=(const CanonicalSchedule&) = delete;
+  CanonicalSchedule& operator=(CanonicalSchedule&&) = delete;
+
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetSchedule() const noexcept { return schedule_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetTile() const noexcept { return tile_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetLayout() const noexcept { return layout_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetPersistence() const noexcept { return persistence_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetCta() const noexcept { return cta_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetWarp() const noexcept { return warp_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetStage() const noexcept { return stage_; }
+  [[nodiscard]] const std::vector<ScheduleParameter>& GetOptions() const noexcept { return options_; }
+
+ private:
+  std::vector<ScheduleParameter> schedule_;
+  std::vector<ScheduleParameter> tile_;
+  std::vector<ScheduleParameter> layout_;
+  std::vector<ScheduleParameter> persistence_;
+  std::vector<ScheduleParameter> cta_;
+  std::vector<ScheduleParameter> warp_;
+  std::vector<ScheduleParameter> stage_;
+  std::vector<ScheduleParameter> options_;
+};
+
+/** Optional all-or-none identity of an operator-catalog selection. */
+class CatalogProvenance {
+ public:
+  CatalogProvenance() = delete;
+  CatalogProvenance(std::string operator_digest, std::string problem_digest, std::string schedule_digest);
+  CatalogProvenance(const CatalogProvenance&) = default;
+  CatalogProvenance(CatalogProvenance&&) = default;
+  CatalogProvenance& operator=(const CatalogProvenance&) = delete;
+  CatalogProvenance& operator=(CatalogProvenance&&) = delete;
+
+  [[nodiscard]] const std::string& GetOperatorDigest() const noexcept { return operator_digest_; }
+  [[nodiscard]] const std::string& GetProblemDigest() const noexcept { return problem_digest_; }
+  [[nodiscard]] const std::string& GetScheduleDigest() const noexcept { return schedule_digest_; }
+
+ private:
+  std::string operator_digest_;
+  std::string problem_digest_;
+  std::string schedule_digest_;
+};
+
+/** Immutable, pointer-free per-region KernelBuildSpec v1. */
+class KernelBuildSpec {
+ public:
+  static constexpr uint32_t kBuildSpecSchemaVersion = 1;
+
+  KernelBuildSpec() = delete;
+  KernelBuildSpec(std::string source_ir_digest, std::string callable_abi_digest, SemanticRoute semantic_route,
+                  std::string pipeline_revision, CanonicalSchedule resolved_schedule,
+                  std::string static_specialization_digest, std::string symbolic_specialization_digest,
+                  std::string argument_abi_digest, std::string result_abi_digest,
+                  std::string mutation_abi_digest, std::string compile_request_byte_identity_digest,
+                  std::optional<CatalogProvenance> catalog_provenance = std::nullopt);
+  KernelBuildSpec(const KernelBuildSpec&) = default;
+  KernelBuildSpec(KernelBuildSpec&&) = default;
+  KernelBuildSpec& operator=(const KernelBuildSpec&) = delete;
+  KernelBuildSpec& operator=(KernelBuildSpec&&) = delete;
+
+  [[nodiscard]] constexpr uint32_t GetBuildSpecSchemaVersion() const noexcept {
+    return kBuildSpecSchemaVersion;
+  }
+  [[nodiscard]] const std::string& GetSourceIrDigest() const noexcept { return source_ir_digest_; }
+  [[nodiscard]] const std::string& GetCallableAbiDigest() const noexcept { return callable_abi_digest_; }
+  [[nodiscard]] SemanticRoute GetSemanticRoute() const noexcept { return semantic_route_; }
+  [[nodiscard]] const std::string& GetPipelineRevision() const noexcept { return pipeline_revision_; }
+  [[nodiscard]] const CanonicalSchedule& GetResolvedSchedule() const noexcept { return resolved_schedule_; }
+  [[nodiscard]] const std::string& GetStaticSpecializationDigest() const noexcept {
+    return static_specialization_digest_;
+  }
+  [[nodiscard]] const std::string& GetSymbolicSpecializationDigest() const noexcept {
+    return symbolic_specialization_digest_;
+  }
+  [[nodiscard]] const std::string& GetArgumentAbiDigest() const noexcept { return argument_abi_digest_; }
+  [[nodiscard]] const std::string& GetResultAbiDigest() const noexcept { return result_abi_digest_; }
+  [[nodiscard]] const std::string& GetMutationAbiDigest() const noexcept { return mutation_abi_digest_; }
+  [[nodiscard]] const std::string& GetCompileRequestByteIdentityDigest() const noexcept {
+    return compile_request_byte_identity_digest_;
+  }
+  [[nodiscard]] const std::optional<CatalogProvenance>& GetCatalogProvenance() const noexcept {
+    return catalog_provenance_;
+  }
+
+  /** Serialize the complete build specification as canonical MessagePack. */
+  [[nodiscard]] std::vector<uint8_t> SerializeCanonical() const;
+
+  /** Deserialize canonical MessagePack, rejecting malformed, noncanonical, and unknown data. */
+  [[nodiscard]] static KernelBuildSpec DeserializeCanonical(const std::vector<uint8_t>& data);
+
+  /** Lowercase SHA-256 of the complete canonical KernelBuildSpec v1 payload. */
+  [[nodiscard]] std::string GetIdentityDigest() const;
+
+ private:
+  std::string source_ir_digest_;
+  std::string callable_abi_digest_;
+  SemanticRoute semantic_route_;
+  std::string pipeline_revision_;
+  CanonicalSchedule resolved_schedule_;
+  std::string static_specialization_digest_;
+  std::string symbolic_specialization_digest_;
+  std::string argument_abi_digest_;
+  std::string result_abi_digest_;
+  std::string mutation_abi_digest_;
+  std::string compile_request_byte_identity_digest_;
+  std::optional<CatalogProvenance> catalog_provenance_;
+};
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_KERNEL_BUILD_SPEC_H_
