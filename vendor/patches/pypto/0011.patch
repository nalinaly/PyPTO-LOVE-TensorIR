+using CanonicalPacker = msgpack::packer<msgpack::sbuffer>;
+
+constexpr std::string_view kKernelBuildSpecContract = "pypto.kernel_build_spec.v1";
+constexpr size_t kMaximumSerializedBuildSpecBytes = 1024 * 1024;
+constexpr size_t kMaximumScheduleParametersPerCategory = 128;
+constexpr size_t kMaximumMapItems = 32;
+constexpr size_t kMaximumStringBytes = 64 * 1024;
+constexpr size_t kMaximumNestingDepth = 8;
+constexpr size_t kMaximumParameterNameBytes = 128;
+constexpr size_t kMaximumParameterTextBytes = 4096;
+
+void RequireSha256(const std::string& value, const std::string& field_name) {
+  if (value.size() != 64 || !std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+      })) {
+    throw ValueError(field_name + " must be a 64-character lowercase hexadecimal SHA-256");
+  }
+}
+
+void RequireFullRevision(const std::string& value, const std::string& field_name) {
+  if (value.size() != 40 || !std::all_of(value.begin(), value.end(), [](unsigned char character) {
+        return (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+      })) {
+    throw ValueError(field_name + " must be a full 40-character lowercase hexadecimal revision");
+  }
+}
+
+void RequireParameterName(const std::string& value) {
+  if (value.empty() || value.size() > kMaximumParameterNameBytes) {
+    throw ValueError("schedule parameter name must contain 1 to 128 bytes");
+  }
+  bool at_segment_start = true;
+  for (unsigned char character : value) {
+    if (character == '.') {
+      if (at_segment_start) {
+        throw ValueError("schedule parameter name must be a canonical lowercase dotted identifier");
+      }
+      at_segment_start = true;
+      continue;
+    }
+    if (at_segment_start) {
+      if (character < 'a' || character > 'z') {
+        throw ValueError("schedule parameter name segments must begin with a lowercase ASCII letter");
+      }
+      at_segment_start = false;
+      continue;
+    }
+    const bool is_lowercase = character >= 'a' && character <= 'z';
+    const bool is_digit = character >= '0' && character <= '9';
+    if (!is_lowercase && !is_digit && character != '_') {
+      throw ValueError(
+          "schedule parameter name must contain only lowercase ASCII letters, digits, underscores, and dots");
+    }
+  }
+  if (at_segment_start) {
+    throw ValueError("schedule parameter name must not end with a dot");
+  }
+}
+
+void RequireCanonicalTextValue(const std::string& value) {
+  if (value.empty() || value.size() > kMaximumParameterTextBytes) {
+    throw ValueError("text schedule parameter value must contain 1 to 4096 bytes");
+  }
+  if (value.front() == ' ' || value.back() == ' ') {
+    throw ValueError("text schedule parameter value must be trimmed");
+  }
+  if (!std::all_of(value.begin(), value.end(),
+                   [](unsigned char character) { return character >= 0x20U && character <= 0x7eU; })) {
+    throw ValueError("text schedule parameter value must contain printable ASCII without control bytes");
+  }
+}
+
+int64_t ParseCanonicalSignedInteger(const std::string& value) {
+  int64_t parsed = 0;
+  const auto result = std::from_chars(value.data(), value.data() + value.size(), parsed);
+  if (result.ec != std::errc{} || result.ptr != value.data() + value.size() ||
+      std::to_string(parsed) != value) {
+    throw ValueError("signed-integer schedule value must be a canonical int64 decimal");
+  }
+  return parsed;
+}
+
+uint64_t ParseCanonicalUnsignedInteger(const std::string& value) {
+  uint64_t parsed = 0;
+  const auto result = std::from_chars(value.data(), value.data() + value.size(), parsed);
+  if (result.ec != std::errc{} || result.ptr != value.data() + value.size() ||
+      std::to_string(parsed) != value) {
+    throw ValueError("unsigned-integer schedule value must be a canonical uint64 decimal");
+  }
+  return parsed;
+}
+
+std::string_view SemanticRouteName(SemanticRoute route) {
+  switch (route) {
+    case SemanticRoute::GenericDirect:
+      return "generic-direct";
+    case SemanticRoute::StructuredTensorIr:
+      return "structured-tensorir";
+    case SemanticRoute::ServingDirect:
+      return "serving-direct";
+  }
+  throw ValueError("unsupported semantic_route value " + std::to_string(static_cast<unsigned int>(route)));
+}
+
+std::string_view ScheduleValueKindName(ScheduleValueKind value_kind) {
+  switch (value_kind) {
+    case ScheduleValueKind::Boolean:
+      return "boolean";
+    case ScheduleValueKind::SignedInteger:
+      return "signed-integer";
+    case ScheduleValueKind::UnsignedInteger:
+      return "unsigned-integer";
+    case ScheduleValueKind::Text:
+      return "text";
+  }
+  throw ValueError("unsupported schedule value_kind " +
+                   std::to_string(static_cast<unsigned int>(value_kind)));
+}
+
+void ValidateCanonicalValue(ScheduleValueKind value_kind, const std::string& canonical_value) {
+  switch (value_kind) {
+    case ScheduleValueKind::Boolean:
+      if (canonical_value != "false" && canonical_value != "true") {
+        throw ValueError("boolean schedule value must be exactly 'false' or 'true'");
+      }
+      return;
+    case ScheduleValueKind::SignedInteger:
+      (void)ParseCanonicalSignedInteger(canonical_value);
+      return;
+    case ScheduleValueKind::UnsignedInteger:
+      (void)ParseCanonicalUnsignedInteger(canonical_value);
+      return;
+    case ScheduleValueKind::Text:
+      RequireCanonicalTextValue(canonical_value);
+      return;
+  }
+  (void)ScheduleValueKindName(value_kind);
+}
+
+void ValidateParameterCategory(const std::vector<ScheduleParameter>& parameters,
+                               const std::string& category_name) {
+  if (parameters.size() > kMaximumScheduleParametersPerCategory) {
+    throw ValueError(category_name + " contains more than 128 schedule parameters");
+  }
+  for (size_t i = 1; i < parameters.size(); ++i) {
+    if (parameters[i - 1].GetName() >= parameters[i].GetName()) {
+      throw ValueError(category_name +
+                       " schedule parameters must be strictly ordered by unique canonical name");
+    }
+  }
+}
+
+void PackText(CanonicalPacker& packer, std::string_view value) {
+  packer.pack_str(static_cast<uint32_t>(value.size()));
+  packer.pack_str_body(value.data(), static_cast<uint32_t>(value.size()));
+}
+
+void PackKey(CanonicalPacker& packer, std::string_view key) { PackText(packer, key); }
+
+void PackScheduleParameter(CanonicalPacker& packer, const ScheduleParameter& parameter) {
+  packer.pack_map(3);
+  PackKey(packer, "kind");
+  PackText(packer, ScheduleValueKindName(parameter.GetValueKind()));
+  PackKey(packer, "name");
+  PackText(packer, parameter.GetName());
+  PackKey(packer, "value");
+  switch (parameter.GetValueKind()) {
+    case ScheduleValueKind::Boolean:
+      packer.pack(parameter.GetCanonicalValue() == "true");
+      return;
+    case ScheduleValueKind::SignedInteger:
+      packer.pack(ParseCanonicalSignedInteger(parameter.GetCanonicalValue()));
+      return;
+    case ScheduleValueKind::UnsignedInteger:
+      packer.pack(ParseCanonicalUnsignedInteger(parameter.GetCanonicalValue()));
+      return;
+    case ScheduleValueKind::Text:
+      PackText(packer, parameter.GetCanonicalValue());
+      return;
+  }
+  (void)ScheduleValueKindName(parameter.GetValueKind());
+}
+
+void PackParameterCategory(CanonicalPacker& packer, const std::vector<ScheduleParameter>& parameters) {
+  packer.pack_array(static_cast<uint32_t>(parameters.size()));
+  for (const auto& parameter : parameters) PackScheduleParameter(packer, parameter);
+}
+
+void PackResolvedSchedule(CanonicalPacker& packer, const CanonicalSchedule& schedule) {
+  packer.pack_map(8);
+  PackKey(packer, "cta");
+  PackParameterCategory(packer, schedule.GetCta());
+  PackKey(packer, "layout");
+  PackParameterCategory(packer, schedule.GetLayout());
+  PackKey(packer, "options");
+  PackParameterCategory(packer, schedule.GetOptions());
+  PackKey(packer, "persistence");
+  PackParameterCategory(packer, schedule.GetPersistence());
+  PackKey(packer, "schedule");
+  PackParameterCategory(packer, schedule.GetSchedule());
+  PackKey(packer, "stage");
+  PackParameterCategory(packer, schedule.GetStage());
+  PackKey(packer, "tile");
+  PackParameterCategory(packer, schedule.GetTile());
+  PackKey(packer, "warp");
+  PackParameterCategory(packer, schedule.GetWarp());
+}
+
+void PackCatalogProvenance(CanonicalPacker& packer,
+                           const std::optional<CatalogProvenance>& catalog_provenance) {
+  if (!catalog_provenance.has_value()) {
+    packer.pack_nil();
+    return;
+  }
+  packer.pack_map(3);
+  PackKey(packer, "operator_digest");
+  PackText(packer, catalog_provenance->GetOperatorDigest());
+  PackKey(packer, "problem_digest");
+  PackText(packer, catalog_provenance->GetProblemDigest());
+  PackKey(packer, "schedule_digest");
+  PackText(packer, catalog_provenance->GetScheduleDigest());
+}
+
+std::vector<uint8_t> FinishBuffer(const msgpack::sbuffer& buffer) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+class StrictMap {
+ public:
+  StrictMap(const msgpack::object& object, std::string context,
+            std::initializer_list<std::string_view> allowed_fields)
+      : context_(std::move(context)) {
+    if (object.type != msgpack::type::MAP) throw ValueError(context_ + " must be a map");
+    std::map<std::string, bool> allowed;
+    for (std::string_view field : allowed_fields) allowed.emplace(field, true);
+    for (uint32_t i = 0; i < object.via.map.size; ++i) {
+      const auto& entry = object.via.map.ptr[i];
+      if (entry.key.type != msgpack::type::STR) {
+        throw ValueError(context_ + " field names must be strings");
+      }
+      std::string key(entry.key.via.str.ptr, entry.key.via.str.size);
+      if (allowed.find(key) == allowed.end()) {
+        throw ValueError(context_ + " contains unknown field '" + key + "'");
+      }
+      if (!fields_.emplace(std::move(key), &entry.val).second) {
+        throw ValueError(context_ + " contains a duplicate field");
+      }
+    }
+  }
+
+  [[nodiscard]] const msgpack::object& Get(const std::string& field) const {
+    const auto iterator = fields_.find(field);
+    if (iterator == fields_.end()) throw ValueError(context_ + " is missing required field '" + field + "'");
+    return *iterator->second;
+  }
+
+ private:
+  std::string context_;
+  std::map<std::string, const msgpack::object*> fields_;
+};
+
+std::string ReadText(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::STR) throw ValueError(context + " must be a string");
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+uint64_t ReadUint64(const msgpack::object& object, const std::string& context) {
+  if (object.type != msgpack::type::POSITIVE_INTEGER) {
+    throw ValueError(context + " must be an unsigned integer");
+  }
+  return object.via.u64;
+}
+
+uint32_t ReadUint32(const msgpack::object& object, const std::string& context) {
+  const uint64_t value = ReadUint64(object, context);
+  if (value > std::numeric_limits<uint32_t>::max()) throw ValueError(context + " exceeds uint32 range");
+  return static_cast<uint32_t>(value);
+}
+
+ScheduleValueKind ParseScheduleValueKind(const msgpack::object& object) {
+  const std::string value = ReadText(object, "resolved_schedule parameter kind");
+  if (value == "boolean") return ScheduleValueKind::Boolean;
+  if (value == "signed-integer") return ScheduleValueKind::SignedInteger;
+  if (value == "unsigned-integer") return ScheduleValueKind::UnsignedInteger;
+  if (value == "text") return ScheduleValueKind::Text;
+  throw ValueError("unsupported resolved_schedule parameter kind '" + value + "'");
+}
+
+std::string ParseCanonicalValue(const msgpack::object& object, ScheduleValueKind value_kind) {
+  switch (value_kind) {
+    case ScheduleValueKind::Boolean:
+      if (object.type != msgpack::type::BOOLEAN) {
+        throw ValueError("boolean schedule parameter value must be a MessagePack boolean");
+      }
+      return object.via.boolean ? "true" : "false";
+    case ScheduleValueKind::SignedInteger:
+      if (object.type == msgpack::type::NEGATIVE_INTEGER) return std::to_string(object.via.i64);
+      if (object.type == msgpack::type::POSITIVE_INTEGER &&
+          object.via.u64 <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+        return std::to_string(object.via.u64);
+      }
+      throw ValueError("signed-integer schedule parameter value must fit int64");
+    case ScheduleValueKind::UnsignedInteger:
+      if (object.type != msgpack::type::POSITIVE_INTEGER) {
+        throw ValueError("unsigned-integer schedule parameter value must be nonnegative");
+      }
+      return std::to_string(object.via.u64);
+    case ScheduleValueKind::Text:
+      return ReadText(object, "text schedule parameter value");
+  }
+  (void)ScheduleValueKindName(value_kind);
+  return {};
+}
+
+ScheduleParameter ParseScheduleParameter(const msgpack::object& object) {
+  StrictMap fields(object, "KernelBuildSpec.resolved_schedule parameter", {"kind", "name", "value"});
+  const ScheduleValueKind value_kind = ParseScheduleValueKind(fields.Get("kind"));
+  return ScheduleParameter(ReadText(fields.Get("name"), "resolved_schedule parameter name"), value_kind,
+                           ParseCanonicalValue(fields.Get("value"), value_kind));
+}
+
+std::vector<ScheduleParameter> ParseParameterCategory(const msgpack::object& object,
+                                                      const std::string& category_name) {
+  if (object.type != msgpack::type::ARRAY) {
+    throw ValueError("KernelBuildSpec.resolved_schedule." + category_name + " must be an array");
+  }
+  if (object.via.array.size > kMaximumScheduleParametersPerCategory) {
+    throw ValueError("KernelBuildSpec.resolved_schedule." + category_name +
+                     " contains more than 128 parameters");
+  }
+  std::vector<ScheduleParameter> parameters;
+  parameters.reserve(object.via.array.size);
+  for (uint32_t i = 0; i < object.via.array.size; ++i) {
+    parameters.push_back(ParseScheduleParameter(object.via.array.ptr[i]));
+  }
+  return parameters;
+}
+
+CanonicalSchedule ParseResolvedSchedule(const msgpack::object& object) {
+  StrictMap fields(object, "KernelBuildSpec.resolved_schedule",
+                   {"cta", "layout", "options", "persistence", "schedule", "stage", "tile", "warp"});
+  return CanonicalSchedule(ParseParameterCategory(fields.Get("schedule"), "schedule"),
+                           ParseParameterCategory(fields.Get("tile"), "tile"),
+                           ParseParameterCategory(fields.Get("layout"), "layout"),
+                           ParseParameterCategory(fields.Get("persistence"), "persistence"),
+                           ParseParameterCategory(fields.Get("cta"), "cta"),
+                           ParseParameterCategory(fields.Get("warp"), "warp"),
+                           ParseParameterCategory(fields.Get("stage"), "stage"),
+                           ParseParameterCategory(fields.Get("options"), "options"));
+}
+
+std::optional<CatalogProvenance> ParseCatalogProvenance(const msgpack::object& object) {
+  if (object.type == msgpack::type::NIL) return std::nullopt;
+  StrictMap fields(object, "KernelBuildSpec.catalog_provenance",
+                   {"operator_digest", "problem_digest", "schedule_digest"});
+  return CatalogProvenance(ReadText(fields.Get("operator_digest"), "catalog_provenance.operator_digest"),
+                           ReadText(fields.Get("problem_digest"), "catalog_provenance.problem_digest"),
+                           ReadText(fields.Get("schedule_digest"), "catalog_provenance.schedule_digest"));
+}
+
+SemanticRoute ParseSemanticRoute(const msgpack::object& object) {
+  const std::string value = ReadText(object, "semantic_route");
+  if (value == "generic-direct") return SemanticRoute::GenericDirect;
+  if (value == "structured-tensorir") return SemanticRoute::StructuredTensorIr;
+  if (value == "serving-direct") return SemanticRoute::ServingDirect;
+  throw ValueError("unsupported semantic_route '" + value + "'");
+}
+
+msgpack::object_handle UnpackOne(const std::vector<uint8_t>& data) {
+  if (data.empty()) throw ValueError("KernelBuildSpec payload must not be empty");
+  if (data.size() > kMaximumSerializedBuildSpecBytes) {
+    throw ValueError("KernelBuildSpec payload exceeds the 1 MiB v1 limit");
+  }
+  size_t offset = 0;
+  const msgpack::unpack_limit limits(kMaximumScheduleParametersPerCategory, kMaximumMapItems,
+                                     kMaximumStringBytes, 0, 0, kMaximumNestingDepth);
+  msgpack::object_handle handle = [&]() {
+    try {
+      return msgpack::unpack(reinterpret_cast<const char*>(data.data()), data.size(), offset, nullptr,
+                             nullptr, limits);
+    } catch (const msgpack::unpack_error& error) {
+      throw ValueError("malformed KernelBuildSpec MessagePack: " + std::string(error.what()));
+    }
+  }();
+  if (offset != data.size()) throw ValueError("KernelBuildSpec payload contains trailing bytes");
+  return handle;
+}
+
+}  // namespace
+
+ScheduleParameter::ScheduleParameter(std::string name, ScheduleValueKind value_kind,
+                                     std::string canonical_value)
+    : name_(std::move(name)), value_kind_(value_kind), canonical_value_(std::move(canonical_value)) {
+  RequireParameterName(name_);
+  ValidateCanonicalValue(value_kind_, canonical_value_);
+}
+
+CanonicalSchedule::CanonicalSchedule(std::vector<ScheduleParameter> schedule,
+                                     std::vector<ScheduleParameter> tile,
+                                     std::vector<ScheduleParameter> layout,
+                                     std::vector<ScheduleParameter> persistence,
+                                     std::vector<ScheduleParameter> cta, std::vector<ScheduleParameter> warp,
+                                     std::vector<ScheduleParameter> stage,
+                                     std::vector<ScheduleParameter> options)
+    : schedule_(std::move(schedule)),
+      tile_(std::move(tile)),
+      layout_(std::move(layout)),
+      persistence_(std::move(persistence)),
+      cta_(std::move(cta)),
+      warp_(std::move(warp)),
+      stage_(std::move(stage)),
+      options_(std::move(options)) {
+  ValidateParameterCategory(schedule_, "schedule");
+  ValidateParameterCategory(tile_, "tile");
+  ValidateParameterCategory(layout_, "layout");
+  ValidateParameterCategory(persistence_, "persistence");
+  ValidateParameterCategory(cta_, "cta");
+  ValidateParameterCategory(warp_, "warp");
+  ValidateParameterCategory(stage_, "stage");
+  ValidateParameterCategory(options_, "options");
+}
+
+CatalogProvenance::CatalogProvenance(std::string operator_digest, std::string problem_digest,
+                                     std::string schedule_digest)
+    : operator_digest_(std::move(operator_digest)),
+      problem_digest_(std::move(problem_digest)),
+      schedule_digest_(std::move(schedule_digest)) {
+  RequireSha256(operator_digest_, "catalog_provenance.operator_digest");
+  RequireSha256(problem_digest_, "catalog_provenance.problem_digest");
+  RequireSha256(schedule_digest_, "catalog_provenance.schedule_digest");
+}
+
+KernelBuildSpec::KernelBuildSpec(std::string source_ir_digest, std::string callable_abi_digest,
+                                 SemanticRoute semantic_route, std::string pipeline_revision,
+                                 CanonicalSchedule resolved_schedule,
+                                 std::string static_specialization_digest,
+                                 std::string symbolic_specialization_digest, std::string argument_abi_digest,
+                                 std::string result_abi_digest, std::string mutation_abi_digest,
+                                 std::string compile_request_byte_identity_digest,
+                                 std::optional<CatalogProvenance> catalog_provenance)
+    : source_ir_digest_(std::move(source_ir_digest)),
+      callable_abi_digest_(std::move(callable_abi_digest)),
+      semantic_route_(semantic_route),
+      pipeline_revision_(std::move(pipeline_revision)),
+      resolved_schedule_(std::move(resolved_schedule)),
+      static_specialization_digest_(std::move(static_specialization_digest)),
+      symbolic_specialization_digest_(std::move(symbolic_specialization_digest)),
+      argument_abi_digest_(std::move(argument_abi_digest)),
+      result_abi_digest_(std::move(result_abi_digest)),
+      mutation_abi_digest_(std::move(mutation_abi_digest)),
+      compile_request_byte_identity_digest_(std::move(compile_request_byte_identity_digest)),
+      catalog_provenance_(std::move(catalog_provenance)) {
+  RequireSha256(source_ir_digest_, "source_ir_digest");
+  RequireSha256(callable_abi_digest_, "callable_abi_digest");
+  (void)SemanticRouteName(semantic_route_);
+  RequireFullRevision(pipeline_revision_, "pipeline_revision");
+  RequireSha256(static_specialization_digest_, "static_specialization_digest");
+  RequireSha256(symbolic_specialization_digest_, "symbolic_specialization_digest");
+  RequireSha256(argument_abi_digest_, "argument_abi_digest");
+  RequireSha256(result_abi_digest_, "result_abi_digest");
+  RequireSha256(mutation_abi_digest_, "mutation_abi_digest");
+  RequireSha256(compile_request_byte_identity_digest_, "compile_request_byte_identity_digest");
+  if (SerializeCanonical().size() > kMaximumSerializedBuildSpecBytes) {
+    throw ValueError("KernelBuildSpec canonical payload exceeds the 1 MiB v1 limit");
+  }
+}
+
+std::vector<uint8_t> KernelBuildSpec::SerializeCanonical() const {
+  msgpack::sbuffer buffer;
+  CanonicalPacker packer(buffer);
+  packer.pack_map(14);
+  PackKey(packer, "argument_abi_digest");
+  PackText(packer, argument_abi_digest_);
+  PackKey(packer, "callable_abi_digest");
+  PackText(packer, callable_abi_digest_);
+  PackKey(packer, "catalog_provenance");
+  PackCatalogProvenance(packer, catalog_provenance_);
+  PackKey(packer, "compile_request_byte_identity_digest");
+  PackText(packer, compile_request_byte_identity_digest_);
+  PackKey(packer, "contract");
+  PackText(packer, kKernelBuildSpecContract);
+  PackKey(packer, "kernel_build_spec_schema_version");
+  packer.pack(kBuildSpecSchemaVersion);
+  PackKey(packer, "mutation_abi_digest");
+  PackText(packer, mutation_abi_digest_);
+  PackKey(packer, "pipeline_revision");
+  PackText(packer, pipeline_revision_);
+  PackKey(packer, "resolved_schedule");
+  PackResolvedSchedule(packer, resolved_schedule_);
+  PackKey(packer, "result_abi_digest");
+  PackText(packer, result_abi_digest_);
+  PackKey(packer, "semantic_route");
+  PackText(packer, SemanticRouteName(semantic_route_));
+  PackKey(packer, "source_ir_digest");
+  PackText(packer, source_ir_digest_);
+  PackKey(packer, "static_specialization_digest");
+  PackText(packer, static_specialization_digest_);
+  PackKey(packer, "symbolic_specialization_digest");
+  PackText(packer, symbolic_specialization_digest_);
+  return FinishBuffer(buffer);
+}
+
+KernelBuildSpec KernelBuildSpec::DeserializeCanonical(const std::vector<uint8_t>& data) {
+  auto handle = UnpackOne(data);
+  StrictMap fields(
+      handle.get(), "KernelBuildSpec",
+      {"argument_abi_digest", "callable_abi_digest", "catalog_provenance",
+       "compile_request_byte_identity_digest", "contract", "kernel_build_spec_schema_version",
+       "mutation_abi_digest", "pipeline_revision", "resolved_schedule", "result_abi_digest", "semantic_route",
+       "source_ir_digest", "static_specialization_digest", "symbolic_specialization_digest"});
+  const std::string contract = ReadText(fields.Get("contract"), "contract");
+  if (contract != kKernelBuildSpecContract) {
+    throw ValueError("unsupported KernelBuildSpec contract '" + contract + "'");
+  }
+  const uint32_t schema_version =
+      ReadUint32(fields.Get("kernel_build_spec_schema_version"), "kernel_build_spec_schema_version");
+  if (schema_version != kBuildSpecSchemaVersion) {
+    throw ValueError("unsupported KernelBuildSpec kernel_build_spec_schema_version " +
+                     std::to_string(schema_version));
+  }
+
+  KernelBuildSpec build_spec(
+      ReadText(fields.Get("source_ir_digest"), "source_ir_digest"),
+      ReadText(fields.Get("callable_abi_digest"), "callable_abi_digest"),
+      ParseSemanticRoute(fields.Get("semantic_route")),
+      ReadText(fields.Get("pipeline_revision"), "pipeline_revision"),
+      ParseResolvedSchedule(fields.Get("resolved_schedule")),
+      ReadText(fields.Get("static_specialization_digest"), "static_specialization_digest"),
+      ReadText(fields.Get("symbolic_specialization_digest"), "symbolic_specialization_digest"),
+      ReadText(fields.Get("argument_abi_digest"), "argument_abi_digest"),
+      ReadText(fields.Get("result_abi_digest"), "result_abi_digest"),
+      ReadText(fields.Get("mutation_abi_digest"), "mutation_abi_digest"),
+      ReadText(fields.Get("compile_request_byte_identity_digest"), "compile_request_byte_identity_digest"),
+      ParseCatalogProvenance(fields.Get("catalog_provenance")));
+  if (build_spec.SerializeCanonical() != data) {
+    throw ValueError("KernelBuildSpec payload is valid MessagePack but is not in canonical form");
+  }
+  return build_spec;
+}
+
+std::string KernelBuildSpec::GetIdentityDigest() const { return detail::Sha256Hex(SerializeCanonical()); }
+
+}  // namespace pypto::compiler
