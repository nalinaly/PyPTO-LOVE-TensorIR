+namespace {
+
+constexpr std::string_view kPipelineRevision = "cccccccccccccccccccccccccccccccccccccccc";
+
+ScheduleParameter Parameter(std::string name, ScheduleValueKind kind, std::string value) {
+  return ScheduleParameter(std::move(name), kind, std::move(value));
+}
+
+CanonicalSchedule ValidSchedule() {
+  return CanonicalSchedule({Parameter("algorithm", ScheduleValueKind::Text, "blocked")},
+                           {Parameter("k", ScheduleValueKind::UnsignedInteger, "64"),
+                            Parameter("m", ScheduleValueKind::UnsignedInteger, "128"),
+                            Parameter("n", ScheduleValueKind::UnsignedInteger, "128")},
+                           {Parameter("input", ScheduleValueKind::Text, "row-major"),
+                            Parameter("output", ScheduleValueKind::Text, "row-major")},
+                           {Parameter("enabled", ScheduleValueKind::Boolean, "false")},
+                           {Parameter("cluster_x", ScheduleValueKind::UnsignedInteger, "1"),
+                            Parameter("threads", ScheduleValueKind::UnsignedInteger, "256")},
+                           {Parameter("count", ScheduleValueKind::UnsignedInteger, "8")},
+                           {Parameter("count", ScheduleValueKind::UnsignedInteger, "3")},
+                           {Parameter("fast_math", ScheduleValueKind::Boolean, "false"),
+                            Parameter("max_candidates", ScheduleValueKind::UnsignedInteger, "0")});
+}
+
+CatalogProvenance ValidCatalog() {
+  return CatalogProvenance(std::string(64, '9'), std::string(64, 'a'), std::string(64, 'b'));
+}
+
+KernelBuildSpec ValidSpec(SemanticRoute route = SemanticRoute::GenericDirect,
+                          std::optional<CatalogProvenance> catalog = ValidCatalog()) {
+  return KernelBuildSpec(std::string(64, '1'), std::string(64, '2'), route, std::string(kPipelineRevision),
+                         ValidSchedule(), std::string(64, '3'), std::string(64, '4'), std::string(64, '5'),
+                         std::string(64, '6'), std::string(64, '7'), std::string(64, '8'),
+                         std::move(catalog));
+}
+
+void PackText(msgpack::packer<msgpack::sbuffer>& packer, std::string_view text) {
+  packer.pack_str(static_cast<uint32_t>(text.size()));
+  packer.pack_str_body(text.data(), static_cast<uint32_t>(text.size()));
+}
+
+std::string ObjectKey(const msgpack::object& object) {
+  return std::string(object.via.str.ptr, object.via.str.size);
+}
+
+std::vector<uint8_t> BufferBytes(const msgpack::sbuffer& buffer) {
+  const auto* begin = reinterpret_cast<const uint8_t*>(buffer.data());
+  return std::vector<uint8_t>(begin, begin + buffer.size());
+}
+
+std::vector<uint8_t> AddUnknownRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    packer.pack(root.get().via.map.ptr[i].key);
+    packer.pack(root.get().via.map.ptr[i].val);
+  }
+  PackText(packer, "unknown_field");
+  packer.pack(1);
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddDuplicateRootField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size + 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    packer.pack(root.get().via.map.ptr[i].key);
+    packer.pack(root.get().via.map.ptr[i].val);
+  }
+  PackText(packer, "source_ir_digest");
+  PackText(packer, std::string(64, '1'));
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> DropRootField(const std::vector<uint8_t>& canonical, std::string_view field_name) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size - 1);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    if (ObjectKey(entry.key) == field_name) continue;
+    packer.pack(entry.key);
+    packer.pack(entry.val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReverseRootOrder(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = root.get().via.map.size; i > 0; --i) {
+    packer.pack(root.get().via.map.ptr[i - 1].key);
+    packer.pack(root.get().via.map.ptr[i - 1].val);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceRootText(const std::vector<uint8_t>& canonical, std::string_view field_name,
+                                     std::string_view replacement) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == field_name) {
+      PackText(packer, replacement);
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> EncodeVersionNoncanonically(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) == "kernel_build_spec_schema_version") {
+      const char noncanonical_uint32_one[] = {static_cast<char>(0xce), 0x00, 0x00, 0x00, 0x01};
+      buffer.write(noncanonical_uint32_one, sizeof(noncanonical_uint32_one));
+    } else {
+      packer.pack(entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> AddUnknownScheduleField(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "resolved_schedule") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size + 1);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      packer.pack(entry.val.via.map.ptr[j].key);
+      packer.pack(entry.val.via.map.ptr[j].val);
+    }
+    PackText(packer, "unknown_schedule_field");
+    packer.pack_array(0);
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReverseTileParameters(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "resolved_schedule") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      const auto& schedule_entry = entry.val.via.map.ptr[j];
+      packer.pack(schedule_entry.key);
+      if (ObjectKey(schedule_entry.key) != "tile") {
+        packer.pack(schedule_entry.val);
+        continue;
+      }
+      packer.pack_array(schedule_entry.val.via.array.size);
+      for (uint32_t k = schedule_entry.val.via.array.size; k > 0; --k) {
+        packer.pack(schedule_entry.val.via.array.ptr[k - 1]);
+      }
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> ReplaceFirstTileParameterKind(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "resolved_schedule") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      const auto& schedule_entry = entry.val.via.map.ptr[j];
+      packer.pack(schedule_entry.key);
+      if (ObjectKey(schedule_entry.key) != "tile") {
+        packer.pack(schedule_entry.val);
+        continue;
+      }
+      packer.pack_array(schedule_entry.val.via.array.size);
+      for (uint32_t k = 0; k < schedule_entry.val.via.array.size; ++k) {
+        const auto& parameter = schedule_entry.val.via.array.ptr[k];
+        if (k != 0) {
+          packer.pack(parameter);
+          continue;
+        }
+        packer.pack_map(parameter.via.map.size);
+        for (uint32_t field_index = 0; field_index < parameter.via.map.size; ++field_index) {
+          const auto& parameter_entry = parameter.via.map.ptr[field_index];
+          packer.pack(parameter_entry.key);
+          if (ObjectKey(parameter_entry.key) == "kind") {
+            PackText(packer, "unknown-kind");
+          } else {
+            packer.pack(parameter_entry.val);
+          }
+        }
+      }
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+std::vector<uint8_t> DropCatalogScheduleDigest(const std::vector<uint8_t>& canonical) {
+  auto root = msgpack::unpack(reinterpret_cast<const char*>(canonical.data()), canonical.size());
+  msgpack::sbuffer buffer;
+  msgpack::packer<msgpack::sbuffer> packer(buffer);
+  packer.pack_map(root.get().via.map.size);
+  for (uint32_t i = 0; i < root.get().via.map.size; ++i) {
+    const auto& entry = root.get().via.map.ptr[i];
+    packer.pack(entry.key);
+    if (ObjectKey(entry.key) != "catalog_provenance") {
+      packer.pack(entry.val);
+      continue;
+    }
+    packer.pack_map(entry.val.via.map.size - 1);
+    for (uint32_t j = 0; j < entry.val.via.map.size; ++j) {
+      const auto& catalog_entry = entry.val.via.map.ptr[j];
+      if (ObjectKey(catalog_entry.key) == "schedule_digest") continue;
+      packer.pack(catalog_entry.key);
+      packer.pack(catalog_entry.val);
+    }
+  }
+  return BufferBytes(buffer);
+}
+
+bool Rejects(const std::vector<uint8_t>& data) {
+  try {
+    (void)KernelBuildSpec::DeserializeCanonical(data);
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
+
+template <typename Function>
+bool RejectsConstruction(Function&& function) {
+  try {
+    std::forward<Function>(function)();
+  } catch (const ValueError&) {
+    return true;
+  }
+  return false;
+}
