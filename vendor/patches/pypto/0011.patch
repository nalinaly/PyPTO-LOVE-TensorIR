+}  // namespace
+
+int main() {
+  static_assert(!std::is_default_constructible_v<ScheduleParameter>);
+  static_assert(!std::is_copy_assignable_v<ScheduleParameter>);
+  static_assert(!std::is_move_assignable_v<ScheduleParameter>);
+  static_assert(!std::is_default_constructible_v<CanonicalSchedule>);
+  static_assert(!std::is_copy_assignable_v<CanonicalSchedule>);
+  static_assert(!std::is_move_assignable_v<CanonicalSchedule>);
+  static_assert(!std::is_default_constructible_v<CatalogProvenance>);
+  static_assert(!std::is_copy_assignable_v<CatalogProvenance>);
+  static_assert(!std::is_move_assignable_v<CatalogProvenance>);
+  static_assert(!std::is_default_constructible_v<KernelBuildSpec>);
+  static_assert(!std::is_copy_assignable_v<KernelBuildSpec>);
+  static_assert(!std::is_move_assignable_v<KernelBuildSpec>);
+
+  const auto input_schedule = ValidSchedule();
+  const KernelBuildSpec owned_spec(std::string(64, '1'), std::string(64, '2'), SemanticRoute::GenericDirect,
+                                   std::string(kPipelineRevision), input_schedule, std::string(64, '3'),
+                                   std::string(64, '4'), std::string(64, '5'), std::string(64, '6'),
+                                   std::string(64, '7'), std::string(64, '8'), ValidCatalog());
+  REQUIRE(&owned_spec.GetResolvedSchedule() != &input_schedule);
+  REQUIRE(owned_spec.GetBuildSpecSchemaVersion() == 1);
+  REQUIRE(owned_spec.GetSemanticRoute() == SemanticRoute::GenericDirect);
+  REQUIRE(owned_spec.GetResolvedSchedule().GetTile().size() == 3);
+  REQUIRE(owned_spec.GetCatalogProvenance().has_value());
+
+  const std::vector<uint8_t> canonical = owned_spec.SerializeCanonical();
+  const KernelBuildSpec round_trip = KernelBuildSpec::DeserializeCanonical(canonical);
+  REQUIRE(round_trip.SerializeCanonical() == canonical);
+  REQUIRE(round_trip.GetIdentityDigest() ==
+          "93cab0033e5eb53ca87468c52348ffbfe5e17cd5d611080b2b8087af67fa93f6");
+  REQUIRE(round_trip.GetSourceIrDigest() == std::string(64, '1'));
+  REQUIRE(round_trip.GetCallableAbiDigest() == std::string(64, '2'));
+  REQUIRE(round_trip.GetStaticSpecializationDigest() == std::string(64, '3'));
+  REQUIRE(round_trip.GetSymbolicSpecializationDigest() == std::string(64, '4'));
+  REQUIRE(round_trip.GetArgumentAbiDigest() == std::string(64, '5'));
+  REQUIRE(round_trip.GetResultAbiDigest() == std::string(64, '6'));
+  REQUIRE(round_trip.GetMutationAbiDigest() == std::string(64, '7'));
+  REQUIRE(round_trip.GetCompileRequestByteIdentityDigest() == std::string(64, '8'));
+
+  REQUIRE(
+      KernelBuildSpec::DeserializeCanonical(ValidSpec(SemanticRoute::StructuredTensorIr).SerializeCanonical())
+          .GetSemanticRoute() == SemanticRoute::StructuredTensorIr);
+  REQUIRE(KernelBuildSpec::DeserializeCanonical(ValidSpec(SemanticRoute::ServingDirect).SerializeCanonical())
+              .GetSemanticRoute() == SemanticRoute::ServingDirect);
+  const KernelBuildSpec no_catalog = ValidSpec(SemanticRoute::GenericDirect, std::nullopt);
+  REQUIRE(!KernelBuildSpec::DeserializeCanonical(no_catalog.SerializeCanonical())
+               .GetCatalogProvenance()
+               .has_value());
+  REQUIRE(no_catalog.GetIdentityDigest() != owned_spec.GetIdentityDigest());
+
+  REQUIRE(RejectsConstruction(
+      [] { (void)ScheduleParameter("tile.m", ScheduleValueKind::UnsignedInteger, "01"); }));
+  REQUIRE(RejectsConstruction(
+      [] { (void)ScheduleParameter("Tile.m", ScheduleValueKind::UnsignedInteger, "1"); }));
+  REQUIRE(
+      RejectsConstruction([] { (void)ScheduleParameter("enabled", ScheduleValueKind::Boolean, "False"); }));
+  REQUIRE(
+      RejectsConstruction([] { (void)ScheduleParameter("value", static_cast<ScheduleValueKind>(99), "1"); }));
+  REQUIRE(RejectsConstruction([] {
+    (void)CanonicalSchedule({},
+                            {Parameter("second", ScheduleValueKind::Boolean, "true"),
+                             Parameter("first", ScheduleValueKind::Boolean, "false")},
+                            {}, {}, {}, {}, {}, {});
+  }));
+  REQUIRE(RejectsConstruction([] {
+    std::vector<ScheduleParameter> parameters;
+    parameters.reserve(129);
+    for (int i = 0; i < 129; ++i) {
+      parameters.emplace_back("value_" + std::to_string(i), ScheduleValueKind::UnsignedInteger, "1");
+    }
+    (void)CanonicalSchedule({}, std::move(parameters), {}, {}, {}, {}, {}, {});
+  }));
+  REQUIRE(RejectsConstruction(
+      [] { (void)CatalogProvenance(std::string(64, '9'), std::string(63, 'a'), std::string(64, 'b')); }));
+  REQUIRE(RejectsConstruction([] {
+    (void)KernelBuildSpec(std::string(63, '1'), std::string(64, '2'), SemanticRoute::GenericDirect,
+                          std::string(kPipelineRevision), ValidSchedule(), std::string(64, '3'),
+                          std::string(64, '4'), std::string(64, '5'), std::string(64, '6'),
+                          std::string(64, '7'), std::string(64, '8'));
+  }));
+  REQUIRE(RejectsConstruction([] {
+    (void)KernelBuildSpec(std::string(64, '1'), std::string(64, '2'), static_cast<SemanticRoute>(99),
+                          std::string(kPipelineRevision), ValidSchedule(), std::string(64, '3'),
+                          std::string(64, '4'), std::string(64, '5'), std::string(64, '6'),
+                          std::string(64, '7'), std::string(64, '8'));
+  }));
+  REQUIRE(RejectsConstruction([] {
+    (void)KernelBuildSpec(std::string(64, '1'), std::string(64, '2'), SemanticRoute::GenericDirect,
+                          std::string(40, 'C'), ValidSchedule(), std::string(64, '3'), std::string(64, '4'),
+                          std::string(64, '5'), std::string(64, '6'), std::string(64, '7'),
+                          std::string(64, '8'));
+  }));
+
+  REQUIRE(Rejects({}));
+  REQUIRE(Rejects(std::vector<uint8_t>{0xc1}));
+  REQUIRE(Rejects(std::vector<uint8_t>{0xdd, 0xff, 0xff, 0xff, 0xff}));
+  REQUIRE(Rejects(std::vector<uint8_t>{0xdf, 0xff, 0xff, 0xff, 0xff}));
+  REQUIRE(Rejects(std::vector<uint8_t>{0xdb, 0x00, 0x10, 0x00, 0x01}));
+  REQUIRE(Rejects(std::vector<uint8_t>(1024 * 1024 + 1, 0)));
+  std::vector<uint8_t> depth_bomb(17, 0x91);
+  depth_bomb.back() = 0xc0;
+  REQUIRE(Rejects(depth_bomb));
+  REQUIRE(Rejects(AddUnknownRootField(canonical)));
+  REQUIRE(Rejects(AddDuplicateRootField(canonical)));
+  REQUIRE(Rejects(DropRootField(canonical, "result_abi_digest")));
+  REQUIRE(Rejects(ReverseRootOrder(canonical)));
+  REQUIRE(Rejects(ReplaceRootText(canonical, "semantic_route", "unknown-route")));
+  REQUIRE(Rejects(AddUnknownScheduleField(canonical)));
+  REQUIRE(Rejects(ReverseTileParameters(canonical)));
+  REQUIRE(Rejects(ReplaceFirstTileParameterKind(canonical)));
+  REQUIRE(Rejects(DropCatalogScheduleDigest(canonical)));
+  REQUIRE(Rejects(EncodeVersionNoncanonically(canonical)));
+  auto trailing = canonical;
+  trailing.push_back(0);
+  REQUIRE(Rejects(trailing));
+  auto truncated = canonical;
+  truncated.pop_back();
+  REQUIRE(Rejects(truncated));
+
+  return 0;
+}
