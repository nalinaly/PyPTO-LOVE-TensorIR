+"""Canonical, pointer-free per-region KernelBuildSpec v1 contract."""
+
+import hashlib
+from typing import cast
+
+import pytest
+from pypto.compiler import (
+    CanonicalSchedule,
+    CatalogProvenance,
+    KernelBuildSpec,
+    ScheduleParameter,
+    ScheduleValueKind,
+    SemanticRoute,
+)
+
+PIPELINE_REVISION = "c" * 40
+SOURCE_IR_DIGEST = "1" * 64
+CALLABLE_ABI_DIGEST = "2" * 64
+STATIC_SPECIALIZATION_DIGEST = "3" * 64
+SYMBOLIC_SPECIALIZATION_DIGEST = "4" * 64
+ARGUMENT_ABI_DIGEST = "5" * 64
+RESULT_ABI_DIGEST = "6" * 64
+MUTATION_ABI_DIGEST = "7" * 64
+COMPILE_REQUEST_BYTE_IDENTITY_DIGEST = "8" * 64
+
+
+def parameter(
+    name: str,
+    value_kind: ScheduleValueKind,
+    canonical_value: str,
+) -> ScheduleParameter:
+    return ScheduleParameter(name, value_kind, canonical_value)
+
+
+def schedule(**overrides: object) -> CanonicalSchedule:
+    values: dict[str, object] = dict(
+        schedule=[parameter("algorithm", ScheduleValueKind.Text, "blocked")],
+        tile=[
+            parameter("k", ScheduleValueKind.UnsignedInteger, "64"),
+            parameter("m", ScheduleValueKind.UnsignedInteger, "128"),
+            parameter("n", ScheduleValueKind.UnsignedInteger, "128"),
+        ],
+        layout=[
+            parameter("input", ScheduleValueKind.Text, "row-major"),
+            parameter("output", ScheduleValueKind.Text, "row-major"),
+        ],
+        persistence=[parameter("enabled", ScheduleValueKind.Boolean, "false")],
+        cta=[
+            parameter("cluster_x", ScheduleValueKind.UnsignedInteger, "1"),
+            parameter("threads", ScheduleValueKind.UnsignedInteger, "256"),
+        ],
+        warp=[parameter("count", ScheduleValueKind.UnsignedInteger, "8")],
+        stage=[parameter("count", ScheduleValueKind.UnsignedInteger, "3")],
+        options=[
+            parameter("fast_math", ScheduleValueKind.Boolean, "false"),
+            parameter("max_candidates", ScheduleValueKind.UnsignedInteger, "0"),
+        ],
+    )
+    values.update(overrides)
+    return CanonicalSchedule(
+        schedule=cast(list[ScheduleParameter], values["schedule"]),
+        tile=cast(list[ScheduleParameter], values["tile"]),
+        layout=cast(list[ScheduleParameter], values["layout"]),
+        persistence=cast(list[ScheduleParameter], values["persistence"]),
+        cta=cast(list[ScheduleParameter], values["cta"]),
+        warp=cast(list[ScheduleParameter], values["warp"]),
+        stage=cast(list[ScheduleParameter], values["stage"]),
+        options=cast(list[ScheduleParameter], values["options"]),
+    )
+
+
+def catalog() -> CatalogProvenance:
+    return CatalogProvenance("9" * 64, "a" * 64, "b" * 64)
+
+
+def build_spec(**overrides: object) -> KernelBuildSpec:
+    values: dict[str, object] = dict(
+        source_ir_digest=SOURCE_IR_DIGEST,
+        callable_abi_digest=CALLABLE_ABI_DIGEST,
+        semantic_route=SemanticRoute.GenericDirect,
+        pipeline_revision=PIPELINE_REVISION,
+        resolved_schedule=schedule(),
+        static_specialization_digest=STATIC_SPECIALIZATION_DIGEST,
+        symbolic_specialization_digest=SYMBOLIC_SPECIALIZATION_DIGEST,
+        argument_abi_digest=ARGUMENT_ABI_DIGEST,
+        result_abi_digest=RESULT_ABI_DIGEST,
+        mutation_abi_digest=MUTATION_ABI_DIGEST,
+        compile_request_byte_identity_digest=COMPILE_REQUEST_BYTE_IDENTITY_DIGEST,
+        catalog_provenance=catalog(),
+    )
+    values.update(overrides)
+    return KernelBuildSpec(
+        source_ir_digest=cast(str, values["source_ir_digest"]),
+        callable_abi_digest=cast(str, values["callable_abi_digest"]),
+        semantic_route=cast(SemanticRoute, values["semantic_route"]),
+        pipeline_revision=cast(str, values["pipeline_revision"]),
+        resolved_schedule=cast(CanonicalSchedule, values["resolved_schedule"]),
+        static_specialization_digest=cast(str, values["static_specialization_digest"]),
+        symbolic_specialization_digest=cast(str, values["symbolic_specialization_digest"]),
+        argument_abi_digest=cast(str, values["argument_abi_digest"]),
+        result_abi_digest=cast(str, values["result_abi_digest"]),
+        mutation_abi_digest=cast(str, values["mutation_abi_digest"]),
+        compile_request_byte_identity_digest=cast(str, values["compile_request_byte_identity_digest"]),
+        catalog_provenance=cast(CatalogProvenance | None, values["catalog_provenance"]),
+    )
+
+
+def test_kernel_build_spec_round_trip_is_canonical_and_value_owned() -> None:
+    value = build_spec()
+    canonical = value.serialize()
+    restored = KernelBuildSpec.deserialize(canonical)
+
+    assert restored.serialize() == canonical
+    assert restored.build_spec_schema_version == 1
+    assert restored.source_ir_digest == SOURCE_IR_DIGEST
+    assert restored.callable_abi_digest == CALLABLE_ABI_DIGEST
+    assert restored.semantic_route == SemanticRoute.GenericDirect
+    assert restored.pipeline_revision == PIPELINE_REVISION
+    assert restored.resolved_schedule.tile[1].name == "m"
+    assert restored.resolved_schedule.cta[1].canonical_value == "256"
+    assert restored.static_specialization_digest == STATIC_SPECIALIZATION_DIGEST
+    assert restored.symbolic_specialization_digest == SYMBOLIC_SPECIALIZATION_DIGEST
+    assert restored.argument_abi_digest == ARGUMENT_ABI_DIGEST
+    assert restored.result_abi_digest == RESULT_ABI_DIGEST
+    assert restored.mutation_abi_digest == MUTATION_ABI_DIGEST
+    assert restored.compile_request_byte_identity_digest == COMPILE_REQUEST_BYTE_IDENTITY_DIGEST
+    assert restored.catalog_provenance is not None
+    assert restored.catalog_provenance.operator_digest == "9" * 64
+    assert restored.resolved_schedule is not value.resolved_schedule
+    with pytest.raises(AttributeError):
+        setattr(restored, "source_ir_digest", "f" * 64)
+    with pytest.raises(AttributeError):
+        setattr(restored.resolved_schedule, "tile", [])
+    with pytest.raises(AttributeError):
+        setattr(restored.resolved_schedule.tile[0], "name", "changed")
+    copied_tile = restored.resolved_schedule.tile
+    copied_tile.clear()
+    assert len(restored.resolved_schedule.tile) == 3
+
+
+def test_identity_digest_is_sha256_of_the_complete_canonical_payload() -> None:
+    value = build_spec()
+    canonical = value.serialize()
+
+    assert value.identity_digest == hashlib.sha256(canonical).hexdigest()
+    assert value.identity_digest == ("93cab0033e5eb53ca87468c52348ffbfe5e17cd5d611080b2b8087af67fa93f6")
+
+
+@pytest.mark.parametrize(
+    "route",
+    [
+        SemanticRoute.GenericDirect,
+        SemanticRoute.StructuredTensorIr,
+        SemanticRoute.ServingDirect,
+    ],
+)
+def test_all_semantic_routes_round_trip(route: SemanticRoute) -> None:
+    value = build_spec(semantic_route=route)
+    assert KernelBuildSpec.deserialize(value.serialize()).semantic_route == route
+
+
+def test_catalog_provenance_is_optional_but_all_or_none_when_present() -> None:
+    absent = build_spec(catalog_provenance=None)
+    restored = KernelBuildSpec.deserialize(absent.serialize())
+    assert restored.catalog_provenance is None
+    assert absent.identity_digest != build_spec().identity_digest
+
+    with pytest.raises(TypeError):
+        CatalogProvenance(operator_digest="9" * 64, problem_digest="a" * 64)
+    with pytest.raises(ValueError, match="64-character"):
+        CatalogProvenance("9" * 64, "a" * 63, "b" * 64)
+
+
+@pytest.mark.parametrize(
+    "field",
+    [
+        "source_ir_digest",
+        "callable_abi_digest",
+        "static_specialization_digest",
+        "symbolic_specialization_digest",
+        "argument_abi_digest",
+        "result_abi_digest",
+        "mutation_abi_digest",
+        "compile_request_byte_identity_digest",
+    ],
+)
+def test_all_hash_fields_require_lowercase_sha256(field: str) -> None:
+    with pytest.raises(ValueError, match="64-character"):
+        build_spec(**{field: "f" * 63})
+    with pytest.raises(ValueError, match="lowercase"):
+        build_spec(**{field: "F" * 64})
+
+
+@pytest.mark.parametrize("revision", ["a" * 39, "A" * 40, "not-a-revision"])
+def test_pipeline_revision_must_be_full_lowercase_revision(revision: str) -> None:
+    with pytest.raises(ValueError, match="40-character"):
+        build_spec(pipeline_revision=revision)
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["", "Tile.m", "tile..m", "tile.", "tile-m", "1tile", "a" * 129],
+)
+def test_schedule_parameter_names_require_canonical_dotted_identifiers(name: str) -> None:
+    with pytest.raises(ValueError, match="schedule parameter name"):
+        parameter(name, ScheduleValueKind.UnsignedInteger, "1")
+
+
+@pytest.mark.parametrize(
+    ("value_kind", "canonical_value"),
+    [
+        (ScheduleValueKind.Boolean, "False"),
+        (ScheduleValueKind.Boolean, "0"),
+        (ScheduleValueKind.SignedInteger, "+1"),
+        (ScheduleValueKind.SignedInteger, "01"),
+        (ScheduleValueKind.SignedInteger, "-0"),
+        (ScheduleValueKind.SignedInteger, str(1 << 63)),
+        (ScheduleValueKind.UnsignedInteger, "-1"),
+        (ScheduleValueKind.UnsignedInteger, "01"),
+        (ScheduleValueKind.UnsignedInteger, str(1 << 64)),
+        (ScheduleValueKind.Text, ""),
+        (ScheduleValueKind.Text, " leading"),
+        (ScheduleValueKind.Text, "trailing "),
+        (ScheduleValueKind.Text, "line\nbreak"),
+        (ScheduleValueKind.Text, "x" * 4097),
+    ],
+    ids=[
+        "boolean-case",
+        "boolean-numeric",
+        "signed-plus",
+        "signed-leading-zero",
+        "signed-negative-zero",
+        "signed-overflow",
+        "unsigned-negative",
+        "unsigned-leading-zero",
+        "unsigned-overflow",
+        "text-empty",
+        "text-leading-space",
+        "text-trailing-space",
+        "text-control",
+        "text-oversized",
+    ],
+)
+def test_schedule_parameter_values_require_canonical_typed_spelling(
+    value_kind: ScheduleValueKind,
+    canonical_value: str,
+) -> None:
+    with pytest.raises(ValueError):
+        parameter("value", value_kind, canonical_value)
+
+
+def test_schedule_integer_boundaries_round_trip_without_type_ambiguity() -> None:
+    boundary_options = [
+        parameter("signed_max", ScheduleValueKind.SignedInteger, str((1 << 63) - 1)),
+        parameter("signed_min", ScheduleValueKind.SignedInteger, str(-(1 << 63))),
+        parameter("unsigned_max", ScheduleValueKind.UnsignedInteger, str((1 << 64) - 1)),
+    ]
+    restored = KernelBuildSpec.deserialize(
+        build_spec(resolved_schedule=schedule(options=boundary_options)).serialize()
+    )
+    assert [entry.value_kind for entry in restored.resolved_schedule.options] == [
+        ScheduleValueKind.SignedInteger,
+        ScheduleValueKind.SignedInteger,
+        ScheduleValueKind.UnsignedInteger,
+    ]
+    assert [entry.canonical_value for entry in restored.resolved_schedule.options] == [
+        str((1 << 63) - 1),
+        str(-(1 << 63)),
+        str((1 << 64) - 1),
+    ]
+
+
+def test_schedule_categories_require_strict_unique_name_order() -> None:
+    first = parameter("first", ScheduleValueKind.Boolean, "false")
+    second = parameter("second", ScheduleValueKind.Boolean, "true")
+    with pytest.raises(ValueError, match="strictly ordered"):
+        schedule(tile=[second, first])
+    with pytest.raises(ValueError, match="strictly ordered"):
+        schedule(tile=[first, first])
+
+
+def test_empty_categories_are_explicit_inapplicable_values() -> None:
+    empty = CanonicalSchedule([], [], [], [], [], [], [], [])
+    restored = KernelBuildSpec.deserialize(build_spec(resolved_schedule=empty).serialize())
+    assert restored.resolved_schedule.schedule == []
+    assert restored.resolved_schedule.tile == []
+    assert restored.resolved_schedule.layout == []
+    assert restored.resolved_schedule.persistence == []
+    assert restored.resolved_schedule.cta == []
+    assert restored.resolved_schedule.warp == []
+    assert restored.resolved_schedule.stage == []
+    assert restored.resolved_schedule.options == []
+
+
+@pytest.mark.parametrize(
+    ("category", "changed_parameters"),
+    [
+        ("schedule", [parameter("algorithm", ScheduleValueKind.Text, "linear")]),
+        ("tile", [parameter("m", ScheduleValueKind.UnsignedInteger, "64")]),
+        ("layout", [parameter("input", ScheduleValueKind.Text, "column-major")]),
+        ("persistence", [parameter("enabled", ScheduleValueKind.Boolean, "true")]),
+        ("cta", [parameter("threads", ScheduleValueKind.UnsignedInteger, "128")]),
+        ("warp", [parameter("count", ScheduleValueKind.UnsignedInteger, "4")]),
+        ("stage", [parameter("count", ScheduleValueKind.UnsignedInteger, "2")]),
+        ("options", [parameter("fast_math", ScheduleValueKind.Boolean, "true")]),
+    ],
+)
+def test_every_resolved_schedule_category_changes_identity(
+    category: str,
+    changed_parameters: list[ScheduleParameter],
+) -> None:
+    baseline = build_spec()
+    changed = build_spec(resolved_schedule=schedule(**{category: changed_parameters}))
+    assert changed.identity_digest != baseline.identity_digest
+
+
+def test_all_region_identity_inputs_change_identity() -> None:
+    baseline = build_spec()
+    changed_values = [
+        build_spec(source_ir_digest="d" * 64),
+        build_spec(callable_abi_digest="d" * 64),
+        build_spec(semantic_route=SemanticRoute.ServingDirect),
+        build_spec(pipeline_revision="d" * 40),
+        build_spec(static_specialization_digest="d" * 64),
+        build_spec(symbolic_specialization_digest="d" * 64),
+        build_spec(argument_abi_digest="d" * 64),
+        build_spec(result_abi_digest="d" * 64),
+        build_spec(mutation_abi_digest="d" * 64),
+        build_spec(compile_request_byte_identity_digest="d" * 64),
+        build_spec(catalog_provenance=None),
+    ]
+    assert all(value.identity_digest != baseline.identity_digest for value in changed_values)
+
+
+def test_ambient_environment_does_not_change_build_spec(monkeypatch: pytest.MonkeyPatch) -> None:
+    baseline = build_spec().serialize()
+    monkeypatch.setenv("CUDA_VISIBLE_DEVICES", "17")
+    monkeypatch.setenv("NVIDIA_VISIBLE_DEVICES", "all")
+    monkeypatch.setenv("TENSOR_IR_STRATEGY", "ambient-must-not-be-read")
+    monkeypatch.setenv("TENSOR_IR_MAX_CANDIDATES", "999")
+    monkeypatch.setenv("PYPTO_BACKEND", "ambient-must-not-be-read")
+    assert build_spec().serialize() == baseline
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        b"",
+        b"\xc1",
+        b"\xdd\xff\xff\xff\xff",
+        b"\xdf\xff\xff\xff\xff",
+        b"\xdb\x00\x10\x00\x01",
+        b"\x91" * 16 + b"\xc0",
+        b"\x81\xadunknown_field\x01",
+    ],
+)
+def test_malformed_unknown_and_allocation_bomb_payloads_are_rejected(payload: bytes) -> None:
+    with pytest.raises(ValueError):
+        KernelBuildSpec.deserialize(payload)
+
+
+def test_payload_size_cap_rejects_before_unpacking() -> None:
+    with pytest.raises(ValueError, match="1 MiB"):
+        KernelBuildSpec.deserialize(b"\x00" * (1024 * 1024 + 1))
+
+
+def test_trailing_and_truncated_payloads_are_rejected() -> None:
+    canonical = build_spec().serialize()
+    with pytest.raises(ValueError, match="trailing"):
+        KernelBuildSpec.deserialize(canonical + b"\x00")
+    with pytest.raises(ValueError, match="malformed"):
+        KernelBuildSpec.deserialize(canonical[:-1])
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
