From d551ed877c33efa6463f90530832b5fd55dc0d42 Mon Sep 17 00:00:00 2001
From: zhaosiying12138 <neucszhaopeng2016@163.com>
Date: Sat, 29 Aug 2026 06:19:36 +0800
Subject: [PATCH 216/263] Allow bounded model-scale tileiras compilation

---
 src/compiler/nvidia/structured_tensorir_explicit_v1.json | 2 +-
 src/compiler/strict_tensor_ir_options.h                  | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/compiler/nvidia/structured_tensorir_explicit_v1.json b/src/compiler/nvidia/structured_tensorir_explicit_v1.json
index 46610e0415598d010981e4bd07d0660c592401ac..81aee59d88e17aaf4a37fe6e954ee89b0980ebb9 100644
--- a/src/compiler/nvidia/structured_tensorir_explicit_v1.json
+++ b/src/compiler/nvidia/structured_tensorir_explicit_v1.json
@@ -14,7 +14,7 @@
   "assembler_scratch_total_limit_bytes": 4294967296,
   "assembler_scratch_transient_scan_limit": 100,
   "assembler_stdio_policy": "reserved-above-stderr",
-  "assembler_timeout_seconds": 300,
+  "assembler_timeout_seconds": 900,
   "bytecode_version": [13, 3, 0],
   "codegen_strategy": "layout-propagation",
   "contract": "pypto.nvidia.structured_tensorir_pipeline.v1",
diff --git a/src/compiler/strict_tensor_ir_options.h b/src/compiler/strict_tensor_ir_options.h
index b74c0bc767cd7f42ab71eb4e0df8e3bb6c0ce162..db4c57f79046c956bd7de92a85a838dfff21ca68 100644
--- a/src/compiler/strict_tensor_ir_options.h
+++ b/src/compiler/strict_tensor_ir_options.h
@@ -35,7 +35,7 @@ struct StrictTensorIrProducerOptions {
   uint8_t bytecode_major = 13;
   uint8_t bytecode_minor = 3;
   uint16_t bytecode_tag = 0;
-  uint32_t assembler_timeout_seconds = 300;
+  uint32_t assembler_timeout_seconds = 900;
   uint32_t assembler_memory_limit_mib = 4096;
   uint64_t assembler_file_size_limit_bytes = 4096ULL * 1024ULL * 1024ULL;
   uint64_t assembler_scratch_total_limit_bytes = 4096ULL * 1024ULL * 1024ULL;
