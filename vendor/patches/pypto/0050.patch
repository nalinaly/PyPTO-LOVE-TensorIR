+
+"""Functional Python coverage for the single-transaction structured compiler facade."""
+
+import pypto
+import pytest
+from pypto.compiler import (
+    Artifact,
+    ArtifactArgumentPackingPolicy,
+    ArtifactGridPolicy,
+    ArtifactOperandKind,
+    CanonicalSchedule,
+    CompileRequest,
+    NvidiaBackendBuildInfo,
+    NvidiaTargetInfo,
+    ScheduleParameter,
+    ScheduleValueKind,
+    StructuredCompileResult,
+    TargetTraits,
+    ToolchainIdentity,
+    compile_structured_strict,
+    get_nvidia_backend_build_info,
+)
+from pypto.pypto_core import ir
+
+
+def _program() -> ir.Program:
+    span = ir.Span("structured_compile_test.py", 1, 1)
+    tensor_type = ir.TensorType([8, 8], pypto.DataType.FP32)
+    lhs = ir.Var("lhs", tensor_type, span)
+    rhs = ir.Var("rhs", tensor_type, span)
+    result = ir.Var("sum", tensor_type, span)
+    call = ir.Call(ir.get_op("tensor.add"), [lhs, rhs], tensor_type, span)
+    body = ir.SeqStmts(
+        [ir.AssignStmt(result, call, span), ir.ReturnStmt([result], span)],
+        span,
+    )
+    function = ir.Function(
+        "add_main",
+        [lhs, rhs],
+        [tensor_type],
+        body,
+        span,
+    )
+    return ir.Program([function], "structured_compile", span)
+
+
+def _traits() -> TargetTraits:
+    return TargetTraits(
+        compute_capability=120,
+        multiprocessor_count=82,
+        warp_size=32,
+        max_threads_per_block=1024,
+        max_threads_per_multiprocessor=1536,
+        max_blocks_per_multiprocessor=24,
+        max_block_dim_x=1024,
+        max_block_dim_y=1024,
+        max_block_dim_z=64,
+        max_grid_dim_x=(1 << 31) - 1,
+        max_grid_dim_y=65535,
+        max_grid_dim_z=65535,
+        l1_cache_line_bytes=128,
+        default_shared_memory_per_cta_bytes=48 * 1024,
+        max_shared_memory_per_cta_bytes=101376,
+        shared_memory_per_multiprocessor_bytes=131072,
+        registers_per_cta=65536,
+        max_registers_per_thread=255,
+        registers_per_multiprocessor=65536,
+        l2_cache_size_bytes=96 * 1024 * 1024,
+        total_global_memory_bytes=24 * 1024 * 1024 * 1024,
+    )
+
+
+def _request(info: NvidiaBackendBuildInfo) -> CompileRequest:
+    if info.compiled:
+        toolchain = ToolchainIdentity(
+            info.pypto_revision,
+            info.tensor_ir_revision,
+            info.cuda_tile_revision,
+            info.llvm_revision,
+            info.cuda_toolkit_root,
+            info.cuda_toolkit_version,
+            info.tileiras_real_path,
+            info.tileiras_version,
+            info.tileiras_sha256,
+        )
+        toolkit_version = info.cuda_toolkit_version
+        tensor_ir_revision = info.tensor_ir_revision
+        cuda_tile_revision = info.cuda_tile_revision
+    else:
+        toolchain = ToolchainIdentity(
+            "0" * 40,
+            "1" * 40,
+            "2" * 40,
+            "3" * 40,
+            "/usr/local/cuda-13.3",
+            "13.3.73",
+            "/usr/local/cuda-13.3/bin/tileiras",
+            "13.3.36",
+            "4" * 64,
+        )
+        toolkit_version = "13.3.73"
+        tensor_ir_revision = "1" * 40
+        cuda_tile_revision = "2" * 40
+    target = NvidiaTargetInfo(
+        0,
+        "Structured compile test device",
+        "GPU-structured-compile",
+        "0000:01:00.0",
+        _traits(),
+        toolkit_version,
+        "610.74",
+        tensor_ir_revision,
+        cuda_tile_revision,
+        [pypto.DataType.BF16, pypto.DataType.FP32],
+    )
+    return CompileRequest(target, toolchain)
+
+
+def _schedule() -> CanonicalSchedule:
+    parameter = ScheduleParameter
+    unsigned = ScheduleValueKind.UnsignedInteger
+    return CanonicalSchedule(
+        [parameter("codegen_strategy", ScheduleValueKind.Text, "layout-propagation")],
+        [parameter("dim_000", unsigned, "16")],
+        [],
+        [],
+        [parameter("count", unsigned, "1")],
+        [parameter("count", unsigned, "4")],
+        [],
+        [
+            parameter("bytecode_major", unsigned, "13"),
+            parameter("bytecode_minor", unsigned, "3"),
+            parameter("bytecode_tag", unsigned, "0"),
+            parameter("max_candidates", unsigned, "0"),
+            parameter("uniform_signature", ScheduleValueKind.Boolean, "false"),
+        ],
+    )
+
+
+def test_compile_structured_strict_functional() -> None:
+    info = get_nvidia_backend_build_info()
+    request = _request(info)
+    program = _program()
+    schedule = _schedule()
+
+    if not info.compiled:
+        with pytest.raises(ValueError, match="requires the compiled private NVIDIA backend"):
+            compile_structured_strict(program, request, schedule)
+        return
+
+    result = compile_structured_strict(program, request, schedule)
+    assert isinstance(result, StructuredCompileResult)
+    with pytest.raises(AttributeError):
+        setattr(result, "build_spec", result.build_spec)
+    with pytest.raises(AttributeError):
+        setattr(result, "artifact", result.artifact)
+
+    build_spec = result.build_spec
+    artifact = result.artifact
+    kernel = artifact.kernel_abi
+    assert build_spec.callable_abi_digest == kernel.identity_digest
+    assert artifact.identities.kernel_build_spec_digest == build_spec.identity_digest
+    assert artifact.identities.source_ir_digest == build_spec.source_ir_digest
+    assert kernel.runtime_kernel_name == "tensor_ir_rtk"
+    assert kernel.entry_function_name == "pypto_vector_add"
+    assert kernel.argument_packing_policy == ArtifactArgumentPackingPolicy.PointerOnly
+    assert kernel.grid_abi.policy == ArtifactGridPolicy.Static
+    assert kernel.grid_abi.static_dimensions == [4, 1, 1]
+    assert kernel.grid_abi.tile_sizes == [16]
+    assert len(kernel.argument_layout.operand_descriptors) == 3
+    assert kernel.argument_layout.input_operand_count == 2
+    assert kernel.argument_layout.total_kernel_argument_count == 3
+    for descriptor in kernel.argument_layout.operand_descriptors:
+        assert descriptor.kind == ArtifactOperandKind.Tensor
+        assert descriptor.shape == [8, 8]
+        assert descriptor.strides == [8, 1]
+        assert descriptor.dynamic_size_count == 0
+        assert descriptor.dynamic_stride_count == 0
+
+    build_spec_bytes = build_spec.serialize()
+    assert type(build_spec).deserialize(build_spec_bytes).serialize() == build_spec_bytes
+    artifact_bytes = artifact.serialize()
+    assert Artifact.deserialize(artifact_bytes, request, build_spec).serialize() == artifact_bytes
+
+
+if __name__ == "__main__":
+    pytest.main([__file__, "-v"])
