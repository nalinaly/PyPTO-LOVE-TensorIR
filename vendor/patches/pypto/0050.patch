+#include "pypto/compiler/structured_compile.h"
+
+#include <utility>
+
+#include "nvidia_artifact_compiler_internal.h"
+#include "structured_compile_internal.h"
+#include "structured_tensor_ir_build_spec.h"
+#include "pypto/core/error.h"
+
+namespace pypto::compiler {
+
+StructuredCompileResult::StructuredCompileResult(KernelBuildSpec build_spec, Artifact artifact)
+    : build_spec_(std::move(build_spec)), artifact_(std::move(artifact)) {
+  const ArtifactIdentities& identities = artifact_.GetIdentities();
+  if (identities.GetCompileRequestByteIdentityDigest() !=
+          build_spec_.GetCompileRequestByteIdentityDigest() ||
+      identities.GetKernelBuildSpecDigest() != build_spec_.GetIdentityDigest() ||
+      identities.GetSourceIrDigest() != build_spec_.GetSourceIrDigest() ||
+      identities.GetCallableAbiDigest() != build_spec_.GetCallableAbiDigest() ||
+      artifact_.GetKernelAbi().GetIdentityDigest() != build_spec_.GetCallableAbiDigest() ||
+      identities.GetArgumentAbiDigest() != build_spec_.GetArgumentAbiDigest() ||
+      identities.GetResultAbiDigest() != build_spec_.GetResultAbiDigest() ||
+      identities.GetMutationAbiDigest() != build_spec_.GetMutationAbiDigest() ||
+      identities.GetStaticSpecializationDigest() !=
+          build_spec_.GetStaticSpecializationDigest() ||
+      identities.GetSymbolicSpecializationDigest() !=
+          build_spec_.GetSymbolicSpecializationDigest() ||
+      artifact_.GetSemanticRoute() != build_spec_.GetSemanticRoute()) {
+    throw InternalError("StructuredCompileResult BuildSpec and Artifact identities do not join");
+  }
+}
+
+StructuredCompileResult CompileStructuredStrict(const ir::ProgramPtr& program,
+                                                 const CompileRequest& request,
+                                                 const CanonicalSchedule& schedule) {
+  detail::PreparedStructuredTensorIrCompilation prepared =
+      detail::PrepareStructuredTensorIrCompilation(program, request, schedule);
+  detail::NormalizedNvidiaProducerArtifact normalized = detail::CompileNvidiaProducerOnce(
+      prepared.GetCanonicalSource(), prepared.GetCompileRequest(), prepared.GetResolvedOptions());
+  KernelBuildSpec build_spec =
+      detail::FinalizeStructuredTensorIrBuildSpec(prepared, normalized.GetKernelAbi());
+  Artifact artifact = detail::CreateArtifactFromNormalized(
+      prepared.GetCompileRequest(), build_spec, std::move(normalized));
+  return detail::StructuredCompileResultBuilder::Create(std::move(build_spec),
+                                                        std::move(artifact));
+}
+
+StructuredCompileResult detail::StructuredCompileResultBuilder::Create(
+    KernelBuildSpec build_spec, Artifact artifact) {
+  return StructuredCompileResult(std::move(build_spec), std::move(artifact));
+}
+
+}  // namespace pypto::compiler
