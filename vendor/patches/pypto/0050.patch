+#ifndef PYPTO_COMPILER_STRUCTURED_COMPILE_H_
+#define PYPTO_COMPILER_STRUCTURED_COMPILE_H_
+
+#include "pypto/compiler/artifact.h"
+#include "pypto/compiler/compile_request.h"
+#include "pypto/compiler/kernel_build_spec.h"
+#include "pypto/ir/program.h"
+
+namespace pypto::compiler {
+
+namespace detail {
+class StructuredCompileResultBuilder;
+}  // namespace detail
+
+/** Final immutable BuildSpec and Artifact produced by one strict transaction. */
+class StructuredCompileResult {
+ public:
+  StructuredCompileResult() = delete;
+  StructuredCompileResult(const StructuredCompileResult&) = default;
+  StructuredCompileResult(StructuredCompileResult&&) = default;
+  StructuredCompileResult& operator=(const StructuredCompileResult&) = delete;
+  StructuredCompileResult& operator=(StructuredCompileResult&&) = delete;
+
+  [[nodiscard]] const KernelBuildSpec& GetBuildSpec() const noexcept { return build_spec_; }
+  [[nodiscard]] const Artifact& GetArtifact() const noexcept { return artifact_; }
+
+ private:
+  friend class detail::StructuredCompileResultBuilder;
+  StructuredCompileResult(KernelBuildSpec build_spec, Artifact artifact);
+
+  KernelBuildSpec build_spec_;
+  Artifact artifact_;
+};
+
+/** Emit, compile once, finalize identity, and return the joined strict result. */
+[[nodiscard]] StructuredCompileResult CompileStructuredStrict(
+    const ir::ProgramPtr& program, const CompileRequest& request,
+    const CanonicalSchedule& schedule);
+
+}  // namespace pypto::compiler
+
+#endif  // PYPTO_COMPILER_STRUCTURED_COMPILE_H_
