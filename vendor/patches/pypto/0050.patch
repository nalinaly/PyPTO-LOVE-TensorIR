+#ifndef PYPTO_SRC_COMPILER_NVIDIA_ARTIFACT_COMPILER_INTERNAL_H_
+#define PYPTO_SRC_COMPILER_NVIDIA_ARTIFACT_COMPILER_INTERNAL_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "pypto/compiler/artifact.h"
+#include "strict_tensor_ir_options.h"
+
+namespace pypto::compiler::detail {
+
+/** Immutable normalized output of one concrete private producer invocation. */
+class NormalizedNvidiaProducerArtifact {
+ public:
+  NormalizedNvidiaProducerArtifact() = delete;
+  NormalizedNvidiaProducerArtifact(const NormalizedNvidiaProducerArtifact&) = delete;
+  NormalizedNvidiaProducerArtifact(NormalizedNvidiaProducerArtifact&&) = default;
+  NormalizedNvidiaProducerArtifact& operator=(const NormalizedNvidiaProducerArtifact&) = delete;
+  NormalizedNvidiaProducerArtifact& operator=(NormalizedNvidiaProducerArtifact&&) = delete;
+
+  [[nodiscard]] const ArtifactKernelAbi& GetKernelAbi() const noexcept { return kernel_abi_; }
+
+ private:
+  friend NormalizedNvidiaProducerArtifact CompileNvidiaProducerOnce(
+      const std::vector<uint8_t>& source, const CompileRequest& request,
+      const StrictTensorIrProducerOptions& resolved);
+  friend Artifact CreateArtifactFromNormalized(const CompileRequest& request,
+                                               const KernelBuildSpec& build_spec,
+                                               NormalizedNvidiaProducerArtifact result);
+
+  NormalizedNvidiaProducerArtifact(ArtifactTarget requested_target,
+                                   ArtifactTarget actual_target,
+                                   ArtifactBytecodeVersion tile_ir_bytecode_version,
+                                   ArtifactKernelAbi kernel_abi, bool fallback_used,
+                                   std::vector<uint8_t> device_code,
+                                   std::string source_ir_digest,
+                                   std::string compile_request_byte_identity_digest,
+                                   std::string compile_options_identity);
+
+  ArtifactTarget requested_target_;
+  ArtifactTarget actual_target_;
+  ArtifactBytecodeVersion tile_ir_bytecode_version_;
+  ArtifactKernelAbi kernel_abi_;
+  bool fallback_used_;
+  std::vector<uint8_t> device_code_;
+  std::string source_ir_digest_;
+  std::string compile_request_byte_identity_digest_;
+  std::string compile_options_identity_;
+};
+
+/** Validate exact build identity and invoke the concrete private producer once. */
+[[nodiscard]] NormalizedNvidiaProducerArtifact CompileNvidiaProducerOnce(
+    const std::vector<uint8_t>& source, const CompileRequest& request,
+    const StrictTensorIrProducerOptions& resolved);
+
+/** Create and fully validate an Artifact from the same normalized producer result. */
+[[nodiscard]] Artifact CreateArtifactFromNormalized(
+    const CompileRequest& request, const KernelBuildSpec& build_spec,
+    NormalizedNvidiaProducerArtifact result);
+
+/** Monotonic observation-only count of concrete private producer invocations. */
+[[nodiscard]] uint64_t GetStrictNvidiaProducerInvocationCountForTesting() noexcept;
+
+}  // namespace pypto::compiler::detail
+
+#endif  // PYPTO_SRC_COMPILER_NVIDIA_ARTIFACT_COMPILER_INTERNAL_H_
