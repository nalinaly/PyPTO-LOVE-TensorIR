+const ir::Span& TestSpan() {
+  static const ir::Span span("structured_compile_test.cpp", 7, 3);
+  return span;
+}
+
+ir::ProgramPtr MakeProgram() {
+  auto type = std::make_shared<ir::TensorType>(
+      std::vector<int64_t>{8, 8}, DataType::FP32, std::optional<ir::MemRefPtr>{});
+  auto lhs = std::make_shared<ir::Var>("lhs", type, TestSpan());
+  auto rhs = std::make_shared<ir::Var>("rhs", type, TestSpan());
+  auto result = std::make_shared<ir::Var>("sum", type, TestSpan());
+  auto call = std::make_shared<ir::Call>(
+      ir::OpRegistry::GetInstance().GetOp("tensor.add"), std::vector<ir::ExprPtr>{lhs, rhs},
+      std::vector<std::pair<std::string, std::any>>{},
+      std::vector<std::pair<std::string, std::any>>{}, type, TestSpan());
+  auto assignment = std::make_shared<ir::AssignStmt>(result, call, TestSpan());
+  auto returned =
+      std::make_shared<ir::ReturnStmt>(std::vector<ir::ExprPtr>{result}, TestSpan());
+  auto body = std::make_shared<ir::SeqStmts>(
+      std::vector<ir::StmtPtr>{assignment, returned}, TestSpan());
+  auto function = std::make_shared<ir::Function>(
+      "add_main", std::vector<ir::VarPtr>{lhs, rhs},
+      std::vector<ir::ParamDirection>{ir::ParamDirection::In, ir::ParamDirection::In},
+      std::vector<ir::TypePtr>{type}, body, TestSpan());
+  return std::make_shared<ir::Program>(std::vector<ir::FunctionPtr>{function}, "test", TestSpan());
+}
+
+TargetTraits MakeTraits(int multiprocessor_count = 82) {
+  return TargetTraits(120, multiprocessor_count, 32, 1024, 1536, 24, 1024, 1024, 64,
+                      2147483647, 65535,
+                      65535, 128, 48 * 1024, 101376, 131072, 65536, 255, 65536,
+                      96ULL * 1024 * 1024, 24ULL * 1024 * 1024 * 1024);
+}
+
+CompileRequest MakeRequest(int multiprocessor_count = 82) {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  const NvidiaBackendBuildInfo build_info = GetNvidiaBackendBuildInfo();
+  NvidiaTargetInfo target(0, "Synthetic SM120", "GPU-synthetic", "0000:01:00.0",
+                          MakeTraits(multiprocessor_count),
+                          build_info.GetCudaToolkitVersion(), "610.74",
+                          build_info.GetTensorIrRevision(), build_info.GetCudaTileRevision(),
+                          {DataType::BF16, DataType::FP32});
+  ToolchainIdentity toolchain(
+      build_info.GetPyptoRevision(), build_info.GetTensorIrRevision(),
+      build_info.GetCudaTileRevision(), build_info.GetLlvmRevision(),
+      build_info.GetCudaToolkitRoot(), build_info.GetCudaToolkitVersion(),
+      build_info.GetTileirasRealPath(), build_info.GetTileirasVersion(),
+      build_info.GetTileirasSha256());
+#else
+  NvidiaTargetInfo target(0, "Synthetic SM120", "GPU-synthetic", "0000:01:00.0",
+                          MakeTraits(multiprocessor_count),
+                          "13.3", "610.74", std::string(kDummyTensorIrRevision),
+                          std::string(kDummyCudaTileRevision), {DataType::BF16, DataType::FP32});
+  ToolchainIdentity toolchain(
+      std::string(kDummyPyptoRevision), std::string(kDummyTensorIrRevision),
+      std::string(kDummyCudaTileRevision), std::string(kDummyLlvmRevision), "/opt/cuda-13.3",
+      "13.3", "/opt/cuda-13.3/bin/tileiras", "13.3.73",
+      std::string(kDummyTileirasSha256));
+#endif
+  return CompileRequest(std::move(target), std::move(toolchain));
+}
+
+CanonicalSchedule MakeSchedule(std::string tile_size = "16") {
+  return CanonicalSchedule(
+      {ScheduleParameter("codegen_strategy", ScheduleValueKind::Text, "layout-propagation")},
+      {ScheduleParameter("dim_000", ScheduleValueKind::UnsignedInteger,
+                         std::move(tile_size))},
+      {}, {},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "1")},
+      {ScheduleParameter("count", ScheduleValueKind::UnsignedInteger, "4")}, {},
+      {ScheduleParameter("bytecode_major", ScheduleValueKind::UnsignedInteger, "13"),
+       ScheduleParameter("bytecode_minor", ScheduleValueKind::UnsignedInteger, "3"),
+       ScheduleParameter("bytecode_tag", ScheduleValueKind::UnsignedInteger, "0"),
+       ScheduleParameter("max_candidates", ScheduleValueKind::UnsignedInteger, "0"),
+       ScheduleParameter("uniform_signature", ScheduleValueKind::Boolean, "false")});
+}
+
+bool RejectsValue(const std::function<void()>& action, std::string_view expected) {
+  try {
+    action();
+  } catch (const ValueError& error) {
+    return std::string_view(error.what()).find(expected) != std::string_view::npos;
+  }
+  return false;
+}
+
+bool RejectsInternal(const std::function<void()>& action, std::string_view expected) {
+  try {
+    action();
+  } catch (const InternalError& error) {
+    return std::string_view(error.what()).find(expected) != std::string_view::npos;
+  }
+  return false;
+}
+
+bool RejectsRuntime(const std::function<void()>& action, std::string_view expected) {
+  try {
+    action();
+  } catch (const RuntimeError& error) {
+    return std::string_view(error.what()).find(expected) != std::string_view::npos;
+  }
+  return false;
+}
