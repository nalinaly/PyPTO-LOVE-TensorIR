+int TestPrevalidationMakesZeroProducerCalls() {
+  const CompileRequest request = MakeRequest();
+  const uint64_t before = GetStrictNvidiaProducerInvocationCountForTesting();
+
+  REQUIRE(RejectsValue(
+      [&] { (void)CompileStructuredStrict(ir::ProgramPtr{}, request, MakeSchedule()); },
+      "program must not be null"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before);
+
+  REQUIRE(RejectsValue(
+      [&] {
+        (void)CompileStructuredStrict(
+            MakeProgram(), request, CanonicalSchedule({}, {}, {}, {}, {}, {}, {}, {}));
+      },
+      "CanonicalSchedule resolved schedule"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before);
+
+#if !defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  REQUIRE(RejectsValue(
+      [&] { (void)CompileStructuredStrict(MakeProgram(), request, MakeSchedule()); },
+      "requires the compiled private NVIDIA backend"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before);
+#endif
+  return 0;
+}
+
+int TestLegacyBackendOffRegression() {
+#if !defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  const CompileRequest request = MakeRequest();
+  const auto prepared = PrepareStructuredTensorIrCompilation(MakeProgram(), request, MakeSchedule());
+  const KernelBuildSpec build_spec(
+      prepared.GetSourceIrDigest(), std::string(64, '1'), SemanticRoute::StructuredTensorIr,
+      std::string(Artifact::kStructuredTensorIrPipelineRevision), prepared.GetSchedule(),
+      prepared.GetStaticSpecialization().GetIdentityDigest(),
+      prepared.GetSymbolicSpecialization().GetIdentityDigest(),
+      prepared.GetArgumentAbi().GetIdentityDigest(), prepared.GetResultAbi().GetIdentityDigest(),
+      prepared.GetMutationAbi().GetIdentityDigest(), request.GetByteCompileIdentityDigest());
+  REQUIRE(RejectsValue(
+      [&] { (void)Artifact::CompileStrict(prepared.GetCanonicalSource(), request, build_spec); },
+      "requires the compiled private NVIDIA backend"));
+#endif
+  return 0;
+}
+
+int TestRealProducerSuccess() {
+#if defined(PYPTO_ENABLE_NVIDIA_COMPILER_BACKEND)
+  const CompileRequest request = MakeRequest();
+  const uint64_t before = GetStrictNvidiaProducerInvocationCountForTesting();
+  const StructuredCompileResult result =
+      CompileStructuredStrict(MakeProgram(), request, MakeSchedule());
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before + 1);
+  const KernelBuildSpec& build_spec = result.GetBuildSpec();
+  const Artifact& artifact = result.GetArtifact();
+  const auto& kernel = artifact.GetKernelAbi();
+  REQUIRE(kernel.GetRuntimeKernelName() == "tensor_ir_rtk");
+  REQUIRE(kernel.GetEntryFunctionName() == "pypto_vector_add");
+  REQUIRE(kernel.GetArgumentPackingPolicy() ==
+          pypto::compiler::ArtifactArgumentPackingPolicy::PointerOnly);
+  REQUIRE(kernel.GetArgumentLayout().GetOperandDescriptors().size() == 3);
+  REQUIRE(kernel.GetArgumentLayout().GetInputOperandCount() == 2);
+  REQUIRE(kernel.GetArgumentLayout().GetTotalKernelArgumentCount() == 3);
+  REQUIRE(!kernel.GetArgumentLayout().HasUniformSignature());
+  for (const auto& descriptor : kernel.GetArgumentLayout().GetOperandDescriptors()) {
+    REQUIRE(descriptor.GetKind() == pypto::compiler::ArtifactOperandKind::Tensor);
+    REQUIRE(descriptor.GetShape() ==
+            std::vector<std::optional<int64_t>>({std::optional<int64_t>{8},
+                                                 std::optional<int64_t>{8}}));
+    REQUIRE(descriptor.GetStrides() ==
+            std::vector<std::optional<int64_t>>({std::optional<int64_t>{8},
+                                                 std::optional<int64_t>{1}}));
+    REQUIRE(descriptor.GetDynamicSizeCount() == 0);
+    REQUIRE(descriptor.GetDynamicStrideCount() == 0);
+    REQUIRE(descriptor.GetScalarSizeBytes() == 0);
+  }
+  REQUIRE(kernel.GetGridAbi().GetPolicy() == pypto::compiler::ArtifactGridPolicy::Static);
+  REQUIRE(kernel.GetGridAbi().GetShapeOperandIndex() == 0);
+  REQUIRE((kernel.GetGridAbi().GetStaticDimensions() == std::array<uint32_t, 3>{4, 1, 1}));
+  REQUIRE(kernel.GetGridAbi().GetTileSizes() == std::vector<uint32_t>({16}));
+  REQUIRE(build_spec.GetCallableAbiDigest() == artifact.GetKernelAbi().GetIdentityDigest());
+  REQUIRE(artifact.GetIdentities().GetKernelBuildSpecDigest() == build_spec.GetIdentityDigest());
+  REQUIRE(artifact.GetIdentities().GetSourceIrDigest() == build_spec.GetSourceIrDigest());
+  REQUIRE(artifact.GetIdentities().GetArgumentAbiDigest() == build_spec.GetArgumentAbiDigest());
+  REQUIRE(artifact.GetIdentities().GetResultAbiDigest() == build_spec.GetResultAbiDigest());
+  REQUIRE(artifact.GetIdentities().GetMutationAbiDigest() == build_spec.GetMutationAbiDigest());
+  REQUIRE(artifact.GetIdentities().GetStaticSpecializationDigest() ==
+          build_spec.GetStaticSpecializationDigest());
+  REQUIRE(artifact.GetIdentities().GetSymbolicSpecializationDigest() ==
+          build_spec.GetSymbolicSpecializationDigest());
+
+  const std::vector<uint8_t> build_spec_bytes = build_spec.SerializeCanonical();
+  REQUIRE(KernelBuildSpec::DeserializeCanonical(build_spec_bytes).SerializeCanonical() ==
+          build_spec_bytes);
+  const std::vector<uint8_t> artifact_bytes = artifact.SerializeCanonical();
+  REQUIRE(Artifact::DeserializeCanonical(artifact_bytes, request, build_spec).SerializeCanonical() ==
+          artifact_bytes);
+
+  const KernelBuildSpec mismatched_build_spec(
+      std::string(64, 'f'), build_spec.GetCallableAbiDigest(), build_spec.GetSemanticRoute(),
+      build_spec.GetPipelineRevision(), build_spec.GetResolvedSchedule(),
+      build_spec.GetStaticSpecializationDigest(), build_spec.GetSymbolicSpecializationDigest(),
+      build_spec.GetArgumentAbiDigest(), build_spec.GetResultAbiDigest(),
+      build_spec.GetMutationAbiDigest(), build_spec.GetCompileRequestByteIdentityDigest());
+  REQUIRE(RejectsInternal(
+      [&] {
+        (void)StructuredCompileResultBuilder::Create(mismatched_build_spec, artifact);
+      },
+      "identities do not join"));
+
+  const KernelBuildSpec mismatched_request(
+      build_spec.GetSourceIrDigest(), build_spec.GetCallableAbiDigest(),
+      build_spec.GetSemanticRoute(), build_spec.GetPipelineRevision(),
+      build_spec.GetResolvedSchedule(), build_spec.GetStaticSpecializationDigest(),
+      build_spec.GetSymbolicSpecializationDigest(), build_spec.GetArgumentAbiDigest(),
+      build_spec.GetResultAbiDigest(), build_spec.GetMutationAbiDigest(), std::string(64, 'e'));
+  REQUIRE(RejectsInternal(
+      [&] {
+        (void)StructuredCompileResultBuilder::Create(mismatched_request, artifact);
+      },
+      "identities do not join"));
+
+  const auto prepared_source =
+      PrepareStructuredTensorIrCompilation(MakeProgram(), request, MakeSchedule());
+  const uint64_t before_source_seal = GetStrictNvidiaProducerInvocationCountForTesting();
+  auto source_sealed = CompileNvidiaProducerOnce(
+      prepared_source.GetCanonicalSource(), prepared_source.GetCompileRequest(),
+      prepared_source.GetResolvedOptions());
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before_source_seal + 1);
+  const KernelBuildSpec source_spec =
+      FinalizeStructuredTensorIrBuildSpec(prepared_source, source_sealed.GetKernelAbi());
+  const KernelBuildSpec rebound_source(
+      std::string(64, 'd'), source_spec.GetCallableAbiDigest(), source_spec.GetSemanticRoute(),
+      source_spec.GetPipelineRevision(), source_spec.GetResolvedSchedule(),
+      source_spec.GetStaticSpecializationDigest(), source_spec.GetSymbolicSpecializationDigest(),
+      source_spec.GetArgumentAbiDigest(), source_spec.GetResultAbiDigest(),
+      source_spec.GetMutationAbiDigest(), source_spec.GetCompileRequestByteIdentityDigest());
+  REQUIRE(RejectsInternal(
+      [&] {
+        (void)CreateArtifactFromNormalized(request, rebound_source, std::move(source_sealed));
+      },
+      "normalized NVIDIA producer result identity"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before_source_seal + 1);
+
+  const auto prepared_request_a =
+      PrepareStructuredTensorIrCompilation(MakeProgram(), request, MakeSchedule());
+  const uint64_t before_request_seal = GetStrictNvidiaProducerInvocationCountForTesting();
+  auto request_sealed = CompileNvidiaProducerOnce(
+      prepared_request_a.GetCanonicalSource(), prepared_request_a.GetCompileRequest(),
+      prepared_request_a.GetResolvedOptions());
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before_request_seal + 1);
+  const CompileRequest request_b = MakeRequest(96);
+  const auto prepared_request_b =
+      PrepareStructuredTensorIrCompilation(MakeProgram(), request_b, MakeSchedule());
+  const KernelBuildSpec request_b_spec =
+      FinalizeStructuredTensorIrBuildSpec(prepared_request_b, request_sealed.GetKernelAbi());
+  REQUIRE(RejectsInternal(
+      [&] {
+        (void)CreateArtifactFromNormalized(request_b, request_b_spec, std::move(request_sealed));
+      },
+      "normalized NVIDIA producer result identity"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before_request_seal + 1);
+
+  const uint64_t before_rejection = GetStrictNvidiaProducerInvocationCountForTesting();
+  REQUIRE(RejectsRuntime(
+      [&] { (void)CompileStructuredStrict(MakeProgram(), request, MakeSchedule("128")); },
+      "private TensorIR producer failed with status 3"));
+  REQUIRE(GetStrictNvidiaProducerInvocationCountForTesting() == before_rejection + 1);
+#endif
+  return 0;
+}
+
+}  // namespace
+
+int main() {
+  static_assert(!std::is_copy_constructible_v<
+                pypto::compiler::detail::NormalizedNvidiaProducerArtifact>);
+  static_assert(std::is_move_constructible_v<
+                pypto::compiler::detail::NormalizedNvidiaProducerArtifact>);
+  static_assert(!std::is_default_constructible_v<StructuredCompileResult>);
+  static_assert(!std::is_copy_assignable_v<StructuredCompileResult>);
+  static_assert(!std::is_move_assignable_v<StructuredCompileResult>);
+
+  if (const int result = TestPrevalidationMakesZeroProducerCalls()) return result;
+  if (const int result = TestLegacyBackendOffRegression()) return result;
+  if (const int result = TestRealProducerSuccess()) return result;
+  return 0;
+}
