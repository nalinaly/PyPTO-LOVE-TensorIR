+struct NativeTileRopeGraph {
+  StaticTensor input;
+  StaticTensor frequency;
+};
+
+bool IsNativeTileRopeCandidate(const ir::ProgramPtr& program) {
+  if (!IsNativeTilePointwiseCandidate(program)) return false;
+  const ir::FunctionPtr& function = program->functions_.begin()->second;
+  if (function->params_.size() != 4) return false;
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  const ir::SeqStmtsPtr& leaf = loop_nest.leaf;
+  if (!leaf || leaf->stmts_.size() != 12) return false;
+  const auto first = ir::As<ir::AssignStmt>(leaf->stmts_[0]);
+  const auto first_call = first ? ir::As<ir::Call>(first->value_) : nullptr;
+  const auto store0 = ir::As<ir::EvalStmt>(leaf->stmts_[10]);
+  const auto store1 = ir::As<ir::EvalStmt>(leaf->stmts_[11]);
+  const auto call0 = store0 ? ir::As<ir::Call>(store0->expr_) : nullptr;
+  const auto call1 = store1 ? ir::As<ir::Call>(store1->expr_) : nullptr;
+  return first_call && ir::IsOp(first_call, "tile.load") && call0 && call1 &&
+         ir::IsOp(call0, "tile.store") && ir::IsOp(call1, "tile.store");
+}
+
+NativeTileRopeGraph AnalyzeNativeTileRope(const ir::ProgramPtr& program) {
+  const auto& [global, function] = *program->functions_.begin();
+  if (!global || !function || global->name_ != function->name_ ||
+      function->requires_runtime_binding_ ||
+      function->func_type_ != ir::FunctionType::Orchestration ||
+      !function->level_.has_value() || *function->level_ != ir::Level::CHIP ||
+      !function->role_.has_value() || *function->role_ != ir::Role::Orchestrator ||
+      !function->attrs_.empty()) {
+    Reject("native RoPE must be one canonical CHIP @pl.jit function",
+           function ? &function->span_ : &program->span_);
+  }
+  if (function->params_.size() != 4 ||
+      function->param_directions_.size() != 4 ||
+      function->param_directions_[0] != ir::ParamDirection::In ||
+      function->param_directions_[1] != ir::ParamDirection::In ||
+      function->param_directions_[2] != ir::ParamDirection::In ||
+      function->param_directions_[3] != ir::ParamDirection::Out ||
+      function->return_types_.size() != 1) {
+    Reject("native RoPE requires x, cos, sin and one output parameter",
+           &function->span_);
+  }
+  for (const ir::VarPtr& parameter : function->params_) {
+    if (!parameter || parameter->GetKind() != ir::ObjectKind::Var) {
+      Reject("native RoPE parameters must be exact Var nodes", &function->span_);
+    }
+  }
+  const StaticTensor input = ReadStaticTensor(
+      function->params_[0]->GetType(), function->params_[0]->span_,
+      "native RoPE input");
+  const StaticTensor cosine = ReadStaticTensor(
+      function->params_[1]->GetType(), function->params_[1]->span_,
+      "native RoPE cosine");
+  const StaticTensor sine = ReadStaticTensor(
+      function->params_[2]->GetType(), function->params_[2]->span_,
+      "native RoPE sine");
+  const StaticTensor output = ReadStaticTensor(
+      function->params_[3]->GetType(), function->params_[3]->span_,
+      "native RoPE output");
+  const StaticTensor declared = ReadStaticTensor(
+      function->return_types_[0], function->span_, "native RoPE return");
+  if (input.dtype != DataType::BF16 || input.shape.size() != 2 ||
+      input.shape[1] % 2 != 0 || !SameTensor(input, output) ||
+      !SameTensor(input, declared) || !SameTensor(cosine, sine) ||
+      cosine.dtype != DataType::BF16 || cosine.shape.size() != 2 ||
+      cosine.shape[0] != input.shape[0] ||
+      cosine.shape[1] * 2 != input.shape[1]) {
+    Reject("native RoPE requires x/out [rows,2*half] and cos/sin [rows,half] BF16",
+           &function->span_);
+  }
+
+  const auto top = ir::As<ir::SeqStmts>(function->body_);
+  if (!top || top->stmts_.size() != 2 || !top->stmts_[0] || !top->stmts_[1]) {
+    Reject("native RoPE body must contain one pl.at scope and one return",
+           &function->span_);
+  }
+  const auto scope = ir::As<ir::InCoreScopeStmt>(top->stmts_[0]);
+  if (!scope || scope->split_ != ir::SplitMode::None || !scope->attrs_.empty()) {
+    Reject("native RoPE requires an unsplit CORE_GROUP scope",
+           &top->stmts_[0]->span_);
+  }
+  const auto returned = ir::As<ir::ReturnStmt>(top->stmts_[1]);
+  const auto returned_var =
+      returned && returned->value_.size() == 1
+          ? ir::As<ir::Var>(returned->value_[0])
+          : nullptr;
+  if (!returned_var || returned_var.get() != function->params_[3].get()) {
+    Reject("native RoPE must return its output parameter", &top->stmts_[1]->span_);
+  }
+  const TileLoopNest loop_nest = UnwrapStaticTileLoops(scope->body_);
+  if (loop_nest.repetitions != static_cast<uint64_t>(input.shape[0])) {
+    Reject("native RoPE row loop must cover every row exactly once", &scope->span_);
+  }
+  const ir::SeqStmtsPtr& leaf = loop_nest.leaf;
+  if (!leaf || leaf->stmts_.size() != 12) {
+    Reject("native RoPE row body must contain ten assignments and two stores",
+           leaf ? &leaf->span_ : &scope->span_);
+  }
+  constexpr std::array<std::string_view, 10> kExpectedOps = {
+      "tile.load", "tile.load", "tile.load", "tile.load", "tile.mul",
+      "tile.mul", "tile.sub", "tile.mul", "tile.mul", "tile.add"};
+  std::array<ir::AssignStmtPtr, 10> assignments;
+  std::array<ir::CallPtr, 10> calls;
+  for (size_t index = 0; index < assignments.size(); ++index) {
+    assignments[index] = ir::As<ir::AssignStmt>(leaf->stmts_[index]);
+    calls[index] = assignments[index]
+                       ? ir::As<ir::Call>(assignments[index]->value_)
+                       : nullptr;
+    if (!assignments[index] || !assignments[index]->var_ || !calls[index] ||
+        !calls[index]->op_ ||
+        !ir::IsOp(calls[index], std::string(kExpectedOps[index]))) {
+      Reject("native RoPE tile operation sequence is not canonical",
+             &leaf->stmts_[index]->span_);
+    }
+  }
+  std::array<ir::CallPtr, 2> stores;
+  for (size_t index = 0; index < stores.size(); ++index) {
+    const auto statement = ir::As<ir::EvalStmt>(leaf->stmts_[10 + index]);
+    stores[index] = statement ? ir::As<ir::Call>(statement->expr_) : nullptr;
+    if (!stores[index] || !stores[index]->op_ ||
+        !ir::IsOp(stores[index], "tile.store") || stores[index]->args_.size() != 3) {
+      Reject("native RoPE row body must end in two tile.store calls",
+             &leaf->stmts_[10 + index]->span_);
+    }
+  }
+
+  auto require_var = [&](const ir::CallPtr& call, size_t argument_index,
+                         const ir::VarPtr& expected,
+                         std::string_view diagnostic) {
+    if (argument_index >= call->args_.size()) {
+      Reject(std::string(diagnostic), &call->span_);
+    }
+    const auto value = ir::As<ir::Var>(call->args_[argument_index]);
+    if (!value || value.get() != expected.get()) {
+      Reject(std::string(diagnostic), &call->span_);
+    }
+  };
+  require_var(calls[0], 0, function->params_[0], "RoPE low load must read x");
+  require_var(calls[1], 0, function->params_[0], "RoPE high load must read x");
+  require_var(calls[2], 0, function->params_[1], "RoPE cosine load is invalid");
+  require_var(calls[3], 0, function->params_[2], "RoPE sine load is invalid");
+  require_var(calls[4], 0, assignments[0]->var_, "RoPE low*cos lhs is invalid");
+  require_var(calls[4], 1, assignments[2]->var_, "RoPE low*cos rhs is invalid");
+  require_var(calls[5], 0, assignments[1]->var_, "RoPE high*sin lhs is invalid");
+  require_var(calls[5], 1, assignments[3]->var_, "RoPE high*sin rhs is invalid");
+  require_var(calls[6], 0, assignments[4]->var_, "RoPE low subtraction lhs is invalid");
+  require_var(calls[6], 1, assignments[5]->var_, "RoPE low subtraction rhs is invalid");
+  require_var(calls[7], 0, assignments[1]->var_, "RoPE high*cos lhs is invalid");
+  require_var(calls[7], 1, assignments[2]->var_, "RoPE high*cos rhs is invalid");
+  require_var(calls[8], 0, assignments[0]->var_, "RoPE low*sin lhs is invalid");
+  require_var(calls[8], 1, assignments[3]->var_, "RoPE low*sin rhs is invalid");
+  require_var(calls[9], 0, assignments[7]->var_, "RoPE high addition lhs is invalid");
+  require_var(calls[9], 1, assignments[8]->var_, "RoPE high addition rhs is invalid");
+  require_var(stores[0], 0, assignments[6]->var_, "RoPE low store is invalid");
+  require_var(stores[1], 0, assignments[9]->var_, "RoPE high store is invalid");
+  require_var(stores[0], 2, function->params_[3], "RoPE low output is invalid");
+  require_var(stores[1], 2, function->params_[3], "RoPE high output is invalid");
+
+  const StaticTensor expected_tile{DataType::BF16, {1, cosine.shape[1]},
+                                   {cosine.shape[1], 1}};
+  for (const ir::AssignStmtPtr& assignment : assignments) {
+    const StaticTensor tile = ReadStaticTile(
+        assignment->var_->GetType(), assignment->span_, "native RoPE tile");
+    if (!SameTensor(tile, expected_tile)) {
+      Reject("native RoPE tile shapes must all be BF16 [1,half]",
+             &assignment->span_);
+    }
+  }
+  return NativeTileRopeGraph{input, cosine};
+}
