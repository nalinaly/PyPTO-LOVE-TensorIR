+std::string EmitNativeTileRopeSource(const NativeTileRopeGraph& graph) {
+  const StaticTensor& input = graph.input;
+  const StaticTensor& half = graph.frequency;
+  const std::string input_type = TensorTypeText(input);
+  const std::string half_type = TensorTypeText(half);
+  std::string source;
+  source.reserve(2048);
+  source += "module {\n  nv_tensor_ir.graph @";
+  source += kFusedPointwiseEntryName;
+  source += "(\n    %arg0: ";
+  source += TensorWithStrideText(input);
+  source += ",\n    %arg1: ";
+  source += TensorWithStrideText(half);
+  source += ",\n    %arg2: ";
+  source += TensorWithStrideText(half);
+  source += "\n  ) -> (";
+  source += TensorWithStrideText(input);
+  source += ") {\n    %xlow = slice %arg0 starts = [0, 0] limits = [";
+  AppendInteger(source, input.shape[0]);
+  source += ", ";
+  AppendInteger(source, half.shape[1]);
+  source += "] strides = [1, 1] : ";
+  source += input_type;
+  source += " -> ";
+  source += half_type;
+  source += "\n    %xhigh = slice %arg0 starts = [0, ";
+  AppendInteger(source, half.shape[1]);
+  source += "] limits = [";
+  AppendInteger(source, input.shape[0]);
+  source += ", ";
+  AppendInteger(source, input.shape[1]);
+  source += "] strides = [1, 1] : ";
+  source += input_type;
+  source += " -> ";
+  source += half_type;
+  source += "\n    %lowcos = mul %xlow, %arg1 : ";
+  source += half_type;
+  source += "\n    %highsin = mul %xhigh, %arg2 : ";
+  source += half_type;
+  source += "\n    %low = sub %lowcos, %highsin : ";
+  source += half_type;
+  source += "\n    %highcos = mul %xhigh, %arg1 : ";
+  source += half_type;
+  source += "\n    %lowsin = mul %xlow, %arg2 : ";
+  source += half_type;
+  source += "\n    %high = add %highcos, %lowsin : ";
+  source += half_type;
+  source += "\n    %result0 = concatenate %low, %high dimension = 1 : (";
+  source += half_type;
+  source += ", ";
+  source += half_type;
+  source += ") -> ";
+  source += input_type;
+  source += "\n    results %result0 : ";
+  source += input_type;
+  source += "\n  }\n}\n";
+  if (source.size() > kMaximumCanonicalSourceBytes) {
+    Reject("canonical TensorIR source exceeds 16 MiB");
+  }
+  return source;
+}
