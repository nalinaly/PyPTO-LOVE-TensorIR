+@pl.jit
+def _native_tile_rope(
+    x: pl.Tensor[[2, 128], pl.BF16],
+    cos: pl.Tensor[[2, 64], pl.BF16],
+    sin: pl.Tensor[[2, 64], pl.BF16],
+    out: pl.Out[pl.Tensor[[2, 128], pl.BF16]],
+):
+    with pl.at(level=pl.Level.CORE_GROUP):
+        for row in pl.range(2):
+            x_low = pl.load(x, [row, 0], [1, 64])
+            x_high = pl.load(x, [row, 64], [1, 64])
+            cos_part = pl.load(cos, [row, 0], [1, 64])
+            sin_part = pl.load(sin, [row, 0], [1, 64])
+            low_cos = pl.mul(x_low, cos_part)
+            high_sin = pl.mul(x_high, sin_part)
+            low = pl.sub(low_cos, high_sin)
+            high_cos = pl.mul(x_high, cos_part)
+            low_sin = pl.mul(x_low, sin_part)
+            high = pl.add(high_cos, low_sin)
+            pl.store(low, [row, 0], out)
+            pl.store(high, [row, 64], out)
+    return out
+
