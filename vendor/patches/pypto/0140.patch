+ 
++// Matmul dimension-map sentinel for an explicit unit operand dimension that
++// is absent from the normalized output view.
++constexpr size_t kUnitDimension = static_cast<size_t>(-1);
++
+ /// Helper for extracting the tensor sources from a layout attribute.
+ /// Only process the layouts within the iteration space boundary.
+ void extractTensorSources(LayoutSourceAttrInterface layout,
+@@ -427,9 +431,20 @@ buildMatmulBlockStructure(RewriterBase &rewriter, MatmulOp matmulOp,
+   SmallVector<int64_t> lhsTileShape;
+   SmallVector<Value> lhsIndexValues;
+   SmallVector<size_t> lhsContractingDims;
++  Value unitIndex;
++
++  auto getUnitIndex = [&]() {
++    if (!unitIndex) {
++      unitIndex = createIndex(0);
++    }
++    return unitIndex;
++  };
+ 
+   for (size_t idx : *lhsDimensionMap) {
+-    if (idx < iterSpaceRank) {
++    if (idx == kUnitDimension) {
++      lhsTileShape.push_back(1);
++      lhsIndexValues.push_back(getUnitIndex());
++    } else if (idx < iterSpaceRank) {
+       lhsTileShape.push_back(iterSpace.tileShape[idx]);
+       lhsIndexValues.push_back(iterSpace.indexValues[idx]);
+     } else {
+@@ -445,7 +460,10 @@ buildMatmulBlockStructure(RewriterBase &rewriter, MatmulOp matmulOp,
+   SmallVector<size_t> rhsContractingDims;
+ 
+   for (size_t idx : *rhsDimensionMap) {
