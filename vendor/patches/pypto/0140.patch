+     } else {
+diff --git a/lib/Dialect/TensorAttrs.cpp b/lib/Dialect/TensorAttrs.cpp
+index 98caee3..2dfaf8b 100644
+--- a/lib/Dialect/TensorAttrs.cpp
++++ b/lib/Dialect/TensorAttrs.cpp
+@@ -24,6 +24,9 @@ namespace tcg = mlir::nv_tensor_ir::tcutegen;
+ namespace {
+ 
+ constexpr int64_t kDynamic = mlir::ShapedType::kDynamic;
++// Explicit unit operand dimensions may be absent from a normalized matmul
++// view; the conversion restores them with extent one and index zero.
++constexpr size_t kUnitDimension = static_cast<size_t>(-1);
+ 
+ bool isValidTensorElementType(Type type) {
+   if (auto intTy = dyn_cast<IntegerType>(type)) {
+@@ -1547,6 +1550,7 @@ llvm::FailureOr<SmallVector<size_t>>
+ MatmulSourceAttr::getLhsDimensionMap() const {
+   // Collect expected strides of LHS dimensions in the output view.
+   SmallVector<int64_t> ident;
++  SmallVector<int64_t> dimensionSizes;
+   SmallVector<int64_t> lhsShape = getLhs().getShape();
+   auto lhsM = findDimensionWithSuffixProduct(lhsShape, getM() * getK());
+   auto lhsK = findDimensionWithSuffixProduct(lhsShape, getK());
+@@ -1561,6 +1565,7 @@ MatmulSourceAttr::getLhsDimensionMap() const {
+       stride *= size;
+     }
+     ident.append(strides.rbegin(), strides.rend());
++    dimensionSizes.append(shape.begin(), shape.end());
+   };
+   appendStrides(ArrayRef(lhsShape).take_front(*lhsM), getM() * getN() * getK());
+   appendStrides(ArrayRef(lhsShape).slice(*lhsM, *lhsK - *lhsM),
+@@ -1570,7 +1575,15 @@ MatmulSourceAttr::getLhsDimensionMap() const {
+   // Map strides to output dimensions.
+   SmallVector<size_t> result;
+   auto dimensionMap = buildDimensionMap(getCuteLayout());
+-  for (int64_t stride : ident) {
++  for (auto [stride, size] : llvm::zip_equal(ident, dimensionSizes)) {
++    // Normalization is allowed to remove unit dimensions from the matmul
++    // view. Keep an explicit unit dimension in the operand iteration space,
++    // but mark it for a fixed tile extent of one and a zero index rather than
++    // requiring a non-existent output-view stride.
++    if (size == 1) {
++      result.push_back(kUnitDimension);
++      continue;
++    }
+     auto it = dimensionMap.find(stride);
+     if (it == dimensionMap.end()) {
+       LLVM_DEBUG(llvm::dbgs() << "Cannot find output dimension for stride "
+@@ -1586,6 +1599,7 @@ llvm::FailureOr<SmallVector<size_t>>
+ MatmulSourceAttr::getRhsDimensionMap() const {
+   // Collect expected strides of RHS dimensions in the output view.
+   SmallVector<int64_t> ident;
++  SmallVector<int64_t> dimensionSizes;
+   SmallVector<int64_t> rhsShape = getRhs().getShape();
+   auto rhsK = findDimensionWithSuffixProduct(rhsShape, getK() * getN());
+   auto rhsN = findDimensionWithSuffixProduct(rhsShape, getN());
+@@ -1600,6 +1614,7 @@ MatmulSourceAttr::getRhsDimensionMap() const {
+       stride *= size;
+     }
+     ident.append(strides.rbegin(), strides.rend());
++    dimensionSizes.append(shape.begin(), shape.end());
+   };
+   appendStrides(ArrayRef(rhsShape).take_front(*rhsK), getM() * getN() * getK());
+   appendStrides(ArrayRef(rhsShape).slice(*rhsK, *rhsN - *rhsK), 1);
+@@ -1608,7 +1623,11 @@ MatmulSourceAttr::getRhsDimensionMap() const {
+   // Map strides to output dimensions.
+   SmallVector<size_t> result;
+   auto dimensionMap = buildDimensionMap(getCuteLayout());
+-  for (int64_t stride : ident) {
++  for (auto [stride, size] : llvm::zip_equal(ident, dimensionSizes)) {
++    if (size == 1) {
++      result.push_back(kUnitDimension);
++      continue;
++    }
+     auto it = dimensionMap.find(stride);
+     if (it == dimensionMap.end()) {
+       LLVM_DEBUG(llvm::dbgs() << "Cannot find output dimension for stride "
+diff --git a/test/Conversion/TensorToCudaTile/paged_decode_attention_layout.mlir b/test/Conversion/TensorToCudaTile/paged_decode_attention_layout.mlir
+new file mode 100644
+index 0000000..142d26d
+--- /dev/null
++++ b/test/Conversion/TensorToCudaTile/paged_decode_attention_layout.mlir
+@@ -0,0 +1,55 @@
++// RUN: tensor_ir-opt --layout-propagation-pipeline %s | FileCheck %s
++
++// A decode attention head keeps an explicit unit-M query source after graph
++// splitting because QK feeds reductions and the resulting probabilities feed
++// a second matmul. The normalized matmul view omits that unit dimension; the
++// operand iteration space must restore it as extent one with index zero.
++//
++// CHECK-LABEL: entry @paged_decode_attention
++// CHECK: make_gather_scatter_view
++// CHECK: load_view_tko weak
++// CHECK: mmaf
++// CHECK: reduce
++// CHECK: exp
++// CHECK: mmaf
++// CHECK: store_view_tko weak
++module {
++  nv_tensor_ir.graph @paged_decode_attention(
++      %query: tensor<1x256xbf16> {nv_tensor_ir.stride = "(256,1)"},
++      %key_cache: tensor<1024x256xbf16> {nv_tensor_ir.stride = "(256,1)"},
++      %value_cache: tensor<1024x256xbf16> {nv_tensor_ir.stride = "(256,1)"},
++      %physical_indices: tensor<16x256xsi32>
++          {nv_tensor_ir.stride = "(1,0)"}) -> tensor<1x256xbf16>
++      attributes {tile_size = array<i32: 64>} {
++    %scale = constant 0.0625 : f32
++    %scale_splat = splat %scale : tensor<1x16xf32>
++    %key = gather_rows %key_cache, %physical_indices
++        : (tensor<1024x256xbf16>, tensor<16x256xsi32>)
++       -> tensor<16x256xbf16>
++    %key_t = transpose %key permutation = [1, 0]
++        : tensor<16x256xbf16> -> tensor<256x16xbf16>
++    %scores = matmul(%query, %key_t)
++        : (tensor<1x256xbf16>, tensor<256x16xbf16>) -> tensor<1x16xf32>
++    %scaled = mul %scores, %scale_splat : tensor<1x16xf32>
++    %rowmax = reduce(%scaled) <dimensions = [1], reduction_mode = <max>>
++        : tensor<1x16xf32> -> tensor<1x1xf32>
++    %max_full = broadcast %rowmax : tensor<1x1xf32> -> tensor<1x16xf32>
++    %centered = sub %scaled, %max_full : tensor<1x16xf32>
++    %exponent = exp %centered : tensor<1x16xf32>
++    %rowsum = reduce(%exponent) <dimensions = [1], reduction_mode = <add>>
++        : tensor<1x16xf32> -> tensor<1x1xf32>
++    %inverse = reciprocal %rowsum : tensor<1x1xf32>
++    %inverse_full = broadcast %inverse
++        : tensor<1x1xf32> -> tensor<1x16xf32>
++    %probability_f32 = mul %exponent, %inverse_full : tensor<1x16xf32>
++    %probability = convert %probability_f32
++        : tensor<1x16xf32> -> tensor<1x16xbf16>
++    %value = gather_rows %value_cache, %physical_indices
++        : (tensor<1024x256xbf16>, tensor<16x256xsi32>)
++       -> tensor<16x256xbf16>
++    %mixed = matmul(%probability, %value)
++        : (tensor<1x16xbf16>, tensor<16x256xbf16>) -> tensor<1x256xf32>
++    %output = convert %mixed : tensor<1x256xf32> -> tensor<1x256xbf16>
++    results %output : tensor<1x256xbf16>
++  }
++}
+-- 
+2.53.0
