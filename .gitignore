# Nested repositories are independently versioned; WORKSPACE.lock records heads.
/projects/*/
/upstream/*/
/worktrees/

# Large/local state.
/models/*/
!/models/MANIFEST.json
/envs/
/builds/
/build_output/
/demo/pypto-lib/build_output/
/caches/
/.cache/
/logs/
/runs/
/state/evidence/current-*-run.json
# Keep JSON evidence in git; ignore other dumps under reports/data.
/reports/data/*
!/reports/data/*.json
.sources/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/

# Local-only blog drafts and session state.
/blog/
/.zcode/
